// HicOS_PowerManager.hl -- Power Management (Native H-L)
//
// User-space interface for ACPI power control.
// Delegates to bare-kernel/hl/power.hl

fn hicos_shutdown() {
    print("System shutting down...");
    power_shutdown();
    return 0;
}

fn hicos_reboot() {
    print("System rebooting...");
    power_reboot();
    return 0;
}

fn hicos_sleep() {
    print("System entering sleep (S1)...");
    power_sleep();
    return 0;
}

fn hicos_power_status() {
    print("Power: ACPI initialized");
    return 0;
}

print("HicOS_PowerManager.hl loaded (native H-L)");
