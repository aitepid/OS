// ============================================================
// 8. BYTE ARRAY OPERATIONS (binary data manipulation)
// ============================================================

fn byte_array_from_str(s) {
    let mut result = [];
    let ascii = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~";
    let mut i = 0;
    while i < len(s) {
        let c = s[i];
        let mut code = 0;
        if c == "\n" { code = 10; }
        else if c == "\r" { code = 13; }
        else if c == "\t" { code = 9; }
        else {
            let mut ai = 0;
            while ai < len(ascii) {
                if ascii[ai] == c { code = ai + 32; ai = len(ascii); }
                ai = ai + 1;
            }
        }
        push(result, code);
        i = i + 1;
    }
    return result;
}

fn byte_array_to_str(arr) {
    let ascii = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~";
    let mut result = "";
    let mut i = 0;
    while i < len(arr) {
        let b = arr[i];
        if b >= 32 && b <= 126 {
            result = result + to_string(ascii[b - 32]);
        } else if b == 10 {
            result = result + "\n";
        } else if b == 13 {
            result = result + "\r";
        } else if b == 9 {
            result = result + "\t";
        } else {
            result = result + ".";
        }
        i = i + 1;
    }
    return result;
}

fn byte_array_write_u16_le(arr, offset, value) {
    arr[offset] = value % 256;
    arr[offset + 1] = (value / 256) % 256;
    return arr;
}

fn byte_array_write_u32_le(arr, offset, value) {
    arr[offset] = value % 256;
    arr[offset + 1] = (value / 256) % 256;
    arr[offset + 2] = (value / 65536) % 256;
    arr[offset + 3] = (value / 16777216) % 256;
    return arr;
}

fn byte_array_write_u64_le(arr, offset, value) {
    let lo = value % 4294967296;
    let hi = value / 4294967296;
    byte_array_write_u32_le(arr, offset, lo);
    byte_array_write_u32_le(arr, offset + 4, hi);
    return arr;
}

fn byte_array_read_u16_le(arr, offset) {
    return arr[offset] + arr[offset + 1] * 256;
}

fn byte_array_read_u32_le(arr, offset) {
    return arr[offset] + arr[offset + 1] * 256 + arr[offset + 2] * 65536 + arr[offset + 3] * 16777216;
}

fn byte_array_read_u64_le(arr, offset) {
    let lo = byte_array_read_u32_le(arr, offset);
    let hi = byte_array_read_u32_le(arr, offset + 4);
    return lo + hi * 4294967296;
}

fn byte_array_copy(dst, dst_off, src, src_off, length) {
    let mut i = 0;
    while i < length {
        dst[dst_off + i] = src[src_off + i];
        i = i + 1;
    }
    return dst;
}

fn byte_array_fill(arr, offset, length, value) {
    let mut i = 0;
    while i < length {
        arr[offset + i] = value % 256;
        i = i + 1;
    }
    return arr;
}

fn byte_array_compare(a, a_off, b, b_off, length) {
    let mut i = 0;
    while i < length {
        if a[a_off + i] != b[b_off + i] {
            if a[a_off + i] < b[b_off + i] { return 0 - 1; }
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

// Hex dump: format byte array as hex string
fn byte_array_hex(arr, offset, length) {
    let hex_chars = "0123456789ABCDEF";
    let mut result = "";
    let mut i = 0;
    while i < length {
        if offset + i >= len(arr) { i = length; }
        else {
            let b = arr[offset + i];
            result = result + to_string(hex_chars[b / 16]) + to_string(hex_chars[b % 16]);
            if i < length - 1 { result = result + " "; }
        }
        i = i + 1;
    }
    return result;
}

// ============================================================
// 9. NUMBER PARSING AND FORMATTING
// ============================================================

fn parse_int_str(s) {
    let mut result = 0;
    let mut sign = 1;
    let mut i = 0;
    if len(s) > 0 {
        if str_char_at(s, 0) == 45 { sign = 0 - 1; i = 1; }  // '-'
    }
    let digits = "0123456789";
    while i < len(s) {
        let c = str_char_at(s, i);
        let mut found = false;
        let mut d = 0;
        while d < 10 {
            if str_char_at(digits, d) == c {
                result = result * 10 + d;
                found = true;
                d = 10;
            }
            d = d + 1;
        }
        if !found { return result * sign; }
        i = i + 1;
    }
    return result * sign;
}

fn parse_hex_str(s) {
    let mut result = 0;
    let mut i = 0;
    // Skip "0x" prefix if present
    if len(s) >= 2 {
        if str_char_at(s, 0) == 48 {  // '0'
            if str_char_at(s, 1) == 120 || str_char_at(s, 1) == 88 {  // 'x' or 'X'
                i = 2;
            }
        }
    }
    let hex_lo = "0123456789abcdef";
    let hex_hi = "0123456789ABCDEF";
    while i < len(s) {
        let c = str_char_at(s, i);
        let mut val = 0 - 1;
        let mut d = 0;
        while d < 16 {
            if str_char_at(hex_lo, d) == c { val = d; d = 16; }
            if str_char_at(hex_hi, d) == c { val = d; d = 16; }
            d = d + 1;
        }
        if val < 0 { return result; }
        result = result * 16 + val;
        i = i + 1;
    }
    return result;
}

fn format_hex(value, width) {
    let hex_chars = "0123456789abcdef";
    let mut v = value;
    if v < 0 { v = 0 - v; }
    if v == 0 { return str_pad_start("0", width, "0"); }
    let mut result = "";
    while v > 0 {
        result = to_string(hex_chars[v % 16]) + result;
        v = v / 16;
    }
    return str_pad_start(result, width, "0");
}

fn format_bin(value, width) {
    let mut v = value;
    if v < 0 { v = 0 - v; }
    if v == 0 { return str_pad_start("0", width, "0"); }
    let mut result = "";
    while v > 0 {
        if v % 2 == 1 { result = "1" + result; }
        else { result = "0" + result; }
        v = v / 2;
    }
    return str_pad_start(result, width, "0");
}

// ============================================================
// 10. ASSERTION AND DEBUG UTILITIES
// ============================================================

fn assert_eq(actual, expected, msg) {
    if actual != expected {
        print("ASSERT FAILED: " + msg);
        print("  expected: " + to_string(expected));
        print("  actual:   " + to_string(actual));
        return false;
    }
    return true;
}

fn assert_true(cond, msg) {
    if !cond {
        print("ASSERT FAILED: " + msg);
        return false;
    }
    return true;
}

fn debug_print(label, value) {
    print("[DEBUG] " + label + " = " + to_string(value));
    return value;
}

// Sprint 35 wave 2: real H-L wrappers replacing C-class no-op stubs
fn _find_space(s) {
    return str_find(s, " ");
}

fn parse_int(s) {
    return int(s);
}

fn to_int(x) {
    return int(x);
}

fn to_char(n) {
    return chr(n);
}

fn substr(s, a, b) {
    return str_sub(s, a, b);
}

fn str_slice(s, a, b) {
    return str_sub(s, a, b);
}

fn str_index_of(s, n) {
    return str_find(s, n);
}

fn _starts_with(s, p) {
    return str_starts_with(s, p);
}

fn char_code(s) {
    return ord(s);
}

fn str_char_code(s) {
    return str_to_code(s);
}

fn str_byte(s, i) {
    return str_char_at(s, i);
}

fn str_from_byte(b) {
    return str_from_code(b);
}

fn strlen(s) {
    return str_len(s);
}

fn array_new() {
    return [];
}

fn array(n, init_val) {
    let result = [];
    let i = 0;
    while i < n {
        push(result, init_val);
        i = i + 1;
    }
    return result;
}

fn cstr_from_addr(addr) {
    let result = "";
    let i = 0;
    while i < 65536 {
        let b = mem_read_u8(addr + i);
        if b == 0 { return result; }
        result = result + str_from_code(b);
        i = i + 1;
    }
    return result;
}

fn ui_fill_rect(x, y, w, h, color) {
    return gfx_fill_rect(x, y, w, h, color);
}

fn font_draw_string(x, y, text, fg, bg) {
    return font_atlas_draw_str(x, y, text, 14, fg);
}
