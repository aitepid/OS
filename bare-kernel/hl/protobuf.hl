# protobuf.hl - Protocol Buffers Wire Format
# Implements Google Protocol Buffers binary serialization format (simplified)

# Memory layout
global PROTOBUF_BUF = 0x11D0000

# Wire types
global PROTOBUF_VARINT = 0      # int32, int64, uint32, uint64, bool, enum
global PROTOBUF_64BIT = 1       # fixed64, sfixed64, double
global PROTOBUF_LENGTH = 2      # string, bytes, embedded messages
global PROTOBUF_32BIT = 5       # fixed32, sfixed32, float

# Encoding state
global protobuf_output = 0
global protobuf_output_len = 0
global protobuf_decode_pos = 0

fn protobuf_init() {
    protobuf_output = PROTOBUF_BUF
    protobuf_output_len = 0
    protobuf_decode_pos = 0
    serial_print("Protocol Buffers ready")
}

# Start new message
fn protobuf_start() {
    protobuf_output_len = 0
    return protobuf_output
}

# Encode varint field (field_number, value)
fn protobuf_add_varint(field_num, value) {
    # Encode tag: (field_number << 3) | wire_type
    var tag = field_num * 8 + PROTOBUF_VARINT
    protobuf_output_len = _protobuf_encode_varint(protobuf_output, protobuf_output_len, tag)
    protobuf_output_len = _protobuf_encode_varint(protobuf_output, protobuf_output_len, value)
    return protobuf_output_len
}

# Encode string field (field_number, string)
fn protobuf_add_string(field_num, str) {
    # Encode tag
    var tag = field_num * 8 + PROTOBUF_LENGTH
    protobuf_output_len = _protobuf_encode_varint(protobuf_output, protobuf_output_len, tag)

    # Encode length
    var len = strlen(str)
    protobuf_output_len = _protobuf_encode_varint(protobuf_output, protobuf_output_len, len)

    # Copy string bytes
    var i = 0
    while (i < len) {
        set_at(protobuf_output, protobuf_output_len, get_at(str, i))
        protobuf_output_len = protobuf_output_len + 1
        i = i + 1
    }

    return protobuf_output_len
}

# Encode bytes field (field_number, data, len)
fn protobuf_add_bytes(field_num, data, len) {
    # Encode tag
    var tag = field_num * 8 + PROTOBUF_LENGTH
    protobuf_output_len = _protobuf_encode_varint(protobuf_output, protobuf_output_len, tag)

    # Encode length
    protobuf_output_len = _protobuf_encode_varint(protobuf_output, protobuf_output_len, len)

    # Copy bytes
    var i = 0
    while (i < len) {
        set_at(protobuf_output, protobuf_output_len, get_at(data, i))
        protobuf_output_len = protobuf_output_len + 1
        i = i + 1
    }

    return protobuf_output_len
}

# Encode 32-bit fixed field
fn protobuf_add_fixed32(field_num, value) {
    # Encode tag
    var tag = field_num * 8 + PROTOBUF_32BIT
    protobuf_output_len = _protobuf_encode_varint(protobuf_output, protobuf_output_len, tag)

    # Encode value (little-endian)
    set_at(protobuf_output, protobuf_output_len + 0, value % 256)
    set_at(protobuf_output, protobuf_output_len + 1, (value / 256) % 256)
    set_at(protobuf_output, protobuf_output_len + 2, (value / 65536) % 256)
    set_at(protobuf_output, protobuf_output_len + 3, (value / 16777216) % 256)
    protobuf_output_len = protobuf_output_len + 4

    return protobuf_output_len
}

# Encode 64-bit fixed field (simplified - only lower 32 bits)
fn protobuf_add_fixed64(field_num, value) {
    # Encode tag
    var tag = field_num * 8 + PROTOBUF_64BIT
    protobuf_output_len = _protobuf_encode_varint(protobuf_output, protobuf_output_len, tag)

    # Encode value (little-endian, upper 32 bits = 0)
    set_at(protobuf_output, protobuf_output_len + 0, value % 256)
    set_at(protobuf_output, protobuf_output_len + 1, (value / 256) % 256)
    set_at(protobuf_output, protobuf_output_len + 2, (value / 65536) % 256)
    set_at(protobuf_output, protobuf_output_len + 3, (value / 16777216) % 256)
    set_at(protobuf_output, protobuf_output_len + 4, 0)
    set_at(protobuf_output, protobuf_output_len + 5, 0)
    set_at(protobuf_output, protobuf_output_len + 6, 0)
    set_at(protobuf_output, protobuf_output_len + 7, 0)
    protobuf_output_len = protobuf_output_len + 8

    return protobuf_output_len
}

# Encode varint (base-128 encoding)
fn _protobuf_encode_varint(buf, pos, value) {
    while (value >= 128) {
        set_at(buf, pos, (value % 128) + 128)  # Set MSB
        pos = pos + 1
        value = value / 128
    }
    set_at(buf, pos, value)
    pos = pos + 1
    return pos
}

# Decode varint from buffer
fn _protobuf_decode_varint(buf, start_pos) {
    var result = PROTOBUF_BUF + 65536
    var value = 0
    var shift = 0
    var pos = start_pos

    while (1 == 1) {
        var byte = get_at(buf, pos)
        pos = pos + 1

        value = value + ((byte % 128) * _protobuf_pow2(shift))
        shift = shift + 7

        if (byte < 128) {
            break
        }
    }

    set_at(result, 0, value)
    set_at(result, 1, pos - start_pos)  # Bytes consumed
    return result
}

# Power of 2 (for varint decoding)
fn _protobuf_pow2(exp) {
    var result = 1
    var i = 0
    while (i < exp) {
        result = result * 2
        i = i + 1
    }
    return result
}

# Start decoding message
fn protobuf_decode_start(data) {
    protobuf_decode_pos = 0
    return 0
}

# Decode next field (returns field_num, wire_type, value)
fn protobuf_decode_field(data, data_len) {
    if (protobuf_decode_pos >= data_len) {
        return 0  # No more fields
    }

    var result = PROTOBUF_BUF + 131072

    # Decode tag
    var tag_result = _protobuf_decode_varint(data, protobuf_decode_pos)
    var tag = get_at(tag_result, 0)
    var tag_len = get_at(tag_result, 1)
    protobuf_decode_pos = protobuf_decode_pos + tag_len

    var field_num = tag / 8
    var wire_type = tag % 8

    # Store field number and wire type
    set_at(result, 0, field_num)
    set_at(result, 1, wire_type)

    # Decode value based on wire type
    if (wire_type == PROTOBUF_VARINT) {
        var value_result = _protobuf_decode_varint(data, protobuf_decode_pos)
        var value = get_at(value_result, 0)
        var value_len = get_at(value_result, 1)
        protobuf_decode_pos = protobuf_decode_pos + value_len
        set_at(result, 2, value)
        set_at(result, 3, 0)  # No additional data
    } else if (wire_type == PROTOBUF_LENGTH) {
        var len_result = _protobuf_decode_varint(data, protobuf_decode_pos)
        var len = get_at(len_result, 0)
        var len_bytes = get_at(len_result, 1)
        protobuf_decode_pos = protobuf_decode_pos + len_bytes
        set_at(result, 2, protobuf_decode_pos)  # Data offset
        set_at(result, 3, len)                  # Data length
        protobuf_decode_pos = protobuf_decode_pos + len
    } else if (wire_type == PROTOBUF_32BIT) {
        var value = _protobuf_read_u32_le(data, protobuf_decode_pos)
        protobuf_decode_pos = protobuf_decode_pos + 4
        set_at(result, 2, value)
        set_at(result, 3, 0)
    } else if (wire_type == PROTOBUF_64BIT) {
        var value = _protobuf_read_u32_le(data, protobuf_decode_pos)
        protobuf_decode_pos = protobuf_decode_pos + 8
        set_at(result, 2, value)
        set_at(result, 3, 0)
    }

    return result
}

# Read 32-bit little-endian
fn _protobuf_read_u32_le(buf, offset) {
    var b0 = get_at(buf, offset + 0)
    var b1 = get_at(buf, offset + 1)
    var b2 = get_at(buf, offset + 2)
    var b3 = get_at(buf, offset + 3)
    return b0 + b1 * 256 + b2 * 65536 + b3 * 16777216
}

# Get encoded message
fn protobuf_get_message() {
    return protobuf_output
}

# Get message length
fn protobuf_get_length() {
    return protobuf_output_len
}

# Extract string from decoded field
fn protobuf_extract_string(data, field_info) {
    var offset = get_at(field_info, 2)
    var len = get_at(field_info, 3)

    var buf = PROTOBUF_BUF + 196608
    var i = 0
    while (i < len) {
        set_at(buf, i, get_at(data, offset + i))
        i = i + 1
    }
    set_at(buf, len, 0)  # Null terminator

    return buf
}

# Format field info as string
fn protobuf_format_field(field_info) {
    var buf = PROTOBUF_BUF + 262144
    var pos = 0

    var field_num = get_at(field_info, 0)
    var wire_type = get_at(field_info, 1)
    var value = get_at(field_info, 2)

    pos = _protobuf_append_str(buf, pos, "Field ")
    pos = _protobuf_append_num(buf, pos, field_num)
    pos = _protobuf_append_str(buf, pos, " (")

    if (wire_type == PROTOBUF_VARINT) {
        pos = _protobuf_append_str(buf, pos, "varint): ")
        pos = _protobuf_append_num(buf, pos, value)
    } else if (wire_type == PROTOBUF_LENGTH) {
        pos = _protobuf_append_str(buf, pos, "length): ")
        pos = _protobuf_append_num(buf, pos, get_at(field_info, 3))
        pos = _protobuf_append_str(buf, pos, " bytes")
    } else if (wire_type == PROTOBUF_32BIT) {
        pos = _protobuf_append_str(buf, pos, "32-bit): ")
        pos = _protobuf_append_num(buf, pos, value)
    } else if (wire_type == PROTOBUF_64BIT) {
        pos = _protobuf_append_str(buf, pos, "64-bit): ")
        pos = _protobuf_append_num(buf, pos, value)
    }

    set_at(buf, pos, 0)
    return buf
}

# Helper: append string
fn _protobuf_append_str(buf, pos, str) {
    var i = 0
    var len = strlen(str)
    while (i < len) {
        set_at(buf, pos, get_at(str, i))
        pos = pos + 1
        i = i + 1
    }
    return pos
}

# Helper: append number
fn _protobuf_append_num(buf, pos, num) {
    if (num == 0) {
        set_at(buf, pos, 48)
        return pos + 1
    }

    var digits = PROTOBUF_BUF + 327680
    var d_pos = 0

    while (num > 0) {
        set_at(digits, d_pos, 48 + (num % 10))
        num = num / 10
        d_pos = d_pos + 1
    }

    while (d_pos > 0) {
        d_pos = d_pos - 1
        set_at(buf, pos, get_at(digits, d_pos))
        pos = pos + 1
    }

    return pos
}

# Test protobuf encoding/decoding
fn protobuf_test() {
    protobuf_start()

    # Encode test message: field 1 = 150, field 2 = "testing"
    protobuf_add_varint(1, 150)
    protobuf_add_string(2, "testing")

    var msg = protobuf_get_message()
    var len = protobuf_get_length()

    # Decode message
    protobuf_decode_start(msg)
    var field1 = protobuf_decode_field(msg, len)
    var field2 = protobuf_decode_field(msg, len)

    if (field1 == 0 || field2 == 0) {
        serial_print("Protobuf test: decode failed")
        return -1
    }

    if (get_at(field1, 0) != 1 || get_at(field1, 2) != 150) {
        serial_print("Protobuf test: field 1 mismatch")
        return -2
    }

    if (get_at(field2, 0) != 2) {
        serial_print("Protobuf test: field 2 number mismatch")
        return -3
    }

    serial_print("Protobuf test: passed")
    return 0
}
