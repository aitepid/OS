// pty.hl -- Pseudo-Terminal (PTY)
//
// Implements Unix98 PTY pairs (master + slave) for terminal emulation.
// Required by: ssh, screen, tmux, xterm, any graphical terminal.
//
// Architecture:
//   ptmx (master) <---> pts/N (slave)
//   Master side: the terminal emulator or ssh daemon reads/writes
//   Slave side:  the shell/application sees it as a real terminal
//
// Data flow:
//   User types -> master write -> slave read -> shell gets input
//   Shell prints -> slave write -> master read -> terminal displays
//
// Each PTY pair has a 4KB bidirectional ring buffer.

let PTY_MAX = 16;
let PTY_BUF_SIZE = 4096;
let PTY_BUF_BASE = 12582912;  // 0xC00000

let mut pty_count = 0;

let pty_active = [];
let pty_master_fd = [];
let pty_slave_fd = [];
// Ring buffer state: [write_pos, read_pos, count] for each direction
let pty_m2s_wpos = [];  // master-to-slave write position
let pty_m2s_rpos = [];
let pty_m2s_count = [];
let pty_s2m_wpos = [];  // slave-to-master
let pty_s2m_rpos = [];
let pty_s2m_count = [];
let pty_line_mode = [];  // 1=cooked (line buffered), 0=raw
let pty_echo = [];       // 1=echo input back
let pty_master_task = [];
let pty_slave_task = [];

fn pty_init() {
    let mut i = 0;
    while i < PTY_MAX {
        push(pty_active, 0);
        push(pty_master_fd, 0 - 1);
        push(pty_slave_fd, 0 - 1);
        push(pty_m2s_wpos, 0);
        push(pty_m2s_rpos, 0);
        push(pty_m2s_count, 0);
        push(pty_s2m_wpos, 0);
        push(pty_s2m_rpos, 0);
        push(pty_s2m_count, 0);
        push(pty_line_mode, 1);
        push(pty_echo, 1);
        push(pty_master_task, 0 - 1);
        push(pty_slave_task, 0 - 1);
        i = i + 1;
    }
    return 0;
}

fn pty_buf_addr(pty_id, direction) {
    // direction: 0=master-to-slave, 1=slave-to-master
    return PTY_BUF_BASE + pty_id * PTY_BUF_SIZE * 2 + direction * PTY_BUF_SIZE;
}

fn pty_alloc() {
    let mut i = 0;
    while i < PTY_MAX {
        if pty_active[i] == 0 {
            pty_active[i] = 1;
            pty_m2s_wpos[i] = 0;
            pty_m2s_rpos[i] = 0;
            pty_m2s_count[i] = 0;
            pty_s2m_wpos[i] = 0;
            pty_s2m_rpos[i] = 0;
            pty_s2m_count[i] = 0;
            pty_line_mode[i] = 1;
            pty_echo[i] = 1;
            pty_master_fd[i] = 0 - 1;
            pty_slave_fd[i] = 0 - 1;
            pty_master_task[i] = 0 - 1;
            pty_slave_task[i] = 0 - 1;
            pty_count = pty_count + 1;
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

fn pty_free(id) {
    if id < 0 { return 0; }
    if id >= PTY_MAX { return 0; }
    pty_active[id] = 0;
    pty_master_fd[id] = 0 - 1;
    pty_slave_fd[id] = 0 - 1;
    pty_master_task[id] = 0 - 1;
    pty_slave_task[id] = 0 - 1;
    pty_m2s_wpos[id] = 0;
    pty_m2s_rpos[id] = 0;
    pty_m2s_count[id] = 0;
    pty_s2m_wpos[id] = 0;
    pty_s2m_rpos[id] = 0;
    pty_s2m_count[id] = 0;
    pty_count = pty_count - 1;
    return 0;
}

fn pty_attach(id, master_task, slave_task, master_fd, slave_fd) {
    if id < 0 { return 0 - 1; }
    if id >= PTY_MAX { return 0 - 1; }
    if pty_active[id] == 0 { return 0 - 1; }
    pty_master_task[id] = master_task;
    pty_slave_task[id] = slave_task;
    pty_master_fd[id] = master_fd;
    pty_slave_fd[id] = slave_fd;
    return 0;
}

fn pty_detach(id) {
    if id < 0 { return 0 - 1; }
    if id >= PTY_MAX { return 0 - 1; }
    pty_master_task[id] = 0 - 1;
    pty_slave_task[id] = 0 - 1;
    pty_master_fd[id] = 0 - 1;
    pty_slave_fd[id] = 0 - 1;
    return 0;
}

fn pty_master_write(id, byte) {
    if pty_m2s_count[id] >= PTY_BUF_SIZE { return 0 - 1; }
    let mut addr = pty_buf_addr(id, 0) + pty_m2s_wpos[id];
    mem_write_u8(addr, byte);
    pty_m2s_wpos[id] = (pty_m2s_wpos[id] + 1) % PTY_BUF_SIZE;
    pty_m2s_count[id] = pty_m2s_count[id] + 1;
    return 0;
}

fn pty_slave_read(id) {
    if pty_m2s_count[id] == 0 { return 0 - 1; }
    let mut addr = pty_buf_addr(id, 0) + pty_m2s_rpos[id];
    let mut byte = mem_read_u8(addr);
    pty_m2s_rpos[id] = (pty_m2s_rpos[id] + 1) % PTY_BUF_SIZE;
    pty_m2s_count[id] = pty_m2s_count[id] - 1;
    return byte;
}

fn pty_slave_write(id, byte) {
    if pty_s2m_count[id] >= PTY_BUF_SIZE { return 0 - 1; }
    let mut addr = pty_buf_addr(id, 1) + pty_s2m_wpos[id];
    mem_write_u8(addr, byte);
    pty_s2m_wpos[id] = (pty_s2m_wpos[id] + 1) % PTY_BUF_SIZE;
    pty_s2m_count[id] = pty_s2m_count[id] + 1;
    // Echo if enabled
    if pty_echo[id] == 1 {
        pty_master_write(id, byte);
    }
    return 0;
}

fn pty_master_read(id) {
    if pty_s2m_count[id] == 0 { return 0 - 1; }
    let mut addr = pty_buf_addr(id, 1) + pty_s2m_rpos[id];
    let mut byte = mem_read_u8(addr);
    pty_s2m_rpos[id] = (pty_s2m_rpos[id] + 1) % PTY_BUF_SIZE;
    pty_s2m_count[id] = pty_s2m_count[id] - 1;
    return byte;
}

fn pty_set_raw(id) {
    pty_line_mode[id] = 0;
    pty_echo[id] = 0;
    return 0;
}

fn pty_set_cooked(id) {
    pty_line_mode[id] = 1;
    pty_echo[id] = 1;
    return 0;
}

fn pty_info(id) {
    if id < 0 { return "pty: invalid"; }
    if id >= PTY_MAX { return "pty: invalid"; }
    if pty_active[id] == 0 { return "pty: free"; }
    let mut mode = "cooked";
    if pty_line_mode[id] == 0 { mode = "raw"; }
    return "pty" + to_string(id) +
           " mfd=" + to_string(pty_master_fd[id]) +
           " sfd=" + to_string(pty_slave_fd[id]) +
           " mtask=" + to_string(pty_master_task[id]) +
           " stask=" + to_string(pty_slave_task[id]) +
           " m2s=" + to_string(pty_m2s_count[id]) +
           " s2m=" + to_string(pty_s2m_count[id]) +
           " mode=" + mode;
}

fn pty_status() {
    let mut attached = 0;
    let mut i = 0;
    while i < PTY_MAX {
        if pty_active[i] == 1 {
            if pty_master_task[i] >= 0 || pty_slave_task[i] >= 0 { attached = attached + 1; }
        }
        i = i + 1;
    }
    return to_string(pty_count) + "/" + to_string(PTY_MAX) +
           " PTY pairs active, " + to_string(attached) + " attached";
}

// Drain all master-to-slave bytes, collect into line, run shell on newline.
// Returns string of output that should be written back to slave (for display).
fn pty_exec_input(id) {
    if id < 0 { return ""; }
    if id >= PTY_MAX { return ""; }
    if pty_active[id] == 0 { return ""; }
    let mut line = "";
    let mut done = 0;
    while done == 0 {
        let mut b = pty_slave_read(id);
        if b < 0 {
            done = 1;
        } else {
            if b == 13 || b == 10 {
                // End of line — dispatch to shell
                done = 1;
                let mut result = shell_handle_ext(line);
                // Write result bytes back to slave->master (for terminal display)
                let mut ri = 0;
                while ri < len(result) {
                    pty_slave_write(id, str_char_at(result, ri));
                    ri = ri + 1;
                }
                // Write trailing newline
                pty_slave_write(id, 10);
                return result;
            } else {
                line = line + str_from_code(b);
            }
        }
    }
    return "";
}

// Open a new PTY and attach to current task (master) and a new slave task.
// Returns [master_fd, slave_fd, pty_id].
fn pty_open_pair() {
    let mut id = pty_alloc();
    if id < 0 { return [0 - 1, 0 - 1, 0 - 1]; }
    // Allocate fake fds (use pty_id shifted into high range to avoid VFS collision)
    let mut mfd = 64 + id * 2;
    let mut sfd = 65 + id * 2;
    pty_master_fd[id] = mfd;
    pty_slave_fd[id] = sfd;
    pty_master_task[id] = current_task;
    pty_slave_task[id] = 0 - 1;
    return [mfd, sfd, id];
}

print("pty.hl loaded");
print("PTY: " + to_string(PTY_MAX) + " pairs, cooked/raw mode, echo, attach/detach, shell-exec");
