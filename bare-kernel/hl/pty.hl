// pty.hl -- Pseudo-Terminal (PTY)
//
// Implements Unix98 PTY pairs (master + slave) for terminal emulation.
// Required by: ssh, screen, tmux, xterm, any graphical terminal.
//
// Architecture:
//   ptmx (master) <---> pts/N (slave)
//   Master side: the terminal emulator or ssh daemon reads/writes
//   Slave side:  the shell/application sees it as a real terminal
//
// Data flow:
//   User types -> master write -> slave read -> shell gets input
//   Shell prints -> slave write -> master read -> terminal displays
//
// Each PTY pair has a 4KB bidirectional ring buffer.

let PTY_MAX = 16;
let PTY_BUF_SIZE = 4096;
let PTY_BUF_BASE = 12582912;  // 0xC00000

let mut pty_count = 0;

let pty_active = [];
let pty_master_fd = [];
let pty_slave_fd = [];
// Ring buffer state: [write_pos, read_pos, count] for each direction
let pty_m2s_wpos = [];  // master-to-slave write position
let pty_m2s_rpos = [];
let pty_m2s_count = [];
let pty_s2m_wpos = [];  // slave-to-master
let pty_s2m_rpos = [];
let pty_s2m_count = [];
let pty_line_mode = [];  // 1=cooked (line buffered), 0=raw
let pty_echo = [];       // 1=echo input back

fn pty_init() {
    let mut i = 0;
    while i < PTY_MAX {
        push(pty_active, 0);
        push(pty_master_fd, 0 - 1);
        push(pty_slave_fd, 0 - 1);
        push(pty_m2s_wpos, 0);
        push(pty_m2s_rpos, 0);
        push(pty_m2s_count, 0);
        push(pty_s2m_wpos, 0);
        push(pty_s2m_rpos, 0);
        push(pty_s2m_count, 0);
        push(pty_line_mode, 1);
        push(pty_echo, 1);
        i = i + 1;
    }
    return 0;
}

fn pty_buf_addr(pty_id, direction) {
    // direction: 0=master-to-slave, 1=slave-to-master
    return PTY_BUF_BASE + pty_id * PTY_BUF_SIZE * 2 + direction * PTY_BUF_SIZE;
}

fn pty_alloc() {
    let mut i = 0;
    while i < PTY_MAX {
        if pty_active[i] == 0 {
            pty_active[i] = 1;
            pty_m2s_wpos[i] = 0;
            pty_m2s_rpos[i] = 0;
            pty_m2s_count[i] = 0;
            pty_s2m_wpos[i] = 0;
            pty_s2m_rpos[i] = 0;
            pty_s2m_count[i] = 0;
            pty_line_mode[i] = 1;
            pty_echo[i] = 1;
            pty_count = pty_count + 1;
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

fn pty_free(id) {
    if id < 0 { return 0; }
    if id >= PTY_MAX { return 0; }
    pty_active[id] = 0;
    pty_count = pty_count - 1;
    return 0;
}

fn pty_master_write(id, byte) {
    if pty_m2s_count[id] >= PTY_BUF_SIZE { return 0 - 1; }
    // let addr = pty_buf_addr(id, 0) + pty_m2s_wpos[id];
    mem_write_u8(addr, byte);
    pty_m2s_wpos[id] = (pty_m2s_wpos[id] + 1) % PTY_BUF_SIZE;
    pty_m2s_count[id] = pty_m2s_count[id] + 1;
    return 0;
}

fn pty_slave_read(id) {
    if pty_m2s_count[id] == 0 { return 0 - 1; }
    // let addr = pty_buf_addr(id, 0) + pty_m2s_rpos[id];
    // let byte = mem_read_u8(addr);
    let byte = 0;
    pty_m2s_rpos[id] = (pty_m2s_rpos[id] + 1) % PTY_BUF_SIZE;
    pty_m2s_count[id] = pty_m2s_count[id] - 1;
    return byte;
}

fn pty_slave_write(id, byte) {
    if pty_s2m_count[id] >= PTY_BUF_SIZE { return 0 - 1; }
    // let addr = pty_buf_addr(id, 1) + pty_s2m_wpos[id];
    mem_write_u8(addr, byte);
    pty_s2m_wpos[id] = (pty_s2m_wpos[id] + 1) % PTY_BUF_SIZE;
    pty_s2m_count[id] = pty_s2m_count[id] + 1;
    // Echo if enabled
    if pty_echo[id] == 1 {
        pty_master_write(id, byte);
    }
    return 0;
}

fn pty_master_read(id) {
    if pty_s2m_count[id] == 0 { return 0 - 1; }
    // let addr = pty_buf_addr(id, 1) + pty_s2m_rpos[id];
    // let byte = mem_read_u8(addr);
    let byte = 0;
    pty_s2m_rpos[id] = (pty_s2m_rpos[id] + 1) % PTY_BUF_SIZE;
    pty_s2m_count[id] = pty_s2m_count[id] - 1;
    return byte;
}

fn pty_set_raw(id) {
    pty_line_mode[id] = 0;
    pty_echo[id] = 0;
    return 0;
}

fn pty_set_cooked(id) {
    pty_line_mode[id] = 1;
    pty_echo[id] = 1;
    return 0;
}

print("pty.hl loaded");
print("PTY: " + to_string(PTY_MAX) + " pairs, cooked/raw mode, echo");
