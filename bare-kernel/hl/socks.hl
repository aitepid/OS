// socks.hl -- SOCKS5 Proxy Protocol client (RFC 1928)

let SOCKS_VERSION   = 5;
let SOCKS_PORT      = 1080;

// Auth methods
let SOCKS_AUTH_NONE     = 0;
let SOCKS_AUTH_GSSAPI   = 1;
let SOCKS_AUTH_USERPASS = 2;

// Commands
let SOCKS_CMD_CONNECT  = 1;
let SOCKS_CMD_BIND     = 2;
let SOCKS_CMD_UDP_ASSOC = 3;

// Address types
let SOCKS_ATYP_IPV4   = 1;
let SOCKS_ATYP_DOMAIN = 3;
let SOCKS_ATYP_IPV6   = 4;

// Reply codes
let SOCKS_REP_SUCCESS         = 0;
let SOCKS_REP_FAILURE         = 1;
let SOCKS_REP_NOT_ALLOWED     = 2;
let SOCKS_REP_NET_UNREACHABLE = 3;
let SOCKS_REP_HOST_UNREACHABLE = 4;
let SOCKS_REP_CONN_REFUSED    = 5;
let SOCKS_REP_TTL_EXPIRED     = 6;
let SOCKS_REP_CMD_NOT_SUPPORTED = 7;
let SOCKS_REP_ATYP_NOT_SUPPORTED = 8;

// Buffers
let socks_req_buf      = array(256, 0);
let socks_resp_buf     = array(16, 0);
let socks_auth_buf     = array(256, 0);
let socks_auth_resp    = array(4, 0);
let socks_conn_req     = array(512, 0);
let socks_conn_resp    = array(256, 0);
let socks_ip_parts     = array(4, 0);
let socks_sockaddr     = array(16, 0);
let socks_username_buf = array(64, 0);
let socks_password_buf = array(64, 0);
let socks_proxy_ip     = array(4, 0);

// State
let mut socks_proxy_port        = 1080;
let mut socks_proxy_configured  = 0;
let mut socks_username_len      = 0;
let mut socks_password_len      = 0;
let mut socks_socket            = 0 - 1;

fn socks_init() {
    socks_proxy_port       = SOCKS_PORT;
    socks_proxy_configured = 0;
    socks_username_len     = 0;
    socks_password_len     = 0;
    socks_socket           = 0 - 1;
    print("SOCKS5 client ready");
    return 0;
}

fn _socks_parse_ip(ip_str, ip_len) {
    let mut part_idx = 0;
    let mut num      = 0;
    let mut i = 0;
    set_at(socks_ip_parts, 0, 0);
    set_at(socks_ip_parts, 1, 0);
    set_at(socks_ip_parts, 2, 0);
    set_at(socks_ip_parts, 3, 0);
    while i < ip_len {
        let mut ch = ip_str[i];
        if ch == 46 {
            set_at(socks_ip_parts, part_idx, num);
            part_idx = part_idx + 1;
            num = 0;
        } else {
            if ch >= 48 {
                if ch <= 57 {
                    num = num * 10 + ch - 48;
                }
            }
        }
        i = i + 1;
    }
    set_at(socks_ip_parts, part_idx, num);
    return 0;
}

fn _socks_is_ip(str, str_len) {
    let mut i        = 0;
    let mut dots     = 0;
    let mut has_digit = 0;
    let mut is_ip    = 1;
    while i < str_len {
        let mut ch = str[i];
        if ch >= 48 {
            if ch <= 57 { has_digit = 1; }
        } else {
            if ch == 46 { dots = dots + 1; }
            else        { is_ip = 0; }
        }
        i = i + 1;
    }
    if dots != 3 { is_ip = 0; }
    if has_digit == 0 { is_ip = 0; }
    return is_ip;
}

fn socks_set_proxy(host, host_len, port) {
    _socks_parse_ip(host, host_len);
    socks_proxy_port       = port;
    socks_proxy_configured = 1;
    return 0;
}

fn socks_set_auth(username, ulen, password, plen) {
    let mut i = 0;
    while i < ulen {
        if i < 64 { set_at(socks_username_buf, i, username[i]); }
        i = i + 1;
    }
    socks_username_len = ulen;
    i = 0;
    while i < plen {
        if i < 64 { set_at(socks_password_buf, i, password[i]); }
        i = i + 1;
    }
    socks_password_len = plen;
    return 0;
}

fn _socks_build_sockaddr() {
    set_at(socks_sockaddr, 0, 2);
    set_at(socks_sockaddr, 1, 0);
    set_at(socks_sockaddr, 2, socks_proxy_port / 256);
    set_at(socks_sockaddr, 3, socks_proxy_port % 256);
    set_at(socks_sockaddr, 4, socks_ip_parts[0]);
    set_at(socks_sockaddr, 5, socks_ip_parts[1]);
    set_at(socks_sockaddr, 6, socks_ip_parts[2]);
    set_at(socks_sockaddr, 7, socks_ip_parts[3]);
    let mut i = 8;
    while i < 16 {
        set_at(socks_sockaddr, i, 0);
        i = i + 1;
    }
    return 0;
}

fn _socks_auth_userpass(sock) {
    let mut pos = 0;
    set_at(socks_auth_buf, pos, 1);
    pos = pos + 1;
    set_at(socks_auth_buf, pos, socks_username_len);
    pos = pos + 1;
    let mut i = 0;
    while i < socks_username_len {
        set_at(socks_auth_buf, pos, socks_username_buf[i]);
        pos = pos + 1;
        i = i + 1;
    }
    set_at(socks_auth_buf, pos, socks_password_len);
    pos = pos + 1;
    i = 0;
    while i < socks_password_len {
        set_at(socks_auth_buf, pos, socks_password_buf[i]);
        pos = pos + 1;
        i = i + 1;
    }
    let mut sent = send(sock, socks_auth_buf, pos, 0);
    if sent != pos { return 0 - 1; }
    let mut received = recv(sock, socks_auth_resp, 2, 0);
    if received != 2 { return 0 - 2; }
    if socks_auth_resp[1] != 0 { return 0 - 3; }
    return 0;
}

fn _socks_handshake(sock) {
    let mut pos = 0;
    set_at(socks_req_buf, pos, SOCKS_VERSION);
    pos = pos + 1;
    let mut num_methods = 1;
    if socks_username_len > 0 { num_methods = 2; }
    set_at(socks_req_buf, pos, num_methods);
    pos = pos + 1;
    set_at(socks_req_buf, pos, SOCKS_AUTH_NONE);
    pos = pos + 1;
    if socks_username_len > 0 {
        set_at(socks_req_buf, pos, SOCKS_AUTH_USERPASS);
        pos = pos + 1;
    }
    let mut sent = send(sock, socks_req_buf, pos, 0);
    if sent != pos { return 0 - 1; }
    let mut received = recv(sock, socks_resp_buf, 2, 0);
    if received != 2 { return 0 - 2; }
    if socks_resp_buf[0] != SOCKS_VERSION { return 0 - 3; }
    let mut chosen = socks_resp_buf[1];
    if chosen == 255 { return 0 - 4; }
    if chosen == SOCKS_AUTH_USERPASS {
        return _socks_auth_userpass(sock);
    }
    return 0;
}

fn _socks_request_connect(sock, dest_host, dest_host_len, dest_port) {
    let mut pos = 0;
    set_at(socks_conn_req, pos, SOCKS_VERSION);
    pos = pos + 1;
    set_at(socks_conn_req, pos, SOCKS_CMD_CONNECT);
    pos = pos + 1;
    set_at(socks_conn_req, pos, 0);
    pos = pos + 1;
    if _socks_is_ip(dest_host, dest_host_len) == 1 {
        _socks_parse_ip(dest_host, dest_host_len);
        set_at(socks_conn_req, pos, SOCKS_ATYP_IPV4);
        pos = pos + 1;
        let mut i = 0;
        while i < 4 {
            set_at(socks_conn_req, pos, socks_ip_parts[i]);
            pos = pos + 1;
            i = i + 1;
        }
    } else {
        set_at(socks_conn_req, pos, SOCKS_ATYP_DOMAIN);
        pos = pos + 1;
        set_at(socks_conn_req, pos, dest_host_len);
        pos = pos + 1;
        let mut i = 0;
        while i < dest_host_len {
            set_at(socks_conn_req, pos, dest_host[i]);
            pos = pos + 1;
            i = i + 1;
        }
    }
    set_at(socks_conn_req, pos,     dest_port / 256);
    set_at(socks_conn_req, pos + 1, dest_port % 256);
    pos = pos + 2;
    let mut sent = send(sock, socks_conn_req, pos, 0);
    if sent != pos { return 0 - 1; }
    let mut received = recv(sock, socks_conn_resp, 256, 0);
    if received < 10 { return 0 - 2; }
    if socks_conn_resp[0] != SOCKS_VERSION { return 0 - 3; }
    let mut reply = socks_conn_resp[1];
    if reply != SOCKS_REP_SUCCESS { return 0 - 10 - reply; }
    return 0;
}

fn socks_connect(dest_host, dest_host_len, dest_port) {
    if socks_proxy_configured == 0 {
        print("SOCKS: proxy not configured");
        return 0 - 1;
    }
    let mut sock = socket(2, 1, 0);
    if sock < 0 {
        print("SOCKS: socket creation failed");
        return 0 - 2;
    }
    _socks_build_sockaddr();
    let mut conn_result = connect(sock, socks_sockaddr, 16);
    if conn_result < 0 {
        print("SOCKS: proxy connection failed");
        close(sock);
        return 0 - 3;
    }
    let mut auth_result = _socks_handshake(sock);
    if auth_result < 0 {
        print("SOCKS: handshake failed");
        close(sock);
        return 0 - 4;
    }
    let mut req_result = _socks_request_connect(sock, dest_host, dest_host_len, dest_port);
    if req_result < 0 {
        print("SOCKS: connection request failed");
        close(sock);
        return 0 - 5;
    }
    socks_socket = sock;
    return sock;
}

fn socks_get_error(code) {
    if code == SOCKS_REP_SUCCESS          { return "Success"; }
    if code == SOCKS_REP_FAILURE          { return "General failure"; }
    if code == SOCKS_REP_NOT_ALLOWED      { return "Not allowed"; }
    if code == SOCKS_REP_NET_UNREACHABLE  { return "Network unreachable"; }
    if code == SOCKS_REP_HOST_UNREACHABLE { return "Host unreachable"; }
    if code == SOCKS_REP_CONN_REFUSED     { return "Connection refused"; }
    if code == SOCKS_REP_TTL_EXPIRED      { return "TTL expired"; }
    if code == SOCKS_REP_CMD_NOT_SUPPORTED { return "Command not supported"; }
    if code == SOCKS_REP_ATYP_NOT_SUPPORTED { return "Address type not supported"; }
    return "Unknown error";
}

fn socks_close() {
    if socks_socket >= 0 {
        close(socks_socket);
        socks_socket = 0 - 1;
    }
    return 0;
}

print("socks.hl loaded");
