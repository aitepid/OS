// linear_basis.hl -- XOR Linear Basis (Gaussian Elimination) (iter 342)
// Buffer: 0x18D0000
// XOR linear basis over integers up to 2^30.
// lb_insert(x): insert x; returns 1 if linearly independent, 0 if dependent.
// lb_query_max(): maximum XOR achievable by any subset.
// lb_size(): number of basis vectors.

let LB_BITS   = 30;
let lb_basis  = array(30, 0);
let mut lb_sz     = 0;

fn lb_init() {
    let mut i = 0;
    while i < LB_BITS { set_at(lb_basis, i, 0); i += 1; }
    lb_sz = 0;
    return 0;
}

fn _lb_xor(a, b) {
    let mut result = 0;
    let mut pw = 1;
    let mut i = 0;
    while i < LB_BITS {
        let mut abit = a / pw - (a / pw / 2) * 2;
        let mut bbit = b / pw - (b / pw / 2) * 2;
        let mut xbit = abit + bbit - (abit + bbit) / 2 * 2;
        result = result + xbit * pw;
        pw = pw * 2;
        i += 1;
    }
    return result;
}

fn _lb_bit(x, pos) {
    let mut pw = 1;
    let mut i = 0;
    while i < pos { pw = pw * 2; i += 1; }
    return x / pw - (x / pw / 2) * 2;
}

fn lb_insert(x) {
    let mut i = LB_BITS - 1;
    while i >= 0 {
        if _lb_bit(x, i) == 1 {
            if lb_basis[i] == 0 {
                set_at(lb_basis, i, x);
                lb_sz += 1;
                return 1;
            }
            x = _lb_xor(x, lb_basis[i]);
        }
        i -= 1;
    }
    return 0;
}

fn lb_query_max() {
    let mut res = 0;
    let mut i = LB_BITS - 1;
    while i >= 0 {
        if lb_basis[i] != 0 {
            let mut candidate = _lb_xor(res, lb_basis[i]);
            if candidate > res { res = candidate; }
        }
        i -= 1;
    }
    return res;
}

fn lb_size() {
    return lb_sz;
}

fn lb_test() {
    lb_init();
    // Insert {1,2,3,4}: 3=1 XOR 2 is dependent; basis = {4,2,1}, max = 4 XOR 2 XOR 1 = 7
    let mut r1 = lb_insert(1);
    let mut r2 = lb_insert(2);
    let mut r3 = lb_insert(3);
    let mut r4 = lb_insert(4);
    let mut mx = lb_query_max();
    let mut sz = lb_size();
    print("lb_test: insert(1)=" + to_string(r1) +
          " insert(2)=" + to_string(r2) +
          " insert(3)=" + to_string(r3) +
          " insert(4)=" + to_string(r4) +
          " max_xor=" + to_string(mx) +
          " size=" + to_string(sz));
    if r1 == 1 {
        if r2 == 1 {
            if r3 == 0 {
                if r4 == 1 {
                    if mx == 7 {
                        if sz == 3 {
                            print("lb_test: PASS");
                            return 1;
                        }
                    }
                }
            }
        }
    }
    print("lb_test: FAIL");
    return 0;
}

print("linear_basis.hl loaded");
