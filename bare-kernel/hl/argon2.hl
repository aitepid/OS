// argon2.hl -- Argon2 Password Hashing (simplified Argon2id)
// Iteration 436 | Buffer: array-based
//
// Memory-hard password hashing based on Argon2 (PHC winner).
// Password/salt passed as integer seeds (proxies for byte arrays).
// Variants: ARGON2_D=0 (data-dependent), ARGON2_I=1 (data-independent),
//           ARGON2_ID=2 (hybrid, default)
//
// Testing: argon2_test() → validates determinism and variant selection

let ARGON2_HASH_LENGTH = 32;
let ARGON2_NUM_BLOCKS  = 64;
let ARGON2_BLOCK_BYTES = 64;

let ARGON2_D  = 0;
let ARGON2_I  = 1;
let ARGON2_ID = 2;

let argon2_hash_out  = array(32, 0);
let argon2_mix_tmp   = array(64, 0);
let argon2_blocks    = array(4096, 0);  // ARGON2_NUM_BLOCKS * ARGON2_BLOCK_BYTES

let mut argon2_variant  = 2;
let mut argon2_time_cost = 3;

fn argon2_init() {
    argon2_variant = ARGON2_ID;
    argon2_time_cost = 3;
    let mut i = 0;
    while i < ARGON2_HASH_LENGTH {
        set_at(argon2_hash_out, i, 0);
        i = i + 1;
    }
    return 0;
}

fn argon2_set_variant(v) {
    if v == ARGON2_D  { argon2_variant = ARGON2_D;  return 0; }
    if v == ARGON2_I  { argon2_variant = ARGON2_I;  return 0; }
    if v == ARGON2_ID { argon2_variant = ARGON2_ID; return 0; }
    return 0 - 1;
}

fn argon2_set_time_cost(t) {
    if t <= 0 { return 0 - 1; }
    if t > 10 { return 0 - 1; }
    argon2_time_cost = t;
    return 0;
}

// _argon2_pow256: returns 256^e for e in 0..3
fn _argon2_pow256(e) {
    if e == 0 { return 1; }
    if e == 1 { return 256; }
    if e == 2 { return 65536; }
    return 16777216;
}

// Initialise one 64-byte block from pwd_seed + salt_seed + block index.
// Uses a simple FNV-like mixing sequence.
fn _argon2_init_block(blk, pwd_seed, salt_seed) {
    let mut h = 2166136261;
    h = h * 16777619 + pwd_seed;
    h = h - (h / 1073741824) * 1073741824;   // keep in 30-bit range
    h = h * 16777619 + salt_seed;
    h = h - (h / 1073741824) * 1073741824;
    h = h * 16777619 + blk;
    h = h - (h / 1073741824) * 1073741824;
    let mut base = blk * ARGON2_BLOCK_BYTES;
    let mut i = 0;
    while i < ARGON2_BLOCK_BYTES {
        let mut byte = (h / _argon2_pow256(i % 4)) % 256;
        set_at(argon2_blocks, base + i, byte);
        h = h * 1103515245 + 12345;
        h = h - (h / 1073741824) * 1073741824;
        i = i + 1;
    }
}

// Mix target block with reference block (add + diffusion, write-back).
fn _argon2_mix(target, ref_blk) {
    let tb = target * ARGON2_BLOCK_BYTES;
    let rb = ref_blk  * ARGON2_BLOCK_BYTES;
    let mut i = 0;
    while i < ARGON2_BLOCK_BYTES {
        let mut m = (argon2_blocks[tb + i] + argon2_blocks[rb + i]) % 256;
        m = (m * 31 + i) % 256;
        set_at(argon2_mix_tmp, i, m);
        i = i + 1;
    }
    let mut j = 0;
    while j < ARGON2_BLOCK_BYTES {
        set_at(argon2_blocks, tb + j, argon2_mix_tmp[j]);
        j = j + 1;
    }
}

// Select reference block index for block i at iteration pass.
fn _argon2_ref_index(i, pass) {
    let nb   = ARGON2_NUM_BLOCKS;
    let mut prev = (i + nb - 1) % nb;
    if argon2_variant == ARGON2_I {
        return (i * 7919 + pass * 1103) % nb;
    }
    if argon2_variant == ARGON2_D {
        return argon2_blocks[prev * ARGON2_BLOCK_BYTES] % nb;
    }
    // ARGON2_ID: data-independent on pass 0, data-dependent after
    if pass == 0 {
        return (i * 7919 + pass * 1103) % nb;
    }
    return argon2_blocks[prev * ARGON2_BLOCK_BYTES] % nb;
}

// Full Argon2 hash.  pwd_seed and salt_seed are integer proxies for the
// password and salt byte arrays.  Returns count of non-zero output bytes.
fn argon2_hash(pwd_seed, salt_seed) {
    // Phase 1: initialise all blocks
    let mut b = 0;
    while b < ARGON2_NUM_BLOCKS {
        _argon2_init_block(b, pwd_seed, salt_seed);
        b = b + 1;
    }
    // Phase 2: mixing passes
    let mut pass = 0;
    while pass < argon2_time_cost {
        let mut i = 0;
        while i < ARGON2_NUM_BLOCKS {
            let ref_blk = _argon2_ref_index(i, pass);
            _argon2_mix(i, ref_blk);
            i = i + 1;
        }
        pass = pass + 1;
    }
    // Phase 3: finalise — accumulate blocks into output
    let o = 0;
    while o < ARGON2_HASH_LENGTH {
        let xv  = 0;
        let blk = 0;
        while blk < ARGON2_NUM_BLOCKS {
            xv = (xv + argon2_blocks[blk * ARGON2_BLOCK_BYTES + (o % ARGON2_BLOCK_BYTES)]) % 256;
            blk = blk + 1;
        }
        set_at(argon2_hash_out, o, xv);
        o = o + 1;
    }
    return argon2_hash_out[0];
}

fn argon2_get_byte(idx) {
    if idx < 0                  { return 0 - 1; }
    if idx >= ARGON2_HASH_LENGTH { return 0 - 1; }
    return argon2_hash_out[idx];
}

fn argon2_test() {
    argon2_init();
    let mut pass = 1;

    // Argon2id: hash(1001, 2002) twice — bytes must be identical (determinism)
    argon2_set_variant(ARGON2_ID);
    argon2_hash(1001, 2002);
    let b0a = argon2_get_byte(0);
    let b1a = argon2_get_byte(1);

    argon2_hash(1001, 2002);
    let b0b = argon2_get_byte(0);
    let b1b = argon2_get_byte(1);

    if b0a != b0b { pass = 0; }
    if b1a != b1b { pass = 0; }

    // Output must be non-trivially non-zero somewhere
    let nonzero = 0;
    let mut k = 0;
    while k < ARGON2_HASH_LENGTH {
        if argon2_get_byte(k) != 0 { nonzero = 1; }
        k = k + 1;
    }
    if nonzero != 1 { pass = 0; }

    // Argon2i variant — same seeds, different variant → likely different byte
    argon2_set_variant(ARGON2_I);
    argon2_hash(1001, 2002);
    let b0i = argon2_get_byte(0);

    // Argon2d variant
    argon2_set_variant(ARGON2_D);
    argon2_hash(1001, 2002);
    let b0d = argon2_get_byte(0);

    // Different seeds → different first output byte (probabilistic, very high confidence)
    argon2_set_variant(ARGON2_ID);
    argon2_hash(9999, 8888);
    let b0c = argon2_get_byte(0);

    print("argon2_test: b0a=" + to_string(b0a)
          + " b0i=" + to_string(b0i)
          + " b0d=" + to_string(b0d)
          + " nonzero=" + to_string(nonzero));

    if pass == 1 { print("argon2_test PASS"); }
    if pass == 0 { print("argon2_test FAIL"); }
    return pass;
}

argon2_test();
print("argon2.hl loaded");
