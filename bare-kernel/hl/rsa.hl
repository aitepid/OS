// rsa.hl - RSA Asymmetric Encryption (simplified)
// Implements basic RSA encryption and decryption

// Output string buffers (replace fixed-address memory regions)
let rsa_pub_buf   = array(256, 0);   // Public key formatted string
let rsa_priv_buf  = array(256, 0);   // Private key formatted string
let rsa_digits    = array(32,  0);   // Digit scratch for number formatting

// Constants
let RSA_KEY_SIZE   = 512;   // bits (simplified; production uses 2048+)
let RSA_BLOCK_SIZE = 64;    // bytes

// Mutable RSA key components
let mut rsa_n = 0;   // Modulus (public)
let mut rsa_e = 0;   // Public exponent
let mut rsa_d = 0;   // Private exponent
let mut rsa_p = 0;   // Prime p
let mut rsa_q = 0;   // Prime q

fn rsa_init() {
    rsa_n = 0;
    rsa_e = 65537;   // Common public exponent F4
    rsa_d = 0;
    rsa_p = 0;
    rsa_q = 0;
    print("RSA encryption ready");
    return 0;
}

// Generate RSA key pair using small demonstration primes (not cryptographically secure)
fn rsa_generate_keys() {
    rsa_p = 61;
    rsa_q = 53;

    // n = p * q
    rsa_n = rsa_p * rsa_q;   // 3233

    // phi(n) = (p-1)(q-1)
    let mut phi = (rsa_p - 1) * (rsa_q - 1);   // 3120

    // Choose e coprime with phi
    rsa_e = 17;

    // Compute d = e^-1 mod phi(n)
    rsa_d = _rsa_mod_inverse(rsa_e, phi);

    if rsa_d == 0 {
        print("RSA: key generation failed");
        return 0 - 1;
    }

    return 0;
}

// Set public key components manually
fn rsa_set_public_key(n, e) {
    rsa_n = n;
    rsa_e = e;
    return 0;
}

// Set private key components manually
fn rsa_set_private_key(n, d) {
    rsa_n = n;
    rsa_d = d;
    return 0;
}

// Encrypt first byte of message string with public key
// Returns ciphertext c = m^e mod n, or negative on error
fn rsa_encrypt(message) {
    if rsa_n == 0 || rsa_e == 0 {
        print("RSA: public key not set");
        return 0 - 1;
    }

    let mut m = 0;
    if len(message) > 0 {
        m = message[0];
    }

    let mut c = _rsa_mod_exp(m, rsa_e, rsa_n);
    return c;
}

// Decrypt ciphertext with private key
// Returns plaintext m = c^d mod n, or negative on error
fn rsa_decrypt(ciphertext) {
    if rsa_n == 0 || rsa_d == 0 {
        print("RSA: private key not set");
        return 0 - 1;
    }

    let mut m = _rsa_mod_exp(ciphertext, rsa_d, rsa_n);
    return m;
}

// Modular exponentiation: base^exp mod modulus  (square-and-multiply)
fn _rsa_mod_exp(base, exp, modulus) {
    let mut result = 1;
    let mut b = base % modulus;
    let mut e = exp;

    while e > 0 {
        if e % 2 == 1 {
            result = (result * b) % modulus;
        }
        e = e / 2;
        b = (b * b) % modulus;
    }

    return result;
}

// Extended Euclidean algorithm: returns d such that  a*d ≡ 1 (mod m)
// Returns 0 if inverse does not exist
fn _rsa_mod_inverse(a, m) {
    let mut m0 = m;
    let mut x0 = 0;
    let mut x1 = 1;
    let mut aa = a;
    let mut mm = m;

    if mm == 1 {
        return 0;
    }

    while aa > 1 {
        let mut q = aa / mm;
        let mut t = mm;
        mm = aa % mm;
        aa = t;
        let mut tx = x0;
        x0 = x1 - q * x0;
        x1 = tx;
    }

    if x1 < 0 {
        x1 = x1 + m0;
    }

    return x1;
}

// Return public key info formatted in rsa_pub_buf
fn rsa_get_public_key() {
    let mut pos = 0;
    pos = _rsa_append_str(rsa_pub_buf, pos, "n=");
    pos = _rsa_append_num(rsa_pub_buf, pos, rsa_n);
    pos = _rsa_append_str(rsa_pub_buf, pos, ", e=");
    pos = _rsa_append_num(rsa_pub_buf, pos, rsa_e);
    set_at(rsa_pub_buf, pos, 0);
    return rsa_pub_buf;
}

// Return private key info formatted in rsa_priv_buf
fn rsa_get_private_key() {
    let mut pos = 0;
    pos = _rsa_append_str(rsa_priv_buf, pos, "n=");
    pos = _rsa_append_num(rsa_priv_buf, pos, rsa_n);
    pos = _rsa_append_str(rsa_priv_buf, pos, ", d=");
    pos = _rsa_append_num(rsa_priv_buf, pos, rsa_d);
    set_at(rsa_priv_buf, pos, 0);
    return rsa_priv_buf;
}

// Helper: copy str bytes into buf starting at pos; return updated pos
fn _rsa_append_str(buf, pos, str) {
    let mut slen = len(str);
    let mut i = 0;
    let mut p = pos;
    while i < slen {
        set_at(buf, p, str[i]);
        p = p + 1;
        i = i + 1;
    }
    return p;
}

// Helper: write decimal representation of num into buf at pos; return updated pos
fn _rsa_append_num(buf, pos, num) {
    if num == 0 {
        set_at(buf, pos, 48);
        return pos + 1;
    }

    let mut d_pos = 0;
    let mut is_negative = 0;
    let mut n = num;
    let mut p = pos;

    if n < 0 {
        is_negative = 1;
        n = 0 - n;
    }

    while n > 0 {
        set_at(rsa_digits, d_pos, 48 + (n % 10));
        n = n / 10;
        d_pos = d_pos + 1;
    }

    if is_negative == 1 {
        set_at(buf, p, 45);   // '-'
        p = p + 1;
    }

    // Write digits in reverse order (most-significant first)
    while d_pos > 0 {
        d_pos = d_pos - 1;
        set_at(buf, p, rsa_digits[d_pos]);
        p = p + 1;
    }

    return p;
}

// Return modulus n
fn rsa_get_n() {
    return rsa_n;
}

// Return public exponent e
fn rsa_get_e() {
    return rsa_e;
}

// Return private exponent d
fn rsa_get_d() {
    return rsa_d;
}

// Self-test: generate keys, encrypt '*' (ASCII 42), decrypt, verify round-trip
fn rsa_test() {
    let mut result = rsa_generate_keys();
    if result < 0 {
        print("RSA test: key generation failed");
        return 0 - 1;
    }

    let mut plaintext = 42;

    let mut ciphertext = rsa_encrypt("*");   // ASCII 42 = '*'
    if ciphertext < 0 {
        print("RSA test: encryption failed");
        return 0 - 2;
    }

    let mut decrypted = rsa_decrypt(ciphertext);
    if decrypted < 0 {
        print("RSA test: decryption failed");
        return 0 - 3;
    }

    if decrypted != plaintext {
        print("RSA test: plaintext mismatch");
        return 0 - 4;
    }

    print("RSA test: passed");
    return 0;
}

rsa_test();
print("rsa.hl loaded");
