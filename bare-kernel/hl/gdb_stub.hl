// gdb_stub.hl -- GDB Remote Protocol Stub (Phase 7: 生态与自举完善, iter 431)
// Buffer: 0x1E60000
//
// Implements GDB RSP (Remote Serial Protocol) with packet framing:
//   Packet format: $<data>#<checksum-2hex>
//   Checksum = 8-bit sum of all data bytes, mod 256
//   ACK = '+' (43), NACK = '-' (45)
//
// Commands: HALT/CONT/STEP/READ_REG/WRITE_REG (same as before)
// gs_regs[8]: simulated register file r0..r7
// GS_MAX_PKTS=16: packet log
//
// Shell: gs init/test/pkt/reg/wreg/count/halted/parse/checksum (9 commands)

let GS_MAX_PKTS    = 16;
let GS_CMD_HALT      = 0;
let GS_CMD_CONT      = 1;
let GS_CMD_STEP      = 2;
let GS_CMD_READ_REG  = 3;
let GS_CMD_WRITE_REG = 4;

// RSP status codes returned by gdb_parse_packet
let GS_PKT_OK       = 0;   // valid packet, checksums match
let GS_PKT_BAD_CK   = 1;   // checksum mismatch
let GS_PKT_EMPTY    = 2;   // no $ found or zero-length data
let GS_PKT_ACK      = 43;  // '+' ack byte value
let GS_PKT_NACK     = 45;  // '-' nack byte value

let gs_pkt_cmd    = array(16, 0);   // command type per packet
let gs_pkt_arg    = array(16, 0);   // argument per packet
let gs_pkt_result = array(16, 0);   // result per packet

// RSP framing state for the most-recently parsed packet
let gs_last_data_len  = 0;   // byte count of last packet data field
let gs_last_checksum  = 0;   // computed checksum of last packet
let gs_last_status    = 0;   // GS_PKT_OK / GS_PKT_BAD_CK / GS_PKT_EMPTY

// Outgoing reply buffer (integer-encoded: reply_buf[0..GS_REPLY_LEN-1])
let GS_REPLY_LEN   = 32;
let gs_reply_buf   = array(32, 0);
let gs_reply_len   = 0;

let gs_regs       = array(8, 0);    // simulated registers r0..r7
let gs_n_pkts     = 0;
let gs_halted     = 0;

fn gdb_stub_init() {
    let i = 0;
    while i < GS_MAX_PKTS {
        set_at(gs_pkt_cmd,    i, 0);
        set_at(gs_pkt_arg,    i, 0);
        set_at(gs_pkt_result, i, 0);
        i += 1;
    }
    let j = 0;
    while j < 8 {
        set_at(gs_regs, j, 0);
        j += 1;
    }
    let k = 0;
    while k < GS_REPLY_LEN {
        set_at(gs_reply_buf, k, 0);
        k += 1;
    }
    gs_n_pkts        = 0;
    gs_halted        = 0;
    gs_last_data_len = 0;
    gs_last_checksum = 0;
    gs_last_status   = 0;
    gs_reply_len     = 0;
    return 0;
}

fn gs_read_reg(reg_idx)       { return gs_regs[reg_idx]; }
fn gs_write_reg(reg_idx, val) { set_at(gs_regs, reg_idx, val); return val; }

// Compute 8-bit GDB RSP checksum over an integer array `data` of `len` bytes.
// Each element is treated as one byte (0-255).
fn gdb_checksum(data, len) {
    let sum = 0;
    let i   = 0;
    while i < len {
        sum = sum + data[i];
        i += 1;
    }
    // mod 256: sum - (sum/256)*256
    let mod256 = sum - (sum / 256) * 256;
    return mod256;
}

// Parse a GDB RSP packet stored as integer array `raw` of `raw_len` bytes.
// Expects format: '$' data... '#' hi lo   (hi,lo are ASCII hex digits)
// Populates gs_last_data_len, gs_last_checksum, gs_last_status.
// Returns GS_PKT_OK on success, GS_PKT_BAD_CK on mismatch, GS_PKT_EMPTY if malformed.
fn gdb_parse_packet(raw, raw_len) {
    // Find '$' (36)
    let data_start = 0 - 1;
    let i = 0;
    while i < raw_len {
        if raw[i] == 36 {
            data_start = i + 1;
        }
        i += 1;
    }
    if data_start < 0 {
        set_at(gs_last_status, 0, GS_PKT_EMPTY);
        return GS_PKT_EMPTY;
    }

    // Find '#' (35) after data_start
    let hash_pos = 0 - 1;
    let j = data_start;
    while j < raw_len {
        if raw[j] == 35 {
            hash_pos = j;
        }
        j += 1;
    }
    if hash_pos < 0 {
        set_at(gs_last_status, 0, GS_PKT_EMPTY);
        return GS_PKT_EMPTY;
    }

    let data_len = hash_pos - data_start;
    set_at(gs_last_data_len, 0, data_len);

    // Extract data slice starting at data_start for gdb_checksum
    // We compute checksum over raw[data_start .. hash_pos-1]
    // Build a temporary view by re-computing using raw directly
    let computed = 0;
    let k = data_start;
    while k < hash_pos {
        computed = computed + raw[k];
        k += 1;
    }
    let ck = computed - (computed / 256) * 256;
    set_at(gs_last_checksum, 0, ck);

    // Decode two ASCII hex digits after '#' into expected checksum
    let hi = 0;
    let lo = 0;
    if hash_pos + 1 < raw_len { hi = raw[hash_pos + 1]; }
    if hash_pos + 2 < raw_len { lo = raw[hash_pos + 2]; }

    // ASCII '0'-'9'=48-57, 'a'-'f'=97-102, 'A'-'F'=65-70
    fn hex_digit(ch) {
        if ch >= 48 {
            if ch <= 57 {
                return ch - 48;
            }
        }
        if ch >= 65 {
            if ch <= 70 {
                return ch - 55;
            }
        }
        if ch >= 97 {
            if ch <= 102 {
                return ch - 87;
            }
        }
        return 0;
    }

    let expected = hex_digit(hi) * 16 + hex_digit(lo);

    if ck == expected {
        set_at(gs_last_status, 0, GS_PKT_OK);
        return GS_PKT_OK;
    }
    set_at(gs_last_status, 0, GS_PKT_BAD_CK);
    return GS_PKT_BAD_CK;
}

fn gs_get_last_status()   { return gs_last_status; }
fn gs_get_last_checksum() { return gs_last_checksum; }
fn gs_get_last_data_len() { return gs_last_data_len; }

// Encode a reply value into the gs_reply_buf as "$<hex-value>#<checksum>".
// Uses decimal encoding (simplified — real RSP uses hex).
// Stores byte values in gs_reply_buf; sets gs_reply_len.
fn gdb_encode_reply(value) {
    // Frame: $ value # ck
    // Encode value as decimal digits into reply buffer
    set_at(gs_reply_buf, 0, 36);   // '$'
    // Convert value to digit string (up to 10 digits)
    let digits = array(10, 0);
    let ndig   = 0;
    let v      = value;
    if v == 0 {
        set_at(digits, 0, 0);
        ndig = 1;
    }
    if v != 0 {
        while v > 0 {
            let d = v - (v / 10) * 10;
            set_at(digits, ndig, d);
            ndig = ndig + 1;
            v = v / 10;
        }
    }
    // Reverse digits into reply_buf[1..]
    let pos = 1;
    let di  = ndig - 1;
    while di >= 0 {
        set_at(gs_reply_buf, pos, 48 + digits[di]);   // ASCII '0'+d
        pos = pos + 1;
        di  = di - 1;
    }
    set_at(gs_reply_buf, pos, 35);   // '#'
    pos = pos + 1;
    // Compute checksum of data portion (reply_buf[1..pos-2])
    let ck_sum = 0;
    let ci = 1;
    while ci < pos - 1 {
        ck_sum = ck_sum + gs_reply_buf[ci];
        ci += 1;
    }
    let ck = ck_sum - (ck_sum / 256) * 256;
    // Write two hex digits
    let hi = ck / 16;
    let lo = ck - hi * 16;
    fn nibble_to_hex(n) {
        if n < 10 { return 48 + n; }
        return 87 + n;   // 'a' - 10 + n
    }
    set_at(gs_reply_buf, pos,     nibble_to_hex(hi));
    set_at(gs_reply_buf, pos + 1, nibble_to_hex(lo));
    set_at(gs_reply_len, 0, pos + 2);
    return pos + 2;
}

fn gs_get_reply_len() { return gs_reply_len; }

fn gs_send_pkt(cmd, arg) {
    if gs_n_pkts >= GS_MAX_PKTS { return 0 - 1; }
    let slot = gs_n_pkts;
    set_at(gs_pkt_cmd, slot, cmd);
    set_at(gs_pkt_arg, slot, arg);
    let result = 0;
    if cmd == GS_CMD_HALT      { gs_halted = 1; result = 1; }
    if cmd == GS_CMD_CONT      { gs_halted = 0; result = 0; }
    if cmd == GS_CMD_STEP      { gs_halted = 1; result = 1; }
    if cmd == GS_CMD_READ_REG  { result = gs_regs[arg]; }
    if cmd == GS_CMD_WRITE_REG { result = 0; }
    set_at(gs_pkt_result, slot, result);
    gs_n_pkts += 1;
    gdb_encode_reply(result);
    return result;
}

fn gs_get_result(pkt_idx) {
    if pkt_idx >= gs_n_pkts { return 0 - 1; }
    return gs_pkt_result[pkt_idx];
}

fn gs_count()     { return gs_n_pkts; }
fn gs_is_halted() { return gs_halted; }

fn gs_test() {
    gdb_stub_init();
    let pass = 1;

    gs_write_reg(0, 1000);
    gs_write_reg(1, 2000);

    // Send READ_REG(0) → result=1000
    let r0 = gs_send_pkt(GS_CMD_READ_REG, 0);
    if r0 != 1000 { pass = 0; }

    // Send STEP → halted=1
    gs_send_pkt(GS_CMD_STEP, 0);
    let n_pkts  = gs_count();
    let halted  = gs_is_halted();
    let reg0    = gs_read_reg(0);
    let reg1    = gs_read_reg(1);
    let res0    = gs_get_result(0);

    if n_pkts != 2  { pass = 0; }
    if halted != 1  { pass = 0; }
    if reg0 != 1000 { pass = 0; }
    if reg1 != 2000 { pass = 0; }
    if res0 != 1000 { pass = 0; }

    // Test gdb_checksum: data = [72, 101, 108] → sum=281 → 281 mod 256 = 25
    let sample = array(3, 0);
    set_at(sample, 0, 72);
    set_at(sample, 1, 101);
    set_at(sample, 2, 108);
    let ck = gdb_checksum(sample, 3);
    if ck != 25 { pass = 0; }

    // Test gdb_encode_reply: encode 42 → buf[0]='$' (36)
    gdb_encode_reply(42);
    let rlen = gs_get_reply_len();
    if gs_reply_buf[0] != 36 { pass = 0; }
    if rlen < 4 { pass = 0; }   // at minimum: $ 4 2 # hi lo = 6 bytes

    // Test gdb_parse_packet: build packet for "c" (99) data with checksum 99
    // Packet: $ c # 6 3   → 36 99 35 54 51
    let pkt = array(5, 0);
    set_at(pkt, 0, 36);   // '$'
    set_at(pkt, 1, 99);   // 'c'
    set_at(pkt, 2, 35);   // '#'
    set_at(pkt, 3, 54);   // '6'
    set_at(pkt, 4, 51);   // '3'  → 0x63 = 99
    let parse_result = gdb_parse_packet(pkt, 5);
    if parse_result != GS_PKT_OK { pass = 0; }
    let parsed_ck = gs_get_last_checksum();
    if parsed_ck != 99 { pass = 0; }   // data byte 'c'=99; 99 mod 256 = 99

    print("gs_test: r0=" + to_string(r0)
          + " n=" + to_string(n_pkts)
          + " halted=" + to_string(halted)
          + " ck=" + to_string(ck)
          + " rlen=" + to_string(rlen)
          + " parse=" + to_string(parse_result));

    if pass == 1 { print("gs_test: PASS"); }
    if pass == 0 { print("gs_test: FAIL"); }
    return pass;
}

print("gdb_stub.hl loaded");
