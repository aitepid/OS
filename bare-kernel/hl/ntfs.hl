    // Parse B-tree index entries
    // Each entry: MFT ref (8) + entry length (2) + name offset (2) + flags (2) + name
    let mut entries = [];
    return entries;
}

// Resolve path: split by '\', walk from root (MFT record 5)
fn ntfs_resolve(path) {
