// Read file data from $DATA attribute
fn ntfs_read_file(record_num, max_size) {
    let mft = ntfs_read_mft(record_num);
    if len(mft) == 0 { return []; }
    let attr_off = ntfs_find_attr(mft, 128); // 0x80 = $DATA
    if attr_off < 0 { return []; }
    // Check resident vs non-resident
    // If resident: copy inline data
    // If non-resident: decode data runs, read clusters
    return [];
}

// List directory (MFT record 5 = root directory)
fn ntfs_list_dir(dir_record) {
