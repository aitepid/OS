// vdesktop.hl -- 虚拟桌面（Sprint G7）
//
// 最多 8 个虚拟桌面。每个窗口归属一个 vdesktop_id（默认 0）。切换桌面
// 时 wm 只渲染属于当前桌面的窗口；其余被压入对应桌面的列表。
// 切换有 250 ms 横向滑动动画（通过 anim 系统）。

let VDT_MAX = 8;
let VDT_WIN_MAX = 64;       // 全局窗口槽（外部 wm 提供）

let mut vdt_initialized = 0;
let mut vdt_count       = 4;        // 默认 4 个
let mut vdt_current     = 0;
let mut vdt_anim_offset = 0;        // 切换时 X 偏移（动画）
let mut vdt_win_assign  = [0];      // 每个 wm 窗口的 vdesktop id

fn vdesktop_init() {
    if vdt_initialized == 1 { return 0; }
    vdt_win_assign = array_new(VDT_WIN_MAX, 0);
    vdt_current = 0;
    vdt_anim_offset = 0;
    vdt_initialized = 1;
    print("vdesktop: 4 virtual desktops");
    return 0;
}

fn vdesktop_count_get()   { return vdt_count; }
fn vdesktop_current_get() { return vdt_current; }

fn vdesktop_count_set(n) {
    if n < 1 { n = 1; }
    if n > VDT_MAX { n = VDT_MAX; }
    vdt_count = n;
    if vdt_current >= n { vdt_current = n - 1; }
    return 0;
}

fn vdesktop_assign_window(win_id, vd) {
    if vdt_initialized == 0 { vdesktop_init(); }
    if win_id < 0 { return 0; }
    if win_id >= VDT_WIN_MAX { return 0; }
    if vd < 0 { vd = 0; }
    if vd >= vdt_count { vd = vdt_count - 1; }
    vdt_win_assign[win_id] = vd;
    return 0;
}

fn vdesktop_window_visible(win_id) {
    if win_id < 0 { return 0; }
    if win_id >= VDT_WIN_MAX { return 0; }
    if vdt_win_assign[win_id] == vdt_current { return 1; }
    return 0;
}

fn vdesktop_switch_to(vd) {
    if vdt_initialized == 0 { vdesktop_init(); }
    if vd < 0 { return 0; }
    if vd >= vdt_count { return 0; }
    if vd == vdt_current { return 0; }
    let mut sw = vesa_width;  if sw == 0 { sw = 1024; }
    // 滑动方向
    let mut dir = 1;
    if vd < vdt_current { dir = 0 - 1; }
    vdt_anim_offset = dir * sw;
    vdt_current = vd;
    anim_start(ANIM_TARGET_WM, 0, ANIM_PROP_X, vdt_anim_offset, 0, 250,
               ANIM_EASE_OUT);
    return 1;
}

fn vdesktop_next() {
    let mut nxt = vdt_current + 1;
    if nxt >= vdt_count { nxt = 0; }
    return vdesktop_switch_to(nxt);
}

fn vdesktop_prev() {
    let mut prv = vdt_current - 1;
    if prv < 0 { prv = vdt_count - 1; }
    return vdesktop_switch_to(prv);
}

// 切换器条：在 Mission Control 顶部绘制 4 个缩略矩形
fn vdesktop_switcher_paint(screen_w, y) {
    if vdt_initialized == 0 { vdesktop_init(); }
    let mut tile_w = 120;
    let mut tile_h = 68;
    let mut gap = 12;
    let mut total = vdt_count * tile_w + (vdt_count - 1) * gap;
    let mut sx = (screen_w - total) / 2;
    let mut i = 0;
    while i < vdt_count {
        let mut tx = sx + i * (tile_w + gap);
        let mut bg = ui_theme_bg_elevated();
        if i == vdt_current { bg = ui_theme_accent_get(); }
        gfx_rect_round(tx, y, tile_w, tile_h, 8, bg);
        let mut s = to_string(i + 1);
        font_atlas_draw_str(tx + 8, y + 6, s, 13, ui_theme_text_primary());
        i = i + 1;
    }
    return 0;
}

print("vdesktop.hl loaded");
