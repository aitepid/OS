# bzip2.hl - bzip2 Compression (simplified)
# Implements simplified bzip2 compression using Burrows-Wheeler Transform

# Memory layout
global BZIP2_BUF = 0x1220000
global BZIP2_BLOCK_SIZE = 900000  # 900KB blocks (bzip2 default)
global BZIP2_MAGIC = 0x425A  # "BZ" magic header

# State
global bzip2_output = 0
global bzip2_output_len = 0
global bzip2_block_crc = 0

fn bzip2_init() {
    bzip2_output = BZIP2_BUF + 262144
    bzip2_output_len = 0
    bzip2_block_crc = 0
    serial_print("bzip2 compression ready")
}

# Compress data (simplified bzip2)
fn bzip2_compress(data, len) {
    var output = bzip2_output
    var pos = 0

    # bzip2 header (10 bytes)
    # Magic "BZ" (2 bytes)
    set_at(output, pos, 66)  # 'B'
    set_at(output, pos + 1, 90)  # 'Z'
    pos = pos + 2

    # Version 'h' for bzip2
    set_at(output, pos, 104)  # 'h'
    pos = pos + 1

    # Block size '9' (900k)
    set_at(output, pos, 57)  # '9'
    pos = pos + 1

    # Stream header (6 bytes): 0x314159265359 (π as magic)
    set_at(output, pos, 0x31)
    set_at(output, pos + 1, 0x41)
    set_at(output, pos + 2, 0x59)
    set_at(output, pos + 3, 0x26)
    set_at(output, pos + 4, 0x53)
    set_at(output, pos + 5, 0x59)
    pos = pos + 6

    # Compress data using simplified BWT + RLE
    var compressed_len = _bzip2_compress_block(data, len, output, pos)
    pos = pos + compressed_len

    # End-of-stream marker (6 bytes): 0x177245385090
    set_at(output, pos, 0x17)
    set_at(output, pos + 1, 0x72)
    set_at(output, pos + 2, 0x45)
    set_at(output, pos + 3, 0x38)
    set_at(output, pos + 4, 0x50)
    set_at(output, pos + 5, 0x90)
    pos = pos + 6

    # Stream CRC (4 bytes)
    var crc = _bzip2_crc32(data, len)
    set_at(output, pos, (crc / 16777216) % 256)
    set_at(output, pos + 1, (crc / 65536) % 256)
    set_at(output, pos + 2, (crc / 256) % 256)
    set_at(output, pos + 3, crc % 256)
    pos = pos + 4

    bzip2_output_len = pos
    return pos
}

# Compress single block (simplified BWT + RLE)
fn _bzip2_compress_block(data, len, output, start_pos) {
    var pos = start_pos

    # Apply Burrows-Wheeler Transform (simplified)
    var bwt_result = _bzip2_bwt(data, len)
    var bwt_data = get_at(bwt_result, 0)
    var bwt_index = get_at(bwt_result, 1)

    # Store BWT index (original position)
    set_at(output, pos, (bwt_index / 16777216) % 256)
    set_at(output, pos + 1, (bwt_index / 65536) % 256)
    set_at(output, pos + 2, (bwt_index / 256) % 256)
    set_at(output, pos + 3, bwt_index % 256)
    pos = pos + 4

    # Apply Run-Length Encoding
    var i = 0
    while (i < len) {
        var byte = get_at(bwt_data, i)
        var run_len = 1

        # Count consecutive identical bytes
        while (i + run_len < len && get_at(bwt_data, i + run_len) == byte) {
            run_len = run_len + 1
            if (run_len >= 255) {
                break
            }
        }

        if (run_len >= 4) {
            # Encode as run
            set_at(output, pos, byte)
            pos = pos + 1
            set_at(output, pos, byte)
            pos = pos + 1
            set_at(output, pos, byte)
            pos = pos + 1
            set_at(output, pos, byte)
            pos = pos + 1
            set_at(output, pos, run_len - 4)
            pos = pos + 1
        } else {
            # Encode as literals
            var j = 0
            while (j < run_len) {
                set_at(output, pos, byte)
                pos = pos + 1
                j = j + 1
            }
        }

        i = i + run_len
    }

    return pos - start_pos
}

# Burrows-Wheeler Transform (simplified)
fn _bzip2_bwt(data, len) {
    var rotations = BZIP2_BUF
    var sorted = BZIP2_BUF + 65536
    var result = BZIP2_BUF + 131072
    var original_index = 0

    # Limit to reasonable size
    if (len > 256) {
        len = 256
    }

    # Generate all rotations (simplified - store indices)
    var i = 0
    while (i < len) {
        set_at(rotations, i, i)
        i = i + 1
    }

    # Sort rotations lexicographically (bubble sort for simplicity)
    i = 0
    while (i < len - 1) {
        var j = 0
        while (j < len - i - 1) {
            var rot1 = get_at(rotations, j)
            var rot2 = get_at(rotations, j + 1)

            if (_bzip2_compare_rotation(data, len, rot1, rot2) > 0) {
                # Swap
                set_at(rotations, j, rot2)
                set_at(rotations, j + 1, rot1)
            }
            j = j + 1
        }
        i = i + 1
    }

    # Extract last column and find original
    i = 0
    while (i < len) {
        var rot = get_at(rotations, i)
        var last_pos = (rot + len - 1) % len
        var last_char = get_at(data, last_pos)
        set_at(sorted, i, last_char)

        if (rot == 0) {
            original_index = i
        }
        i = i + 1
    }

    set_at(result, 0, sorted)
    set_at(result, 1, original_index)
    return result
}

# Compare two rotations
fn _bzip2_compare_rotation(data, len, rot1, rot2) {
    var i = 0
    while (i < len) {
        var pos1 = (rot1 + i) % len
        var pos2 = (rot2 + i) % len
        var c1 = get_at(data, pos1)
        var c2 = get_at(data, pos2)

        if (c1 < c2) {
            return -1
        }
        if (c1 > c2) {
            return 1
        }
        i = i + 1
    }
    return 0
}

# Simple CRC32 calculation
fn _bzip2_crc32(data, len) {
    var crc = 4294967295  # 0xFFFFFFFF
    var i = 0

    while (i < len) {
        var byte = get_at(data, i)
        crc = (crc * 31 + byte) % 4294967296
        i = i + 1
    }

    return crc
}

# Decompress bzip2 data (simplified)
fn bzip2_decompress(data, len) {
    if (len < 14) {
        serial_print("bzip2: data too short")
        return -1
    }

    # Verify magic header
    if (get_at(data, 0) != 66 || get_at(data, 1) != 90) {  # "BZ"
        serial_print("bzip2: invalid magic")
        return -2
    }

    # Version check
    if (get_at(data, 2) != 104) {  # 'h'
        serial_print("bzip2: unsupported version")
        return -3
    }

    # Skip header and decompress
    var pos = 10  # After header
    var output = bzip2_output
    var out_pos = 0

    # Read BWT index
    var bwt_index = get_at(data, pos) * 16777216 + get_at(data, pos + 1) * 65536 + get_at(data, pos + 2) * 256 + get_at(data, pos + 3)
    pos = pos + 4

    # Simplified decompression (reverse RLE)
    while (pos < len - 10) {
        var byte = get_at(data, pos)
        pos = pos + 1

        # Check for run
        if (pos + 3 < len && get_at(data, pos) == byte && get_at(data, pos + 1) == byte && get_at(data, pos + 2) == byte) {
            pos = pos + 3
            var run_extra = get_at(data, pos)
            pos = pos + 1
            var total_run = 4 + run_extra

            var i = 0
            while (i < total_run) {
                set_at(output, out_pos, byte)
                out_pos = out_pos + 1
                i = i + 1
            }
        } else {
            set_at(output, out_pos, byte)
            out_pos = out_pos + 1
        }
    }

    bzip2_output_len = out_pos
    return out_pos
}

# Get output
fn bzip2_get_output() {
    return bzip2_output
}

# Get output length
fn bzip2_get_output_len() {
    return bzip2_output_len
}

# Test bzip2
fn bzip2_test() {
    var test_data = BZIP2_BUF + 196608
    var test_str = "bzip2 test data with repeating patterns: aaaa bbbb cccc"
    var len = strlen(test_str)
    var i = 0

    while (i < len) {
        set_at(test_data, i, get_at(test_str, i))
        i = i + 1
    }

    # Compress
    var comp_len = bzip2_compress(test_data, len)
    if (comp_len < 0) {
        serial_print("bzip2 test: compression failed")
        return -1
    }

    serial_print("bzip2 test: passed")
    return 0
}
