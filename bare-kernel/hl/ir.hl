// ir.hl -- SSA Intermediate Representation
// Basic blocks + typed instructions (NOP/COPY/ADD/SUB/MUL/PHI/JUMP/BRANCH/RET).
// ir_emit(bb, op, dst, src1, src2) appends to BB. Phi nodes tracked separately.
// Runtime buffer: 0x1700000

let IR_MAX_INST = 64;
let IR_MAX_BB   = 16;

let IR_NOP    = 0;
let IR_COPY   = 1;
let IR_ADD    = 2;
let IR_SUB    = 3;
let IR_MUL    = 4;
let IR_PHI    = 5;
let IR_JUMP   = 6;
let IR_BRANCH = 7;
let IR_RET    = 8;

let ir_op    = array(64, 0);
let ir_dst   = array(64, 0);
let ir_src1  = array(64, 0);
let ir_src2  = array(64, 0);
let ir_ibb   = array(64, 0);
let ir_n     = 0;

let ir_bb_start  = array(16, 0);
let ir_bb_size   = array(16, 0);
let ir_bb_succ0  = array(16, -1);
let ir_bb_succ1  = array(16, -1);
let ir_bb_n      = 0;
let ir_cur_bb    = 0;
let ir_phi_count = 0;

fn ir_init() {
    ir_n         = 0;
    ir_bb_n      = 0;
    ir_cur_bb    = 0;
    ir_phi_count = 0;
    let mut i = 0;
    while i < 64 {
        set_at(ir_op,   i, 0); set_at(ir_dst,  i, 0);
        set_at(ir_src1, i, 0); set_at(ir_src2, i, 0);
        set_at(ir_ibb,  i, 0);
        i += 1;
    }
    i = 0;
    while i < 16 {
        set_at(ir_bb_start, i, 0); set_at(ir_bb_size,  i, 0);
        set_at(ir_bb_succ0, i, -1); set_at(ir_bb_succ1, i, -1);
        i += 1;
    }
    return 0;
}

fn ir_new_bb() {
    let bb = ir_bb_n;
    set_at(ir_bb_start, bb, ir_n);
    set_at(ir_bb_size,  bb, 0);
    ir_bb_n   += 1;
    ir_cur_bb  = bb;
    return bb;
}

fn ir_emit(bb, op, dst, src1, src2) {
    let mut idx = ir_n;
    set_at(ir_op,   idx, op);
    set_at(ir_dst,  idx, dst);
    set_at(ir_src1, idx, src1);
    set_at(ir_src2, idx, src2);
    set_at(ir_ibb,  idx, bb);
    ir_n += 1;
    set_at(ir_bb_size, bb, ir_bb_size[bb] + 1);
    if op == IR_PHI { ir_phi_count += 1; }
    return idx;
}

fn ir_add_edge(pred, succ) {
    if ir_bb_succ0[pred] == -1 {
        set_at(ir_bb_succ0, pred, succ);
    } else {
        set_at(ir_bb_succ1, pred, succ);
    }
    return 0;
}

fn ir_test() {
    let bb0 = 0;
    let bb1 = 0;
    let bb2 = 0;
    ir_init();
    bb0 = ir_new_bb();
    bb1 = ir_new_bb();
    bb2 = ir_new_bb();
    ir_emit(bb0, IR_COPY,   0, 1, 0);
    ir_emit(bb0, IR_JUMP,   bb2, 0, 0);
    ir_emit(bb1, IR_COPY,   1, 2, 0);
    ir_emit(bb1, IR_JUMP,   bb2, 0, 0);
    ir_emit(bb2, IR_PHI,    2, 0, 1);
    ir_emit(bb2, IR_ADD,    3, 2, 1);
    ir_emit(bb2, IR_RET,    3, 0, 0);
    ir_add_edge(bb0, bb2);
    ir_add_edge(bb1, bb2);
    print("ir_test: n=" + to_string(ir_n) + " bbs=" + to_string(ir_bb_n) + " phi=" + to_string(ir_phi_count));
    if ir_n == 7 {
        if ir_bb_n == 3 {
            if ir_phi_count == 1 {
                print("ir_test: PASS");
                return 1;
            }
        }
    }
    print("ir_test: FAIL");
    return 0;
}

print("ir.hl loaded");
