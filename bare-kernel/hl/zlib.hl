// zlib.hl - DEFLATE Compression (simplified)
// Implements basic DEFLATE compression algorithm (RFC 1951) with zlib wrapper (RFC 1950)

// Constants
let ZLIB_WINDOW_SIZE = 32768;
let ZLIB_MIN_MATCH   = 3;
let ZLIB_MAX_MATCH   = 258;
let ZLIB_HASH_BITS   = 15;

let ZLIB_LEVEL_FAST    = 1;
let ZLIB_LEVEL_DEFAULT = 6;
let ZLIB_LEVEL_BEST    = 9;

// Buffers replacing raw address layout
let zlib_output_buf = array(131072, 0);  // compressed output
let zlib_info_buf   = array(256,    0);  // format_info string scratch
let zlib_digit_buf  = array(32,     0);  // number digit scratch

// State
let mut zlib_compression_level = ZLIB_LEVEL_DEFAULT;
let mut zlib_output_len        = 0;
let mut zlib_adler32_val       = 1;

fn zlib_init() {
    zlib_compression_level = ZLIB_LEVEL_DEFAULT;
    zlib_output_len        = 0;
    zlib_adler32_val       = 1;
    print("ZLIB DEFLATE ready");
}

// Set compression level 1-9; returns 0 on success, 0-1 on error
fn zlib_set_level(level) {
    if level >= 1 {
        if level <= 9 {
            zlib_compression_level = level;
            return 0;
        }
    }
    return 0 - 1;
}

// Compress data with zlib wrapper — returns total byte count
fn zlib_compress(data, data_len) {
    let mut pos = 0;

    // Zlib header: CMF = 0x78 (DEFLATE, 32K window), FLG = 0x9C
    set_at(zlib_output_buf, pos, 120);
    pos = pos + 1;
    set_at(zlib_output_buf, pos, 156);
    pos = pos + 1;

    // DEFLATE compressed payload
    let mut compressed_len = _zlib_deflate(data, data_len, zlib_output_buf, pos);
    if compressed_len < 0 {
        return 0 - 1;
    }
    pos = pos + compressed_len;

    // Adler-32 checksum (4 bytes, big-endian)
    let mut adler = _zlib_adler32(data, data_len);
    set_at(zlib_output_buf, pos,     (adler / 16777216) % 256);
    set_at(zlib_output_buf, pos + 1, (adler / 65536)    % 256);
    set_at(zlib_output_buf, pos + 2, (adler / 256)      % 256);
    set_at(zlib_output_buf, pos + 3,  adler              % 256);
    pos = pos + 4;

    zlib_output_len = pos;
    return pos;
}

// Decompress zlib data — returns decompressed byte count
fn zlib_decompress(data, data_len) {
    if data_len < 6 {
        print("ZLIB: data too short");
        return 0 - 1;
    }

    let mut cmf = data[0];
    let mut flg = data[1];

    let mut cm = cmf % 16;
    if cm != 8 {
        print("ZLIB: unsupported compression method");
        return 0 - 2;
    }

    let mut check = (cmf * 256 + flg) % 31;
    if check != 0 {
        print("ZLIB: invalid header");
        return 0 - 3;
    }

    let mut decompressed_len = _zlib_inflate(data, 2, data_len - 6, zlib_output_buf);
    if decompressed_len < 0 {
        return 0 - 4;
    }

    let mut stored_adler = _zlib_read_u32_be(data, data_len - 4);
    let mut computed_adler = _zlib_adler32(zlib_output_buf, decompressed_len);

    if stored_adler != computed_adler {
        print("ZLIB: checksum mismatch");
        return 0 - 5;
    }

    zlib_output_len = decompressed_len;
    return decompressed_len;
}

// Simplified DEFLATE using uncompressed store blocks
fn _zlib_deflate(data, data_len, output, start_pos) {
    let mut pos      = start_pos;
    let mut data_pos = 0;
    let mut remaining = data_len;

    while remaining > 0 {
        let mut block_size = remaining;
        let mut is_final   = 0;

        if block_size > 65535 {
            block_size = 65535;
        } else {
            is_final = 1;
        }

        // Block header byte: bit0 = BFINAL, bits1-2 = BTYPE=00 (no compression)
        let mut header = 0;
        if is_final == 1 {
            header = 1;
        }
        set_at(output, pos, header);
        pos = pos + 1;

        // LEN (little-endian)
        set_at(output, pos,     block_size % 256);
        set_at(output, pos + 1, block_size / 256);
        pos = pos + 2;

        // NLEN = one's complement of LEN
        let mut nlen = 65535 - block_size;
        set_at(output, pos,     nlen % 256);
        set_at(output, pos + 1, nlen / 256);
        pos = pos + 2;

        // Literal data
        let mut i = 0;
        while i < block_size {
            set_at(output, pos, data[data_pos]);
            pos      = pos      + 1;
            data_pos = data_pos + 1;
            i        = i        + 1;
        }

        remaining = remaining - block_size;
    }

    return pos - start_pos;
}

// Simplified DEFLATE inflate (uncompressed blocks only)
fn _zlib_inflate(data, start_pos, compressed_len, output) {
    let mut pos      = start_pos;
    let mut out_pos  = 0;
    let mut is_final = 0;

    while is_final == 0 {
        if pos >= start_pos + compressed_len {
            is_final = 1;
        }
        if is_final == 0 {
            let mut header = data[pos];
            pos      = pos + 1;

            is_final = header % 2;
            let mut btype = (header / 2) % 4;

            if btype == 0 {
                let mut block_len = data[pos] + data[pos + 1] * 256;
                pos = pos + 2;
                let mut nlen = data[pos] + data[pos + 1] * 256;
                pos = pos + 2;

                if block_len + nlen != 65535 {
                    print("ZLIB: invalid block length");
                    return 0 - 1;
                }

                let mut i = 0;
                while i < block_len {
                    set_at(output, out_pos, data[pos]);
                    out_pos = out_pos + 1;
                    pos     = pos     + 1;
                    i       = i       + 1;
                }
            } else {
                print("ZLIB: compressed blocks not supported");
                return 0 - 2;
            }
        }
    }

    return out_pos;
}

// Adler-32 checksum
fn _zlib_adler32(data, data_len) {
    let mut s1 = 1;
    let mut s2 = 0;
    let mut i  = 0;
    let mut MOD_ADLER = 65521;

    while i < data_len {
        s1 = (s1 + data[i]) % MOD_ADLER;
        s2 = (s2 + s1)      % MOD_ADLER;
        i  = i + 1;
    }

    return (s2 * 65536 + s1) % 4294967296;
}

// Read a 32-bit big-endian value
fn _zlib_read_u32_be(buf, offset) {
    let mut b0 = buf[offset];
    let mut b1 = buf[offset + 1];
    let mut b2 = buf[offset + 2];
    let mut b3 = buf[offset + 3];
    return b0 * 16777216 + b1 * 65536 + b2 * 256 + b3;
}

// Return the output buffer
fn zlib_get_output() {
    return zlib_output_buf;
}

// Return the byte length of the last operation's output
fn zlib_get_output_len() {
    return zlib_output_len;
}

// Compression ratio as percentage (100 = no gain, lower = better)
fn zlib_get_ratio(original_len) {
    if original_len == 0 {
        return 0;
    }
    return (zlib_output_len * 100) / original_len;
}

// Build a human-readable compression summary into zlib_info_buf
fn zlib_format_info(original_len, compressed_len) {
    let mut pos = 0;

    pos = _zlib_append_str(zlib_info_buf, pos, "Original: ");
    pos = _zlib_append_num(zlib_info_buf, pos, original_len);
    pos = _zlib_append_str(zlib_info_buf, pos, " bytes, Compressed: ");
    pos = _zlib_append_num(zlib_info_buf, pos, compressed_len);
    pos = _zlib_append_str(zlib_info_buf, pos, " bytes (");

    let mut ratio = 100;
    if original_len > 0 {
        ratio = (compressed_len * 100) / original_len;
    }
    pos = _zlib_append_num(zlib_info_buf, pos, ratio);
    pos = _zlib_append_str(zlib_info_buf, pos, "%)");

    set_at(zlib_info_buf, pos, 0);
    return zlib_info_buf;
}

// Append a string into buf at pos — returns updated pos
fn _zlib_append_str(buf, pos, str) {
    let mut i    = 0;
    let mut str_len = len(str);
    while i < str_len {
        set_at(buf, pos, str[i]);
        pos = pos + 1;
        i   = i   + 1;
    }
    return pos;
}

// Append a decimal integer into buf at pos — returns updated pos
fn _zlib_append_num(buf, pos, num) {
    if num == 0 {
        set_at(buf, pos, 48);
        return pos + 1;
    }

    let mut n     = num;
    let mut d_pos = 0;
    while n > 0 {
        set_at(zlib_digit_buf, d_pos, 48 + (n % 10));
        n     = n     / 10;
        d_pos = d_pos + 1;
    }

    let mut p = pos;
    while d_pos > 0 {
        d_pos = d_pos - 1;
        set_at(buf, p, zlib_digit_buf[d_pos]);
        p = p + 1;
    }

    return p;
}

// Self-test
fn zlib_test() {
    let mut test_str = "Hello, ZLIB! This is a test string for compression.";
    let mut tlen = len(test_str);

    let mut comp_len = zlib_compress(test_str, tlen);
    if comp_len < 1 {
        print("ZLIB test: compression failed");
        return 0 - 1;
    }

    print("ZLIB test: compression succeeded");

    let mut decomp_len = zlib_decompress(zlib_output_buf, comp_len);
    if decomp_len < 1 {
        print("ZLIB test: decompression failed");
        return 0 - 2;
    }

    if decomp_len != tlen {
        print("ZLIB test: length mismatch");
        return 0 - 3;
    }

    print("ZLIB test: decompression succeeded");
    return 0;
}

zlib_init();
zlib_test();
print("zlib.hl loaded");
