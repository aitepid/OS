// audio.hl -- AC97 Audio Driver
//
// Basic sound output via Intel AC97 codec (QEMU default audio device).
// PCI: vendor=0x8086 device=0x2415 (ICH AC97 audio)
//
// AC97 uses NABM (Native Audio Bus Mastering) with 3 DMA channels:
//   PCM-OUT (channel 0): main audio playback
//   PCM-IN  (channel 1): recording
//   MIC-IN  (channel 2): microphone
//
// Buffer Descriptor List (BDL): 32 entries, each 8 bytes:
//   +0: buffer_addr (4) -- physical address of PCM data
//   +4: length (2) -- number of samples (not bytes)
//   +6: flags (2) -- bit 14 = last entry, bit 15 = fire IRQ

let AC97_VENDOR = 32902;      // 0x8086
let AC97_DEVICE = 9237;       // 0x2415

let mut ac97_nabm_bar = 0;    // BAR1: NABM I/O base
let mut ac97_mixer_bar = 0;   // BAR0: Mixer I/O base

// NABM registers (relative to nabm_bar)
let NABM_PCMOUT_BDBAR = 16;   // 0x10 -- BDL base address
let NABM_PCMOUT_CIV   = 20;   // 0x14 -- current index value
let NABM_PCMOUT_LVI   = 21;   // 0x15 -- last valid index
let NABM_PCMOUT_SR    = 22;   // 0x16 -- status register
let NABM_PCMOUT_CR    = 27;   // 0x1B -- control register
let NABM_GLOB_CNT     = 44;   // 0x2C -- global control
let NABM_GLOB_STA     = 48;   // 0x30 -- global status

// Mixer registers (relative to mixer_bar)
let MIXER_RESET        = 0;
let MIXER_MASTER_VOL   = 2;
let MIXER_PCM_VOL      = 24;  // 0x18
let MIXER_SAMPLE_RATE  = 44;  // 0x2C

let BDL_ADDR = 8978432;       // 0x890000 -- BDL (32 * 8 = 256 bytes)
let PCM_BUF_ADDR = 8978688;   // 0x890100 -- PCM data buffer (64 KB)
let PCM_BUF_SIZE = 65536;

fn ac97_detect() {
    let devices = pci_scan();
    let mut i = 0;
    while i < len(devices) {
        let vid = devices[i][3];
        let did = devices[i][4];
        if vid == AC97_VENDOR {
            if did == AC97_DEVICE {
                return [devices[i][0], devices[i][1], devices[i][2]];
            }
        }
        i = i + 1;
    }
    return [];
}

fn ac97_init() {
    let pci_info = ac97_detect();
    if len(pci_info) == 0 {
        print("AC97 codec not found.");
        return 0;
    }
    let pci_bus = pci_info[0];
    let pci_dev = pci_info[1];
    let pci_func = pci_info[2];

    ac97_mixer_bar = pci_bar(pci_bus, pci_dev, pci_func, 0);
    ac97_mixer_bar = (ac97_mixer_bar / 4) * 4; // mask low 2 bits for I/O
    ac97_nabm_bar = pci_bar(pci_bus, pci_dev, pci_func, 1);
    ac97_nabm_bar = (ac97_nabm_bar / 4) * 4;

    // Enable PCI bus mastering + I/O space
    let cmd = pci_config_read16(pci_bus, pci_dev, pci_func, 4);
    pci_config_write16(pci_bus, pci_dev, pci_func, 4, cmd + 5); // 0x05 (Memory/IO + Bus Master)

    // Reset codec
    port_out_u16(ac97_mixer_bar + MIXER_RESET, 1);

    // Set sample rate to 44100 Hz
    port_out_u16(ac97_mixer_bar + MIXER_SAMPLE_RATE, 44100);

    // Set master volume (0 = max, 0x8000 = mute)
    port_out_u16(ac97_mixer_bar + MIXER_MASTER_VOL, 0);
    port_out_u16(ac97_mixer_bar + MIXER_PCM_VOL, 2056); // 0x0808

    // Enable cold reset in global control
    port_out_u32(ac97_nabm_bar + NABM_GLOB_CNT, 2);

    print("AC97 initialized: mixer=0x" + format_hex(ac97_mixer_bar, 4) + " nabm=0x" + format_hex(ac97_nabm_bar, 4));
    return 1;
}

// Play a buffer of PCM samples (16-bit signed, stereo, 44100 Hz)
fn ac97_play(samples_addr, sample_count) {
    if ac97_nabm_bar == 0 { return 0; }
    // Setup BDL entry 0
    mem_write_u32(BDL_ADDR + 0, samples_addr);
    mem_write_u16(BDL_ADDR + 4, sample_count);
    mem_write_u16(BDL_ADDR + 6, 49152); // 0xC000 last + IOC

    // Set BDL base address
    port_out_u32(ac97_nabm_bar + NABM_PCMOUT_BDBAR, BDL_ADDR);

    // Set last valid index to 0
    port_out_u8(ac97_nabm_bar + NABM_PCMOUT_LVI, 0);

    // Start playback: set RPBM bit in control register
    port_out_u8(ac97_nabm_bar + NABM_PCMOUT_CR, 1);

    return 0;
}

// Stop playback
fn ac97_stop() {
    if ac97_nabm_bar != 0 {
        port_out_u8(ac97_nabm_bar + NABM_PCMOUT_CR, 0);
    }
    return 0;
}

// Generate a simple sine wave tone (for testing)
fn ac97_beep(freq_hz, duration_ms) {
    let sample_rate = 44100;
    let total_samples = sample_rate * duration_ms / 1000;
    // Generate samples: sin(2*pi*freq*t/sample_rate) * 32767
    // For simplicity: square wave (easier without floating point)
    let half_period = sample_rate / (2 * freq_hz);
    let mut i = 0;
    let mut high = 1;
    let mut count = 0;
    while i < total_samples {
        if count >= half_period { high = 1 - high; count = 0; }
        let sample = 0;
        if high == 1 { sample = 16384; } else { sample = 0 - 16384; }
        // Write stereo sample (L+R = 4 bytes)
        mem_write_i16(PCM_BUF_ADDR + i * 4, sample);
        mem_write_i16(PCM_BUF_ADDR + i * 4 + 2, sample);
        count = count + 1;
        i = i + 1;
    }
    ac97_play(PCM_BUF_ADDR, total_samples);
    return 0;
}

// Set master volume (0-100)
fn ac97_set_volume(percent) {
    if percent > 100 { percent = 100; }
    // AC97 volume: 0=max, 63=min, bit 15=mute
    let vol = 63 - (percent * 63 / 100);
    if ac97_mixer_bar != 0 {
        port_out_u16(ac97_mixer_bar + MIXER_MASTER_VOL, vol * 256 + vol);
    }
    return vol;
}

print("audio.hl loaded");
print("AC97: PCM playback, 44100 Hz 16-bit stereo");
