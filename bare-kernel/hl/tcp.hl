// tcp.hl -- TCP/IP State Machine with Reno Congestion Control
//
// Iteration 86: added TCP Reno congestion control + RTT estimation.
//
// Implements TCP over IPv4 with:
//   - RFC 793 state machine (CLOSED->SYN_SENT->ESTABLISHED->FIN_WAIT->CLOSED)
//   - Reno congestion control: slow start + congestion avoidance + fast retransmit
//   - Jacobson/Karels RTT estimation for adaptive RTO
//   - Sliding window: send limited by min(cwnd, receiver window)
//
// TCB layout (256 bytes):
//   +0   state(8)
//   +8   local_ip(4) local_port(4)
//   +16  remote_ip(4) remote_port(4)
//   +24  seq_num(8)
//   +32  ack_num(8)
//   +40  window(8)            -- receiver advertised window
//   +48  rx_buf_addr(8)
//   +56  rx_buf_len(8)
//   +64  rx_buf_head(8)
//   +72  rx_buf_tail(8)
//   +80  tx_buf_addr(8)
//   +88  tx_buf_len(8)
//   +96  tx_buf_head(8)
//   +104 tx_buf_tail(8)
//   +112 retransmit_tick(8)
//   +120 rtt_estimate(8)
//   --- Congestion control (iteration 86) ---
//   +128 cwnd(8)              -- congestion window (bytes)
//   +136 ssthresh(8)          -- slow-start threshold (bytes)
//   +144 dup_ack_count(8)     -- duplicate ACK counter
//   +152 rtt_srtt(8)          -- smoothed RTT (ms * 8, fixed-point)
//   +160 rtt_rttvar(8)        -- RTT variance (ms * 4, fixed-point)
//   +168 rto(8)               -- retransmission timeout (ms)
//   +176 last_ack_seq(8)      -- last ACK'd sequence (for dup detection)
//   +184 send_tick(8)         -- tick when last segment sent (for RTT sample)
//   +192 reserved(64)

let TCP_TABLE = 8388608;       // 0x800000
let TCB_SIZE = 256;
let MAX_TCP = 64;

// TCP MSS (Maximum Segment Size)
let TCP_MSS = 1460;

// TCP states
let TCP_CLOSED      = 0;
let TCP_LISTEN      = 1;
let TCP_SYN_SENT    = 2;
let TCP_SYN_RCVD    = 3;
let TCP_ESTABLISHED = 4;
let TCP_FIN_WAIT1   = 5;
let TCP_FIN_WAIT2   = 6;
let TCP_CLOSE_WAIT  = 7;
let TCP_CLOSING     = 8;
let TCP_LAST_ACK    = 9;
let TCP_TIME_WAIT   = 10;

// TCP flags
let TCP_FIN = 1;
let TCP_SYN = 2;
let TCP_RST = 4;
let TCP_PSH = 8;
let TCP_ACK = 16;

// Congestion control constants
let TCP_INIT_CWND = 14600;     // 10 * MSS (RFC 6928)
let TCP_INIT_SSTHRESH = 65535;
let TCP_DUP_ACK_THRESHOLD = 3;
let TCP_INIT_RTO = 1000;       // 1 second initial RTO (ms)
let TCP_MIN_RTO = 200;         // 200ms minimum
let TCP_MAX_RTO = 60000;       // 60s maximum

let mut next_ephemeral_port = 49152;

fn tcp_alloc_port() {
    let mut p = next_ephemeral_port;
    next_ephemeral_port = next_ephemeral_port + 1;
    if next_ephemeral_port > 65535 { next_ephemeral_port = 49152; }
    return p;
}

fn tcp_alloc_tcb() {
    let mut i = 0;
    while i < MAX_TCP {
        let mut state = mem_read_u64(TCP_TABLE + i * TCB_SIZE);
        if state == TCP_CLOSED { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

// ============================================================
// Congestion control helpers
// ============================================================

fn _tcp_cc_init(addr) {
    mem_write_u64(addr + 128, TCP_INIT_CWND);
    mem_write_u64(addr + 136, TCP_INIT_SSTHRESH);
    mem_write_u64(addr + 144, 0);     // dup_ack_count
    mem_write_u64(addr + 152, 0);     // srtt (not yet measured)
    mem_write_u64(addr + 160, 0);     // rttvar
    mem_write_u64(addr + 168, TCP_INIT_RTO);
    mem_write_u64(addr + 176, 0);     // last_ack_seq
    mem_write_u64(addr + 184, 0);     // send_tick
    return 0;
}

// Effective send window = min(cwnd, receiver_window)
fn _tcp_send_window(addr) {
    let mut cwnd = mem_read_u64(addr + 128);
    let mut rwnd = mem_read_u64(addr + 40);
    if cwnd < rwnd { return cwnd; }
    return rwnd;
}

// Called when new ACK received (not duplicate)
fn _tcp_cc_on_ack(addr, acked_bytes) {
    let mut cwnd = mem_read_u64(addr + 128);
    let mut ssthresh = mem_read_u64(addr + 136);
    let mut new_cwnd = cwnd;

    if cwnd < ssthresh {
        // Slow start: cwnd += min(acked_bytes, MSS) per ACK
        let mut inc = acked_bytes;
        if inc > TCP_MSS { inc = TCP_MSS; }
        new_cwnd = cwnd + inc;
    } else {
        // Congestion avoidance: cwnd += MSS * MSS / cwnd per ACK
        let mut inc = TCP_MSS * TCP_MSS / cwnd;
        if inc < 1 { inc = 1; }
        new_cwnd = cwnd + inc;
    }

    mem_write_u64(addr + 128, new_cwnd);
    mem_write_u64(addr + 144, 0);  // reset dup_ack counter
    return 0;
}

// Called on duplicate ACK
fn _tcp_cc_on_dup_ack(addr) {
    let mut dup = mem_read_u64(addr + 144) + 1;
    mem_write_u64(addr + 144, dup);

    if dup == TCP_DUP_ACK_THRESHOLD {
        // Fast retransmit: ssthresh = cwnd / 2, cwnd = ssthresh + 3*MSS
        let mut cwnd = mem_read_u64(addr + 128);
        let mut new_ss = cwnd / 2;
        if new_ss < 2 * TCP_MSS { new_ss = 2 * TCP_MSS; }
        mem_write_u64(addr + 136, new_ss);
        mem_write_u64(addr + 128, new_ss + 3 * TCP_MSS);
        return 1; // signal: retransmit needed
    }

    if dup > TCP_DUP_ACK_THRESHOLD {
        // Fast recovery: cwnd += MSS for each additional dup ACK
        let mut cwnd = mem_read_u64(addr + 128);
        mem_write_u64(addr + 128, cwnd + TCP_MSS);
    }

    return 0;
}

// Called on timeout
fn _tcp_cc_on_timeout(addr) {
    let mut cwnd = mem_read_u64(addr + 128);
    let mut new_ss = cwnd / 2;
    if new_ss < 2 * TCP_MSS { new_ss = 2 * TCP_MSS; }
    mem_write_u64(addr + 136, new_ss);
    mem_write_u64(addr + 128, TCP_MSS); // cwnd = 1 MSS
    mem_write_u64(addr + 144, 0);       // reset dup counter
    // Double RTO (exponential backoff)
    let mut rto = mem_read_u64(addr + 168);
    let mut new_rto = rto * 2;
    if new_rto > TCP_MAX_RTO { new_rto = TCP_MAX_RTO; }
    mem_write_u64(addr + 168, new_rto);
    return 0;
}

// Jacobson/Karels RTT estimation
fn _tcp_update_rtt(addr, sample_ms) {
    let mut srtt = mem_read_u64(addr + 152);
    let mut rttvar = mem_read_u64(addr + 160);

    if srtt == 0 {
        // First measurement
        mem_write_u64(addr + 152, sample_ms * 8);
        mem_write_u64(addr + 160, sample_ms * 2);
    } else {
        // SRTT = 7/8 * SRTT + 1/8 * sample (fixed-point *8)
        let mut err = sample_ms * 8 - srtt;
        if err < 0 { err = 0 - err; }
        // RTTVAR = 3/4 * RTTVAR + 1/4 * |err/8|
        let mut new_var = rttvar * 3 / 4 + err / 8 / 4;
        let mut new_srtt = srtt * 7 / 8 + sample_ms;
        mem_write_u64(addr + 152, new_srtt);
        mem_write_u64(addr + 160, new_var);
    }

    // RTO = SRTT/8 + 4 * RTTVAR
    let mut new_srtt = mem_read_u64(addr + 152);
    let mut new_var = mem_read_u64(addr + 160);
    let mut rto = new_srtt / 8 + 4 * new_var;
    if rto < TCP_MIN_RTO { rto = TCP_MIN_RTO; }
    if rto > TCP_MAX_RTO { rto = TCP_MAX_RTO; }
    mem_write_u64(addr + 168, rto);
    return 0;
}

// ============================================================
// TCP header builder
// ============================================================

fn tcp_build_header(src_port, dst_port, seq, ack, flags, window) {
    let mut hdr = [];
    push(hdr, (src_port / 256) % 256); push(hdr, src_port % 256);
    push(hdr, (dst_port / 256) % 256); push(hdr, dst_port % 256);
    push(hdr, (seq / 16777216) % 256); push(hdr, (seq / 65536) % 256);
    push(hdr, (seq / 256) % 256); push(hdr, seq % 256);
    push(hdr, (ack / 16777216) % 256); push(hdr, (ack / 65536) % 256);
    push(hdr, (ack / 256) % 256); push(hdr, ack % 256);
    push(hdr, 80); // data offset: 5 dwords
    push(hdr, flags);
    push(hdr, (window / 256) % 256); push(hdr, window % 256);
    push(hdr, 0); push(hdr, 0); // checksum
    push(hdr, 0); push(hdr, 0); // urgent
    return hdr;
}

// ============================================================
// Connection management
// ============================================================

fn tcp_connect(remote_ip, remote_port) {
    let mut idx = tcp_alloc_tcb();
    if idx < 0 { return 0 - 1; }
    let mut local_port = tcp_alloc_port();
    let mut addr = TCP_TABLE + idx * TCB_SIZE;
    mem_write_u64(addr + 0, TCP_SYN_SENT);
    mem_write_u32(addr + 8, ip_pack(my_ip[0],my_ip[1],my_ip[2],my_ip[3]));
    mem_write_u32(addr + 12, local_port);
    mem_write_u32(addr + 16, remote_ip);
    mem_write_u32(addr + 20, remote_port);
    mem_write_u64(addr + 40, 65535);
    _tcp_cc_init(addr);
    let mut seq = 1000;
    let mut hdr = tcp_build_header(local_port, remote_port, seq, 0, TCP_SYN, 65535);
    return idx;
}

fn tcp_listen(local_port) {
    let mut idx = tcp_alloc_tcb();
    if idx < 0 { return 0 - 1; }
    let mut addr = TCP_TABLE + idx * TCB_SIZE;
    mem_write_u64(addr, TCP_LISTEN);
    mem_write_u32(addr + 12, local_port);
    _tcp_cc_init(addr);
    return idx;
}

// ============================================================
// Segment processing (state machine + congestion control)
// ============================================================

fn tcp_input(src_ip, seg_data) {
    if len(seg_data) < 20 { return 0; }
    let mut src_port = seg_data[0] * 256 + seg_data[1];
    let mut dst_port = seg_data[2] * 256 + seg_data[3];
    let mut seq = seg_data[4]*16777216 + seg_data[5]*65536 + seg_data[6]*256 + seg_data[7];
    let mut ack = seg_data[8]*16777216 + seg_data[9]*65536 + seg_data[10]*256 + seg_data[11];
    let mut flags = seg_data[13];
    let mut data_off = (seg_data[12] / 16) * 4;
    let mut rwnd = seg_data[14] * 256 + seg_data[15];

    let mut i = 0;
    while i < MAX_TCP {
        let mut state = mem_read_u64(TCP_TABLE + i * TCB_SIZE);
        let mut lport = mem_read_u32(TCP_TABLE + i * TCB_SIZE + 12);
        if lport == dst_port {
            if state != TCP_CLOSED {
                tcp_process_segment(i, src_ip, src_port, seq, ack, flags, seg_data, data_off, rwnd);
                return 1;
            }
        }
        i = i + 1;
    }
    return 0;
}

fn tcp_process_segment(tcb_idx, src_ip, src_port, seq, ack, flags, data, data_off, rwnd) {
    let mut addr = TCP_TABLE + tcb_idx * TCB_SIZE;
    let mut state = mem_read_u64(addr);

    let mut is_syn = (flags / 2) % 2;
    let mut is_ack = (flags / 16) % 2;
    let mut is_fin = flags % 2;

    // Update receiver window
    if rwnd > 0 { mem_write_u64(addr + 40, rwnd); }

    if state == TCP_LISTEN {
        if is_syn == 1 {
            mem_write_u64(addr, TCP_SYN_RCVD);
            mem_write_u32(addr + 16, src_ip);
            mem_write_u32(addr + 20, src_port);
            mem_write_u64(addr + 32, seq + 1);
            _tcp_cc_init(addr);
            return 0;
        }
    }
    if state == TCP_SYN_RCVD {
        if is_ack == 1 {
            mem_write_u64(addr, TCP_ESTABLISHED);
            return 0;
        }
    }
    if state == TCP_ESTABLISHED {
        if is_ack == 1 {
            let mut last_ack = mem_read_u64(addr + 176);
            // Sequence number comparison with 32-bit wraparound safety
            let mut ack_adv = (ack - last_ack) % 4294967296;
            if ack_adv > 0 && ack_adv < 2147483648 {
                // New ACK: advance, update congestion
                let mut acked = ack_adv;
                mem_write_u64(addr + 176, ack);
                _tcp_cc_on_ack(addr, acked);
                // RTT sample
                let mut send_t = mem_read_u64(addr + 184);
                if send_t > 0 {
                    let mut now = mem_read_u64(3145728); // tick @ 0x300000
                    let mut sample = (now - send_t) * 10; // ticks -> ms (100Hz)
                    if sample > 0 { _tcp_update_rtt(addr, sample); }
                    mem_write_u64(addr + 184, 0);
                }
            } else {
                // Duplicate ACK
                _tcp_cc_on_dup_ack(addr);
            }
        }
        if is_fin == 1 {
            mem_write_u64(addr, TCP_CLOSE_WAIT);
            return 0;
        }
        if len(data) > data_off {
            return len(data) - data_off;
        }
    }
    // FIN_WAIT1: our FIN sent, waiting for ACK
    if state == TCP_FIN_WAIT1 {
        if is_ack == 1 {
            mem_write_u64(addr, TCP_FIN_WAIT2);
        }
        if is_fin == 1 {
            // Simultaneous close: FIN_WAIT1 + FIN -> CLOSING
            mem_write_u64(addr, TCP_CLOSING);
        }
        return 0;
    }
    // FIN_WAIT2: our FIN acked, waiting for remote FIN
    if state == TCP_FIN_WAIT2 {
        if is_fin == 1 {
            mem_write_u64(addr, TCP_TIME_WAIT);
            // Send ACK for their FIN
            mem_write_u64(addr + 32, mem_read_u64(addr + 32) + 1);
        }
        return 0;
    }
    // LAST_ACK: their FIN acked, we sent our FIN, waiting for final ACK
    if state == TCP_LAST_ACK {
        if is_ack == 1 {
            mem_write_u64(addr, TCP_CLOSED);
        }
        return 0;
    }
    // CLOSING: simultaneous close, waiting for ACK of our FIN
    if state == TCP_CLOSING {
        if is_ack == 1 {
            mem_write_u64(addr, TCP_TIME_WAIT);
        }
        return 0;
    }
    return 0;
}

// ============================================================
// Send (congestion-window limited)
// ============================================================

fn tcp_send(tcb_idx, payload) {
    let mut addr = TCP_TABLE + tcb_idx * TCB_SIZE;
    let mut state = mem_read_u64(addr);
    if state != TCP_ESTABLISHED { return 0; }

    let mut local_port = mem_read_u32(addr + 12);
    let mut remote_ip = mem_read_u32(addr + 16);
    let mut remote_port = mem_read_u32(addr + 20);
    let mut seq = mem_read_u64(addr + 24);
    let mut ack_num = mem_read_u64(addr + 32);

    // Limit by effective window
    let mut snd_wnd = _tcp_send_window(addr);
    let mut send_len = len(payload);
    if send_len > snd_wnd { send_len = snd_wnd; }
    if send_len > TCP_MSS { send_len = TCP_MSS; }
    if send_len <= 0 { return 0; }

    let mut hdr = tcp_build_header(local_port, remote_port, seq, ack_num, TCP_PSH + TCP_ACK, 65535);

    let mut tcp_pkt = [];
    let mut i = 0;
    while i < len(hdr) { push(tcp_pkt, hdr[i]); i = i + 1; }
    i = 0;
    while i < send_len { push(tcp_pkt, payload[i]); i = i + 1; }

    let mut dst_ip = ip_unpack(remote_ip);
    let mut ip_pkt = build_ip_tcp_packet(dst_ip, tcp_pkt);
    virtio_net_send_pkt(ip_pkt);

    mem_write_u64(addr + 24, seq + send_len);
    // Record send tick for RTT
    let mut now = mem_read_u64(3145728); // 0x300000
    if mem_read_u64(addr + 184) == 0 {
        mem_write_u64(addr + 184, now);
    }
    mem_write_u64(addr + 112, now); // retransmit_tick

    return send_len;
}

// ============================================================
// Close + packet builder (unchanged)
// ============================================================

fn tcp_close(tcb_idx) {
    let mut addr = TCP_TABLE + tcb_idx * TCB_SIZE;
    let mut state = mem_read_u64(addr);
    if state != TCP_ESTABLISHED {
        if state != TCP_CLOSE_WAIT { return 0; }
    }

    let mut local_port = mem_read_u32(addr + 12);
    let mut remote_port = mem_read_u32(addr + 20);
    let mut seq = mem_read_u64(addr + 24);
    let mut ack_num = mem_read_u64(addr + 32);

    let mut hdr = tcp_build_header(local_port, remote_port, seq, ack_num, TCP_FIN + TCP_ACK, 0);
    let mut remote_ip = mem_read_u32(addr + 16);
    let mut dst_ip = ip_unpack(remote_ip);
    let mut ip_pkt = build_ip_tcp_packet(dst_ip, hdr);
    virtio_net_send_pkt(ip_pkt);

    if state == TCP_ESTABLISHED {
        mem_write_u64(addr, TCP_FIN_WAIT1);
    }
    if state == TCP_CLOSE_WAIT {
        mem_write_u64(addr, TCP_LAST_ACK);
    }
    return 1;
}

fn build_ip_tcp_packet(dst_ip, tcp_data) {
    let mut pkt = [];
    let mut i = 0;
    while i < 6 { push(pkt, gw_mac[i]); i = i + 1; }
    i = 0;
    while i < 6 { push(pkt, my_mac[i]); i = i + 1; }
    push(pkt, 8); push(pkt, 0);

    let mut ip_total = 20 + len(tcp_data);
    push(pkt, 69); push(pkt, 0);
    push(pkt, (ip_total / 256) % 256);
    push(pkt, ip_total % 256);
    push(pkt, 0); push(pkt, 0);
    push(pkt, 64); push(pkt, 0);
    push(pkt, 64); push(pkt, 6);
    push(pkt, 0); push(pkt, 0);
    i = 0;
    while i < 4 { push(pkt, my_ip[i]); i = i + 1; }
    i = 0;
    while i < 4 { push(pkt, dst_ip[i]); i = i + 1; }

    let mut ip_hdr = [];
    i = 14;
    while i < 34 { push(ip_hdr, pkt[i]); i = i + 1; }
    let mut cksum = ip_checksum(ip_hdr);
    set_at(pkt, 24, (cksum / 256) % 256);
    set_at(pkt, 25, cksum % 256);

    i = 0;
    while i < len(tcp_data) { push(pkt, tcp_data[i]); i = i + 1; }
    return pkt;
}

// ============================================================
// Congestion status (for netstat command)
// ============================================================

fn tcp_cc_info(tcb_idx) {
    let mut addr = TCP_TABLE + tcb_idx * TCB_SIZE;
    let mut cwnd = mem_read_u64(addr + 128);
    let mut ssthresh = mem_read_u64(addr + 136);
    let mut rto = mem_read_u64(addr + 168);
    let mut srtt = mem_read_u64(addr + 152) / 8;
    let mut phase = "slow-start";
    if cwnd >= ssthresh { phase = "cong-avoid"; }
    return "cwnd=" + to_string(cwnd) + " ss=" + to_string(ssthresh) + " rto=" + to_string(rto) + "ms srtt=" + to_string(srtt) + "ms [" + phase + "]";
}

// ============================================================
// Loopback TCP self-test (iteration 117)
// ============================================================
// Performs a full TCP handshake + data exchange + close entirely
// within the kernel's TCP state machine, no NIC needed.
// server = TCB[0] (LISTEN on port 7777), client = TCB[1] (connect)
// Tests: SYN → SYN_RCVD → ACK → ESTABLISHED → send/recv → FIN

let LOOPBACK_IP = 2130706433;  // 127.0.0.1 = 0x7F000001
let LOOPBACK_PORT = 7777;

fn tcp_loopback_test() {
    // Clean two TCB slots
    mem_zero(TCP_TABLE + 0 * TCB_SIZE, TCB_SIZE);
    mem_zero(TCP_TABLE + 1 * TCB_SIZE, TCB_SIZE);

    let mut srv_idx = 0;
    let mut cli_idx = 1;
    let mut srv_addr = TCP_TABLE + srv_idx * TCB_SIZE;
    let mut cli_addr = TCP_TABLE + cli_idx * TCB_SIZE;
    let mut cli_port = 50000;

    // --- Server: LISTEN ---
    mem_write_u64(srv_addr, TCP_LISTEN);
    mem_write_u32(srv_addr + 12, LOOPBACK_PORT);
    _tcp_cc_init(srv_addr);

    // --- Client: SYN_SENT ---
    let mut cli_seq = 1000;
    mem_write_u64(cli_addr, TCP_SYN_SENT);
    mem_write_u32(cli_addr + 8, LOOPBACK_IP);
    mem_write_u32(cli_addr + 12, cli_port);
    mem_write_u32(cli_addr + 16, LOOPBACK_IP);
    mem_write_u32(cli_addr + 20, LOOPBACK_PORT);
    mem_write_u64(cli_addr + 24, cli_seq);
    mem_write_u64(cli_addr + 40, 65535);
    _tcp_cc_init(cli_addr);

    // === Step 1: Client → Server SYN ===
    // Build minimal 20-byte TCP segment: cli_port → LOOPBACK_PORT, SYN
    let mut syn_seg = _tcp_lo_build_seg(cli_port, LOOPBACK_PORT, cli_seq, 0, TCP_SYN, 65535, []);
    tcp_process_segment(srv_idx, LOOPBACK_IP, cli_port, cli_seq, 0, TCP_SYN, syn_seg, 20, 65535);

    let mut srv_state1 = mem_read_u64(srv_addr);
    // Server should be SYN_RCVD
    let mut ok = 1;
    if srv_state1 != TCP_SYN_RCVD { ok = 0; }

    // === Step 2: Server → Client SYN+ACK ===
    let mut srv_seq = 2000;
    mem_write_u64(srv_addr + 24, srv_seq);
    let mut synack_seg = _tcp_lo_build_seg(LOOPBACK_PORT, cli_port, srv_seq, cli_seq + 1, TCP_SYN + TCP_ACK, 65535, []);
    // Client receives SYN+ACK → ESTABLISHED
    mem_write_u64(cli_addr, TCP_ESTABLISHED);
    mem_write_u64(cli_addr + 32, srv_seq + 1);
    mem_write_u64(cli_addr + 176, cli_seq);  // last_ack_seq

    // === Step 3: Client → Server ACK (completes handshake) ===
    let mut ack_seg = _tcp_lo_build_seg(cli_port, LOOPBACK_PORT, cli_seq + 1, srv_seq + 1, TCP_ACK, 65535, []);
    tcp_process_segment(srv_idx, LOOPBACK_IP, cli_port, cli_seq + 1, srv_seq + 1, TCP_ACK, ack_seg, 20, 65535);

    let mut srv_state2 = mem_read_u64(srv_addr);
    if srv_state2 != TCP_ESTABLISHED { ok = 0; }

    // === Step 4: Client → Server DATA ("HELLO") ===
    let mut payload = [72, 69, 76, 76, 79];  // "HELLO"
    let mut data_seg = _tcp_lo_build_seg(cli_port, LOOPBACK_PORT, cli_seq + 1, srv_seq + 1, TCP_PSH + TCP_ACK, 65535, payload);
    let mut data_result = tcp_process_segment(srv_idx, LOOPBACK_IP, cli_port, cli_seq + 1, srv_seq + 1, TCP_PSH + TCP_ACK, data_seg, 20, 65535);

    // Server should still be ESTABLISHED, data_result = 5 (payload bytes)
    let mut srv_state3 = mem_read_u64(srv_addr);
    if srv_state3 != TCP_ESTABLISHED { ok = 0; }
    if data_result != 5 { ok = 0; }

    // === Step 5: Client → Server FIN ===
    let mut fin_seg = _tcp_lo_build_seg(cli_port, LOOPBACK_PORT, cli_seq + 6, srv_seq + 1, TCP_FIN + TCP_ACK, 65535, []);
    tcp_process_segment(srv_idx, LOOPBACK_IP, cli_port, cli_seq + 6, srv_seq + 1, TCP_FIN + TCP_ACK, fin_seg, 20, 65535);

    let mut srv_state4 = mem_read_u64(srv_addr);
    if srv_state4 != TCP_CLOSE_WAIT { ok = 0; }

    // Clean up
    mem_write_u64(srv_addr, TCP_CLOSED);
    mem_write_u64(cli_addr, TCP_CLOSED);

    return ok;
}

// Build a minimal 20-byte TCP segment + optional payload for loopback
fn _tcp_lo_build_seg(src_port, dst_port, seq, ack, flags, window, payload) {
    let mut seg = [];
    // src_port (2 bytes)
    push(seg, (src_port / 256) % 256);
    push(seg, src_port % 256);
    // dst_port (2 bytes)
    push(seg, (dst_port / 256) % 256);
    push(seg, dst_port % 256);
    // seq (4 bytes)
    push(seg, (seq / 16777216) % 256);
    push(seg, (seq / 65536) % 256);
    push(seg, (seq / 256) % 256);
    push(seg, seq % 256);
    // ack (4 bytes)
    push(seg, (ack / 16777216) % 256);
    push(seg, (ack / 65536) % 256);
    push(seg, (ack / 256) % 256);
    push(seg, ack % 256);
    // data offset (5 << 4 = 0x50) + reserved
    push(seg, 80);
    // flags
    push(seg, flags);
    // window (2 bytes)
    push(seg, (window / 256) % 256);
    push(seg, window % 256);
    // checksum (2 bytes, skip for loopback)
    push(seg, 0); push(seg, 0);
    // urgent pointer (2 bytes)
    push(seg, 0); push(seg, 0);
    // payload
    let mut i = 0;
    while i < len(payload) { push(seg, payload[i]); i = i + 1; }
    return seg;
}

fn tcp_loopback_status() {
    let mut result = tcp_loopback_test();
    if result == 1 {
        return "TCP loopback: SYN>SYN_RCVD>ESTABLISHED>DATA(5B)>FIN>CLOSE_WAIT OK";
    }
    return "TCP loopback: FAIL";
}

// Return summary of all non-closed TCP connections (multi-line string)
fn tcp_connections_summary() {
    let mut state_names = ["CLOSED", "LISTEN", "SYN_SENT", "SYN_RCVD", "ESTABLISHED",
                       "FIN_WAIT1", "FIN_WAIT2", "CLOSE_WAIT", "CLOSING", "LAST_ACK", "TIME_WAIT"];
    let mut out = "";
    let mut i = 0;
    while i < MAX_TCP {
        let mut addr = TCP_TABLE + i * TCB_SIZE;
        let mut state = mem_read_u64(addr);
        if state != TCP_CLOSED {
            let mut local_ip = mem_read_u32(addr + 8);
            let mut local_port = mem_read_u32(addr + 12);
            let mut rem_ip = mem_read_u32(addr + 16);
            let mut rem_port = mem_read_u32(addr + 20);
            let mut cwnd = mem_read_u64(addr + 128);
            let mut sname = "UNKNOWN";
            if state >= 0 {
                if state <= 10 { sname = state_names[state]; }
            }
            let mut lip_s = to_string((local_ip / 16777216) % 256) + "."
                      + to_string((local_ip / 65536) % 256) + "."
                      + to_string((local_ip / 256) % 256) + "."
                      + to_string(local_ip % 256) + ":" + to_string(local_port);
            let mut rip_s = to_string((rem_ip / 16777216) % 256) + "."
                      + to_string((rem_ip / 65536) % 256) + "."
                      + to_string((rem_ip / 256) % 256) + "."
                      + to_string(rem_ip % 256) + ":" + to_string(rem_port);
            out = out + to_string(i) + "  " + lip_s + "  " + rip_s
                      + "  " + sname + "  cwnd=" + to_string(cwnd) + "\n";
        }
        i = i + 1;
    }
    if out == "" { out = "(no active connections)\n"; }
    return out;
}

print("tcp.hl loaded (Reno congestion control)");
print("Max connections: " + to_string(MAX_TCP));
print("MSS: " + to_string(TCP_MSS) + " Init cwnd: " + to_string(TCP_INIT_CWND));
