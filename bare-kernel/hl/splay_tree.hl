// splay_tree.hl -- Splay tree: self-adjusting BST amortized O(log n) (iter 319)
// Buffer: 0x1760000
// Operations: insert, find, min, max. Splay brings accessed node to root.

let SP_MAX = 64;

let sp_key    = array(64,  0);
let sp_left   = array(64, -1);
let sp_right  = array(64, -1);
let sp_parent = array(64, -1);
let sp_pool   = 0;
let sp_root   = -1;
let sp_size   = 0;

fn sp_init() {
    sp_pool = 0;
    sp_root = -1;
    sp_size = 0;
    let mut i = 0;
    while i < SP_MAX {
        set_at(sp_key,    i,  0);
        set_at(sp_left,   i, -1);
        set_at(sp_right,  i, -1);
        set_at(sp_parent, i, -1);
        i += 1;
    }
    return 0;
}

fn _sp_set_par(x, p) {
    if x >= 0 {
        set_at(sp_parent, x, p);
    }
    return 0;
}

fn _sp_is_left(x) {
    let mut p = sp_parent[x];
    if p >= 0 {
        if sp_left[p] == x { return 1; }
    }
    return 0;
}

fn _sp_rotate(x) {
    let mut p = sp_parent[x];
    let mut g = sp_parent[p];
    if _sp_is_left(x) == 1 {
        let mut b = sp_right[x];
        set_at(sp_right, x, p);
        set_at(sp_left,  p, b);
        _sp_set_par(b, p);
    } else {
        let mut b = sp_left[x];
        set_at(sp_left,  x, p);
        set_at(sp_right, p, b);
        _sp_set_par(b, p);
    }
    _sp_set_par(p, x);
    _sp_set_par(x, g);
    if g >= 0 {
        if sp_left[g] == p {
            set_at(sp_left,  g, x);
        } else {
            set_at(sp_right, g, x);
        }
    } else {
        sp_root = x;
    }
    return 0;
}

fn _sp_splay(x) {
    let mut done = 0;
    while done == 0 {
        let mut p = sp_parent[x];
        if p < 0 {
            sp_root = x;
            done = 1;
        } else {
            let mut g = sp_parent[p];
            if g < 0 {
                _sp_rotate(x);
                done = 1;
            } else {
                let xl = _sp_is_left(x);
                let pl = _sp_is_left(p);
                if xl == pl {
                    _sp_rotate(p);
                    _sp_rotate(x);
                } else {
                    _sp_rotate(x);
                    _sp_rotate(x);
                }
            }
        }
    }
    return 0;
}

fn sp_insert(k) {
    let mut n = sp_pool;
    sp_pool += 1;
    set_at(sp_key,    n,  k);
    set_at(sp_left,   n, -1);
    set_at(sp_right,  n, -1);
    set_at(sp_parent, n, -1);
    sp_size += 1;
    if sp_root < 0 {
        sp_root = n;
        return n;
    }
    let mut cur = sp_root;
    let mut done = 0;
    while done == 0 {
        if k < sp_key[cur] {
            if sp_left[cur] < 0 {
                set_at(sp_left,   cur, n);
                set_at(sp_parent, n,   cur);
                done = 1;
            } else {
                cur = sp_left[cur];
            }
        } else {
            if sp_right[cur] < 0 {
                set_at(sp_right,  cur, n);
                set_at(sp_parent, n,   cur);
                done = 1;
            } else {
                cur = sp_right[cur];
            }
        }
    }
    _sp_splay(n);
    return n;
}

fn sp_find(k) {
    let mut cur = sp_root;
    let last = -1;
    let mut done = 0;
    while done == 0 {
        if cur < 0 {
            done = 1;
        } else {
            last = cur;
            if k == sp_key[cur] {
                done = 1;
            } else {
                if k < sp_key[cur] {
                    cur = sp_left[cur];
                } else {
                    cur = sp_right[cur];
                }
            }
        }
    }
    if last >= 0 {
        _sp_splay(last);
    }
    if sp_root >= 0 {
        if sp_key[sp_root] == k {
            return sp_root;
        }
    }
    return 0 - 1;
}

fn sp_min() {
    if sp_root < 0 { return 0 - 1; }
    let mut cur = sp_root;
    let mut done = 0;
    while done == 0 {
        if sp_left[cur] < 0 { done = 1; }
        else { cur = sp_left[cur]; }
    }
    _sp_splay(cur);
    return sp_key[sp_root];
}

fn sp_max() {
    if sp_root < 0 { return 0 - 1; }
    let mut cur = sp_root;
    let mut done = 0;
    while done == 0 {
        if sp_right[cur] < 0 { done = 1; }
        else { cur = sp_right[cur]; }
    }
    _sp_splay(cur);
    return sp_key[sp_root];
}

fn sp_test() {
    sp_init();
    sp_insert(5);
    sp_insert(3);
    sp_insert(7);
    sp_insert(1);
    sp_insert(4);
    let mn = sp_min();
    let mx = sp_max();
    let f3 = sp_find(3);
    let f9 = sp_find(9);
    print("sp_test: min=" + to_string(mn) + " max=" + to_string(mx) +
          " find(3)=" + to_string(f3) + " find(9)=" + to_string(f9));
    if mn == 1 {
        if mx == 7 {
            if f3 >= 0 {
                if f9 < 0 {
                    print("sp_test: PASS");
                    return 1;
                }
            }
        }
    }
    print("sp_test: FAIL");
    return 0;
}

print("splay_tree.hl loaded");
