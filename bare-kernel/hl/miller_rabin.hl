// miller_rabin.hl -- Miller-Rabin deterministic primality test (iter 340)
// Buffer: 0x18B0000
// Deterministic for n < 3,215,031,751 using witnesses {2,3,5,7}.
// Safe for n < 10^9 (modular multiply stays within int64).
// mr_is_prime(n): 1=prime, 0=composite.  mr_next_prime(n): next prime > n.

let MR_WITS = 4;
let mr_wit  = array(4, 0);

fn mr_init() {
    set_at(mr_wit, 0, 2);
    set_at(mr_wit, 1, 3);
    set_at(mr_wit, 2, 5);
    set_at(mr_wit, 3, 7);
    return 0;
}

fn _mr_mod(v, m) {
    return v - (v / m) * m;
}

fn _mr_modpow(base, exp, mod) {
    let mut result = 1;
    let mut b = _mr_mod(base, mod);
    let mut e = exp;
    while e > 0 {
        let emod2 = e - (e / 2) * 2;
        if emod2 == 1 {
            result = _mr_mod(result * b, mod);
        }
        b = _mr_mod(b * b, mod);
        e = e / 2;
    }
    return result;
}

fn _mr_witness_check(a, n, d, r) {
    let mut x = _mr_modpow(a, d, n);
    if x == 1     { return 1; }
    if x == n - 1 { return 1; }
    let mut i = 0;
    while i < r - 1 {
        x = _mr_mod(x * x, n);
        if x == n - 1 { return 1; }
        i += 1;
    }
    return 0;
}

fn mr_is_prime(n) {
    if n < 2  { return 0; }
    if n == 2 { return 1; }
    if n == 3 { return 1; }
    let nmod2 = n - (n / 2) * 2;
    if nmod2 == 0 { return 0; }
    // write n-1 = 2^r * d with d odd
    let mut d = n - 1;
    let mut r = 0;
    let dmod2 = d - (d / 2) * 2;
    while dmod2 == 0 {
        d = d / 2;
        r += 1;
        dmod2 = d - (d / 2) * 2;
    }
    let mut i = 0;
    while i < MR_WITS {
        let mut a = mr_wit[i];
        if a < n {
            if _mr_witness_check(a, n, d, r) == 0 { return 0; }
        }
        i += 1;
    }
    return 1;
}

fn mr_next_prime(n) {
    let mut x = n + 1;
    if x < 2 { x = 2; }
    while mr_is_prime(x) == 0 { x += 1; }
    return x;
}

fn mr_count_primes(limit) {
    let cnt = 0;
    let x   = 2;
    while x <= limit {
        if mr_is_prime(x) == 1 { cnt += 1; }
        x += 1;
    }
    return cnt;
}

fn mr_test() {
    let p1 = mr_is_prime(997);     // prime
    let p2 = mr_is_prime(7919);    // prime (1000th prime)
    let c1 = mr_is_prime(100);     // composite (4*25)
    let c2 = mr_is_prime(1001);    // composite (7*11*13)
    let nx = mr_next_prime(100);   // 101
    print("mr_test: prime(997)=" + to_string(p1) +
          " prime(7919)=" + to_string(p2) +
          " comp(100)=" + to_string(c1) +
          " comp(1001)=" + to_string(c2) +
          " next(100)=" + to_string(nx));
    if p1 == 1 {
        if p2 == 1 {
            if c1 == 0 {
                if c2 == 0 {
                    if nx == 101 {
                        print("mr_test: PASS");
                        return 1;
                    }
                }
            }
        }
    }
    print("mr_test: FAIL");
    return 0;
}

print("miller_rabin.hl loaded");
