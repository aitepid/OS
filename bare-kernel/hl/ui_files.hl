// ui_files.hl -- HicOS File Manager UI
//
// Provides a graphical file browser with:
//   - Two-column layout: breadcrumb/path + file list
//   - Double-click navigation
//   - Right-click context menu (delete, new folder, copy path)
//   - File/folder icons
//

let UIFILES_MAX_ENTRIES = 256;
let UIFILES_ENTRY_HEIGHT = 24;
let UIFILES_COLUMN_PATH_W = 200;
let UIFILES_COLUMN_LIST_W = 400;
let UIFILES_WINDOW_W = 700;
let UIFILES_WINDOW_H = 500;

// Context menu constants
let UIFILES_CTX_NONE    = 0;
let UIFILES_CTX_DELETE  = 1;
let UIFILES_CTX_NEWFOLD = 2;
let UIFILES_CTX_COPY    = 3;
let UIFILES_CTX_CANCEL  = 4;
let UIFILES_CTX_ITEMS   = 4;
let UIFILES_CTX_ITEM_H  = 24;
let UIFILES_CTX_W       = 130;

// File browser state
let mut uifiles_current_path = "/";
let mut uifiles_entry_count = 0;
let mut uifiles_selected_idx = 0;
let mut uifiles_scroll_pos = 0;
let mut uifiles_entries = [];
let mut uifiles_window_id = 0 - 1;

// Context menu state
let mut uifiles_ctx_open = 0;
let mut uifiles_ctx_x = 0;
let mut uifiles_ctx_y = 0;

fn uifiles_init() {
    uifiles_current_path = "/";
    uifiles_selected_idx = 0;
    uifiles_scroll_pos = 0;
    uifiles_entries = [];
    uifiles_entry_count = 0;
    uifiles_ctx_open = 0;
    return 0;
}

fn uifiles_load_dir(path) {
    uifiles_entries = [];
    uifiles_entry_count = 0;
    uifiles_selected_idx = 0;
    uifiles_scroll_pos = 0;

    if path != "/" {
        push(uifiles_entries, ["..", 1, 0]);
        uifiles_entry_count = uifiles_entry_count + 1;
    }

    let mut names = vfs_readdir(path);
    let mut i = 0;
    while i < len(names) {
        let mut name = names[i];
        let mut full_path = path + "/" + name;
        let mut stat_result = vfs_stat(full_path);
        let mut is_dir = 0;
        let mut size = 0;

        if stat_result > 0 { is_dir = 1; }

        push(uifiles_entries, [name, is_dir, size]);
        uifiles_entry_count = uifiles_entry_count + 1;

        if uifiles_entry_count >= UIFILES_MAX_ENTRIES {
            i = len(names);
        } else {
            i = i + 1;
        }
    }

    return uifiles_entry_count;
}

fn uifiles_navigate(path) {
    uifiles_current_path = path;
    uifiles_load_dir(path);
    uifiles_ctx_open = 0;
    return 0;
}

// Return full path of currently selected entry, or "" if none
fn uifiles_selected_path() {
    if uifiles_entry_count == 0 { return ""; }
    if uifiles_selected_idx >= uifiles_entry_count { return ""; }
    let mut name = uifiles_entries[uifiles_selected_idx][0];
    if name == ".." { return uifiles_current_path; }
    if uifiles_current_path == "/" { return "/" + name; }
    return uifiles_current_path + "/" + name;
}

fn uifiles_draw_icon(x, y, is_dir) {
    if is_dir == 1 {
        let mut fg = ui_theme_accent();
        vesa_rect(x, y, 12, 10, fg);
        vesa_hline(x + 3, y + 3, 5, fg);
        return 0;
    }

    let mut fg = ui_theme_text_secondary();
    vesa_vline(x + 2, y + 2, 9, fg);
    vesa_hline(x + 2, y + 2, 7, fg);
    return 0;
}

fn uifiles_render(window_id) {
    let mut addr = WM_TABLE_ADDR + window_id * 128;
    let mut x = mem_read_u64(addr + 8);
    let mut y = mem_read_u64(addr + 16);
    let mut w = mem_read_u64(addr + 24);
    let mut h = mem_read_u64(addr + 32);

    vesa_fill_rect(x, y, w, h, ui_theme_bg_surface());
    vesa_fill_rect(x, y, w, 24, ui_theme_bg_elevated());
    ui_draw_text(x + 8, y + 4, "File Manager", ui_theme_text_primary(), 0);

    let mut path_y = y + 30;
    vesa_fill_rect(x, path_y, w, 24, ui_theme_bg_elevated());
    ui_label(x + 8, path_y + 4, uifiles_current_path);

    let mut list_y = path_y + 28;
    vesa_fill_rect(x, list_y, w, 20, ui_theme_bg_elevated());
    ui_label(x + 8, list_y + 2, "Name");
    ui_label(x + 300, list_y + 2, "Type");
    vesa_hline(x, list_y + 20, w, ui_theme_border());

    let mut entries_y = list_y + 22;
    let mut visible_rows = (h - (entries_y - y) - 20) / UIFILES_ENTRY_HEIGHT;
    let mut row = 0;

    while row < visible_rows {
        let mut idx = uifiles_scroll_pos + row;
        if idx >= uifiles_entry_count { row = visible_rows; }
        if row < visible_rows {
            let mut entry = uifiles_entries[idx];
            let mut name = entry[0];
            let mut is_dir = entry[1];
            let mut item_y = entries_y + row * UIFILES_ENTRY_HEIGHT;

            if idx == uifiles_selected_idx {
                vesa_fill_rect(x, item_y, w, UIFILES_ENTRY_HEIGHT, ui_theme_accent());
            }

            uifiles_draw_icon(x + 6, item_y + 4, is_dir);
            ui_label(x + 24, item_y + 4, name);

            if is_dir == 1 {
                ui_label_colored(x + 300, item_y + 4, "DIR", ui_theme_accent());
            } else {
                ui_label_colored(x + 300, item_y + 4, "file", ui_theme_text_secondary());
            }

            row = row + 1;
        }
    }

    // Draw scroll bar if needed
    if uifiles_entry_count > visible_rows {
        let mut bar_h = h - (entries_y - y) - 20;
        let mut thumb_h = visible_rows * bar_h / uifiles_entry_count;
        let mut thumb_y = entries_y + uifiles_scroll_pos * bar_h / uifiles_entry_count;
        vesa_fill_rect(x + w - 8, entries_y, 6, bar_h, ui_theme_bg_elevated());
        vesa_fill_rect(x + w - 8, thumb_y, 6, thumb_h, ui_theme_accent());
    }

    // Overlay context menu if open
    if uifiles_ctx_open == 1 {
        uifiles_ctx_render();
    }

    return 0;
}

// --- Context Menu ---

fn uifiles_ctx_label(item) {
    if item == UIFILES_CTX_DELETE  { return "Delete"; }
    if item == UIFILES_CTX_NEWFOLD { return "New Folder"; }
    if item == UIFILES_CTX_COPY    { return "Copy Path"; }
    if item == UIFILES_CTX_CANCEL  { return "Cancel"; }
    return "";
}

fn uifiles_ctx_render() {
    let mut menu_h = UIFILES_CTX_ITEMS * UIFILES_CTX_ITEM_H + 4;
    vesa_fill_rect(uifiles_ctx_x, uifiles_ctx_y, UIFILES_CTX_W, menu_h, ui_theme_bg_elevated());
    vesa_rect(uifiles_ctx_x, uifiles_ctx_y, UIFILES_CTX_W, menu_h, ui_theme_border());

    let mut i = 1;
    while i <= UIFILES_CTX_ITEMS {
        let mut iy = uifiles_ctx_y + 2 + (i - 1) * UIFILES_CTX_ITEM_H;
        let mut label = uifiles_ctx_label(i);
        // Separator before Cancel
        if i == UIFILES_CTX_CANCEL {
            vesa_hline(uifiles_ctx_x + 4, iy - 2, UIFILES_CTX_W - 8, ui_theme_border());
        }
        ui_label(uifiles_ctx_x + 10, iy + 4, label);
        i = i + 1;
    }
}

fn uifiles_ctx_show(mx, my) {
    uifiles_ctx_x = mx;
    uifiles_ctx_y = my;
    uifiles_ctx_open = 1;
}

fn uifiles_ctx_hide() {
    uifiles_ctx_open = 0;
}

// Handle click on context menu; returns action id or 0
fn uifiles_ctx_handle_click(mx, my) {
    if uifiles_ctx_open == 0 { return 0; }

    let mut menu_h = UIFILES_CTX_ITEMS * UIFILES_CTX_ITEM_H + 4;

    // Click outside = cancel
    if mx < uifiles_ctx_x { uifiles_ctx_hide(); return UIFILES_CTX_CANCEL; }
    if mx > uifiles_ctx_x + UIFILES_CTX_W { uifiles_ctx_hide(); return UIFILES_CTX_CANCEL; }
    if my < uifiles_ctx_y { uifiles_ctx_hide(); return UIFILES_CTX_CANCEL; }
    if my > uifiles_ctx_y + menu_h { uifiles_ctx_hide(); return UIFILES_CTX_CANCEL; }

    let mut row = (my - uifiles_ctx_y - 2) / UIFILES_CTX_ITEM_H;
    let mut action = row + 1;
    uifiles_ctx_hide();
    return action;
}

// --- File Operations ---

fn uifiles_op_delete() {
    let mut path = uifiles_selected_path();
    if len(path) == 0 { return 0 - 1; }
    let mut result = vfs_unlink(path);
    uifiles_load_dir(uifiles_current_path);  // refresh
    return result;
}

fn uifiles_op_new_folder(name) {
    let mut path = uifiles_current_path + "/" + name;
    let mut result = vfs_mkdir(path);
    uifiles_load_dir(uifiles_current_path);  // refresh
    return result;
}

fn uifiles_op_copy(dst_dir) {
    let mut src_path = uifiles_selected_path();
    if len(src_path) == 0 { return 0 - 1; }
    let mut name = uifiles_entries[uifiles_selected_idx][0];
    let mut dst_path = dst_dir + "/" + name;
    return vfs_copy(src_path, dst_path);
}

// --- Click / input handlers ---

fn uifiles_handle_click(click_x, click_y, double_click) {
    // Delegate to context menu first if open
    if uifiles_ctx_open == 1 {
        let mut action = uifiles_ctx_handle_click(click_x, click_y);
        if action == UIFILES_CTX_DELETE  { uifiles_op_delete(); return 1; }
        if action == UIFILES_CTX_NEWFOLD {
            uifiles_op_new_folder("new_folder");
            return 1;
        }
        // COPY_PATH and CANCEL: just hide
        return 1;
    }

    let mut addr = WM_TABLE_ADDR + uifiles_window_id * 128;
    let mut x = mem_read_u64(addr + 8);
    let mut y = mem_read_u64(addr + 16);

    let mut entries_y = y + 104;
    if click_y < entries_y { return 0; }

    let mut row = (click_y - entries_y) / UIFILES_ENTRY_HEIGHT;
    let mut idx = uifiles_scroll_pos + row;

    if idx >= uifiles_entry_count { return 0; }

    uifiles_selected_idx = idx;

    if double_click == 1 {
        let mut entry = uifiles_entries[idx];
        let mut name = entry[0];
        let mut is_dir = entry[1];

        if is_dir == 1 {
            let mut new_path = uifiles_current_path + "/" + name;
            if name == ".." {
                let mut parts = _vfs_split_path(uifiles_current_path);
                if len(parts) > 1 {
                    new_path = "";
                    let mut i = 0;
                    while i < len(parts) - 1 {
                        new_path = new_path + "/" + parts[i];
                        i = i + 1;
                    }
                    if len(new_path) == 0 { new_path = "/"; }
                }
            }
            uifiles_navigate(new_path);
        }
    }

    return 0;
}

// Right-click: show context menu at (mx, my)
fn uifiles_handle_right_click(mx, my) {
    uifiles_ctx_show(mx, my);
    return 0;
}

fn uifiles_open() {
    uifiles_window_id = wm_create_window(50, 50, UIFILES_WINDOW_W, UIFILES_WINDOW_H, "File Manager");
    if uifiles_window_id < 0 {
        klog(3, "UI", "Failed to create file manager window");
        return 0 - 1;
    }
    uifiles_navigate("/");
    return uifiles_window_id;
}

fn uifiles_update() {
    if uifiles_window_id < 0 { return 0; }
    uifiles_render(uifiles_window_id);
    return 0;
}

fn uifiles_close() {
    if uifiles_window_id >= 0 {
        wm_close_window(uifiles_window_id);
        uifiles_window_id = 0 - 1;
    }
    uifiles_entries = [];
    uifiles_entry_count = 0;
    uifiles_ctx_open = 0;
    return 0;
}

fn uifiles_is_open() {
    if uifiles_window_id < 0 { return 0; }
    return 1;
}

print("ui_files.hl loaded");
print("File manager: navigate/select/ctx-menu/delete/new-folder/copy");

