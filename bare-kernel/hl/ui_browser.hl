// ui_browser.hl -- Graphical Text Browser
//
// Iteration 159: Simple HTTP text/HTML browser in a WM window.
//
// Layout: 640x440 window
//   URL bar (28px)  : text input + [Go] [Back] [Refresh] buttons
//   Status bar (16px): current URL + loading status
//   Content area (396px): scrollable rendered text
//
// HTTP flow:
//   1. User types URL in URL bar or shell: "browse <url>"
//   2. uibrowse_navigate(url): parse host+path, call http_get+tcp,
//      read response, strip HTTP headers, strip HTML tags.
//   3. Render plain text with line wrapping at COLS (76 chars).
//   4. Scroll: Page Up / Page Down / arrow keys.
//
// HTML stripping: remove <tags>, decode &amp; &lt; &gt; &quot;
// Line wrapping: break at COLS characters.
//
// Shell: browse <url>   or   browse (opens empty browser)

let UIBROW_WIN_X   = 40;
let UIBROW_WIN_Y   = 40;
let UIBROW_WIN_W   = 640;
let UIBROW_WIN_H   = 440;
let UIBROW_URLBAR_H = 28;
let UIBROW_STATUS_H = 16;
let UIBROW_CONTENT_H = 396;   // = WIN_H - title(20) - urlbar - status
let UIBROW_COLS    = 76;      // chars per line
let UIBROW_PAGE_LINES = 20;   // visible lines

// State
let mut uibrowse_open_flag  = 0;
let mut uibrowse_url        = "";
let mut uibrowse_url_input  = "";   // URL bar edit buffer
let mut uibrowse_status     = "Ready";
let mut uibrowse_lines      = [];   // rendered lines array
let mut uibrowse_scroll     = 0;    // first visible line index
let mut uibrowse_back_url   = "";   // 1-deep history
let mut uibrowse_url_focus  = 0;    // 1 = URL bar has focus

// ============================================================
// HTML / text processing
// ============================================================

// Strip HTML tags and decode basic entities from raw HTML
fn _uibrowse_strip_html(html) {
    let mut out = "";
    let mut n = len(html);
    let mut i = 0;
    let mut in_tag = 0;
    while i < n {
        let mut c = char_at(html, i);
        if c == "<" {
            in_tag = 1;
            // Detect block-level tags: add newline for </p> <br> <li> etc.
            if i + 2 < n {
                let tag3 = str_sub(html, i, i + 3);
                let tag4 = str_sub(html, i, i + 4);
                if tag3 == "<br" { out = out + "\n"; }
                if tag3 == "<p>" { out = out + "\n"; }
                if tag4 == "</p>" { out = out + "\n"; }
                if tag3 == "<li" { out = out + "\n  * "; }
                if tag3 == "<h1" { out = out + "\n=== "; }
                if tag3 == "<h2" { out = out + "\n--- "; }
                if tag4 == "</h1" { out = out + " ===\n"; }
                if tag4 == "</h2" { out = out + " ---\n"; }
                if tag4 == "<div" { out = out + "\n"; }
                if tag4 == "</di" { out = out + "\n"; }
            }
        }
        else if c == ">" { in_tag = 0; }
        else if in_tag == 0 {
            if c == "&" {
                // Decode entity
                if i + 4 < n {
                    let ent = str_sub(html, i, i + 5);
                    if ent == "&amp;" { out = out + "&"; i = i + 4; }
                    else if str_sub(html, i, i + 4) == "&lt;" { out = out + "<"; i = i + 3; }
                    else if str_sub(html, i, i + 4) == "&gt;" { out = out + ">"; i = i + 3; }
                    else if str_sub(html, i, i + 6) == "&quot;" { out = out + "\""; i = i + 5; }
                    else { out = out + c; }
                } else { out = out + c; }
            } else {
                out = out + c;
            }
        }
        i = i + 1;
    }
    return out;
}

// Word-wrap text into COLS-width lines, split on '\n' first
fn _uibrowse_wrap(text) {
    let mut lines = [];
    let mut n = len(text);
    let mut line = "";
    let mut i = 0;
    while i < n {
        let mut c = char_at(text, i);
        if c == "\n" {
            push(lines, line);
            line = "";
        } else if c == "\r" {
            // skip CR
        } else {
            line = line + c;
            if len(line) >= UIBROW_COLS {
                push(lines, line);
                line = "";
            }
        }
        i = i + 1;
    }
    if len(line) > 0 { push(lines, line); }
    return lines;
}

// Extract body from HTTP response (skip headers after \r\n\r\n)
fn _uibrowse_http_body(response) {
    let mut n = len(response);
    let mut i = 0;
    while i + 3 < n {
        if char_at(response, i) == "\r" {
            if char_at(response, i + 1) == "\n" {
                if char_at(response, i + 2) == "\r" {
                    if char_at(response, i + 3) == "\n" {
                        return str_sub(response, i + 4, n);
                    }
                }
            }
        }
        i = i + 1;
    }
    return response;  // no headers found, return as-is
}

// Parse URL "http://host/path" or "host/path" → [host, path]
fn _uibrowse_parse_url(url) {
    let mut u = url;
    // Strip "http://"
    if str_starts_with(u, "http://") { u = str_sub(u, 7, len(u)); }
    if str_starts_with(u, "https://") { u = str_sub(u, 8, len(u)); }
    let sl = str_find(u, "/");
    if sl < 0 { return [u, "/"]; }
    return [str_sub(u, 0, sl), str_sub(u, sl, len(u))];
}

// ============================================================
// Navigation
// ============================================================

fn uibrowse_navigate(url) {
    if len(url) == 0 { return 0; }
    uibrowse_back_url = uibrowse_url;
    uibrowse_url      = url;
    uibrowse_status   = "Loading: " + url;
    uibrowse_scroll   = 0;
    uibrowse_lines    = [];
    _uibrowse_toolbar_draw();

    let parts = _uibrowse_parse_url(url);
    let host  = parts[0];
    let path  = parts[1];

    // Open TCP connection directly (avoids TLS complexity)
    let ip  = dns_resolve(host);
    let tcb = tcp_connect(ip, 80);
    if tcb < 0 {
        uibrowse_status = "Error: cannot connect to " + host;
        uibrowse_lines  = ["Connection failed: " + host, "", "Check hostname and network."];
        _uibrowse_content_draw();
        _uibrowse_toolbar_draw();
        return 0 - 1;
    }

    // Send HTTP/1.0 GET
    let req = "GET " + path + " HTTP/1.0\r\n"
        + "Host: " + host + "\r\n"
        + "User-Agent: HicOS-Browser/1.0\r\n"
        + "Connection: close\r\n"
        + "\r\n";
    tcp_send(tcb, req);

    // Read response into buffer
    let mut resp = "";
    let buf_addr = 10158080;  // 0x9B0000 — 64 KB response buffer
    let mut n = tcp_recv(tcb, buf_addr, 65535);
    tcp_close(tcb);

    if n <= 0 {
        uibrowse_status = "Error: no response from " + host;
        uibrowse_lines  = ["No response."];
        _uibrowse_content_draw();
        _uibrowse_toolbar_draw();
        return 0 - 2;
    }

    // Reconstruct string from buffer
    let mut i = 0;
    while i < n {
        let mut b = mem_read_u8(buf_addr + i);
        if b > 0 { resp = resp + str_from_code(b); }
        i = i + 1;
    }

    // Extract body + strip HTML
    let body  = _uibrowse_http_body(resp);
    let plain = _uibrowse_strip_html(body);
    uibrowse_lines  = _uibrowse_wrap(plain);
    uibrowse_status = url + " (" + to_string(len(uibrowse_lines)) + " lines)";
    _uibrowse_content_draw();
    _uibrowse_toolbar_draw();
    return 0;
}

fn uibrowse_back() {
    if len(uibrowse_back_url) > 0 {
        uibrowse_navigate(uibrowse_back_url);
    }
    return 0;
}

// ============================================================
// Drawing
// ============================================================

fn _uibrowse_toolbar_draw() {
    let wx  = UIBROW_WIN_X;
    let wy  = UIBROW_WIN_Y + 20;   // below title bar
    let bg  = ui_theme_panel_color();
    let bdr = ui_theme_border_color();
    let fg  = ui_theme_text_color();

    // URL bar background
    vesa_fill_rect(wx, wy, UIBROW_WIN_W, UIBROW_URLBAR_H, bg);
    vesa_rect(wx, wy, UIBROW_WIN_W, UIBROW_URLBAR_H, bdr);

    // URL input field
    vesa_fill_rect(wx + 4, wy + 4, UIBROW_WIN_W - 140, 20, ui_theme_surface_color());
    vesa_rect(wx + 4, wy + 4, UIBROW_WIN_W - 140, 20, bdr);
    let url_disp = uibrowse_url_input;
    if len(url_disp) == 0 { url_disp = uibrowse_url; }
    ui_draw_text(wx + 8, wy + 6, url_disp, fg, 0);

    // Buttons: Go, Back, Refresh
    ui_button(wx + UIBROW_WIN_W - 132, wy + 4, 40, 20, "Go");
    ui_button(wx + UIBROW_WIN_W - 88,  wy + 4, 40, 20, "Back");
    ui_button(wx + UIBROW_WIN_W - 44,  wy + 4, 40, 20, "Rld");

    // Status bar
    let sy = wy + UIBROW_URLBAR_H;
    vesa_fill_rect(wx, sy, UIBROW_WIN_W, UIBROW_STATUS_H, bg);
    ui_draw_text(wx + 4, sy + 1, uibrowse_status, fg, 0);
    return 0;
}

fn _uibrowse_content_draw() {
    if uibrowse_open_flag == 0 { return 0; }
    let cx  = UIBROW_WIN_X;
    let cy  = UIBROW_WIN_Y + 20 + UIBROW_URLBAR_H + UIBROW_STATUS_H;
    let cw  = UIBROW_WIN_W;
    let ch  = UIBROW_CONTENT_H;
    let bg  = ui_theme_surface_color();
    let fg  = ui_theme_text_color();

    vesa_fill_rect(cx, cy, cw, ch, bg);

    let mut total = len(uibrowse_lines);
    let mut row = 0;
    while row < UIBROW_PAGE_LINES {
        let li = uibrowse_scroll + row;
        if li < total {
            let line = uibrowse_lines[li];
            ui_draw_text(cx + 4, cy + 2 + row * 18, line, fg, 0);
        }
        row = row + 1;
    }

    // Scroll indicator
    if total > UIBROW_PAGE_LINES {
        let pct = (uibrowse_scroll * 100) / (total - UIBROW_PAGE_LINES);
        vesa_fill_rect(cx + cw - 8, cy + (ch * pct / 100), 6, 16, ui_theme_accent_color());
    }
    return 0;
}

fn uibrowse_draw() {
    if uibrowse_open_flag == 0 { return 0; }
    let wx = UIBROW_WIN_X;
    let wy = UIBROW_WIN_Y;
    let bdr = ui_theme_border_color();
    // Window outline + title
    vesa_fill_rect(wx, wy, UIBROW_WIN_W, 20, ui_theme_panel_color());
    ui_draw_text(wx + 8, wy + 2, "Browser  " + uibrowse_url, ui_theme_text_color(), 0);
    vesa_rect(wx, wy, UIBROW_WIN_W, UIBROW_WIN_H, bdr);
    _uibrowse_toolbar_draw();
    _uibrowse_content_draw();
    return 0;
}

// ============================================================
// Input
// ============================================================

fn uibrowse_key(k) {
    if uibrowse_open_flag == 0 { return 0; }
    if k == 27  { uibrowse_close(); return 1; }           // Esc = close
    if k == 13  {                                          // Enter = navigate
        if len(uibrowse_url_input) > 0 {
            let mut u = uibrowse_url_input;
            uibrowse_url_input = "";
            uibrowse_navigate(u);
        }
        return 1;
    }
    if k == 8 {                                            // Backspace
        if len(uibrowse_url_input) > 1 {
            uibrowse_url_input = str_sub(uibrowse_url_input, 0, len(uibrowse_url_input) - 1);
        } else { uibrowse_url_input = ""; }
        _uibrowse_toolbar_draw();
        return 1;
    }
    // Page up/down (ASCII fallback: [ = 91, ] = 93)
    if k == 339 { // Page Up (VT key code approx)
        if uibrowse_scroll >= UIBROW_PAGE_LINES { uibrowse_scroll = uibrowse_scroll - UIBROW_PAGE_LINES; }
        else { uibrowse_scroll = 0; }
        _uibrowse_content_draw();
        return 1;
    }
    if k == 338 { // Page Down
        let mut max = len(uibrowse_lines) - UIBROW_PAGE_LINES;
        if max > 0 {
            uibrowse_scroll = uibrowse_scroll + UIBROW_PAGE_LINES;
            if uibrowse_scroll > max { uibrowse_scroll = max; }
        }
        _uibrowse_content_draw();
        return 1;
    }
    // Up/down arrows
    if k == 65 {  // 'A' as up (arrow approx)
        if uibrowse_scroll > 0 { uibrowse_scroll = uibrowse_scroll - 1; _uibrowse_content_draw(); }
        return 1;
    }
    if k == 90 {  // 'Z' as down (arrow approx)
        let mut max = len(uibrowse_lines) - UIBROW_PAGE_LINES;
        if max > 0 { if uibrowse_scroll < max { uibrowse_scroll = uibrowse_scroll + 1; } }
        _uibrowse_content_draw();
        return 1;
    }
    // Printable: type URL
    if k >= 32 { if k <= 126 {
        uibrowse_url_input = uibrowse_url_input + str_from_code(k);
        _uibrowse_toolbar_draw();
        return 1;
    }}
    return 0;
}

fn uibrowse_click(mx, my) {
    if uibrowse_open_flag == 0 { return 0; }
    let wx = UIBROW_WIN_X;
    let wy = UIBROW_WIN_Y + 20;
    // Toolbar button hit tests
    if ui_button_hit(wx + UIBROW_WIN_W - 132, wy + 4, 40, 20, mx, my) == 1 {
        let mut u = uibrowse_url_input;
        if len(u) == 0 { u = uibrowse_url; }
        uibrowse_url_input = "";
        uibrowse_navigate(u);
        return 1;
    }
    if ui_button_hit(wx + UIBROW_WIN_W - 88, wy + 4, 40, 20, mx, my) == 1 {
        uibrowse_back();
        return 1;
    }
    if ui_button_hit(wx + UIBROW_WIN_W - 44, wy + 4, 40, 20, mx, my) == 1 {
        uibrowse_navigate(uibrowse_url);
        return 1;
    }
    return 0;
}

// ============================================================
// Lifecycle
// ============================================================

fn uibrowse_open() {
    uibrowse_url       = "";
    uibrowse_url_input = "";
    uibrowse_status    = "Ready — type URL and press Enter";
    uibrowse_lines     = ["Welcome to HicOS Browser", "",
        "Type a URL in the address bar above and press Enter or click Go.",
        "Supports HTTP/1.0 GET. HTML tags stripped for text rendering.",
        "",
        "Shortcuts:", "  Enter   navigate", "  Esc     close",
        "  Bksp    edit URL", "  A/Z     scroll up/down (one line)",
        "  PgUp/Dn scroll page"];
    uibrowse_scroll    = 0;
    uibrowse_back_url  = "";
    uibrowse_open_flag = 1;
    uibrowse_draw();
    return 0;
}

fn uibrowse_close() {
    uibrowse_open_flag = 0;
    vesa_fill_rect(UIBROW_WIN_X, UIBROW_WIN_Y, UIBROW_WIN_W, UIBROW_WIN_H,
        ui_theme_bg_color());
    return 0;
}

fn uibrowse_is_open() { return uibrowse_open_flag; }

print("ui_browser.hl loaded");
print("Browser: HTTP/1.0 GET, HTML tag stripping, 76-col wrap, 640x440 window, scroll");
