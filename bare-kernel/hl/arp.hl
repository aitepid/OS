// arp.hl -- ARP with Hash Table Cache (RFC 826)
//
// Iteration 91: upgraded from O(n) linear scan to O(1) hash lookup.
//
// Design:
//   32 cache entries, 16-bucket hash table (separate chaining)
//   Hash function: packed_ip % 16
//   arp_table_lookup/arp_table_update: O(1) average
//
// Public API (all signatures preserved):
//   arp_table_lookup / arp_table_update / arp_build_request / arp_handle_packet / arp_resolve

let ARP_HTYPE_ETHERNET = 1;
let ARP_PTYPE_IPV4 = 2048;
let ARP_OP_REQUEST = 1;
let ARP_OP_REPLY = 2;
let ETHERTYPE_ARP = 2054;

let ARP_CACHE_SIZE = 32;
let ARP_HASH_BUCKETS = 16;

let mut arp_cache_count = 0;

// Per-slot parallel arrays
let mut _arp_ip = [];
let mut _arp_mac = [];
let mut _arp_valid = [];

// Hash table: separate chaining
let mut _arp_ht = [];        // bucket -> first slot (-1)
let mut _arp_ht_next = [];   // slot -> next in chain (-1)

fn _arp_hash(ip) {
    let mut h = ip % ARP_HASH_BUCKETS;
    if h < 0 { return h + ARP_HASH_BUCKETS; }
    return h;
}

fn _arp_cache_init() {
    _arp_ip = [];
    _arp_mac = [];
    _arp_valid = [];
    _arp_ht_next = [];
    let mut i = 0;
    while i < ARP_CACHE_SIZE {
        push(_arp_ip, 0);
        push(_arp_mac, [0, 0, 0, 0, 0, 0]);
        push(_arp_valid, 0);
        push(_arp_ht_next, 0 - 1);
        i = i + 1;
    }
    _arp_ht = [];
    i = 0;
    while i < ARP_HASH_BUCKETS {
        push(_arp_ht, 0 - 1);
        i = i + 1;
    }
    arp_cache_count = 0;
    return 0;
}

// ============================================================
// Hash table operations
// ============================================================

fn _arp_ht_find(ip) {
    let bucket = _arp_hash(ip);
    let mut cur = _arp_ht[bucket];
    while cur >= 0 {
        if _arp_valid[cur] == 1 {
            if _arp_ip[cur] == ip { return cur; }
        }
        cur = _arp_ht_next[cur];
    }
    return 0 - 1;
}

fn _arp_ht_insert(slot, ip) {
    let bucket = _arp_hash(ip);
    set_at(_arp_ht_next, slot, _arp_ht[bucket]);
    set_at(_arp_ht, bucket, slot);
    return 0;
}

fn _arp_ht_remove(slot) {
    let ip = _arp_ip[slot];
    let bucket = _arp_hash(ip);
    let mut prev = 0 - 1;
    let mut cur = _arp_ht[bucket];
    while cur >= 0 {
        if cur == slot {
            if prev < 0 {
                set_at(_arp_ht, bucket, _arp_ht_next[cur]);
            } else {
                set_at(_arp_ht_next, prev, _arp_ht_next[cur]);
            }
            set_at(_arp_ht_next, slot, 0 - 1);
            return 1;
        }
        prev = cur;
        cur = _arp_ht_next[cur];
    }
    return 0;
}

// ============================================================
// Public API
// ============================================================

fn arp_table_lookup(ip) {
    let mut slot = _arp_ht_find(ip);
    if slot >= 0 { return _arp_mac[slot]; }
    return [0, 0, 0, 0, 0, 0];
}

fn arp_table_update(ip, mac) {
    // Check if already cached
    let mut slot = _arp_ht_find(ip);
    if slot >= 0 {
        set_at(_arp_mac, slot, mac);
        return 0;
    }
    // Find free slot
    let mut free = 0 - 1;
    let mut i = 0;
    while i < ARP_CACHE_SIZE {
        if _arp_valid[i] == 0 {
            free = i;
            i = ARP_CACHE_SIZE;
        }
        i = i + 1;
    }
    // If full, evict slot 0 (simple policy)
    if free < 0 {
        free = 0;
        _arp_ht_remove(0);
        set_at(_arp_valid, 0, 0);
        arp_cache_count = arp_cache_count - 1;
    }
    set_at(_arp_ip, free, ip);
    set_at(_arp_mac, free, mac);
    set_at(_arp_valid, free, 1);
    _arp_ht_insert(free, ip);
    arp_cache_count = arp_cache_count + 1;
    return 0;
}

fn arp_build_request(sender_ip, sender_mac, target_ip) {
    let mut pkt = [];
    push(pkt, 0); push(pkt, 1);
    push(pkt, 8); push(pkt, 0);
    push(pkt, 6); push(pkt, 4);
    push(pkt, 0); push(pkt, 1);
    let mut j = 0;
    while j < 6 { push(pkt, sender_mac[j]); j = j + 1; }
    push(pkt, (sender_ip / 16777216) % 256);
    push(pkt, (sender_ip / 65536) % 256);
    push(pkt, (sender_ip / 256) % 256);
    push(pkt, sender_ip % 256);
    j = 0;
    while j < 6 { push(pkt, 0); j = j + 1; }
    push(pkt, (target_ip / 16777216) % 256);
    push(pkt, (target_ip / 65536) % 256);
    push(pkt, (target_ip / 256) % 256);
    push(pkt, target_ip % 256);
    return pkt;
}

fn arp_handle_packet(data) {
    if len(data) < 28 { return 0; }
    let op = data[6] * 256 + data[7];
    let sender_mac = [data[8], data[9], data[10], data[11], data[12], data[13]];
    let sender_ip = data[14] * 16777216 + data[15] * 65536 + data[16] * 256 + data[17];
    arp_table_update(sender_ip, sender_mac);
    return 0;
}

fn arp_resolve(target_ip) {
    let mac = arp_table_lookup(target_ip);
    if mac[0] != 0 { return mac; }
    return [0, 0, 0, 0, 0, 0];
}

// Return all valid ARP cache entries as [[ip_string, mac_string], ...]
fn arp_table_snapshot() {
    let mut result = [];
    let mut i = 0;
    while i < ARP_CACHE_SIZE {
        if _arp_valid[i] == 1 {
            let ip = _arp_ip[i];
            let ip_s = to_string((ip / 16777216) % 256) + "."
                     + to_string((ip / 65536) % 256) + "."
                     + to_string((ip / 256) % 256) + "."
                     + to_string(ip % 256);
            let mac = _arp_mac[i];
            let mac_s = format_hex(mac[0], 2) + ":" + format_hex(mac[1], 2) + ":"
                      + format_hex(mac[2], 2) + ":" + format_hex(mac[3], 2) + ":"
                      + format_hex(mac[4], 2) + ":" + format_hex(mac[5], 2);
            push(result, [ip_s, mac_s]);
        }
        i = i + 1;
    }
    return result;
}

// Init on load
_arp_cache_init();

print("arp.hl loaded (hash table cache)");
print("ARP: " + to_string(ARP_CACHE_SIZE) + " entries, " + to_string(ARP_HASH_BUCKETS) + " hash buckets");
