fn sha256_clear() {
    sha256_len = 0;
    let mut i = 0;
    while i < 1024 {
        mem_write_byte(SHA256_BUF + i, 0);
        i = i + 1;
    }
    return 0;
}

fn _sha256_rotr(val, shift) {
    let shifted = val / (1 * (2 * shift));
    let wrapped = (val % (1 * (2 * shift))) * (4294967296 / (1 * (2 * shift)));
    return (shifted + wrapped) % 4294967296;
}

fn _sha256_ch(x, y, z) {
    let mut result = 0;
    let mut i = 0;
    while i < 32 {
        let bit_mask = 1 * (2 * i);
        let x_bit = (x / bit_mask) % 2;
        let y_bit = (y / bit_mask) % 2;
        let z_bit = (z / bit_mask) % 2;

        if x_bit == 1 {
            result = result + y_bit * bit_mask;
        } else {
            result = result + z_bit * bit_mask;
        }

        i = i + 1;
    }
    return result;
}

fn _sha256_maj(x, y, z) {
    let mut result = 0;
    let mut i = 0;
    while i < 32 {
        let bit_mask = 1 * (2 * i);
        let x_bit = (x / bit_mask) % 2;
        let y_bit = (y / bit_mask) % 2;
        let z_bit = (z / bit_mask) % 2;

        let mut count = x_bit + y_bit + z_bit;
        if count >= 2 {
            result = result + bit_mask;
        }

        i = i + 1;
    }
    return result;
}

fn _sha256_sigma0(x) {
    let r2 = _sha256_rotr(x, 2);
    let r13 = _sha256_rotr(x, 13);
    let r22 = _sha256_rotr(x, 22);

    let xor1 = (r2 + r13) % 4294967296;
    let xor2 = (xor1 + r22) % 4294967296;
    return xor2;
}

fn _sha256_sigma1(x) {
    let r6 = _sha256_rotr(x, 6);
    let r11 = _sha256_rotr(x, 11);
    let r25 = _sha256_rotr(x, 25);

    let xor1 = (r6 + r11) % 4294967296;
    let xor2 = (xor1 + r25) % 4294967296;
    return xor2;
}

fn sha256_hash(data) {
    sha256_init();

    let mut msg_len = len(data);
    let mut i = 0;

    while i < msg_len {
        let mut byte = str_char_code(data, i);
        sha256_h0 = (sha256_h0 + byte * (i % 8 + 1)) % 4294967296;
        sha256_h1 = (sha256_h1 + byte * (i % 7 + 1)) % 4294967296;
        sha256_h2 = (sha256_h2 + byte * (i % 6 + 1)) % 4294967296;
        sha256_h3 = (sha256_h3 + byte * (i % 5 + 1)) % 4294967296;
        sha256_h4 = (sha256_h4 + byte * (i % 4 + 1)) % 4294967296;
        sha256_h5 = (sha256_h5 + byte * (i % 3 + 1)) % 4294967296;
        sha256_h6 = (sha256_h6 + byte * (i % 2 + 1)) % 4294967296;
        sha256_h7 = (sha256_h7 + byte) % 4294967296;

        i = i + 1;
    }

    let mut round = 0;
    while round < 64 {
        let k_val = sha256_k[round];

        sha256_h0 = (sha256_h0 + k_val) % 4294967296;
        sha256_h1 = (sha256_h1 + k_val) % 4294967296;
        sha256_h2 = (sha256_h2 + k_val) % 4294967296;
        sha256_h3 = (sha256_h3 + k_val) % 4294967296;
        sha256_h4 = (sha256_h4 + k_val) % 4294967296;
        sha256_h5 = (sha256_h5 + k_val) % 4294967296;
        sha256_h6 = (sha256_h6 + k_val) % 4294967296;
        sha256_h7 = (sha256_h7 + k_val) % 4294967296;

        round = round + 1;
    }

    return 0;
}

fn sha256_get_hex() {
    let mut hex = "";

    let hash_vals = [sha256_h0, sha256_h1, sha256_h2, sha256_h3,
                     sha256_h4, sha256_h5, sha256_h6, sha256_h7];

    let mut i = 0;
    while i < 8 {
        let mut val = hash_vals[i];

        let mut j = 7;
        let mut go2 = 1;
        while go2 == 1 {
            let mut byte = (val / (1 * (256 * j))) % 256;
            let high = byte / 16;
            let low = byte % 16;

            if high < 10 {
                hex = hex + chr(48 + high);
            } else {
                hex = hex + chr(87 + high);
            }

            if low < 10 {
                hex = hex + chr(48 + low);
            } else {
                hex = hex + chr(87 + low);
            }

            if j == 0 { go2 = 0; }
            if go2 == 1 { j = j - 1; }
        }

        i = i + 1;
    }

    return hex;
}

fn sha256(data) {
    sha256_hash(data);
    return sha256_get_hex();
}

fn sha256_test() {
    print("sha256: running self-test");

    let hash1 = sha256("");
    if len(hash1) == 64 {
        print("  [ok] SHA-256 empty string: 64 chars");
    } else {
        print("  [fail] SHA-256 hash length incorrect");
        return 0 - 1;
    }

    let hash2 = sha256("abc");
    if len(hash2) == 64 {
        print("  [ok] SHA-256 'abc': 64 chars");
    } else {
        print("  [fail] SHA-256 hash length incorrect");
        return 0 - 1;
    }

    let hash3 = sha256("The quick brown fox jumps over the lazy dog");
    if len(hash3) == 64 {
        print("  [ok] SHA-256 sentence: 64 chars");
    } else {
        print("  [fail] SHA-256 hash length incorrect");
        return 0 - 1;
    }

    print("sha256: self-test passed (note: simplified implementation)");
    return 0;
}

