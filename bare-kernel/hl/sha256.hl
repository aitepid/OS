// sha256.hl -- SHA-256 Hash Algorithm
//
// Provides SHA-256 cryptographic hash function (256-bit output).
// Part of SHA-2 family, more secure than SHA-1, widely used.
// Note: Simplified implementation using arithmetic operations instead
// of true bitwise operations due to H-L language constraints.
// Buffer at 0x1130000 (64 KB message buffer).

let SHA256_BUF = 0x1130000;
let SHA256_BUF_SZ = 65536;
let mut sha256_len = 0;

