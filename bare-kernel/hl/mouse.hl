// mouse.hl -- PS/2 Mouse Driver
//
// Handles IRQ12 (vector 44) for PS/2 mouse via the 8042 controller.
// Mouse sends 3-byte packets: [status, dx, dy]
//
// Status byte bits:
//   bit 0: left button
//   bit 1: right button
//   bit 2: middle button
//   bit 3: always 1 (sync bit)
//   bit 4: X sign
//   bit 5: Y sign
//   bit 6: X overflow
//   bit 7: Y overflow

let MOUSE_DATA_ADDR = 3145752;   // 0x300018
let MOUSE_X_ADDR    = 3145760;   // 0x300020
let MOUSE_Y_ADDR    = 3145768;   // 0x300028
let MOUSE_BTN_ADDR  = 3145776;   // 0x300030
let MOUSE_READY     = 3145784;   // 0x300038

let mut mouse_x = 40;  // center of 80-col screen
let mut mouse_y = 12;  // center of 25-row screen
let mut mouse_cycle = 0;
let mut mouse_bytes = [0, 0, 0];
let mut mouse_screen_w = 80;   // text mode default; VESA sets via mouse_set_bounds
let mut mouse_screen_h = 25;

fn mouse_set_bounds(w, h) {
    mouse_screen_w = w;
    mouse_screen_h = h;
    mouse_x = w / 2;
    mouse_y = h / 2;
    return 0;
}

// Initialize PS/2 mouse via 8042 controller
fn mouse_init() {
    // Enable auxiliary device (mouse)
    // Wait for input buffer clear
    let mut timeout = 10000;
    while timeout > 0 {
        if port_in_u8(100) / 2 % 2 == 0 { timeout = 0; } // 0x64 bit1 clear
        timeout = timeout - 1;
    }
    port_out_u8(100, 168);  // 0x64, 0xA8 = enable aux

    // Enable IRQ12
    port_out_u8(100, 32);   // 0x64, 0x20 = read config
    timeout = 10000;
    while timeout > 0 {
        if port_in_u8(100) % 2 == 1 { timeout = 0; }
        timeout = timeout - 1;
    }
    let mut config = port_in_u8(96);  // 0x60
    config = config + 2;  // enable aux interrupt (bit 1)
    port_out_u8(100, 96);  // 0x64, 0x60 = write config
    timeout = 10000;
    while timeout > 0 {
        if port_in_u8(100) / 2 % 2 == 0 { timeout = 0; }
        timeout = timeout - 1;
    }
    port_out_u8(96, config);  // 0x60

    mouse_write(246);  // 0xF6 = set defaults
    mouse_write(244);  // 0xF4 = enable data reporting

    // Unmask IRQ12 on slave PIC
    let mut mask = port_in_u8(161);  // 0xA1
    port_out_u8(161, mask - (mask / 16 % 2) * 16);  // clear bit 4

    return 0;
}

fn mouse_write(cmd) {
    let mut timeout = 10000;
    while timeout > 0 {
        if port_in_u8(100) / 2 % 2 == 0 { timeout = 0; }
        timeout = timeout - 1;
    }
    port_out_u8(100, 212);  // 0x64, 0xD4 = next byte to mouse
    timeout = 10000;
    while timeout > 0 {
        if port_in_u8(100) / 2 % 2 == 0 { timeout = 0; }
        timeout = timeout - 1;
    }
    port_out_u8(96, cmd);  // 0x60
    // Read ACK
    timeout = 10000;
    while timeout > 0 {
        if port_in_u8(100) % 2 == 1 { timeout = 0; }
        timeout = timeout - 1;
    }
    port_in_u8(96);  // consume ACK (0xFA)
    return 0;
}

// Mouse ISR handler (called from IRQ12 = vector 44)
fn mouse_isr() {
    let status_reg = port_in_u8(100);  // 0x64
    if (status_reg / 32) % 2 == 0 { return 0; }  // bit 5 = aux data
    let data = port_in_u8(96);  // 0x60

    if mouse_cycle == 0 {
        mouse_bytes[0] = data;
        // Check sync bit (bit 3 must be 1)
        if (data / 8) % 2 == 1 {
            mouse_cycle = 1;
        }
    } else if mouse_cycle == 1 {
        mouse_bytes[1] = data;
        mouse_cycle = 2;
    } else {
        mouse_bytes[2] = data;
        mouse_cycle = 0;

        // Process complete packet
        let status = mouse_bytes[0];
        let mut dx = mouse_bytes[1];
        let mut dy = mouse_bytes[2];

        // Check overflow bits -- discard packet if overflow
        if (status / 64) % 2 == 1 { return 0; }  // X overflow
        if (status / 128) % 2 == 1 { return 0; }  // Y overflow

        // Apply sign extension
        if (status / 16) % 2 == 1 { dx = dx - 256; }  // X sign
        if (status / 32) % 2 == 1 { dy = dy - 256; }  // Y sign

        // Update position (clamp to screen bounds)
        mouse_x = mouse_x + dx;
        mouse_y = mouse_y - dy;  // Y is inverted

        if mouse_x < 0 { mouse_x = 0; }
        if mouse_x >= mouse_screen_w { mouse_x = mouse_screen_w - 1; }
        if mouse_y < 0 { mouse_y = 0; }
        if mouse_y >= mouse_screen_h { mouse_y = mouse_screen_h - 1; }

        // Store to memory
        mem_write_u64(MOUSE_X_ADDR, mouse_x);
        mem_write_u64(MOUSE_Y_ADDR, mouse_y);
        mem_write_u64(MOUSE_BTN_ADDR, status % 8);
        mem_write_u64(MOUSE_READY, 1);
    }

    // Send EOI to slave PIC then master PIC
    port_out_u8(160, 32);  // 0xA0, 0x20
    port_out_u8(32, 32);   // 0x20, 0x20
    return 0;
}

fn mouse_get_x() { return mouse_x; }
fn mouse_get_y() { return mouse_y; }
fn mouse_get_buttons() {
    return mem_read_u64(MOUSE_BTN_ADDR);
}

print("mouse.hl loaded");
print("PS/2 mouse via 8042, IRQ12 vector 44");
