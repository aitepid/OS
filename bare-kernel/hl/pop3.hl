// pop3.hl -- POP3 Email Retrieval Client (RFC 1939)
//
// Iteration 165: Retrieve email from a POP3 server over TCP.
//
// Protocol flow (plain POP3, port 110):
//   CONNECT → recv "+OK" greeting
//   USER <username>\r\n → recv "+OK"
//   PASS <password>\r\n → recv "+OK"
//   STAT                → recv "+OK N M"  (N messages, M total octets)
//   LIST                → recv "+OK" + message list lines + "."
//   RETR <n>            → recv "+OK" + message + "."
//   DELE <n>            → recv "+OK"
//   QUIT                → recv "+OK"
//
// Up to POP3_MAX (4) concurrent sessions.
// Response buffer: 0xDE0000 (14548992)  8 KB per session slot.
//
// Public API:
//   pop3_init()
//   pop3_connect(host, port)            → session_id  (-1 on fail)
//   pop3_auth(id, user, pass)           → 0 ok / -1 fail
//   pop3_stat(id)                       → [count, total_bytes] or [-1,-1]
//   pop3_list(id)                       → formatted message list string
//   pop3_retr(id, msg_num)             → message content string
//   pop3_dele(id, msg_num)             → 0 ok / -1 fail
//   pop3_quit(id)
//   pop3_tick()                         → poll for pending responses
//   pop3_status(id) / pop3_list_sessions()

let POP3_MAX     = 4;
let POP3_BUF     = 14548992;   // 0xDE0000
let POP3_BUF_SZ  = 8192;       // 8 KB per session

// Session states
let POP3_ST_FREE   = 0;
let POP3_ST_CONN   = 1;   // connected, waiting for greeting
let POP3_ST_AUTH   = 2;   // USER sent, waiting +OK
let POP3_ST_READY  = 3;   // authenticated, idle
let POP3_ST_BUSY   = 4;   // command in flight
let POP3_ST_ERR    = 5;

// Per-session arrays
let mut pop3_active  = [];
let mut pop3_tcb     = [];
let mut pop3_state   = [];
let mut pop3_host    = [];
let mut pop3_user    = [];
let mut pop3_count   = 0;   // active sessions

fn pop3_init() {
    pop3_active = [];
    pop3_tcb    = [];
    pop3_state  = [];
    pop3_host   = [];
    pop3_user   = [];
    pop3_count  = 0;
    let mut i = 0;
    while i < POP3_MAX {
        push(pop3_active, 0);
        push(pop3_tcb,    0 - 1);
        push(pop3_state,  POP3_ST_FREE);
        push(pop3_host,   "");
        push(pop3_user,   "");
        i = i + 1;
    }
    print("pop3: init — max " + to_string(POP3_MAX) + " sessions");
    return 0;
}

fn _pop3_alloc() {
    let mut i = 0;
    while i < POP3_MAX {
        if pop3_active[i] == 0 { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

// ============================================================
// Response reading
// ============================================================

// Read response from TCB RX buffer into session's POP3_BUF slot.
// Returns response string (up to POP3_BUF_SZ bytes).
fn _pop3_read_resp(id) {
    let tcb  = pop3_tcb[id];
    let addr = TCP_TABLE + tcb * TCB_SIZE;
    let rx_buf = mem_read_u64(addr + 64);
    if rx_buf == 0 { return ""; }
    let slot = POP3_BUF + id * POP3_BUF_SZ;
    let mut s = "";
    let mut j = 0;
    while j < POP3_BUF_SZ {
        let b = mem_read_u8(rx_buf + j);
        if b == 0 { j = POP3_BUF_SZ + 1; }
        else { s = s + str_from_code(b); j = j + 1; }
    }
    mem_zero(rx_buf, POP3_BUF_SZ);
    return s;
}

// Returns 1 if response starts with "+OK"
fn _pop3_is_ok(resp) {
    if len(resp) < 3 { return 0; }
    if str_sub(resp, 0, 3) == "+OK" { return 1; }
    return 0;
}

// ============================================================
// Lifecycle
// ============================================================

fn pop3_connect(host, port) {
    let id = _pop3_alloc();
    if id < 0 { print("pop3: no free slots"); return 0 - 1; }

    let ip = dns_resolve(host);
    if ip == 0 { print("pop3: dns_resolve failed for " + host); return 0 - 1; }

    let tcb = tcp_connect(ip, port);
    if tcb < 0 { print("pop3: tcp_connect failed to " + host); return 0 - 1; }

    set_at(pop3_active, id, 1);
    set_at(pop3_tcb,    id, tcb);
    set_at(pop3_state,  id, POP3_ST_CONN);
    set_at(pop3_host,   id, host);
    set_at(pop3_user,   id, "");
    pop3_count = pop3_count + 1;

    print("pop3[" + to_string(id) + "]: connected to " + host + ":" + to_string(port));
    return id;
}

fn pop3_auth(id, user, pass) {
    if id < 0 { return 0 - 1; }
    if id >= POP3_MAX { return 0 - 1; }
    if pop3_active[id] == 0 { return 0 - 1; }

    let tcb = pop3_tcb[id];
    tcp_send(tcb, "USER " + user + "\r\n");
    set_at(pop3_state, id, POP3_ST_AUTH);
    set_at(pop3_user,  id, user);

    // Give server a moment, then send PASS
    let deadline = get_ticks() + 100;
    while get_ticks() < deadline {}

    tcp_send(tcb, "PASS " + pass + "\r\n");
    set_at(pop3_state, id, POP3_ST_READY);
    print("pop3[" + to_string(id) + "]: auth sent for " + user);
    return 0;
}

fn pop3_quit(id) {
    if id < 0 { return 0; }
    if id >= POP3_MAX { return 0; }
    if pop3_active[id] == 0 { return 0; }
    tcp_send(pop3_tcb[id], "QUIT\r\n");
    tcp_close(pop3_tcb[id]);
    set_at(pop3_active, id, 0);
    pop3_count = pop3_count - 1;
    print("pop3[" + to_string(id) + "]: disconnected");
    return 0;
}

// ============================================================
// Commands
// ============================================================

fn pop3_stat(id) {
    if id < 0 { return [0 - 1, 0 - 1]; }
    if pop3_active[id] == 0 { return [0 - 1, 0 - 1]; }

    tcp_send(pop3_tcb[id], "STAT\r\n");
    set_at(pop3_state, id, POP3_ST_BUSY);

    let deadline = get_ticks() + 200;
    while get_ticks() < deadline {}

    let resp = _pop3_read_resp(id);
    set_at(pop3_state, id, POP3_ST_READY);

    if _pop3_is_ok(resp) == 0 { return [0 - 1, 0 - 1]; }
    // Parse: "+OK N M"
    let body = str_sub(resp, 4, len(resp));
    let sp = str_find(body, " ");
    if sp < 0 { return [0, 0]; }
    let count = parse_int(str_sub(body, 0, sp));
    let total = parse_int(str_sub(body, sp + 1, len(body)));
    return [count, total];
}

fn pop3_list(id) {
    if id < 0 { return "pop3: invalid id"; }
    if pop3_active[id] == 0 { return "pop3[" + to_string(id) + "] not connected"; }

    tcp_send(pop3_tcb[id], "LIST\r\n");
    set_at(pop3_state, id, POP3_ST_BUSY);

    let deadline = get_ticks() + 300;
    while get_ticks() < deadline {}

    let resp = _pop3_read_resp(id);
    set_at(pop3_state, id, POP3_ST_READY);

    if _pop3_is_ok(resp) == 0 { return "pop3[" + to_string(id) + "] LIST error: " + resp; }
    return resp;
}

fn pop3_retr(id, msg_num) {
    if id < 0 { return "pop3: invalid id"; }
    if pop3_active[id] == 0 { return "pop3: not connected"; }

    tcp_send(pop3_tcb[id], "RETR " + to_string(msg_num) + "\r\n");
    set_at(pop3_state, id, POP3_ST_BUSY);

    let deadline = get_ticks() + 500;
    while get_ticks() < deadline {}

    let resp = _pop3_read_resp(id);
    set_at(pop3_state, id, POP3_ST_READY);

    if _pop3_is_ok(resp) == 0 { return "pop3: RETR error: " + resp; }
    // Strip "+OK N octets\r\n" prefix and trailing ".\r\n"
    let nl = str_find(resp, "\n");
    if nl < 0 { return resp; }
    let body = str_sub(resp, nl + 1, len(resp));
    let dot_end = len(body) - 3;
    if dot_end > 0 { return str_sub(body, 0, dot_end); }
    return body;
}

fn pop3_dele(id, msg_num) {
    if id < 0 { return 0 - 1; }
    if pop3_active[id] == 0 { return 0 - 1; }
    tcp_send(pop3_tcb[id], "DELE " + to_string(msg_num) + "\r\n");
    print("pop3[" + to_string(id) + "]: DELE " + to_string(msg_num) + " sent");
    return 0;
}

// ============================================================
// Tick: check for error responses
// ============================================================

fn pop3_tick() {
    let mut i = 0;
    while i < POP3_MAX {
        if pop3_active[i] == 1 {
            if pop3_state[i] == POP3_ST_BUSY {
                let resp = _pop3_read_resp(i);
                if len(resp) > 0 {
                    if _pop3_is_ok(resp) == 0 {
                        klog(2, "pop3", "error on session " + to_string(i) + ": " + resp);
                        set_at(pop3_state, i, POP3_ST_ERR);
                    } else {
                        set_at(pop3_state, i, POP3_ST_READY);
                    }
                }
            }
        }
        i = i + 1;
    }
    return 0;
}

// ============================================================
// Status
// ============================================================

fn pop3_status(id) {
    if id < 0 { return "pop3: invalid"; }
    if id >= POP3_MAX { return "pop3: invalid"; }
    if pop3_active[id] == 0 { return "pop3[" + to_string(id) + "] free"; }
    let st_names = ["free", "connecting", "auth", "ready", "busy", "error"];
    let st = pop3_state[id];
    let mut st_s = "?";
    if st >= 0 { if st <= 5 { st_s = st_names[st]; } }
    return "pop3[" + to_string(id) + "] " + st_s
        + " host=" + pop3_host[id]
        + " user=" + pop3_user[id];
}

fn pop3_list_sessions() {
    let mut out = "POP3 sessions (" + to_string(pop3_count) + "/" + to_string(POP3_MAX) + "):\n";
    let mut i = 0;
    while i < POP3_MAX {
        if pop3_active[i] == 1 { out = out + "  " + pop3_status(i) + "\n"; }
        i = i + 1;
    }
    return out;
}

print("pop3.hl loaded");
print("POP3: RFC 1939 client, USER/PASS/STAT/LIST/RETR/DELE/QUIT, " + to_string(POP3_MAX) + " sessions");
