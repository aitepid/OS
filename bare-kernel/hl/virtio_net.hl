// virtio_net.hl -- VirtIO Network Device Driver
//
// Implements basic VirtIO-net for QEMU virtual networking.
// VirtIO PCI device: vendor=0x1AF4, device=0x1000 (net, transitional)
//
// VirtIO transport (legacy MMIO / PCI):
//   Queue 0: RX (receive)
//   Queue 1: TX (transmit)
//
// Each virtqueue has:
//   Descriptor table: array of {addr, len, flags, next}
//   Available ring: {flags, idx, ring[]}
//   Used ring: {flags, idx, ring[{id,len}]}

let VIRTIO_VENDOR = 6900;    // 0x1AF4
let VIRTIO_NET_DEV = 4096;   // 0x1000

// VirtIO PCI config space offsets (legacy)
let VIRTIO_DEVICE_FEATURES  = 0;
let VIRTIO_GUEST_FEATURES   = 4;
let VIRTIO_QUEUE_ADDR       = 8;
let VIRTIO_QUEUE_SIZE       = 12;
let VIRTIO_QUEUE_SELECT     = 14;
let VIRTIO_QUEUE_NOTIFY     = 16;
let VIRTIO_DEVICE_STATUS    = 18;
let VIRTIO_ISR_STATUS       = 19;

// Device status bits
let VIRTIO_STATUS_ACK       = 1;
let VIRTIO_STATUS_DRIVER    = 2;
let VIRTIO_STATUS_DRIVER_OK = 4;
let VIRTIO_STATUS_FEATURES_OK = 8;

// Feature bits
let VIRTIO_NET_F_MAC        = 32;   // bit 5
let VIRTIO_NET_F_STATUS     = 65536; // bit 16

// Descriptor flags
let VRING_DESC_F_NEXT       = 1;
let VRING_DESC_F_WRITE      = 2;

let mut virtio_bar = 0;     // BAR0 address (I/O port base)
let mut rx_queue_addr = 0;
let mut tx_queue_addr = 0;
let mut rx_queue_size = 0;
let mut tx_queue_size = 0;
let mut tx_desc_idx = 0;      // next free TX descriptor
let mut rx_last_used = 0;     // last processed used ring index

// VirtIO net header (10 bytes for legacy, 12 for modern)
let VIRTIO_NET_HDR_SIZE = 10;

// Buffer pool for RX (at 0x920000, 64 buffers * 2048 bytes)
let RX_BUF_BASE = 9568256;    // 0x920000
let RX_BUF_SIZE = 2048;
let RX_BUF_COUNT = 64;

// Buffer for TX header (at 0x940000)
let TX_HDR_BUF = 9699328;     // 0x940000

// Detect VirtIO-net on PCI bus
fn virtio_net_detect() {
    let mut devices = pci_scan();
    let mut i = 0;
    while i < len(devices) {
        let mut vendor = devices[i][3];
        let mut devid = devices[i][4];
        if vendor == VIRTIO_VENDOR && devid == VIRTIO_NET_DEV {
            return [devices[i][0], devices[i][1], devices[i][2]];
        }
        i = i + 1;
    }
    return [];
}

// Initialize VirtIO network device
fn virtio_net_init(pci_bus, pci_dev, pci_func) {
    // Read BAR0 for I/O base (mask low 2 bits)
    let mut bar0 = pci_bar(pci_bus, pci_dev, pci_func, 0);
    virtio_bar = (bar0 / 4) * 4;

    // Reset device
    port_out_u8(virtio_bar + VIRTIO_DEVICE_STATUS, 0);

    // Acknowledge
    port_out_u8(virtio_bar + VIRTIO_DEVICE_STATUS, VIRTIO_STATUS_ACK);

    // Driver loaded
    port_out_u8(virtio_bar + VIRTIO_DEVICE_STATUS, VIRTIO_STATUS_ACK + VIRTIO_STATUS_DRIVER);

    // Negotiate features: accept MAC feature
    let mut features = port_in_u32(virtio_bar + VIRTIO_DEVICE_FEATURES);
    port_out_u32(virtio_bar + VIRTIO_GUEST_FEATURES, features % 64); // keep low bits

    // Setup RX queue (queue 0)
    port_out_u16(virtio_bar + VIRTIO_QUEUE_SELECT, 0);
    rx_queue_size = port_in_u16(virtio_bar + VIRTIO_QUEUE_SIZE);
    rx_queue_addr = page_alloc_contiguous(4);  // 16KB for descriptors+avail+used
    mem_zero(rx_queue_addr, 16384);
    port_out_u32(virtio_bar + VIRTIO_QUEUE_ADDR, rx_queue_addr / 4096);

    // Pre-fill RX descriptors
    let mut i = 0;
    while i < RX_BUF_COUNT && i < rx_queue_size {
        let mut desc_addr = rx_queue_addr + i * 16;  // each descriptor = 16 bytes
        let mut buf = RX_BUF_BASE + i * RX_BUF_SIZE;
        mem_write_u64(desc_addr, buf);               // addr
        mem_write_u32(desc_addr + 8, RX_BUF_SIZE);  // len
        mem_write_u16(desc_addr + 12, VRING_DESC_F_WRITE); // flags: device writes
        mem_write_u16(desc_addr + 14, 0);            // next (not chained)

        // Add to available ring
        let mut avail_base = rx_queue_addr + rx_queue_size * 16;
        let mut avail_idx = mem_read_u16(avail_base + 2);
        mem_write_u16(avail_base + 4 + (avail_idx % rx_queue_size) * 2, i);
        mem_write_u16(avail_base + 2, avail_idx + 1);
        i = i + 1;
    }

    // Setup TX queue (queue 1)
    port_out_u16(virtio_bar + VIRTIO_QUEUE_SELECT, 1);
    tx_queue_size = port_in_u16(virtio_bar + VIRTIO_QUEUE_SIZE);
    tx_queue_addr = page_alloc_contiguous(4);
    mem_zero(tx_queue_addr, 16384);
    port_out_u32(virtio_bar + VIRTIO_QUEUE_ADDR, tx_queue_addr / 4096);
    tx_desc_idx = 0;

    // Mark driver OK
    port_out_u8(virtio_bar + VIRTIO_DEVICE_STATUS, VIRTIO_STATUS_ACK + VIRTIO_STATUS_DRIVER + VIRTIO_STATUS_DRIVER_OK);

    // Read MAC address
    let mut mac = virtio_net_mac();
    let mut mi = 0;
    while mi < 6 { my_mac[mi] = mac[mi]; mi = mi + 1; }

    print("VirtIO-net initialized: MAC=" + to_string(mac[0]) + ":" + to_string(mac[1]) + ":" + to_string(mac[2]) + ":" + to_string(mac[3]) + ":" + to_string(mac[4]) + ":" + to_string(mac[5]));
    return 0;
}

// Send packet (Ethernet frame bytes in memory at data_addr, length data_len)
fn virtio_net_send(data_addr, data_len) {
    // Descriptor 0: virtio_net_header (10 bytes, all zeros = no offloading)
    mem_zero(TX_HDR_BUF, VIRTIO_NET_HDR_SIZE);

    let mut desc0 = tx_queue_addr + tx_desc_idx * 16;
    mem_write_u64(desc0, TX_HDR_BUF);
    mem_write_u32(desc0 + 8, VIRTIO_NET_HDR_SIZE);
    mem_write_u16(desc0 + 12, VRING_DESC_F_NEXT);  // chained
    mem_write_u16(desc0 + 14, tx_desc_idx + 1);     // next descriptor

    // Descriptor 1: actual packet data
    let mut desc1 = tx_queue_addr + (tx_desc_idx + 1) * 16;
    mem_write_u64(desc1, data_addr);
    mem_write_u32(desc1 + 8, data_len);
    mem_write_u16(desc1 + 12, 0);  // no more chaining
    mem_write_u16(desc1 + 14, 0);

    // Add to TX available ring
    let mut avail_base = tx_queue_addr + tx_queue_size * 16;
    let mut avail_idx = mem_read_u16(avail_base + 2);
    mem_write_u16(avail_base + 4 + (avail_idx % tx_queue_size) * 2, tx_desc_idx);
    mem_write_u16(avail_base + 2, avail_idx + 1);

    // Advance descriptor index (2 per send: header + data)
    tx_desc_idx = (tx_desc_idx + 2) % tx_queue_size;

    // Notify device: TX queue = 1
    port_out_u16(virtio_bar + VIRTIO_QUEUE_NOTIFY, 1);
    return data_len;
}

// Send packet from array of bytes (copies to memory buffer first)
fn virtio_net_send_pkt(pkt) {
    let mut buf = page_alloc();
    let mut i = 0;
    while i < len(pkt) {
        mem_write_u8(buf + i, pkt[i]);
        i = i + 1;
    }
    let mut result = virtio_net_send(buf, len(pkt));
    page_free(buf);
    return result;
}

// Receive a packet (poll used ring)
// Returns array of bytes, or empty array if nothing available
fn virtio_net_recv_pkt() {
    let mut used_base = rx_queue_addr + rx_queue_size * 16;
    // used ring starts after avail ring: avail = qsize*16 + 4 + qsize*2 + 2
    let mut avail_size = 4 + rx_queue_size * 2 + 2;
    let mut used_ring = rx_queue_addr + rx_queue_size * 16 + avail_size;
    // Align to next page
    let mut used_aligned = ((used_ring + 4095) / 4096) * 4096;

    let mut used_idx = mem_read_u16(used_aligned + 2);
    if rx_last_used == used_idx { return []; }  // nothing new

    // Read used element
    let mut used_elem = used_aligned + 4 + (rx_last_used % rx_queue_size) * 8;
    let mut desc_id = mem_read_u32(used_elem);
    let mut total_len = mem_read_u32(used_elem + 4);
    rx_last_used = rx_last_used + 1;

    if desc_id >= RX_BUF_COUNT { return []; }
    if total_len <= VIRTIO_NET_HDR_SIZE { return []; }
    // Read data from buffer (skip virtio_net_header)
    let mut buf = RX_BUF_BASE + desc_id * RX_BUF_SIZE;
    let mut pkt_len = total_len - VIRTIO_NET_HDR_SIZE;
    if pkt_len > RX_BUF_SIZE { pkt_len = RX_BUF_SIZE; }

    let mut pkt = [];
    let mut i = 0;
    while i < pkt_len {
        push(pkt, mem_read_u8(buf + VIRTIO_NET_HDR_SIZE + i));
        i = i + 1;
    }

    // Re-add descriptor to available ring
    let mut avail_base2 = rx_queue_addr + rx_queue_size * 16;
    let mut avail_idx = mem_read_u16(avail_base2 + 2);
    mem_write_u16(avail_base2 + 4 + (avail_idx % rx_queue_size) * 2, desc_id);
    mem_write_u16(avail_base2 + 2, avail_idx + 1);
    port_out_u16(virtio_bar + VIRTIO_QUEUE_NOTIFY, 0);  // notify RX queue

    return pkt;
}

fn virtio_net_mac() {
    let mut mac = [];
    let mut i = 0;
    while i < 6 {
        push(mac, port_in_u8(virtio_bar + 20 + i));
        i = i + 1;
    }
    return mac;
}

// Self-test
print("virtio_net.hl loaded");
print("VirtIO vendor: 0x1AF4, device: 0x1000");
print("Queues: RX=0, TX=1 (descriptor chain)");
