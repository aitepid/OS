// regalloc.hl -- Graph-Coloring Register Allocation (Greedy)
// Interference graph (RA_MAX_VAR x RA_MAX_VAR) + greedy K-coloring.
// ra_run() assigns physical registers; returns spill count.
// Runtime buffer: 0x1710000

let RA_MAX_VAR = 16;
let RA_K       = 4;

let ra_ig       = array(256, 0);
let ra_color    = array(16, -1);
let ra_tmp_used = array(8, 0);
let mut ra_n        = 0;
let mut ra_spill    = 0;

fn ra_init() {
    ra_n     = 0;
    ra_spill = 0;
    let mut i = 0;
    while i < 256 { set_at(ra_ig,    i, 0);  i += 1; }
    i = 0;
    while i < 16  { set_at(ra_color, i, -1); i += 1; }
    i = 0;
    while i < 8   { set_at(ra_tmp_used, i, 0); i += 1; }
    return 0;
}

fn ra_add_interfere(u, v) {
    set_at(ra_ig, u * RA_MAX_VAR + v, 1);
    set_at(ra_ig, v * RA_MAX_VAR + u, 1);
    return 0;
}

fn _ra_choose_color(v) {
    let mut i = 0;
    let mut c = -1;
    let mut done = 0;
    while i < RA_K { set_at(ra_tmp_used, i, 0); i += 1; }
    i = 0;
    while i < ra_n {
        if ra_ig[v * RA_MAX_VAR + i] == 1 {
            if ra_color[i] >= 0 {
                set_at(ra_tmp_used, ra_color[i], 1);
            }
        }
        i += 1;
    }
    i = 0;
    while i < RA_K {
        if done == 0 {
            if ra_tmp_used[i] == 0 { c = i; done = 1; }
        }
        i += 1;
    }
    return c;
}

fn ra_run() {
    let mut i = 0;
    let mut c = 0;
    ra_spill = 0;
    while i < ra_n {
        c = _ra_choose_color(i);
        if c >= 0 {
            set_at(ra_color, i, c);
        } else {
            set_at(ra_color, i, -1);
            ra_spill += 1;
        }
        i += 1;
    }
    return ra_spill;
}

fn ra_test() {
    ra_init();
    ra_n = 4;
    ra_add_interfere(0, 1);
    ra_add_interfere(1, 2);
    ra_add_interfere(2, 3);
    ra_add_interfere(0, 2);
    let mut sp = ra_run();
    print("ra_test: colors=[" + to_string(ra_color[0]) + "," + to_string(ra_color[1]) + "," + to_string(ra_color[2]) + "," + to_string(ra_color[3]) + "] spills=" + to_string(sp));
    if sp == 0 {
        print("ra_test: PASS");
        return 1;
    }
    print("ra_test: FAIL");
    return 0;
}

print("regalloc.hl loaded");
