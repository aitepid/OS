// firmware.hl -- Firmware Loading Framework
//
// Loads binary firmware blobs from the ramfs/VFS into device memory.
// Many hardware devices (Wi-Fi, GPU, Bluetooth) need firmware uploaded
// by the OS driver before they can operate.
//
// Firmware storage:
//   /lib/firmware/<name>.bin  (in ramfs or VFS)
//
// Process:
//   1. Driver calls firmware_request("iwlwifi-xxx.ucode")
//   2. Framework opens /lib/firmware/<name> via VFS
//   3. Reads entire file into a kernel buffer
//   4. Returns buffer address and size to driver
//   5. Driver uploads to device via MMIO/DMA
//
// Known firmware names (for documentation):
//   Intel WiFi:    iwlwifi-*.ucode
//   Realtek WiFi:  rtl8xxxu/rtl*.bin
//   AMD GPU:       amdgpu/*.bin
//   Intel GPU:     i915/*.bin
//   Bluetooth:     intel/ibt-*.sfi, rtl_bt/*.bin

let FW_PATH_PREFIX = "/lib/firmware/";
let FW_MAX_SIZE = 1048576;      // 1 MB max firmware size
let FW_BUF_ADDR = 9961472;     // 0x980000 -- firmware staging buffer (avoid AHCI region)

let mut fw_loaded_count = 0;
let mut fw_cache_names = [];
let mut fw_cache_addrs = [];
let mut fw_cache_sizes = [];

fn firmware_request(name) {
    let path = FW_PATH_PREFIX + name;

    // Check cache first
    let mut ci = 0;
    while ci < len(fw_cache_names) {
        if fw_cache_names[ci] == name {
            return [fw_cache_addrs[ci], fw_cache_sizes[ci]];
        }
        ci = ci + 1;
    }

    // Open file via VFS
    let fd = vfs_open(path, 0);  // O_RDONLY = 0
    if fd < 0 {
        print("firmware: not found: " + path);
        return [0, 0];  // [addr, size]
    }

    // Get file size via stat
    let stat = vfs_stat(path);
    let size = stat[0];
    if size == 0 {
        vfs_close(fd);
        return [0, 0];
    }
    if size > FW_MAX_SIZE {
        print("firmware: too large: " + to_string(size) + " bytes (max " + to_string(FW_MAX_SIZE) + ")");
        vfs_close(fd);
        return [0, 0];
    }

    // Allocate buffer (page-aligned)
    let pages = (size + 4095) / 4096;
    let buf = page_alloc_contiguous(pages);
    if buf == 0 {
        print("firmware: allocation failed for " + to_string(pages) + " pages");
        vfs_close(fd);
        return [0, 0];
    }

    // Read into buffer
    let bytes_read = vfs_read(fd, buf, size);
    vfs_close(fd);

    // Cache the result
    push(fw_cache_names, name);
    push(fw_cache_addrs, buf);
    push(fw_cache_sizes, bytes_read);

    fw_loaded_count = fw_loaded_count + 1;
    print("firmware: loaded " + name + " (" + to_string(bytes_read) + " bytes)");
    return [buf, bytes_read];
}

fn firmware_release(name) {
    // Find in cache and free
    let mut i = 0;
    while i < len(fw_cache_names) {
        if fw_cache_names[i] == name {
            let addr = fw_cache_addrs[i];
            let size = fw_cache_sizes[i];
            // Zero for security
            mem_zero(addr, size);
            // Free pages
            let pages = (size + 4095) / 4096;
            let mut p = 0;
            while p < pages {
                page_free(addr + p * 4096);
                p = p + 1;
            }
            // Remove from cache (swap with last)
            let last = len(fw_cache_names) - 1;
            fw_cache_names[i] = fw_cache_names[last];
            fw_cache_addrs[i] = fw_cache_addrs[last];
            fw_cache_sizes[i] = fw_cache_sizes[last];
            // pop is not available, just decrement usage
            fw_loaded_count = fw_loaded_count - 1;
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

// Pre-populate firmware directory in ramfs
fn firmware_init() {
    vfs_mkdir("/lib");
    vfs_mkdir("/lib/firmware");
    print("Firmware loader ready: " + FW_PATH_PREFIX);
    return 0;
}

print("firmware.hl loaded");
print("Firmware loader: /lib/firmware/ via VFS, " + to_string(FW_MAX_SIZE / 1024) + " KB max");
