// fenwick_tree.hl -- Fenwick Tree (Binary Indexed Tree)
//
// Implements Fenwick Tree / BIT (Peter Fenwick 1994, Software: Practice and Experience):
//   - Point update + prefix sum query: O(log n) time, O(n) space
//   - Range sum query [l..r]: O(log n) via two prefix queries
//   - Range update + point query (difference BIT): O(log n)
//   - k-th element search via binary lifting: O(log n)
//   - 2D BIT: rectangle prefix sum + point update: O(log^2 n)
// Applications: frequency tables, order statistics, inversion counting,
//               prefix sums, rank/select queries, 2D range sums.
//
// Buffer: 0x1460000

let FW_BUF      = 0x1460000;

let FW_MAX_SIZE = 256;   // max n (1-indexed positions 1..n)
let FW_2D_N     = 16;    // 2D BIT grid dimension (16×16)

// Sum BIT: fw_tree[i] stores sum of range [i - lowbit(i) + 1 .. i]
let fw_tree = [];        // 1-indexed, size FW_MAX_SIZE+1
// Difference BIT for range update / point query
let fw_diff = [];        // 1-indexed, size FW_MAX_SIZE+1
// 2D BIT: flat (FW_2D_N+1) × (FW_2D_N+1) array
let fw_2d   = [];

let fw_n    = 0;         // current active size

let fw_initialized = 0;

fn fenwick_init(n) {
    if n > FW_MAX_SIZE { n = FW_MAX_SIZE; }
    fw_n = n;
    let mut i = 0;
    while i <= FW_MAX_SIZE {
        set_at(fw_tree, i, 0);
        set_at(fw_diff, i, 0);
        i = i + 1;
    }
    let sz2d = (FW_2D_N + 1) * (FW_2D_N + 1);
    i = 0;
    while i < sz2d { set_at(fw_2d, i, 0); i = i + 1; }
    fw_initialized = 1;
    return 0;
}

// Lowest set bit of positive integer i (largest power of 2 dividing i)
fn _fw_lowbit(i) {
    let bit = 1;
    while bit * 2 <= i {
        let rem = i - ((i / (bit * 2)) * (bit * 2));
        if rem == 0 { bit = bit * 2; } else { return bit; }
    }
    return bit;
}

// --- Standard BIT: point update ---
// Add delta to position i; updates all ancestors
fn fenwick_update(i, delta) {
    while i <= fw_n {
        set_at(fw_tree, i, fw_tree[i] + delta);
        i = i + _fw_lowbit(i);
    }
    return 0;
}

// Prefix sum [1..i]
fn fenwick_query(i) {
    let mut s = 0;
    while i > 0 { s = s + fw_tree[i]; i = i - _fw_lowbit(i); }
    return s;
}

// Range sum [l..r]
fn fenwick_range_sum(l, r) {
    if l <= 1 { return fenwick_query(r); }
    return fenwick_query(r) - fenwick_query(l - 1);
}

// Build from 0-indexed data array of length n
fn fenwick_build(data, n) {
    fenwick_init(n);
    let mut i = 0;
    while i < n { fenwick_update(i + 1, data[i]); i = i + 1; }
    return 0;
}

// k-th prefix: find smallest pos s.t. prefix_sum(pos) >= k (binary lifting)
fn fenwick_find_kth(k) {
    let mut pos = 0;
    let bit = 256;
    while bit > 0 {
        let nxt = pos + bit;
        if nxt <= fw_n {
            if fw_tree[nxt] < k { k = k - fw_tree[nxt]; pos = nxt; }
        }
        bit = bit / 2;
    }
    return pos + 1;
}

// --- Difference BIT: range update [l..r] += delta ---
fn _fw_diff_add(i, delta) {
    while i <= fw_n {
        set_at(fw_diff, i, fw_diff[i] + delta);
        i = i + _fw_lowbit(i);
    }
    return 0;
}

fn fenwick_range_update(l, r, delta) {
    _fw_diff_add(l, delta);
    if r + 1 <= fw_n { _fw_diff_add(r + 1, -delta); }
    return 0;
}

// Point query for range-update BIT (prefix sum of difference array)
fn fenwick_point_query(i) {
    let mut s = 0;
    while i > 0 { s = s + fw_diff[i]; i = i - _fw_lowbit(i); }
    return s;
}

// --- 2D BIT: point update at (r, c) ---
fn fenwick_2d_update(r, c, delta) {
    let ri = r;
    while ri <= FW_2D_N {
        let mut ci = c;
        while ci <= FW_2D_N {
            let mut idx = ri * (FW_2D_N + 1) + ci;
            set_at(fw_2d, idx, fw_2d[idx] + delta);
            ci = ci + _fw_lowbit(ci);
        }
        ri = ri + _fw_lowbit(ri);
    }
    return 0;
}

// 2D prefix sum: sum over rectangle [1..r] × [1..c]
fn fenwick_2d_query(r, c) {
    let mut s = 0;
    let ri = r;
    while ri > 0 {
        let mut ci = c;
        while ci > 0 {
            s = s + fw_2d[ri * (FW_2D_N + 1) + ci];
            ci = ci - _fw_lowbit(ci);
        }
        ri = ri - _fw_lowbit(ri);
    }
    return s;
}

fn fenwick_status() {
    return "fenwick: n=" + to_string(fw_n)
        + " total_sum=" + to_string(fenwick_query(fw_n));
}

fn fenwick_tree_test() {
    // Test 1: build + prefix sum + range sum
    let data = [1, 2, 3, 4, 5, 6, 7, 8];
    fenwick_build(data, 8);
    let s_all = fenwick_query(8);           // 36
    let s36   = fenwick_range_sum(3, 6);   // 3+4+5+6=18
    // Test 2: point update
    fenwick_update(4, 10);
    let s_upd = fenwick_query(8);           // 46
    // Test 3: k-th element (2nd 1 in [1,0,1,0,1,0,1,0])
    fenwick_init(8);
    let freq = [1, 0, 1, 0, 1, 0, 1, 0];
    let mut i = 0;
    while i < 8 { fenwick_update(i + 1, freq[i]); i = i + 1; }
    let kth = fenwick_find_kth(2);          // 3
    // Test 4: range update + point query
    fenwick_init(8);
    fenwick_range_update(2, 5, 3);
    let pq3 = fenwick_point_query(3);       // 3
    let pq7 = fenwick_point_query(7);       // 0
    // Test 5: 2D BIT
    fenwick_2d_update(2, 3, 10);
    fenwick_2d_update(4, 4, 5);
    let q2d = fenwick_2d_query(4, 4);       // 15
    print("fenwick test: sum=" + to_string(s_all)
        + " range(3,6)=" + to_string(s36)
        + " after_update=" + to_string(s_upd)
        + " kth(2)=" + to_string(kth)
        + " range_upd_pq=" + to_string(pq3) + "/" + to_string(pq7)
        + " 2d=" + to_string(q2d));
    return "fenwick: sum=" + to_string(s_all)
        + " range(3,6)=" + to_string(s36)
        + " kth(2)=" + to_string(kth)
        + " range_update_pq=" + to_string(pq3)
        + " 2d_query=" + to_string(q2d)
        + " [Fenwick 1994 ok]";
}

print("fenwick_tree.hl loaded -- Fenwick Tree (BIT: prefix sum, range update, k-th element, 2D BIT)");
