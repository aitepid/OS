// widget_core.hl -- Widget base: identity, geometry, focus, hit-test
//
// Sprint G4 of HicOS GUI injection (per GUI_DESIGN.md §3.5).
//
// All widgets share a flat array store keyed by a numeric ID. This avoids
// dynamic allocation per widget and matches the existing wm.hl pattern.
//
// Lifecycle:
//   id = widget_new(kind, parent, x, y, w, h)
//   widget_set_*(id, ...) before each frame as state changes
//   widget_paint(id) draws the widget into its parent surface
//   widget_dispatch_pointer(id, ev) handles pointer events; returns 1 if
//     consumed.
//
// State bits packed into widget_flags[id]:
//   bit 0 = visible
//   bit 1 = enabled
//   bit 2 = hovered
//   bit 3 = pressed
//   bit 4 = focused
//   bit 5 = checked   (toggles)
//   bit 6 = dirty     (re-paint needed)

let WIDGET_MAX = 512;

let WIDGET_KIND_NONE       = 0;
let WIDGET_KIND_BUTTON     = 1;
let WIDGET_KIND_TEXTFIELD  = 2;
let WIDGET_KIND_TOGGLE     = 3;
let WIDGET_KIND_CHECKBOX   = 4;
let WIDGET_KIND_RADIO      = 5;
let WIDGET_KIND_SLIDER     = 6;
let WIDGET_KIND_SPINBOX    = 7;
let WIDGET_KIND_COMBOBOX   = 8;
let WIDGET_KIND_SEGMENTED  = 9;
let WIDGET_KIND_LABEL      = 10;
let WIDGET_KIND_LIST       = 11;
let WIDGET_KIND_TREE       = 12;
let WIDGET_KIND_TABLE      = 13;
let WIDGET_KIND_TABS       = 14;
let WIDGET_KIND_GROUPBOX   = 15;
let WIDGET_KIND_SCROLLVIEW = 16;
let WIDGET_KIND_SPLITVIEW  = 17;
let WIDGET_KIND_SIDEBAR    = 18;
let WIDGET_KIND_TOOLBAR    = 19;
let WIDGET_KIND_TABBAR     = 20;
let WIDGET_KIND_MENU       = 21;
let WIDGET_KIND_BREADCRUMB = 22;
let WIDGET_KIND_PROGRESS   = 23;
let WIDGET_KIND_SPINNER    = 24;
let WIDGET_KIND_TOOLTIP    = 25;
let WIDGET_KIND_TOAST      = 26;
let WIDGET_KIND_DIALOG     = 27;
let WIDGET_KIND_SEARCH     = 28;

let WIDGET_FLAG_VISIBLE = 1;
let WIDGET_FLAG_ENABLED = 2;
let WIDGET_FLAG_HOVER   = 4;
let WIDGET_FLAG_PRESSED = 8;
let WIDGET_FLAG_FOCUSED = 16;
let WIDGET_FLAG_CHECKED = 32;
let WIDGET_FLAG_DIRTY   = 64;

let mut widget_initialized = 0;
let mut widget_kind   = [0];
let mut widget_parent = [0];
let mut widget_x      = [0];
let mut widget_y      = [0];
let mut widget_w      = [0];
let mut widget_h      = [0];
let mut widget_flags  = [0];
let mut widget_label  = [0];      // for label/button/etc: address of cstring
let mut widget_value  = [0];      // numeric value (slider, spinbox, progress)
let mut widget_min    = [0];
let mut widget_max    = [0];
let mut widget_extra  = [0];      // kind-specific (tab index, selected row, etc)
let mut widget_used   = [0];
let mut widget_focus_id = 0 - 1;

fn widget_core_init() {
    if widget_initialized == 1 { return 0; }
    widget_kind   = array_new(WIDGET_MAX, 0);
    widget_parent = array_new(WIDGET_MAX, 0 - 1);
    widget_x      = array_new(WIDGET_MAX, 0);
    widget_y      = array_new(WIDGET_MAX, 0);
    widget_w      = array_new(WIDGET_MAX, 0);
    widget_h      = array_new(WIDGET_MAX, 0);
    widget_flags  = array_new(WIDGET_MAX, 0);
    widget_label  = array_new(WIDGET_MAX, 0);
    widget_value  = array_new(WIDGET_MAX, 0);
    widget_min    = array_new(WIDGET_MAX, 0);
    widget_max    = array_new(WIDGET_MAX, 100);
    widget_extra  = array_new(WIDGET_MAX, 0);
    widget_used   = array_new(WIDGET_MAX, 0);
    widget_initialized = 1;
    print("widget_core: " + to_string(WIDGET_MAX) + " slots, 28 kinds");
    return 0;
}

fn widget_new(kind, parent, x, y, w, h) {
    if widget_initialized == 0 { widget_core_init(); }
    let mut i = 1;   // reserve id 0 = sentinel "no widget"
    while i < WIDGET_MAX {
        if widget_used[i] == 0 {
            widget_used[i]   = 1;
            widget_kind[i]   = kind;
            widget_parent[i] = parent;
            widget_x[i]      = x;
            widget_y[i]      = y;
            widget_w[i]      = w;
            widget_h[i]      = h;
            widget_flags[i]  = WIDGET_FLAG_VISIBLE + WIDGET_FLAG_ENABLED + WIDGET_FLAG_DIRTY;
            widget_label[i]  = 0;
            widget_value[i]  = 0;
            widget_min[i]    = 0;
            widget_max[i]    = 100;
            widget_extra[i]  = 0;
            return i;
        }
        i = i + 1;
    }
    return 0;
}

fn widget_free(id) {
    if id <= 0 { return 0; } if id >= WIDGET_MAX { return 0; }
    widget_used[id] = 0;
    widget_flags[id] = 0;
    if widget_focus_id == id { widget_focus_id = 0 - 1; }
    return 0;
}

fn widget_set_label(id, addr) { widget_label[id] = addr; widget_set_dirty(id); return 0; }
fn widget_set_value(id, v)    { widget_value[id] = v;    widget_set_dirty(id); return 0; }
fn widget_set_range(id, lo, hi){widget_min[id]=lo; widget_max[id]=hi; widget_set_dirty(id); return 0;}
fn widget_set_pos(id, x, y)   { widget_x[id] = x; widget_y[id] = y; widget_set_dirty(id); return 0; }
fn widget_set_size(id, w, h)  { widget_w[id] = w; widget_h[id] = h; widget_set_dirty(id); return 0; }
fn widget_set_extra(id, v)    { widget_extra[id] = v; widget_set_dirty(id); return 0; }

fn widget_get_flag(id, flag) { return widget_flags[id] / flag % 2; }
fn widget_set_flag(id, flag, on) {
    let mut cur = widget_get_flag(id, flag);
    if on == 1 {
        if cur == 0 { widget_flags[id] = widget_flags[id] + flag; }
    } else {
        if cur == 1 { widget_flags[id] = widget_flags[id] - flag; }
    }
    return 0;
}

fn widget_set_dirty(id)    { widget_set_flag(id, WIDGET_FLAG_DIRTY,   1); return 0; }
fn widget_set_visible(id, v){widget_set_flag(id, WIDGET_FLAG_VISIBLE, v); return 0; }
fn widget_set_enabled(id, v){widget_set_flag(id, WIDGET_FLAG_ENABLED, v); return 0; }
fn widget_set_checked(id, v){widget_set_flag(id, WIDGET_FLAG_CHECKED, v); widget_set_dirty(id); return 0; }

fn widget_hit(id, x, y) {
    if widget_get_flag(id, WIDGET_FLAG_VISIBLE) == 0 { return 0; }
    if widget_get_flag(id, WIDGET_FLAG_ENABLED) == 0 { return 0; }
    if x < widget_x[id] { return 0; }
    if y < widget_y[id] { return 0; }
    if x >= widget_x[id] + widget_w[id] { return 0; }
    if y >= widget_y[id] + widget_h[id] { return 0; }
    return 1;
}

fn widget_focus(id) {
    if widget_focus_id != 0 - 1 {
        widget_set_flag(widget_focus_id, WIDGET_FLAG_FOCUSED, 0);
        widget_set_dirty(widget_focus_id);
    }
    widget_focus_id = id;
    if id >= 0 {
        widget_set_flag(id, WIDGET_FLAG_FOCUSED, 1);
        widget_set_dirty(id);
    }
    return 0;
}

fn widget_focused_get() { return widget_focus_id; }

// Convenience: draw a Fluent base rectangle for any widget.
// Uses ui_theme tokens; corner radius 4 for controls, 8 for windows.
fn widget_base_rect(id, radius) {
    let mut bg = ui_theme_bg_elevated();
    if widget_get_flag(id, WIDGET_FLAG_HOVER)   == 1 { bg = ui_theme_bg_overlay(); }
    if widget_get_flag(id, WIDGET_FLAG_PRESSED) == 1 { bg = ui_theme_accent_get(); }
    if widget_get_flag(id, WIDGET_FLAG_ENABLED) == 0 { bg = ui_theme_bg_surface(); }
    gfx_rect_round(widget_x[id], widget_y[id], widget_w[id], widget_h[id], radius, bg);
    if widget_get_flag(id, WIDGET_FLAG_FOCUSED) == 1 {
        // Fluent focus ring: 2 px outset accent at 80% alpha.
        let mut ring = gfx_pack(204,
            gfx_color_r(ui_theme_accent_get()),
            gfx_color_g(ui_theme_accent_get()),
            gfx_color_b(ui_theme_accent_get()));
        let mut x = widget_x[id] - 1;
        let mut y = widget_y[id] - 1;
        let mut w = widget_w[id] + 2;
        let mut h = widget_h[id] + 2;
        // Stroke rectangle as 4 thin AA lines.
        gfx_line_aa(x,         y,         x + w - 1, y,         ring);
        gfx_line_aa(x,         y + h - 1, x + w - 1, y + h - 1, ring);
        gfx_line_aa(x,         y,         x,         y + h - 1, ring);
        gfx_line_aa(x + w - 1, y,         x + w - 1, y + h - 1, ring);
    }
    return 0;
}

print("widget_core.hl loaded");
