// ui_theme.hl -- HicOS UI theme baseline

let UI_COLOR_DESKTOP = 4280171323;
let UI_COLOR_PANEL = 4281542970;
let UI_COLOR_SURFACE = 4293123807;
let UI_COLOR_BORDER = 4282861385;
let UI_COLOR_TITLEBAR = 4282668390;
let UI_COLOR_TITLEBAR_ACTIVE = 4282092283;
let UI_COLOR_ACCENT = 4282092283;
let UI_COLOR_SUCCESS = 4280462624;
let UI_COLOR_WARNING = 4289821184;
let UI_COLOR_ERROR = 4293872896;
let UI_COLOR_TEXT = 4293065200;
let UI_COLOR_TEXT_MUTED = 4287931291;
let UI_COLOR_SHADOW = 4279374354;

let UI_TITLE_HEIGHT = 24;
let UI_TOPBAR_HEIGHT = 28;
let UI_DOCK_HEIGHT = 36;
let UI_SHADOW_OFFSET = 3;
let UI_PADDING_SM = 4;
let UI_PADDING_MD = 8;
let UI_PADDING_LG = 12;

fn ui_theme_init() {
    return 0;
}

fn ui_theme_desktop_color() { return UI_COLOR_DESKTOP; }
fn ui_theme_panel_color() { return UI_COLOR_PANEL; }
fn ui_theme_surface_color() { return UI_COLOR_SURFACE; }
fn ui_theme_border_color() { return UI_COLOR_BORDER; }
fn ui_theme_titlebar_color() { return UI_COLOR_TITLEBAR; }
fn ui_theme_titlebar_active_color() { return UI_COLOR_TITLEBAR_ACTIVE; }
fn ui_theme_accent_color() { return UI_COLOR_ACCENT; }
fn ui_theme_success_color() { return UI_COLOR_SUCCESS; }
fn ui_theme_warning_color() { return UI_COLOR_WARNING; }
fn ui_theme_error_color() { return UI_COLOR_ERROR; }
fn ui_theme_text_color() { return UI_COLOR_TEXT; }
fn ui_theme_text_muted_color() { return UI_COLOR_TEXT_MUTED; }
fn ui_theme_shadow_color() { return UI_COLOR_SHADOW; }

fn ui_theme_title_height() { return UI_TITLE_HEIGHT; }
fn ui_theme_topbar_height() { return UI_TOPBAR_HEIGHT; }
fn ui_theme_dock_height() { return UI_DOCK_HEIGHT; }
