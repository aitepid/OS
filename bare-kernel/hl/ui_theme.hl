// ui_theme.hl -- HicOS UI Design Token System
// Sprint 18 | Theme Mode: Dark (0) / Light (1) / High-Contrast (2)
//
// Usage: set ui_theme_mode then call accessor functions
//   0 = Dark  (default — Windows 11 dark / macOS dark style)
//   1 = Light (Windows 11 light / macOS light style)
//   2 = High-Contrast (WCAG 2.1 AA accessibility)
//
// All colors stored as ARGB 32-bit decimal (A=255 opaque).
// Testing: ui_theme_test() => validates mode switching and token values

let mut ui_theme_mode = 0;

// ─── Dark Theme Tokens ───────────────────────────────────────────────────────
let TK_BG_BASE_DARK       = 4278718234;  // #080F1A  deep navy base
let TK_BG_SURFACE_DARK    = 4279179050;  // #0F172A  card / panel
let TK_BG_ELEVATED_DARK   = 4280166715;  // #1E293B  tooltip / dropdown
let TK_BG_OVERLAY_DARK    = 4281549141;  // #334155  hover overlay
let TK_TEXT_PRIMARY_DARK  = 4294507260;  // #F8FAFC  primary text
let TK_TEXT_SECOND_DARK   = 4287931320;  // #94A3B8  secondary / muted

// ─── Light Theme Tokens ──────────────────────────────────────────────────────
let TK_BG_BASE_LIGHT      = 4294047225;  // #F1F5F9  page background
let TK_BG_SURFACE_LIGHT   = 4294967295;  // #FFFFFF  card / panel
let TK_BG_ELEVATED_LIGHT  = 4293060848;  // #E2E8F0  tooltip / dropdown
let TK_BG_OVERLAY_LIGHT   = 4291548641;  // #CBD5E1  hover overlay
let TK_TEXT_PRIMARY_LIGHT = 4279179050;  // #0F172A  primary text
let TK_TEXT_SECOND_LIGHT  = 4284773515;  // #64748B  secondary / muted

// ─── High-Contrast Tokens ────────────────────────────────────────────────────
let TK_HC_BG     = 4278190080;  // #000000  black background
let TK_HC_TEXT   = 4294967295;  // #FFFFFF  white text
let TK_HC_ACCENT = 4294967040;  // #FFFF00  yellow accent
let TK_HC_BORDER = 4294967295;  // #FFFFFF  white border

// ─── Shared Accent / Status Tokens (theme-independent) ───────────────────────
let TK_ACCENT_PRIMARY = 4282090230;  // #3B82F6  blue 500
let TK_ACCENT_HOVER   = 4280640491;  // #2563EB  blue 600 hover
let TK_BORDER_DEFAULT = 4282865001;  // #475569  slate 600
let TK_STATUS_SUCCESS = 4280468830;  // #22C55E  green 500
let TK_STATUS_WARNING = 4293571336;  // #EAB308  yellow 500
let TK_STATUS_ERROR   = 4293870660;  // #EF4444  red 500

// ─── Window Chrome Dot Colors (macOS-style) ──────────────────────────────────
let TK_WM_CLOSE    = 4294926167;  // #FF5F57  red close
let TK_WM_MINIMIZE = 4294950190;  // #FFBD2E  yellow minimize
let TK_WM_MAXIMIZE = 4280862784;  // #28C840  green maximize

// ─── Spacing Tokens (4 px grid) ──────────────────────────────────────────────
let TK_SPACE_1 = 4;
let TK_SPACE_2 = 8;
let TK_SPACE_3 = 12;
let TK_SPACE_4 = 16;
let TK_SPACE_6 = 24;
let TK_SPACE_8 = 32;

// ─── Border Radius Tokens ─────────────────────────────────────────────────────
let TK_RADIUS_SM   = 4;
let TK_RADIUS_MD   = 8;
let TK_RADIUS_LG   = 12;
let TK_RADIUS_XL   = 16;
let TK_RADIUS_FULL = 9999;

// ─── Typography Tokens (px) ───────────────────────────────────────────────────
let TK_FONT_XS  = 10;
let TK_FONT_SM  = 12;
let TK_FONT_MD  = 14;
let TK_FONT_LG  = 16;
let TK_FONT_XL  = 20;
let TK_FONT_2XL = 24;

// ─── Legacy Size Constants (kept for backward compatibility) ─────────────────
let UI_TITLE_HEIGHT  = 24;
let UI_TOPBAR_HEIGHT = 28;
let UI_DOCK_HEIGHT   = 36;
let UI_SHADOW_OFFSET = 3;
let UI_PADDING_SM    = 4;
let UI_PADDING_MD    = 8;
let UI_PADDING_LG    = 12;

// ─── Theme Control ────────────────────────────────────────────────────────────

fn ui_theme_set(mode) {
    ui_theme_mode = mode;
}

fn ui_theme_get_mode() {
    return ui_theme_mode;
}

// ─── Background Accessor Functions ───────────────────────────────────────────

fn ui_theme_bg_base() {
    if ui_theme_mode == 1 {
        return TK_BG_BASE_LIGHT;
    }
    if ui_theme_mode == 2 {
        return TK_HC_BG;
    }
    return TK_BG_BASE_DARK;
}

fn ui_theme_bg_surface() {
    if ui_theme_mode == 1 {
        return TK_BG_SURFACE_LIGHT;
    }
    if ui_theme_mode == 2 {
        return TK_HC_BG;
    }
    return TK_BG_SURFACE_DARK;
}

fn ui_theme_bg_elevated() {
    if ui_theme_mode == 1 {
        return TK_BG_ELEVATED_LIGHT;
    }
    if ui_theme_mode == 2 {
        return TK_HC_BG;
    }
    return TK_BG_ELEVATED_DARK;
}

fn ui_theme_bg_overlay() {
    if ui_theme_mode == 1 {
        return TK_BG_OVERLAY_LIGHT;
    }
    if ui_theme_mode == 2 {
        return TK_HC_BG;
    }
    return TK_BG_OVERLAY_DARK;
}

// ─── Text Accessor Functions ──────────────────────────────────────────────────

fn ui_theme_text_primary() {
    if ui_theme_mode == 1 {
        return TK_TEXT_PRIMARY_LIGHT;
    }
    if ui_theme_mode == 2 {
        return TK_HC_TEXT;
    }
    return TK_TEXT_PRIMARY_DARK;
}

fn ui_theme_text_secondary() {
    if ui_theme_mode == 1 {
        return TK_TEXT_SECOND_LIGHT;
    }
    if ui_theme_mode == 2 {
        return TK_HC_TEXT;
    }
    return TK_TEXT_SECOND_DARK;
}

// ─── Accent / Border / Status Accessor Functions ─────────────────────────────

fn ui_theme_accent() {
    if ui_theme_mode == 2 {
        return TK_HC_ACCENT;
    }
    return TK_ACCENT_PRIMARY;
}

fn ui_theme_accent_hover() {
    if ui_theme_mode == 2 {
        return TK_HC_ACCENT;
    }
    return TK_ACCENT_HOVER;
}

fn ui_theme_border() {
    if ui_theme_mode == 2 {
        return TK_HC_BORDER;
    }
    return TK_BORDER_DEFAULT;
}

fn ui_theme_success() { return TK_STATUS_SUCCESS; }
fn ui_theme_warning() { return TK_STATUS_WARNING; }
fn ui_theme_error()   { return TK_STATUS_ERROR; }

// ─── Window Chrome Accessor Functions ────────────────────────────────────────

fn ui_theme_wm_close()    { return TK_WM_CLOSE; }
fn ui_theme_wm_minimize() { return TK_WM_MINIMIZE; }
fn ui_theme_wm_maximize() { return TK_WM_MAXIMIZE; }

// ─── Backward-Compatible Accessor Functions ───────────────────────────────────

fn ui_theme_init() { return 0; }

fn ui_theme_desktop_color()         { return ui_theme_bg_base(); }
fn ui_theme_panel_color()           { return ui_theme_bg_overlay(); }
fn ui_theme_surface_color()         { return ui_theme_bg_surface(); }
fn ui_theme_border_color()          { return ui_theme_border(); }
fn ui_theme_titlebar_color()        { return ui_theme_bg_elevated(); }
fn ui_theme_titlebar_active_color() { return ui_theme_accent(); }
fn ui_theme_accent_color()          { return ui_theme_accent(); }
fn ui_theme_success_color()         { return TK_STATUS_SUCCESS; }
fn ui_theme_warning_color()         { return TK_STATUS_WARNING; }
fn ui_theme_error_color()           { return TK_STATUS_ERROR; }
fn ui_theme_text_color()            { return ui_theme_text_primary(); }
fn ui_theme_text_muted_color()      { return ui_theme_text_secondary(); }
fn ui_theme_shadow_color()          { return TK_BG_BASE_DARK; }

fn ui_theme_title_height()   { return UI_TITLE_HEIGHT; }
fn ui_theme_topbar_height()  { return UI_TOPBAR_HEIGHT; }
fn ui_theme_dock_height()    { return UI_DOCK_HEIGHT; }
fn ui_theme_shadow_offset()  { return UI_SHADOW_OFFSET; }
fn ui_theme_padding_small()  { return UI_PADDING_SM; }
fn ui_theme_padding_medium() { return UI_PADDING_MD; }
fn ui_theme_padding_large()  { return UI_PADDING_LG; }

// ─── Self-Test ────────────────────────────────────────────────────────────────

fn ui_theme_test() {
    let mut pass = 1;

    // Dark mode (default)
    ui_theme_set(0);
    let mut d_bg = ui_theme_bg_base();
    if d_bg != TK_BG_BASE_DARK {
        pass = 0;
    }
    let mut d_surf = ui_theme_bg_surface();
    if d_surf != TK_BG_SURFACE_DARK {
        pass = 0;
    }
    let mut d_txt = ui_theme_text_primary();
    if d_txt != TK_TEXT_PRIMARY_DARK {
        pass = 0;
    }
    let mut d_acc = ui_theme_accent();
    if d_acc != TK_ACCENT_PRIMARY {
        pass = 0;
    }
    let mut d_border = ui_theme_border();
    if d_border != TK_BORDER_DEFAULT {
        pass = 0;
    }

    // Light mode
    ui_theme_set(1);
    let mut l_bg = ui_theme_bg_base();
    if l_bg != TK_BG_BASE_LIGHT {
        pass = 0;
    }
    let mut l_txt = ui_theme_text_primary();
    if l_txt != TK_TEXT_PRIMARY_LIGHT {
        pass = 0;
    }
    let mut l_acc = ui_theme_accent();
    if l_acc != TK_ACCENT_PRIMARY {
        pass = 0;
    }

    // High-Contrast mode
    ui_theme_set(2);
    let mut hc_bg = ui_theme_bg_base();
    if hc_bg != TK_HC_BG {
        pass = 0;
    }
    let mut hc_txt = ui_theme_text_primary();
    if hc_txt != TK_HC_TEXT {
        pass = 0;
    }
    let mut hc_acc = ui_theme_accent();
    if hc_acc != TK_HC_ACCENT {
        pass = 0;
    }
    let mut hc_brd = ui_theme_border();
    if hc_brd != TK_HC_BORDER {
        pass = 0;
    }

    // Reset to Dark
    ui_theme_set(0);

    // Spacing tokens
    if TK_SPACE_1 != 4 {
        pass = 0;
    }
    if TK_SPACE_2 != 8 {
        pass = 0;
    }
    if TK_SPACE_4 != 16 {
        pass = 0;
    }
    if TK_SPACE_6 != 24 {
        pass = 0;
    }

    // Radius tokens
    if TK_RADIUS_SM != 4 {
        pass = 0;
    }
    if TK_RADIUS_MD != 8 {
        pass = 0;
    }
    if TK_RADIUS_LG != 12 {
        pass = 0;
    }

    // Font tokens
    if TK_FONT_SM != 12 {
        pass = 0;
    }
    if TK_FONT_LG != 16 {
        pass = 0;
    }

    // WM dot colors
    let mut wm_c = ui_theme_wm_close();
    if wm_c != TK_WM_CLOSE {
        pass = 0;
    }
    let mut wm_m = ui_theme_wm_minimize();
    if wm_m != TK_WM_MINIMIZE {
        pass = 0;
    }
    let mut wm_x = ui_theme_wm_maximize();
    if wm_x != TK_WM_MAXIMIZE {
        pass = 0;
    }

    // Backward-compat wrappers delegate correctly (dark mode)
    let mut bc_acc = ui_theme_accent_color();
    if bc_acc != TK_ACCENT_PRIMARY {
        pass = 0;
    }
    let mut bc_err = ui_theme_error_color();
    if bc_err != TK_STATUS_ERROR {
        pass = 0;
    }

    if pass == 1 {
        print("ui_theme_test PASS");
    }
    if pass == 0 {
        print("ui_theme_test FAIL");
    }
    return pass;
}

ui_theme_test();
print("ui_theme.hl loaded");
print("UI Design Token System v2: Dark/Light/HC themes, spacing/radius/font tokens");
