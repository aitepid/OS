// eyecare.hl -- Eye-protection LUT post-process pass
//
// Sprint G2 of HicOS GUI injection (per GUI_DESIGN.md §1.1).
// Decision #2: 护眼模式 is a mandatory feature.
//
// Approach: a 256-entry per-channel LUT applied to the backbuffer just
// before LFB present. Color temperature (4500K..7500K) maps to a fixed
// (R, G, B) gain triple — warmer = more red, less blue. Brightness scales
// every entry by an output multiplier.
//
// Performance: 1024×768 ≈ 786K pixels × 3 reads/writes ≈ 2.4 ms. Triggered
// only when eyecare_enabled = 1.
//
// LUT layout in memory:
//   EYECARE_LUT_ADDR (768 bytes = 3 × 256)
//     +0..255   R LUT
//     +256..511 G LUT
//     +512..767 B LUT

let EYECARE_LUT_ADDR = 71307264;   // 0x04401000

let mut eyecare_enabled       = 0;
let mut eyecare_color_temp_k  = 6500;    // 4500 (warm) .. 7500 (cool)
let mut eyecare_brightness    = 100;     // percent 0..100
let mut eyecare_paper_mode    = 0;       // for text apps; warm + low-contrast bg
let mut eyecare_lut_dirty     = 1;       // regenerate LUT on first call
let mut eyecare_runs          = 0;

// Color-temperature → gain triple in 0..1000 per channel.
// Numbers picked to give a visible but comfortable shift at 4500 K.
fn eyecare_gain_r() {
    if eyecare_color_temp_k <= 4500 { return 1000; }
    if eyecare_color_temp_k >= 7500 { return 900; }
    // 4500..7500 K maps to 1000..900
    return 1000 - (eyecare_color_temp_k - 4500) * 100 / 3000;
}
fn eyecare_gain_g() {
    if eyecare_color_temp_k <= 4500 { return 920; }
    if eyecare_color_temp_k >= 7500 { return 1000; }
    return 920 + (eyecare_color_temp_k - 4500) * 80 / 3000;
}
fn eyecare_gain_b() {
    // Most aggressive on blue: B×0.6 at 4500 K, ×1.0 at 6500 K, ×1.05 at 7500 K.
    if eyecare_color_temp_k <= 4500 { return 600; }
    if eyecare_color_temp_k <= 6500 { return 600 + (eyecare_color_temp_k - 4500) * 400 / 2000; }
    if eyecare_color_temp_k >= 7500 { return 1050; }
    return 1000 + (eyecare_color_temp_k - 6500) * 50 / 1000;
}

fn eyecare_build_lut() {
    let mut gr = eyecare_gain_r();
    let mut gg = eyecare_gain_g();
    let mut gb = eyecare_gain_b();
    let mut bri = eyecare_brightness;
    if bri < 30  { bri = 30; }
    if bri > 100 { bri = 100; }
    let mut i = 0;
    while i < 256 {
        let mut r = i * gr / 1000 * bri / 100;
        let mut g = i * gg / 1000 * bri / 100;
        let mut b = i * gb / 1000 * bri / 100;
        if r > 255 { r = 255; }
        if g > 255 { g = 255; }
        if b > 255 { b = 255; }
        mem_write_u8(EYECARE_LUT_ADDR + i,         r);
        mem_write_u8(EYECARE_LUT_ADDR + 256 + i,   g);
        mem_write_u8(EYECARE_LUT_ADDR + 512 + i,   b);
        i = i + 1;
    }
    eyecare_lut_dirty = 0;
    return 0;
}

fn eyecare_set_enabled(on)         { eyecare_enabled       = on;       return 0; }
fn eyecare_set_color_temp(k) {
    eyecare_color_temp_k = k;
    eyecare_lut_dirty    = 1;
    return 0;
}
fn eyecare_set_brightness(pct) {
    eyecare_brightness = pct;
    eyecare_lut_dirty  = 1;
    return 0;
}
fn eyecare_set_paper_mode(on)      { eyecare_paper_mode    = on;       return 0; }

// Apply LUT to the backbuffer (the compositor calls this each frame).
fn eyecare_apply() {
    if eyecare_enabled == 0 { return 0; }
    if eyecare_lut_dirty == 1 { eyecare_build_lut(); }
    let mut total = gfx_back_width * gfx_back_height;
    let mut addr = GFX_BACK_ADDR;
    let mut i = 0;
    while i < total {
        let mut c = mem_read_u32(addr);
        // Memory layout is BGRA (little-endian). LUT is RGB indexed.
        let mut b = c % 256;
        let mut g = c / 256 % 256;
        let mut r = c / 65536 % 256;
        let mut a = c / 16777216 % 256;
        let mut nr = mem_read_u8(EYECARE_LUT_ADDR + r);
        let mut ng = mem_read_u8(EYECARE_LUT_ADDR + 256 + g);
        let mut nb = mem_read_u8(EYECARE_LUT_ADDR + 512 + b);
        mem_write_u32(addr, a * 16777216 + nr * 65536 + ng * 256 + nb);
        addr = addr + 4;
        i = i + 1;
    }
    eyecare_runs = eyecare_runs + 1;
    return 0;
}

fn eyecare_init() {
    eyecare_build_lut();
    print("eyecare: temp=" + to_string(eyecare_color_temp_k) + "K " +
          "brightness=" + to_string(eyecare_brightness) + "% " +
          "enabled=" + to_string(eyecare_enabled));
    return 0;
}

print("eyecare.hl loaded");
