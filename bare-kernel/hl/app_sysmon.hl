// app_sysmon.hl -- 系统监视器（Sprint G6）
//
// 三个 Tab：Overview / Processes / Resources
//   Overview  -> CPU 使用环 + 内存条 + 网络速率
//   Processes -> Table（PID/Name/CPU%/Mem KB）
//   Resources -> 60 桶历史曲线（CPU / Mem / Net）
// 响应式：xs 上隐藏 Resources tab；只显示 Overview。

let SM_TAB_OVERVIEW  = 0;
let SM_TAB_PROCESSES = 1;
let SM_TAB_RESOURCES = 2;

let APPSM_HIST_LEN   = 60;
let APPSM_HIST_BUF   = 73597440;    // 0x04630000 (3 * 60 * 4 = 720 B)

let mut appsm_initialized = 0;
let mut appsm_win         = 0;
let mut appsm_tabs        = 0;
let mut appsm_current_tab = 0;
let mut appsm_cpu_pct     = 0;
let mut appsm_mem_pct     = 0;
let mut appsm_net_kbps    = 0;
let mut appsm_hist_pos    = 0;

fn app_sysmon_init() {
    if appsm_initialized == 1 { return 0; }
    appsm_current_tab = SM_TAB_OVERVIEW;
    appsm_cpu_pct = 12;
    appsm_mem_pct = 38;
    appsm_net_kbps = 64;
    appsm_hist_pos = 0;
    let mut i = 0;
    while i < APPSM_HIST_LEN * 3 {
        mem_write_u32(APPSM_HIST_BUF + i * 4, 0);
        i = i + 1;
    }
    appsm_initialized = 1;
    print("app_sysmon: ready");
    return 0;
}

fn app_sysmon_tick() {
    if appsm_initialized == 0 { app_sysmon_init(); }
    // 写入历史桶
    let mut p = appsm_hist_pos;
    mem_write_u32(APPSM_HIST_BUF + p * 4,                       appsm_cpu_pct);
    mem_write_u32(APPSM_HIST_BUF + (p + APPSM_HIST_LEN) * 4,    appsm_mem_pct);
    mem_write_u32(APPSM_HIST_BUF + (p + 2*APPSM_HIST_LEN) * 4,  appsm_net_kbps);
    appsm_hist_pos = appsm_hist_pos + 1;
    if appsm_hist_pos >= APPSM_HIST_LEN { appsm_hist_pos = 0; }
    return 0;
}

fn app_sysmon_open() {
    if appsm_initialized == 0 { app_sysmon_init(); }
    let mut sw = vesa_width;  if sw == 0 { sw = 1024; }
    let mut sh = vesa_height; if sh == 0 { sh = 768; }
    let mut w = 720; let mut h = 480;
    let mut bp = al_breakpoint_get();
    if bp <= AL_BP_SM { w = sw; h = sh - shell_topbar_height(); }
    appsm_win = widget_new(WIDGET_KIND_GROUPBOX, 0,
                           (sw - w) / 2, (sh - h) / 2, w, h);
    widget_set_label(appsm_win, "System Monitor");
    let mut tab_count = 3;
    if bp <= AL_BP_SM { tab_count = 2; }
    appsm_tabs = tabs_new(appsm_win,
        widget_x[appsm_win], widget_y[appsm_win] + 32,
        w, 36, tab_count, 0);
    return appsm_win;
}

fn appsm_paint_overview() {
    let mut x = widget_x[appsm_win] + 24;
    let mut y = widget_y[appsm_win] + 84;
    font_atlas_draw_str(x, y, "CPU", 15, ui_theme_text_secondary());
    // CPU 环 (简化为圆)
    let mut cx = x + 60;
    let mut cy = y + 60;
    gfx_circle_aa(cx, cy, 40, ui_theme_bg_overlay());
    gfx_circle_aa(cx, cy, 40 - 4, ui_theme_bg_elevated());
    let mut pct_s = to_string(appsm_cpu_pct);
    let mut tw = font_atlas_measure(pct_s, 22);
    font_atlas_draw_str(cx - tw / 2, cy - 12, pct_s, 22,
                        ui_theme_accent_get());
    font_atlas_draw_str(cx - 8, cy + 14, "%", 13, ui_theme_text_secondary());
    // 内存条
    let mut my = y + 140;
    font_atlas_draw_str(x, my, "Memory", 15, ui_theme_text_secondary());
    gfx_rect_round(x, my + 24, 320, 12, 4, ui_theme_bg_overlay());
    gfx_rect_round(x, my + 24, 320 * appsm_mem_pct / 100, 12, 4,
                   ui_theme_accent_get());
    // 网络
    let mut ny = my + 60;
    font_atlas_draw_str(x, ny, "Network", 15, ui_theme_text_secondary());
    font_atlas_draw_str(x, ny + 24, to_string(appsm_net_kbps), 17,
                        ui_theme_text_primary());
    font_atlas_draw_str(x + 60, ny + 28, "KB/s", 13, ui_theme_text_secondary());
    return 0;
}

fn appsm_paint_processes() {
    let mut x = widget_x[appsm_win] + 16;
    let mut y = widget_y[appsm_win] + 78;
    let mut w = widget_w[appsm_win] - 32;
    // 表头
    gfx_fill_rect(x, y, w, 28, ui_theme_bg_overlay());
    font_atlas_draw_str(x + 8,   y + 7, "PID",  13, ui_theme_text_primary());
    font_atlas_draw_str(x + 60,  y + 7, "Name", 13, ui_theme_text_primary());
    font_atlas_draw_str(x + 260, y + 7, "CPU%", 13, ui_theme_text_primary());
    font_atlas_draw_str(x + 340, y + 7, "Mem",  13, ui_theme_text_primary());
    // 演示行
    let mut ry = y + 36;
    font_atlas_draw_str(x + 8,   ry, "1",    13, ui_theme_text_primary());
    font_atlas_draw_str(x + 60,  ry, "kernel", 13, ui_theme_text_primary());
    font_atlas_draw_str(x + 260, ry, "3",    13, ui_theme_text_primary());
    font_atlas_draw_str(x + 340, ry, "2048", 13, ui_theme_text_primary());
    ry = ry + 28;
    font_atlas_draw_str(x + 8,   ry, "12",   13, ui_theme_text_primary());
    font_atlas_draw_str(x + 60,  ry, "compositor", 13, ui_theme_text_primary());
    font_atlas_draw_str(x + 260, ry, "8",    13, ui_theme_text_primary());
    font_atlas_draw_str(x + 340, ry, "512",  13, ui_theme_text_primary());
    return 0;
}

fn appsm_paint_resources() {
    let mut x = widget_x[appsm_win] + 24;
    let mut y = widget_y[appsm_win] + 78;
    let mut w = widget_w[appsm_win] - 48;
    let mut h = (widget_h[appsm_win] - 100) / 3 - 8;
    // 3 张曲线图
    let mut ch_y = y;
    let mut series = 0;
    while series < 3 {
        gfx_rect_round(x, ch_y, w, h, 6, ui_theme_bg_elevated());
        let mut label = "CPU";
        if series == 1 { label = "Memory"; }
        if series == 2 { label = "Network"; }
        font_atlas_draw_str(x + 8, ch_y + 6, label, 13, ui_theme_text_secondary());
        let mut i = 0;
        let mut px = 0;
        let mut py = 0;
        let mut first = 1;
        while i < APPSM_HIST_LEN {
            let mut v = mem_read_u32(APPSM_HIST_BUF + (series * APPSM_HIST_LEN + i) * 4);
            if v > 100 { v = 100; }
            let mut nx = x + i * w / APPSM_HIST_LEN;
            let mut ny = ch_y + h - v * (h - 12) / 100 - 4;
            if first == 1 { first = 0; }
            else { gfx_line_aa(px, py, nx, ny, ui_theme_accent_get()); }
            px = nx; py = ny;
            i = i + 1;
        }
        ch_y = ch_y + h + 8;
        series = series + 1;
    }
    return 0;
}

fn app_sysmon_paint() {
    if appsm_initialized == 0 { return 0; }
    if appsm_win == 0 { return 0; }
    groupbox_paint(appsm_win);
    tabs_paint(appsm_tabs);
    let mut sel = widget_extra[appsm_tabs];
    if sel == SM_TAB_OVERVIEW  { appsm_paint_overview();  }
    if sel == SM_TAB_PROCESSES { appsm_paint_processes(); }
    if sel == SM_TAB_RESOURCES { appsm_paint_resources(); }
    return 0;
}

print("app_sysmon.hl loaded");
