// lz4.hl -- LZ4 Block Compression Codec
//
// Iteration 183: Fast in-memory compression/decompression.
//
// LZ4 block format (sequence-based):
//   Each sequence:
//     token (1 byte): litlen=token/16, matchlen=(token%16)+4
//     if litlen  == 15: extra length bytes until byte < 255
//     literal bytes (litlen of them)
//     offset (2 bytes, little-endian) — distance back into output
//     if matchlen == 19: extra length bytes until byte < 255
//   Last sequence has no match (literals only, no offset).
//
// Compression: 4096-entry hash table (4 bytes each → 4KB).
//   Key = hash of 4-byte window mod 4096.
//   Hash = (b0 * 2654435761 + b1 * 1234567 + b2 * 9876543 + b3) % 4096
//   (pure integer arithmetic, no bitwise ops)
//
// Limits: input ≤ 65536 bytes (64 KB).
//
// Memory layout (all read/write via mem_read_u8/mem_write_u8):
//   LZ4_IN_BUF  = 0xEB0000  (65536 bytes input  scratch)
//   LZ4_OUT_BUF = 0xEC0000  (65536 bytes output scratch)
//   LZ4_HASH    = 0xED0000  (16384 bytes = 4096 × 4-byte position entries)
//
// Public API:
//   lz4_init()
//   lz4_compress(src, slen, dst)   → compressed size (-1 on overflow)
//   lz4_decompress(src, slen, dst, max_out) → decompressed size (-1 on error)
//   lz4_compress_mem(saddr, slen, daddr) → compressed size
//   lz4_decompress_mem(saddr, slen, daddr, dlim) → output size
//   lz4_compress_file(inpath, outpath)   → compressed size
//   lz4_decompress_file(inpath, outpath) → decompressed size
//   lz4_selftest()                → "ok" or error string
//
// Shell:
//   lz4c <inpath> <outpath>
//   lz4d <inpath> <outpath>
//   lz4test

let mut LZ4_IN_BUF   = 15400960;   // 0xEB0000
let mut LZ4_OUT_BUF  = 15466496;   // 0xEC0000
let mut LZ4_HASH     = 15532032;   // 0xED0000
let LZ4_BUF_SZ   = 65536;
let LZ4_HASH_SZ  = 4096;       // number of entries
let LZ4_MIN_MATCH = 4;
let LZ4_LAST_LIT  = 5;         // last 5 bytes always go as literals

fn lz4_init() {
    print("lz4: init — in=" + to_string(LZ4_IN_BUF)
        + " out=" + to_string(LZ4_OUT_BUF)
        + " hash=" + to_string(LZ4_HASH));
    return 0;
}

// ============================================================
// Hash table helpers
// ============================================================

fn _lz4_hash4(src, pos) {
    let mut b0 = mem_read_u8(src + pos);
    let mut b1 = mem_read_u8(src + pos + 1);
    let mut b2 = mem_read_u8(src + pos + 2);
    let mut b3 = mem_read_u8(src + pos + 3);
    let mut h = (b0 * 2654435 + b1 * 123456 + b2 * 987654 + b3 * 11111) % LZ4_HASH_SZ;
    return h;
}

fn _lz4_hash_get(slot) {
    let mut addr = LZ4_HASH + slot * 4;
    return mem_read_u8(addr) + mem_read_u8(addr + 1) * 256
         + mem_read_u8(addr + 2) * 65536 + mem_read_u8(addr + 3) * 16777216;
}

fn _lz4_hash_set(slot, val) {
    let mut addr = LZ4_HASH + slot * 4;
    mem_write_u8(addr,     val % 256);
    mem_write_u8(addr + 1, (val / 256) % 256);
    mem_write_u8(addr + 2, (val / 65536) % 256);
    mem_write_u8(addr + 3, (val / 16777216) % 256);
    return 0;
}

fn _lz4_hash_clear() {
    let mut total = LZ4_HASH_SZ * 4;
    mem_zero(LZ4_HASH, total);
    return 0;
}

// ============================================================
// Compression
// ============================================================

// Write variable extra-length bytes for len >= 15 extension
fn _lz4_write_extra_len(dst, dpos, extra) {
    let mut rem = extra;
    while rem >= 255 {
        mem_write_u8(dst + dpos, 255);
        dpos = dpos + 1;
        rem = rem - 255;
    }
    mem_write_u8(dst + dpos, rem);
    return dpos + 1;
}

fn lz4_compress_mem(src, slen, dst) {
    if slen <= 0 { return 0; }
    if slen > LZ4_BUF_SZ { return 0 - 1; }
    _lz4_hash_clear();

    let mut sp   = 0;    // source position
    let mut dp   = 0;    // dest position
    let mut anchor = 0;  // start of current literal run
    let mut limit = slen - LZ4_LAST_LIT;

    while sp < limit {
        // Look for a match
        let mut match_pos = 0 - 1;
        let mut match_len = 0;

        if sp + 4 <= slen {
            let mut slot = _lz4_hash4(src, sp);
            let mut candidate = _lz4_hash_get(slot);
            _lz4_hash_set(slot, sp);

            if candidate > 0 {
                let mut off = sp - candidate;
                if off > 0 {
                    if off <= 65535 {
                        // Count match length
                        let mut ml = 0;
                        while sp + ml < slen {
                            if mem_read_u8(src + candidate + ml) == mem_read_u8(src + sp + ml) {
                                ml = ml + 1;
                            } else {
                                ml = slen + 1;
                            }
                        }
                        if ml < slen + 1 { ml = ml; }
                        else { ml = slen - sp; }
                        if ml >= LZ4_MIN_MATCH {
                            match_pos = candidate;
                            match_len = ml;
                        }
                    }
                }
            }
        }

        if match_pos < 0 {
            sp = sp + 1;
        } else {
            // Emit sequence: literals from anchor..sp, then match
            let mut litlen = sp - anchor;
            let mut matchlen_enc = match_len - LZ4_MIN_MATCH;
            let mut off = sp - match_pos;

            // Token byte
            let mut lit_nibble = litlen;
            if lit_nibble > 15 { let lit_nibble = 15; }
            let mut mat_nibble = matchlen_enc;
            if mat_nibble > 15 { let mat_nibble = 15; }
            mem_write_u8(dst + dp, lit_nibble * 16 + mat_nibble);
            dp = dp + 1;

            // Extra literal length
            if litlen >= 15 {
                dp = _lz4_write_extra_len(dst, dp, litlen - 15);
            }

            // Literal bytes
            let mut i = 0;
            while i < litlen {
                mem_write_u8(dst + dp, mem_read_u8(src + anchor + i));
                dp = dp + 1;
                i = i + 1;
            }

            // Offset (little-endian 2 bytes)
            mem_write_u8(dst + dp,     off % 256);
            mem_write_u8(dst + dp + 1, off / 256);
            dp = dp + 2;

            // Extra match length
            if matchlen_enc >= 15 {
                dp = _lz4_write_extra_len(dst, dp, matchlen_enc - 15);
            }

            sp = sp + match_len;
            anchor = sp;
        }

        if dp >= LZ4_BUF_SZ - 16 { return 0 - 1; }
    }

    // Emit final literal sequence (no match)
    let mut litlen = slen - anchor;
    if litlen > 0 {
        let mut lit_nibble = litlen;
        if lit_nibble > 15 { let lit_nibble = 15; }
        mem_write_u8(dst + dp, lit_nibble * 16);   // matchlen nibble = 0
        dp = dp + 1;
        if litlen >= 15 {
            dp = _lz4_write_extra_len(dst, dp, litlen - 15);
        }
        let mut i = 0;
        while i < litlen {
            mem_write_u8(dst + dp, mem_read_u8(src + anchor + i));
            dp = dp + 1;
            i = i + 1;
        }
    }
    return dp;
}

// ============================================================
// Decompression
// ============================================================

fn lz4_decompress_mem(src, slen, dst, dlim) {
    let mut sp = 0;
    let mut dp = 0;
    while sp < slen {
        let mut token = mem_read_u8(src + sp);
        sp = sp + 1;

        // Literal length
        let mut litlen = token / 16;
        if litlen == 15 {
            let mut extra = 255;
            while extra == 255 {
                if sp >= slen { return 0 - 1; }
                extra = mem_read_u8(src + sp);
                sp = sp + 1;
                litlen = litlen + extra;
            }
        }

        // Copy literals
        let mut i = 0;
        while i < litlen {
            if sp >= slen { return 0 - 1; }
            if dp >= dlim { return 0 - 1; }
            mem_write_u8(dst + dp, mem_read_u8(src + sp));
            dp = dp + 1;
            sp = sp + 1;
            i = i + 1;
        }

        // Last sequence has no match part
        if sp >= slen { return dp; }

        // Offset (little-endian 2 bytes)
        if sp + 1 >= slen { return 0 - 1; }
        let mut off = mem_read_u8(src + sp) + mem_read_u8(src + sp + 1) * 256;
        sp = sp + 2;
        if off == 0 { return 0 - 1; }
        if off > dp { return 0 - 1; }

        // Match length
        let mut matchlen = (token % 16) + LZ4_MIN_MATCH;
        if matchlen == 15 + LZ4_MIN_MATCH {
            let mut extra = 255;
            while extra == 255 {
                if sp >= slen { return 0 - 1; }
                extra = mem_read_u8(src + sp);
                sp = sp + 1;
                matchlen = matchlen + extra;
            }
        }

        // Copy match (may overlap — byte-by-byte required)
        let mut match_start = dp - off;
        let mut j = 0;
        while j < matchlen {
            if dp >= dlim { return 0 - 1; }
            mem_write_u8(dst + dp, mem_read_u8(dst + match_start + j));
            dp = dp + 1;
            j = j + 1;
        }
    }
    return dp;
}

// ============================================================
// File-backed wrappers
// ============================================================

fn lz4_compress_file(inpath, outpath) {
    let mut fd_in = vfs_open(inpath, 0);
    if fd_in < 0 { print("lz4c: cannot open " + inpath); return 0 - 1; }
    let mut n = vfs_read(fd_in, LZ4_IN_BUF, LZ4_BUF_SZ);
    vfs_close(fd_in);
    if n <= 0 { print("lz4c: empty input"); return 0 - 1; }
    let mut clen = lz4_compress_mem(LZ4_IN_BUF, n, LZ4_OUT_BUF);
    if clen < 0 { print("lz4c: compression failed"); return 0 - 1; }
    let mut fd_out = vfs_open(outpath, 1);
    if fd_out < 0 { print("lz4c: cannot create " + outpath); return 0 - 1; }
    vfs_write(fd_out, LZ4_OUT_BUF, clen);
    vfs_close(fd_out);
    print("lz4c: " + inpath + " → " + outpath
        + " " + to_string(n) + " → " + to_string(clen)
        + " bytes (" + to_string(clen * 100 / n) + "%)");
    return clen;
}

fn lz4_decompress_file(inpath, outpath) {
    let mut fd_in = vfs_open(inpath, 0);
    if fd_in < 0 { print("lz4d: cannot open " + inpath); return 0 - 1; }
    let mut n = vfs_read(fd_in, LZ4_IN_BUF, LZ4_BUF_SZ);
    vfs_close(fd_in);
    if n <= 0 { print("lz4d: empty input"); return 0 - 1; }
    let mut dlen = lz4_decompress_mem(LZ4_IN_BUF, n, LZ4_OUT_BUF, LZ4_BUF_SZ);
    if dlen < 0 { print("lz4d: decompression failed"); return 0 - 1; }
    let mut fd_out = vfs_open(outpath, 1);
    if fd_out < 0 { print("lz4d: cannot create " + outpath); return 0 - 1; }
    vfs_write(fd_out, LZ4_OUT_BUF, dlen);
    vfs_close(fd_out);
    print("lz4d: " + inpath + " → " + outpath
        + " " + to_string(n) + " → " + to_string(dlen) + " bytes");
    return dlen;
}

// ============================================================
// Self-test
// ============================================================

fn lz4_selftest() {
    // Write pattern: "AAABBBAAACCC..." (60 bytes with repeats)
    let mut pattern = "AAABBBCCCDDDEEEFFF";
    let mut plen = len(pattern);
    let mut i = 0;
    while i < 60 {
        mem_write_u8(LZ4_IN_BUF + i, str_char_code(pattern, i % plen));
        i = i + 1;
    }
    let mut clen = lz4_compress_mem(LZ4_IN_BUF, 60, LZ4_OUT_BUF);
    if clen < 0 { return "lz4_selftest: compress failed"; }
    if clen >= 60 { return "lz4_selftest: no compression (" + to_string(clen) + " >= 60)"; }

    // Decompress into IN_BUF+128 (scratch zone)
    let mut dlen = lz4_decompress_mem(LZ4_OUT_BUF, clen, LZ4_IN_BUF + 128, 64);
    if dlen != 60 { return "lz4_selftest: decomp size mismatch " + to_string(dlen) + " != 60"; }

    // Verify bytes match
    let mut j = 0;
    while j < 60 {
        let mut orig = mem_read_u8(LZ4_IN_BUF + j);
        let mut back = mem_read_u8(LZ4_IN_BUF + 128 + j);
        if orig != back { return "lz4_selftest: byte mismatch at " + to_string(j); }
        j = j + 1;
    }
    return "lz4_selftest: ok (" + to_string(60) + " → " + to_string(clen)
        + " → " + to_string(60) + " bytes)";
}

print("lz4.hl loaded");
print("LZ4: block codec, 4096-slot hash, 64 KB in/out, compress+decompress+file+selftest");
