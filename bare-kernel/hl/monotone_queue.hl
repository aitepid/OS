// monotone_queue.hl -- Sliding-window min/max via monotone deque (iter 331)
// Buffer: 0x1820000
// mq_slide_min(n,k): fills mq_min_res[i] = min of mq_data[i-k+1..i] for i>=k-1
// mq_slide_max(n,k): fills mq_max_res[i] = max of mq_data[i-k+1..i] for i>=k-1
// Both O(n) time; deque stores indices, maintaining monotone value order.

let MQ_MAX = 64;

let mq_data    = array(64, 0);
let mq_min_res = array(64, 0);
let mq_max_res = array(64, 0);
let mq_dq      = array(64, 0);   // index deque (reused for min and max)
let mut mq_dq_f    = 0;
let mut mq_dq_b    = 0;
let mut mq_n       = 0;
let mut mq_k       = 1;

fn mq_init() {
    mq_n   = 0;
    mq_k   = 1;
    mq_dq_f = 0;
    mq_dq_b = 0;
    let mut i = 0;
    while i < MQ_MAX {
        set_at(mq_data,    i, 0);
        set_at(mq_min_res, i, 0);
        set_at(mq_max_res, i, 0);
        set_at(mq_dq,      i, 0);
        i += 1;
    }
    return 0;
}

fn mq_slide_min(n, k) {
    mq_dq_f = 0;
    mq_dq_b = 0;
    let mut i = 0;
    while i < n {
        while mq_dq_f < mq_dq_b && mq_dq[mq_dq_f] < i - k + 1 {
            mq_dq_f += 1;
        }
        while mq_dq_f < mq_dq_b && mq_data[mq_dq[mq_dq_b - 1]] >= mq_data[i] {
            mq_dq_b -= 1;
        }
        set_at(mq_dq, mq_dq_b, i);
        mq_dq_b += 1;
        if i >= k - 1 {
            set_at(mq_min_res, i, mq_data[mq_dq[mq_dq_f]]);
        }
        i += 1;
    }
    return 0;
}

fn mq_slide_max(n, k) {
    mq_dq_f = 0;
    mq_dq_b = 0;
    let mut i = 0;
    while i < n {
        while mq_dq_f < mq_dq_b && mq_dq[mq_dq_f] < i - k + 1 {
            mq_dq_f += 1;
        }
        while mq_dq_f < mq_dq_b && mq_data[mq_dq[mq_dq_b - 1]] <= mq_data[i] {
            mq_dq_b -= 1;
        }
        set_at(mq_dq, mq_dq_b, i);
        mq_dq_b += 1;
        if i >= k - 1 {
            set_at(mq_max_res, i, mq_data[mq_dq[mq_dq_f]]);
        }
        i += 1;
    }
    return 0;
}

fn mq_test() {
    mq_init();
    // data = [3,1,4,1,5,9,2,6], k=3
    set_at(mq_data, 0, 3);
    set_at(mq_data, 1, 1);
    set_at(mq_data, 2, 4);
    set_at(mq_data, 3, 1);
    set_at(mq_data, 4, 5);
    set_at(mq_data, 5, 9);
    set_at(mq_data, 6, 2);
    set_at(mq_data, 7, 6);
    mq_slide_min(8, 3);
    mq_slide_max(8, 3);
    // Windows: [3,1,4],[1,4,1],[4,1,5],[1,5,9],[5,9,2],[9,2,6]
    // min at i=2..7: 1,1,1,1,2,2   max at i=2..7: 4,4,5,9,9,9
    let mut min2 = mq_min_res[2];
    let mut min5 = mq_min_res[5];
    let mut max2 = mq_max_res[2];
    let mut max7 = mq_max_res[7];
    print("mq_test: min[2]=" + to_string(min2) + " min[5]=" + to_string(min5) +
          " max[2]=" + to_string(max2) + " max[7]=" + to_string(max7));
    if min2 == 1 {
        if min5 == 1 {
            if max2 == 4 {
                if max7 == 9 {
                    print("mq_test: PASS");
                    return 1;
                }
            }
        }
    }
    print("mq_test: FAIL");
    return 0;
}

print("monotone_queue.hl loaded");
