// wavelet_tree_range.hl -- Static Wavelet Tree: range k-th smallest (iter 355)
// Buffer: 0x19A0000
// WVR_N=8 elements; WVR_LOG=3 levels; values in [0, WVR_VMAX-1]=[0,7]
// Build: at each level examine bit (LOG-1-level); cnt[l][i] = prefix #left in [0..i-1]
// Query wvr_kth(ql,qr,k): bisect value range using cnt prefix sums; O(log V)

let mut WVR_N    = 8;
let mut WVR_LOG  = 3;
let WVR_VMAX = 8;   // values in [0, WVR_VMAX-1]

// cnt[level*(WVR_N+1)+i] = #elements in positions [0..i-1] that went left at `level`
let wvr_cnt = array(27, 0);  // 3 * 9
let wvr_arr = array(8, 0);   // input array (rearranged during build)
let mut wvr_n   = 0;             // array size set by wvr_build

fn _wvr_pow2(k) {
    let mut r = 1;
    let mut i = 0;
    while i < k { r = r * 2; i += 1; }
    return r;
}

fn wvr_init() {
    let mut i = 0;
    while i < 27 { set_at(wvr_cnt, i, 0); i += 1; }
    let mut j = 0;
    while j < WVR_N { set_at(wvr_arr, j, 0); j += 1; }
    wvr_n = 0;
    return 0;
}

fn wvr_set(i, v) { set_at(wvr_arr, i, v); return 0; }

fn wvr_build(n) {
    wvr_n = n;
    let tmp_l = array(8, 0);
    let tmp_r = array(8, 0);
    let mut level = 0;
    while level < WVR_LOG {
        let bit = _wvr_pow2(WVR_LOG - 1 - level);
        let mut base = level * (WVR_N + 1);
        set_at(wvr_cnt, base, 0);
        let mut i = 0;
        let nl = 0;
        let nr = 0;
        while i < n {
            let bv = wvr_arr[i] / bit;
            let b  = bv - (bv / 2) * 2;
            if b == 0 {
                set_at(tmp_l, nl, wvr_arr[i]);
                nl += 1;
            } else {
                set_at(tmp_r, nr, wvr_arr[i]);
                nr += 1;
            }
            set_at(wvr_cnt, base + i + 1, nl);
            i += 1;
        }
        let mut j = 0;
        while j < nl { set_at(wvr_arr, j, tmp_l[j]); j += 1; }
        let mut k = 0;
        while k < nr { set_at(wvr_arr, nl + k, tmp_r[k]); k += 1; }
        level += 1;
    }
    return 0;
}

fn wvr_kth(ql, qr, k) {
    // k-th smallest (1-indexed) in positions [ql..qr]
    let mut lo = 0;
    let mut hi = WVR_VMAX - 1;
    let mut level = 0;
    while level < WVR_LOG {
        let base  = level * (WVR_N + 1);
        let cql   = wvr_cnt[base + ql];
        let cqr1  = wvr_cnt[base + qr + 1];
        let ctot  = wvr_cnt[base + wvr_n];
        let inlft = cqr1 - cql;
        if k <= inlft {
            ql = cql;
            qr = cqr1 - 1;
            hi = (lo + hi) / 2;
        } else {
            k  -= inlft;
            ql  = ctot + ql - cql;
            qr  = ctot + (qr + 1 - cqr1) - 1;
            lo  = (lo + hi) / 2 + 1;
        }
        level += 1;
    }
    return lo;
}

fn wvr_test() {
    wvr_init();
    // arr = [3,1,4,1], k-th in [0..3]
    wvr_set(0, 3); wvr_set(1, 1); wvr_set(2, 4); wvr_set(3, 1);
    wvr_build(4);
    // sorted [0..3] = [1,1,3,4]; k=2 -> 1, k=3 -> 3
    let k2 = wvr_kth(0, 3, 2);
    let k3 = wvr_kth(0, 3, 3);
    print("wvr_test: k2=" + to_string(k2) + " k3=" + to_string(k3));
    if k2 == 1 {
        if k3 == 3 {
            print("wvr_test: PASS");
            return 1;
        }
    }
    print("wvr_test: FAIL");
    return 0;
}

print("wavelet_tree_range.hl loaded");
