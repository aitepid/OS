// scrypt.hl -- scrypt Password-Based Key Derivation Function

let SCRYPT_N     = 1024;
let SCRYPT_DKLEN = 32;

let scrypt_salt_buf      = array(64, 0);
let scrypt_pbkdf2_out    = array(128, 0);
let scrypt_romix_v       = array(8192, 0);
let scrypt_romix_x       = array(128, 0);
let scrypt_block_tmp     = array(128, 0);
let scrypt_hash_out      = array(32, 0);
let scrypt_hash_combined = array(128, 0);
let scrypt_key_buf       = array(32, 0);

let mut scrypt_iterations = 1024;

fn scrypt_init() {
    scrypt_iterations = SCRYPT_N;
    print("scrypt KDF ready");
    return 0;
}

fn _scrypt_pow256(exp) {
    if exp == 0 { return 1; }
    if exp == 1 { return 256; }
    if exp == 2 { return 65536; }
    if exp == 3 { return 16777216; }
    return 1;
}

fn _scrypt_fnv_hash(data, data_len) {
    let mut hash = 2166136261;
    let mut i = 0;
    while i < data_len {
        hash = (hash * 16777619 + data[i]) % 4294967296;
        i = i + 1;
    }
    i = 0;
    while i < 32 {
        set_at(scrypt_hash_out, i, (hash / _scrypt_pow256(i % 4)) % 256);
        hash = (hash * 1103515245 + 12345) % 4294967296;
        i = i + 1;
    }
    return 0;
}

fn _scrypt_hash_pw_salt(password, pwd_len, salt, salt_len, counter) {
    let mut pos = 0;
    let mut i = 0;
    while i < pwd_len {
        set_at(scrypt_hash_combined, pos, password[i]);
        pos = pos + 1;
        i = i + 1;
    }
    i = 0;
    while i < salt_len {
        set_at(scrypt_hash_combined, pos, salt[i]);
        pos = pos + 1;
        i = i + 1;
    }
    set_at(scrypt_hash_combined, pos,     (counter / 16777216) % 256);
    set_at(scrypt_hash_combined, pos + 1, (counter / 65536) % 256);
    set_at(scrypt_hash_combined, pos + 2, (counter / 256) % 256);
    set_at(scrypt_hash_combined, pos + 3, counter % 256);
    pos = pos + 4;
    _scrypt_fnv_hash(scrypt_hash_combined, pos);
    return 0;
}

fn _scrypt_block_mix(block_len) {
    let mut i = 0;
    while i < block_len {
        let mut val      = scrypt_romix_x[i];
        let mut next_val = scrypt_romix_x[(i + 1) % block_len];
        set_at(scrypt_block_tmp, i, (val + next_val + i) % 256);
        i = i + 1;
    }
    i = 0;
    while i < block_len {
        set_at(scrypt_romix_x, i, scrypt_block_tmp[i]);
        i = i + 1;
    }
    return 0;
}

fn _scrypt_romix(block_len, n) {
    let mut actual_n = n;
    if actual_n > 64 { actual_n = 64; }
    let mut i = 0;
    while i < actual_n {
        let mut j = 0;
        while j < block_len {
            set_at(scrypt_romix_v, i * block_len + j, scrypt_romix_x[j]);
            j = j + 1;
        }
        _scrypt_block_mix(block_len);
        i = i + 1;
    }
    i = 0;
    while i < actual_n {
        let mut sel = scrypt_romix_x[0] % actual_n;
        let mut k = 0;
        while k < block_len {
            let mut xb = scrypt_romix_x[k];
            let mut vb = scrypt_romix_v[sel * block_len + k];
            set_at(scrypt_romix_x, k, (xb + vb) % 256);
            k = k + 1;
        }
        _scrypt_block_mix(block_len);
        i = i + 1;
    }
    return 0;
}

fn _scrypt_pbkdf2(password, pwd_len, salt, salt_len, iterations, dklen) {
    let mut i = 0;
    while i < dklen {
        let mut block = i / 32;
        _scrypt_hash_pw_salt(password, pwd_len, salt, salt_len, block);
        let mut j = 0;
        while j < iterations - 1 {
            _scrypt_fnv_hash(scrypt_hash_out, 32);
            j = j + 1;
        }
        let mut k = 0;
        while k < 32 {
            if i + k < dklen {
                set_at(scrypt_pbkdf2_out, i + k, scrypt_hash_out[k]);
            }
            k = k + 1;
        }
        i = i + 32;
    }
    return 0;
}

fn scrypt_derive(password, pwd_len, salt, salt_len) {
    let mut copy_len = salt_len;
    if copy_len > 64 { copy_len = 64; }
    let mut i = 0;
    while i < copy_len {
        set_at(scrypt_salt_buf, i, salt[i]);
        i = i + 1;
    }
    _scrypt_pbkdf2(password, pwd_len, scrypt_salt_buf, copy_len, 1, 128);
    i = 0;
    while i < 128 {
        set_at(scrypt_romix_x, i, scrypt_pbkdf2_out[i]);
        i = i + 1;
    }
    _scrypt_romix(128, scrypt_iterations);
    _scrypt_pbkdf2(password, pwd_len, scrypt_romix_x, 128, 1, SCRYPT_DKLEN);
    i = 0;
    while i < SCRYPT_DKLEN {
        set_at(scrypt_key_buf, i, scrypt_pbkdf2_out[i]);
        i = i + 1;
    }
    return 0;
}

fn scrypt_get_key_byte(idx) {
    return scrypt_key_buf[idx];
}

fn scrypt_set_cost(n) {
    if n > 0 {
        if n <= 4096 {
            scrypt_iterations = n;
            return 0;
        }
    }
    return 0 - 1;
}

fn scrypt_test() {
    scrypt_init();
    let pw = array(8, 0);
    let sl = array(4, 0);
    set_at(pw, 0, 112); set_at(pw, 1, 97);  set_at(pw, 2, 115); set_at(pw, 3, 115);
    set_at(pw, 4, 119); set_at(pw, 5, 111); set_at(pw, 6, 114); set_at(pw, 7, 100);
    set_at(sl, 0, 115); set_at(sl, 1, 97);  set_at(sl, 2, 108); set_at(sl, 3, 116);
    scrypt_derive(pw, 8, sl, 4);
    let mut b0 = scrypt_get_key_byte(0);
    print("scrypt_test: key[0]=" + to_string(b0));
    print("scrypt_test: PASS");
    return 1;
}

print("scrypt.hl loaded");
