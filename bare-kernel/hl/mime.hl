// mime.hl -- MIME Multipart Message Parser
//
// Iteration 195: Parse MIME multipart messages (email, HTTP).
//
// MIME structure:
//   Headers (key: value) until blank line
//   Body (may contain multiple parts separated by boundary)
//
// Multipart format:
//   Content-Type: multipart/mixed; boundary="boundary_string"
//   (blank line)
//   --boundary_string
//   (part 1 headers)
//   (blank line)
//   (part 1 body)
//   --boundary_string
//   (part 2 headers)
//   (blank line)
//   (part 2 body)
//   --boundary_string--
//
// Storage: MIME_MAX (8) parts in parallel flat arrays.
//   Each part: headers_str, body_str, content_type
//
// Public API:
//   mime_init()
//   mime_parse_str(s)          → part count / -1 on error
//   mime_load(path)            → part count / -1 on error
//   mime_part_count()
//   mime_part_body(idx)        → body string
//   mime_part_header(idx, key) → header value or ""
//   mime_list()                → formatted dump
//   mime_clear()
//
// Shell:
//   mime load <path>
//   mime parse <string>
//   mime list
//   mime part <idx>
//   mime header <idx> <key>
//   mime clear

let MIME_MAX    = 8;
let MIME_BUF    = 16384000;   // 0xFA0000  64 KB scratch
let MIME_BUF_SZ = 65536;

let mut mime_part_headers = [];   // header strings per part
let mut mime_part_bodies  = [];   // body strings per part
let mut mime_part_ctypes  = [];   // content-type per part
let mut mime_part_count_n = 0;
let mut mime_boundary     = "";

fn mime_init() {
    mime_part_headers = [];
    mime_part_bodies  = [];
    mime_part_ctypes  = [];
    mime_part_count_n = 0;
    mime_boundary     = "";
    let mut i = 0;
    while i < MIME_MAX {
        push(mime_part_headers, "");
        push(mime_part_bodies,  "");
        push(mime_part_ctypes,  "");
        i = i + 1;
    }
    print("mime: init — max " + to_string(MIME_MAX) + " parts, multipart/mixed parser");
    return 0;
}

fn mime_clear() {
    if len(mime_part_headers) == 0 { mime_init(); return 0; }
    mime_part_count_n = 0;
    mime_boundary     = "";
    let mut i = 0;
    while i < MIME_MAX {
        set_at(mime_part_headers, i, "");
        set_at(mime_part_bodies,  i, "");
        set_at(mime_part_ctypes,  i, "");
        i = i + 1;
    }
    return 0;
}

fn mime_part_count() { return mime_part_count_n; }

fn mime_part_body(idx) {
    if idx < 0 { return ""; }
    if idx >= mime_part_count_n { return ""; }
    return mime_part_bodies[idx];
}

// ============================================================
// Extract boundary from Content-Type header
// ============================================================

fn _mime_extract_boundary(ctype) {
    let mut pos = str_find(ctype, "boundary=");
    if pos < 0 { return ""; }
    let mut bstart = pos + 9;   // skip "boundary="
    if bstart >= len(ctype) { return ""; }
    let mut delim = str_char_code(ctype, bstart);
    if delim == 34 {   // '"' quoted
        let mut bend = str_find(str_sub(ctype, bstart + 1, len(ctype)), "\"");
        if bend < 0 { return ""; }
        return str_sub(ctype, bstart + 1, bstart + 1 + bend);
    }
    // Unquoted: read until space or semicolon or end
    let mut j = bstart;
    while j < len(ctype) {
        let mut c = str_char_code(ctype, j);
        if c == 32 { j = len(ctype) + 1; }   // space
        else { if c == 59 { j = len(ctype) + 1; }   // semicolon
        else { j = j + 1; } }
    }
    if j > len(ctype) { j = j - len(ctype) - 1; }
    return str_sub(ctype, bstart, j);
}

// ============================================================
// Extract header value from headers string
// ============================================================

fn mime_part_header(idx, key) {
    if idx < 0 { return ""; }
    if idx >= mime_part_count_n { return ""; }
    let mut hdrs = mime_part_headers[idx];
    let mut pattern = key + ":";
    let mut pos = str_find(hdrs, pattern);
    if pos < 0 { return ""; }
    let mut vstart = pos + len(pattern);
    // Skip leading spaces
    while vstart < len(hdrs) {
        if str_char_code(hdrs, vstart) == 32 { vstart = vstart + 1; }
        else { vstart = len(hdrs) + 1; }
    }
    if vstart > len(hdrs) { vstart = vstart - len(hdrs) - 1; }
    // Find end of line
    let mut nl = str_find(str_sub(hdrs, vstart, len(hdrs)), "\n");
    let mut vend = len(hdrs);
    if nl >= 0 { vend = vstart + nl; }
    let mut val = str_sub(hdrs, vstart, vend);
    // Trim trailing \r
    if len(val) > 0 {
        if str_char_code(val, len(val) - 1) == 13 {
            return str_sub(val, 0, len(val) - 1);
        }
    }
    return val;
}

// ============================================================
// Parse MIME string
// ============================================================

fn mime_parse_str(s) {
    mime_clear();
    let mut n = len(s);
    // Find blank line separating headers from body
    let mut hdr_end = str_find(s, "\n\n");
    if hdr_end < 0 { hdr_end = str_find(s, "\r\n\r\n"); }
    if hdr_end < 0 { return 0; }   // No body

    let mut headers = str_sub(s, 0, hdr_end);
    let mut body_start = hdr_end + 2;
    if str_char_code(s, hdr_end) == 13 { body_start = body_start + 2; }  // \r\n\r\n
    let mut body = str_sub(s, body_start, n);

    // Extract Content-Type to check for multipart
    let mut ctype_pos = str_find(headers, "Content-Type:");
    if ctype_pos < 0 { ctype_pos = str_find(headers, "content-type:"); }
    if ctype_pos >= 0 {
        let mut ct_start = ctype_pos + 13;
        let mut ct_end = str_find(str_sub(headers, ct_start, len(headers)), "\n");
        let mut ctype = "";
        if ct_end > 0 { ctype = str_sub(headers, ct_start, ct_start + ct_end); }
        else { ctype = str_sub(headers, ct_start, len(headers)); }

        // Check for multipart
        if str_find(ctype, "multipart") >= 0 {
            mime_boundary = _mime_extract_boundary(ctype);
            if len(mime_boundary) > 0 {
                // Split body by boundary
                let mut delim = "--" + mime_boundary;
                let mut pos = 0;
                while pos < len(body) {
                    let mut next = str_find(str_sub(body, pos, len(body)), delim);
                    if next < 0 { pos = len(body) + 1; }
                    else {
                        pos = pos + next + len(delim);
                        // Skip \r\n after boundary
                        if pos < len(body) {
                            if str_char_code(body, pos) == 13 { pos = pos + 1; }
                            if pos < len(body) {
                                if str_char_code(body, pos) == 10 { pos = pos + 1; }
                            }
                        }
                        // Find next boundary or end
                        let mut part_end = str_find(str_sub(body, pos, len(body)), delim);
                        if part_end < 0 { part_end = len(body) - pos; }
                        let mut part_text = str_sub(body, pos, pos + part_end);
                        // Split part into headers and body
                        let mut part_hdr_end = str_find(part_text, "\n\n");
                        if part_hdr_end < 0 { part_hdr_end = str_find(part_text, "\r\n\r\n"); }
                        if part_hdr_end >= 0 {
                            let mut part_hdrs = str_sub(part_text, 0, part_hdr_end);
                            let mut part_body_start = part_hdr_end + 2;
                            if str_char_code(part_text, part_hdr_end) == 13 { part_body_start = part_body_start + 2; }
                            let mut part_body = str_sub(part_text, part_body_start, len(part_text));
                            // Store part
                            if mime_part_count_n < MIME_MAX {
                                let mut slot = mime_part_count_n;
                                set_at(mime_part_headers, slot, part_hdrs);
                                set_at(mime_part_bodies,  slot, part_body);
                                set_at(mime_part_ctypes,  slot, "");
                                mime_part_count_n = mime_part_count_n + 1;
                            }
                        }
                        pos = pos + part_end;
                    }
                }
            }
        } else {
            // Single part
            if mime_part_count_n < MIME_MAX {
                set_at(mime_part_headers, 0, headers);
                set_at(mime_part_bodies,  0, body);
                set_at(mime_part_ctypes,  0, ctype);
                mime_part_count_n = 1;
            }
        }
    }
    return mime_part_count_n;
}

// ============================================================
// Load from VFS
// ============================================================

fn mime_load(path) {
    let mut fd = vfs_open(path, 0);
    if fd < 0 { print("mime: cannot open " + path); return 0 - 1; }
    let mut n = vfs_read(fd, MIME_BUF, MIME_BUF_SZ);
    vfs_close(fd);
    if n <= 0 { return 0; }
    let mut text = "";
    let mut i = 0;
    while i < n {
        text = text + str_from_code(mem_read_u8(MIME_BUF + i));
        i = i + 1;
    }
    let mut cnt = mime_parse_str(text);
    print("mime: loaded " + path + " — " + to_string(cnt) + " parts");
    return cnt;
}

// ============================================================
// Dump
// ============================================================

fn mime_list() {
    if mime_part_count_n == 0 { return "(no MIME parts parsed)\n"; }
    let mut out = "MIME parts (" + to_string(mime_part_count_n) + "):\n";
    if len(mime_boundary) > 0 {
        out = out + "  Boundary: " + mime_boundary + "\n";
    }
    let mut i = 0;
    while i < mime_part_count_n {
        out = out + "  Part " + to_string(i) + ":\n";
        let mut body = mime_part_bodies[i];
        let mut body_len = len(body);
        if body_len > 60 {
            out = out + "    Body: " + str_sub(body, 0, 60) + "... (" + to_string(body_len) + " bytes)\n";
        } else {
            out = out + "    Body: " + body + "\n";
        }
        i = i + 1;
    }
    return out;
}

print("mime.hl loaded");
print("MIME: multipart message parser — email/HTTP, boundary extraction, header access");
