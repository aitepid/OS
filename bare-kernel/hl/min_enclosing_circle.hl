// min_enclosing_circle.hl -- Welzl minimum enclosing circle O(n) expected (iter 360)
// Buffer: 0x19F0000
// mec_px/mec_py: point arrays (MEC_MAXN=16)
// mec_cx/mec_cy/mec_cr2: circle center + radius^2 (scaled integers, *1000 for fixed-point)
// Fixed-point: coords stored *1 (integer), distances *1; r stored as r^2 for comparison
// welzl(n, boundary[]): recursively find circle for n points with boundary support points

let mut MEC_MAXN = 16;
let mec_px  = array(16, 0);
let mec_py  = array(16, 0);
let mut mec_n   = 0;

// Result (scaled by 1000)
let mut mec_cx  = 0;
let mut mec_cy  = 0;
let mut mec_cr2 = 0;  // radius^2 * 1000000

// Boundary: at most 3 points
let mec_bx  = array(3, 0);
let mec_by  = array(3, 0);
let mut mec_bn  = 0;

fn mec_init() {
    mec_n  = 0;
    mec_cx = 0;
    mec_cy = 0;
    mec_cr2 = 0;
    return 0;
}

fn mec_add(x, y) {
    set_at(mec_px, mec_n, x);
    set_at(mec_py, mec_n, y);
    mec_n += 1;
    return 0;
}

fn _mec_dist2(ax, ay, bx, by) {
    let dx = ax - bx;
    let dy = ay - by;
    return dx * dx + dy * dy;
}

// Circle from 1 point
fn _mec_c1(ax, ay) {
    mec_cx = ax * 1000;
    mec_cy = ay * 1000;
    mec_cr2 = 0;
    return 0;
}

// Circle from 2 points: center = midpoint
fn _mec_c2(ax, ay, bx, by) {
    mec_cx = (ax + bx) * 500;  // (ax+bx)/2 * 1000
    mec_cy = (ay + by) * 500;
    let dx = ax - bx;
    let dy = ay - by;
    mec_cr2 = (dx * dx + dy * dy) * 250;  // (d^2/4) * 1000
    return 0;
}

// Circle from 3 points (circumcircle): use integer cross product
// Using formula: circumcenter via perpendicular bisectors
// All coordinates * 1000 for fixed-point
fn _mec_c3(ax, ay, bx, by, cx2, cy2) {
    // Translate so a = origin
    let bxr = bx - ax;
    let byr = by - ay;
    let cxr = cx2 - ax;
    let cyr = cy2 - ay;
    // D = 2*(bx*(cy) - by*(cx))
    let D = 2 * (bxr * cyr - byr * cxr);
    if D == 0 {
        // Collinear: use diameter of longest pair
        let d_ab = _mec_dist2(ax, ay, bx, by);
        let d_ac = _mec_dist2(ax, ay, cx2, cy2);
        let d_bc = _mec_dist2(bx, by, cx2, cy2);
        if d_ab >= d_ac {
            if d_ab >= d_bc { _mec_c2(ax, ay, bx, by); }
            else { _mec_c2(bx, by, cx2, cy2); }
        } else {
            if d_ac >= d_bc { _mec_c2(ax, ay, cx2, cy2); }
            else { _mec_c2(bx, by, cx2, cy2); }
        }
        return 0;
    }
    let b2 = bxr * bxr + byr * byr;
    let c2 = cxr * cxr + cyr * cyr;
    // ux = (b2*cy - c2*by) / D
    // uy = (c2*bx - b2*cx) / D
    // Store *1000: ux1000 = (b2*cy - c2*by)*1000 / D
    let ux_num = (b2 * cyr - c2 * byr) * 1000;
    let uy_num = (c2 * bxr - b2 * cxr) * 1000;
    let ux = ux_num / D;
    let uy = uy_num / D;
    mec_cx = ax * 1000 + ux;
    mec_cy = ay * 1000 + uy;
    // r^2 = ux^2 + uy^2 (already scaled *1000000)
    mec_cr2 = ux * ux + uy * uy;
    return 0;
}

fn _mec_from_boundary(bn) {
    if bn == 0 { mec_cx = 0; mec_cy = 0; mec_cr2 = 0; return 0; }
    if bn == 1 { _mec_c1(mec_bx[0], mec_by[0]); return 0; }
    if bn == 2 { _mec_c2(mec_bx[0], mec_by[0], mec_bx[1], mec_by[1]); return 0; }
    _mec_c3(mec_bx[0], mec_by[0], mec_bx[1], mec_by[1], mec_bx[2], mec_by[2]);
    return 0;
}

fn _mec_inside(x, y) {
    // Check if point (x,y) is inside current circle (within r^2 with tolerance +1)
    let dx = x * 1000 - mec_cx;
    let dy = y * 1000 - mec_cy;
    let d2 = dx * dx + dy * dy;
    if d2 <= mec_cr2 + 1000 { return 1; }
    return 0;
}

// Welzl recursive: indices [0..n-1], boundary size mec_bn
fn _mec_welzl(n) {
    if n == 0 {
        _mec_from_boundary(mec_bn);
        return 0;
    }
    if mec_bn == 3 {
        _mec_from_boundary(3);
        return 0;
    }
    // Use last point
    let px_cur = mec_px[n - 1];
    let py_cur = mec_py[n - 1];
    _mec_welzl(n - 1);
    if _mec_inside(px_cur, py_cur) == 0 {
        // Add to boundary
        set_at(mec_bx, mec_bn, px_cur);
        set_at(mec_by, mec_bn, py_cur);
        mec_bn += 1;
        _mec_welzl(n - 1);
        mec_bn -= 1;
    }
    return 0;
}

fn mec_compute() {
    mec_bn = 0;
    _mec_welzl(mec_n);
    return 0;
}

fn mec_test() {
    // Points: (0,0),(4,0),(2,3)
    // Circumcircle center ~(2, 0.833), r^2 ~5.556
    mec_init();
    mec_add(0, 0);
    mec_add(4, 0);
    mec_add(2, 3);
    mec_compute();
    // cx*1000 should be 2000, cy*1000 should be ~833
    let cx_approx = mec_cx / 1000;
    let cy_approx = mec_cy / 1000;
    print("mec_test: cx=" + to_string(cx_approx) + " cy=" + to_string(cy_approx) + " r2=" + to_string(mec_cr2));
    // Test: point (0,0) should be on/inside circle
    if cx_approx == 2 {
        print("mec_test: PASS");
        return 1;
    }
    print("mec_test: FAIL");
    return 0;
}

print("min_enclosing_circle.hl loaded");
