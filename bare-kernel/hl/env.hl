// env.hl -- Environment Variables
//
// POSIX-compatible environment variable store.
// Each task has its own environment (inherited by fork, reset by exec).
//
// Storage: 64 variables max per task, each key=value (64+256 bytes).

let ENV_MAX = 64;
let ENV_KEY_LEN = 64;
let ENV_VAL_LEN = 256;
let ENV_TABLE_ADDR = 9568256;  // 0x920000 -- 64 tasks * 64 vars * 320 bytes

fn env_addr(task_id, index) {
    return ENV_TABLE_ADDR + (task_id * ENV_MAX + index) * (ENV_KEY_LEN + ENV_VAL_LEN);
}

fn env_init_task(task_id) {
    let mut i = 0;
    while i < ENV_MAX {
        mem_write_u8(env_addr(task_id, i), 0);
        i = i + 1;
    }
    env_set(task_id, "HOME", "/root");
    env_set(task_id, "PATH", "/bin:/usr/bin");
    env_set(task_id, "SHELL", "/bin/sh");
    env_set(task_id, "USER", "root");
    env_set(task_id, "TERM", "vt100");
    return 0;
}

fn env_get(task_id, key) {
    let mut i = 0;
    while i < ENV_MAX {
        let mut addr = env_addr(task_id, i);
        let mut stored_key = mem_read_string(addr, ENV_KEY_LEN);
        if stored_key == key {
            return mem_read_string(addr + ENV_KEY_LEN, ENV_VAL_LEN);
        }
        if stored_key == "" { return ""; }
        i = i + 1;
    }
    return "";
}

fn env_set(task_id, key, value) {
    let mut i = 0;
    while i < ENV_MAX {
        let mut addr = env_addr(task_id, i);
        let mut stored_key = mem_read_string(addr, ENV_KEY_LEN);
        if stored_key == key {
            mem_write_string(addr + ENV_KEY_LEN, value);
            return 0;
        }
        if stored_key == "" {
            mem_write_string(addr, key);
            mem_write_string(addr + ENV_KEY_LEN, value);
            return 0;
        }
        i = i + 1;
    }
    return 0 - 1;
}

fn env_unset(task_id, key) {
    let mut i = 0;
    while i < ENV_MAX {
        let mut addr = env_addr(task_id, i);
        if mem_read_string(addr, ENV_KEY_LEN) == key {
            mem_write_u8(addr, 0);
            return 0;
        }
        i = i + 1;
    }
    return 0 - 1;
}

fn env_list(task_id) {
    let mut vars = [];
    let mut i = 0;
    while i < ENV_MAX {
        let mut key = mem_read_string(env_addr(task_id, i), ENV_KEY_LEN);
        if key == "" { return vars; }
        push(vars, key);
        i = i + 1;
    }
    return vars;
}

print("env.hl loaded");
print("Environment: " + to_string(ENV_MAX) + " vars/task, HOME/PATH/SHELL/USER/TERM defaults");
