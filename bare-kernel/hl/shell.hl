        let pst_r = ps_build(pst_n);
        return "pst: root=" + to_string(pst_r);
    }
    if _starts_with(cmd, "pst query ") {
        let pst_args = str_sub(cmd, 10, len(cmd));
        let pst_v = to_int(pst_args);
        let pst_q = ps_query(pst_v, 8, 0, 7);
        return "pst: sum=" + to_string(pst_q);
    }

    if cmd == "rdu init"  { rdu_init(32); return "rdu: init 32"; }
    if cmd == "rdu test"  { let rdut = rdu_test(); return "rdu: " + to_string(rdut); }
    if _starts_with(cmd, "rdu find ") {
        let rdu_x = to_int(str_sub(cmd, 9, len(cmd)));
        return "rdu: find=" + to_string(rdu_find(rdu_x));
    }
    if _starts_with(cmd, "rdu union ") {
        let rdu_args = str_sub(cmd, 10, len(cmd));
        let rdu_a = to_int(rdu_args);
        let rdu_b = to_int(str_sub(rdu_args, 2, len(rdu_args)));
        let rdu_ok = rdu_union(rdu_a, rdu_b);
        return "rdu: union=" + to_string(rdu_ok);
    }
    if _starts_with(cmd, "rdu same ") {
        let rdu_sargs = str_sub(cmd, 9, len(cmd));
        let rdu_sa = to_int(rdu_sargs);
        let rdu_sb = to_int(str_sub(rdu_sargs, 2, len(rdu_sargs)));
        return "rdu: same=" + to_string(rdu_same(rdu_sa, rdu_sb));
    }
    if cmd == "rdu rollback" { let rdu_rb = rdu_rollback(); return "rdu: rollback=" + to_string(rdu_rb); }
    if cmd == "rdu htop"     { return "rdu: h_top=" + to_string(rdu_h_top); }

    return shell_handle(cmd);
}

