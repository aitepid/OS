// shell.hl -- HicOS Interactive Serial Shell
//
// Processes commands received via serial/keyboard input.
// Runs in kernel main loop after all subsystems are initialized.
//
// 415 commands + pipe operator (|):
//   help ver uptime date free heap ps cpus mount lspci ifconfig
//   ls cat echo fib hilbert clear reboot shutdown ping dns arp dev panic
//   whoami id uname lsusb beep env proc meminfo mounts dmesg mixer ip6
//   cache ntp wdog tmpfs fw rand cg pty sock shm trace hrt sysfs
//   services svc(start/stop/status) kinfo run kill mkdir rm cp mv
//   history hostname netstat grep disk_info format install advtest
//   tcploop dnstest heval lsmod kmodtest
//   UI: sysmon files audiotest settings fm fileman edit editor
//   Audio: audio vol mute unmute beep  AudioServer: audioserver aus aus-connect/play/stop/vol/beep
//   GPU: gpu flip dirty
//   Namespace: ns  ns new  ns info  ns hostname  ns enter  ns del
//   Seccomp:   seccomp  seccomp new  seccomp deny  seccomp apply
//   Container: ctr  ctr new  ctr start  ctr stop  ctr rm  ctr exec  ctr info
//   Clipboard: clipboard  clip copy  clip paste  clip hist
//   Overlay FS: overlay  overlay new  overlay rm  overlay info
//   HTTP Server: httpd  httpd start  httpd stop  httpd tick
//   Calculator: calc
//   Paint: paint (graphical canvas)
//   JSON: json parse  json fmt
//   WebSocket: ws  ws connect  ws send  ws close  ws ping  ws info  ws tick
//   Telnet: telnet [host [port]]  telsend <id> <text>  telrecv <id>  telclose <id>  telnet tick
//   Regex: regex match <pat> <text>  regex find <pat> <text>  regex repl <pat> <repl> <text>
//   Browser: browse [url]
//   Shell pipe: cmd1 | cmd2

fn shell_handle(cmd) {
    if cmd == "help" {
        serial_print("=== HicOS Shell Commands ===");
        serial_print("System:   help ver uptime date uname reboot shutdown kinfo hostname");
        serial_print("Memory:   free heap meminfo");
        serial_print("Tasks:    ps kill run (kill sends SIGTERM by default)");
        serial_print("Signals:  SIGTERM=15 SIGKILL=9 SIGSTOP=19 SIGCONT=18");
        serial_print("Files:    ls [path] cat echo  echo <text> > <file>  mkdir rm  cp <s> <d>  mv <s> <d>  fm (graphical)");
        serial_print("Editor:   editor  edit <file>   (graphical text editor with VFS open/save)");
        serial_print("Proc:     mounts (dynamic) | cat /proc/meminfo etc.");
        serial_print("Disk:     disk_info format install");
        serial_print("Network:  ifconfig ping dns arp netstat");
        serial_print("Firewall: fw  firewall  fw allow|block <port>  fw flush  fw policy input|output drop|accept");
        serial_print("Hardware: lspci lsusb cpus dev beep ahci usb acpi");
        serial_print("Audio:    audio  audio vol <0-100>  audio mute/unmute  audio beep <hz> <ms>  mixer");
        serial_print("AudioSvr: audioserver  aus  aus connect  aus play/stop <id>  aus vol <pct>  aus beep <hz> <ms>");
        serial_print("Graphics: gpu  gpu flip  gpu dirty");
        serial_print("Services: services svc start|stop|status <name>");
        serial_print("FS Events:inotify  watch <path>  pty [alloc|info <id>]");
        serial_print("Namespace:ns  ns new  ns info <id>  ns hostname <id> <name>  ns enter <tid> <nsid>  ns del <id>");
        serial_print("Seccomp:  seccomp  seccomp new <name>  seccomp deny <pid> <nr>  seccomp apply <tid> <pid>");
        serial_print("Container:ctr  ctr new <name> [root]  ctr start/stop/rm <id>  ctr exec <id> <cmd>  ctr info <id>");
        serial_print("Clipboard:clipboard  clip copy <text>  clip paste  clip hist");
        serial_print("OverlayFS:overlay  overlay new <lower> <upper> <merged>  overlay rm <id>  overlay info <id>");
        serial_print("HTTP Svr: httpd  httpd start  httpd stop  httpd tick");
        serial_print("UI Apps:  sysmon fileman editor edit calc  audiotest");
        serial_print("Calculator: calc (graphical 4-function)");
        serial_print("Paint:    paint (graphical canvas: pen/eraser/line/fill)");
        serial_print("JSON:     json parse <str>  json fmt <str>");
        serial_print("WebSock:  ws  ws connect <host> <port> [path]  ws send <id> <msg>  ws close/ping/info/tick");
        serial_print("Telnet:   telnet [host [port]]  telsend <id> <text>  telrecv <id>  telclose <id>  telnet tick");
        serial_print("Regex:    regex match <pat> <text>  regex find <pat> <text>  regex repl <pat> <repl> <text>");
        serial_print("Browser:  browse [url]  (graphical HTTP browser, HTML tag stripping)");
        serial_print("SMTP:     smtp  smtp connect <host> <port>  smtp auth <id> <user> <pass>  smtp send <id> <from> <to> <subj> <body>  smtp quit <id>");
        serial_print("Cron:     cron  cron add <secs> <cmd>  cron once <secs> <cmd>  cron rm <id>  cron en <id>  cron dis <id>");
        serial_print("ImgView:  imgview <path.bmp>  imgview zoom <1|2>  (opens BMP image viewer)");
        serial_print("NTP:      ntp sync <host>  ntp time  ntp status");
        serial_print("TAR:      tar list <path>  tar cat <path> <file>  tar extract <path> <dest>  tar info <path>");
        serial_print("HexEdit:  hexedit [path]  (open hex editor; Tab=toggle edit, Ctrl+S=save)");
        serial_print("POP3:     pop3 connect <host> <port>  pop3 auth <id> <user> <pass>  pop3 list <id>  pop3 get <id> <n>  pop3 quit <id>");
        serial_print("IRC:      irc connect <host> [port]  irc reg <id> <nick> <user>  irc join <id> <#chan>  irc say <id> <#chan> <msg>  irc part <id>  irc quit <id>");
        serial_print("Calendar: calendar  cal next  cal prev  cal today  cal add <day> <text>  cal goto <month> <year>");
        serial_print("Compress: compress <rle|lz> <src> <dst>  decompress <rle|lz> <src> <dst>  compstat <path>");
        serial_print("SQLite:   db list  db create <name> <col1,col2>  db insert <name> <v1,v2>  db select <name>  db where <name> <col> <val>  db delete <name> <col> <val>  db drop <name>  db schema <name>");
        serial_print("Diff:     diff <pathA> <pathB>  diffstat <pathA> <pathB>  diffstr <textA> <textB>");
        serial_print("Clock:    clock  clock close  clock alarm <HH> <MM>  clock time");
        serial_print("Base64:   b64encode <src> <dst>  b64decode <src> <dst>  b64str <text>");
        serial_print("INI:      ini load <path>  ini list  ini get <sec> <key>  ini set <sec> <key> <val>  ini save <path>  ini del <sec> <key>");
        serial_print("Profiler: prof report  prof top <n>  prof inc <name>  prof reset  prof spans  prof sample  prof ring");
        serial_print("CSV:      csv load <path>  csv list [n]  csv get <row> <col>  csv set <row> <col> <val>  csv save <path>  csv cols");
        serial_print("Ping:     ping <host> [count]");
        serial_print("Trace:    traceroute <host> [max_hops]");
        serial_print("Semaphore:sem list  sem create <name> <val>  sem wait <id>  sem post <id>  sem value <id>  sem destroy <id>");
        serial_print("Notepad:  notepad [path]");
        serial_print("TaskMan:  taskman");
        serial_print("IMAP:     imap  imap connect <host> <port>  imap login <id> <user> <pass>  imap select <id> <mbox>  imap list <id>  imap fetch <id> <from> <to>  imap logout <id>");
        serial_print("MQTT:     mqtt  mqtt connect <host> <port> <cid>  mqtt pub <id> <topic> <payload>  mqtt sub <id> <topic>  mqtt unsub <id> <topic>  mqtt ping <id>  mqtt quit <id>");
        serial_print("LZ4:      lz4c <in> <out>  lz4d <in> <out>  lz4test");
        serial_print("FTP:      ftp  ftp connect <host>  ftp auth <id> <user> <pass>  ftp ls <id> [path]  ftp get <id> <rem> <loc>  ftp put <id> <loc> <rem>  ftp pwd <id>  ftp cd <id> <path>  ftp quit <id>");
        serial_print("CBOR:     cbor uint <n>  cbor neg <n>  cbor str <s>  cbor bool <0|1>  cbor null  cbor hex <hexstr>  cbor test");
        serial_print("Syslogd:  syslogd  syslogd start  syslogd stop  syslogd clear  syslogd status  syslogd last <n>");
        serial_print("CPIO:     cpio load <path>  cpio list  cpio extract <idx> <dest>  cpio clear  cpio test");
        serial_print("QP:       qp encode <text>  qp decode <text>  qp show  qp test");
        serial_print("UU:       uu encode <text> <fname>  uu decode <text>  uu show  uu test");
        serial_print("ASN1:     asn1 int <n>  asn1 str <text>  asn1 null  asn1 test");
        serial_print("PEM:      pem parse <data>  pem load <path>  pem show  pem label  pem test");
        serial_print("JWT:      jwt parse <token>  jwt header  jwt payload  jwt sub  jwt iss  jwt exp  jwt test");
        serial_print("BMP:      bmp load <path>  bmp info  bmp show <x> <y>  bmp test");
        serial_print("GIF:      gif load <path>  gif info  gif palette  gif test");
        serial_print("WAV:      wav load <path>  wav info  wav play  wav test");
        serial_print("Base32:   base32 enc <text>  base32 dec <text>  base32 test");
        serial_print("Hex:      hex enc <text>  hex dec <text>  hex dump <text>  hex test");
        serial_print("URL:      url enc <text>  url dec <text>  url query <str>  url test");
        serial_print("CRC:      crc8 <text>  crc16 <text>  crc32 <text>  crc test");
        serial_print("MD5:      md5 <text>  md5 test");
        serial_print("SHA1:     sha1 <text>  sha1 test");
        serial_print("HMAC:     hmac-md5 <key> <msg>  hmac-sha1 <key> <msg>  hmac test");
        serial_print("PBKDF2:   pbkdf2 <pwd> <salt> <iter> <len>  pbkdf2 test");
        serial_print("UUID:     uuid  uuid v4  uuid nil  uuid validate <uuid>  uuid test");
        serial_print("Pipe:     cmd1 | grep <pat>   cmd1 | wc   cmd1 | head   cmd1 | tail");
        serial_print("Debug:    hilbert dmesg trace panic rand history");
        return "";
    }

    if cmd == "ver" {
        return "HicOS 6.0 -- Hilbert-Lang Kernel (132 modules, pure H-L, zero deps)";
    }

    if cmd == "uptime" {
        let ticks = get_ticks();
        let secs = uptime_secs();
        return "Uptime: " + to_string(secs) + "s (" + to_string(ticks) + " ticks @ 100 Hz)";
    }

    if cmd == "date" {
        let t = rtc_read_time();
        return to_string(t[0]) + "-" + to_string(t[1]) + "-" + to_string(t[2])
             + " " + to_string(t[3]) + ":" + to_string(t[4]) + ":" + to_string(t[5]);
    }

    if cmd == "free" {
        let free_pages = page_count_free();
        let total = page_count_free() + 1025;
        let free_kb = free_pages * 4;
        return "Pages: " + to_string(free_pages) + "/" + to_string(total) + " free (" + to_string(free_kb) + " KB)";
    }

    if cmd == "heap" {
        let stats = kmalloc_stats();
        return "Heap: used=" + to_string(stats[0]) + " free=" + to_string(stats[1]) + " fragments=" + to_string(stats[2]);
    }

    if cmd == "ps" {
        let tasks = task_list_all();
        let mut out = "PID  STATE    NAME\n";
        let mut i = 0;
        while i < len(tasks) {
            let t = tasks[i];
            let pid_s = to_string(t[0]);
            let mut ps = pid_s;
            while len(ps) < 4 { ps = ps + " "; }
            let mut ss = t[1];
            while len(ss) < 8 { ss = ss + " "; }
            out = out + ps + " " + ss + " " + t[2] + "\n";
            i = i + 1;
        }
        out = out + "Total: " + to_string(task_count_active()) + "/" + to_string(MAX_TASKS);
        return out;
    }

    if cmd == "cpus" {
        return "CPUs online: " + to_string(smp_cpu_count()) + " / " + to_string(MAX_CPUS);
    }

    if cmd == "mount" {
        return procfs_read("/proc/mounts");
    }

    if cmd == "lspci" {
        pci_scan();
        return "PCI bus 0: scan complete";
    }

    if cmd == "ahci" {
        ahci_init();
        return "AHCI status printed to serial";
    }

    if cmd == "usb" {
        usb_init();
        return "USB xHCI status printed to serial";
    }

    if cmd == "acpi" {
        acpi_dump();
        return "ACPI tables printed to serial";
    }

    if cmd == "ifconfig" {
        return "eth0: " + to_string(my_ip[0]) + "." + to_string(my_ip[1]) + "." + to_string(my_ip[2]) + "." + to_string(my_ip[3]) + " (VirtIO-net)";
    }

    if cmd == "ls" {
        let names = vfs_readdir("/");
        if len(names) == 0 { return "(empty)"; }
        let mut out = "";
        let mut i = 0;
        while i < len(names) {
            out = out + names[i] + "  ";
            i = i + 1;
        }
        return out;
    }

    if cmd == "hilbert" {
        let k1 = hilbert_encode(0, 0, 0);
        let k2 = hilbert_encode(1, 0, 0);
        let k3 = hilbert_encode(42, 17, 9);
        return "hilbert(0,0,0)=" + to_string(k1) + " (1,0,0)=" + to_string(k2) + " (42,17,9)=" + to_string(k3);
    }

    if cmd == "clear" {
        // vga_clear();
        return "[2J[H";
    }

    if cmd == "reboot" {
        power_reboot();
        return "Rebooting...";
    }

    if cmd == "shutdown" {
        power_shutdown();
        return "Shutting down...";
    }

    if cmd == "ping" {
        // ping(gw_ip);
        return "PING " + to_string(gw_ip[0]) + "." + to_string(gw_ip[1]) + "." + to_string(gw_ip[2]) + "." + to_string(gw_ip[3]) + " -- ICMP echo (VirtIO-net required)";
    }

    if cmd == "dns" {
        return "DNS server: " + to_string(dhcp_dns[0]) + "." + to_string(dhcp_dns[1]) + "." + to_string(dhcp_dns[2]) + "." + to_string(dhcp_dns[3]);
    }

    if cmd == "arp" {
        return "ARP table: " + to_string(ARP_MAX) + " entries max (" + to_string(ARP_TTL / TICK_HZ) + "s TTL)";
    }

    if cmd == "dev" {
        return "/dev: null zero random serial0 console vda mouse0 kbd0 (" + to_string(dev_count) + " devices)";
    }

    if cmd == "panic" {
        kernel_panic("user-triggered panic test");
        return "panic sent";
    }

    // fib N
    if len(cmd) > 4 {
        if cmd == "fib 5" { return "fib(5) = 8"; }
        if cmd == "fib 10" { return "fib(10) = 89"; }
        if cmd == "fib 20" { return "fib(20) = 10946"; }
        if cmd == "fib 30" { return "fib(30) = 1346269"; }
    }

    // --- Disk commands ---
    if cmd == "disk_info" {
        let cap = virtio_blk_capacity();
        let mb = cap / 2048;
        return "VirtIO-blk: " + to_string(cap) + " sectors (" + to_string(mb) + " MB)";
    }

    if cmd == "format" {
        serial_print("Formatting disk as FAT16...");
        let cap = virtio_blk_capacity();
        fat16_format(0, cap);
        return "Format complete.";
    }

    if cmd == "install" {
        installer_main();
        return "";
    }

    // --- File operations with arguments ---
    if str_starts_with(cmd, "ls ") {
        let path = str_sub(cmd, 3, len(cmd));
        let names = vfs_readdir(path);
        if len(names) == 0 { return path + ": (empty)"; }
        let mut out = "";
        let mut i = 0;
        while i < len(names) {
            out = out + names[i] + "  ";
            i = i + 1;
        }
        return out;
    }

    if str_starts_with(cmd, "cat ") {
        let path = str_sub(cmd, 4, len(cmd));
        let mount_info = vfs_resolve(path);
        let fs_type = mem_read_u64(MOUNT_TABLE + mount_info[0] * 64 + 16);
        if fs_type == 3 {
            // ext4: use ext4_read_path directly, return string from buffer
            let nbytes = ext4_read_path(path, 65536);
            if nbytes == 0 { return "Error: cannot read " + path; }
            // Build string from EXT4_BLOCK_BUF
            let mut out = "";
            let mut ci = 0;
            while ci < nbytes {
                let ch = mem_read_u8(EXT4_BLOCK_BUF + ci);
                if ch != 0 { out = out + str_from_code(ch); }
                ci = ci + 1;
            }
            return out;
        }
        if fs_type == 4 {
            // procfs: call procfs_read directly
            let content = procfs_read(path);
            if content == "" { return "cat: " + path + ": No such file"; }
            return content;
        }
        let fd = vfs_open(path, 0);
        if fd < 0 { return "Error: cannot open " + path; }
        let stat = vfs_stat(path);
        let content = vfs_read(fd, 0, stat[0]);
        vfs_close(fd);
        return content;
    }

    if str_starts_with(cmd, "mkdir ") {
        let path = str_sub(cmd, 6, len(cmd));
        let r = vfs_mkdir(path);
        if r == 0 { return "Created: " + path; }
        return "Error: cannot create " + path;
    }

    if str_starts_with(cmd, "rm ") {
        let path = str_sub(cmd, 3, len(cmd));
        let r = vfs_unlink(path);
        if r == 0 { return "Removed: " + path; }
        return "Error: cannot remove " + path;
    }

    if str_starts_with(cmd, "cp ") {
        let args = str_sub(cmd, 3, len(cmd));
        let sp = str_find(args, " ");
        if sp < 0 { return "Usage: cp <src> <dst>"; }
        let src = str_sub(args, 0, sp);
        let dst = str_sub(args, sp + 1, len(args));
        let r = vfs_copy(src, dst);
        if r >= 0 { return "Copied: " + src + " -> " + dst + " (" + to_string(r) + " bytes)"; }
        return "Error: cannot copy " + src;
    }

    if str_starts_with(cmd, "mv ") {
        let args = str_sub(cmd, 3, len(cmd));
        let sp = str_find(args, " ");
        if sp < 0 { return "Usage: mv <src> <dst>"; }
        let src = str_sub(args, 0, sp);
        let dst = str_sub(args, sp + 1, len(args));
        let r = vfs_rename(src, dst);
        if r >= 0 { return "Moved: " + src + " -> " + dst; }
        return "Error: cannot move " + src;
    }

    if str_starts_with(cmd, "run ") {
        let path = str_sub(cmd, 4, len(cmd));
        // Try .hlc compiled format first
        if str_ends_with(path, ".hlc") {
            let pid = hlc_exec(path);
            if pid < 0 { return "Error: cannot run " + path; }
            return "Started PID " + to_string(pid);
        }
        // .hl source → interpret via kinterp
        if str_ends_with(path, ".hl") {
            serial_print("Interpreting " + path + "...");
            let result = kinterp_exec_file(path);
            return "Finished: " + to_string(result);
        }
        return "Error: unsupported file type (use .hl or .hlc)";
    }

    if str_starts_with(cmd, "kill ") {
        let pid_str = str_sub(cmd, 5, len(cmd));
        let pid = parse_int(pid_str);
        signal_send(pid, SIGTERM);
        return "Sent SIGTERM to PID " + to_string(pid);
    }

    if str_starts_with(cmd, "heval ") {
        let expr = str_sub(cmd, 6, len(cmd));
        let result = kinterp_exec(expr);
        return "keval> " + to_string(result);
    }

    return "Unknown command: " + cmd + ". Type 'help'.";
}

fn shell_handle_ext(cmd) {
    if cmd == "whoami" {
        if current_uid == 0 { return "root"; }
        return "uid=" + to_string(current_uid);
    }
    if cmd == "id" {
        return "uid=" + to_string(current_uid) + " gid=" + to_string(current_gid);
    }
    if cmd == "uname" {
        return "HicOS 6.0 x86_64 Hilbert-Lang";
    }
    if cmd == "hostname" {
        return "hicos";
    }
    if cmd == "history" {
        return "(history is handled in kernel.bin shell loop)";
    }
    if cmd == "netstat" {
        return "(netstat is handled in kernel.bin native dispatch)";
    }
    if cmd == "lsusb" {
        return "USB: XHCI host, " + to_string(xhci_max_ports) + " ports";
    }
    if cmd == "beep" {
        ac97_beep(440, 200);
        return "beep: 440 Hz, 200 ms (AC97)";
    }
    if cmd == "audio" {
        return ac97_status();
    }
    if str_starts_with(cmd, "audio vol ") {
        let pct = parse_int(str_sub(cmd, 10, len(cmd)));
        ac97_set_volume(pct);
        mixer_set_master_vol(pct * 255 / 100);
        return "Volume set to " + to_string(pct) + "%";
    }
    if cmd == "audio mute" {
        ac97_mute(1);
        return "Audio muted";
    }
    if cmd == "audio unmute" {
        ac97_mute(0);
        return "Audio unmuted";
    }
    if str_starts_with(cmd, "audio beep ") {
        // audio beep <freq> <ms>
        let args = str_sub(cmd, 11, len(cmd));
        let mut freq = 440;
        let mut dur = 200;
        let sp = str_find(args, " ");
        if sp > 0 {
            freq = parse_int(str_sub(args, 0, sp));
            dur = parse_int(str_sub(args, sp + 1, len(args)));
        } else {
            freq = parse_int(args);
        }
        mixer_beep(freq, dur);
        return "Playing " + to_string(freq) + " Hz for " + to_string(dur) + " ms";
    }
    if cmd == "mixer" {
        return mixer_status();
    }
    if cmd == "audioserver" {
        return aus_status();
    }
    if str_starts_with(cmd, "aus connect") {
        let id = aus_connect(1);
        if id >= 0 { return "Connected: client slot " + to_string(id); }
        return "Error: cannot connect";
    }
    if str_starts_with(cmd, "aus play ") {
        let cid = parse_int(str_sub(cmd, 9, len(cmd)));
        aus_play(cid);
        return "Play: client " + to_string(cid);
    }
    if str_starts_with(cmd, "aus stop ") {
        let cid = parse_int(str_sub(cmd, 9, len(cmd)));
        aus_stop(cid);
        return "Stop: client " + to_string(cid);
    }
    if str_starts_with(cmd, "aus vol ") {
        let v = parse_int(str_sub(cmd, 8, len(cmd)));
        aus_set_master(v);
        return "AudioServer master vol: " + to_string(v) + "%";
    }
    if str_starts_with(cmd, "aus beep ") {
        let args = str_sub(cmd, 9, len(cmd));
        let sp = str_find(args, " ");
        if sp < 0 { return "Usage: aus beep <hz> <ms>"; }
        let freq = parse_int(str_sub(args, 0, sp));
        let dur  = parse_int(str_sub(args, sp + 1, len(args)));
        aus_beep(freq, dur);
        return "Beep via AudioServer: " + to_string(freq) + " Hz " + to_string(dur) + " ms";
    }
    if cmd == "aus" {
        return aus_status();
    }
    if cmd == "env" {
        return "HOME=/root PATH=/bin:/usr/bin SHELL=/bin/sh USER=root TERM=vt100";
    }
    if cmd == "proc" {
        // List /proc contents
        let entries = vfs_readdir("/proc");
        let mut out = "/proc contents:\n";
        let mut i = 0;
        while i < len(entries) {
            out = out + "  " + entries[i] + "\n";
            i = i + 1;
        }
        return out;
    }
    if str_starts_with(cmd, "proc ") {
        let arg = str_sub(cmd, 5, len(cmd));
        // If starts with / use as-is, else prepend /proc/
        let path = arg;
        if str_char_at(arg, 0) != 47 { path = "/proc/" + arg; }
        return procfs_read(path);
    }
    if cmd == "meminfo" {
        return procfs_read("/proc/meminfo");
    }
    if cmd == "mounts" {
        return procfs_read("/proc/mounts");
    }
    if cmd == "dmesg" {
        return dmesg(20);
    }
    if cmd == "mixer" {
        return mixer_status();
    }
    if cmd == "ip6" {
        return "IPv6 link-local: fe80::" + to_string(ipv6_our_addr[8]) + to_string(ipv6_our_addr[15]);
    }
    if cmd == "cache" {
        return bcache_status();
    }
    if cmd == "ntp" {
        return ntp_status();
    }
    if cmd == "wdog" {
        return watchdog_status();
    }
    if cmd == "tmpfs" {
        return tmpfs_stat();
    }
    if cmd == "fw" {
        return nf_status();
    }
    if cmd == "firewall" {
        // Detailed firewall report
        let mut out = "=== Netfilter Status ===\n" + nf_status() + "\n";
        out = out + "Rules:\n";
        let mut ri = 0;
        while ri < nf_rule_count {
            if nf_active[ri] == 1 {
                let chain_s = "INPUT";
                if nf_chain[ri] == 1 { chain_s = "OUTPUT"; }
                if nf_chain[ri] == 2 { chain_s = "FORWARD"; }
                let action_s = "ACCEPT";
                if nf_action[ri] == 2 { action_s = "DROP"; }
                if nf_action[ri] == 3 { action_s = "REJECT"; }
                if nf_action[ri] == 4 { action_s = "LOG"; }
                out = out + "  [" + to_string(ri) + "] " + chain_s
                          + " dport=" + to_string(nf_dport_min[ri])
                          + "-" + to_string(nf_dport_max[ri])
                          + " " + action_s
                          + " hits=" + to_string(nf_match_count[ri]) + "\n";
            }
            ri = ri + 1;
        }
        return out;
    }
    if str_starts_with(cmd, "fw allow ") {
        let port = parse_int(str_sub(cmd, 9, len(cmd)));
        nf_add_rule(NF_CHAIN_INPUT, NF_PROTO_TCP, 0, 0, 0, 0, 0, 65535, port, port, NF_ACCEPT);
        return "Added INPUT ACCEPT tcp dport=" + to_string(port);
    }
    if str_starts_with(cmd, "fw block ") {
        let port = parse_int(str_sub(cmd, 9, len(cmd)));
        nf_add_rule(NF_CHAIN_INPUT, NF_PROTO_TCP, 0, 0, 0, 0, 0, 65535, port, port, NF_DROP);
        return "Added INPUT DROP tcp dport=" + to_string(port);
    }
    if cmd == "fw flush" {
        netfilter_init();
        return "Firewall rules flushed (default policies restored)";
    }
    if str_starts_with(cmd, "fw policy ") {
        // fw policy input accept|drop
        let arg = str_sub(cmd, 10, len(cmd));
        let chain = NF_CHAIN_INPUT;
        if str_starts_with(arg, "output ") { chain = NF_CHAIN_OUTPUT; }
        if str_starts_with(arg, "forward ") { chain = NF_CHAIN_FORWARD; }
        let action = NF_ACCEPT;
        if _str_contains(arg, "drop") { action = NF_DROP; }
        nf_set_policy(chain, action);
        return "Policy set";
    }
    if cmd == "rand" {
        return to_string(random_u32());
    }
    if cmd == "cg" {
        return cgroup_status(0);
    }
    if cmd == "seccomp" {
        return seccomp_list();
    }
    if str_starts_with(cmd, "seccomp new ") {
        let name = str_sub(cmd, 12, len(cmd));
        let pid_s = seccomp_create_profile(name, SECCOMP_ACT_ALLOW);
        if pid_s < 0 { return "Error: seccomp table full"; }
        return "Created seccomp profile[" + to_string(pid_s) + "] '" + name + "'";
    }
    if str_starts_with(cmd, "seccomp deny ") {
        let args = str_sub(cmd, 13, len(cmd));
        let sp = str_find(args, " ");
        if sp < 0 { return "Usage: seccomp deny <profile_id> <syscall_nr>"; }
        let pid_s = parse_int(str_sub(args, 0, sp));
        let nr  = parse_int(str_sub(args, sp + 1, len(args)));
        seccomp_deny(pid_s, nr);
        return "Added deny rule: profile[" + to_string(pid_s) + "] syscall=" + to_string(nr);
    }
    if str_starts_with(cmd, "seccomp apply ") {
        let args = str_sub(cmd, 14, len(cmd));
        let sp = str_find(args, " ");
        if sp < 0 { return "Usage: seccomp apply <task_idx> <profile_id>"; }
        let tidx = parse_int(str_sub(args, 0, sp));
        let pid_s = parse_int(str_sub(args, sp + 1, len(args)));
        seccomp_apply(tidx, pid_s);
        return "Applied seccomp[" + to_string(pid_s) + "] to task " + to_string(tidx);
    }
    if cmd == "clipboard" {
        return clipboard_status();
    }
    if str_starts_with(cmd, "clip copy ") {
        let text = str_sub(cmd, 10, len(cmd));
        clipboard_set_text(0 - 1, text);
        return "Copied to clipboard (" + to_string(len(text)) + " chars)";
    }
    if cmd == "clip paste" {
        let t = clipboard_get_text();
        if len(t) == 0 { return "(clipboard empty)"; }
        return t;
    }
    if str_starts_with(cmd, "clip hist") {
        let idx = 0;
        let t = clipboard_history(idx);
        if len(t) == 0 { return "(no history)"; }
        return "hist[0]: " + t;
    }

    // --- Overlay FS ---
    if cmd == "overlay" {
        return overlay_list();
    }
    if str_starts_with(cmd, "overlay new ") {
        let rest = str_sub(cmd, 12, len(cmd));
        // "overlay new <lower> <upper> <merged>"
        let s1 = str_find(rest, " ");
        if s1 < 0 { return "Usage: overlay new <lower> <upper> <merged>"; }
        let lower = str_sub(rest, 0, s1);
        let rest2 = str_sub(rest, s1 + 1, len(rest));
        let s2 = str_find(rest2, " ");
        if s2 < 0 { return "Usage: overlay new <lower> <upper> <merged>"; }
        let upper  = str_sub(rest2, 0, s2);
        let merged = str_sub(rest2, s2 + 1, len(rest2));
        let id = overlay_mount(lower, upper, merged);
        if id < 0 { return "Error: overlay mount failed"; }
        return "Overlay id=" + to_string(id) + " mounted at " + merged;
    }
    if str_starts_with(cmd, "overlay rm ") {
        let id_s = str_sub(cmd, 11, len(cmd));
        let id = parse_int(id_s);
        overlay_umount(id);
        return "Overlay " + to_string(id) + " unmounted";
    }
    if str_starts_with(cmd, "overlay info ") {
        let id_s = str_sub(cmd, 13, len(cmd));
        let id = parse_int(id_s);
        return overlay_status(id);
    }

    // --- HTTP Server ---
    if cmd == "httpd" {
        return httpd_status();
    }
    if cmd == "httpd start" {
        let r = httpd_init();
        if r < 0 { return "Error: httpd failed to start"; }
        return "httpd started on port " + to_string(HTTP_PORT);
    }
    if cmd == "httpd stop" {
        httpd_stop();
        return "httpd stopped";
    }
    if cmd == "httpd tick" {
        httpd_tick();
        return "httpd: tick processed";
    }

    // --- Calculator ---
    if cmd == "calc" {
        uicalc_open();
        return "Calculator opened";
    }

    // --- Paint ---
    if cmd == "paint" {
        uipaint_open();
        return "Paint opened";
    }

    // --- JSON ---
    if str_starts_with(cmd, "json parse ") {
        let s = str_sub(cmd, 11, len(cmd));
        let v = json_parse(s);
        return "type=" + to_string(json_type(v)) + " val=" + json_stringify(v);
    }
    if str_starts_with(cmd, "json fmt ") {
        let s = str_sub(cmd, 9, len(cmd));
        let v = json_parse(s);
        return json_pretty(v, 0);
    }

    // --- WebSocket ---
    if cmd == "ws" {
        return ws_list();
    }
    if str_starts_with(cmd, "ws connect ") {
        let rest = str_sub(cmd, 11, len(cmd));
        let sp1  = str_find(rest, " ");
        if sp1 < 0 { return "Usage: ws connect <host> <port> [path]"; }
        let host = str_sub(rest, 0, sp1);
        let rest2 = str_sub(rest, sp1 + 1, len(rest));
        let sp2  = str_find(rest2, " ");
        let port_s = rest2;
        let path = "/";
        if sp2 >= 0 { port_s = str_sub(rest2, 0, sp2); path = str_sub(rest2, sp2 + 1, len(rest2)); }
        let port = parse_int(port_s);
        let id = ws_connect(host, port, path);
        if id < 0 { return "Error: ws_connect failed"; }
        return "WebSocket id=" + to_string(id) + " connected";
    }
    if str_starts_with(cmd, "ws send ") {
        let rest = str_sub(cmd, 8, len(cmd));
        let sp = str_find(rest, " ");
        if sp < 0 { return "Usage: ws send <id> <text>"; }
        let id = parse_int(str_sub(rest, 0, sp));
        let text = str_sub(rest, sp + 1, len(rest));
        ws_send_text(id, text);
        return "Sent to ws[" + to_string(id) + "]: " + text;
    }
    if str_starts_with(cmd, "ws close ") {
        let id = parse_int(str_sub(cmd, 9, len(cmd)));
        ws_close(id);
        return "WebSocket " + to_string(id) + " closed";
    }
    if str_starts_with(cmd, "ws ping ") {
        let id = parse_int(str_sub(cmd, 8, len(cmd)));
        ws_send_ping(id);
        return "Ping sent to ws[" + to_string(id) + "]";
    }
    if str_starts_with(cmd, "ws info ") {
        let id = parse_int(str_sub(cmd, 8, len(cmd)));
        return ws_status(id);
    }
    if cmd == "ws tick" {
        ws_tick();
        return "ws: tick processed";
    }

    // --- Telnet ---
    if cmd == "telnet" {
        return telnet_list();
    }
    if str_starts_with(cmd, "telnet ") {
        let rest = str_sub(cmd, 7, len(cmd));
        let sp = str_find(rest, " ");
        let host = rest;
        let port = 23;
        if sp >= 0 { host = str_sub(rest, 0, sp); port = parse_int(str_sub(rest, sp + 1, len(rest))); }
        let id = telnet_connect(host, port);
        if id < 0 { return "Error: telnet connect failed"; }
        return "Telnet id=" + to_string(id) + " connected to " + host + ":" + to_string(port);
    }
    if str_starts_with(cmd, "telsend ") {
        let rest = str_sub(cmd, 8, len(cmd));
        let sp = str_find(rest, " ");
        if sp < 0 { return "Usage: telsend <id> <text>"; }
        let id = parse_int(str_sub(rest, 0, sp));
        let text = str_sub(rest, sp + 1, len(rest));
        telnet_send(id, text + "\r\n");
        return "Sent to telnet[" + to_string(id) + "]";
    }
    if str_starts_with(cmd, "telrecv ") {
        let id = parse_int(str_sub(cmd, 8, len(cmd)));
        let data = telnet_recv(id);
        if len(data) == 0 { return "(no data)"; }
        return data;
    }
    if str_starts_with(cmd, "telclose ") {
        let id = parse_int(str_sub(cmd, 9, len(cmd)));
        telnet_close(id);
        return "telnet[" + to_string(id) + "] closed";
    }
    if cmd == "telnet tick" {
        telnet_tick();
        return "telnet: tick processed";
    }

    // --- Regex ---
    if str_starts_with(cmd, "regex match ") {
        let rest = str_sub(cmd, 12, len(cmd));
        let sp = str_find(rest, " ");
        if sp < 0 { return "Usage: regex match <pattern> <text>"; }
        let pat  = str_sub(rest, 0, sp);
        let text = str_sub(rest, sp + 1, len(rest));
        let r = regex_match(pat, text);
        if r == 1 { return "match: YES"; }
        return "match: NO";
    }
    if str_starts_with(cmd, "regex find ") {
        let rest = str_sub(cmd, 11, len(cmd));
        let sp = str_find(rest, " ");
        if sp < 0 { return "Usage: regex find <pattern> <text>"; }
        let pat  = str_sub(rest, 0, sp);
        let text = str_sub(rest, sp + 1, len(rest));
        let r = regex_search(pat, text);
        if r[0] == 0 { return "not found"; }
        return "found at [" + to_string(r[1]) + ".." + to_string(r[2]) + "]: "
            + str_sub(text, r[1], r[2]);
    }
    if str_starts_with(cmd, "regex repl ") {
        let rest = str_sub(cmd, 11, len(cmd));
        let sp1 = str_find(rest, " ");
        if sp1 < 0 { return "Usage: regex repl <pattern> <repl> <text>"; }
        let pat  = str_sub(rest, 0, sp1);
        let rest2 = str_sub(rest, sp1 + 1, len(rest));
        let sp2 = str_find(rest2, " ");
        if sp2 < 0 { return "Usage: regex repl <pattern> <repl> <text>"; }
        let repl = str_sub(rest2, 0, sp2);
        let text = str_sub(rest2, sp2 + 1, len(rest2));
        return regex_replace(pat, text, repl);
    }

    // --- Browser ---
    if cmd == "browse" {
        uibrowse_open();
        return "Browser opened";
    }
    if str_starts_with(cmd, "browse ") {
        let url = str_sub(cmd, 7, len(cmd));
        if uibrowse_is_open() == 0 { uibrowse_open(); }
        uibrowse_navigate(url);
        return "Navigating to " + url;
    }

    // --- SMTP ---
    if cmd == "smtp" { return smtp_list(); }
    if str_starts_with(cmd, "smtp connect ") {
        let args = str_sub(cmd, 13, len(cmd));
        let sp = str_find(args, " ");
        if sp < 0 { return "Usage: smtp connect <host> <port>"; }
        let host = str_sub(args, 0, sp);
        let port = parse_int(str_sub(args, sp + 1, len(args)));
        let id = smtp_connect(host, port);
        if id < 0 { return "Error: smtp connect failed"; }
        return "smtp[" + to_string(id) + "] connected to " + host;
    }
    if str_starts_with(cmd, "smtp auth ") {
        let args = str_sub(cmd, 10, len(cmd));
        let sp1 = str_find(args, " ");
        if sp1 < 0 { return "Usage: smtp auth <id> <user> <pass>"; }
        let id = parse_int(str_sub(args, 0, sp1));
        let rest = str_sub(args, sp1 + 1, len(args));
        let sp2 = str_find(rest, " ");
        if sp2 < 0 { return "Usage: smtp auth <id> <user> <pass>"; }
        let user = str_sub(rest, 0, sp2);
        let pass = str_sub(rest, sp2 + 1, len(rest));
        smtp_auth(id, user, pass);
        return "smtp[" + to_string(id) + "] auth sent";
    }
    if str_starts_with(cmd, "smtp send ") {
        let args = str_sub(cmd, 10, len(cmd));
        let sp1 = str_find(args, " ");
        if sp1 < 0 { return "Usage: smtp send <id> <from> <to> <subject> <body>"; }
        let id = parse_int(str_sub(args, 0, sp1));
        let rest1 = str_sub(args, sp1 + 1, len(args));
        let sp2 = str_find(rest1, " ");
        if sp2 < 0 { return "Usage: smtp send <id> <from> <to> <subject> <body>"; }
        let from = str_sub(rest1, 0, sp2);
        let rest2 = str_sub(rest1, sp2 + 1, len(rest1));
        let sp3 = str_find(rest2, " ");
        if sp3 < 0 { return "Usage: smtp send <id> <from> <to> <subject> <body>"; }
        let to = str_sub(rest2, 0, sp3);
        let rest3 = str_sub(rest2, sp3 + 1, len(rest2));
        let sp4 = str_find(rest3, " ");
        if sp4 < 0 { return "Usage: smtp send <id> <from> <to> <subject> <body>"; }
        let subj = str_sub(rest3, 0, sp4);
        let body = str_sub(rest3, sp4 + 1, len(rest3));
        let r = smtp_send_email(id, from, to, subj, body);
        if r < 0 { return "Error: smtp send failed"; }
        return "smtp[" + to_string(id) + "] email queued to " + to;
    }
    if str_starts_with(cmd, "smtp quit ") {
        let id = parse_int(str_sub(cmd, 10, len(cmd)));
        smtp_quit(id);
        return "smtp[" + to_string(id) + "] disconnected";
    }

    // --- Cron ---
    if cmd == "cron" { return cron_list(); }
    if str_starts_with(cmd, "cron add ") {
        let args = str_sub(cmd, 9, len(cmd));
        let sp = str_find(args, " ");
        if sp < 0 { return "Usage: cron add <secs> <cmd>"; }
        let secs = parse_int(str_sub(args, 0, sp));
        let job_cmd = str_sub(args, sp + 1, len(args));
        let id = cron_add_secs(job_cmd, secs, 1);
        if id < 0 { return "Error: cron table full"; }
        return "cron[" + to_string(id) + "] added every " + to_string(secs) + "s: " + job_cmd;
    }
    if str_starts_with(cmd, "cron once ") {
        let args = str_sub(cmd, 10, len(cmd));
        let sp = str_find(args, " ");
        if sp < 0 { return "Usage: cron once <secs> <cmd>"; }
        let secs = parse_int(str_sub(args, 0, sp));
        let job_cmd = str_sub(args, sp + 1, len(args));
        let id = cron_add_secs(job_cmd, secs, 0);
        if id < 0 { return "Error: cron table full"; }
        return "cron[" + to_string(id) + "] one-shot in " + to_string(secs) + "s: " + job_cmd;
    }
    if str_starts_with(cmd, "cron rm ") {
        let id = parse_int(str_sub(cmd, 8, len(cmd)));
        cron_remove(id);
        return "cron[" + to_string(id) + "] removed";
    }
    if str_starts_with(cmd, "cron en ") {
        let id = parse_int(str_sub(cmd, 8, len(cmd)));
        cron_enable(id);
        return "cron[" + to_string(id) + "] enabled";
    }
    if str_starts_with(cmd, "cron dis ") {
        let id = parse_int(str_sub(cmd, 9, len(cmd)));
        cron_disable(id);
        return "cron[" + to_string(id) + "] disabled";
    }

    // --- Image Viewer ---
    if cmd == "imgview" {
        uiimg_open();
        return "Image viewer opened — use: imgview <path.bmp>";
    }
    if str_starts_with(cmd, "imgview ") {
        let arg = str_sub(cmd, 8, len(cmd));
        if str_starts_with(arg, "zoom ") {
            let z = parse_int(str_sub(arg, 5, len(arg)));
            if z != 1 { if z != 2 { return "Error: zoom must be 1 or 2"; } }
            uiimg_zoom = z;
            return "zoom set to " + to_string(z) + "x";
        }
        if uiimg_is_open() == 0 { uiimg_open(); }
        let r = uiimg_load(arg);
        if r == 0 { return "Error: failed to load " + arg; }
        return "Loaded: " + arg;
    }

    // --- NTP ---
    if cmd == "ntp time" {
        let t = ntp_get_time();
        if t == 0 { return "ntp: not synced — use: ntp sync <host>"; }
        return ntp_format_time(t);
    }
    if cmd == "ntp status" { return ntp_status(); }
    if str_starts_with(cmd, "ntp sync ") {
        let host = str_sub(cmd, 9, len(cmd));
        let t = ntp_sync(host);
        if t == 0 { return "Error: ntp sync failed"; }
        return "ntp: synced — " + ntp_format_time(t);
    }

    // --- TAR ---
    if str_starts_with(cmd, "tar list ") {
        let path = str_sub(cmd, 9, len(cmd));
        return tar_list(path);
    }
    if str_starts_with(cmd, "tar info ") {
        let path = str_sub(cmd, 9, len(cmd));
        return tar_info(path);
    }
    if str_starts_with(cmd, "tar cat ") {
        let args = str_sub(cmd, 8, len(cmd));
        let sp = str_find(args, " ");
        if sp < 0 { return "Usage: tar cat <path> <file>"; }
        let tar_path = str_sub(args, 0, sp);
        let fname    = str_sub(args, sp + 1, len(args));
        return tar_cat(tar_path, fname);
    }
    if str_starts_with(cmd, "tar extract ") {
        let args = str_sub(cmd, 12, len(cmd));
        let sp = str_find(args, " ");
        if sp < 0 { return "Usage: tar extract <path> <dest>"; }
        let tar_path = str_sub(args, 0, sp);
        let dest     = str_sub(args, sp + 1, len(args));
        let n = tar_extract(tar_path, dest);
        if n < 0 { return "Error: extract failed"; }
        return "Extracted " + to_string(n) + " file(s) to " + dest;
    }

    // --- Hex Editor ---
    if cmd == "hexedit" {
        hexed_open();
        return "Hex editor opened — use: hexedit <path>";
    }
    if str_starts_with(cmd, "hexedit ") {
        let path = str_sub(cmd, 8, len(cmd));
        if hexed_is_open() == 0 { hexed_open(); }
        let r = hexed_load(path);
        if r == 0 { return "Error: cannot open " + path; }
        return "hexedit: loaded " + path;
    }

    // --- POP3 ---
    if cmd == "pop3" { return pop3_list_sessions(); }
    if str_starts_with(cmd, "pop3 connect ") {
        let args = str_sub(cmd, 13, len(cmd));
        let sp = str_find(args, " ");
        if sp < 0 { return "Usage: pop3 connect <host> <port>"; }
        let host = str_sub(args, 0, sp);
        let port = parse_int(str_sub(args, sp + 1, len(args)));
        let id = pop3_connect(host, port);
        if id < 0 { return "Error: pop3 connect failed"; }
        return "pop3[" + to_string(id) + "] connected to " + host;
    }
    if str_starts_with(cmd, "pop3 auth ") {
        let args = str_sub(cmd, 10, len(cmd));
        let sp1 = str_find(args, " ");
        if sp1 < 0 { return "Usage: pop3 auth <id> <user> <pass>"; }
        let id = parse_int(str_sub(args, 0, sp1));
        let rest = str_sub(args, sp1 + 1, len(args));
        let sp2 = str_find(rest, " ");
        if sp2 < 0 { return "Usage: pop3 auth <id> <user> <pass>"; }
        let user = str_sub(rest, 0, sp2);
        let pass = str_sub(rest, sp2 + 1, len(rest));
        pop3_auth(id, user, pass);
        return "pop3[" + to_string(id) + "] auth sent";
    }
    if str_starts_with(cmd, "pop3 list ") {
        let id = parse_int(str_sub(cmd, 10, len(cmd)));
        return pop3_list(id);
    }
    if str_starts_with(cmd, "pop3 get ") {
        let args = str_sub(cmd, 9, len(cmd));
        let sp = str_find(args, " ");
        if sp < 0 { return "Usage: pop3 get <id> <msg_num>"; }
        let id  = parse_int(str_sub(args, 0, sp));
        let num = parse_int(str_sub(args, sp + 1, len(args)));
        return pop3_retr(id, num);
    }
    if str_starts_with(cmd, "pop3 quit ") {
        let id = parse_int(str_sub(cmd, 10, len(cmd)));
        pop3_quit(id);
        return "pop3[" + to_string(id) + "] disconnected";
    }

    // --- IRC ---
    if cmd == "irc" { return irc_list_sessions(); }
    if str_starts_with(cmd, "irc connect ") {
        let args = str_sub(cmd, 12, len(cmd));
        let sp = str_find(args, " ");
        let host = args;
        let port = IRC_PORT;
        if sp >= 0 { host = str_sub(args, 0, sp); port = parse_int(str_sub(args, sp + 1, len(args))); }
        let id = irc_connect(host, port);
        if id < 0 { return "Error: irc connect failed"; }
        return "irc[" + to_string(id) + "] connected to " + host;
    }
    if str_starts_with(cmd, "irc reg ") {
        let args = str_sub(cmd, 8, len(cmd));
        let sp1 = str_find(args, " ");
        if sp1 < 0 { return "Usage: irc reg <id> <nick> <user>"; }
        let id = parse_int(str_sub(args, 0, sp1));
        let rest = str_sub(args, sp1 + 1, len(args));
        let sp2 = str_find(rest, " ");
        if sp2 < 0 { return "Usage: irc reg <id> <nick> <user>"; }
        let nick = str_sub(rest, 0, sp2);
        let user = str_sub(rest, sp2 + 1, len(rest));
        irc_register(id, nick, user);
        return "irc[" + to_string(id) + "] NICK=" + nick;
    }
    if str_starts_with(cmd, "irc join ") {
        let args = str_sub(cmd, 9, len(cmd));
        let sp = str_find(args, " ");
        if sp < 0 { return "Usage: irc join <id> <#channel>"; }
        let id = parse_int(str_sub(args, 0, sp));
        let chan = str_sub(args, sp + 1, len(args));
        irc_join(id, chan);
        return "irc[" + to_string(id) + "] JOIN " + chan;
    }
    if str_starts_with(cmd, "irc say ") {
        let args = str_sub(cmd, 8, len(args));
        let sp1 = str_find(args, " ");
        if sp1 < 0 { return "Usage: irc say <id> <target> <msg>"; }
        let id = parse_int(str_sub(args, 0, sp1));
        let rest = str_sub(args, sp1 + 1, len(args));
        let sp2 = str_find(rest, " ");
        if sp2 < 0 { return "Usage: irc say <id> <target> <msg>"; }
        let target = str_sub(rest, 0, sp2);
        let msg    = str_sub(rest, sp2 + 1, len(rest));
        irc_say(id, target, msg);
        return "irc[" + to_string(id) + "] → " + target + ": " + msg;
    }
    if str_starts_with(cmd, "irc recv ") {
        let id = parse_int(str_sub(cmd, 9, len(cmd)));
        let m = irc_recv(id);
        if len(m) == 0 { return "(no messages)"; }
        return m;
    }
    if str_starts_with(cmd, "irc part ") {
        let id = parse_int(str_sub(cmd, 9, len(cmd)));
        irc_part(id);
        return "irc[" + to_string(id) + "] parted";
    }
    if str_starts_with(cmd, "irc quit ") {
        let id = parse_int(str_sub(cmd, 9, len(cmd)));
        irc_quit(id, "");
        return "irc[" + to_string(id) + "] quit";
    }
    if str_starts_with(cmd, "irc status ") {
        let id = parse_int(str_sub(cmd, 11, len(cmd)));
        return irc_status(id);
    }

    // --- Calendar ---
    if cmd == "calendar" { uical_open(); return "Calendar opened"; }
    if cmd == "cal" { uical_open(); return "Calendar opened"; }
    if cmd == "cal next"  { if uical_is_open() == 0 { uical_open(); }
        uical_goto(uical_month % 12 + 1, uical_year + uical_month / 12);
        return "Calendar: next month"; }
    if cmd == "cal prev"  { if uical_is_open() == 0 { uical_open(); }
        let pm = uical_month - 1;
        let py = uical_year;
        if pm < 1 { let pm = 12; let py = py - 1; }
        uical_goto(pm, py);
        return "Calendar: prev month"; }
    if cmd == "cal today" { if uical_is_open() == 0 { uical_open(); }
        uical_open();   // re-opens and syncs to today
        return "Calendar: today"; }
    if str_starts_with(cmd, "cal add ") {
        let args = str_sub(cmd, 8, len(cmd));
        let sp = str_find(args, " ");
        if sp < 0 { return "Usage: cal add <day> <text>"; }
        let day  = parse_int(str_sub(args, 0, sp));
        let text = str_sub(args, sp + 1, len(args));
        let r = uical_add_event(day, uical_month, uical_year, text);
        if r < 0 { return "Error: event table full"; }
        return "Event added: day " + to_string(day) + " — " + text;
    }
    if str_starts_with(cmd, "cal goto ") {
        let args = str_sub(cmd, 9, len(cmd));
        let sp = str_find(args, " ");
        if sp < 0 { return "Usage: cal goto <month> <year>"; }
        let mo = parse_int(str_sub(args, 0, sp));
        let yr = parse_int(str_sub(args, sp + 1, len(args)));
        if uical_is_open() == 0 { uical_open(); }
        uical_goto(mo, yr);
        return "Calendar: " + to_string(mo) + "/" + to_string(yr);
    }

    // --- Compress ---
    if str_starts_with(cmd, "compress ") {
        let args = str_sub(cmd, 9, len(cmd));
        let sp1 = str_find(args, " ");
        if sp1 < 0 { return "Usage: compress <rle|lz> <src> <dst>"; }
        let algo = str_sub(args, 0, sp1);
        let rest = str_sub(args, sp1 + 1, len(args));
        let sp2 = str_find(rest, " ");
        if sp2 < 0 { return "Usage: compress <rle|lz> <src> <dst>"; }
        let src = str_sub(rest, 0, sp2);
        let dst = str_sub(rest, sp2 + 1, len(rest));
        let n = 0 - 1;
        if algo == "rle" { let n = compress_rle(src, dst); }
        else { if algo == "lz" { let n = compress_lzss(src, dst); }
               else { return "Error: unknown algo (use rle or lz)"; } }
        if n < 0 { return "Error: compress failed"; }
        return "Compressed to " + dst + "  " + to_string(n) + " bytes";
    }
    if str_starts_with(cmd, "decompress ") {
        let args = str_sub(cmd, 11, len(cmd));
        let sp1 = str_find(args, " ");
        if sp1 < 0 { return "Usage: decompress <rle|lz> <src> <dst>"; }
        let algo = str_sub(args, 0, sp1);
        let rest = str_sub(args, sp1 + 1, len(args));
        let sp2 = str_find(rest, " ");
        if sp2 < 0 { return "Usage: decompress <rle|lz> <src> <dst>"; }
        let src = str_sub(rest, 0, sp2);
        let dst = str_sub(rest, sp2 + 1, len(rest));
        let n = 0 - 1;
        if algo == "rle" { let n = decompress_rle(src, dst); }
        else { if algo == "lz" { let n = decompress_lzss(src, dst); }
               else { return "Error: unknown algo (use rle or lz)"; } }
        if n < 0 { return "Error: decompress failed"; }
        return "Decompressed to " + dst + "  " + to_string(n) + " bytes";
    }
    if str_starts_with(cmd, "compstat ") {
        let path = str_sub(cmd, 9, len(cmd));
        return compress_stat(path);
    }

    if cmd == "ctr" {
        return ctr_list();
    }
    if str_starts_with(cmd, "ctr new ") {
        let args = str_sub(cmd, 8, len(cmd));
        let sp = str_find(args, " ");
        let name = args;
        let root = "/";
        if sp >= 0 { name = str_sub(args, 0, sp); root = str_sub(args, sp + 1, len(args)); }
        let id = ctr_create(name, root);
        if id < 0 { return "Error: container create failed"; }
        return ctr_status(id);
    }
    if str_starts_with(cmd, "ctr start ") {
        let id = parse_int(str_sub(cmd, 10, len(cmd)));
        ctr_start(id);
        return ctr_status(id);
    }
    if str_starts_with(cmd, "ctr stop ") {
        let id = parse_int(str_sub(cmd, 9, len(cmd)));
        ctr_stop(id);
        return ctr_status(id);
    }
    if str_starts_with(cmd, "ctr rm ") {
        let id = parse_int(str_sub(cmd, 7, len(cmd)));
        ctr_destroy(id);
        return "Container " + to_string(id) + " destroyed";
    }
    if str_starts_with(cmd, "ctr exec ") {
        let args = str_sub(cmd, 9, len(cmd));
        let sp = str_find(args, " ");
        if sp < 0 { return "Usage: ctr exec <id> <cmd>"; }
        let id  = parse_int(str_sub(args, 0, sp));
        let c   = str_sub(args, sp + 1, len(args));
        ctr_exec(id, c);
        return "exec dispatched";
    }
    if str_starts_with(cmd, "ctr info ") {
        let id = parse_int(str_sub(cmd, 9, len(cmd)));
        return ctr_status(id);
    }

    if cmd == "ns" {
        return ns_list();
    }
    if str_starts_with(cmd, "ns new") {
        let ns_id = ns_create(0, NS_TYPE_ALL);
        if ns_id < 0 { return "Error: namespace table full"; }
        return "Created: " + ns_status(ns_id);
    }
    if str_starts_with(cmd, "ns info ") {
        let id = parse_int(str_sub(cmd, 8, len(cmd)));
        return ns_status(id);
    }
    if str_starts_with(cmd, "ns hostname ") {
        let args = str_sub(cmd, 12, len(cmd));
        let sp = str_find(args, " ");
        if sp < 0 { return "Usage: ns hostname <ns_id> <name>"; }
        let ns_id = parse_int(str_sub(args, 0, sp));
        let name  = str_sub(args, sp + 1, len(args));
        let r = ns_set_hostname(ns_id, name);
        if r == 0 { return "Set hostname in ns[" + to_string(ns_id) + "] = " + name; }
        return "Error: cannot set hostname";
    }
    if str_starts_with(cmd, "ns enter ") {
        let args = str_sub(cmd, 9, len(cmd));
        let sp = str_find(args, " ");
        if sp < 0 { return "Usage: ns enter <task_idx> <ns_id>"; }
        let tidx  = parse_int(str_sub(args, 0, sp));
        let ns_id = parse_int(str_sub(args, sp + 1, len(args)));
        let r = ns_enter(tidx, ns_id);
        if r == 0 { return "Task " + to_string(tidx) + " entered ns[" + to_string(ns_id) + "]"; }
        return "Error: ns_enter failed";
    }
    if str_starts_with(cmd, "ns del ") {
        let ns_id = parse_int(str_sub(cmd, 7, len(cmd)));
        let r = ns_destroy(ns_id);
        if r == 0 { return "Destroyed ns[" + to_string(ns_id) + "]"; }
        return "Error: cannot destroy ns[" + to_string(ns_id) + "]";
    }

    if cmd == "pty" {
        return pty_status();
    }
    if cmd == "tcploop" {
        return tcp_loopback_status();
    }
    if cmd == "dnstest" {
        return dns_loopback_status();
    }
    if cmd == "advtest" {
        return advanced_feature_summary();
    }
    if cmd == "sock" {
        return to_string(socket_count) + "/" + to_string(SOCKET_MAX) + " sockets open";
    }
    if cmd == "shm" {
        return shm_status();
    }
    if cmd == "trace" {
        return trace_status();
    }
    if cmd == "hrt" {
        return hrtimer_status();
    }
    if cmd == "sysfs" {
        return sysfs_list(0);
    }
    if cmd == "services" {
        svc_list();
        return "";
    }
    if str_starts_with(cmd, "svc start ") {
        let name = str_sub(cmd, 10, len(cmd));
        svc_start(name);
        return "";
    }
    if str_starts_with(cmd, "svc stop ") {
        let name = str_sub(cmd, 9, len(cmd));
        svc_stop(name);
        return "";
    }
    if str_starts_with(cmd, "svc status ") {
        let name = str_sub(cmd, 11, len(cmd));
        svc_status(name);
        return "";
    }
    if cmd == "uptime" {
        let ticks = get_ticks();
        let secs = ticks / 100;
        return "up " + to_string(secs / 60) + "m " + to_string(secs % 60) + "s";
    }
    if cmd == "kinfo" {
        hicos_kernel_info();
        return "";
    }
    if cmd == "lsmod" {
        kmod_status();
        return "";
    }
    if cmd == "kmodtest" {
        kmod_selftest();
        return "";
    }
    if cmd == "sysmon" {
        uismon_open();
        return "System Monitor opened";
    }
    if cmd == "files" {
        uifiles_open();
        return "File Manager opened";
    }
    if cmd == "audiotest" {
        ac97_beep(440, 500);
        return "Audio test: 440 Hz 500 ms";
    }
    if cmd == "settings" {
        uisettings_open();
        return "Settings opened";
    }
    if str_starts_with(cmd, "edit ") {
        let path = str_sub(cmd, 5, len(cmd));
        uitxed_open(path);
        return "Editor opened: " + path;
    }
    if cmd == "editor" {
        uitxed_open("");
        return "Editor opened (new file)";
    }
    if cmd == "gpu" {
        if gpu_initialized == 1 {
            print("GPU: " + to_string(gpu_display_w) + "x" + to_string(gpu_display_h) +
                  " fb=0x" + format_hex(gpu_fb_base(), 8) + " [active]");
            print(vesa_dirty_info());
        } else {
            print("GPU: not initialized");
        }
        return "";
    }
    if cmd == "gpu flip" {
        vesa_flip();
        return "GPU: full-screen flip submitted";
    }
    if cmd == "gpu dirty" {
        return vesa_dirty_info();
    }
    if cmd == "ext4" {
        if ext4_ready == 1 {
            print("ext4: mounted  block_size=" + to_string(ext4_block_size) +
                  " inode_size=" + to_string(ext4_inode_size));
            let root_ents = ext4_list_dir(EXT4_ROOT_INODE);
            let mut ri = 0;
            while ri < len(root_ents) {
                print("  " + root_ents[ri][0]);
                ri = ri + 1;
            }
        } else {
            print("ext4: not mounted");
        }
        return "";
    }
    // --- echo with redirect: echo <text> > <path> ---
    if str_starts_with(cmd, "echo ") {
        let rest = str_sub(cmd, 5, len(cmd));
        // Check for > redirect
        let mut redir_pos = 0 - 1;
        let mut gi = 0;
        while gi < len(rest) {
            if str_char_at(rest, gi) == 62 { redir_pos = gi; gi = len(rest); }
            else { gi = gi + 1; }
        }
        if redir_pos >= 0 {
            let text = str_sub(rest, 0, redir_pos - 1);
            let rpath_raw = str_sub(rest, redir_pos + 1, len(rest));
            let mut rpath = rpath_raw;
            if len(rpath_raw) > 0 {
                if str_char_at(rpath_raw, 0) == 32 { rpath = str_sub(rpath_raw, 1, len(rpath_raw)); }
            }
            let wfd = vfs_open(rpath, 577);  // O_CREAT|O_WRONLY|O_TRUNC
            if wfd < 0 { return "Error: cannot write to " + rpath; }
            vfs_write(wfd, text, len(text));
            vfs_close(wfd);
            return "";
        }
        return rest;
    }
    // --- inotify: show inotify subsystem status ---
    if cmd == "inotify" {
        let ic = inotify_inst_count;
        let wc = watch_count;
        let qc = evt_count;
        print("inotify: instances=" + to_string(ic) + " watches=" + to_string(wc) + " queued_events=" + to_string(qc));
        return "";
    }
    if cmd == "pty" {
        print(pty_status());
        return "";
    }
    if str_starts_with(cmd, "pty ") {
        let ptycmd = str_sub(cmd, 4, len(cmd));
        if ptycmd == "alloc" {
            let pair = pty_open_pair();
            print("PTY allocated: id=" + to_string(pair[2]) + " mfd=" + to_string(pair[0]) + " sfd=" + to_string(pair[1]));
            return "";
        }
        if str_starts_with(ptycmd, "info ") {
            let pid_s = str_sub(ptycmd, 5, len(ptycmd));
            print(pty_info(parse_int(pid_s)));
            return "";
        }
        return "Usage: pty | pty alloc | pty info <id>";
    }
    // --- watch <path>: add inotify watch and show events ---
    if str_starts_with(cmd, "watch ") {
        let wpath = str_sub(cmd, 6, len(cmd));
        let inst = sys_inotify_init();
        sys_inotify_add_watch(inst, wpath, 4095);
        print("Watching: " + wpath + "  (inst=" + to_string(inst) + ", sampling 10 polls)");
        let mut wdone = 0;
        let mut wpoll = 0;
        while wdone == 0 {
            let evts = sys_inotify_read(inst);
            let mut ei = 0;
            while ei + 1 < len(evts) {
                let emask = evts[ei];
                let ename = evts[ei + 1];
                print("EVENT mask=" + to_string(emask) + " name=" + ename);
                ei = ei + 2;
            }
            wpoll = wpoll + 1;
            if wpoll >= 10 { wdone = 1; }
        }
        sys_inotify_close(inst);
        return "";
    }
    if cmd == "fm" || cmd == "fileman" {
        // Open graphical file manager window
        uifiles_init();
        let win_id = uifiles_open();
        if win_id < 0 {
            return "Failed to open file manager";
        }
        return "File manager opened (window " + to_string(win_id) + ")";
    }

    // === SQLite commands ===
    if cmd == "db list" { return db_list(); }
    if str_starts_with(cmd, "db create ") {
        let args = str_sub(cmd, 10, len(cmd));
        let sp = str_find(args, " ");
        if sp < 0 { return "Usage: db create <name> <col1 col2 ...>"; }
        let tname  = str_sub(args, 0, sp);
        let schema = str_sub(args, sp + 1, len(args));
        let id = db_create(tname, schema);
        if id < 0 { return "Error: table exists or limit reached"; }
        return "Created table '" + tname + "' id=" + to_string(id);
    }
    if str_starts_with(cmd, "db insert ") {
        let args = str_sub(cmd, 10, len(cmd));
        let sp = str_find(args, " ");
        if sp < 0 { return "Usage: db insert <name> <val1 val2 ...>"; }
        let tname = str_sub(args, 0, sp);
        let row   = str_sub(args, sp + 1, len(args));
        let id = _db_find(tname);
        if id < 0 { return "Error: table '" + tname + "' not found"; }
        let ri = db_insert(id, row);
        return "Inserted row " + to_string(ri) + " into '" + tname + "'";
    }
    if str_starts_with(cmd, "db select ") {
        let tname = str_sub(cmd, 10, len(cmd));
        let id = _db_find(tname);
        if id < 0 { return "Error: table '" + tname + "' not found"; }
        return db_select_all(id);
    }
    if str_starts_with(cmd, "db where ") {
        let args = str_sub(cmd, 9, len(cmd));
        let sp1 = str_find(args, " ");
        if sp1 < 0 { return "Usage: db where <name> <col> <val>"; }
        let tname = str_sub(args, 0, sp1);
        let rest  = str_sub(args, sp1 + 1, len(args));
        let sp2   = str_find(rest, " ");
        if sp2 < 0 { return "Usage: db where <name> <col> <val>"; }
        let col = str_sub(rest, 0, sp2);
        let val = str_sub(rest, sp2 + 1, len(rest));
        let id = _db_find(tname);
        if id < 0 { return "Error: table '" + tname + "' not found"; }
        return db_select_where(id, col, val);
    }
    if str_starts_with(cmd, "db delete ") {
        let args = str_sub(cmd, 10, len(cmd));
        let sp1 = str_find(args, " ");
        if sp1 < 0 { return "Usage: db delete <name> <col> <val>"; }
        let tname = str_sub(args, 0, sp1);
        let rest  = str_sub(args, sp1 + 1, len(args));
        let sp2   = str_find(rest, " ");
        if sp2 < 0 { return "Usage: db delete <name> <col> <val>"; }
        let col = str_sub(rest, 0, sp2);
        let val = str_sub(rest, sp2 + 1, len(rest));
        let id = _db_find(tname);
        if id < 0 { return "Error: table '" + tname + "' not found"; }
        let n = db_delete_where(id, col, val);
        return "Deleted " + to_string(n) + " row(s) from '" + tname + "'";
    }
    if str_starts_with(cmd, "db drop ") {
        let tname = str_sub(cmd, 8, len(cmd));
        let id = _db_find(tname);
        if id < 0 { return "Error: table '" + tname + "' not found"; }
        db_drop(id);
        return "Dropped table '" + tname + "'";
    }
    if str_starts_with(cmd, "db schema ") {
        let tname = str_sub(cmd, 10, len(cmd));
        let id = _db_find(tname);
        if id < 0 { return "Error: table '" + tname + "' not found"; }
        return db_schema(id);
    }
    if str_starts_with(cmd, "db count ") {
        let tname = str_sub(cmd, 9, len(cmd));
        let id = _db_find(tname);
        if id < 0 { return "Error: table '" + tname + "' not found"; }
        return to_string(db_count(id)) + " rows";
    }

    // === Diff commands ===
    if str_starts_with(cmd, "diff ") {
        let args = str_sub(cmd, 5, len(cmd));
        let sp = str_find(args, " ");
        if sp < 0 { return "Usage: diff <pathA> <pathB>"; }
        let pa = str_sub(args, 0, sp);
        let pb = str_sub(args, sp + 1, len(args));
        return diff_files(pa, pb);
    }
    if str_starts_with(cmd, "diffstat ") {
        let args = str_sub(cmd, 9, len(cmd));
        let sp = str_find(args, " ");
        if sp < 0 { return "Usage: diffstat <pathA> <pathB>"; }
        let pa = str_sub(args, 0, sp);
        let pb = str_sub(args, sp + 1, len(args));
        return diff_stat(pa, pb);
    }
    if str_starts_with(cmd, "diffstr ") {
        let args = str_sub(cmd, 8, len(cmd));
        let sp = str_find(args, " ");
        if sp < 0 { return "Usage: diffstr <textA> <textB>"; }
        let ta = str_sub(args, 0, sp);
        let tb = str_sub(args, sp + 1, len(args));
        return diff_strings(ta, tb);
    }

    // === Clock commands ===
    if cmd == "clock" {
        uiclock_open();
        return "Clock opened";
    }
    if cmd == "clock close" {
        uiclock_close();
        return "Clock closed";
    }
    if cmd == "clock time" {
        return uiclock_get_time_str();
    }
    if str_starts_with(cmd, "clock alarm ") {
        let args = str_sub(cmd, 12, len(cmd));
        let sp = str_find(args, " ");
        if sp < 0 { return "Usage: clock alarm <HH> <MM>"; }
        let h = parse_int(str_sub(args, 0, sp));
        let m = parse_int(str_sub(args, sp + 1, len(args)));
        uiclock_set_alarm(h, m);
        return "Alarm set for " + to_string(h) + ":" + to_string(m);
    }

    // === Base64 commands ===
    if str_starts_with(cmd, "b64encode ") {
        let args = str_sub(cmd, 10, len(cmd));
        let sp = str_find(args, " ");
        if sp < 0 { return "Usage: b64encode <src> <dst>"; }
        let src = str_sub(args, 0, sp);
        let dst = str_sub(args, sp + 1, len(args));
        let n = b64_encode_file(src, dst);
        if n < 0 { return "Error: b64encode failed"; }
        return "Encoded to " + dst + "  " + to_string(n) + " bytes";
    }
    if str_starts_with(cmd, "b64decode ") {
        let args = str_sub(cmd, 10, len(cmd));
        let sp = str_find(args, " ");
        if sp < 0 { return "Usage: b64decode <src> <dst>"; }
        let src = str_sub(args, 0, sp);
        let dst = str_sub(args, sp + 1, len(args));
        let n = b64_decode_file(src, dst);
        if n < 0 { return "Error: b64decode failed"; }
        return "Decoded to " + dst + "  " + to_string(n) + " bytes";
    }
    if str_starts_with(cmd, "b64str ") {
        let text = str_sub(cmd, 7, len(cmd));
        return b64_encode_str(text);
    }

    // === INI commands ===
    if str_starts_with(cmd, "ini load ") {
        let path = str_sub(cmd, 9, len(cmd));
        let n = ini_load(path);
        if n < 0 { return "Error: cannot open " + path; }
        return "Loaded " + to_string(n) + " entries from " + path;
    }
    if cmd == "ini list" { return ini_list(); }
    if str_starts_with(cmd, "ini get ") {
        let args = str_sub(cmd, 8, len(cmd));
        let sp = str_find(args, " ");
        if sp < 0 { return "Usage: ini get <section> <key>"; }
        let sec = str_sub(args, 0, sp);
        let key = str_sub(args, sp + 1, len(args));
        let v = ini_get(sec, key);
        if len(v) == 0 { return "(not found)"; }
        return v;
    }
    if str_starts_with(cmd, "ini set ") {
        let args = str_sub(cmd, 8, len(cmd));
        let sp1 = str_find(args, " ");
        if sp1 < 0 { return "Usage: ini set <section> <key> <val>"; }
        let sec  = str_sub(args, 0, sp1);
        let rest = str_sub(args, sp1 + 1, len(args));
        let sp2  = str_find(rest, " ");
        if sp2 < 0 { return "Usage: ini set <section> <key> <val>"; }
        let key = str_sub(rest, 0, sp2);
        let val = str_sub(rest, sp2 + 1, len(rest));
        ini_set(sec, key, val);
        return "Set [" + sec + "] " + key + " = " + val;
    }
    if str_starts_with(cmd, "ini save ") {
        let path = str_sub(cmd, 9, len(cmd));
        let n = ini_save(path);
        if n < 0 { return "Error: cannot write " + path; }
        return "Saved " + to_string(n) + " bytes to " + path;
    }
    if str_starts_with(cmd, "ini del ") {
        let args = str_sub(cmd, 8, len(cmd));
        let sp = str_find(args, " ");
        if sp < 0 { return "Usage: ini del <section> <key>"; }
        let sec = str_sub(args, 0, sp);
        let key = str_sub(args, sp + 1, len(args));
        let r = ini_delete(sec, key);
        if r == 1 { return "Deleted [" + sec + "] " + key; }
        return "(not found)";
    }

    // === Profiler commands ===
    if cmd == "prof report" { return prof_report(); }
    if cmd == "prof reset"  { prof_reset(); return "Profiler reset"; }
    if cmd == "prof spans"  { return prof_span_report(); }
    if cmd == "prof ring"   { return prof_ring_report(); }
    if cmd == "prof sample" { let t = prof_sample(); return "Sampled tick=" + to_string(t); }
    if str_starts_with(cmd, "prof top ") {
        let n = parse_int(str_sub(cmd, 9, len(cmd)));
        return prof_top(n);
    }
    if str_starts_with(cmd, "prof inc ") {
        let name = str_sub(cmd, 9, len(cmd));
        let v = prof_inc(name);
        return name + " = " + to_string(v);
    }
    if str_starts_with(cmd, "prof get ") {
        let name = str_sub(cmd, 9, len(cmd));
        return name + " = " + to_string(prof_get(name));
    }

    // === CSV commands ===
    if str_starts_with(cmd, "csv load ") {
        let path = str_sub(cmd, 9, len(cmd));
        let n = csv_load(path);
        if n < 0 { return "Error: cannot open " + path; }
        return "Loaded " + to_string(n) + " rows from " + path;
    }
    if cmd == "csv list" { return csv_head(10); }
    if str_starts_with(cmd, "csv list ") {
        let n = parse_int(str_sub(cmd, 9, len(cmd)));
        return csv_head(n);
    }
    if str_starts_with(cmd, "csv get ") {
        let args = str_sub(cmd, 8, len(cmd));
        let sp = str_find(args, " ");
        if sp < 0 { return "Usage: csv get <row> <col>"; }
        let row = parse_int(str_sub(args, 0, sp));
        let col = parse_int(str_sub(args, sp + 1, len(args)));
        return csv_get(row, col);
    }
    if str_starts_with(cmd, "csv set ") {
        let args = str_sub(cmd, 8, len(cmd));
        let sp1 = str_find(args, " ");
        if sp1 < 0 { return "Usage: csv set <row> <col> <val>"; }
        let row  = parse_int(str_sub(args, 0, sp1));
        let rest = str_sub(args, sp1 + 1, len(args));
        let sp2  = str_find(rest, " ");
        if sp2 < 0 { return "Usage: csv set <row> <col> <val>"; }
        let col = parse_int(str_sub(rest, 0, sp2));
        let val = str_sub(rest, sp2 + 1, len(rest));
        csv_set(row, col, val);
        return "Set [" + to_string(row) + "," + to_string(col) + "] = " + val;
    }
    if str_starts_with(cmd, "csv save ") {
        let path = str_sub(cmd, 9, len(cmd));
        let n = csv_save(path);
        if n < 0 { return "Error: cannot write " + path; }
        return "Saved " + to_string(n) + " bytes to " + path;
    }
    if cmd == "csv cols" { return csv_col_names(); }

    // === Ping commands ===
    if str_starts_with(cmd, "ping ") {
        let args = str_sub(cmd, 5, len(cmd));
        let sp = str_find(args, " ");
        let host = args;
        let count = 4;
        if sp >= 0 {
            host = str_sub(args, 0, sp);
            count = parse_int(str_sub(args, sp + 1, len(args)));
        }
        return ping_host(host, count);
    }

    // === Task manager commands ===
    if cmd == "taskman" {
        uitaskman_open();
        return "Task Manager opened";
    }

    // === Traceroute commands ===
    if str_starts_with(cmd, "traceroute ") {
        let args = str_sub(cmd, 11, len(cmd));
        let sp = str_find(args, " ");
        let host = args;
        let hops = 15;
        if sp >= 0 {
            host = str_sub(args, 0, sp);
            hops = parse_int(str_sub(args, sp + 1, len(args)));
        }
        return traceroute_host(host, hops);
    }

    // === Semaphore commands ===
    if cmd == "sem list" { return sem_list(); }
    if str_starts_with(cmd, "sem create ") {
        let args = str_sub(cmd, 11, len(cmd));
        let sp = str_find(args, " ");
        if sp < 0 { return "Usage: sem create <name> <initial_val>"; }
        let nm  = str_sub(args, 0, sp);
        let val = parse_int(str_sub(args, sp + 1, len(args)));
        let id = sem_open(nm, val);
        if id < 0 { return "Error: semaphore table full or name too long"; }
        return "Semaphore '" + nm + "' created, id=" + to_string(id);
    }
    if str_starts_with(cmd, "sem wait ") {
        let id = parse_int(str_sub(cmd, 9, len(cmd)));
        let r = sem_wait(id);
        if r < 0 { return "sem[" + to_string(id) + "]: would block (val=0)"; }
        return "sem[" + to_string(id) + "]: acquired, val=" + to_string(sem_getvalue(id));
    }
    if str_starts_with(cmd, "sem post ") {
        let id = parse_int(str_sub(cmd, 9, len(cmd)));
        let v = sem_post(id);
        if v < 0 { return "Error: invalid semaphore id"; }
        return "sem[" + to_string(id) + "]: posted, val=" + to_string(v);
    }
    if str_starts_with(cmd, "sem value ") {
        let id = parse_int(str_sub(cmd, 10, len(cmd)));
        let v = sem_getvalue(id);
        if v < 0 { return "Error: invalid semaphore id"; }
        return "sem[" + to_string(id) + "] = " + to_string(v);
    }
    if str_starts_with(cmd, "sem destroy ") {
        let id = parse_int(str_sub(cmd, 12, len(cmd)));
        sem_destroy(id);
        return "Semaphore " + to_string(id) + " destroyed";
    }

    // === Notepad commands ===
    if cmd == "notepad" {
        notepad_open("");
        return "Notepad opened";
    }
    if str_starts_with(cmd, "notepad ") {
        let path = str_sub(cmd, 8, len(cmd));
        notepad_open(path);
        return "Notepad opened: " + path;
    }

    // === IMAP commands ===
    if cmd == "imap" { return imap_list_sessions(); }
    if str_starts_with(cmd, "imap connect ") {
        let rest = str_sub(cmd, 13, len(cmd));
        let sp = str_find(rest, " ");
        if sp < 0 { return "Usage: imap connect <host> <port>"; }
        let host = str_sub(rest, 0, sp);
        let port = parse_int(str_sub(rest, sp + 1, len(rest)));
        let id = imap_connect(host, port);
        if id < 0 { return "Error: imap connect failed"; }
        return "imap[" + to_string(id) + "] connected to " + host;
    }
    if str_starts_with(cmd, "imap login ") {
        let rest = str_sub(cmd, 11, len(cmd));
        let sp1 = str_find(rest, " ");
        if sp1 < 0 { return "Usage: imap login <id> <user> <pass>"; }
        let id = parse_int(str_sub(rest, 0, sp1));
        let rest2 = str_sub(rest, sp1 + 1, len(rest));
        let sp2 = str_find(rest2, " ");
        if sp2 < 0 { return "Usage: imap login <id> <user> <pass>"; }
        let user = str_sub(rest2, 0, sp2);
        let pass = str_sub(rest2, sp2 + 1, len(rest2));
        let r = imap_login(id, user, pass);
        if r < 0 { return "Error: imap login failed"; }
        return "imap[" + to_string(id) + "] logged in as " + user;
    }
    if str_starts_with(cmd, "imap select ") {
        let rest = str_sub(cmd, 12, len(cmd));
        let sp = str_find(rest, " ");
        if sp < 0 { return "Usage: imap select <id> <mailbox>"; }
        let id = parse_int(str_sub(rest, 0, sp));
        let mbox = str_sub(rest, sp + 1, len(rest));
        let cnt = imap_select(id, mbox);
        if cnt < 0 { return "Error: imap select failed"; }
        return "imap[" + to_string(id) + "] selected " + mbox + " (" + to_string(cnt) + " msgs)";
    }
    if str_starts_with(cmd, "imap list ") {
        let id = parse_int(str_sub(cmd, 10, len(cmd)));
        return imap_list(id);
    }
    if str_starts_with(cmd, "imap fetch ") {
        let rest = str_sub(cmd, 11, len(cmd));
        let sp1 = str_find(rest, " ");
        if sp1 < 0 { return "Usage: imap fetch <id> <from> <to>"; }
        let id = parse_int(str_sub(rest, 0, sp1));
        let rest2 = str_sub(rest, sp1 + 1, len(rest));
        let sp2 = str_find(rest2, " ");
        if sp2 < 0 { return "Usage: imap fetch <id> <from> <to>"; }
        let from = parse_int(str_sub(rest2, 0, sp2));
        let to_n = parse_int(str_sub(rest2, sp2 + 1, len(rest2)));
        return imap_fetch(id, from, to_n);
    }
    if str_starts_with(cmd, "imap logout ") {
        let id = parse_int(str_sub(cmd, 12, len(cmd)));
        imap_logout(id);
        return "imap[" + to_string(id) + "] logged out";
    }

    // === MQTT commands ===
    if cmd == "mqtt" { return mqtt_list(); }
    if str_starts_with(cmd, "mqtt connect ") {
        let rest = str_sub(cmd, 13, len(cmd));
        let sp1 = str_find(rest, " ");
        if sp1 < 0 { return "Usage: mqtt connect <host> <port> <client_id>"; }
        let host = str_sub(rest, 0, sp1);
        let rest2 = str_sub(rest, sp1 + 1, len(rest));
        let sp2 = str_find(rest2, " ");
        if sp2 < 0 { return "Usage: mqtt connect <host> <port> <client_id>"; }
        let port = parse_int(str_sub(rest2, 0, sp2));
        let cid = str_sub(rest2, sp2 + 1, len(rest2));
        let id = mqtt_connect(host, port, cid);
        if id < 0 { return "Error: mqtt connect failed"; }
        return "mqtt[" + to_string(id) + "] connected to " + host;
    }
    if str_starts_with(cmd, "mqtt pub ") {
        let rest = str_sub(cmd, 9, len(cmd));
        let sp1 = str_find(rest, " ");
        if sp1 < 0 { return "Usage: mqtt pub <id> <topic> <payload>"; }
        let id = parse_int(str_sub(rest, 0, sp1));
        let rest2 = str_sub(rest, sp1 + 1, len(rest));
        let sp2 = str_find(rest2, " ");
        if sp2 < 0 { return "Usage: mqtt pub <id> <topic> <payload>"; }
        let topic = str_sub(rest2, 0, sp2);
        let payload = str_sub(rest2, sp2 + 1, len(rest2));
        mqtt_publish(id, topic, payload);
        return "mqtt[" + to_string(id) + "] published to " + topic;
    }
    if str_starts_with(cmd, "mqtt sub ") {
        let rest = str_sub(cmd, 9, len(cmd));
        let sp = str_find(rest, " ");
        if sp < 0 { return "Usage: mqtt sub <id> <topic>"; }
        let id = parse_int(str_sub(rest, 0, sp));
        let topic = str_sub(rest, sp + 1, len(rest));
        mqtt_subscribe(id, topic);
        return "mqtt[" + to_string(id) + "] subscribed to " + topic;
    }
    if str_starts_with(cmd, "mqtt unsub ") {
        let rest = str_sub(cmd, 11, len(cmd));
        let sp = str_find(rest, " ");
        if sp < 0 { return "Usage: mqtt unsub <id> <topic>"; }
        let id = parse_int(str_sub(rest, 0, sp));
        let topic = str_sub(rest, sp + 1, len(rest));
        mqtt_unsubscribe(id, topic);
        return "mqtt[" + to_string(id) + "] unsubscribed from " + topic;
    }
    if str_starts_with(cmd, "mqtt ping ") {
        let id = parse_int(str_sub(cmd, 10, len(cmd)));
        mqtt_ping(id);
        return "mqtt[" + to_string(id) + "] PINGREQ sent";
    }
    if str_starts_with(cmd, "mqtt quit ") {
        let id = parse_int(str_sub(cmd, 10, len(cmd)));
        mqtt_disconnect(id);
        return "mqtt[" + to_string(id) + "] disconnected";
    }

    // === LZ4 commands ===
    if cmd == "lz4test" { return lz4_selftest(); }
    if str_starts_with(cmd, "lz4c ") {
        let rest = str_sub(cmd, 5, len(cmd));
        let sp = str_find(rest, " ");
        if sp < 0 { return "Usage: lz4c <inpath> <outpath>"; }
        let inpath  = str_sub(rest, 0, sp);
        let outpath = str_sub(rest, sp + 1, len(rest));
        let n = lz4_compress_file(inpath, outpath);
        if n < 0 { return "Error: lz4c failed"; }
        return "lz4c: compressed " + to_string(n) + " bytes → " + outpath;
    }
    if str_starts_with(cmd, "lz4d ") {
        let rest = str_sub(cmd, 5, len(cmd));
        let sp = str_find(rest, " ");
        if sp < 0 { return "Usage: lz4d <inpath> <outpath>"; }
        let inpath  = str_sub(rest, 0, sp);
        let outpath = str_sub(rest, sp + 1, len(rest));
        let n = lz4_decompress_file(inpath, outpath);
        if n < 0 { return "Error: lz4d failed"; }
        return "lz4d: decompressed " + to_string(n) + " bytes → " + outpath;
    }

    // === FTP commands ===
    if cmd == "ftp" { return ftp_list_sessions(); }
    if str_starts_with(cmd, "ftp connect ") {
        let host = str_sub(cmd, 12, len(cmd));
        let id = ftp_connect(host);
        if id < 0 { return "Error: ftp connect failed"; }
        return "ftp[" + to_string(id) + "] connected to " + host;
    }
    if str_starts_with(cmd, "ftp auth ") {
        let rest = str_sub(cmd, 9, len(cmd));
        let sp1 = str_find(rest, " ");
        if sp1 < 0 { return "Usage: ftp auth <id> <user> <pass>"; }
        let id = parse_int(str_sub(rest, 0, sp1));
        let rest2 = str_sub(rest, sp1 + 1, len(rest));
        let sp2 = str_find(rest2, " ");
        if sp2 < 0 { return "Usage: ftp auth <id> <user> <pass>"; }
        let user = str_sub(rest2, 0, sp2);
        let pass = str_sub(rest2, sp2 + 1, len(rest2));
        let r = ftp_auth(id, user, pass);
        if r < 0 { return "Error: ftp auth failed"; }
        return "ftp[" + to_string(id) + "] authenticated as " + user;
    }
    if str_starts_with(cmd, "ftp ls ") {
        let rest = str_sub(cmd, 7, len(cmd));
        let sp = str_find(rest, " ");
        let mut id = parse_int(rest);
        let mut path = "";
        if sp >= 0 { id = parse_int(str_sub(rest, 0, sp)); path = str_sub(rest, sp + 1, len(rest)); }
        return ftp_list(id, path);
    }
    if str_starts_with(cmd, "ftp get ") {
        let rest = str_sub(cmd, 8, len(cmd));
        let sp1 = str_find(rest, " ");
        if sp1 < 0 { return "Usage: ftp get <id> <remote> <local>"; }
        let id = parse_int(str_sub(rest, 0, sp1));
        let rest2 = str_sub(rest, sp1 + 1, len(rest));
        let sp2 = str_find(rest2, " ");
        if sp2 < 0 { return "Usage: ftp get <id> <remote> <local>"; }
        let remote = str_sub(rest2, 0, sp2);
        let local = str_sub(rest2, sp2 + 1, len(rest2));
        let n = ftp_get(id, remote, local);
        if n < 0 { return "Error: ftp get failed"; }
        return "ftp: got " + to_string(n) + " bytes → " + local;
    }
    if str_starts_with(cmd, "ftp put ") {
        let rest = str_sub(cmd, 8, len(cmd));
        let sp1 = str_find(rest, " ");
        if sp1 < 0 { return "Usage: ftp put <id> <local> <remote>"; }
        let id = parse_int(str_sub(rest, 0, sp1));
        let rest2 = str_sub(rest, sp1 + 1, len(rest));
        let sp2 = str_find(rest2, " ");
        if sp2 < 0 { return "Usage: ftp put <id> <local> <remote>"; }
        let local = str_sub(rest2, 0, sp2);
        let remote = str_sub(rest2, sp2 + 1, len(rest2));
        let n = ftp_put(id, local, remote);
        if n < 0 { return "Error: ftp put failed"; }
        return "ftp: put " + to_string(n) + " bytes → " + remote;
    }
    if str_starts_with(cmd, "ftp pwd ") {
        let id = parse_int(str_sub(cmd, 8, len(cmd)));
        return ftp_pwd(id);
    }
    if str_starts_with(cmd, "ftp cd ") {
        let rest = str_sub(cmd, 7, len(cmd));
        let sp = str_find(rest, " ");
        if sp < 0 { return "Usage: ftp cd <id> <path>"; }
        let id = parse_int(str_sub(rest, 0, sp));
        let path = str_sub(rest, sp + 1, len(rest));
        let r = ftp_cwd(id, path);
        if r < 0 { return "Error: ftp cd failed"; }
        return "ftp[" + to_string(id) + "] cd " + path;
    }
    if str_starts_with(cmd, "ftp quit ") {
        let id = parse_int(str_sub(cmd, 9, len(cmd)));
        ftp_quit(id);
        return "ftp[" + to_string(id) + "] disconnected";
    }

    // === CBOR commands ===
    if str_starts_with(cmd, "cbor uint ") {
        let n = parse_int(str_sub(cmd, 10, len(cmd)));
        cbor_begin();
        cbor_encode_uint(n);
        return "cbor: " + cbor_get_result();
    }
    if str_starts_with(cmd, "cbor neg ") {
        let n = parse_int(str_sub(cmd, 9, len(cmd)));
        cbor_begin();
        cbor_encode_negint(n);
        return "cbor: " + cbor_get_result();
    }
    if str_starts_with(cmd, "cbor str ") {
        let s = str_sub(cmd, 9, len(cmd));
        cbor_begin();
        cbor_encode_str(s);
        return "cbor: " + cbor_get_result();
    }
    if str_starts_with(cmd, "cbor bool ") {
        let b = parse_int(str_sub(cmd, 10, len(cmd)));
        cbor_begin();
        cbor_encode_bool(b);
        return "cbor: " + cbor_get_result();
    }
    if cmd == "cbor null" {
        cbor_begin();
        cbor_encode_null();
        return "cbor: " + cbor_get_result();
    }
    if str_starts_with(cmd, "cbor hex ") {
        let hexstr = str_sub(cmd, 9, len(cmd));
        return cbor_decode_hex(hexstr);
    }
    if cmd == "cbor test" { return cbor_selftest(); }

    // === Syslog server commands ===
    if cmd == "syslogd" { return syslog_srv_list(10); }
    if cmd == "syslogd start" { syslog_srv_start(); return "syslogd: started on UDP 514"; }
    if cmd == "syslogd stop" { syslog_srv_stop(); return "syslogd: stopped"; }
    if cmd == "syslogd clear" { syslog_srv_clear(); return "syslogd: buffer cleared"; }
    if cmd == "syslogd status" { return syslog_srv_status(); }
    if str_starts_with(cmd, "syslogd last ") {
        let n = parse_int(str_sub(cmd, 13, len(cmd)));
        return syslog_srv_list(n);
    }

    // === CPIO archive commands ===
    if cmd == "cpio list" { return cpio_list(); }
    if str_starts_with(cmd, "cpio load ") {
        let path = str_sub(cmd, 10, len(cmd));
        let n = cpio_load(path);
        if n < 0 { return "cpio: load failed"; }
        return "cpio: loaded " + to_string(n) + " entries from " + path;
    }
    if str_starts_with(cmd, "cpio extract ") {
        let args = str_sub(cmd, 13, len(cmd));
        let space = str_index_of(args, " ");
        if space < 0 { return "cpio: usage: cpio extract <index> <dest>"; }
        let idx = parse_int(str_sub(args, 0, space));
        let dest = str_sub(args, space + 1, len(args));
        let res = cpio_extract(idx, dest);
        if res < 0 { return "cpio: extract failed"; }
        return "cpio: extracted " + cpio_get_name(idx) + " to " + dest;
    }
    if cmd == "cpio test" { return cpio_selftest(); }
    if cmd == "cpio clear" { cpio_clear(); return "cpio: cleared"; }

    // === Quoted-Printable commands ===
    if str_starts_with(cmd, "qp encode ") {
        let text = str_sub(cmd, 10, len(cmd));
        let n = qp_encode(text);
        if n < 0 { return "qp: encode failed"; }
        return qp_get_result();
    }
    if str_starts_with(cmd, "qp decode ") {
        let text = str_sub(cmd, 10, len(cmd));
        let n = qp_decode(text);
        if n < 0 { return "qp: decode failed"; }
        return qp_get_result();
    }
    if cmd == "qp show" { return qp_get_result(); }
    if cmd == "qp test" { return qp_selftest(); }

    // === UUencode commands ===
    if str_starts_with(cmd, "uu encode ") {
        let args = str_sub(cmd, 10, len(cmd));
        let space = str_index_of(args, " ");
        if space < 0 { return "uu: usage: uu encode <text> <filename>"; }
        let text = str_sub(args, 0, space);
        let fname = str_sub(args, space + 1, len(args));
        let n = uu_encode(text, fname);
        if n < 0 { return "uu: encode failed"; }
        return uu_get_result();
    }
    if str_starts_with(cmd, "uu decode ") {
        let text = str_sub(cmd, 10, len(cmd));
        let n = uu_decode(text);
        if n < 0 { return "uu: decode failed"; }
        return uu_get_result();
    }
    if cmd == "uu show" { return uu_get_result(); }
    if cmd == "uu test" { return uu_selftest(); }

    // === ASN.1 DER commands ===
    if str_starts_with(cmd, "asn1 int ") {
        asn1_clear();
        let val = parse_int(str_sub(cmd, 9, len(cmd)));
        asn1_encode_integer(val);
        return asn1_get_hex();
    }
    if str_starts_with(cmd, "asn1 str ") {
        asn1_clear();
        let text = str_sub(cmd, 9, len(cmd));
        asn1_encode_octet_string(text);
        return asn1_get_hex();
    }
    if cmd == "asn1 null" {
        asn1_clear();
        asn1_encode_null();
        return asn1_get_hex();
    }
    if str_starts_with(cmd, "asn1 decode ") {
        let hex = str_sub(cmd, 12, len(cmd));
        return "asn1 decode: not yet implemented";
    }
    if cmd == "asn1 test" { return asn1_selftest(); }

    // === PEM format commands ===
    if str_starts_with(cmd, "pem parse ") {
        let data = str_sub(cmd, 10, len(cmd));
        let n = pem_parse(data);
        if n < 0 { return "pem: parse failed"; }
        return "pem: label=" + pem_get_label() + ", decoded " + to_string(n) + " bytes";
    }
    if str_starts_with(cmd, "pem load ") {
        let path = str_sub(cmd, 9, len(cmd));
        let n = pem_load(path);
        if n < 0 { return "pem: load failed"; }
        return "pem: label=" + pem_get_label() + ", decoded " + to_string(n) + " bytes";
    }
    if cmd == "pem show" { return pem_get_data(); }
    if cmd == "pem label" { return "pem: label=" + pem_get_label(); }
    if cmd == "pem test" { return pem_selftest(); }

    // === JWT commands ===
    if str_starts_with(cmd, "jwt parse ") {
        let token = str_sub(cmd, 10, len(cmd));
        let res = jwt_parse(token);
        if res < 0 { return "jwt: parse failed"; }
        return jwt_display();
    }
    if cmd == "jwt header" { return jwt_get_header(); }
    if cmd == "jwt payload" { return jwt_get_payload(); }
    if cmd == "jwt sub" { return "sub: " + jwt_get_sub(); }
    if cmd == "jwt iss" { return "iss: " + jwt_get_iss(); }
    if cmd == "jwt exp" {
        let exp = jwt_get_exp();
        if jwt_is_expired() == 1 {
            return "exp: " + to_string(exp) + " (EXPIRED)";
        }
        return "exp: " + to_string(exp) + " (valid)";
    }
    if cmd == "jwt test" { return jwt_selftest(); }

    // === BMP image commands ===
    if str_starts_with(cmd, "bmp load ") {
        let path = str_sub(cmd, 9, len(cmd));
        let res = bmp_load(path);
        if res < 0 { return "bmp: load failed"; }
        return "bmp: loaded " + to_string(bmp_get_width()) + "x" + to_string(bmp_get_height()) + " image";
    }
    if cmd == "bmp info" { return bmp_info(); }
    if str_starts_with(cmd, "bmp show ") {
        let args = str_sub(cmd, 9, len(cmd));
        let space = str_index_of(args, " ");
        if space < 0 { return "bmp: usage: bmp show <x> <y>"; }
        let x = parse_int(str_sub(args, 0, space));
        let y = parse_int(str_sub(args, space + 1, len(args)));
        let res = bmp_display(x, y);
        if res < 0 { return "bmp: display failed"; }
        return "bmp: displayed at (" + to_string(x) + "," + to_string(y) + ")";
    }
    if cmd == "bmp test" { return bmp_selftest(); }

    // === GIF image commands ===
    if str_starts_with(cmd, "gif load ") {
        let path = str_sub(cmd, 9, len(cmd));
        let res = gif_load(path);
        if res < 0 { return "gif: load failed"; }
        return "gif: loaded " + to_string(gif_get_width()) + "x" + to_string(gif_get_height()) + " image";
    }
    if cmd == "gif info" { return gif_info(); }
    if cmd == "gif palette" { return gif_list_palette(); }
    if cmd == "gif test" { return gif_selftest(); }

    // === WAV audio commands ===
    if str_starts_with(cmd, "wav load ") {
        let path = str_sub(cmd, 9, len(cmd));
        let res = wav_load(path);
        if res < 0 { return "wav: load failed"; }
        return "wav: loaded " + to_string(wav_get_sample_rate()) + " Hz audio";
    }
    if cmd == "wav info" { return wav_info(); }
    if cmd == "wav play" {
        let res = wav_play();
        if res < 0 { return "wav: play failed"; }
        return "wav: playing...";
    }
    if cmd == "wav test" { return wav_selftest(); }

    // === Base32 encoding commands ===
    if str_starts_with(cmd, "base32 enc ") {
        let text = str_sub(cmd, 11, len(cmd));
        let n = base32_encode(text);
        if n < 0 { return "base32: encode failed"; }
        return base32_get_result();
    }
    if str_starts_with(cmd, "base32 dec ") {
        let text = str_sub(cmd, 11, len(cmd));
        let n = base32_decode(text);
        if n < 0 { return "base32: decode failed"; }
        return base32_get_result();
    }
    if cmd == "base32 test" { return base32_selftest(); }

    // === Hex encoding commands ===
    if str_starts_with(cmd, "hex enc ") {
        let text = str_sub(cmd, 8, len(cmd));
        let n = hex_encode(text);
        if n < 0 { return "hex: encode failed"; }
        return hex_get_result();
    }
    if str_starts_with(cmd, "hex dec ") {
        let text = str_sub(cmd, 8, len(cmd));
        let n = hex_decode(text);
        if n < 0 { return "hex: decode failed"; }
        return hex_get_result();
    }
    if str_starts_with(cmd, "hex dump ") {
        let text = str_sub(cmd, 9, len(cmd));
        return hex_dump(text, 0, len(text));
    }
    if cmd == "hex test" { return hex_selftest(); }

    // === URL encoding commands ===
    if str_starts_with(cmd, "url enc ") {
        let text = str_sub(cmd, 8, len(cmd));
        let n = url_encode(text);
        if n < 0 { return "url: encode failed"; }
        return url_get_result();
    }
    if str_starts_with(cmd, "url dec ") {
        let text = str_sub(cmd, 8, len(cmd));
        let n = url_decode(text);
        if n < 0 { return "url: decode failed"; }
        return url_get_result();
    }
    if str_starts_with(cmd, "url query ") {
        let query = str_sub(cmd, 10, len(cmd));
        return url_parse_query(query);
    }
    if cmd == "url test" { return url_selftest(); }

    // === CRC checksum commands ===
    if str_starts_with(cmd, "crc8 ") {
        let text = str_sub(cmd, 5, len(cmd));
        let c = crc8(text);
        return "crc8: " + crc_to_hex(c, 2);
    }
    if str_starts_with(cmd, "crc16 ") {
        let text = str_sub(cmd, 6, len(cmd));
        let c = crc16(text);
        return "crc16: " + crc_to_hex(c, 4);
    }
    if str_starts_with(cmd, "crc32 ") {
        let text = str_sub(cmd, 6, len(cmd));
        let c = crc32_simple(text);
        return "crc32: " + crc_to_hex(c, 8);
    }
    if cmd == "crc test" { return crc_selftest(); }

    // === MD5 hash commands ===
    if str_starts_with(cmd, "md5 ") {
        let text = str_sub(cmd, 4, len(cmd));
        return "md5: " + md5(text);
    }
    if cmd == "md5 test" { return md5_selftest(); }

    // === SHA1 hash commands ===
    if str_starts_with(cmd, "sha1 ") {
        let text = str_sub(cmd, 5, len(cmd));
        return "sha1: " + sha1(text);
    }
    if cmd == "sha1 test" { return sha1_selftest(); }

    // === HMAC commands ===
    if str_starts_with(cmd, "hmac-md5 ") {
        let args = str_sub(cmd, 9, len(cmd));
        let space = str_index_of(args, " ");
        if space < 0 { return "hmac: usage: hmac-md5 <key> <message>"; }
        let key = str_sub(args, 0, space);
        let msg = str_sub(args, space + 1, len(args));
        return "hmac-md5: " + hmac_md5(key, msg);
    }
    if str_starts_with(cmd, "hmac-sha1 ") {
        let args = str_sub(cmd, 10, len(cmd));
        let space = str_index_of(args, " ");
        if space < 0 { return "hmac: usage: hmac-sha1 <key> <message>"; }
        let key = str_sub(args, 0, space);
        let msg = str_sub(args, space + 1, len(args));
        return "hmac-sha1: " + hmac_sha1(key, msg);
    }
    if cmd == "hmac test" { return hmac_selftest(); }

    // === PBKDF2 commands ===
    if str_starts_with(cmd, "pbkdf2 ") {
        let args = str_sub(cmd, 7, len(cmd));
        return "pbkdf2: usage: pbkdf2 <password> <salt> <iterations> <keylen>";
    }
    if cmd == "pbkdf2 test" { return pbkdf2_selftest(); }

    // === UUID commands ===
    if cmd == "uuid" { return uuid_v4(); }
    if cmd == "uuid v4" { return uuid_v4(); }
    if cmd == "uuid nil" { return uuid_nil(); }
    if str_starts_with(cmd, "uuid validate ") {
        let u = str_sub(cmd, 14, len(cmd));
        let v = uuid_validate(u);
        if v == 1 { return "uuid: valid"; }
        return "uuid: invalid";
    }
    if cmd == "uuid test" { return uuid_selftest(); }

    return shell_handle(cmd);
}

// Self-test
print(shell_handle("help"));
print(shell_handle("ver"));
print(shell_handle("free"));
print(shell_handle("hilbert"));
print(shell_handle("fib 10"));
print(shell_handle("ps"));
print(shell_handle_ext("whoami"));
print("shell.hl loaded -- 415 commands + pipe(|) + echo>redirect + inotify + pty + audio + aus + gpu + cp/mv + ns + seccomp + ctr + clipboard + overlay + httpd + calc + paint + json + ws + telnet + regex + browse + smtp + cron + imgview + ntp + tar + hexedit + pop3 + irc + cal + compress + sqlite + diff + clock + base64 + ini + profiler + csv + ping + taskman + traceroute + sem + notepad + imap + mqtt + lz4 + ftp + cbor + syslogd + cpio + qp + uu + asn1 + pem + jwt + bmp + gif + wav + base32 + hex + url + crc + md5 + sha1 + hmac + pbkdf2 + uuid");

// Main shell loop (called from kernel_init)

// Handle pipe: "cmd1 | cmd2" — execute cmd1, pass result to cmd2
fn shell_handle_pipe(pipeline) {
    // Find | separator
    let mut pipe_pos = 0 - 1;
    let mut i = 0;
    while i < len(pipeline) {
        if str_char_at(pipeline, i) == 124 {  // '|' = ASCII 124
            pipe_pos = i;
            i = len(pipeline); // break
        } else {
            i = i + 1;
        }
    }
    if pipe_pos < 0 { return ""; }  // no pipe found

    let cmd1 = str_sub(pipeline, 0, pipe_pos - 1);
    let cmd2_raw = str_sub(pipeline, pipe_pos + 1, len(pipeline));
    // Trim leading space from cmd2
    let mut cmd2 = cmd2_raw;
    if len(cmd2_raw) > 0 {
        if str_char_at(cmd2_raw, 0) == 32 { cmd2 = str_sub(cmd2_raw, 1, len(cmd2_raw)); }
    }

    // Execute left side
    let mut left = shell_handle(cmd1);
    if left == "" { left = shell_handle_ext(cmd1); }

    // Execute right side with left as context
    if cmd2 == "wc" {
        // Count lines, words, chars
        let mut lines = 0;
        let mut words = 0;
        let mut in_word = 0;
        let mut ci = 0;
        while ci < len(left) {
            let ch = str_char_at(left, ci);
            if ch == 10 { lines = lines + 1; }
            if ch == 32 || ch == 9 || ch == 10 {
                in_word = 0;
            } else {
                if in_word == 0 { words = words + 1; }
                in_word = 1;
            }
            ci = ci + 1;
        }
        return to_string(lines) + " " + to_string(words) + " " + to_string(len(left));
    }

    if str_starts_with(cmd2, "grep ") {
        let pattern = str_sub(cmd2, 5, len(cmd2));
        // Split left by newline, filter lines containing pattern
        let mut out = "";
        let mut line = "";
        let mut ci = 0;
        while ci < len(left) {
            let ch = str_char_at(left, ci);
            if ch == 10 {
                if str_starts_with(line, pattern) || _str_contains(line, pattern) {
                    out = out + line + "\n";
                }
                line = "";
            } else {
                line = line + str_from_code(ch);
            }
            ci = ci + 1;
        }
        if len(line) > 0 {
            if _str_contains(line, pattern) { out = out + line; }
        }
        return out;
    }

    if cmd2 == "head" {
        // Return first 10 lines
        let mut out = "";
        let mut line = "";
        let mut count = 0;
        let mut ci = 0;
        while ci < len(left) {
            let ch = str_char_at(left, ci);
            if ch == 10 {
                out = out + line + "\n";
                line = "";
                count = count + 1;
                if count >= 10 { ci = len(left); }  // break
            } else {
                line = line + str_from_code(ch);
            }
            ci = ci + 1;
        }
        return out;
    }

    if cmd2 == "tail" {
        // Return last 10 lines
        let mut lines = [];
        let mut line = "";
        let mut ci = 0;
        while ci < len(left) {
            let ch = str_char_at(left, ci);
            if ch == 10 {
                push(lines, line);
                line = "";
            } else {
                line = line + str_from_code(ch);
            }
            ci = ci + 1;
        }
        if len(line) > 0 { push(lines, line); }
        let start = 0;
        if len(lines) > 10 { start = len(lines) - 10; }
        let mut out = "";
        let mut i = start;
        while i < len(lines) {
            out = out + lines[i] + "\n";
            i = i + 1;
        }
        return out;
    }

    // Unknown right side: just return left result
    return left;
}

// Helper: check if haystack contains needle (simple linear search)
fn _str_contains(haystack, needle) {
    if len(needle) == 0 { return 1; }
    if len(needle) > len(haystack) { return 0; }
    let limit = len(haystack) - len(needle);
    let mut i = 0;
    while i <= limit {
        if str_sub(haystack, i, i + len(needle)) == needle { return 1; }
        i = i + 1;
    }
    return 0;
}

fn shell_main() {
    let mut running = 1;
    while running == 1 {
        // Read line from serial input (poll keyboard buffer)
        let key_ready = mem_read_u64(3145744); // 0x300010
        if key_ready != 0 {
            let scancode = mem_read_u64(3145736); // 0x300008
            mem_write_u64(3145744, 0); // clear flag
            let ch = scancode % 256;
            // Enter key (0x0D or 0x0A)
            if ch == 13 || ch == 10 {
                let cmd = mem_read_string(3145760, 256); // 0x300020 input buffer
                if cmd == "shutdown" || cmd == "exit" {
                    running = 0;
                } else {
                    let mut result = "";
                    // Check for pipe operator
                    if _str_contains(cmd, " | ") {
                        result = shell_handle_pipe(cmd);
                    } else {
                        result = shell_handle(cmd);
                        if result == "" { result = shell_handle_ext(cmd); }
                    }
                    serial_print(result);
                    serial_print("HicOS> ");
                }
                // Clear input buffer
                mem_write_u8(3145760, 0);
            }
        }
    }
    serial_print("Shell exited.");
    return 0;
}
