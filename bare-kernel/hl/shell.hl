// shell.hl -- HicOS Interactive Serial Shell
//
// Processes commands received via serial/keyboard input.
// Runs in kernel main loop after all subsystems are initialized.
//
// 685 commands + pipe operator (|):
//   help ver uptime date free heap ps cpus mount lspci ifconfig
//   ls cat echo fib hilbert clear reboot shutdown ping dns arp dev panic
//   whoami id uname lsusb beep env proc meminfo mounts dmesg mixer ip6
//   cache ntp wdog tmpfs fw rand cg pty sock shm trace hrt sysfs
//   services svc(start/stop/status) kinfo run kill mkdir rm cp mv
//   history hostname netstat grep disk_info format install advtest
//   tcploop dnstest heval lsmod kmodtest
//   UI: sysmon files audiotest settings fm fileman edit editor
//   Audio: audio vol mute unmute beep  AudioServer: audioserver aus aus-connect/play/stop/vol/beep
//   GPU: gpu flip dirty
//   Namespace: ns  ns new  ns info  ns hostname  ns enter  ns del
//   Seccomp:   seccomp  seccomp new  seccomp deny  seccomp apply
//   Container: ctr  ctr new  ctr start  ctr stop  ctr rm  ctr exec  ctr info
//   Clipboard: clipboard  clip copy  clip paste  clip hist
//   Overlay FS: overlay  overlay new  overlay rm  overlay info
//   HTTP Server: httpd  httpd start  httpd stop  httpd tick
//   Calculator: calc
//   Paint: paint (graphical canvas)
//   JSON: json parse  json fmt
//   WebSocket: ws  ws connect  ws send  ws close  ws ping  ws info  ws tick
//   Telnet: telnet [host [port]]  telsend <id> <text>  telrecv <id>  telclose <id>  telnet tick
//   Regex: regex match <pat> <text>  regex find <pat> <text>  regex repl <pat> <repl> <text>
//   Browser: browse [url]
//   Shell pipe: cmd1 | cmd2

fn shell_handle(cmd) {
    if cmd == "help" {
        serial_print("=== HicOS Shell Commands ===");
        serial_print("System:   help ver uptime date uname reboot shutdown kinfo hostname");
        serial_print("Memory:   free heap meminfo");
        serial_print("Tasks:    ps kill run (kill sends SIGTERM by default)");
        serial_print("Signals:  SIGTERM=15 SIGKILL=9 SIGSTOP=19 SIGCONT=18");
        serial_print("Files:    ls [path] cat echo  echo <text> > <file>  mkdir rm  cp <s> <d>  mv <s> <d>  fm (graphical)");
        serial_print("Editor:   editor  edit <file>   (graphical text editor with VFS open/save)");
        serial_print("Proc:     mounts (dynamic) | cat /proc/meminfo etc.");
        serial_print("Disk:     disk_info format install");
        serial_print("Network:  ifconfig ping dns arp netstat");
        serial_print("Firewall: fw  firewall  fw allow|block <port>  fw flush  fw policy input|output drop|accept");
        serial_print("Hardware: lspci lsusb cpus dev beep ahci usb acpi");
        serial_print("Audio:    audio  audio vol <0-100>  audio mute/unmute  audio beep <hz> <ms>  mixer");
        serial_print("AudioSvr: audioserver  aus  aus connect  aus play/stop <id>  aus vol <pct>  aus beep <hz> <ms>");
        serial_print("Graphics: gpu  gpu flip  gpu dirty");
        serial_print("Services: services svc start|stop|status <name>");
        serial_print("FS Events:inotify  watch <path>  pty [alloc|info <id>]");
        serial_print("Namespace:ns  ns new  ns info <id>  ns hostname <id> <name>  ns enter <tid> <nsid>  ns del <id>");
        serial_print("Seccomp:  seccomp  seccomp new <name>  seccomp deny <pid> <nr>  seccomp apply <tid> <pid>");
        serial_print("Container:ctr  ctr new <name> [root]  ctr start/stop/rm <id>  ctr exec <id> <cmd>  ctr info <id>");
        serial_print("Clipboard:clipboard  clip copy <text>  clip paste  clip hist");
        serial_print("OverlayFS:overlay  overlay new <lower> <upper> <merged>  overlay rm <id>  overlay info <id>");
        serial_print("HTTP Svr: httpd  httpd start  httpd stop  httpd tick");
        serial_print("UI Apps:  sysmon fileman editor edit calc  audiotest");
        serial_print("Calculator: calc (graphical 4-function)");
        serial_print("Paint:    paint (graphical canvas: pen/eraser/line/fill)");
        serial_print("JSON:     json parse <str>  json fmt <str>");
        serial_print("WebSock:  ws  ws connect <host> <port> [path]  ws send <id> <msg>  ws close/ping/info/tick");
        serial_print("Telnet:   telnet [host [port]]  telsend <id> <text>  telrecv <id>  telclose <id>  telnet tick");
        serial_print("Regex:    regex match <pat> <text>  regex find <pat> <text>  regex repl <pat> <repl> <text>");
        serial_print("Browser:  browse [url]  (graphical HTTP browser, HTML tag stripping)");
        serial_print("SMTP:     smtp  smtp connect <host> <port>  smtp auth <id> <user> <pass>  smtp send <id> <from> <to> <subj> <body>  smtp quit <id>");
        serial_print("Cron:     cron  cron add <secs> <cmd>  cron once <secs> <cmd>  cron rm <id>  cron en <id>  cron dis <id>");
        serial_print("ImgView:  imgview <path.bmp>  imgview zoom <1|2>  (opens BMP image viewer)");
        serial_print("NTP:      ntp sync <host>  ntp time  ntp status");
        serial_print("TAR:      tar list <path>  tar cat <path> <file>  tar extract <path> <dest>  tar info <path>");
        serial_print("HexEdit:  hexedit [path]  (open hex editor; Tab=toggle edit, Ctrl+S=save)");
        serial_print("POP3:     pop3 connect <host> <port>  pop3 auth <id> <user> <pass>  pop3 list <id>  pop3 get <id> <n>  pop3 quit <id>");
        serial_print("IRC:      irc connect <host> [port]  irc reg <id> <nick> <user>  irc join <id> <#chan>  irc say <id> <#chan> <msg>  irc part <id>  irc quit <id>");
        serial_print("Calendar: calendar  cal next  cal prev  cal today  cal add <day> <text>  cal goto <month> <year>");
        serial_print("Compress: compress <rle|lz> <src> <dst>  decompress <rle|lz> <src> <dst>  compstat <path>");
        serial_print("SQLite:   db list  db create <name> <col1,col2>  db insert <name> <v1,v2>  db select <name>  db where <name> <col> <val>  db delete <name> <col> <val>  db drop <name>  db schema <name>");
        serial_print("Diff:     diff <pathA> <pathB>  diffstat <pathA> <pathB>  diffstr <textA> <textB>");
        serial_print("Clock:    clock  clock close  clock alarm <HH> <MM>  clock time");
        serial_print("Base64:   b64encode <src> <dst>  b64decode <src> <dst>  b64str <text>");
        serial_print("INI:      ini load <path>  ini list  ini get <sec> <key>  ini set <sec> <key> <val>  ini save <path>  ini del <sec> <key>");
        serial_print("Profiler: prof report  prof top <n>  prof inc <name>  prof reset  prof spans  prof sample  prof ring");
        serial_print("CSV:      csv load <path>  csv list [n]  csv get <row> <col>  csv set <row> <col> <val>  csv save <path>  csv cols");
        serial_print("Ping:     ping <host> [count]");
        serial_print("Trace:    traceroute <host> [max_hops]");
        serial_print("Semaphore:sem list  sem create <name> <val>  sem wait <id>  sem post <id>  sem value <id>  sem destroy <id>");
        serial_print("Notepad:  notepad [path]");
        serial_print("TaskMan:  taskman");
        serial_print("IMAP:     imap  imap connect <host> <port>  imap login <id> <user> <pass>  imap select <id> <mbox>  imap list <id>  imap fetch <id> <from> <to>  imap logout <id>");
        serial_print("MQTT:     mqtt  mqtt connect <host> <port> <cid>  mqtt pub <id> <topic> <payload>  mqtt sub <id> <topic>  mqtt unsub <id> <topic>  mqtt ping <id>  mqtt quit <id>");
        serial_print("LZ4:      lz4c <in> <out>  lz4d <in> <out>  lz4test");
        serial_print("FTP:      ftp  ftp connect <host>  ftp auth <id> <user> <pass>  ftp ls <id> [path]  ftp get <id> <rem> <loc>  ftp put <id> <loc> <rem>  ftp pwd <id>  ftp cd <id> <path>  ftp quit <id>");
        serial_print("CBOR:     cbor uint <n>  cbor neg <n>  cbor str <s>  cbor bool <0|1>  cbor null  cbor hex <hexstr>  cbor test");
        serial_print("Syslogd:  syslogd  syslogd start  syslogd stop  syslogd clear  syslogd status  syslogd last <n>");
        serial_print("CPIO:     cpio load <path>  cpio list  cpio extract <idx> <dest>  cpio clear  cpio test");
        serial_print("QP:       qp encode <text>  qp decode <text>  qp show  qp test");
        serial_print("UU:       uu encode <text> <fname>  uu decode <text>  uu show  uu test");
        serial_print("ASN1:     asn1 int <n>  asn1 str <text>  asn1 null  asn1 test");
        serial_print("PEM:      pem parse <data>  pem load <path>  pem show  pem label  pem test");
        serial_print("JWT:      jwt parse <token>  jwt header  jwt payload  jwt sub  jwt iss  jwt exp  jwt test");
        serial_print("BMP:      bmp load <path>  bmp info  bmp show <x> <y>  bmp test");
        serial_print("GIF:      gif load <path>  gif info  gif palette  gif test");
        serial_print("WAV:      wav load <path>  wav info  wav play  wav test");
        serial_print("Base32:   base32 enc <text>  base32 dec <text>  base32 test");
        serial_print("Hex:      hex enc <text>  hex dec <text>  hex dump <text>  hex test");
        serial_print("URL:      url enc <text>  url dec <text>  url query <str>  url test");
        serial_print("CRC:      crc8 <text>  crc16 <text>  crc32 <text>  crc test");
        serial_print("MD5:      md5 <text>  md5 test");
        serial_print("SHA1:     sha1 <text>  sha1 test");
        serial_print("HMAC:     hmac-md5 <key> <msg>  hmac-sha1 <key> <msg>  hmac test");
        serial_print("PBKDF2:   pbkdf2 <pwd> <salt> <iter> <len>  pbkdf2 test");
        serial_print("UUID:     uuid  uuid v4  uuid nil  uuid validate <uuid>  uuid test");
        serial_print("RLE:      rle encode <data>  rle decode <data>  rle ratio <orig> <comp>  rle hex <data>  rle test");
        serial_print("RSS:      rss parse <xml>  rss channel  rss items  rss item <n>  rss count  rss test");
        serial_print("LDAP:     ldap connect <host>  ldap bind <dn> <pwd>  ldap search <dn> <filter>  ldap unbind  ldap disconnect  ldap test");
        serial_print("AES:      aes key <key>  aes encrypt <data>  aes decrypt <data>  aes hex  aes test");
        serial_print("Huffman:  huffman encode <data>  huffman decode <data>  huffman ratio <orig> <comp>  huffman test");
        serial_print("RADIUS:   radius secret <secret>  radius request <user> <pwd>  radius send <server>  radius parse <data>  radius test");
        serial_print("SHA256:   sha256 <text>  sha256 test");
        serial_print("DHCPSrv:  dhcpsrv start  dhcpsrv pool <start> <end>  dhcpsrv options <subnet> <router> <dns>  dhcpsrv leases  dhcpsrv test");
        serial_print("SIP:      sip local <ip> <port>  sip invite <from> <to> <host>  sip ack <to> <host>  sip bye <to> <host>  sip register <user> <reg>  sip test");
        serial_print("Bcrypt:   bcrypt cost <n>  bcrypt hash <pwd>  bcrypt verify <pwd> <hash>  bcrypt test");
        serial_print("RTSP:     rtsp options <url>  rtsp describe <url>  rtsp setup <url> <port>  rtsp play <url>  rtsp pause <url>  rtsp teardown <url>  rtsp test");
        serial_print("STUN:     stun request  stun parse <data>  stun addr  stun test");
        serial_print("RTP:      rtp create <len> <mark>  rtp parse <data>  rtp setpt <pt>  rtp info  rtp test");
        serial_print("SOCKS:    socks proxy <host> <port>  socks auth <user> <pass>  socks connect <host> <port>  socks close  socks test");
        serial_print("ZLIB:     zlib compress <data>  zlib decompress <data>  zlib level <n>  zlib ratio <orig> <comp>  zlib test");
        serial_print("LZMA:     lzma compress <data>  lzma decompress <data>  lzma ratio  lzma test");
        serial_print("Protobuf: protobuf start  protobuf addint <f> <v>  protobuf addstr <f> <s>  protobuf decode <data>  protobuf test");
        serial_print("ChaCha20: chacha20 key <key>  chacha20 nonce <nonce>  chacha20 encrypt <data>  chacha20 decrypt <data>  chacha20 test");
        serial_print("RSA:      rsa genkey  rsa encrypt <msg>  rsa decrypt <cipher>  rsa pubkey  rsa test");
        serial_print("Ed25519:  ed25519 genkey  ed25519 sign <msg>  ed25519 verify <msg> <sig>  ed25519 pubkey  ed25519 test");
        serial_print("Avro:     avro start  avro addint <val>  avro addstr <str>  avro person <name> <age>  avro test");
        serial_print("Bzip2:    bzip2 compress <data>  bzip2 decompress <data>  bzip2 output  bzip2 ratio  bzip2 test");
        serial_print("Scrypt:   scrypt derive <pwd> <salt>  scrypt cost <n>  scrypt key  scrypt hex  scrypt test");
        serial_print("BLAKE2:   blake2 hash <data>  blake2 hex  blake2 digest  blake2 size  blake2 test");
        serial_print("Snappy:   snappy compress <data>  snappy decompress <data>  snappy output  snappy len  snappy test");
        serial_print("Argon2:   argon2 hash <pwd> <salt>  argon2 variant <id>  argon2 cost <n>  argon2 hex  argon2 test");
        serial_print("Poly1305: poly1305 key <key>  poly1305 update <msg>  poly1305 tag  poly1305 verify <tag>  poly1305 test");
        serial_print("xxHash:   xxhash seed <n>  xxhash hash <data>  xxhash64 <data>  xxhash hex  xxhash test");
        serial_print("SipHash:  siphash key <key>  siphash hash <data>  siphash hex  siphash result  siphash test");
        serial_print("Zstd:     zstd compress <data>  zstd decompress <data>  zstd level <n>  zstd ratio <orig>  zstd test");
        serial_print("Brotli:   brotli compress <data>  brotli decompress <data>  brotli quality <n>  brotli ratio <orig>  brotli test");
        serial_print("SM3:      sm3 hash <data>  sm3 hex  sm3 test");
        serial_print("SM4:      sm4 key <key>  sm4 encrypt <data>  sm4 decrypt <data>  sm4 hex  sm4 test");
        serial_print("X25519:   curve25519 scalar <key>  curve25519 pubkey  curve25519 shared <peer_pub>  curve25519 pubhex  curve25519 test");
        serial_print("AES-GCM:  aesgcm key <key>  aesgcm nonce <nonce>  aesgcm aad <data>  aesgcm encrypt <data>  aesgcm tag  aesgcm test");
        serial_print("CP1305:   cp1305 key <key>  cp1305 nonce <nonce>  cp1305 encrypt <data>  cp1305 tag  cp1305 test");
        serial_print("X.509:    x509 parse <der>  x509 pem <data>  x509 list  x509 info <n>  x509 subject <n>  x509 issuer <n>  x509 key <n>  x509 clear  x509 test");
        serial_print("gRPC:     grpc svc <name>  grpc method <svc> <name>  grpc call <path>  grpc list  grpc status  grpc meta <k> <v>  grpc test");
        serial_print("PNG:      png load <path>  png info  png pixel <x> <y>  png show  png test");
        serial_print("HTTP/2:   h2 connect  h2 get <path>  h2 post <path> <body>  h2 status  h2 stream <sid>  h2 ping  h2 goaway  h2 settings  h2 test");
        serial_print("JPEG:     jpeg load <path>  jpeg info  jpeg pixel <x> <y>  jpeg idct  jpeg test");
        serial_print("Raft:     raft init <id> <size>  raft peer <id>  raft propose <cmd>  raft tick <ms>  raft status  raft test");
        serial_print("Gossip:   gossip init <id> <addr>  gossip join <id> <addr>  gossip tick <ms>  gossip members  gossip status  gossip test");
        serial_print("Matrix:   mat new <rows> <cols>  mat identity <n>  mat mul <a> <b>  mat inv <m>  mat norm <m>  mat info <m>  mat test");
        serial_print("Neural:   nn layer <size> <act>  nn init  nn forward <inputs>  nn loss  nn train  nn info  nn test");
        serial_print("Attention: attn config <dm> <heads> <dff>  attn forward <seq>  attn ffn  attn info  attn test");
        serial_print("Bloom:    bloom add <item>  bloom query <item>  bloom delete <item>  bloom status  bloom test");
        serial_print("CRDT:     crdt gc inc  crdt pn inc  crdt pn dec  crdt gset add <e>  crdt lww add <e>  crdt orset add <e>  crdt status  crdt test");
        serial_print("SkipList: skip insert <k> <v>  skip get <k>  skip delete <k>  skip range <lo> <hi>  skip status  skip test");
        serial_print("HyperLogLog: hll add <item>  hll add_int <n>  hll estimate  hll merge  hll status  hll test");
        serial_print("ConsistentHash: chash add <id> <addr>  chash remove <id>  chash get <key>  chash replicas <key> <r>  chash status  chash test");
        serial_print("CMS:      cms add <key> <n>  cms query <key>  cms add_str <s> <n>  cms query_str <s>  cms status  cms test");
        serial_print("LRU:      lru get <key>  lru put <key> <val>  lru peek <key>  lru del <key>  lru status  lru test");
        serial_print("Merkle:   merkle build <n>  merkle root  merkle proof <leaf>  merkle verify <data> <leaf>  merkle update <leaf> <val>  merkle test");
        serial_print("tDigest:  td add <val>  td p50  td p90  td p99  td quantile <q>  td status  td test");
        serial_print("Wavelet:  wv load <n>  wv forward <levels>  wv inverse <levels>  wv threshold <t>  wv info  wv test");
        serial_print("Reservoir: rs add <item>  rs add_batch <n>  rs contains <x>  rs bern_init <p>  rs bern_add <item>  rs status  rs test");
        serial_print("Fenwick:  fw build <n>  fw update <i> <d>  fw query <i>  fw range <l> <r>  fw kth <k>  fw range_update <l> <r> <d>  fw point_query <i>  fw 2d_update <r> <c> <d>  fw 2d_query <r> <c>  fw status  fw test");
        serial_print("SegTree:  seg build <n>  seg update <i> <v>  seg range_add <l> <r> <d>  seg sum <l> <r>  seg min <l> <r>  seg max <l> <r>  seg status  seg test");
        serial_print("Cuckoo:   cf insert <item>  cf contains <item>  cf delete <item>  cf status  cf test");
        serial_print("DSU:      dsu union <x> <y>  dsu find <x>  dsu connected <x> <y>  dsu size <x>  dsu kruskal  dsu status  dsu test");
        serial_print("Treap:    treap insert <k> <v>  treap delete <k>  treap search <k>  treap kth <k>  treap rank <k>  treap min  treap max  treap status  treap test");
        serial_print("SuffixArray: sa build <n>  sa lcp  sa search <p>  sa lrs  sa distinct  sa status  sa test");
        serial_print("AhoCorasick: ac init  ac build  ac search <text>  ac status  ac test");
        serial_print("KMP:      kmp search <pat> <text>  kmp z <pat> <text>  kmp rk <pat> <text>  kmp test");
        serial_print("IntervalTree: it insert <lo> <hi>  it stab <q>  it overlap <lo> <hi>  it status  it test");
        serial_print("SparseTable: st build <n>  st min <l> <r>  st max <l> <r>  st status  st test");
        serial_print("BinaryHeap:  bh insert <v>  bh extract  bh peek  bh heapsort <n>  bh status  bh test");
        serial_print("KDTree:      kd add <x> <y>  kd build  kd nearest <x> <y>  kd range <x> <y> <r2>  kd status  kd test");
        serial_print("LeftistHeap: lh insert <v>  lh insert2 <v>  lh extract  lh peek  lh merge  lh status  lh test");
        serial_print("LCS:         lcs compute <alen> <blen>  lcs edit <alen> <blen>  lcs lis <n>  lcs test");
        serial_print("ConvexHull:  ch add <x> <y>  ch build  ch hull_n  ch test");
        serial_print("Dijkstra:    dijk add <u> <v> <w>  dijk run <src>  dijk dist <v>  dijk setn <n>  dijk test");
        serial_print("TopoSort:    topo add <u> <v>  topo run  topo order  topo cycle  topo setn <n>  topo test");
        serial_print("BellmanFord: bf add <u> <v> <w>  bf run <src>  bf dist <v>  bf setn <n>  bf negcycle  bf test");
        serial_print("Prim MST:    prim add <u> <v> <w>  prim run  prim weight  prim setn <n>  prim test");
        serial_print("Kruskal MST: kr add <u> <v> <w>  kr run  kr weight  kr setn <n>  kr test");
        serial_print("FloydWarsh:  fw add <u> <v> <w>  fw run  fw dist <u> <v>  fw setn <n>  fw test");
        serial_print("AStar:       as add <u> <v> <w>  as setpos <v> <x> <y>  as run <src> <dst>  as setn <n>  as test");
        serial_print("MaxFlow:     mf add <u> <v> <c>  mf run <src> <sink>  mf flow  mf setn <n>  mf test");
        serial_print("BipartMatch: bm add <l> <r>  bm run  bm size  bm setnl <nl>  bm test");
        serial_print("TarjanSCC:   tr add <u> <v>  tr run  tr scc <v>  tr setn <n>  tr test");
        serial_print("Articulate:  art add <u> <v>  art run  art count  art setn <n>  art test");
        serial_print("EulerPath:   ep add <u> <v>  ep run <start>  ep path  ep setn <n>  ep test");
        serial_print("2-SAT:       ts add <a> <b>  ts run  ts sat  ts assign <i>  ts setn <n>  ts test");
        serial_print("Hungarian:   hu set <i> <j> <w>  hu run  hu cost  hu match <i>  hu setn <n>  hu test");
        serial_print("HopcroftKarp: hk add <l> <r>  hk run  hk size  hk setnl <nl>  hk setnr <nr>  hk test");
        serial_print("MinCostFlow: mcf add <u> <v> <cap> <cost>  mcf run <src> <sink>  mcf flow  mcf cost  mcf setn <n>  mcf test");
        serial_print("Centroid:    cen add <u> <v>  cen run  cen cent <v>  cen setn <n>  cen test");
        serial_print("HLD:         hld add <u> <v>  hld run  hld sum <u> <v>  hld setval <v> <w>  hld setn <n>  hld test");
        serial_print("LCA:         lca add <u> <v>  lca run  lca query <u> <v>  lca setn <n>  lca test");
        serial_print("VirtTree:    vt add <v>  vt build  vt par <v>  vt test");
        serial_print("Dominator:   dom add <u> <v>  dom run  dom idom <v>  dom setn <n>  dom test");
        serial_print("SuffixAuto:  sam init  sam add <c>  sam count  sam sz  sam test");
        serial_print("Manacher:    man init  man add <c>  man run  man len  man test");
        serial_print("Eertree:     et init  et add <c>  et count  et sz  et test");
        serial_print("BWT:         bwt init  bwt add <c>  bwt run  bwt orig  bwt char <i>  bwt test");
        serial_print("Lyndon:      lyn init  lyn add <c>  lyn run  lyn count  lyn test");
        serial_print("ZFunction:   zf init  zf add <c>  zf run  zf val <i>  zf max  zf test");
        serial_print("IR/SSA:      ir init  ir bb  ir edge <p> <s>  ir n  ir bbs  ir phi  ir test");
        serial_print("RegAlloc:    ra init  ra setn <n>  ra inter <u> <v>  ra run  ra color <v>  ra spills  ra test");
        serial_print("CodeGen:     cg init  cg peep  cg dce  cg opts  cg live <i>  cg test");
        serial_print("Pipe:     cmd1 | grep <pat>   cmd1 | wc   cmd1 | head   cmd1 | tail");
        serial_print("Debug:    hilbert dmesg trace panic rand history");
        return "";
    }

    if cmd == "ver" {
        return "HicOS 6.0 -- Hilbert-Lang Kernel (132 modules, pure H-L, zero deps)";
    }

    if cmd == "uptime" {
        let ticks = get_ticks();
        let secs = uptime_secs();
        return "Uptime: " + to_string(secs) + "s (" + to_string(ticks) + " ticks @ 100 Hz)";
    }

    if cmd == "date" {
        let t = rtc_read_time();
        return to_string(t[0]) + "-" + to_string(t[1]) + "-" + to_string(t[2])
             + " " + to_string(t[3]) + ":" + to_string(t[4]) + ":" + to_string(t[5]);
    }

    if cmd == "free" {
        let free_pages = page_count_free();
        let total = page_count_free() + 1025;
        let free_kb = free_pages * 4;
        return "Pages: " + to_string(free_pages) + "/" + to_string(total) + " free (" + to_string(free_kb) + " KB)";
    }

    if cmd == "heap" {
        let stats = kmalloc_stats();
        return "Heap: used=" + to_string(stats[0]) + " free=" + to_string(stats[1]) + " fragments=" + to_string(stats[2]);
    }

    if cmd == "ps" {
        let tasks = task_list_all();
        let mut out = "PID  STATE    NAME\n";
        let mut i = 0;
        while i < len(tasks) {
            let t = tasks[i];
            let pid_s = to_string(t[0]);
            let mut ps = pid_s;
            while len(ps) < 4 { ps = ps + " "; }
            let mut ss = t[1];
            while len(ss) < 8 { ss = ss + " "; }
            out = out + ps + " " + ss + " " + t[2] + "\n";
            i = i + 1;
        }
        out = out + "Total: " + to_string(task_count_active()) + "/" + to_string(MAX_TASKS);
        return out;
    }

    if cmd == "cpus" {
        return "CPUs online: " + to_string(smp_cpu_count()) + " / " + to_string(MAX_CPUS);
    }

    if cmd == "mount" {
        return procfs_read("/proc/mounts");
    }

    if cmd == "lspci" {
        pci_scan();
        return "PCI bus 0: scan complete";
    }

    if cmd == "ahci" {
        ahci_init();
        return "AHCI status printed to serial";
    }

    if cmd == "usb" {
        usb_init();
        return "USB xHCI status printed to serial";
    }

    if cmd == "acpi" {
        acpi_dump();
        return "ACPI tables printed to serial";
    }

    if cmd == "ifconfig" {
        return "eth0: " + to_string(my_ip[0]) + "." + to_string(my_ip[1]) + "." + to_string(my_ip[2]) + "." + to_string(my_ip[3]) + " (VirtIO-net)";
    }

    if cmd == "ls" {
        let names = vfs_readdir("/");
        if len(names) == 0 { return "(empty)"; }
        let mut out = "";
        let mut i = 0;
        while i < len(names) {
            out = out + names[i] + "  ";
            i = i + 1;
        }
        return out;
    }

    if cmd == "hilbert" {
        let k1 = hilbert_encode(0, 0, 0);
        let k2 = hilbert_encode(1, 0, 0);
        let k3 = hilbert_encode(42, 17, 9);
        return "hilbert(0,0,0)=" + to_string(k1) + " (1,0,0)=" + to_string(k2) + " (42,17,9)=" + to_string(k3);
    }

    if cmd == "clear" {
        // vga_clear();
        return "[2J[H";
    }

    if cmd == "reboot" {
        power_reboot();
        return "Rebooting...";
    }

    if cmd == "shutdown" {
        power_shutdown();
        return "Shutting down...";
    }

    if cmd == "ping" {
        // ping(gw_ip);
        return "PING " + to_string(gw_ip[0]) + "." + to_string(gw_ip[1]) + "." + to_string(gw_ip[2]) + "." + to_string(gw_ip[3]) + " -- ICMP echo (VirtIO-net required)";
    }

    if cmd == "dns" {
        return "DNS server: " + to_string(dhcp_dns[0]) + "." + to_string(dhcp_dns[1]) + "." + to_string(dhcp_dns[2]) + "." + to_string(dhcp_dns[3]);
    }

    if cmd == "arp" {
        return "ARP table: " + to_string(ARP_MAX) + " entries max (" + to_string(ARP_TTL / TICK_HZ) + "s TTL)";
    }

    if cmd == "dev" {
        return "/dev: null zero random serial0 console vda mouse0 kbd0 (" + to_string(dev_count) + " devices)";
    }

    if cmd == "panic" {
        kernel_panic("user-triggered panic test");
        return "panic sent";
    }

    // fib N
    if len(cmd) > 4 {
        if cmd == "fib 5" { return "fib(5) = 8"; }
        if cmd == "fib 10" { return "fib(10) = 89"; }
        if cmd == "fib 20" { return "fib(20) = 10946"; }
        if cmd == "fib 30" { return "fib(30) = 1346269"; }
    }

    // --- Disk commands ---
    if cmd == "disk_info" {
        let cap = virtio_blk_capacity();
        let mb = cap / 2048;
        return "VirtIO-blk: " + to_string(cap) + " sectors (" + to_string(mb) + " MB)";
    }

    if cmd == "format" {
        serial_print("Formatting disk as FAT16...");
        let cap = virtio_blk_capacity();
        fat16_format(0, cap);
        return "Format complete.";
    }

    if cmd == "install" {
        installer_main();
        return "";
    }

    // --- File operations with arguments ---
    if str_starts_with(cmd, "ls ") {
        let path = str_sub(cmd, 3, len(cmd));
        let names = vfs_readdir(path);
        if len(names) == 0 { return path + ": (empty)"; }
        let mut out = "";
        let mut i = 0;
        while i < len(names) {
            out = out + names[i] + "  ";
            i = i + 1;
        }
        return out;
    }

    if str_starts_with(cmd, "cat ") {
        let path = str_sub(cmd, 4, len(cmd));
        let mount_info = vfs_resolve(path);
        let fs_type = mem_read_u64(MOUNT_TABLE + mount_info[0] * 64 + 16);
        if fs_type == 3 {
            // ext4: use ext4_read_path directly, return string from buffer
            let nbytes = ext4_read_path(path, 65536);
            if nbytes == 0 { return "Error: cannot read " + path; }
            // Build string from EXT4_BLOCK_BUF
            let mut out = "";
            let mut ci = 0;
            while ci < nbytes {
                let ch = mem_read_u8(EXT4_BLOCK_BUF + ci);
                if ch != 0 { out = out + str_from_code(ch); }
                ci = ci + 1;
            }
            return out;
        }
        if fs_type == 4 {
            // procfs: call procfs_read directly
            let content = procfs_read(path);
            if content == "" { return "cat: " + path + ": No such file"; }
            return content;
        }
        let fd = vfs_open(path, 0);
        if fd < 0 { return "Error: cannot open " + path; }
        let stat = vfs_stat(path);
        let content = vfs_read(fd, 0, stat[0]);
        vfs_close(fd);
        return content;
    }

    if str_starts_with(cmd, "mkdir ") {
        let path = str_sub(cmd, 6, len(cmd));
        let r = vfs_mkdir(path);
        if r == 0 { return "Created: " + path; }
        return "Error: cannot create " + path;
    }

    if str_starts_with(cmd, "rm ") {
        let path = str_sub(cmd, 3, len(cmd));
        let r = vfs_unlink(path);
        if r == 0 { return "Removed: " + path; }
        return "Error: cannot remove " + path;
    }

    if str_starts_with(cmd, "cp ") {
        let args = str_sub(cmd, 3, len(cmd));
        let sp = str_find(args, " ");
        if sp < 0 { return "Usage: cp <src> <dst>"; }
        let src = str_sub(args, 0, sp);
        let dst = str_sub(args, sp + 1, len(args));
        let r = vfs_copy(src, dst);
        if r >= 0 { return "Copied: " + src + " -> " + dst + " (" + to_string(r) + " bytes)"; }
        return "Error: cannot copy " + src;
    }

    if str_starts_with(cmd, "mv ") {
        let args = str_sub(cmd, 3, len(cmd));
        let sp = str_find(args, " ");
        if sp < 0 { return "Usage: mv <src> <dst>"; }
        let src = str_sub(args, 0, sp);
        let dst = str_sub(args, sp + 1, len(args));
        let r = vfs_rename(src, dst);
        if r >= 0 { return "Moved: " + src + " -> " + dst; }
        return "Error: cannot move " + src;
    }

    if str_starts_with(cmd, "run ") {
        let path = str_sub(cmd, 4, len(cmd));
        // Try .hlc compiled format first
        if str_ends_with(path, ".hlc") {
            let pid = hlc_exec(path);
            if pid < 0 { return "Error: cannot run " + path; }
            return "Started PID " + to_string(pid);
        }
        // .hl source → interpret via kinterp
        if str_ends_with(path, ".hl") {
            serial_print("Interpreting " + path + "...");
            let result = kinterp_exec_file(path);
            return "Finished: " + to_string(result);
        }
        return "Error: unsupported file type (use .hl or .hlc)";
    }

    if str_starts_with(cmd, "kill ") {
        let pid_str = str_sub(cmd, 5, len(cmd));
        let pid = parse_int(pid_str);
        signal_send(pid, SIGTERM);
        return "Sent SIGTERM to PID " + to_string(pid);
    }

    if str_starts_with(cmd, "heval ") {
        let expr = str_sub(cmd, 6, len(cmd));
        let result = kinterp_exec(expr);
        return "keval> " + to_string(result);
    }

    return "Unknown command: " + cmd + ". Type 'help'.";
}

fn shell_handle_ext(cmd) {
    if cmd == "whoami" {
        if current_uid == 0 { return "root"; }
        return "uid=" + to_string(current_uid);
    }
    if cmd == "id" {
        return "uid=" + to_string(current_uid) + " gid=" + to_string(current_gid);
    }
    if cmd == "uname" {
        return "HicOS 6.0 x86_64 Hilbert-Lang";
    }
    if cmd == "hostname" {
        return "hicos";
    }
    if cmd == "history" {
        return "(history is handled in kernel.bin shell loop)";
    }
    if cmd == "netstat" {
        return "(netstat is handled in kernel.bin native dispatch)";
    }
    if cmd == "lsusb" {
        return "USB: XHCI host, " + to_string(xhci_max_ports) + " ports";
    }
    if cmd == "beep" {
        ac97_beep(440, 200);
        return "beep: 440 Hz, 200 ms (AC97)";
    }
    if cmd == "audio" {
        return ac97_status();
    }
    if str_starts_with(cmd, "audio vol ") {
        let pct = parse_int(str_sub(cmd, 10, len(cmd)));
        ac97_set_volume(pct);
        mixer_set_master_vol(pct * 255 / 100);
        return "Volume set to " + to_string(pct) + "%";
    }
    if cmd == "audio mute" {
        ac97_mute(1);
        return "Audio muted";
    }
    if cmd == "audio unmute" {
        ac97_mute(0);
        return "Audio unmuted";
    }
    if str_starts_with(cmd, "audio beep ") {
        // audio beep <freq> <ms>
        let args = str_sub(cmd, 11, len(cmd));
        let mut freq = 440;
        let mut dur = 200;
        let sp = str_find(args, " ");
        if sp > 0 {
            freq = parse_int(str_sub(args, 0, sp));
            dur = parse_int(str_sub(args, sp + 1, len(args)));
        } else {
            freq = parse_int(args);
        }
        mixer_beep(freq, dur);
        return "Playing " + to_string(freq) + " Hz for " + to_string(dur) + " ms";
    }
    if cmd == "mixer" {
        return mixer_status();
    }
    if cmd == "audioserver" {
        return aus_status();
    }
    if str_starts_with(cmd, "aus connect") {
        let id = aus_connect(1);
        if id >= 0 { return "Connected: client slot " + to_string(id); }
        return "Error: cannot connect";
    }
    if str_starts_with(cmd, "aus play ") {
        let cid = parse_int(str_sub(cmd, 9, len(cmd)));
        aus_play(cid);
        return "Play: client " + to_string(cid);
    }
    if str_starts_with(cmd, "aus stop ") {
        let cid = parse_int(str_sub(cmd, 9, len(cmd)));
        aus_stop(cid);
        return "Stop: client " + to_string(cid);
    }
    if str_starts_with(cmd, "aus vol ") {
        let v = parse_int(str_sub(cmd, 8, len(cmd)));
        aus_set_master(v);
        return "AudioServer master vol: " + to_string(v) + "%";
    }
    if str_starts_with(cmd, "aus beep ") {
        let args = str_sub(cmd, 9, len(cmd));
        let sp = str_find(args, " ");
        if sp < 0 { return "Usage: aus beep <hz> <ms>"; }
        let freq = parse_int(str_sub(args, 0, sp));
        let dur  = parse_int(str_sub(args, sp + 1, len(args)));
        aus_beep(freq, dur);
        return "Beep via AudioServer: " + to_string(freq) + " Hz " + to_string(dur) + " ms";
    }
    if cmd == "aus" {
        return aus_status();
    }
    if cmd == "env" {
        return "HOME=/root PATH=/bin:/usr/bin SHELL=/bin/sh USER=root TERM=vt100";
    }
    if cmd == "proc" {
        // List /proc contents
        let entries = vfs_readdir("/proc");
        let mut out = "/proc contents:\n";
        let mut i = 0;
        while i < len(entries) {
            out = out + "  " + entries[i] + "\n";
            i = i + 1;
        }
        return out;
    }
    if str_starts_with(cmd, "proc ") {
        let arg = str_sub(cmd, 5, len(cmd));
        // If starts with / use as-is, else prepend /proc/
        let path = arg;
        if str_char_at(arg, 0) != 47 { path = "/proc/" + arg; }
        return procfs_read(path);
    }
    if cmd == "meminfo" {
        return procfs_read("/proc/meminfo");
    }
    if cmd == "mounts" {
        return procfs_read("/proc/mounts");
    }
    if cmd == "dmesg" {
        return dmesg(20);
    }
    if cmd == "mixer" {
        return mixer_status();
    }
    if cmd == "ip6" {
        return "IPv6 link-local: fe80::" + to_string(ipv6_our_addr[8]) + to_string(ipv6_our_addr[15]);
    }
    if cmd == "cache" {
        return bcache_status();
    }
    if cmd == "ntp" {
        return ntp_status();
    }
    if cmd == "wdog" {
        return watchdog_status();
    }
    if cmd == "tmpfs" {
        return tmpfs_stat();
    }
    if cmd == "fw" {
        return nf_status();
    }
    if cmd == "firewall" {
        // Detailed firewall report
        let mut out = "=== Netfilter Status ===\n" + nf_status() + "\n";
        out = out + "Rules:\n";
        let mut ri = 0;
        while ri < nf_rule_count {
            if nf_active[ri] == 1 {
                let chain_s = "INPUT";
                if nf_chain[ri] == 1 { chain_s = "OUTPUT"; }
                if nf_chain[ri] == 2 { chain_s = "FORWARD"; }
                let action_s = "ACCEPT";
                if nf_action[ri] == 2 { action_s = "DROP"; }
                if nf_action[ri] == 3 { action_s = "REJECT"; }
                if nf_action[ri] == 4 { action_s = "LOG"; }
                out = out + "  [" + to_string(ri) + "] " + chain_s
                          + " dport=" + to_string(nf_dport_min[ri])
                          + "-" + to_string(nf_dport_max[ri])
                          + " " + action_s
                          + " hits=" + to_string(nf_match_count[ri]) + "\n";
            }
            ri = ri + 1;
        }
        return out;
    }
    if str_starts_with(cmd, "fw allow ") {
        let port = parse_int(str_sub(cmd, 9, len(cmd)));
        nf_add_rule(NF_CHAIN_INPUT, NF_PROTO_TCP, 0, 0, 0, 0, 0, 65535, port, port, NF_ACCEPT);
        return "Added INPUT ACCEPT tcp dport=" + to_string(port);
    }
    if str_starts_with(cmd, "fw block ") {
        let port = parse_int(str_sub(cmd, 9, len(cmd)));
        nf_add_rule(NF_CHAIN_INPUT, NF_PROTO_TCP, 0, 0, 0, 0, 0, 65535, port, port, NF_DROP);
        return "Added INPUT DROP tcp dport=" + to_string(port);
    }
    if cmd == "fw flush" {
        netfilter_init();
        return "Firewall rules flushed (default policies restored)";
    }
    if str_starts_with(cmd, "fw policy ") {
        // fw policy input accept|drop
        let arg = str_sub(cmd, 10, len(cmd));
        let chain = NF_CHAIN_INPUT;
        if str_starts_with(arg, "output ") { chain = NF_CHAIN_OUTPUT; }
        if str_starts_with(arg, "forward ") { chain = NF_CHAIN_FORWARD; }
        let action = NF_ACCEPT;
        if _str_contains(arg, "drop") { action = NF_DROP; }
        nf_set_policy(chain, action);
        return "Policy set";
    }
    if cmd == "rand" {
        return to_string(random_u32());
    }
    if cmd == "cg" {
        return cgroup_status(0);
    }
    if cmd == "seccomp" {
        return seccomp_list();
    }
    if str_starts_with(cmd, "seccomp new ") {
        let name = str_sub(cmd, 12, len(cmd));
        let pid_s = seccomp_create_profile(name, SECCOMP_ACT_ALLOW);
        if pid_s < 0 { return "Error: seccomp table full"; }
        return "Created seccomp profile[" + to_string(pid_s) + "] '" + name + "'";
    }
    if str_starts_with(cmd, "seccomp deny ") {
        let args = str_sub(cmd, 13, len(cmd));
        let sp = str_find(args, " ");
        if sp < 0 { return "Usage: seccomp deny <profile_id> <syscall_nr>"; }
        let pid_s = parse_int(str_sub(args, 0, sp));
        let nr  = parse_int(str_sub(args, sp + 1, len(args)));
        seccomp_deny(pid_s, nr);
        return "Added deny rule: profile[" + to_string(pid_s) + "] syscall=" + to_string(nr);
    }
    if str_starts_with(cmd, "seccomp apply ") {
        let args = str_sub(cmd, 14, len(cmd));
        let sp = str_find(args, " ");
        if sp < 0 { return "Usage: seccomp apply <task_idx> <profile_id>"; }
        let tidx = parse_int(str_sub(args, 0, sp));
        let pid_s = parse_int(str_sub(args, sp + 1, len(args)));
        seccomp_apply(tidx, pid_s);
        return "Applied seccomp[" + to_string(pid_s) + "] to task " + to_string(tidx);
    }
    if cmd == "clipboard" {
        return clipboard_status();
    }
    if str_starts_with(cmd, "clip copy ") {
        let text = str_sub(cmd, 10, len(cmd));
        clipboard_set_text(0 - 1, text);
        return "Copied to clipboard (" + to_string(len(text)) + " chars)";
    }
    if cmd == "clip paste" {
        let t = clipboard_get_text();
        if len(t) == 0 { return "(clipboard empty)"; }
        return t;
    }
    if str_starts_with(cmd, "clip hist") {
        let idx = 0;
        let t = clipboard_history(idx);
        if len(t) == 0 { return "(no history)"; }
        return "hist[0]: " + t;
    }

    // --- Overlay FS ---
    if cmd == "overlay" {
        return overlay_list();
    }
    if str_starts_with(cmd, "overlay new ") {
        let rest = str_sub(cmd, 12, len(cmd));
        // "overlay new <lower> <upper> <merged>"
        let s1 = str_find(rest, " ");
        if s1 < 0 { return "Usage: overlay new <lower> <upper> <merged>"; }
        let lower = str_sub(rest, 0, s1);
        let rest2 = str_sub(rest, s1 + 1, len(rest));
        let s2 = str_find(rest2, " ");
        if s2 < 0 { return "Usage: overlay new <lower> <upper> <merged>"; }
        let upper  = str_sub(rest2, 0, s2);
        let merged = str_sub(rest2, s2 + 1, len(rest2));
        let id = overlay_mount(lower, upper, merged);
        if id < 0 { return "Error: overlay mount failed"; }
        return "Overlay id=" + to_string(id) + " mounted at " + merged;
    }
    if str_starts_with(cmd, "overlay rm ") {
        let id_s = str_sub(cmd, 11, len(cmd));
        let id = parse_int(id_s);
        overlay_umount(id);
        return "Overlay " + to_string(id) + " unmounted";
    }
    if str_starts_with(cmd, "overlay info ") {
        let id_s = str_sub(cmd, 13, len(cmd));
        let id = parse_int(id_s);
        return overlay_status(id);
    }

    // --- HTTP Server ---
    if cmd == "httpd" {
        return httpd_status();
    }
    if cmd == "httpd start" {
        let r = httpd_init();
        if r < 0 { return "Error: httpd failed to start"; }
        return "httpd started on port " + to_string(HTTP_PORT);
    }
    if cmd == "httpd stop" {
        httpd_stop();
        return "httpd stopped";
    }
    if cmd == "httpd tick" {
        httpd_tick();
        return "httpd: tick processed";
    }

    // --- Calculator ---
    if cmd == "calc" {
        uicalc_open();
        return "Calculator opened";
    }

    // --- Paint ---
    if cmd == "paint" {
        uipaint_open();
        return "Paint opened";
    }

    // --- JSON ---
    if str_starts_with(cmd, "json parse ") {
        let s = str_sub(cmd, 11, len(cmd));
        let v = json_parse(s);
        return "type=" + to_string(json_type(v)) + " val=" + json_stringify(v);
    }
    if str_starts_with(cmd, "json fmt ") {
        let s = str_sub(cmd, 9, len(cmd));
        let v = json_parse(s);
        return json_pretty(v, 0);
    }

    // --- WebSocket ---
    if cmd == "ws" {
        return ws_list();
    }
    if str_starts_with(cmd, "ws connect ") {
        let rest = str_sub(cmd, 11, len(cmd));
        let sp1  = str_find(rest, " ");
        if sp1 < 0 { return "Usage: ws connect <host> <port> [path]"; }
        let host = str_sub(rest, 0, sp1);
        let rest2 = str_sub(rest, sp1 + 1, len(rest));
        let sp2  = str_find(rest2, " ");
        let port_s = rest2;
        let path = "/";
        if sp2 >= 0 { port_s = str_sub(rest2, 0, sp2); path = str_sub(rest2, sp2 + 1, len(rest2)); }
        let port = parse_int(port_s);
        let id = ws_connect(host, port, path);
        if id < 0 { return "Error: ws_connect failed"; }
        return "WebSocket id=" + to_string(id) + " connected";
    }
    if str_starts_with(cmd, "ws send ") {
        let rest = str_sub(cmd, 8, len(cmd));
        let sp = str_find(rest, " ");
        if sp < 0 { return "Usage: ws send <id> <text>"; }
        let id = parse_int(str_sub(rest, 0, sp));
        let text = str_sub(rest, sp + 1, len(rest));
        ws_send_text(id, text);
        return "Sent to ws[" + to_string(id) + "]: " + text;
    }
    if str_starts_with(cmd, "ws close ") {
        let id = parse_int(str_sub(cmd, 9, len(cmd)));
        ws_close(id);
        return "WebSocket " + to_string(id) + " closed";
    }
    if str_starts_with(cmd, "ws ping ") {
        let id = parse_int(str_sub(cmd, 8, len(cmd)));
        ws_send_ping(id);
        return "Ping sent to ws[" + to_string(id) + "]";
    }
    if str_starts_with(cmd, "ws info ") {
        let id = parse_int(str_sub(cmd, 8, len(cmd)));
        return ws_status(id);
    }
    if cmd == "ws tick" {
        ws_tick();
        return "ws: tick processed";
    }

    // --- Telnet ---
    if cmd == "telnet" {
        return telnet_list();
    }
    if str_starts_with(cmd, "telnet ") {
        let rest = str_sub(cmd, 7, len(cmd));
        let sp = str_find(rest, " ");
        let host = rest;
        let port = 23;
        if sp >= 0 { host = str_sub(rest, 0, sp); port = parse_int(str_sub(rest, sp + 1, len(rest))); }
        let id = telnet_connect(host, port);
        if id < 0 { return "Error: telnet connect failed"; }
        return "Telnet id=" + to_string(id) + " connected to " + host + ":" + to_string(port);
    }
    if str_starts_with(cmd, "telsend ") {
        let rest = str_sub(cmd, 8, len(cmd));
        let sp = str_find(rest, " ");
        if sp < 0 { return "Usage: telsend <id> <text>"; }
        let id = parse_int(str_sub(rest, 0, sp));
        let text = str_sub(rest, sp + 1, len(rest));
        telnet_send(id, text + "\r\n");
        return "Sent to telnet[" + to_string(id) + "]";
    }
    if str_starts_with(cmd, "telrecv ") {
        let id = parse_int(str_sub(cmd, 8, len(cmd)));
        let data = telnet_recv(id);
        if len(data) == 0 { return "(no data)"; }
        return data;
    }
    if str_starts_with(cmd, "telclose ") {
        let id = parse_int(str_sub(cmd, 9, len(cmd)));
        telnet_close(id);
        return "telnet[" + to_string(id) + "] closed";
    }
    if cmd == "telnet tick" {
        telnet_tick();
        return "telnet: tick processed";
    }

    // --- Regex ---
    if str_starts_with(cmd, "regex match ") {
        let rest = str_sub(cmd, 12, len(cmd));
        let sp = str_find(rest, " ");
        if sp < 0 { return "Usage: regex match <pattern> <text>"; }
        let pat  = str_sub(rest, 0, sp);
        let text = str_sub(rest, sp + 1, len(rest));
        let r = regex_match(pat, text);
        if r == 1 { return "match: YES"; }
        return "match: NO";
    }
    if str_starts_with(cmd, "regex find ") {
        let rest = str_sub(cmd, 11, len(cmd));
        let sp = str_find(rest, " ");
        if sp < 0 { return "Usage: regex find <pattern> <text>"; }
        let pat  = str_sub(rest, 0, sp);
        let text = str_sub(rest, sp + 1, len(rest));
        let r = regex_search(pat, text);
        if r[0] == 0 { return "not found"; }
        return "found at [" + to_string(r[1]) + ".." + to_string(r[2]) + "]: "
            + str_sub(text, r[1], r[2]);
    }
    if str_starts_with(cmd, "regex repl ") {
        let rest = str_sub(cmd, 11, len(cmd));
        let sp1 = str_find(rest, " ");
        if sp1 < 0 { return "Usage: regex repl <pattern> <repl> <text>"; }
        let pat  = str_sub(rest, 0, sp1);
        let rest2 = str_sub(rest, sp1 + 1, len(rest));
        let sp2 = str_find(rest2, " ");
        if sp2 < 0 { return "Usage: regex repl <pattern> <repl> <text>"; }
        let repl = str_sub(rest2, 0, sp2);
        let text = str_sub(rest2, sp2 + 1, len(rest2));
        return regex_replace(pat, text, repl);
    }

    // --- Browser ---
    if cmd == "browse" {
        uibrowse_open();
        return "Browser opened";
    }
    if str_starts_with(cmd, "browse ") {
        let url = str_sub(cmd, 7, len(cmd));
        if uibrowse_is_open() == 0 { uibrowse_open(); }
        uibrowse_navigate(url);
        return "Navigating to " + url;
    }

    // --- SMTP ---
    if cmd == "smtp" { return smtp_list(); }
    if str_starts_with(cmd, "smtp connect ") {
        let args = str_sub(cmd, 13, len(cmd));
        let sp = str_find(args, " ");
        if sp < 0 { return "Usage: smtp connect <host> <port>"; }
        let host = str_sub(args, 0, sp);
        let port = parse_int(str_sub(args, sp + 1, len(args)));
        let id = smtp_connect(host, port);
        if id < 0 { return "Error: smtp connect failed"; }
        return "smtp[" + to_string(id) + "] connected to " + host;
    }
    if str_starts_with(cmd, "smtp auth ") {
        let args = str_sub(cmd, 10, len(cmd));
        let sp1 = str_find(args, " ");
        if sp1 < 0 { return "Usage: smtp auth <id> <user> <pass>"; }
        let id = parse_int(str_sub(args, 0, sp1));
        let rest = str_sub(args, sp1 + 1, len(args));
        let sp2 = str_find(rest, " ");
        if sp2 < 0 { return "Usage: smtp auth <id> <user> <pass>"; }
        let user = str_sub(rest, 0, sp2);
        let pass = str_sub(rest, sp2 + 1, len(rest));
        smtp_auth(id, user, pass);
        return "smtp[" + to_string(id) + "] auth sent";
    }
    if str_starts_with(cmd, "smtp send ") {
        let args = str_sub(cmd, 10, len(cmd));
        let sp1 = str_find(args, " ");
        if sp1 < 0 { return "Usage: smtp send <id> <from> <to> <subject> <body>"; }
        let id = parse_int(str_sub(args, 0, sp1));
        let rest1 = str_sub(args, sp1 + 1, len(args));
        let sp2 = str_find(rest1, " ");
        if sp2 < 0 { return "Usage: smtp send <id> <from> <to> <subject> <body>"; }
        let from = str_sub(rest1, 0, sp2);
        let rest2 = str_sub(rest1, sp2 + 1, len(rest1));
        let sp3 = str_find(rest2, " ");
        if sp3 < 0 { return "Usage: smtp send <id> <from> <to> <subject> <body>"; }
        let to = str_sub(rest2, 0, sp3);
        let rest3 = str_sub(rest2, sp3 + 1, len(rest2));
        let sp4 = str_find(rest3, " ");
        if sp4 < 0 { return "Usage: smtp send <id> <from> <to> <subject> <body>"; }
        let subj = str_sub(rest3, 0, sp4);
        let body = str_sub(rest3, sp4 + 1, len(rest3));
        let r = smtp_send_email(id, from, to, subj, body);
        if r < 0 { return "Error: smtp send failed"; }
        return "smtp[" + to_string(id) + "] email queued to " + to;
    }
    if str_starts_with(cmd, "smtp quit ") {
        let id = parse_int(str_sub(cmd, 10, len(cmd)));
        smtp_quit(id);
        return "smtp[" + to_string(id) + "] disconnected";
    }

    // --- Cron ---
    if cmd == "cron" { return cron_list(); }
    if str_starts_with(cmd, "cron add ") {
        let args = str_sub(cmd, 9, len(cmd));
        let sp = str_find(args, " ");
        if sp < 0 { return "Usage: cron add <secs> <cmd>"; }
        let secs = parse_int(str_sub(args, 0, sp));
        let job_cmd = str_sub(args, sp + 1, len(args));
        let id = cron_add_secs(job_cmd, secs, 1);
        if id < 0 { return "Error: cron table full"; }
        return "cron[" + to_string(id) + "] added every " + to_string(secs) + "s: " + job_cmd;
    }
    if str_starts_with(cmd, "cron once ") {
        let args = str_sub(cmd, 10, len(cmd));
        let sp = str_find(args, " ");
        if sp < 0 { return "Usage: cron once <secs> <cmd>"; }
        let secs = parse_int(str_sub(args, 0, sp));
        let job_cmd = str_sub(args, sp + 1, len(args));
        let id = cron_add_secs(job_cmd, secs, 0);
        if id < 0 { return "Error: cron table full"; }
        return "cron[" + to_string(id) + "] one-shot in " + to_string(secs) + "s: " + job_cmd;
    }
    if str_starts_with(cmd, "cron rm ") {
        let id = parse_int(str_sub(cmd, 8, len(cmd)));
        cron_remove(id);
        return "cron[" + to_string(id) + "] removed";
    }
    if str_starts_with(cmd, "cron en ") {
        let id = parse_int(str_sub(cmd, 8, len(cmd)));
        cron_enable(id);
        return "cron[" + to_string(id) + "] enabled";
    }
    if str_starts_with(cmd, "cron dis ") {
        let id = parse_int(str_sub(cmd, 9, len(cmd)));
        cron_disable(id);
        return "cron[" + to_string(id) + "] disabled";
    }

    // --- Image Viewer ---
    if cmd == "imgview" {
        uiimg_open();
        return "Image viewer opened — use: imgview <path.bmp>";
    }
    if str_starts_with(cmd, "imgview ") {
        let arg = str_sub(cmd, 8, len(cmd));
        if str_starts_with(arg, "zoom ") {
            let z = parse_int(str_sub(arg, 5, len(arg)));
            if z != 1 { if z != 2 { return "Error: zoom must be 1 or 2"; } }
            uiimg_zoom = z;
            return "zoom set to " + to_string(z) + "x";
        }
        if uiimg_is_open() == 0 { uiimg_open(); }
        let r = uiimg_load(arg);
        if r == 0 { return "Error: failed to load " + arg; }
        return "Loaded: " + arg;
    }

    // --- NTP ---
    if cmd == "ntp time" {
        let t = ntp_get_time();
        if t == 0 { return "ntp: not synced — use: ntp sync <host>"; }
        return ntp_format_time(t);
    }
    if cmd == "ntp status" { return ntp_status(); }
    if str_starts_with(cmd, "ntp sync ") {
        let host = str_sub(cmd, 9, len(cmd));
        let t = ntp_sync(host);
        if t == 0 { return "Error: ntp sync failed"; }
        return "ntp: synced — " + ntp_format_time(t);
    }

    // --- TAR ---
    if str_starts_with(cmd, "tar list ") {
        let path = str_sub(cmd, 9, len(cmd));
        return tar_list(path);
    }
    if str_starts_with(cmd, "tar info ") {
        let path = str_sub(cmd, 9, len(cmd));
        return tar_info(path);
    }
    if str_starts_with(cmd, "tar cat ") {
        let args = str_sub(cmd, 8, len(cmd));
        let sp = str_find(args, " ");
        if sp < 0 { return "Usage: tar cat <path> <file>"; }
        let tar_path = str_sub(args, 0, sp);
        let fname    = str_sub(args, sp + 1, len(args));
        return tar_cat(tar_path, fname);
    }
    if str_starts_with(cmd, "tar extract ") {
        let args = str_sub(cmd, 12, len(cmd));
        let sp = str_find(args, " ");
        if sp < 0 { return "Usage: tar extract <path> <dest>"; }
        let tar_path = str_sub(args, 0, sp);
        let dest     = str_sub(args, sp + 1, len(args));
        let n = tar_extract(tar_path, dest);
        if n < 0 { return "Error: extract failed"; }
        return "Extracted " + to_string(n) + " file(s) to " + dest;
    }

    // --- Hex Editor ---
    if cmd == "hexedit" {
        hexed_open();
        return "Hex editor opened — use: hexedit <path>";
    }
    if str_starts_with(cmd, "hexedit ") {
        let path = str_sub(cmd, 8, len(cmd));
        if hexed_is_open() == 0 { hexed_open(); }
        let r = hexed_load(path);
        if r == 0 { return "Error: cannot open " + path; }
        return "hexedit: loaded " + path;
    }

    // --- POP3 ---
    if cmd == "pop3" { return pop3_list_sessions(); }
    if str_starts_with(cmd, "pop3 connect ") {
        let args = str_sub(cmd, 13, len(cmd));
        let sp = str_find(args, " ");
        if sp < 0 { return "Usage: pop3 connect <host> <port>"; }
        let host = str_sub(args, 0, sp);
        let port = parse_int(str_sub(args, sp + 1, len(args)));
        let id = pop3_connect(host, port);
        if id < 0 { return "Error: pop3 connect failed"; }
        return "pop3[" + to_string(id) + "] connected to " + host;
    }
    if str_starts_with(cmd, "pop3 auth ") {
        let args = str_sub(cmd, 10, len(cmd));
        let sp1 = str_find(args, " ");
        if sp1 < 0 { return "Usage: pop3 auth <id> <user> <pass>"; }
        let id = parse_int(str_sub(args, 0, sp1));
        let rest = str_sub(args, sp1 + 1, len(args));
        let sp2 = str_find(rest, " ");
        if sp2 < 0 { return "Usage: pop3 auth <id> <user> <pass>"; }
        let user = str_sub(rest, 0, sp2);
        let pass = str_sub(rest, sp2 + 1, len(rest));
        pop3_auth(id, user, pass);
        return "pop3[" + to_string(id) + "] auth sent";
    }
    if str_starts_with(cmd, "pop3 list ") {
        let id = parse_int(str_sub(cmd, 10, len(cmd)));
        return pop3_list(id);
    }
    if str_starts_with(cmd, "pop3 get ") {
        let args = str_sub(cmd, 9, len(cmd));
        let sp = str_find(args, " ");
        if sp < 0 { return "Usage: pop3 get <id> <msg_num>"; }
        let id  = parse_int(str_sub(args, 0, sp));
        let num = parse_int(str_sub(args, sp + 1, len(args)));
        return pop3_retr(id, num);
    }
    if str_starts_with(cmd, "pop3 quit ") {
        let id = parse_int(str_sub(cmd, 10, len(cmd)));
        pop3_quit(id);
        return "pop3[" + to_string(id) + "] disconnected";
    }

    // --- IRC ---
    if cmd == "irc" { return irc_list_sessions(); }
    if str_starts_with(cmd, "irc connect ") {
        let args = str_sub(cmd, 12, len(cmd));
        let sp = str_find(args, " ");
        let host = args;
        let port = IRC_PORT;
        if sp >= 0 { host = str_sub(args, 0, sp); port = parse_int(str_sub(args, sp + 1, len(args))); }
        let id = irc_connect(host, port);
        if id < 0 { return "Error: irc connect failed"; }
        return "irc[" + to_string(id) + "] connected to " + host;
    }
    if str_starts_with(cmd, "irc reg ") {
        let args = str_sub(cmd, 8, len(cmd));
        let sp1 = str_find(args, " ");
        if sp1 < 0 { return "Usage: irc reg <id> <nick> <user>"; }
        let id = parse_int(str_sub(args, 0, sp1));
        let rest = str_sub(args, sp1 + 1, len(args));
        let sp2 = str_find(rest, " ");
        if sp2 < 0 { return "Usage: irc reg <id> <nick> <user>"; }
        let nick = str_sub(rest, 0, sp2);
        let user = str_sub(rest, sp2 + 1, len(rest));
        irc_register(id, nick, user);
        return "irc[" + to_string(id) + "] NICK=" + nick;
    }
    if str_starts_with(cmd, "irc join ") {
        let args = str_sub(cmd, 9, len(cmd));
        let sp = str_find(args, " ");
        if sp < 0 { return "Usage: irc join <id> <#channel>"; }
        let id = parse_int(str_sub(args, 0, sp));
        let chan = str_sub(args, sp + 1, len(args));
        irc_join(id, chan);
        return "irc[" + to_string(id) + "] JOIN " + chan;
    }
    if str_starts_with(cmd, "irc say ") {
        let args = str_sub(cmd, 8, len(args));
        let sp1 = str_find(args, " ");
        if sp1 < 0 { return "Usage: irc say <id> <target> <msg>"; }
        let id = parse_int(str_sub(args, 0, sp1));
        let rest = str_sub(args, sp1 + 1, len(args));
        let sp2 = str_find(rest, " ");
        if sp2 < 0 { return "Usage: irc say <id> <target> <msg>"; }
        let target = str_sub(rest, 0, sp2);
        let msg    = str_sub(rest, sp2 + 1, len(rest));
        irc_say(id, target, msg);
        return "irc[" + to_string(id) + "] → " + target + ": " + msg;
    }
    if str_starts_with(cmd, "irc recv ") {
        let id = parse_int(str_sub(cmd, 9, len(cmd)));
        let m = irc_recv(id);
        if len(m) == 0 { return "(no messages)"; }
        return m;
    }
    if str_starts_with(cmd, "irc part ") {
        let id = parse_int(str_sub(cmd, 9, len(cmd)));
        irc_part(id);
        return "irc[" + to_string(id) + "] parted";
    }
    if str_starts_with(cmd, "irc quit ") {
        let id = parse_int(str_sub(cmd, 9, len(cmd)));
        irc_quit(id, "");
        return "irc[" + to_string(id) + "] quit";
    }
    if str_starts_with(cmd, "irc status ") {
        let id = parse_int(str_sub(cmd, 11, len(cmd)));
        return irc_status(id);
    }

    // --- Calendar ---
    if cmd == "calendar" { uical_open(); return "Calendar opened"; }
    if cmd == "cal" { uical_open(); return "Calendar opened"; }
    if cmd == "cal next"  { if uical_is_open() == 0 { uical_open(); }
        uical_goto(uical_month % 12 + 1, uical_year + uical_month / 12);
        return "Calendar: next month"; }
    if cmd == "cal prev"  { if uical_is_open() == 0 { uical_open(); }
        let pm = uical_month - 1;
        let py = uical_year;
        if pm < 1 { let pm = 12; let py = py - 1; }
        uical_goto(pm, py);
        return "Calendar: prev month"; }
    if cmd == "cal today" { if uical_is_open() == 0 { uical_open(); }
        uical_open();   // re-opens and syncs to today
        return "Calendar: today"; }
    if str_starts_with(cmd, "cal add ") {
        let args = str_sub(cmd, 8, len(cmd));
        let sp = str_find(args, " ");
        if sp < 0 { return "Usage: cal add <day> <text>"; }
        let day  = parse_int(str_sub(args, 0, sp));
        let text = str_sub(args, sp + 1, len(args));
        let r = uical_add_event(day, uical_month, uical_year, text);
        if r < 0 { return "Error: event table full"; }
        return "Event added: day " + to_string(day) + " — " + text;
    }
    if str_starts_with(cmd, "cal goto ") {
        let args = str_sub(cmd, 9, len(cmd));
        let sp = str_find(args, " ");
        if sp < 0 { return "Usage: cal goto <month> <year>"; }
        let mo = parse_int(str_sub(args, 0, sp));
        let yr = parse_int(str_sub(args, sp + 1, len(args)));
        if uical_is_open() == 0 { uical_open(); }
        uical_goto(mo, yr);
        return "Calendar: " + to_string(mo) + "/" + to_string(yr);
    }

    // --- Compress ---
    if str_starts_with(cmd, "compress ") {
        let args = str_sub(cmd, 9, len(cmd));
        let sp1 = str_find(args, " ");
        if sp1 < 0 { return "Usage: compress <rle|lz> <src> <dst>"; }
        let algo = str_sub(args, 0, sp1);
        let rest = str_sub(args, sp1 + 1, len(args));
        let sp2 = str_find(rest, " ");
        if sp2 < 0 { return "Usage: compress <rle|lz> <src> <dst>"; }
        let src = str_sub(rest, 0, sp2);
        let dst = str_sub(rest, sp2 + 1, len(rest));
        let n = 0 - 1;
        if algo == "rle" { let n = compress_rle(src, dst); }
        else { if algo == "lz" { let n = compress_lzss(src, dst); }
               else { return "Error: unknown algo (use rle or lz)"; } }
        if n < 0 { return "Error: compress failed"; }
        return "Compressed to " + dst + "  " + to_string(n) + " bytes";
    }
    if str_starts_with(cmd, "decompress ") {
        let args = str_sub(cmd, 11, len(cmd));
        let sp1 = str_find(args, " ");
        if sp1 < 0 { return "Usage: decompress <rle|lz> <src> <dst>"; }
        let algo = str_sub(args, 0, sp1);
        let rest = str_sub(args, sp1 + 1, len(args));
        let sp2 = str_find(rest, " ");
        if sp2 < 0 { return "Usage: decompress <rle|lz> <src> <dst>"; }
        let src = str_sub(rest, 0, sp2);
        let dst = str_sub(rest, sp2 + 1, len(rest));
        let n = 0 - 1;
        if algo == "rle" { let n = decompress_rle(src, dst); }
        else { if algo == "lz" { let n = decompress_lzss(src, dst); }
               else { return "Error: unknown algo (use rle or lz)"; } }
        if n < 0 { return "Error: decompress failed"; }
        return "Decompressed to " + dst + "  " + to_string(n) + " bytes";
    }
    if str_starts_with(cmd, "compstat ") {
        let path = str_sub(cmd, 9, len(cmd));
        return compress_stat(path);
    }

    if cmd == "ctr" {
        return ctr_list();
    }
    if str_starts_with(cmd, "ctr new ") {
        let args = str_sub(cmd, 8, len(cmd));
        let sp = str_find(args, " ");
        let name = args;
        let root = "/";
        if sp >= 0 { name = str_sub(args, 0, sp); root = str_sub(args, sp + 1, len(args)); }
        let id = ctr_create(name, root);
        if id < 0 { return "Error: container create failed"; }
        return ctr_status(id);
    }
    if str_starts_with(cmd, "ctr start ") {
        let id = parse_int(str_sub(cmd, 10, len(cmd)));
        ctr_start(id);
        return ctr_status(id);
    }
    if str_starts_with(cmd, "ctr stop ") {
        let id = parse_int(str_sub(cmd, 9, len(cmd)));
        ctr_stop(id);
        return ctr_status(id);
    }
    if str_starts_with(cmd, "ctr rm ") {
        let id = parse_int(str_sub(cmd, 7, len(cmd)));
        ctr_destroy(id);
        return "Container " + to_string(id) + " destroyed";
    }
    if str_starts_with(cmd, "ctr exec ") {
        let args = str_sub(cmd, 9, len(cmd));
        let sp = str_find(args, " ");
        if sp < 0 { return "Usage: ctr exec <id> <cmd>"; }
        let id  = parse_int(str_sub(args, 0, sp));
        let c   = str_sub(args, sp + 1, len(args));
        ctr_exec(id, c);
        return "exec dispatched";
    }
    if str_starts_with(cmd, "ctr info ") {
        let id = parse_int(str_sub(cmd, 9, len(cmd)));
        return ctr_status(id);
    }

    if cmd == "ns" {
        return ns_list();
    }
    if str_starts_with(cmd, "ns new") {
        let ns_id = ns_create(0, NS_TYPE_ALL);
        if ns_id < 0 { return "Error: namespace table full"; }
        return "Created: " + ns_status(ns_id);
    }
    if str_starts_with(cmd, "ns info ") {
        let id = parse_int(str_sub(cmd, 8, len(cmd)));
        return ns_status(id);
    }
    if str_starts_with(cmd, "ns hostname ") {
        let args = str_sub(cmd, 12, len(cmd));
        let sp = str_find(args, " ");
        if sp < 0 { return "Usage: ns hostname <ns_id> <name>"; }
        let ns_id = parse_int(str_sub(args, 0, sp));
        let name  = str_sub(args, sp + 1, len(args));
        let r = ns_set_hostname(ns_id, name);
        if r == 0 { return "Set hostname in ns[" + to_string(ns_id) + "] = " + name; }
        return "Error: cannot set hostname";
    }
    if str_starts_with(cmd, "ns enter ") {
        let args = str_sub(cmd, 9, len(cmd));
        let sp = str_find(args, " ");
        if sp < 0 { return "Usage: ns enter <task_idx> <ns_id>"; }
        let tidx  = parse_int(str_sub(args, 0, sp));
        let ns_id = parse_int(str_sub(args, sp + 1, len(args)));
        let r = ns_enter(tidx, ns_id);
        if r == 0 { return "Task " + to_string(tidx) + " entered ns[" + to_string(ns_id) + "]"; }
        return "Error: ns_enter failed";
    }
    if str_starts_with(cmd, "ns del ") {
        let ns_id = parse_int(str_sub(cmd, 7, len(cmd)));
        let r = ns_destroy(ns_id);
        if r == 0 { return "Destroyed ns[" + to_string(ns_id) + "]"; }
        return "Error: cannot destroy ns[" + to_string(ns_id) + "]";
    }

    if cmd == "pty" {
        return pty_status();
    }
    if cmd == "tcploop" {
        return tcp_loopback_status();
    }
    if cmd == "dnstest" {
        return dns_loopback_status();
    }
    if cmd == "advtest" {
        return advanced_feature_summary();
    }
    if cmd == "sock" {
        return to_string(socket_count) + "/" + to_string(SOCKET_MAX) + " sockets open";
    }
    if cmd == "shm" {
        return shm_status();
    }
    if cmd == "trace" {
        return trace_status();
    }
    if cmd == "hrt" {
        return hrtimer_status();
    }
    if cmd == "sysfs" {
        return sysfs_list(0);
    }
    if cmd == "services" {
        svc_list();
        return "";
    }
    if str_starts_with(cmd, "svc start ") {
        let name = str_sub(cmd, 10, len(cmd));
        svc_start(name);
        return "";
    }
    if str_starts_with(cmd, "svc stop ") {
        let name = str_sub(cmd, 9, len(cmd));
        svc_stop(name);
        return "";
    }
    if str_starts_with(cmd, "svc status ") {
        let name = str_sub(cmd, 11, len(cmd));
        svc_status(name);
        return "";
    }
    if cmd == "uptime" {
        let ticks = get_ticks();
        let secs = ticks / 100;
        return "up " + to_string(secs / 60) + "m " + to_string(secs % 60) + "s";
    }
    if cmd == "kinfo" {
        hicos_kernel_info();
        return "";
    }
    if cmd == "lsmod" {
        kmod_status();
        return "";
    }
    if cmd == "kmodtest" {
        kmod_selftest();
        return "";
    }
    if cmd == "sysmon" {
        uismon_open();
        return "System Monitor opened";
    }
    if cmd == "files" {
        uifiles_open();
        return "File Manager opened";
    }
    if cmd == "audiotest" {
        ac97_beep(440, 500);
        return "Audio test: 440 Hz 500 ms";
    }
    if cmd == "settings" {
        uisettings_open();
        return "Settings opened";
    }
    if str_starts_with(cmd, "edit ") {
        let path = str_sub(cmd, 5, len(cmd));
        uitxed_open(path);
        return "Editor opened: " + path;
    }
    if cmd == "editor" {
        uitxed_open("");
        return "Editor opened (new file)";
    }
    if cmd == "gpu" {
        if gpu_initialized == 1 {
            print("GPU: " + to_string(gpu_display_w) + "x" + to_string(gpu_display_h) +
                  " fb=0x" + format_hex(gpu_fb_base(), 8) + " [active]");
            print(vesa_dirty_info());
        } else {
            print("GPU: not initialized");
        }
        return "";
    }
    if cmd == "gpu flip" {
        vesa_flip();
        return "GPU: full-screen flip submitted";
    }
    if cmd == "gpu dirty" {
        return vesa_dirty_info();
    }
    if cmd == "ext4" {
        if ext4_ready == 1 {
            print("ext4: mounted  block_size=" + to_string(ext4_block_size) +
                  " inode_size=" + to_string(ext4_inode_size));
            let root_ents = ext4_list_dir(EXT4_ROOT_INODE);
            let mut ri = 0;
            while ri < len(root_ents) {
                print("  " + root_ents[ri][0]);
                ri = ri + 1;
            }
        } else {
            print("ext4: not mounted");
        }
        return "";
    }
    // --- echo with redirect: echo <text> > <path> ---
    if str_starts_with(cmd, "echo ") {
        let rest = str_sub(cmd, 5, len(cmd));
        // Check for > redirect
        let mut redir_pos = 0 - 1;
        let mut gi = 0;
        while gi < len(rest) {
            if str_char_at(rest, gi) == 62 { redir_pos = gi; gi = len(rest); }
            else { gi = gi + 1; }
        }
        if redir_pos >= 0 {
            let text = str_sub(rest, 0, redir_pos - 1);
            let rpath_raw = str_sub(rest, redir_pos + 1, len(rest));
            let mut rpath = rpath_raw;
            if len(rpath_raw) > 0 {
                if str_char_at(rpath_raw, 0) == 32 { rpath = str_sub(rpath_raw, 1, len(rpath_raw)); }
            }
            let wfd = vfs_open(rpath, 577);  // O_CREAT|O_WRONLY|O_TRUNC
            if wfd < 0 { return "Error: cannot write to " + rpath; }
            vfs_write(wfd, text, len(text));
            vfs_close(wfd);
            return "";
        }
        return rest;
    }
    // --- inotify: show inotify subsystem status ---
    if cmd == "inotify" {
        let ic = inotify_inst_count;
        let wc = watch_count;
        let qc = evt_count;
        print("inotify: instances=" + to_string(ic) + " watches=" + to_string(wc) + " queued_events=" + to_string(qc));
        return "";
    }
    if cmd == "pty" {
        print(pty_status());
        return "";
    }
    if str_starts_with(cmd, "pty ") {
        let ptycmd = str_sub(cmd, 4, len(cmd));
        if ptycmd == "alloc" {
            let pair = pty_open_pair();
            print("PTY allocated: id=" + to_string(pair[2]) + " mfd=" + to_string(pair[0]) + " sfd=" + to_string(pair[1]));
            return "";
        }
        if str_starts_with(ptycmd, "info ") {
            let pid_s = str_sub(ptycmd, 5, len(ptycmd));
            print(pty_info(parse_int(pid_s)));
            return "";
        }
        return "Usage: pty | pty alloc | pty info <id>";
    }
    // --- watch <path>: add inotify watch and show events ---
    if str_starts_with(cmd, "watch ") {
        let wpath = str_sub(cmd, 6, len(cmd));
        let inst = sys_inotify_init();
        sys_inotify_add_watch(inst, wpath, 4095);
        print("Watching: " + wpath + "  (inst=" + to_string(inst) + ", sampling 10 polls)");
        let mut wdone = 0;
        let mut wpoll = 0;
        while wdone == 0 {
            let evts = sys_inotify_read(inst);
            let mut ei = 0;
            while ei + 1 < len(evts) {
                let emask = evts[ei];
                let ename = evts[ei + 1];
                print("EVENT mask=" + to_string(emask) + " name=" + ename);
                ei = ei + 2;
            }
            wpoll = wpoll + 1;
            if wpoll >= 10 { wdone = 1; }
        }
        sys_inotify_close(inst);
        return "";
    }
    if cmd == "fm" || cmd == "fileman" {
        // Open graphical file manager window
        uifiles_init();
        let win_id = uifiles_open();
        if win_id < 0 {
            return "Failed to open file manager";
        }
        return "File manager opened (window " + to_string(win_id) + ")";
    }

    // === SQLite commands ===
    if cmd == "db list" { return db_list(); }
    if str_starts_with(cmd, "db create ") {
        let args = str_sub(cmd, 10, len(cmd));
        let sp = str_find(args, " ");
        if sp < 0 { return "Usage: db create <name> <col1 col2 ...>"; }
        let tname  = str_sub(args, 0, sp);
        let schema = str_sub(args, sp + 1, len(args));
        let id = db_create(tname, schema);
        if id < 0 { return "Error: table exists or limit reached"; }
        return "Created table '" + tname + "' id=" + to_string(id);
    }
    if str_starts_with(cmd, "db insert ") {
        let args = str_sub(cmd, 10, len(cmd));
        let sp = str_find(args, " ");
        if sp < 0 { return "Usage: db insert <name> <val1 val2 ...>"; }
        let tname = str_sub(args, 0, sp);
        let row   = str_sub(args, sp + 1, len(args));
        let id = _db_find(tname);
        if id < 0 { return "Error: table '" + tname + "' not found"; }
        let ri = db_insert(id, row);
        return "Inserted row " + to_string(ri) + " into '" + tname + "'";
    }
    if str_starts_with(cmd, "db select ") {
        let tname = str_sub(cmd, 10, len(cmd));
        let id = _db_find(tname);
        if id < 0 { return "Error: table '" + tname + "' not found"; }
        return db_select_all(id);
    }
    if str_starts_with(cmd, "db where ") {
        let args = str_sub(cmd, 9, len(cmd));
        let sp1 = str_find(args, " ");
        if sp1 < 0 { return "Usage: db where <name> <col> <val>"; }
        let tname = str_sub(args, 0, sp1);
        let rest  = str_sub(args, sp1 + 1, len(args));
        let sp2   = str_find(rest, " ");
        if sp2 < 0 { return "Usage: db where <name> <col> <val>"; }
        let col = str_sub(rest, 0, sp2);
        let val = str_sub(rest, sp2 + 1, len(rest));
        let id = _db_find(tname);
        if id < 0 { return "Error: table '" + tname + "' not found"; }
        return db_select_where(id, col, val);
    }
    if str_starts_with(cmd, "db delete ") {
        let args = str_sub(cmd, 10, len(cmd));
        let sp1 = str_find(args, " ");
        if sp1 < 0 { return "Usage: db delete <name> <col> <val>"; }
        let tname = str_sub(args, 0, sp1);
        let rest  = str_sub(args, sp1 + 1, len(args));
        let sp2   = str_find(rest, " ");
        if sp2 < 0 { return "Usage: db delete <name> <col> <val>"; }
        let col = str_sub(rest, 0, sp2);
        let val = str_sub(rest, sp2 + 1, len(rest));
        let id = _db_find(tname);
        if id < 0 { return "Error: table '" + tname + "' not found"; }
        let n = db_delete_where(id, col, val);
        return "Deleted " + to_string(n) + " row(s) from '" + tname + "'";
    }
    if str_starts_with(cmd, "db drop ") {
        let tname = str_sub(cmd, 8, len(cmd));
        let id = _db_find(tname);
        if id < 0 { return "Error: table '" + tname + "' not found"; }
        db_drop(id);
        return "Dropped table '" + tname + "'";
    }
    if str_starts_with(cmd, "db schema ") {
        let tname = str_sub(cmd, 10, len(cmd));
        let id = _db_find(tname);
        if id < 0 { return "Error: table '" + tname + "' not found"; }
        return db_schema(id);
    }
    if str_starts_with(cmd, "db count ") {
        let tname = str_sub(cmd, 9, len(cmd));
        let id = _db_find(tname);
        if id < 0 { return "Error: table '" + tname + "' not found"; }
        return to_string(db_count(id)) + " rows";
    }

    // === Diff commands ===
    if str_starts_with(cmd, "diff ") {
        let args = str_sub(cmd, 5, len(cmd));
        let sp = str_find(args, " ");
        if sp < 0 { return "Usage: diff <pathA> <pathB>"; }
        let pa = str_sub(args, 0, sp);
        let pb = str_sub(args, sp + 1, len(args));
        return diff_files(pa, pb);
    }
    if str_starts_with(cmd, "diffstat ") {
        let args = str_sub(cmd, 9, len(cmd));
        let sp = str_find(args, " ");
        if sp < 0 { return "Usage: diffstat <pathA> <pathB>"; }
        let pa = str_sub(args, 0, sp);
        let pb = str_sub(args, sp + 1, len(args));
        return diff_stat(pa, pb);
    }
    if str_starts_with(cmd, "diffstr ") {
        let args = str_sub(cmd, 8, len(cmd));
        let sp = str_find(args, " ");
        if sp < 0 { return "Usage: diffstr <textA> <textB>"; }
        let ta = str_sub(args, 0, sp);
        let tb = str_sub(args, sp + 1, len(args));
        return diff_strings(ta, tb);
    }

    // === Clock commands ===
    if cmd == "clock" {
        uiclock_open();
        return "Clock opened";
    }
    if cmd == "clock close" {
        uiclock_close();
        return "Clock closed";
    }
    if cmd == "clock time" {
        return uiclock_get_time_str();
    }
    if str_starts_with(cmd, "clock alarm ") {
        let args = str_sub(cmd, 12, len(cmd));
        let sp = str_find(args, " ");
        if sp < 0 { return "Usage: clock alarm <HH> <MM>"; }
        let h = parse_int(str_sub(args, 0, sp));
        let m = parse_int(str_sub(args, sp + 1, len(args)));
        uiclock_set_alarm(h, m);
        return "Alarm set for " + to_string(h) + ":" + to_string(m);
    }

    // === Base64 commands ===
    if str_starts_with(cmd, "b64encode ") {
        let args = str_sub(cmd, 10, len(cmd));
        let sp = str_find(args, " ");
        if sp < 0 { return "Usage: b64encode <src> <dst>"; }
        let src = str_sub(args, 0, sp);
        let dst = str_sub(args, sp + 1, len(args));
        let n = b64_encode_file(src, dst);
        if n < 0 { return "Error: b64encode failed"; }
        return "Encoded to " + dst + "  " + to_string(n) + " bytes";
    }
    if str_starts_with(cmd, "b64decode ") {
        let args = str_sub(cmd, 10, len(cmd));
        let sp = str_find(args, " ");
        if sp < 0 { return "Usage: b64decode <src> <dst>"; }
        let src = str_sub(args, 0, sp);
        let dst = str_sub(args, sp + 1, len(args));
        let n = b64_decode_file(src, dst);
        if n < 0 { return "Error: b64decode failed"; }
        return "Decoded to " + dst + "  " + to_string(n) + " bytes";
    }
    if str_starts_with(cmd, "b64str ") {
        let text = str_sub(cmd, 7, len(cmd));
        return b64_encode_str(text);
    }

    // === INI commands ===
    if str_starts_with(cmd, "ini load ") {
        let path = str_sub(cmd, 9, len(cmd));
        let n = ini_load(path);
        if n < 0 { return "Error: cannot open " + path; }
        return "Loaded " + to_string(n) + " entries from " + path;
    }
    if cmd == "ini list" { return ini_list(); }
    if str_starts_with(cmd, "ini get ") {
        let args = str_sub(cmd, 8, len(cmd));
        let sp = str_find(args, " ");
        if sp < 0 { return "Usage: ini get <section> <key>"; }
        let sec = str_sub(args, 0, sp);
        let key = str_sub(args, sp + 1, len(args));
        let v = ini_get(sec, key);
        if len(v) == 0 { return "(not found)"; }
        return v;
    }
    if str_starts_with(cmd, "ini set ") {
        let args = str_sub(cmd, 8, len(cmd));
        let sp1 = str_find(args, " ");
        if sp1 < 0 { return "Usage: ini set <section> <key> <val>"; }
        let sec  = str_sub(args, 0, sp1);
        let rest = str_sub(args, sp1 + 1, len(args));
        let sp2  = str_find(rest, " ");
        if sp2 < 0 { return "Usage: ini set <section> <key> <val>"; }
        let key = str_sub(rest, 0, sp2);
        let val = str_sub(rest, sp2 + 1, len(rest));
        ini_set(sec, key, val);
        return "Set [" + sec + "] " + key + " = " + val;
    }
    if str_starts_with(cmd, "ini save ") {
        let path = str_sub(cmd, 9, len(cmd));
        let n = ini_save(path);
        if n < 0 { return "Error: cannot write " + path; }
        return "Saved " + to_string(n) + " bytes to " + path;
    }
    if str_starts_with(cmd, "ini del ") {
        let args = str_sub(cmd, 8, len(cmd));
        let sp = str_find(args, " ");
        if sp < 0 { return "Usage: ini del <section> <key>"; }
        let sec = str_sub(args, 0, sp);
        let key = str_sub(args, sp + 1, len(args));
        let r = ini_delete(sec, key);
        if r == 1 { return "Deleted [" + sec + "] " + key; }
        return "(not found)";
    }

    // === Profiler commands ===
    if cmd == "prof report" { return prof_report(); }
    if cmd == "prof reset"  { prof_reset(); return "Profiler reset"; }
    if cmd == "prof spans"  { return prof_span_report(); }
    if cmd == "prof ring"   { return prof_ring_report(); }
    if cmd == "prof sample" { let t = prof_sample(); return "Sampled tick=" + to_string(t); }
    if str_starts_with(cmd, "prof top ") {
        let n = parse_int(str_sub(cmd, 9, len(cmd)));
        return prof_top(n);
    }
    if str_starts_with(cmd, "prof inc ") {
        let name = str_sub(cmd, 9, len(cmd));
        let v = prof_inc(name);
        return name + " = " + to_string(v);
    }
    if str_starts_with(cmd, "prof get ") {
        let name = str_sub(cmd, 9, len(cmd));
        return name + " = " + to_string(prof_get(name));
    }

    // === CSV commands ===
    if str_starts_with(cmd, "csv load ") {
        let path = str_sub(cmd, 9, len(cmd));
        let n = csv_load(path);
        if n < 0 { return "Error: cannot open " + path; }
        return "Loaded " + to_string(n) + " rows from " + path;
    }
    if cmd == "csv list" { return csv_head(10); }
    if str_starts_with(cmd, "csv list ") {
        let n = parse_int(str_sub(cmd, 9, len(cmd)));
        return csv_head(n);
    }
    if str_starts_with(cmd, "csv get ") {
        let args = str_sub(cmd, 8, len(cmd));
        let sp = str_find(args, " ");
        if sp < 0 { return "Usage: csv get <row> <col>"; }
        let row = parse_int(str_sub(args, 0, sp));
        let col = parse_int(str_sub(args, sp + 1, len(args)));
        return csv_get(row, col);
    }
    if str_starts_with(cmd, "csv set ") {
        let args = str_sub(cmd, 8, len(cmd));
        let sp1 = str_find(args, " ");
        if sp1 < 0 { return "Usage: csv set <row> <col> <val>"; }
        let row  = parse_int(str_sub(args, 0, sp1));
        let rest = str_sub(args, sp1 + 1, len(args));
        let sp2  = str_find(rest, " ");
        if sp2 < 0 { return "Usage: csv set <row> <col> <val>"; }
        let col = parse_int(str_sub(rest, 0, sp2));
        let val = str_sub(rest, sp2 + 1, len(rest));
        csv_set(row, col, val);
        return "Set [" + to_string(row) + "," + to_string(col) + "] = " + val;
    }
    if str_starts_with(cmd, "csv save ") {
        let path = str_sub(cmd, 9, len(cmd));
        let n = csv_save(path);
        if n < 0 { return "Error: cannot write " + path; }
        return "Saved " + to_string(n) + " bytes to " + path;
    }
    if cmd == "csv cols" { return csv_col_names(); }

    // === Ping commands ===
    if str_starts_with(cmd, "ping ") {
        let args = str_sub(cmd, 5, len(cmd));
        let sp = str_find(args, " ");
        let host = args;
        let count = 4;
        if sp >= 0 {
            host = str_sub(args, 0, sp);
            count = parse_int(str_sub(args, sp + 1, len(args)));
        }
        return ping_host(host, count);
    }

    // === Task manager commands ===
    if cmd == "taskman" {
        uitaskman_open();
        return "Task Manager opened";
    }

    // === Traceroute commands ===
    if str_starts_with(cmd, "traceroute ") {
        let args = str_sub(cmd, 11, len(cmd));
        let sp = str_find(args, " ");
        let host = args;
        let hops = 15;
        if sp >= 0 {
            host = str_sub(args, 0, sp);
            hops = parse_int(str_sub(args, sp + 1, len(args)));
        }
        return traceroute_host(host, hops);
    }

    // === Semaphore commands ===
    if cmd == "sem list" { return sem_list(); }
    if str_starts_with(cmd, "sem create ") {
        let args = str_sub(cmd, 11, len(cmd));
        let sp = str_find(args, " ");
        if sp < 0 { return "Usage: sem create <name> <initial_val>"; }
        let nm  = str_sub(args, 0, sp);
        let val = parse_int(str_sub(args, sp + 1, len(args)));
        let id = sem_open(nm, val);
        if id < 0 { return "Error: semaphore table full or name too long"; }
        return "Semaphore '" + nm + "' created, id=" + to_string(id);
    }
    if str_starts_with(cmd, "sem wait ") {
        let id = parse_int(str_sub(cmd, 9, len(cmd)));
        let r = sem_wait(id);
        if r < 0 { return "sem[" + to_string(id) + "]: would block (val=0)"; }
        return "sem[" + to_string(id) + "]: acquired, val=" + to_string(sem_getvalue(id));
    }
    if str_starts_with(cmd, "sem post ") {
        let id = parse_int(str_sub(cmd, 9, len(cmd)));
        let v = sem_post(id);
        if v < 0 { return "Error: invalid semaphore id"; }
        return "sem[" + to_string(id) + "]: posted, val=" + to_string(v);
    }
    if str_starts_with(cmd, "sem value ") {
        let id = parse_int(str_sub(cmd, 10, len(cmd)));
        let v = sem_getvalue(id);
        if v < 0 { return "Error: invalid semaphore id"; }
        return "sem[" + to_string(id) + "] = " + to_string(v);
    }
    if str_starts_with(cmd, "sem destroy ") {
        let id = parse_int(str_sub(cmd, 12, len(cmd)));
        sem_destroy(id);
        return "Semaphore " + to_string(id) + " destroyed";
    }

    // === Notepad commands ===
    if cmd == "notepad" {
        notepad_open("");
        return "Notepad opened";
    }
    if str_starts_with(cmd, "notepad ") {
        let path = str_sub(cmd, 8, len(cmd));
        notepad_open(path);
        return "Notepad opened: " + path;
    }

    // === IMAP commands ===
    if cmd == "imap" { return imap_list_sessions(); }
    if str_starts_with(cmd, "imap connect ") {
        let rest = str_sub(cmd, 13, len(cmd));
        let sp = str_find(rest, " ");
        if sp < 0 { return "Usage: imap connect <host> <port>"; }
        let host = str_sub(rest, 0, sp);
        let port = parse_int(str_sub(rest, sp + 1, len(rest)));
        let id = imap_connect(host, port);
        if id < 0 { return "Error: imap connect failed"; }
        return "imap[" + to_string(id) + "] connected to " + host;
    }
    if str_starts_with(cmd, "imap login ") {
        let rest = str_sub(cmd, 11, len(cmd));
        let sp1 = str_find(rest, " ");
        if sp1 < 0 { return "Usage: imap login <id> <user> <pass>"; }
        let id = parse_int(str_sub(rest, 0, sp1));
        let rest2 = str_sub(rest, sp1 + 1, len(rest));
        let sp2 = str_find(rest2, " ");
        if sp2 < 0 { return "Usage: imap login <id> <user> <pass>"; }
        let user = str_sub(rest2, 0, sp2);
        let pass = str_sub(rest2, sp2 + 1, len(rest2));
        let r = imap_login(id, user, pass);
        if r < 0 { return "Error: imap login failed"; }
        return "imap[" + to_string(id) + "] logged in as " + user;
    }
    if str_starts_with(cmd, "imap select ") {
        let rest = str_sub(cmd, 12, len(cmd));
        let sp = str_find(rest, " ");
        if sp < 0 { return "Usage: imap select <id> <mailbox>"; }
        let id = parse_int(str_sub(rest, 0, sp));
        let mbox = str_sub(rest, sp + 1, len(rest));
        let cnt = imap_select(id, mbox);
        if cnt < 0 { return "Error: imap select failed"; }
        return "imap[" + to_string(id) + "] selected " + mbox + " (" + to_string(cnt) + " msgs)";
    }
    if str_starts_with(cmd, "imap list ") {
        let id = parse_int(str_sub(cmd, 10, len(cmd)));
        return imap_list(id);
    }
    if str_starts_with(cmd, "imap fetch ") {
        let rest = str_sub(cmd, 11, len(cmd));
        let sp1 = str_find(rest, " ");
        if sp1 < 0 { return "Usage: imap fetch <id> <from> <to>"; }
        let id = parse_int(str_sub(rest, 0, sp1));
        let rest2 = str_sub(rest, sp1 + 1, len(rest));
        let sp2 = str_find(rest2, " ");
        if sp2 < 0 { return "Usage: imap fetch <id> <from> <to>"; }
        let from = parse_int(str_sub(rest2, 0, sp2));
        let to_n = parse_int(str_sub(rest2, sp2 + 1, len(rest2)));
        return imap_fetch(id, from, to_n);
    }
    if str_starts_with(cmd, "imap logout ") {
        let id = parse_int(str_sub(cmd, 12, len(cmd)));
        imap_logout(id);
        return "imap[" + to_string(id) + "] logged out";
    }

    // === MQTT commands ===
    if cmd == "mqtt" { return mqtt_list(); }
    if str_starts_with(cmd, "mqtt connect ") {
        let rest = str_sub(cmd, 13, len(cmd));
        let sp1 = str_find(rest, " ");
        if sp1 < 0 { return "Usage: mqtt connect <host> <port> <client_id>"; }
        let host = str_sub(rest, 0, sp1);
        let rest2 = str_sub(rest, sp1 + 1, len(rest));
        let sp2 = str_find(rest2, " ");
        if sp2 < 0 { return "Usage: mqtt connect <host> <port> <client_id>"; }
        let port = parse_int(str_sub(rest2, 0, sp2));
        let cid = str_sub(rest2, sp2 + 1, len(rest2));
        let id = mqtt_connect(host, port, cid);
        if id < 0 { return "Error: mqtt connect failed"; }
        return "mqtt[" + to_string(id) + "] connected to " + host;
    }
    if str_starts_with(cmd, "mqtt pub ") {
        let rest = str_sub(cmd, 9, len(cmd));
        let sp1 = str_find(rest, " ");
        if sp1 < 0 { return "Usage: mqtt pub <id> <topic> <payload>"; }
        let id = parse_int(str_sub(rest, 0, sp1));
        let rest2 = str_sub(rest, sp1 + 1, len(rest));
        let sp2 = str_find(rest2, " ");
        if sp2 < 0 { return "Usage: mqtt pub <id> <topic> <payload>"; }
        let topic = str_sub(rest2, 0, sp2);
        let payload = str_sub(rest2, sp2 + 1, len(rest2));
        mqtt_publish(id, topic, payload);
        return "mqtt[" + to_string(id) + "] published to " + topic;
    }
    if str_starts_with(cmd, "mqtt sub ") {
        let rest = str_sub(cmd, 9, len(cmd));
        let sp = str_find(rest, " ");
        if sp < 0 { return "Usage: mqtt sub <id> <topic>"; }
        let id = parse_int(str_sub(rest, 0, sp));
        let topic = str_sub(rest, sp + 1, len(rest));
        mqtt_subscribe(id, topic);
        return "mqtt[" + to_string(id) + "] subscribed to " + topic;
    }
    if str_starts_with(cmd, "mqtt unsub ") {
        let rest = str_sub(cmd, 11, len(cmd));
        let sp = str_find(rest, " ");
        if sp < 0 { return "Usage: mqtt unsub <id> <topic>"; }
        let id = parse_int(str_sub(rest, 0, sp));
        let topic = str_sub(rest, sp + 1, len(rest));
        mqtt_unsubscribe(id, topic);
        return "mqtt[" + to_string(id) + "] unsubscribed from " + topic;
    }
    if str_starts_with(cmd, "mqtt ping ") {
        let id = parse_int(str_sub(cmd, 10, len(cmd)));
        mqtt_ping(id);
        return "mqtt[" + to_string(id) + "] PINGREQ sent";
    }
    if str_starts_with(cmd, "mqtt quit ") {
        let id = parse_int(str_sub(cmd, 10, len(cmd)));
        mqtt_disconnect(id);
        return "mqtt[" + to_string(id) + "] disconnected";
    }

    // === LZ4 commands ===
    if cmd == "lz4test" { return lz4_selftest(); }
    if str_starts_with(cmd, "lz4c ") {
        let rest = str_sub(cmd, 5, len(cmd));
        let sp = str_find(rest, " ");
        if sp < 0 { return "Usage: lz4c <inpath> <outpath>"; }
        let inpath  = str_sub(rest, 0, sp);
        let outpath = str_sub(rest, sp + 1, len(rest));
        let n = lz4_compress_file(inpath, outpath);
        if n < 0 { return "Error: lz4c failed"; }
        return "lz4c: compressed " + to_string(n) + " bytes → " + outpath;
    }
    if str_starts_with(cmd, "lz4d ") {
        let rest = str_sub(cmd, 5, len(cmd));
        let sp = str_find(rest, " ");
        if sp < 0 { return "Usage: lz4d <inpath> <outpath>"; }
        let inpath  = str_sub(rest, 0, sp);
        let outpath = str_sub(rest, sp + 1, len(rest));
        let n = lz4_decompress_file(inpath, outpath);
        if n < 0 { return "Error: lz4d failed"; }
        return "lz4d: decompressed " + to_string(n) + " bytes → " + outpath;
    }

    // === FTP commands ===
    if cmd == "ftp" { return ftp_list_sessions(); }
    if str_starts_with(cmd, "ftp connect ") {
        let host = str_sub(cmd, 12, len(cmd));
        let id = ftp_connect(host);
        if id < 0 { return "Error: ftp connect failed"; }
        return "ftp[" + to_string(id) + "] connected to " + host;
    }
    if str_starts_with(cmd, "ftp auth ") {
        let rest = str_sub(cmd, 9, len(cmd));
        let sp1 = str_find(rest, " ");
        if sp1 < 0 { return "Usage: ftp auth <id> <user> <pass>"; }
        let id = parse_int(str_sub(rest, 0, sp1));
        let rest2 = str_sub(rest, sp1 + 1, len(rest));
        let sp2 = str_find(rest2, " ");
        if sp2 < 0 { return "Usage: ftp auth <id> <user> <pass>"; }
        let user = str_sub(rest2, 0, sp2);
        let pass = str_sub(rest2, sp2 + 1, len(rest2));
        let r = ftp_auth(id, user, pass);
        if r < 0 { return "Error: ftp auth failed"; }
        return "ftp[" + to_string(id) + "] authenticated as " + user;
    }
    if str_starts_with(cmd, "ftp ls ") {
        let rest = str_sub(cmd, 7, len(cmd));
        let sp = str_find(rest, " ");
        let mut id = parse_int(rest);
        let mut path = "";
        if sp >= 0 { id = parse_int(str_sub(rest, 0, sp)); path = str_sub(rest, sp + 1, len(rest)); }
        return ftp_list(id, path);
    }
    if str_starts_with(cmd, "ftp get ") {
        let rest = str_sub(cmd, 8, len(cmd));
        let sp1 = str_find(rest, " ");
        if sp1 < 0 { return "Usage: ftp get <id> <remote> <local>"; }
        let id = parse_int(str_sub(rest, 0, sp1));
        let rest2 = str_sub(rest, sp1 + 1, len(rest));
        let sp2 = str_find(rest2, " ");
        if sp2 < 0 { return "Usage: ftp get <id> <remote> <local>"; }
        let remote = str_sub(rest2, 0, sp2);
        let local = str_sub(rest2, sp2 + 1, len(rest2));
        let n = ftp_get(id, remote, local);
        if n < 0 { return "Error: ftp get failed"; }
        return "ftp: got " + to_string(n) + " bytes → " + local;
    }
    if str_starts_with(cmd, "ftp put ") {
        let rest = str_sub(cmd, 8, len(cmd));
        let sp1 = str_find(rest, " ");
        if sp1 < 0 { return "Usage: ftp put <id> <local> <remote>"; }
        let id = parse_int(str_sub(rest, 0, sp1));
        let rest2 = str_sub(rest, sp1 + 1, len(rest));
        let sp2 = str_find(rest2, " ");
        if sp2 < 0 { return "Usage: ftp put <id> <local> <remote>"; }
        let local = str_sub(rest2, 0, sp2);
        let remote = str_sub(rest2, sp2 + 1, len(rest2));
        let n = ftp_put(id, local, remote);
        if n < 0 { return "Error: ftp put failed"; }
        return "ftp: put " + to_string(n) + " bytes → " + remote;
    }
    if str_starts_with(cmd, "ftp pwd ") {
        let id = parse_int(str_sub(cmd, 8, len(cmd)));
        return ftp_pwd(id);
    }
    if str_starts_with(cmd, "ftp cd ") {
        let rest = str_sub(cmd, 7, len(cmd));
        let sp = str_find(rest, " ");
        if sp < 0 { return "Usage: ftp cd <id> <path>"; }
        let id = parse_int(str_sub(rest, 0, sp));
        let path = str_sub(rest, sp + 1, len(rest));
        let r = ftp_cwd(id, path);
        if r < 0 { return "Error: ftp cd failed"; }
        return "ftp[" + to_string(id) + "] cd " + path;
    }
    if str_starts_with(cmd, "ftp quit ") {
        let id = parse_int(str_sub(cmd, 9, len(cmd)));
        ftp_quit(id);
        return "ftp[" + to_string(id) + "] disconnected";
    }

    // === CBOR commands ===
    if str_starts_with(cmd, "cbor uint ") {
        let n = parse_int(str_sub(cmd, 10, len(cmd)));
        cbor_begin();
        cbor_encode_uint(n);
        return "cbor: " + cbor_get_result();
    }
    if str_starts_with(cmd, "cbor neg ") {
        let n = parse_int(str_sub(cmd, 9, len(cmd)));
        cbor_begin();
        cbor_encode_negint(n);
        return "cbor: " + cbor_get_result();
    }
    if str_starts_with(cmd, "cbor str ") {
        let s = str_sub(cmd, 9, len(cmd));
        cbor_begin();
        cbor_encode_str(s);
        return "cbor: " + cbor_get_result();
    }
    if str_starts_with(cmd, "cbor bool ") {
        let b = parse_int(str_sub(cmd, 10, len(cmd)));
        cbor_begin();
        cbor_encode_bool(b);
        return "cbor: " + cbor_get_result();
    }
    if cmd == "cbor null" {
        cbor_begin();
        cbor_encode_null();
        return "cbor: " + cbor_get_result();
    }
    if str_starts_with(cmd, "cbor hex ") {
        let hexstr = str_sub(cmd, 9, len(cmd));
        return cbor_decode_hex(hexstr);
    }
    if cmd == "cbor test" { return cbor_selftest(); }

    // === Syslog server commands ===
    if cmd == "syslogd" { return syslog_srv_list(10); }
    if cmd == "syslogd start" { syslog_srv_start(); return "syslogd: started on UDP 514"; }
    if cmd == "syslogd stop" { syslog_srv_stop(); return "syslogd: stopped"; }
    if cmd == "syslogd clear" { syslog_srv_clear(); return "syslogd: buffer cleared"; }
    if cmd == "syslogd status" { return syslog_srv_status(); }
    if str_starts_with(cmd, "syslogd last ") {
        let n = parse_int(str_sub(cmd, 13, len(cmd)));
        return syslog_srv_list(n);
    }

    // === CPIO archive commands ===
    if cmd == "cpio list" { return cpio_list(); }
    if str_starts_with(cmd, "cpio load ") {
        let path = str_sub(cmd, 10, len(cmd));
        let n = cpio_load(path);
        if n < 0 { return "cpio: load failed"; }
        return "cpio: loaded " + to_string(n) + " entries from " + path;
    }
    if str_starts_with(cmd, "cpio extract ") {
        let args = str_sub(cmd, 13, len(cmd));
        let space = str_index_of(args, " ");
        if space < 0 { return "cpio: usage: cpio extract <index> <dest>"; }
        let idx = parse_int(str_sub(args, 0, space));
        let dest = str_sub(args, space + 1, len(args));
        let res = cpio_extract(idx, dest);
        if res < 0 { return "cpio: extract failed"; }
        return "cpio: extracted " + cpio_get_name(idx) + " to " + dest;
    }
    if cmd == "cpio test" { return cpio_selftest(); }
    if cmd == "cpio clear" { cpio_clear(); return "cpio: cleared"; }

    // === Quoted-Printable commands ===
    if str_starts_with(cmd, "qp encode ") {
        let text = str_sub(cmd, 10, len(cmd));
        let n = qp_encode(text);
        if n < 0 { return "qp: encode failed"; }
        return qp_get_result();
    }
    if str_starts_with(cmd, "qp decode ") {
        let text = str_sub(cmd, 10, len(cmd));
        let n = qp_decode(text);
        if n < 0 { return "qp: decode failed"; }
        return qp_get_result();
    }
    if cmd == "qp show" { return qp_get_result(); }
    if cmd == "qp test" { return qp_selftest(); }

    // === UUencode commands ===
    if str_starts_with(cmd, "uu encode ") {
        let args = str_sub(cmd, 10, len(cmd));
        let space = str_index_of(args, " ");
        if space < 0 { return "uu: usage: uu encode <text> <filename>"; }
        let text = str_sub(args, 0, space);
        let fname = str_sub(args, space + 1, len(args));
        let n = uu_encode(text, fname);
        if n < 0 { return "uu: encode failed"; }
        return uu_get_result();
    }
    if str_starts_with(cmd, "uu decode ") {
        let text = str_sub(cmd, 10, len(cmd));
        let n = uu_decode(text);
        if n < 0 { return "uu: decode failed"; }
        return uu_get_result();
    }
    if cmd == "uu show" { return uu_get_result(); }
    if cmd == "uu test" { return uu_selftest(); }

    // === ASN.1 DER commands ===
    if str_starts_with(cmd, "asn1 int ") {
        asn1_clear();
        let val = parse_int(str_sub(cmd, 9, len(cmd)));
        asn1_encode_integer(val);
        return asn1_get_hex();
    }
    if str_starts_with(cmd, "asn1 str ") {
        asn1_clear();
        let text = str_sub(cmd, 9, len(cmd));
        asn1_encode_octet_string(text);
        return asn1_get_hex();
    }
    if cmd == "asn1 null" {
        asn1_clear();
        asn1_encode_null();
        return asn1_get_hex();
    }
    if str_starts_with(cmd, "asn1 decode ") {
        let hex = str_sub(cmd, 12, len(cmd));
        return "asn1 decode: not yet implemented";
    }
    if cmd == "asn1 test" { return asn1_selftest(); }

    // === PEM format commands ===
    if str_starts_with(cmd, "pem parse ") {
        let data = str_sub(cmd, 10, len(cmd));
        let n = pem_parse(data);
        if n < 0 { return "pem: parse failed"; }
        return "pem: label=" + pem_get_label() + ", decoded " + to_string(n) + " bytes";
    }
    if str_starts_with(cmd, "pem load ") {
        let path = str_sub(cmd, 9, len(cmd));
        let n = pem_load(path);
        if n < 0 { return "pem: load failed"; }
        return "pem: label=" + pem_get_label() + ", decoded " + to_string(n) + " bytes";
    }
    if cmd == "pem show" { return pem_get_data(); }
    if cmd == "pem label" { return "pem: label=" + pem_get_label(); }
    if cmd == "pem test" { return pem_selftest(); }

    // === JWT commands ===
    if str_starts_with(cmd, "jwt parse ") {
        let token = str_sub(cmd, 10, len(cmd));
        let res = jwt_parse(token);
        if res < 0 { return "jwt: parse failed"; }
        return jwt_display();
    }
    if cmd == "jwt header" { return jwt_get_header(); }
    if cmd == "jwt payload" { return jwt_get_payload(); }
    if cmd == "jwt sub" { return "sub: " + jwt_get_sub(); }
    if cmd == "jwt iss" { return "iss: " + jwt_get_iss(); }
    if cmd == "jwt exp" {
        let exp = jwt_get_exp();
        if jwt_is_expired() == 1 {
            return "exp: " + to_string(exp) + " (EXPIRED)";
        }
        return "exp: " + to_string(exp) + " (valid)";
    }
    if cmd == "jwt test" { return jwt_selftest(); }

    // === BMP image commands ===
    if str_starts_with(cmd, "bmp load ") {
        let path = str_sub(cmd, 9, len(cmd));
        let res = bmp_load(path);
        if res < 0 { return "bmp: load failed"; }
        return "bmp: loaded " + to_string(bmp_get_width()) + "x" + to_string(bmp_get_height()) + " image";
    }
    if cmd == "bmp info" { return bmp_info(); }
    if str_starts_with(cmd, "bmp show ") {
        let args = str_sub(cmd, 9, len(cmd));
        let space = str_index_of(args, " ");
        if space < 0 { return "bmp: usage: bmp show <x> <y>"; }
        let x = parse_int(str_sub(args, 0, space));
        let y = parse_int(str_sub(args, space + 1, len(args)));
        let res = bmp_display(x, y);
        if res < 0 { return "bmp: display failed"; }
        return "bmp: displayed at (" + to_string(x) + "," + to_string(y) + ")";
    }
    if cmd == "bmp test" { return bmp_selftest(); }

    // === GIF image commands ===
    if str_starts_with(cmd, "gif load ") {
        let path = str_sub(cmd, 9, len(cmd));
        let res = gif_load(path);
        if res < 0 { return "gif: load failed"; }
        return "gif: loaded " + to_string(gif_get_width()) + "x" + to_string(gif_get_height()) + " image";
    }
    if cmd == "gif info" { return gif_info(); }
    if cmd == "gif palette" { return gif_list_palette(); }
    if cmd == "gif test" { return gif_selftest(); }

    // === WAV audio commands ===
    if str_starts_with(cmd, "wav load ") {
        let path = str_sub(cmd, 9, len(cmd));
        let res = wav_load(path);
        if res < 0 { return "wav: load failed"; }
        return "wav: loaded " + to_string(wav_get_sample_rate()) + " Hz audio";
    }
    if cmd == "wav info" { return wav_info(); }
    if cmd == "wav play" {
        let res = wav_play();
        if res < 0 { return "wav: play failed"; }
        return "wav: playing...";
    }
    if cmd == "wav test" { return wav_selftest(); }

    // === Base32 encoding commands ===
    if str_starts_with(cmd, "base32 enc ") {
        let text = str_sub(cmd, 11, len(cmd));
        let n = base32_encode(text);
        if n < 0 { return "base32: encode failed"; }
        return base32_get_result();
    }
    if str_starts_with(cmd, "base32 dec ") {
        let text = str_sub(cmd, 11, len(cmd));
        let n = base32_decode(text);
        if n < 0 { return "base32: decode failed"; }
        return base32_get_result();
    }
    if cmd == "base32 test" { return base32_selftest(); }

    // === Hex encoding commands ===
    if str_starts_with(cmd, "hex enc ") {
        let text = str_sub(cmd, 8, len(cmd));
        let n = hex_encode(text);
        if n < 0 { return "hex: encode failed"; }
        return hex_get_result();
    }
    if str_starts_with(cmd, "hex dec ") {
        let text = str_sub(cmd, 8, len(cmd));
        let n = hex_decode(text);
        if n < 0 { return "hex: decode failed"; }
        return hex_get_result();
    }
    if str_starts_with(cmd, "hex dump ") {
        let text = str_sub(cmd, 9, len(cmd));
        return hex_dump(text, 0, len(text));
    }
    if cmd == "hex test" { return hex_selftest(); }

    // === URL encoding commands ===
    if str_starts_with(cmd, "url enc ") {
        let text = str_sub(cmd, 8, len(cmd));
        let n = url_encode(text);
        if n < 0 { return "url: encode failed"; }
        return url_get_result();
    }
    if str_starts_with(cmd, "url dec ") {
        let text = str_sub(cmd, 8, len(cmd));
        let n = url_decode(text);
        if n < 0 { return "url: decode failed"; }
        return url_get_result();
    }
    if str_starts_with(cmd, "url query ") {
        let query = str_sub(cmd, 10, len(cmd));
        return url_parse_query(query);
    }
    if cmd == "url test" { return url_selftest(); }

    // === CRC checksum commands ===
    if str_starts_with(cmd, "crc8 ") {
        let text = str_sub(cmd, 5, len(cmd));
        let c = crc8(text);
        return "crc8: " + crc_to_hex(c, 2);
    }
    if str_starts_with(cmd, "crc16 ") {
        let text = str_sub(cmd, 6, len(cmd));
        let c = crc16(text);
        return "crc16: " + crc_to_hex(c, 4);
    }
    if str_starts_with(cmd, "crc32 ") {
        let text = str_sub(cmd, 6, len(cmd));
        let c = crc32_simple(text);
        return "crc32: " + crc_to_hex(c, 8);
    }
    if cmd == "crc test" { return crc_selftest(); }

    // === MD5 hash commands ===
    if str_starts_with(cmd, "md5 ") {
        let text = str_sub(cmd, 4, len(cmd));
        return "md5: " + md5(text);
    }
    if cmd == "md5 test" { return md5_selftest(); }

    // === SHA1 hash commands ===
    if str_starts_with(cmd, "sha1 ") {
        let text = str_sub(cmd, 5, len(cmd));
        return "sha1: " + sha1(text);
    }
    if cmd == "sha1 test" { return sha1_selftest(); }

    // === HMAC commands ===
    if str_starts_with(cmd, "hmac-md5 ") {
        let args = str_sub(cmd, 9, len(cmd));
        let space = str_index_of(args, " ");
        if space < 0 { return "hmac: usage: hmac-md5 <key> <message>"; }
        let key = str_sub(args, 0, space);
        let msg = str_sub(args, space + 1, len(args));
        return "hmac-md5: " + hmac_md5(key, msg);
    }
    if str_starts_with(cmd, "hmac-sha1 ") {
        let args = str_sub(cmd, 10, len(cmd));
        let space = str_index_of(args, " ");
        if space < 0 { return "hmac: usage: hmac-sha1 <key> <message>"; }
        let key = str_sub(args, 0, space);
        let msg = str_sub(args, space + 1, len(args));
        return "hmac-sha1: " + hmac_sha1(key, msg);
    }
    if cmd == "hmac test" { return hmac_selftest(); }

    // === PBKDF2 commands ===
    if str_starts_with(cmd, "pbkdf2 ") {
        let args = str_sub(cmd, 7, len(cmd));
        return "pbkdf2: usage: pbkdf2 <password> <salt> <iterations> <keylen>";
    }
    if cmd == "pbkdf2 test" { return pbkdf2_selftest(); }

    // === UUID commands ===
    if cmd == "uuid" { return uuid_v4(); }
    if cmd == "uuid v4" { return uuid_v4(); }
    if cmd == "uuid nil" { return uuid_nil(); }
    if str_starts_with(cmd, "uuid validate ") {
        let u = str_sub(cmd, 14, len(cmd));
        let v = uuid_validate(u);
        if v == 1 { return "uuid: valid"; }
        return "uuid: invalid";
    }
    if cmd == "uuid test" { return uuid_selftest(); }

    // === RLE commands ===
    if str_starts_with(cmd, "rle encode ") {
        let data = str_sub(cmd, 11, len(cmd));
        let compressed_len = rle_encode(data);
        return "rle: encoded " + to_string(len(data)) + " → " + to_string(compressed_len) + " bytes";
    }
    if str_starts_with(cmd, "rle decode ") {
        let data = str_sub(cmd, 11, len(cmd));
        let decompressed_len = rle_decode(data);
        let result = rle_get_result();
        return "rle: decoded " + to_string(len(data)) + " → " + to_string(decompressed_len) + " bytes: " + result;
    }
    if str_starts_with(cmd, "rle ratio ") {
        let parts = str_split(str_sub(cmd, 10, len(cmd)), " ");
        if len(parts) >= 2 {
            let orig = parse_int(parts[0]);
            let comp = parse_int(parts[1]);
            return "rle: ratio = " + rle_ratio(orig, comp) + "%";
        }
        return "rle: usage: rle ratio <original_size> <compressed_size>";
    }
    if str_starts_with(cmd, "rle hex ") {
        let data = str_sub(cmd, 8, len(cmd));
        let hex = rle_encode_to_hex(data);
        return "rle: hex = " + hex;
    }
    if cmd == "rle test" { return rle_test(); }

    // === RSS commands ===
    if str_starts_with(cmd, "rss parse ") {
        let xml = str_sub(cmd, 10, len(cmd));
        let count = rss_parse(xml);
        return "rss: parsed " + to_string(count) + " items";
    }
    if cmd == "rss channel" {
        return "rss: " + rss_get_channel_title() + " | " + rss_get_channel_link();
    }
    if cmd == "rss items" {
        let mut output = "rss: " + to_string(rss_get_item_count()) + " items\n";
        let mut i = 0;
        while i < rss_get_item_count() {
            output = output + "[" + to_string(i) + "] " + rss_get_item_title(i) + "\n";
            i = i + 1;
        }
        return output;
    }
    if str_starts_with(cmd, "rss item ") {
        let idx = parse_int(str_sub(cmd, 9, len(cmd)));
        let title = rss_get_item_title(idx);
        let link = rss_get_item_link(idx);
        let desc = rss_get_item_desc(idx);
        return "rss: [" + to_string(idx) + "] " + title + "\n  " + link + "\n  " + desc;
    }
    if cmd == "rss count" { return "rss: " + to_string(rss_get_item_count()) + " items"; }
    if cmd == "rss test" { return rss_test(); }

    // === LDAP commands ===
    if str_starts_with(cmd, "ldap connect ") {
        let host = str_sub(cmd, 13, len(cmd));
        let result = ldap_connect(host);
        if result == 0 { return "ldap: connected to " + host; }
        return "ldap: connection failed";
    }
    if str_starts_with(cmd, "ldap bind ") {
        let parts = str_split(str_sub(cmd, 10, len(cmd)), " ");
        if len(parts) >= 2 {
            let dn = parts[0];
            let password = parts[1];
            let result = ldap_bind(dn, password);
            if result == 0 { return "ldap: bind successful"; }
            return "ldap: bind failed";
        }
        return "ldap: usage: ldap bind <dn> <password>";
    }
    if str_starts_with(cmd, "ldap search ") {
        let parts = str_split(str_sub(cmd, 12, len(cmd)), " ");
        if len(parts) >= 2 {
            let base_dn = parts[0];
            let filter = parts[1];
            let result = ldap_search(base_dn, filter, 2);
            if result == 0 { return "ldap: search request sent"; }
            return "ldap: search failed";
        }
        return "ldap: usage: ldap search <base_dn> <filter>";
    }
    if cmd == "ldap unbind" { return ldap_unbind(); }
    if cmd == "ldap disconnect" { return ldap_disconnect(); }
    if cmd == "ldap test" { return ldap_test(); }

    // === AES commands ===
    if str_starts_with(cmd, "aes key ") {
        let key = str_sub(cmd, 8, len(cmd));
        aes_set_key(key);
        return "aes: key set (" + to_string(len(key)) + " bytes)";
    }
    if str_starts_with(cmd, "aes encrypt ") {
        let plaintext = str_sub(cmd, 12, len(cmd));
        let enc_len = aes_encrypt(plaintext);
        return "aes: encrypted " + to_string(len(plaintext)) + " → " + to_string(enc_len) + " bytes";
    }
    if str_starts_with(cmd, "aes decrypt ") {
        let ciphertext = str_sub(cmd, 12, len(cmd));
        let dec_len = aes_decrypt(ciphertext);
        let result = aes_get_result();
        return "aes: decrypted " + to_string(len(ciphertext)) + " → " + to_string(dec_len) + " bytes";
    }
    if cmd == "aes hex" {
        let hex = aes_get_hex();
        return "aes: " + hex;
    }
    if cmd == "aes test" { return aes_test(); }

    // === Huffman commands ===
    if str_starts_with(cmd, "huffman encode ") {
        let data = str_sub(cmd, 15, len(cmd));
        let enc_len = huffman_encode(data);
        let ratio = huffman_ratio(len(data), enc_len);
        return "huffman: encoded " + to_string(len(data)) + " → " + to_string(enc_len) + " bytes (" + ratio + "%)";
    }
    if str_starts_with(cmd, "huffman decode ") {
        let data = str_sub(cmd, 15, len(cmd));
        let dec_len = huffman_decode(data);
        return "huffman: decoded " + to_string(len(data)) + " → " + to_string(dec_len) + " bytes";
    }
    if str_starts_with(cmd, "huffman ratio ") {
        let parts = str_split(str_sub(cmd, 14, len(cmd)), " ");
        if len(parts) >= 2 {
            let orig = parse_int(parts[0]);
            let comp = parse_int(parts[1]);
            return "huffman: ratio = " + huffman_ratio(orig, comp) + "%";
        }
        return "huffman: usage: huffman ratio <original_size> <compressed_size>";
    }
    if cmd == "huffman test" { return huffman_test(); }

    // === RADIUS commands ===
    if str_starts_with(cmd, "radius secret ") {
        let secret = str_sub(cmd, 14, len(cmd));
        radius_set_secret(secret);
        return "radius: shared secret set";
    }
    if str_starts_with(cmd, "radius request ") {
        let parts = str_split(str_sub(cmd, 15, len(cmd)), " ");
        if len(parts) >= 2 {
            let username = parts[0];
            let password = parts[1];
            let req_len = radius_create_access_request(username, password);
            return "radius: Access-Request created (" + to_string(req_len) + " bytes)";
        }
        return "radius: usage: radius request <username> <password>";
    }
    if str_starts_with(cmd, "radius send ") {
        let parts = str_split(str_sub(cmd, 12, len(cmd)), " ");
        if len(parts) >= 1 {
            let server = parts[0];
            let result = radius_send_request(server, RADIUS_PORT_AUTH);
            if result == 0 { return "radius: request sent to " + server; }
            return "radius: send failed";
        }
        return "radius: usage: radius send <server>";
    }
    if str_starts_with(cmd, "radius parse ") {
        let data = str_sub(cmd, 13, len(cmd));
        let result = radius_parse_response(data);
        if result == 1 { return "radius: Access-Accept"; }
        if result == 0 { return "radius: Access-Reject"; }
        return "radius: parse error";
    }
    if cmd == "radius test" { return radius_test(); }

    // === SHA256 commands ===
    if str_starts_with(cmd, "sha256 ") {
        let data = str_sub(cmd, 7, len(cmd));
        return "sha256: " + sha256(data);
    }
    if cmd == "sha256 test" { return sha256_test(); }

    // === DHCP Server commands ===
    if cmd == "dhcpsrv start" {
        return "dhcpsrv: server started on port " + to_string(DHCP_SRV_PORT);
    }
    if str_starts_with(cmd, "dhcpsrv pool ") {
        let parts = str_split(str_sub(cmd, 13, len(cmd)), " ");
        if len(parts) >= 2 {
            let start = parse_int(parts[0]);
            let end = parse_int(parts[1]);
            dhcp_server_set_pool(start, end);
            return "dhcpsrv: pool set";
        }
        return "dhcpsrv: usage: dhcpsrv pool <start_ip> <end_ip>";
    }
    if str_starts_with(cmd, "dhcpsrv options ") {
        let parts = str_split(str_sub(cmd, 16, len(cmd)), " ");
        if len(parts) >= 3 {
            let subnet = parse_int(parts[0]);
            let router = parse_int(parts[1]);
            let dns = parse_int(parts[2]);
            dhcp_server_set_options(subnet, router, dns);
            return "dhcpsrv: options set";
        }
        return "dhcpsrv: usage: dhcpsrv options <subnet> <router> <dns>";
    }
    if cmd == "dhcpsrv leases" { return dhcp_server_list_leases(); }
    if cmd == "dhcpsrv test" { return dhcp_server_test(); }

    // === SIP commands ===
    if str_starts_with(cmd, "sip local ") {
        let parts = str_split(str_sub(cmd, 10, len(cmd)), " ");
        if len(parts) >= 2 {
            let ip = parts[0];
            let port = parse_int(parts[1]);
            sip_set_local(ip, port);
            return "sip: local endpoint set to " + ip + ":" + to_string(port);
        }
        return "sip: usage: sip local <ip> <port>";
    }
    if str_starts_with(cmd, "sip invite ") {
        let parts = str_split(str_sub(cmd, 11, len(cmd)), " ");
        if len(parts) >= 3 {
            let from = parts[0];
            let to = parts[1];
            let host = parts[2];
            let len = sip_create_invite(from, to, host);
            return "sip: INVITE created (" + to_string(len) + " bytes)";
        }
        return "sip: usage: sip invite <from> <to> <host>";
    }
    if str_starts_with(cmd, "sip ack ") {
        let parts = str_split(str_sub(cmd, 8, len(cmd)), " ");
        if len(parts) >= 2 {
            let to = parts[0];
            let host = parts[1];
            let len = sip_create_ack(to, host);
            return "sip: ACK created (" + to_string(len) + " bytes)";
        }
        return "sip: usage: sip ack <to> <host>";
    }
    if str_starts_with(cmd, "sip bye ") {
        let parts = str_split(str_sub(cmd, 8, len(cmd)), " ");
        if len(parts) >= 2 {
            let to = parts[0];
            let host = parts[1];
            let len = sip_create_bye(to, host);
            return "sip: BYE created (" + to_string(len) + " bytes)";
        }
        return "sip: usage: sip bye <to> <host>";
    }
    if str_starts_with(cmd, "sip register ") {
        let parts = str_split(str_sub(cmd, 13, len(cmd)), " ");
        if len(parts) >= 2 {
            let user = parts[0];
            let registrar = parts[1];
            let len = sip_create_register(user, registrar);
            return "sip: REGISTER created (" + to_string(len) + " bytes)";
        }
        return "sip: usage: sip register <user> <registrar>";
    }
    if str_starts_with(cmd, "sip parse ") {
        let data = str_sub(cmd, 10, len(cmd));
        let status = sip_parse_response(data);
        if status > 0 { return "sip: response code " + to_string(status); }
        return "sip: parse error";
    }
    if cmd == "sip test" { return sip_test(); }

    // === Bcrypt commands ===
    if str_starts_with(cmd, "bcrypt cost ") {
        let cost = parse_int(str_sub(cmd, 12, len(cmd)));
        bcrypt_set_cost(cost);
        return "bcrypt: cost set to " + to_string(cost);
    }
    if str_starts_with(cmd, "bcrypt hash ") {
        let password = str_sub(cmd, 12, len(cmd));
        let hash = bcrypt_hash(password);
        return "bcrypt: " + hash;
    }
    if str_starts_with(cmd, "bcrypt verify ") {
        let parts = str_split(str_sub(cmd, 14, len(cmd)), " ");
        if len(parts) >= 2 {
            let password = parts[0];
            let hash = parts[1];
            let result = bcrypt_verify(password, hash);
            if result == 1 { return "bcrypt: password matches"; }
            return "bcrypt: password does not match";
        }
        return "bcrypt: usage: bcrypt verify <password> <hash>";
    }
    if cmd == "bcrypt test" { return bcrypt_test(); }

    // === RTSP commands ===
    if str_starts_with(cmd, "rtsp options ") {
        let url = str_sub(cmd, 13, len(cmd));
        let len = rtsp_create_options(url);
        return "rtsp: OPTIONS created (" + to_string(len) + " bytes)";
    }
    if str_starts_with(cmd, "rtsp describe ") {
        let url = str_sub(cmd, 14, len(cmd));
        let len = rtsp_create_describe(url);
        return "rtsp: DESCRIBE created (" + to_string(len) + " bytes)";
    }
    if str_starts_with(cmd, "rtsp setup ") {
        let parts = str_split(str_sub(cmd, 11, len(cmd)), " ");
        if len(parts) >= 2 {
            let url = parts[0];
            let port = parse_int(parts[1]);
            let len = rtsp_create_setup(url, port);
            return "rtsp: SETUP created (" + to_string(len) + " bytes)";
        }
        return "rtsp: usage: rtsp setup <url> <client_port>";
    }
    if str_starts_with(cmd, "rtsp play ") {
        let url = str_sub(cmd, 10, len(cmd));
        let len = rtsp_create_play(url);
        return "rtsp: PLAY created (" + to_string(len) + " bytes)";
    }
    if str_starts_with(cmd, "rtsp pause ") {
        let url = str_sub(cmd, 11, len(cmd));
        let len = rtsp_create_pause(url);
        return "rtsp: PAUSE created (" + to_string(len) + " bytes)";
    }
    if str_starts_with(cmd, "rtsp teardown ") {
        let url = str_sub(cmd, 14, len(cmd));
        let len = rtsp_create_teardown(url);
        return "rtsp: TEARDOWN created (" + to_string(len) + " bytes)";
    }
    if cmd == "rtsp test" { return rtsp_test(); }

    // === STUN commands ===
    if cmd == "stun request" {
        let len = stun_create_binding_request();
        return "stun: Binding Request created (" + to_string(len) + " bytes)";
    }
    if str_starts_with(cmd, "stun parse ") {
        let data = str_sub(cmd, 11, len(cmd));
        let result = stun_parse_response(data);
        if result == 0 { return "stun: response parsed successfully"; }
        return "stun: parse error";
    }
    if cmd == "stun addr" {
        let addr = stun_get_mapped_address();
        if len(addr) > 0 { return "stun: mapped address = " + addr; }
        return "stun: no mapped address available";
    }
    if cmd == "stun test" { return stun_test(); }

    // === RTP commands ===
    if str_starts_with(cmd, "rtp create ") {
        let parts = str_split(str_sub(cmd, 11, len(cmd)), " ");
        if len(parts) >= 2 {
            let payload_len = parse_int(parts[0]);
            let marker = parse_int(parts[1]);
            let payload = rtp_get_payload(rtp_create_packet([], payload_len, marker), payload_len, []);
            return "rtp: packet created (" + to_string(payload_len) + " bytes payload, marker=" + to_string(marker) + ")";
        }
        return "rtp: usage: rtp create <payload_len> <marker>";
    }
    if str_starts_with(cmd, "rtp parse ") {
        let data = str_sub(cmd, 10, len(cmd));
        let parsed = rtp_parse_packet(data, len(data));
        if parsed == 0 { return "rtp: parse error"; }
        return "rtp: " + rtp_format_info(parsed);
    }
    if str_starts_with(cmd, "rtp setpt ") {
        let pt = parse_int(str_sub(cmd, 10, len(cmd)));
        let result = rtp_set_payload_type(pt);
        if result == 0 { return "rtp: payload type set to " + to_string(pt) + " (" + rtp_get_payload_name(pt) + ")"; }
        return "rtp: invalid payload type";
    }
    if cmd == "rtp info" {
        return "rtp: ssrc=" + to_string(rtp_get_ssrc()) + " seq=" + to_string(rtp_get_sequence()) + " ts=" + to_string(rtp_get_timestamp());
    }
    if cmd == "rtp test" {
        let result = rtp_create_packet([], 160, 0);
        if result > 0 { return "rtp: test passed"; }
        return "rtp: test failed";
    }

    // === SOCKS commands ===
    if str_starts_with(cmd, "socks proxy ") {
        let parts = str_split(str_sub(cmd, 12, len(cmd)), " ");
        if len(parts) >= 2 {
            let host = parts[0];
            let port = parse_int(parts[1]);
            socks_set_proxy(host, port);
            return "socks: proxy set to " + host + ":" + to_string(port);
        }
        return "socks: usage: socks proxy <host> <port>";
    }
    if str_starts_with(cmd, "socks auth ") {
        let parts = str_split(str_sub(cmd, 11, len(cmd)), " ");
        if len(parts) >= 2 {
            let user = parts[0];
            let pass = parts[1];
            socks_set_auth(user, pass);
            return "socks: authentication set";
        }
        return "socks: usage: socks auth <username> <password>";
    }
    if str_starts_with(cmd, "socks connect ") {
        let parts = str_split(str_sub(cmd, 14, len(cmd)), " ");
        if len(parts) >= 2 {
            let host = parts[0];
            let port = parse_int(parts[1]);
            let sock = socks_connect(host, port);
            if sock >= 0 { return "socks: connected to " + host + ":" + to_string(port) + " (socket " + to_string(sock) + ")"; }
            return "socks: connection failed (error " + to_string(sock) + ")";
        }
        return "socks: usage: socks connect <host> <port>";
    }
    if cmd == "socks close" {
        socks_close();
        return "socks: connection closed";
    }
    if cmd == "socks test" {
        socks_set_proxy("127.0.0.1", 1080);
        return "socks: test - proxy configured";
    }

    // === ZLIB commands ===
    if str_starts_with(cmd, "zlib compress ") {
        let data = str_sub(cmd, 14, len(cmd));
        let comp_len = zlib_compress(data, len(data));
        if comp_len > 0 { return "zlib: compressed " + to_string(len(data)) + " -> " + to_string(comp_len) + " bytes"; }
        return "zlib: compression failed";
    }
    if str_starts_with(cmd, "zlib decompress ") {
        let data = str_sub(cmd, 16, len(cmd));
        let decomp_len = zlib_decompress(data, len(data));
        if decomp_len > 0 { return "zlib: decompressed " + to_string(len(data)) + " -> " + to_string(decomp_len) + " bytes"; }
        return "zlib: decompression failed (error " + to_string(decomp_len) + ")";
    }
    if str_starts_with(cmd, "zlib level ") {
        let level = parse_int(str_sub(cmd, 11, len(cmd)));
        let result = zlib_set_level(level);
        if result == 0 { return "zlib: compression level set to " + to_string(level); }
        return "zlib: invalid level (must be 1-9)";
    }
    if str_starts_with(cmd, "zlib ratio ") {
        let parts = str_split(str_sub(cmd, 11, len(cmd)), " ");
        if len(parts) >= 2 {
            let orig = parse_int(parts[0]);
            let comp = parse_int(parts[1]);
            return "zlib: " + zlib_format_info(orig, comp);
        }
        return "zlib: usage: zlib ratio <original_size> <compressed_size>";
    }
    if cmd == "zlib test" { return zlib_test(); }

    // === LZMA commands ===
    if str_starts_with(cmd, "lzma compress ") {
        let data = str_sub(cmd, 14, len(cmd));
        let comp_len = lzma_compress(data, len(data));
        if comp_len > 0 { return "lzma: compressed " + to_string(len(data)) + " -> " + to_string(comp_len) + " bytes"; }
        return "lzma: compression failed";
    }
    if str_starts_with(cmd, "lzma decompress ") {
        let data = str_sub(cmd, 16, len(cmd));
        let decomp_len = lzma_decompress(data, len(data));
        if decomp_len > 0 { return "lzma: decompressed " + to_string(len(data)) + " -> " + to_string(decomp_len) + " bytes"; }
        return "lzma: decompression failed (error " + to_string(decomp_len) + ")";
    }
    if cmd == "lzma ratio" {
        let ratio = lzma_get_ratio();
        return "lzma: compression ratio = " + to_string(ratio) + "%";
    }
    if cmd == "lzma test" { return lzma_test(); }

    // === Protobuf commands ===
    if cmd == "protobuf start" {
        protobuf_start();
        return "protobuf: message started";
    }
    if str_starts_with(cmd, "protobuf addint ") {
        let parts = str_split(str_sub(cmd, 16, len(cmd)), " ");
        if len(parts) >= 2 {
            let field = parse_int(parts[0]);
            let value = parse_int(parts[1]);
            let len = protobuf_add_varint(field, value);
            return "protobuf: added varint field " + to_string(field) + " = " + to_string(value) + " (total " + to_string(len) + " bytes)";
        }
        return "protobuf: usage: protobuf addint <field_num> <value>";
    }
    if str_starts_with(cmd, "protobuf addstr ") {
        let parts = str_split(str_sub(cmd, 16, len(cmd)), " ");
        if len(parts) >= 2 {
            let field = parse_int(parts[0]);
            let str = parts[1];
            let len = protobuf_add_string(field, str);
            return "protobuf: added string field " + to_string(field) + " = '" + str + "' (total " + to_string(len) + " bytes)";
        }
        return "protobuf: usage: protobuf addstr <field_num> <string>";
    }
    if str_starts_with(cmd, "protobuf decode ") {
        let data = str_sub(cmd, 16, len(cmd));
        protobuf_decode_start(data);
        let field = protobuf_decode_field(data, len(data));
        if field == 0 { return "protobuf: no fields found"; }
        return "protobuf: " + protobuf_format_field(field);
    }
    if cmd == "protobuf test" { return protobuf_test(); }

    // === ChaCha20 commands ===
    if str_starts_with(cmd, "chacha20 key ") {
        let key = str_sub(cmd, 13, len(cmd));
        chacha20_set_key(key);
        return "chacha20: key set (" + to_string(len(key)) + " bytes)";
    }
    if str_starts_with(cmd, "chacha20 nonce ") {
        let nonce = str_sub(cmd, 15, len(cmd));
        chacha20_set_nonce(nonce);
        return "chacha20: nonce set (" + to_string(len(nonce)) + " bytes)";
    }
    if str_starts_with(cmd, "chacha20 encrypt ") {
        let data = str_sub(cmd, 17, len(cmd));
        let result = chacha20_crypt(data, len(data));
        return "chacha20: encrypted " + to_string(len(data)) + " bytes";
    }
    if str_starts_with(cmd, "chacha20 decrypt ") {
        let data = str_sub(cmd, 17, len(cmd));
        let result = chacha20_crypt(data, len(data));
        return "chacha20: decrypted " + to_string(len(data)) + " bytes";
    }
    if cmd == "chacha20 test" { return chacha20_test(); }

    // === RSA commands ===
    if cmd == "rsa genkey" {
        let result = rsa_generate_keys();
        if result == 0 { return "rsa: keys generated - " + rsa_get_public_key(); }
        return "rsa: key generation failed";
    }
    if str_starts_with(cmd, "rsa encrypt ") {
        let msg = str_sub(cmd, 12, len(cmd));
        let cipher = rsa_encrypt(msg);
        if cipher >= 0 { return "rsa: encrypted = " + to_string(cipher); }
        return "rsa: encryption failed";
    }
    if str_starts_with(cmd, "rsa decrypt ") {
        let cipher = parse_int(str_sub(cmd, 12, len(cmd)));
        let plain = rsa_decrypt(cipher);
        if plain >= 0 { return "rsa: decrypted = " + to_string(plain); }
        return "rsa: decryption failed";
    }
    if cmd == "rsa pubkey" { return "rsa: " + rsa_get_public_key(); }
    if cmd == "rsa test" { return rsa_test(); }

    // === Ed25519 commands ===
    if cmd == "ed25519 genkey" {
        ed25519_generate_keys();
        return "ed25519: " + ed25519_format_keys();
    }
    if str_starts_with(cmd, "ed25519 sign ") {
        let msg = str_sub(cmd, 13, len(cmd));
        let sig = ed25519_sign(msg);
        return "ed25519: signature = " + ed25519_get_signature();
    }
    if str_starts_with(cmd, "ed25519 verify ") {
        let parts = str_split(str_sub(cmd, 15, len(cmd)), " ");
        if len(parts) >= 2 {
            let msg = parts[0];
            let sig = parts[1];
            let valid = ed25519_verify(msg, sig);
            if valid == 1 { return "ed25519: signature valid"; }
            return "ed25519: signature invalid";
        }
        return "ed25519: usage: ed25519 verify <message> <signature>";
    }
    if cmd == "ed25519 pubkey" { return "ed25519: " + ed25519_get_public_key(); }
    if cmd == "ed25519 test" { return ed25519_test(); }

    // === Avro commands ===
    if cmd == "avro start" {
        avro_start();
        return "avro: message started";
    }
    if str_starts_with(cmd, "avro addint ") {
        let val = parse_int(str_sub(cmd, 12, len(cmd)));
        let len = avro_add_int(val);
        return "avro: added int " + to_string(val) + " (total " + to_string(len) + " bytes)";
    }
    if str_starts_with(cmd, "avro addstr ") {
        let str = str_sub(cmd, 12, len(cmd));
        let len = avro_add_string(str);
        return "avro: added string '" + str + "' (total " + to_string(len) + " bytes)";
    }
    if str_starts_with(cmd, "avro person ") {
        let parts = str_split(str_sub(cmd, 12, len(cmd)), " ");
        if len(parts) >= 2 {
            let name = parts[0];
            let age = parse_int(parts[1]);
            let len = avro_create_person(name, age);
            return "avro: created person record (" + to_string(len) + " bytes)";
        }
        return "avro: usage: avro person <name> <age>";
    }
    if cmd == "avro test" { return avro_test(); }

    // === Bzip2 commands ===
    if str_starts_with(cmd, "bzip2 compress ") {
        let data = str_sub(cmd, 15, len(cmd));
        let comp_len = bzip2_compress(data, len(data));
        if comp_len > 0 { return "bzip2: compressed " + to_string(len(data)) + " -> " + to_string(comp_len) + " bytes"; }
        return "bzip2: compression failed";
    }
    if str_starts_with(cmd, "bzip2 decompress ") {
        let data = str_sub(cmd, 17, len(cmd));
        let decomp_len = bzip2_decompress(data, len(data));
        if decomp_len > 0 { return "bzip2: decompressed " + to_string(len(data)) + " -> " + to_string(decomp_len) + " bytes"; }
        return "bzip2: decompression failed (error " + to_string(decomp_len) + ")";
    }
    if cmd == "bzip2 output" {
        let len = bzip2_get_output_len();
        return "bzip2: output buffer has " + to_string(len) + " bytes";
    }
    if cmd == "bzip2 ratio" {
        let len = bzip2_get_output_len();
        return "bzip2: output = " + to_string(len) + " bytes";
    }
    if cmd == "bzip2 test" { return bzip2_test(); }

    // === Scrypt commands ===
    if str_starts_with(cmd, "scrypt derive ") {
        let parts = str_split(str_sub(cmd, 14, len(cmd)), " ");
        if len(parts) >= 2 {
            let pwd = parts[0];
            let salt = parts[1];
            scrypt_derive(pwd, salt);
            return "scrypt: key derived - " + scrypt_get_key_hex();
        }
        return "scrypt: usage: scrypt derive <password> <salt>";
    }
    if str_starts_with(cmd, "scrypt cost ") {
        let n = parse_int(str_sub(cmd, 12, len(cmd)));
        let result = scrypt_set_cost(n);
        if result == 0 { return "scrypt: cost set to " + to_string(n); }
        return "scrypt: invalid cost (must be 1-4096)";
    }
    if cmd == "scrypt key" {
        return "scrypt: key buffer ready";
    }
    if cmd == "scrypt hex" {
        return "scrypt: " + scrypt_get_key_hex();
    }
    if cmd == "scrypt test" { return scrypt_test(); }

    // === BLAKE2 commands ===
    if str_starts_with(cmd, "blake2 hash ") {
        let data = str_sub(cmd, 12, len(cmd));
        blake2_hash_data(data, len(data));
        return "blake2: " + blake2_get_hex();
    }
    if cmd == "blake2 hex" {
        return "blake2: " + blake2_get_hex();
    }
    if cmd == "blake2 digest" {
        return "blake2: digest size = 32 bytes";
    }
    if cmd == "blake2 size" {
        return "blake2: block size = 128 bytes";
    }
    if cmd == "blake2 test" { return blake2_test(); }

    // === Snappy commands ===
    if str_starts_with(cmd, "snappy compress ") {
        let data = str_sub(cmd, 16, len(cmd));
        let comp_len = snappy_compress(data, len(data));
        if comp_len > 0 { return "snappy: compressed " + to_string(len(data)) + " -> " + to_string(comp_len) + " bytes"; }
        return "snappy: compression failed";
    }
    if str_starts_with(cmd, "snappy decompress ") {
        let data = str_sub(cmd, 18, len(cmd));
        let decomp_len = snappy_decompress(data, len(data));
        if decomp_len > 0 { return "snappy: decompressed " + to_string(len(data)) + " -> " + to_string(decomp_len) + " bytes"; }
        return "snappy: decompression failed";
    }
    if cmd == "snappy output" {
        let out = snappy_get_output();
        return "snappy: output buffer ready at " + to_string(out);
    }
    if cmd == "snappy len" {
        let len = snappy_get_output_len();
        return "snappy: output length = " + to_string(len) + " bytes";
    }
    if cmd == "snappy test" { return snappy_test(); }

    // === Argon2 commands ===
    if str_starts_with(cmd, "argon2 hash ") {
        let parts = str_split(str_sub(cmd, 12, len(cmd)), " ");
        if len(parts) >= 2 {
            let pwd = parts[0];
            let salt = parts[1];
            argon2_hash(pwd, salt);
            return "argon2: hash computed - " + argon2_get_hex();
        }
        return "argon2: usage: argon2 hash <password> <salt>";
    }
    if str_starts_with(cmd, "argon2 variant ") {
        let v = parse_int(str_sub(cmd, 15, len(cmd)));
        let result = argon2_set_variant(v);
        if result == 0 { return "argon2: variant set to " + argon2_get_variant_name(); }
        return "argon2: invalid variant (0=Argon2d, 1=Argon2i, 2=Argon2id)";
    }
    if str_starts_with(cmd, "argon2 cost ") {
        let t = parse_int(str_sub(cmd, 12, len(cmd)));
        let result = argon2_set_time_cost(t);
        if result == 0 { return "argon2: time cost set to " + to_string(t); }
        return "argon2: invalid cost (must be 1-10)";
    }
    if cmd == "argon2 hex" {
        return "argon2: " + argon2_get_hex();
    }
    if cmd == "argon2 test" { return argon2_test(); }

    // === Poly1305 commands ===
    if str_starts_with(cmd, "poly1305 key ") {
        let key = str_sub(cmd, 13, len(cmd));
        let result = poly1305_set_key(key);
        if result == 0 { return "poly1305: key set (32 bytes)"; }
        return "poly1305: key too short (need 32 bytes)";
    }
    if str_starts_with(cmd, "poly1305 update ") {
        let msg = str_sub(cmd, 16, len(cmd));
        let result = poly1305_update(msg, len(msg));
        if result == 0 { return "poly1305: message updated"; }
        return "poly1305: update failed (error " + to_string(result) + ")";
    }
    if cmd == "poly1305 tag" {
        poly1305_finalize();
        return "poly1305: tag = " + poly1305_get_hex();
    }
    if str_starts_with(cmd, "poly1305 verify ") {
        let tag = str_sub(cmd, 16, len(cmd));
        let match = poly1305_verify(tag);
        if match == 1 { return "poly1305: tag verified OK"; }
        return "poly1305: tag verification FAILED";
    }
    if cmd == "poly1305 test" { return poly1305_test(); }

    // === xxHash commands ===
    if str_starts_with(cmd, "xxhash seed ") {
        let seed = parse_int(str_sub(cmd, 12, len(cmd)));
        xxhash_set_seed(seed);
        return "xxhash: seed set to " + to_string(seed);
    }
    if str_starts_with(cmd, "xxhash hash ") {
        let data = str_sub(cmd, 12, len(cmd));
        let hash = xxhash32(data, len(data));
        return "xxhash32: " + xxhash_get_hex() + " (" + to_string(hash) + ")";
    }
    if str_starts_with(cmd, "xxhash64 ") {
        let data = str_sub(cmd, 9, len(cmd));
        let hash = xxhash64(data, len(data));
        return "xxhash64: " + xxhash_get_hex64();
    }
    if cmd == "xxhash hex" {
        return "xxhash: " + xxhash_get_hex();
    }
    if cmd == "xxhash test" { return xxhash_test(); }

    // === SipHash commands ===
    if str_starts_with(cmd, "siphash key ") {
        let key = str_sub(cmd, 12, len(cmd));
        let result = siphash_set_key(key);
        if result == 0 { return "siphash: key set (16 bytes)"; }
        return "siphash: key too short (need 16 bytes)";
    }
    if str_starts_with(cmd, "siphash hash ") {
        let data = str_sub(cmd, 13, len(cmd));
        let hash = siphash(data, len(data));
        return "siphash: " + siphash_get_hex() + " (" + to_string(hash) + ")";
    }
    if cmd == "siphash hex" {
        return "siphash: " + siphash_get_hex();
    }
    if cmd == "siphash result" {
        let result = siphash_get_result();
        return "siphash: result = " + to_string(result);
    }
    if cmd == "siphash test" { return siphash_test(); }

    // === Zstd commands ===
    if str_starts_with(cmd, "zstd compress ") {
        let data = str_sub(cmd, 14, len(cmd));
        let comp_len = zstd_compress(data, len(data));
        if comp_len > 0 { return "zstd: compressed " + to_string(len(data)) + " -> " + to_string(comp_len) + " bytes"; }
        return "zstd: compression failed";
    }
    if str_starts_with(cmd, "zstd decompress ") {
        let data = str_sub(cmd, 16, len(cmd));
        let decomp_len = zstd_decompress(data, len(data));
        if decomp_len > 0 { return "zstd: decompressed " + to_string(len(data)) + " -> " + to_string(decomp_len) + " bytes"; }
        return "zstd: decompression failed (error " + to_string(decomp_len) + ")";
    }
    if str_starts_with(cmd, "zstd level ") {
        let level = parse_int(str_sub(cmd, 11, len(cmd)));
        let result = zstd_set_level(level);
        if result == 0 { return "zstd: compression level set to " + to_string(level); }
        return "zstd: invalid level (must be 1-9)";
    }
    if str_starts_with(cmd, "zstd ratio ") {
        let orig = parse_int(str_sub(cmd, 11, len(cmd)));
        let ratio = zstd_get_ratio(orig);
        return "zstd: compression ratio = " + to_string(ratio) + "%";
    }
    if cmd == "zstd test" { return zstd_test(); }

    // === Brotli commands ===
    if str_starts_with(cmd, "brotli compress ") {
        let data = str_sub(cmd, 16, len(cmd));
        let comp_len = brotli_compress(data, len(data));
        if comp_len > 0 { return "brotli: compressed " + to_string(len(data)) + " -> " + to_string(comp_len) + " bytes"; }
        return "brotli: compression failed";
    }
    if str_starts_with(cmd, "brotli decompress ") {
        let data = str_sub(cmd, 18, len(cmd));
        let decomp_len = brotli_decompress(data, len(data));
        if decomp_len > 0 { return "brotli: decompressed " + to_string(len(data)) + " -> " + to_string(decomp_len) + " bytes"; }
        return "brotli: decompression failed (error " + to_string(decomp_len) + ")";
    }
    if str_starts_with(cmd, "brotli quality ") {
        let quality = parse_int(str_sub(cmd, 15, len(cmd)));
        let result = brotli_set_quality(quality);
        if result == 0 { return "brotli: quality set to " + to_string(quality); }
        return "brotli: invalid quality (must be 0-9)";
    }
    if str_starts_with(cmd, "brotli ratio ") {
        let orig = parse_int(str_sub(cmd, 13, len(cmd)));
        let ratio = brotli_get_ratio(orig);
        return "brotli: compression ratio = " + to_string(ratio) + "%";
    }
    if cmd == "brotli test" { return brotli_test(); }

    // === SM3 commands ===
    if str_starts_with(cmd, "sm3 hash ") {
        let data = str_sub(cmd, 9, len(cmd));
        sm3_hash(data, len(data));
        return "sm3: " + sm3_get_hex();
    }
    if cmd == "sm3 hex" {
        return "sm3: " + sm3_get_hex();
    }
    if cmd == "sm3 test" { return sm3_test(); }

    // === SM4 commands ===
    if str_starts_with(cmd, "sm4 key ") {
        let key = str_sub(cmd, 8, len(cmd));
        let result = sm4_set_key(key);
        if result == 0 { return "sm4: key set (16 bytes)"; }
        return "sm4: key too short (need 16 bytes)";
    }
    if str_starts_with(cmd, "sm4 encrypt ") {
        let data = str_sub(cmd, 12, len(cmd));
        let ciphertext = sm4_encrypt_block(data);
        if ciphertext != 0 { return "sm4: encrypted -> " + sm4_get_hex(ciphertext); }
        return "sm4: encryption failed";
    }
    if str_starts_with(cmd, "sm4 decrypt ") {
        let data = str_sub(cmd, 12, len(cmd));
        let plaintext = sm4_decrypt_block(data);
        if plaintext != 0 { return "sm4: decrypted"; }
        return "sm4: decryption failed";
    }
    if cmd == "sm4 test" { return sm4_test(); }

    // === Curve25519 X25519 ECDH ===
    if str_starts_with(cmd, "curve25519 scalar ") {
        let key_str = substr(cmd, 18, len(cmd) - 18);
        let key_bytes = str_to_bytes(key_str);
        let result = curve25519_set_scalar(key_bytes);
        if result == 0 { return "curve25519: scalar set (" + to_string(len(key_bytes)) + " bytes)"; }
        return "curve25519: scalar too short (need 32 bytes)";
    }
    if cmd == "curve25519 pubkey" {
        curve25519_get_public();
        return "curve25519: public key computed -> " + substr(curve25519_get_public_hex(), 0, 16) + "...";
    }
    if str_starts_with(cmd, "curve25519 shared ") {
        let peer_str = substr(cmd, 18, len(cmd) - 18);
        let peer_bytes = str_to_bytes(peer_str);
        let result = curve25519_shared_secret(peer_bytes);
        if result == 0 { return "curve25519: shared secret computed -> " + substr(curve25519_get_shared_hex(), 0, 16) + "..."; }
        return "curve25519: peer public key too short";
    }
    if cmd == "curve25519 pubhex" { return "curve25519: " + curve25519_get_public_hex(); }
    if cmd == "curve25519 test" { return curve25519_test(); }

    // === AES-GCM AEAD ===
    if str_starts_with(cmd, "aesgcm key ") {
        let key_str = substr(cmd, 11, len(cmd) - 11);
        let key_bytes = str_to_bytes(key_str);
        let result = aes_gcm_set_key(key_bytes);
        if result == 0 { return "aesgcm: key set (16 bytes)"; }
        return "aesgcm: key too short (need 16 bytes)";
    }
    if str_starts_with(cmd, "aesgcm nonce ") {
        let nonce_str = substr(cmd, 13, len(cmd) - 13);
        let nonce_bytes = str_to_bytes(nonce_str);
        let result = aes_gcm_set_nonce(nonce_bytes);
        if result == 0 { return "aesgcm: nonce set (12 bytes)"; }
        return "aesgcm: nonce too short (need 12 bytes)";
    }
    if str_starts_with(cmd, "aesgcm aad ") {
        let aad_str = substr(cmd, 11, len(cmd) - 11);
        aes_gcm_set_aad(str_to_bytes(aad_str));
        return "aesgcm: AAD set (" + to_string(aes_gcm_aad_len) + " bytes)";
    }
    if str_starts_with(cmd, "aesgcm encrypt ") {
        let plain_str = substr(cmd, 15, len(cmd) - 15);
        let plain_bytes = str_to_bytes(plain_str);
        aes_gcm_encrypt(plain_bytes);
        return "aesgcm: encrypted -> ct=" + aes_gcm_get_ciphertext_hex() + " tag=" + substr(aes_gcm_get_tag(), 0, 8) + "...";
    }
    if cmd == "aesgcm tag" { return "aesgcm: tag=" + aes_gcm_get_tag(); }
    if cmd == "aesgcm test" { return aes_gcm_test(); }

    // === ChaCha20-Poly1305 AEAD ===
    if str_starts_with(cmd, "cp1305 key ") {
        let key_str = substr(cmd, 11, len(cmd) - 11);
        let key_bytes = str_to_bytes(key_str);
        let result = chacha20_poly1305_set_key(key_bytes);
        if result == 0 { return "cp1305: key set (32 bytes)"; }
        return "cp1305: key too short (need 32 bytes)";
    }
    if str_starts_with(cmd, "cp1305 nonce ") {
        let nonce_str = substr(cmd, 13, len(cmd) - 13);
        let nonce_bytes = str_to_bytes(nonce_str);
        let result = chacha20_poly1305_set_nonce(nonce_bytes);
        if result == 0 { return "cp1305: nonce set (12 bytes)"; }
        return "cp1305: nonce too short (need 12 bytes)";
    }
    if str_starts_with(cmd, "cp1305 encrypt ") {
        let plain_str = substr(cmd, 15, len(cmd) - 15);
        let plain_bytes = str_to_bytes(plain_str);
        chacha20_poly1305_encrypt(plain_bytes);
        return "cp1305: encrypted -> ct=" + chacha20_poly1305_get_ct_hex() + " tag=" + substr(chacha20_poly1305_get_tag(), 0, 8) + "...";
    }
    if cmd == "cp1305 tag" { return "cp1305: tag=" + chacha20_poly1305_get_tag(); }
    if cmd == "cp1305 test" { return chacha20_poly1305_test(); }

    // === X.509 Certificate Parser ===
    if str_starts_with(cmd, "x509 pem ") {
        let pem_str = substr(cmd, 9, len(cmd) - 9);
        let result = x509_parse_pem(pem_str);
        if result == 0 { return "x509: certificate parsed, count=" + to_string(x509_cert_count); }
        return "x509: parse failed (code=" + to_string(result) + ")";
    }
    if cmd == "x509 list" {
        let count = x509_list();
        return "x509: " + to_string(count) + " certificate(s) listed";
    }
    if str_starts_with(cmd, "x509 info ") {
        let idx = to_int(substr(cmd, 10, len(cmd) - 10));
        return x509_info(idx);
    }
    if str_starts_with(cmd, "x509 subject ") {
        let idx = to_int(substr(cmd, 13, len(cmd) - 13));
        return "x509: subject=" + x509_get_subject(idx);
    }
    if str_starts_with(cmd, "x509 issuer ") {
        let idx = to_int(substr(cmd, 12, len(cmd) - 12));
        return "x509: issuer=" + x509_get_issuer(idx);
    }
    if str_starts_with(cmd, "x509 key ") {
        let idx = to_int(substr(cmd, 9, len(cmd) - 9));
        return "x509: key=" + x509_get_key_info(idx);
    }
    if cmd == "x509 clear" { x509_clear(); return "x509: cleared"; }
    if cmd == "x509 test" { return x509_test(); }

    // === gRPC Protocol ===
    if str_starts_with(cmd, "grpc svc ") {
        let name = substr(cmd, 9, len(cmd) - 9);
        let idx = grpc_register_service(name);
        return "grpc: service registered [" + to_string(idx) + "] " + name;
    }
    if str_starts_with(cmd, "grpc method ") {
        let args = substr(cmd, 12, len(cmd) - 12);
        let sp = 0;
        let i = 0;
        while i < len(args) { if args[i] == 32 { sp = i; i = len(args); } i = i + 1; }
        let svc_idx = to_int(substr(args, 0, sp));
        let method  = substr(args, sp + 1, len(args) - sp - 1);
        let idx = grpc_register_method(svc_idx, method);
        return "grpc: method registered [" + to_string(idx) + "] " + method;
    }
    if str_starts_with(cmd, "grpc call ") {
        let path = substr(cmd, 10, len(cmd) - 10);
        let status = grpc_call(path);
        return "grpc: call " + path + " -> " + grpc_status_to_string(status);
    }
    if cmd == "grpc list" { grpc_list_services(); return ""; }
    if cmd == "grpc status" { return grpc_status(); }
    if str_starts_with(cmd, "grpc meta ") {
        let args = substr(cmd, 10, len(cmd) - 10);
        let sp = 0;
        let i = 0;
        while i < len(args) { if args[i] == 32 { sp = i; i = len(args); } i = i + 1; }
        let key = substr(args, 0, sp);
        let val = substr(args, sp + 1, len(args) - sp - 1);
        grpc_set_metadata(key, val);
        return "grpc: metadata set " + key + "=" + val;
    }
    if cmd == "grpc test" { return grpc_test(); }

    // === PNG Image Decoder ===
    if str_starts_with(cmd, "png load ") {
        let path = substr(cmd, 9, len(cmd) - 9);
        let data = vfs_read_file(path);
        if len(data) == 0 { return "png: file not found: " + path; }
        let result = png_decode(data);
        if result == 0 { return "png: loaded " + png_info(); }
        return "png: decode failed (code=" + to_string(result) + ")";
    }
    if cmd == "png info" { return png_info(); }
    if str_starts_with(cmd, "png pixel ") {
        let args = substr(cmd, 10, len(cmd) - 10);
        let sp = 0;
        let i = 0;
        while i < len(args) { if args[i] == 32 { sp = i; i = len(args); } i = i + 1; }
        let x = to_int(substr(args, 0, sp));
        let y = to_int(substr(args, sp + 1, len(args) - sp - 1));
        let px = png_get_pixel(x, y);
        return "png: pixel(" + to_string(x) + "," + to_string(y) + ")=RGBA("
            + to_string(px[0]) + "," + to_string(px[1]) + ","
            + to_string(px[2]) + "," + to_string(px[3]) + ")";
    }
    if cmd == "png show" { png_show_ascii(40, 20); return ""; }
    if cmd == "png test" { return png_test(); }

    // === HTTP/2 Protocol ===
    if cmd == "h2 connect" {
        http2_init();
        return "h2: connection initialized, preface=" + H2_PREFACE;
    }
    if str_starts_with(cmd, "h2 get ") {
        let path = substr(cmd, 7, len(cmd) - 7);
        let sid = h2_alloc_stream();
        h2_build_request("GET", path, "https", "localhost", sid);
        return "h2: GET " + path + " stream=" + to_string(sid);
    }
    if str_starts_with(cmd, "h2 post ") {
        let args = substr(cmd, 8, len(cmd) - 8);
        let sp = 0;
        let i = 0;
        while i < len(args) { if args[i] == 32 { sp = i; i = len(args); } i = i + 1; }
        let path = substr(args, 0, sp);
        let sid = h2_alloc_stream();
        h2_build_request("POST", path, "https", "localhost", sid);
        return "h2: POST " + path + " stream=" + to_string(sid);
    }
    if cmd == "h2 status" { return h2_status(); }
    if str_starts_with(cmd, "h2 stream ") {
        let sid = to_int(substr(cmd, 10, len(cmd) - 10));
        return h2_stream_info(sid);
    }
    if cmd == "h2 ping" {
        h2_build_ping([0,1,2,3,4,5,6,7], 0);
        return "h2: PING frame built (8-byte opaque)";
    }
    if cmd == "h2 goaway" {
        h2_build_goaway(h2_last_stream_id, H2_ERR_NO_ERROR);
        return "h2: GOAWAY frame built last_stream=" + to_string(h2_last_stream_id);
    }
    if cmd == "h2 settings" {
        h2_build_settings(0);
        return "h2: SETTINGS frame built (6 params)";
    }
    if cmd == "h2 test" { return http2_test(); }

    // === JPEG Image Decoder ===
    if str_starts_with(cmd, "jpeg load ") {
        let path = substr(cmd, 10, len(cmd) - 10);
        let data = vfs_read_file(path);
        if len(data) == 0 { return "jpeg: file not found: " + path; }
        let result = jpeg_decode(data);
        if result == 0 { return "jpeg: loaded " + jpeg_info(); }
        return "jpeg: decode failed (code=" + to_string(result) + ")";
    }
    if cmd == "jpeg info" { return jpeg_info(); }
    if str_starts_with(cmd, "jpeg pixel ") {
        let args = substr(cmd, 11, len(cmd) - 11);
        let sp = 0;
        let i = 0;
        while i < len(args) { if args[i] == 32 { sp = i; i = len(args); } i = i + 1; }
        let x = to_int(substr(args, 0, sp));
        let y = to_int(substr(args, sp + 1, len(args) - sp - 1));
        let px = jpeg_get_pixel(x, y);
        return "jpeg: pixel(" + to_string(x) + "," + to_string(y) + ")=RGB("
            + to_string(px[0]) + "," + to_string(px[1]) + "," + to_string(px[2]) + ")";
    }
    if cmd == "jpeg idct" {
        let val = jpeg_idct_test();
        return "jpeg: IDCT(DC=128) => " + to_string(val);
    }
    if cmd == "jpeg test" { return jpeg_test(); }

    // === Raft Consensus ===
    if str_starts_with(cmd, "raft init ") {
        let args = substr(cmd, 10, len(cmd) - 10);
        let sp = 0;
        let i = 0;
        while i < len(args) { if args[i] == 32 { sp = i; i = len(args); } i = i + 1; }
        let nid  = to_int(substr(args, 0, sp));
        let size = to_int(substr(args, sp + 1, len(args) - sp - 1));
        raft_init(nid, size);
        return "raft: initialized node=" + to_string(nid) + " cluster_size=" + to_string(size);
    }
    if str_starts_with(cmd, "raft peer ") {
        let pid = to_int(substr(cmd, 10, len(cmd) - 10));
        let idx = raft_add_peer(pid);
        return "raft: peer " + to_string(pid) + " added at slot " + to_string(idx);
    }
    if str_starts_with(cmd, "raft propose ") {
        let command = substr(cmd, 13, len(cmd) - 13);
        let idx = raft_propose(command);
        if idx < 0 { return "raft: not leader, cannot propose"; }
        return "raft: proposed at log index " + to_string(idx);
    }
    if str_starts_with(cmd, "raft tick ") {
        let ms = to_int(substr(cmd, 10, len(cmd) - 10));
        raft_tick(ms);
        return "raft: ticked " + to_string(ms) + "ms -> " + raft_status();
    }
    if cmd == "raft status" { return raft_status(); }
    if cmd == "raft test" { return raft_test(); }

    // --- Gossip (SWIM membership protocol) ---
    if str_starts_with(cmd, "gossip init ") {
        let rest = str_slice(cmd, 12, len(cmd));
        let parts = str_split(rest, " ");
        let nid = to_int(parts[0]);
        let addr = parts[1];
        gossip_init(nid, addr);
        return "gossip: initialized node=" + to_string(nid) + " addr=" + addr;
    }
    if str_starts_with(cmd, "gossip join ") {
        let rest = str_slice(cmd, 12, len(cmd));
        let parts = str_split(rest, " ");
        let sid = to_int(parts[0]);
        let saddr = parts[1];
        gossip_join(sid, saddr);
        return "gossip: joined via seed node " + to_string(sid) + " at " + saddr;
    }
    if str_starts_with(cmd, "gossip tick ") {
        let ms2 = to_int(str_slice(cmd, 12, len(cmd)));
        gossip_tick(ms2);
        return "gossip: ticked " + to_string(ms2) + "ms -> " + gossip_status();
    }
    if cmd == "gossip members" { gossip_list_members(); return gossip_status(); }
    if cmd == "gossip status" { return gossip_status(); }
    if cmd == "gossip test" { return gossip_test(); }

    // --- Matrix (BLAS-like matrix operations) ---
    if str_starts_with(cmd, "mat new ") {
        let rest2 = str_slice(cmd, 8, len(cmd));
        let parts2 = str_split(rest2, " ");
        let rows = to_int(parts2[0]);
        let cols = to_int(parts2[1]);
        let m = mat_alloc(rows, cols);
        return "matrix: allocated slot " + to_string(m) + " [" + to_string(rows) + "x" + to_string(cols) + "]";
    }
    if str_starts_with(cmd, "mat identity ") {
        let n2 = to_int(str_slice(cmd, 13, len(cmd)));
        let mi = mat_identity(n2);
        return mat_info(mi);
    }
    if str_starts_with(cmd, "mat mul ") {
        let rest3 = str_slice(cmd, 8, len(cmd));
        let parts3 = str_split(rest3, " ");
        let ma = to_int(parts3[0]);
        let mb = to_int(parts3[1]);
        let mc = mat_mul(ma, mb);
        if mc < 0 { return "matrix: mul failed (dimension mismatch)"; }
        return mat_info(mc);
    }
    if str_starts_with(cmd, "mat inv ") {
        let mi2 = to_int(str_slice(cmd, 8, len(cmd)));
        let inv = mat_inverse(mi2);
        if inv < 0 { return "matrix: singular (no inverse)"; }
        return mat_info(inv);
    }
    if str_starts_with(cmd, "mat norm ") {
        let mn = to_int(str_slice(cmd, 9, len(cmd)));
        return "matrix: frob_norm=" + to_string(mat_norm_frob(mn) / MATRIX_SCALE);
    }
    if str_starts_with(cmd, "mat info ") {
        let mi3 = to_int(str_slice(cmd, 9, len(cmd)));
        return mat_info(mi3);
    }
    if cmd == "mat test" { return matrix_test(); }

    // --- Neural (MLP inference engine) ---
    if str_starts_with(cmd, "nn layer ") {
        let rest4 = str_slice(cmd, 9, len(cmd));
        let parts4 = str_split(rest4, " ");
        let lsz = to_int(parts4[0]);
        let act = to_int(parts4[1]);
        let res = nn_add_layer(lsz, act);
        if res != 0 { return "neural: layer add failed (limit reached)"; }
        return "neural: added layer size=" + to_string(lsz) + " act=" + to_string(act) + " -> " + nn_info();
    }
    if cmd == "nn init" { neural_init(); return "neural: initialized -> " + nn_info(); }
    if cmd == "nn info" { return nn_info(); }
    if cmd == "nn test" { return neural_test(); }

    // --- Attention (Transformer self-attention) ---
    if str_starts_with(cmd, "attn config ") {
        let rest5 = str_slice(cmd, 12, len(cmd));
        let parts5 = str_split(rest5, " ");
        let dm2 = to_int(parts5[0]);
        let nh = to_int(parts5[1]);
        let dff = to_int(parts5[2]);
        attn_config(dm2, nh, dff);
        return "attention: configured -> " + attn_info();
    }
    if cmd == "attn info" { return attn_info(); }
    if cmd == "attn test" { return attention_test(); }

    // --- Bloom Filter ---
    if str_starts_with(cmd, "bloom add ") {
        let bitem = str_slice(cmd, 10, len(cmd));
        bloom_add(bitem);
        return "bloom: added '" + bitem + "' -> " + bloom_status();
    }
    if str_starts_with(cmd, "bloom query ") {
        let qitem = str_slice(cmd, 12, len(cmd));
        let qres = bloom_query(qitem);
        return "bloom: query '" + qitem + "' -> " + to_string(qres) + " (1=probably present, 0=absent)";
    }
    if str_starts_with(cmd, "bloom delete ") {
        let ditem = str_slice(cmd, 13, len(cmd));
        bloom_delete(ditem);
        return "bloom: deleted '" + ditem + "' -> " + bloom_status();
    }
    if cmd == "bloom status" { return bloom_status(); }
    if cmd == "bloom test" { return bloom_test(); }

    // --- CRDT ---
    if cmd == "crdt gc inc"  { gc_increment(); return gc_status(); }
    if cmd == "crdt pn inc"  { pn_increment(); return pn_status(); }
    if cmd == "crdt pn dec"  { pn_decrement(); return pn_status(); }
    if str_starts_with(cmd, "crdt gset add ") {
        let ge = to_int(str_slice(cmd, 14, len(cmd)));
        gset_add(ge);
        return gset_status();
    }
    if str_starts_with(cmd, "crdt lww add ") {
        let le = to_int(str_slice(cmd, 13, len(cmd)));
        lww_add(le);
        return lww_status();
    }
    if str_starts_with(cmd, "crdt orset add ") {
        let oe = to_int(str_slice(cmd, 15, len(cmd)));
        orset_add(oe);
        return orset_status();
    }
    if cmd == "crdt status" { return crdt_info(); }
    if cmd == "crdt test"   { return crdt_test(); }

    // --- SkipList ---
    if str_starts_with(cmd, "skip insert ") {
        let rsk = str_slice(cmd, 12, len(cmd));
        let psk = str_split(rsk, " ");
        let sk = to_int(psk[0]); let sv = to_int(psk[1]);
        skip_insert(sk, sv);
        return "skiplist: inserted " + to_string(sk) + "→" + to_string(sv) + " " + skiplist_status();
    }
    if str_starts_with(cmd, "skip get ") {
        let gk = to_int(str_slice(cmd, 9, len(cmd)));
        return "skiplist: get(" + to_string(gk) + ")=" + to_string(skip_get(gk));
    }
    if str_starts_with(cmd, "skip delete ") {
        let dk2 = to_int(str_slice(cmd, 12, len(cmd)));
        skip_delete(dk2);
        return "skiplist: deleted " + to_string(dk2) + " " + skiplist_status();
    }
    if str_starts_with(cmd, "skip range ") {
        let rr = str_slice(cmd, 11, len(cmd));
        let pr = str_split(rr, " ");
        let lo = to_int(pr[0]); let hi = to_int(pr[1]);
        let rc = skip_range(lo, hi);
        return "skiplist: range[" + to_string(lo) + "," + to_string(hi) + "]=" + to_string(rc) + " entries";
    }
    if cmd == "skip status" { return skiplist_status(); }
    if cmd == "skip test"   { return skiplist_test(); }

    // --- HyperLogLog ---
    if str_starts_with(cmd, "hll add_int ") {
        let hn = to_int(str_slice(cmd, 12, len(cmd)));
        hll_add_int(hn);
        return "hll: added int " + to_string(hn) + " estimate=" + to_string(hll_estimate());
    }
    if str_starts_with(cmd, "hll add ") {
        let hs = str_slice(cmd, 8, len(cmd));
        hll_add_str(hs);
        return "hll: added '" + hs + "' estimate=" + to_string(hll_estimate());
    }
    if cmd == "hll estimate" { return "hll: estimate=" + to_string(hll_estimate()); }
    if cmd == "hll status"   { return hll_status(); }
    if cmd == "hll test"     { return hyperloglog_test(); }

    // --- Consistent Hash ---
    if str_starts_with(cmd, "chash add ") {
        let cra = str_slice(cmd, 10, len(cmd));
        let cpa = str_split(cra, " ");
        let cnid = to_int(cpa[0]); let caddr = cpa[1];
        let cidx = chash_add_node(cnid, caddr);
        return "chash: added node " + to_string(cnid) + " at " + caddr + " idx=" + to_string(cidx) + " " + chash_status();
    }
    if str_starts_with(cmd, "chash remove ") {
        let crid = to_int(str_slice(cmd, 13, len(cmd)));
        chash_remove_node(crid);
        return "chash: removed node " + to_string(crid) + " " + chash_status();
    }
    if str_starts_with(cmd, "chash get ") {
        let cgk = str_slice(cmd, 10, len(cmd));
        let cgn = chash_get_node_str(cgk);
        return "chash: '" + cgk + "' → node_idx=" + to_string(cgn);
    }
    if str_starts_with(cmd, "chash replicas ") {
        let crx = str_slice(cmd, 15, len(cmd));
        let cpx = str_split(crx, " ");
        let crkey = cpx[0]; let crn = to_int(cpx[1]);
        let crcount = chash_get_replicas(crkey, crn);
        return "chash: replicas(" + crkey + "," + to_string(crn) + ")=" + to_string(crcount);
    }
    if cmd == "chash status" { return chash_status(); }
    if cmd == "chash test"   { return consistent_hash_test(); }

    // --- Count-Min Sketch ---
    if str_starts_with(cmd, "cms add ") {
        let cms_r = str_slice(cmd, 8, len(cmd));
        let cms_p = str_split(cms_r, " ");
        let cms_k2 = to_int(cms_p[0]); let cms_n = to_int(cms_p[1]);
        cms_add_int(cms_k2, cms_n);
        return "cms: add(" + to_string(cms_k2) + "," + to_string(cms_n) + ") -> " + cms_status();
    }
    if str_starts_with(cmd, "cms query ") {
        let cms_qk = to_int(str_slice(cmd, 10, len(cmd)));
        return "cms: query(" + to_string(cms_qk) + ")=" + to_string(cms_query_int(cms_qk));
    }
    if str_starts_with(cmd, "cms add_str ") {
        let cms_sr = str_slice(cmd, 12, len(cmd));
        let cms_sp = str_split(cms_sr, " ");
        let cms_sn = to_int(cms_sp[1]);
        cms_add_str(cms_sp[0], cms_sn);
        return "cms: add_str('" + cms_sp[0] + "'," + to_string(cms_sn) + ") -> " + cms_status();
    }
    if str_starts_with(cmd, "cms query_str ") {
        let cms_qs = str_slice(cmd, 14, len(cmd));
        return "cms: query_str('" + cms_qs + "')=" + to_string(cms_query_str(cms_qs));
    }
    if cmd == "cms status" { return cms_status(); }
    if cmd == "cms test"   { return count_min_sketch_test(); }

    // --- LRU Cache ---
    if str_starts_with(cmd, "lru get ") {
        let lk = to_int(str_slice(cmd, 8, len(cmd)));
        return "lru: get(" + to_string(lk) + ")=" + to_string(lru_get(lk)) + " " + lru_status();
    }
    if str_starts_with(cmd, "lru put ") {
        let lpr = str_slice(cmd, 8, len(cmd));
        let lpp = str_split(lpr, " ");
        let lpk = to_int(lpp[0]); let lpv = to_int(lpp[1]);
        lru_put(lpk, lpv);
        return "lru: put(" + to_string(lpk) + "," + to_string(lpv) + ") -> " + lru_status();
    }
    if str_starts_with(cmd, "lru peek ") {
        let lpk2 = to_int(str_slice(cmd, 9, len(cmd)));
        return "lru: peek(" + to_string(lpk2) + ")=" + to_string(lru_peek(lpk2));
    }
    if str_starts_with(cmd, "lru del ") {
        let ldk = to_int(str_slice(cmd, 8, len(cmd)));
        lru_invalidate(ldk);
        return "lru: deleted " + to_string(ldk) + " -> " + lru_status();
    }
    if cmd == "lru status" { return lru_status(); }
    if cmd == "lru test"   { return lru_cache_test(); }

    // --- Merkle Tree ---
    if cmd == "merkle root" { return "merkle: root=" + to_string(merkle_get_root()); }
    if str_starts_with(cmd, "merkle proof ") {
        let mpl = to_int(str_slice(cmd, 13, len(cmd)));
        let mpr = merkle_get_proof(mpl);
        return "merkle: proof(leaf=" + to_string(mpl) + ") depth=" + to_string(mpr[1]);
    }
    if str_starts_with(cmd, "merkle update ") {
        let mur = str_slice(cmd, 14, len(cmd));
        let mup = str_split(mur, " ");
        let mul = to_int(mup[0]); let muv = to_int(mup[1]);
        merkle_update_leaf(mul, muv);
        return "merkle: updated leaf " + to_string(mul) + " root=" + to_string(merkle_get_root());
    }
    if cmd == "merkle status" { return merkle_status(); }
    if cmd == "merkle test"   { return merkle_tree_test(); }

    // --- t-Digest ---
    if str_starts_with(cmd, "td add ") {
        let tdv = to_int(str_slice(cmd, 7, len(cmd)));
        tdigest_add(tdv * 1000);
        return "tdigest: added " + to_string(tdv) + " -> " + tdigest_status();
    }
    if cmd == "td p50"    { return "tdigest: p50=" + to_string(tdigest_quantile(500) / 1000); }
    if cmd == "td p90"    { return "tdigest: p90=" + to_string(tdigest_quantile(900) / 1000); }
    if cmd == "td p99"    { return "tdigest: p99=" + to_string(tdigest_quantile(990) / 1000); }
    if str_starts_with(cmd, "td quantile ") {
        let tdq = to_int(str_slice(cmd, 12, len(cmd)));
        return "tdigest: quantile(" + to_string(tdq) + ")=" + to_string(tdigest_quantile(tdq) / 1000);
    }
    if cmd == "td status" { return tdigest_status(); }
    if cmd == "td test"   { return tdigest_test(); }

    // --- Wavelet ---
    if str_starts_with(cmd, "wv load ") {
        let wvn = to_int(str_slice(cmd, 8, len(cmd)));
        wavelet_init();
        let wvd = [1000, 2000, 3000, 4000, -4000, -3000, -2000, -1000];
        wavelet_load(wvd, wvn);
        return "wavelet: loaded " + to_string(wvn) + " samples -> " + wavelet_info();
    }
    if str_starts_with(cmd, "wv forward ") {
        let wvl = to_int(str_slice(cmd, 11, len(cmd)));
        wavelet_forward(wvl);
        return "wavelet: forward DWT levels=" + to_string(wvl) + " -> " + wavelet_info();
    }
    if str_starts_with(cmd, "wv inverse ") {
        let wvil = to_int(str_slice(cmd, 11, len(cmd)));
        wavelet_inverse(wvil);
        return "wavelet: inverse DWT levels=" + to_string(wvil) + " -> " + wavelet_info();
    }
    if str_starts_with(cmd, "wv threshold ") {
        let wvt = to_int(str_slice(cmd, 13, len(cmd)));
        let wzero = wavelet_threshold(wvt);
        return "wavelet: threshold=" + to_string(wvt) + " zeroed=" + to_string(wzero) + " -> " + wavelet_info();
    }
    if cmd == "wv info"   { return wavelet_info(); }
    if cmd == "wv test"   { return wavelet_test(); }

    // --- Reservoir Sampling ---
    if str_starts_with(cmd, "rs add ") {
        let rsi = to_int(str_slice(cmd, 7, len(cmd)));
        let rsr = rs_add(rsi);
        return "reservoir: add(" + to_string(rsi) + ")=" + to_string(rsr) + " " + rs_status();
    }
    if str_starts_with(cmd, "rs add_batch ") {
        let rsbn = to_int(str_slice(cmd, 13, len(cmd)));
        let rsbv = 1;
        while rsbv <= rsbn { rs_add(rsbv); rsbv = rsbv + 1; }
        return "reservoir: batch added 1.." + to_string(rsbn) + " -> " + rs_status();
    }
    if str_starts_with(cmd, "rs contains ") {
        let rscx = to_int(str_slice(cmd, 12, len(cmd)));
        return "reservoir: contains(" + to_string(rscx) + ")=" + to_string(rs_contains(rscx));
    }
    if str_starts_with(cmd, "rs bern_init ") {
        let rsbp = to_int(str_slice(cmd, 13, len(cmd)));
        rs_bern_init(rsbp);
        return "reservoir: bernoulli p=" + to_string(rsbp) + "/1000 initialized";
    }
    if str_starts_with(cmd, "rs bern_add ") {
        let rsba = to_int(str_slice(cmd, 12, len(cmd)));
        let rsbr = rs_bern_add(rsba);
        return "reservoir: bern_add(" + to_string(rsba) + ")=" + to_string(rsbr) + " " + rs_status();
    }
    if cmd == "rs status" { return rs_status(); }
    if cmd == "rs test"   { return reservoir_sampling_test(); }

    // --- Fenwick Tree ---
    if str_starts_with(cmd, "fw build ") {
        let fwn = to_int(str_slice(cmd, 9, len(cmd)));
        fenwick_init(fwn);
        let fwd = [1, 2, 3, 4, 5, 6, 7, 8];
        fenwick_build(fwd, fwn);
        return "fenwick: built n=" + to_string(fwn) + " -> " + fenwick_status();
    }
    if str_starts_with(cmd, "fw update ") {
        let fwr = str_slice(cmd, 10, len(cmd));
        let fwp = str_split(fwr, " ");
        let fwi = to_int(fwp[0]); let fwd2 = to_int(fwp[1]);
        fenwick_update(fwi, fwd2);
        return "fenwick: update(" + to_string(fwi) + "," + to_string(fwd2) + ") -> " + fenwick_status();
    }
    if str_starts_with(cmd, "fw query ") {
        let fwqi = to_int(str_slice(cmd, 9, len(cmd)));
        return "fenwick: prefix_sum(1.." + to_string(fwqi) + ")=" + to_string(fenwick_query(fwqi));
    }
    if str_starts_with(cmd, "fw range ") {
        let fwrr = str_slice(cmd, 9, len(cmd));
        let fwrp = str_split(fwrr, " ");
        let fwrl = to_int(fwrp[0]); let fwrR = to_int(fwrp[1]);
        return "fenwick: range_sum(" + to_string(fwrl) + ".." + to_string(fwrR) + ")=" + to_string(fenwick_range_sum(fwrl, fwrR));
    }
    if str_starts_with(cmd, "fw kth ") {
        let fwk = to_int(str_slice(cmd, 7, len(cmd)));
        return "fenwick: kth(" + to_string(fwk) + ")=" + to_string(fenwick_find_kth(fwk));
    }
    if str_starts_with(cmd, "fw range_update ") {
        let fwur = str_slice(cmd, 16, len(cmd));
        let fwup = str_split(fwur, " ");
        let fwul = to_int(fwup[0]); let fwuR = to_int(fwup[1]); let fwud = to_int(fwup[2]);
        fenwick_range_update(fwul, fwuR, fwud);
        return "fenwick: range_update(" + to_string(fwul) + ".." + to_string(fwuR) + ",+" + to_string(fwud) + ")";
    }
    if str_starts_with(cmd, "fw point_query ") {
        let fwpqi = to_int(str_slice(cmd, 15, len(cmd)));
        return "fenwick: point_query(" + to_string(fwpqi) + ")=" + to_string(fenwick_point_query(fwpqi));
    }
    if str_starts_with(cmd, "fw 2d_update ") {
        let fw2ur = str_slice(cmd, 13, len(cmd));
        let fw2up = str_split(fw2ur, " ");
        let fw2r = to_int(fw2up[0]); let fw2c = to_int(fw2up[1]); let fw2d = to_int(fw2up[2]);
        fenwick_2d_update(fw2r, fw2c, fw2d);
        return "fenwick: 2d_update(" + to_string(fw2r) + "," + to_string(fw2c) + ",+" + to_string(fw2d) + ")";
    }
    if str_starts_with(cmd, "fw 2d_query ") {
        let fw2qr = str_slice(cmd, 12, len(cmd));
        let fw2qp = str_split(fw2qr, " ");
        let fw2qR = to_int(fw2qp[0]); let fw2qC = to_int(fw2qp[1]);
        return "fenwick: 2d_query(1.." + to_string(fw2qR) + ",1.." + to_string(fw2qC) + ")=" + to_string(fenwick_2d_query(fw2qR, fw2qC));
    }
    if cmd == "fw status" { return fenwick_status(); }
    if cmd == "fw test"   { return fenwick_tree_test(); }

    // --- Segment Tree ---
    if str_starts_with(cmd, "seg build ") {
        let sgn = to_int(str_slice(cmd, 10, len(cmd)));
        let sgd = [3, 1, 4, 1, 5, 9, 2, 6];
        seg_build(sgd, sgn);
        return "segtree: built n=" + to_string(sgn) + " -> " + seg_status();
    }
    if str_starts_with(cmd, "seg update ") {
        let sgur = str_slice(cmd, 11, len(cmd));
        let sgup = str_split(sgur, " ");
        let sgui = to_int(sgup[0]); let sguv = to_int(sgup[1]);
        seg_update_point(sgui, sguv);
        return "segtree: update(" + to_string(sgui) + "=" + to_string(sguv) + ") -> " + seg_status();
    }
    if str_starts_with(cmd, "seg range_add ") {
        let sgar = str_slice(cmd, 14, len(cmd));
        let sgap = str_split(sgar, " ");
        let sgal = to_int(sgap[0]); let sgaR = to_int(sgap[1]); let sgad = to_int(sgap[2]);
        seg_range_add(sgal, sgaR, sgad);
        return "segtree: range_add(" + to_string(sgal) + ".." + to_string(sgaR) + ",+" + to_string(sgad) + ") -> " + seg_status();
    }
    if str_starts_with(cmd, "seg sum ") {
        let sgsr = str_slice(cmd, 8, len(cmd));
        let sgsp = str_split(sgsr, " ");
        let sgsl = to_int(sgsp[0]); let sgsR = to_int(sgsp[1]);
        return "segtree: sum(" + to_string(sgsl) + ".." + to_string(sgsR) + ")=" + to_string(seg_query_sum(sgsl, sgsR));
    }
    if str_starts_with(cmd, "seg min ") {
        let sgmr = str_slice(cmd, 8, len(cmd));
        let sgmp = str_split(sgmr, " ");
        let sgml = to_int(sgmp[0]); let sgmR = to_int(sgmp[1]);
        return "segtree: min(" + to_string(sgml) + ".." + to_string(sgmR) + ")=" + to_string(seg_query_min(sgml, sgmR));
    }
    if str_starts_with(cmd, "seg max ") {
        let sgxr = str_slice(cmd, 8, len(cmd));
        let sgxp = str_split(sgxr, " ");
        let sgxl = to_int(sgxp[0]); let sgxR = to_int(sgxp[1]);
        return "segtree: max(" + to_string(sgxl) + ".." + to_string(sgxR) + ")=" + to_string(seg_query_max(sgxl, sgxR));
    }
    if cmd == "seg status" { return seg_status(); }
    if cmd == "seg test"   { return segment_tree_test(); }

    // --- Cuckoo Filter ---
    if str_starts_with(cmd, "cf insert ") {
        let cfi = to_int(str_slice(cmd, 10, len(cmd)));
        let cfr = cf_insert(cfi);
        return "cuckoo: insert(" + to_string(cfi) + ")=" + to_string(cfr) + " " + cf_status();
    }
    if str_starts_with(cmd, "cf contains ") {
        let cfc = to_int(str_slice(cmd, 12, len(cmd)));
        return "cuckoo: contains(" + to_string(cfc) + ")=" + to_string(cf_contains(cfc));
    }
    if str_starts_with(cmd, "cf delete ") {
        let cfd = to_int(str_slice(cmd, 10, len(cmd)));
        let cfdr = cf_delete(cfd);
        return "cuckoo: delete(" + to_string(cfd) + ")=" + to_string(cfdr) + " " + cf_status();
    }
    if cmd == "cf status" { return cf_status(); }
    if cmd == "cf test"   { return cuckoo_filter_test(); }

    // --- Disjoint Set Union ---
    if str_starts_with(cmd, "dsu union ") {
        let dur = str_slice(cmd, 10, len(cmd));
        let dup = str_split(dur, " ");
        let dux = to_int(dup[0]); let duy = to_int(dup[1]);
        let dmr = dsu_union(dux, duy);
        return "dsu: union(" + to_string(dux) + "," + to_string(duy) + ")=" + to_string(dmr) + " " + dsu_status();
    }
    if str_starts_with(cmd, "dsu find ") {
        let dfx = to_int(str_slice(cmd, 9, len(cmd)));
        return "dsu: find(" + to_string(dfx) + ")=" + to_string(dsu_find(dfx));
    }
    if str_starts_with(cmd, "dsu connected ") {
        let dcr = str_slice(cmd, 14, len(cmd));
        let dcp = str_split(dcr, " ");
        let dcx = to_int(dcp[0]); let dcy = to_int(dcp[1]);
        return "dsu: connected(" + to_string(dcx) + "," + to_string(dcy) + ")=" + to_string(dsu_connected(dcx, dcy));
    }
    if str_starts_with(cmd, "dsu size ") {
        let dsx = to_int(str_slice(cmd, 9, len(cmd)));
        return "dsu: size(" + to_string(dsx) + ")=" + to_string(dsu_component_size(dsx));
    }
    if cmd == "dsu status" { return dsu_status(); }
    if cmd == "dsu test"   { return disjoint_set_test(); }

    // --- Treap ---
    if str_starts_with(cmd, "treap insert ") {
        let tir = str_slice(cmd, 13, len(cmd));
        let tip = str_split(tir, " ");
        let tik = to_int(tip[0]); let tiv = to_int(tip[1]);
        treap_insert(tik, tiv);
        return "treap: insert(" + to_string(tik) + "," + to_string(tiv) + ") -> " + treap_status();
    }
    if str_starts_with(cmd, "treap delete ") {
        let tdk = to_int(str_slice(cmd, 13, len(cmd)));
        treap_delete(tdk);
        return "treap: deleted " + to_string(tdk) + " -> " + treap_status();
    }
    if str_starts_with(cmd, "treap search ") {
        let tsk = to_int(str_slice(cmd, 13, len(cmd)));
        return "treap: search(" + to_string(tsk) + ")=" + to_string(treap_search(tsk));
    }
    if str_starts_with(cmd, "treap kth ") {
        let tkk = to_int(str_slice(cmd, 10, len(cmd)));
        return "treap: kth(" + to_string(tkk) + ")=" + to_string(treap_kth(tkk));
    }
    if str_starts_with(cmd, "treap rank ") {
        let trk = to_int(str_slice(cmd, 11, len(cmd)));
        return "treap: rank(" + to_string(trk) + ")=" + to_string(treap_rank(trk));
    }
    if cmd == "treap min"    { return "treap: min=" + to_string(treap_min()); }
    if cmd == "treap max"    { return "treap: max=" + to_string(treap_max()); }
    if cmd == "treap status" { return treap_status(); }
    if cmd == "treap test"   { return treap_test(); }

    // --- Suffix Array ---
    if str_starts_with(cmd, "sa build ") {
        let sabn = to_int(str_slice(cmd, 9, len(cmd)));
        let sabd = [98, 97, 110, 97, 110, 97];
        let sabn2 = sabn; if sabn2 > 6 { sabn2 = 6; }
        sa_load(sabd, sabn2);
        sa_build();
        return "sa: built n=" + to_string(sabn2) + " -> " + sa_status();
    }
    if cmd == "sa lcp" {
        sa_build_lcp();
        return "sa: lcp built lrs=" + to_string(sa_lrs());
    }
    if cmd == "sa lrs"      { return "sa: lrs=" + to_string(sa_lrs()); }
    if cmd == "sa distinct" { return "sa: distinct_substrings=" + to_string(sa_distinct_substrings()); }
    if cmd == "sa status"   { return sa_status(); }
    if cmd == "sa test"     { return suffix_array_test(); }

    // === Aho-Corasick ===
    if cmd == "ac init"   { ac_init(); return "ac: automaton cleared"; }
    if cmd == "ac build"  { ac_build(); return "ac: DFA built nodes=" + to_string(ac_size); }
    if cmd == "ac status" { return "ac: nodes=" + to_string(ac_size) + " patterns=" + to_string(ac_np) + " last_matches=" + to_string(ac_match_cnt); }
    if cmd == "ac test"   { return "ac: matches=" + to_string(ac_test()); }

    // === KMP ===
    if cmd == "kmp test"  { let kr = kmp_test(); return "kmp: ok kmp/z/rk=" + to_string(kr); }

    // === Interval Tree ===
    if cmd == "it init"   { interval_tree_init(); return "it: cleared"; }
    if cmd == "it status" { return "it: n=" + to_string(it_n) + " last_res=" + to_string(it_res_cnt); }
    if cmd == "it test"   { let ir = it_test(); return "it: stab=" + to_string(ir); }

    if _starts_with(cmd, "it insert ") {
        let itargs = str_sub(cmd, 10, len(cmd));
        let itsp = _find_space(itargs);
        if itsp < 0 { return "it insert: usage it insert <lo> <hi>"; }
        let itlo = to_int(str_sub(itargs, 0, itsp));
        let ithi = to_int(str_sub(itargs, itsp + 1, len(itargs)));
        let itid = it_insert(itlo, ithi);
        return "it: inserted [" + to_string(itlo) + "," + to_string(ithi) + "] id=" + to_string(itid) + " n=" + to_string(it_n);
    }
    if _starts_with(cmd, "it stab ") {
        let itq = to_int(str_sub(cmd, 8, len(cmd)));
        let itcnt = it_stab(itq);
        return "it: stab(" + to_string(itq) + ")=" + to_string(itcnt);
    }
    if _starts_with(cmd, "it overlap ") {
        let itov = str_sub(cmd, 11, len(cmd));
        let itosp = _find_space(itov);
        if itosp < 0 { return "it overlap: usage it overlap <lo> <hi>"; }
        let itolo = to_int(str_sub(itov, 0, itosp));
        let itohi = to_int(str_sub(itov, itosp + 1, len(itov)));
        let itoct = it_overlap(itolo, itohi);
        return "it: overlap([" + to_string(itolo) + "," + to_string(itohi) + "])=" + to_string(itoct);
    }

    // === Sparse Table ===
    if cmd == "st status" { return "st: n=" + to_string(st_n) + " levels=" + to_string(ST_LOG); }
    if cmd == "st test"   { let sr = st_test(); return "st: min(0,9)=" + to_string(sr); }
    if _starts_with(cmd, "st min ") {
        let stargs = str_sub(cmd, 7, len(cmd));
        let stsp = _find_space(stargs);
        if stsp < 0 { return "st min: usage st min <l> <r>"; }
        let stl = to_int(str_sub(stargs, 0, stsp));
        let str2 = to_int(str_sub(stargs, stsp + 1, len(stargs)));
        return "st: min(" + to_string(stl) + "," + to_string(str2) + ")=" + to_string(st_rmq_min(stl, str2));
    }
    if _starts_with(cmd, "st max ") {
        let stmargs = str_sub(cmd, 7, len(cmd));
        let stmsp = _find_space(stmargs);
        if stmsp < 0 { return "st max: usage st max <l> <r>"; }
        let stml = to_int(str_sub(stmargs, 0, stmsp));
        let stmr = to_int(str_sub(stmargs, stmsp + 1, len(stmargs)));
        return "st: max(" + to_string(stml) + "," + to_string(stmr) + ")=" + to_string(st_rmq_max(stml, stmr));
    }

    // === Binary Heap ===
    if cmd == "bh status"  { return "bh: size=" + to_string(bh_n) + " peek=" + to_string(bh_peek()); }
    if cmd == "bh extract" { return "bh: extracted=" + to_string(bh_extract_min()) + " size=" + to_string(bh_n); }
    if cmd == "bh peek"    { return "bh: min=" + to_string(bh_peek()); }
    if cmd == "bh test"    { let br = bh_test(); return "bh: ok=" + to_string(br); }
    if _starts_with(cmd, "bh insert ") {
        let bhv = to_int(str_sub(cmd, 10, len(cmd)));
        bh_insert(bhv);
        return "bh: inserted " + to_string(bhv) + " size=" + to_string(bh_n);
    }

    // === KD-Tree ===
    if cmd == "kd build"  { let kr2 = kd_build(); return "kd: tree built root=" + to_string(kr2) + " n=" + to_string(kd_n); }
    if cmd == "kd status" { return "kd: points=" + to_string(kd_n) + " nodes=" + to_string(kd_size); }
    if cmd == "kd test"   { let ktr = kd_test(); return "kd: nearest_idx=" + to_string(ktr); }
    if _starts_with(cmd, "kd add ") {
        let kdaargs = str_sub(cmd, 7, len(cmd));
        let kdasp = _find_space(kdaargs);
        if kdasp < 0 { return "kd add: usage kd add <x> <y>"; }
        let kdax = to_int(str_sub(kdaargs, 0, kdasp));
        let kday = to_int(str_sub(kdaargs, kdasp + 1, len(kdaargs)));
        let kdai = kd_add_point(kdax, kday);
        return "kd: added (" + to_string(kdax) + "," + to_string(kday) + ") idx=" + to_string(kdai);
    }
    if _starts_with(cmd, "kd nearest ") {
        let kdnargs = str_sub(cmd, 11, len(cmd));
        let kdnsp = _find_space(kdnargs);
        if kdnsp < 0 { return "kd nearest: usage kd nearest <x> <y>"; }
        let kdnx = to_int(str_sub(kdnargs, 0, kdnsp));
        let kdny = to_int(str_sub(kdnargs, kdnsp + 1, len(kdnargs)));
        let kdnn = kd_nearest(kdnx, kdny);
        return "kd: nearest(" + to_string(kdnx) + "," + to_string(kdny) + ")=(" + to_string(kd_px[kdnn]) + "," + to_string(kd_py[kdnn]) + ") d2=" + to_string(kd_best_d2);
    }
    if _starts_with(cmd, "kd range ") {
        let kdrargs = str_sub(cmd, 9, len(cmd));
        let kdrsp1 = _find_space(kdrargs);
        if kdrsp1 < 0 { return "kd range: usage kd range <x> <y> <r2>"; }
        let kdrx = to_int(str_sub(kdrargs, 0, kdrsp1));
        let kdrrem = str_sub(kdrargs, kdrsp1 + 1, len(kdrargs));
        let kdrsp2 = _find_space(kdrrem);
        if kdrsp2 < 0 { return "kd range: usage kd range <x> <y> <r2>"; }
        let kdry = to_int(str_sub(kdrrem, 0, kdrsp2));
        let kdrr2 = to_int(str_sub(kdrrem, kdrsp2 + 1, len(kdrrem)));
        let kdrc = kd_range_count(kdrx, kdry, kdrr2);
        return "kd: range(" + to_string(kdrx) + "," + to_string(kdry) + ",r2=" + to_string(kdrr2) + ")=" + to_string(kdrc);
    }

    // === Leftist Heap ===
    if cmd == "lh status"  { return "lh: size=" + to_string(lh_size) + " size2=" + to_string(lh_size2) + " peek=" + to_string(lh_peek()); }
    if cmd == "lh extract" { return "lh: extracted=" + to_string(lh_extract_min()) + " size=" + to_string(lh_size); }
    if cmd == "lh peek"    { return "lh: min=" + to_string(lh_peek()); }
    if cmd == "lh merge"   { lh_merge_heaps(); return "lh: merged size=" + to_string(lh_size); }
    if cmd == "lh test"    { let lr = lh_test(); return "lh: ok=" + to_string(lr); }
    if _starts_with(cmd, "lh insert2 ") {
        let lhv2 = to_int(str_sub(cmd, 11, len(cmd)));
        lh_insert2(lhv2);
        return "lh2: inserted " + to_string(lhv2) + " size2=" + to_string(lh_size2);
    }
    if _starts_with(cmd, "lh insert ") {
        let lhv = to_int(str_sub(cmd, 10, len(cmd)));
        lh_insert(lhv);
        return "lh: inserted " + to_string(lhv) + " size=" + to_string(lh_size);
    }

    // === LCS / Edit Distance / LIS ===
    if cmd == "lcs test" { let lr2 = lcs_test(); return "lcs: lcs=" + to_string(lr2); }

    // === Convex Hull ===
    if cmd == "ch build"  { let chr = ch_build(); return "ch: hull_n=" + to_string(chr); }
    if cmd == "ch hull_n" { return "ch: hull_n=" + to_string(ch_hull_n); }
    if cmd == "ch test"   { let ctr = ch_test(); return "ch: hull_n=" + to_string(ctr); }
    if _starts_with(cmd, "ch add ") {
        let chaargs = str_sub(cmd, 7, len(cmd));
        let chasp = _find_space(chaargs);
        if chasp < 0 { return "ch add: usage ch add <x> <y>"; }
        let chax = to_int(str_sub(chaargs, 0, chasp));
        let chay = to_int(str_sub(chaargs, chasp + 1, len(chaargs)));
        let chai = ch_add_point(chax, chay);
        return "ch: added (" + to_string(chax) + "," + to_string(chay) + ") n=" + to_string(ch_n);
    }

    if cmd == "dijk test"    { let dijkr = dijkstra_test(); return "dijk: test d[4]=" + to_string(dijkr); }
    if _starts_with(cmd, "dijk setn ") {
        let dijkn = to_int(str_sub(cmd, 10, len(cmd)));
        dijkstra_set_n(dijkn);
        return "dijk: n=" + to_string(dijkn);
    }
    if _starts_with(cmd, "dijk run ") {
        let dijksrc = to_int(str_sub(cmd, 9, len(cmd)));
        dijkstra_run(dijksrc);
        return "dijk: run from " + to_string(dijksrc);
    }
    if _starts_with(cmd, "dijk dist ") {
        let dijkv = to_int(str_sub(cmd, 10, len(cmd)));
        let dijkd = dijkstra_dist(dijkv);
        return "dijk: dist[" + to_string(dijkv) + "]=" + to_string(dijkd);
    }
    if _starts_with(cmd, "dijk add ") {
        let dijkargs = str_sub(cmd, 9, len(cmd));
        let dijksp1 = _find_space(dijkargs);
        if dijksp1 < 0 { return "dijk add: usage dijk add <u> <v> <w>"; }
        let dijku = to_int(str_sub(dijkargs, 0, dijksp1));
        let dijkargs2 = str_sub(dijkargs, dijksp1 + 1, len(dijkargs));
        let dijksp2 = _find_space(dijkargs2);
        if dijksp2 < 0 { return "dijk add: usage dijk add <u> <v> <w>"; }
        let dijkv2 = to_int(str_sub(dijkargs2, 0, dijksp2));
        let dijkw = to_int(str_sub(dijkargs2, dijksp2 + 1, len(dijkargs2)));
        dijkstra_add_edge(dijku, dijkv2, dijkw);
        return "dijk: add " + to_string(dijku) + "->" + to_string(dijkv2) + " w=" + to_string(dijkw);
    }

    if cmd == "topo test"  { let topor = topo_test(); return "topo: test cycle=" + to_string(topor); }
    if cmd == "topo run"   { topo_run(); return "topo: order_n=" + to_string(topo_order_n) + " cycle=" + to_string(topo_has_cycle); }
    if cmd == "topo order" { return "topo: order[0]=" + to_string(topo_order[0]) + " order[1]=" + to_string(topo_order[1]) + " n=" + to_string(topo_order_n); }
    if cmd == "topo cycle" { return "topo: has_cycle=" + to_string(topo_has_cycle); }
    if _starts_with(cmd, "topo setn ") {
        let toponn = to_int(str_sub(cmd, 10, len(cmd)));
        topo_set_n(toponn);
        return "topo: n=" + to_string(toponn);
    }
    if _starts_with(cmd, "topo add ") {
        let topoargs = str_sub(cmd, 9, len(cmd));
        let toposp = _find_space(topoargs);
        if toposp < 0 { return "topo add: usage topo add <u> <v>"; }
        let topou = to_int(str_sub(topoargs, 0, toposp));
        let topov = to_int(str_sub(topoargs, toposp + 1, len(topoargs)));
        topo_add_edge(topou, topov);
        return "topo: add " + to_string(topou) + "->" + to_string(topov);
    }

    if cmd == "bf test"     { let bfr = bf_test(); return "bf: test d[3]=" + to_string(bfr); }
    if cmd == "bf negcycle" { return "bf: neg_cycle=" + to_string(bf_neg_cycle); }
    if _starts_with(cmd, "bf setn ") {
        let bfn = to_int(str_sub(cmd, 8, len(cmd)));
        bf_set_n(bfn);
        return "bf: n=" + to_string(bfn);
    }
    if _starts_with(cmd, "bf run ") {
        let bfsrc = to_int(str_sub(cmd, 7, len(cmd)));
        bf_run(bfsrc);
        return "bf: run from " + to_string(bfsrc) + " neg_cycle=" + to_string(bf_neg_cycle);
    }
    if _starts_with(cmd, "bf dist ") {
        let bfv = to_int(str_sub(cmd, 8, len(cmd)));
        let bfd = bf_dist_v(bfv);
        return "bf: dist[" + to_string(bfv) + "]=" + to_string(bfd);
    }
    if _starts_with(cmd, "bf add ") {
        let bfargs = str_sub(cmd, 7, len(cmd));
        let bfsp1 = _find_space(bfargs);
        if bfsp1 < 0 { return "bf add: usage bf add <u> <v> <w>"; }
        let bfu = to_int(str_sub(bfargs, 0, bfsp1));
        let bfargs2 = str_sub(bfargs, bfsp1 + 1, len(bfargs));
        let bfsp2 = _find_space(bfargs2);
        if bfsp2 < 0 { return "bf add: usage bf add <u> <v> <w>"; }
        let bfv2 = to_int(str_sub(bfargs2, 0, bfsp2));
        let bfw = to_int(str_sub(bfargs2, bfsp2 + 1, len(bfargs2)));
        bf_add_edge(bfu, bfv2, bfw);
        return "bf: add " + to_string(bfu) + "->" + to_string(bfv2) + " w=" + to_string(bfw);
    }

    if cmd == "prim test"   { let primr = prim_test(); return "prim: mst_weight=" + to_string(primr); }
    if cmd == "prim run"    { let primw = prim_run(); return "prim: mst_weight=" + to_string(primw); }
    if cmd == "prim weight" { return "prim: mst_weight=" + to_string(prim_mst_weight); }
    if _starts_with(cmd, "prim setn ") {
        let primn = to_int(str_sub(cmd, 10, len(cmd)));
        prim_set_n(primn);
        return "prim: n=" + to_string(primn);
    }
    if _starts_with(cmd, "prim add ") {
        let primargs = str_sub(cmd, 9, len(cmd));
        let primsp1 = _find_space(primargs);
        if primsp1 < 0 { return "prim add: usage prim add <u> <v> <w>"; }
        let primu = to_int(str_sub(primargs, 0, primsp1));
        let primargs2 = str_sub(primargs, primsp1 + 1, len(primargs));
