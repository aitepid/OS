// shell.hl -- HicOS Interactive Serial Shell
//
// Processes commands received via serial/keyboard input.
// Runs in kernel main loop after all subsystems are initialized.
//
// 685 commands + pipe operator (|):
//   help ver uptime date free heap ps cpus mount lspci ifconfig
//   ls cat echo fib hilbert clear reboot shutdown ping dns arp dev panic
//   whoami id uname lsusb beep env proc meminfo mounts dmesg mixer ip6
//   cache ntp wdog tmpfs fw rand cg pty sock shm trace hrt sysfs
//   services svc(start/stop/status) kinfo run kill mkdir rm cp mv
//   history hostname netstat grep disk_info format install advtest
//   tcploop dnstest heval lsmod kmodtest
//   UI: sysmon files audiotest settings fm fileman edit editor
//   Audio: audio vol mute unmute beep  AudioServer: audioserver aus aus-connect/play/stop/vol/beep
//   GPU: gpu flip dirty
//   Namespace: ns  ns new  ns info  ns hostname  ns enter  ns del
//   Seccomp:   seccomp  seccomp new  seccomp deny  seccomp apply
//   Container: ctr  ctr new  ctr start  ctr stop  ctr rm  ctr exec  ctr info
//   Clipboard: clipboard  clip copy  clip paste  clip hist
//   Overlay FS: overlay  overlay new  overlay rm  overlay info
//   HTTP Server: httpd  httpd start  httpd stop  httpd tick
//   Calculator: calc
//   Paint: paint (graphical canvas)
//   JSON: json parse  json fmt
//   WebSocket: ws  ws connect  ws send  ws close  ws ping  ws info  ws tick
//   Telnet: telnet [host [port]]  telsend <id> <text>  telrecv <id>  telclose <id>  telnet tick
//   Regex: regex match <pat> <text>  regex find <pat> <text>  regex repl <pat> <repl> <text>
//   Browser: browse [url]
//   Shell pipe: cmd1 | cmd2

fn shell_handle(cmd) {
    if cmd == "help" {
        print("=== HicOS Shell Commands ===");
        print("System:   help ver uptime date uname reboot shutdown kinfo hostname");
        print("Memory:   free heap meminfo");
        print("Tasks:    ps kill run (kill sends SIGTERM by default)");
        print("Signals:  SIGTERM=15 SIGKILL=9 SIGSTOP=19 SIGCONT=18");
        print("Files:    ls [path] cat echo  echo <text> > <file>  mkdir rm  cp <s> <d>  mv <s> <d>  fm (graphical)");
        print("Editor:   editor  edit <file>   (graphical text editor with VFS open/save)");
        print("Proc:     mounts (dynamic) | cat /proc/meminfo etc.");
        print("Disk:     disk_info format install");
        print("Network:  ifconfig ping dns arp netstat");
        print("Firewall: fw  firewall  fw allow|block <port>  fw flush  fw policy input|output drop|accept");
        print("Hardware: lspci lsusb cpus dev beep ahci usb acpi");
        print("Audio:    audio  audio vol <0-100>  audio mute/unmute  audio beep <hz> <ms>  mixer");
        print("AudioSvr: audioserver  aus  aus connect  aus play/stop <id>  aus vol <pct>  aus beep <hz> <ms>");
        print("Graphics: gpu  gpu flip  gpu dirty");
        print("Services: services svc start|stop|status <name>");
        print("FS Events:inotify  watch <path>  pty [alloc|info <id>]");
        print("Namespace:ns  ns new  ns info <id>  ns hostname <id> <name>  ns enter <tid> <nsid>  ns del <id>");
        print("Seccomp:  seccomp  seccomp new <name>  seccomp deny <pid> <nr>  seccomp apply <tid> <pid>");
        print("Container:ctr  ctr new <name> [root]  ctr start/stop/rm <id>  ctr exec <id> <cmd>  ctr info <id>");
        print("Clipboard:clipboard  clip copy <text>  clip paste  clip hist");
        print("OverlayFS:overlay  overlay new <lower> <upper> <merged>  overlay rm <id>  overlay info <id>");
        print("HTTP Svr: httpd  httpd start  httpd stop  httpd tick");
        print("UI Apps:  sysmon fileman editor edit calc  audiotest");
        print("Calculator: calc (graphical 4-function)");
        print("Paint:    paint (graphical canvas: pen/eraser/line/fill)");
        print("JSON:     json parse <str>  json fmt <str>");
        print("WebSock:  ws  ws connect <host> <port> [path]  ws send <id> <msg>  ws close/ping/info/tick");
        print("Telnet:   telnet [host [port]]  telsend <id> <text>  telrecv <id>  telclose <id>  telnet tick");
        print("Regex:    regex match <pat> <text>  regex find <pat> <text>  regex repl <pat> <repl> <text>");
        print("Browser:  browse [url]  (graphical HTTP browser, HTML tag stripping)");
        print("SMTP:     smtp  smtp connect <host> <port>  smtp auth <id> <user> <pass>  smtp send <id> <from> <to> <subj> <body>  smtp quit <id>");
        print("Cron:     cron  cron add <secs> <cmd>  cron once <secs> <cmd>  cron rm <id>  cron en <id>  cron dis <id>");
        print("ImgView:  imgview <path.bmp>  imgview zoom <1|2>  (opens BMP image viewer)");
        print("NTP:      ntp sync <host>  ntp time  ntp status");
        print("TAR:      tar list <path>  tar cat <path> <file>  tar extract <path> <dest>  tar info <path>");
        print("HexEdit:  hexedit [path]  (open hex editor; Tab=toggle edit, Ctrl+S=save)");
        print("POP3:     pop3 connect <host> <port>  pop3 auth <id> <user> <pass>  pop3 list <id>  pop3 get <id> <n>  pop3 quit <id>");
        print("IRC:      irc connect <host> [port]  irc reg <id> <nick> <user>  irc join <id> <#chan>  irc say <id> <#chan> <msg>  irc part <id>  irc quit <id>");
        print("Calendar: calendar  cal next  cal prev  cal today  cal add <day> <text>  cal goto <month> <year>");
        print("Compress: compress <rle|lz> <src> <dst>  decompress <rle|lz> <src> <dst>  compstat <path>");
        print("SQLite:   db list  db create <name> <col1,col2>  db insert <name> <v1,v2>  db select <name>  db where <name> <col> <val>  db delete <name> <col> <val>  db drop <name>  db schema <name>");
        print("Diff:     diff <pathA> <pathB>  diffstat <pathA> <pathB>  diffstr <textA> <textB>");
        print("Clock:    clock  clock close  clock alarm <HH> <MM>  clock time");
        print("Base64:   b64encode <src> <dst>  b64decode <src> <dst>  b64str <text>");
        print("INI:      ini load <path>  ini list  ini get <sec> <key>  ini set <sec> <key> <val>  ini save <path>  ini del <sec> <key>");
        print("Profiler: prof report  prof top <n>  prof inc <name>  prof reset  prof spans  prof sample  prof ring");
        print("CSV:      csv load <path>  csv list [n]  csv get <row> <col>  csv set <row> <col> <val>  csv save <path>  csv cols");
        print("Ping:     ping <host> [count]");
        print("Trace:    traceroute <host> [max_hops]");
        print("Semaphore:sem list  sem create <name> <val>  sem wait <id>  sem post <id>  sem value <id>  sem destroy <id>");
        print("Notepad:  notepad [path]");
        print("TaskMan:  taskman");
        print("IMAP:     imap  imap connect <host> <port>  imap login <id> <user> <pass>  imap select <id> <mbox>  imap list <id>  imap fetch <id> <from> <to>  imap logout <id>");
        print("MQTT:     mqtt  mqtt connect <host> <port> <cid>  mqtt pub <id> <topic> <payload>  mqtt sub <id> <topic>  mqtt unsub <id> <topic>  mqtt ping <id>  mqtt quit <id>");
        print("LZ4:      lz4c <in> <out>  lz4d <in> <out>  lz4test");
        print("FTP:      ftp  ftp connect <host>  ftp auth <id> <user> <pass>  ftp ls <id> [path]  ftp get <id> <rem> <loc>  ftp put <id> <loc> <rem>  ftp pwd <id>  ftp cd <id> <path>  ftp quit <id>");
        print("CBOR:     cbor uint <n>  cbor neg <n>  cbor str <s>  cbor bool <0|1>  cbor null  cbor hex <hexstr>  cbor test");
        print("Syslogd:  syslogd  syslogd start  syslogd stop  syslogd clear  syslogd status  syslogd last <n>");
        print("CPIO:     cpio load <path>  cpio list  cpio extract <idx> <dest>  cpio clear  cpio test");
        print("QP:       qp encode <text>  qp decode <text>  qp show  qp test");
        print("UU:       uu encode <text> <fname>  uu decode <text>  uu show  uu test");
        print("ASN1:     asn1 int <n>  asn1 str <text>  asn1 null  asn1 test");
        print("PEM:      pem parse <data>  pem load <path>  pem show  pem label  pem test");
        print("JWT:      jwt parse <token>  jwt header  jwt payload  jwt sub  jwt iss  jwt exp  jwt test");
        print("BMP:      bmp load <path>  bmp info  bmp show <x> <y>  bmp test");
        print("GIF:      gif load <path>  gif info  gif palette  gif test");
        print("WAV:      wav load <path>  wav info  wav play  wav test");
        print("Base32:   base32 enc <text>  base32 dec <text>  base32 test");
        print("Hex:      hex enc <text>  hex dec <text>  hex dump <text>  hex test");
        print("URL:      url enc <text>  url dec <text>  url query <str>  url test");
        print("CRC:      crc8 <text>  crc16 <text>  crc32 <text>  crc test");
        print("MD5:      md5 <text>  md5 test");
        print("SHA1:     sha1 <text>  sha1 test");
        print("HMAC:     hmac-md5 <key> <msg>  hmac-sha1 <key> <msg>  hmac test");
        print("PBKDF2:   pbkdf2 <pwd> <salt> <iter> <len>  pbkdf2 test");
        print("UUID:     uuid  uuid v4  uuid nil  uuid validate <uuid>  uuid test");
        print("RLE:      rle encode <data>  rle decode <data>  rle ratio <orig> <comp>  rle hex <data>  rle test");
        print("RSS:      rss parse <xml>  rss channel  rss items  rss item <n>  rss count  rss test");
        print("LDAP:     ldap connect <host>  ldap bind <dn> <pwd>  ldap search <dn> <filter>  ldap unbind  ldap disconnect  ldap test");
        print("AES:      aes key <key>  aes encrypt <data>  aes decrypt <data>  aes hex  aes test");
        print("Huffman:  huffman encode <data>  huffman decode <data>  huffman ratio <orig> <comp>  huffman test");
        print("RADIUS:   radius secret <secret>  radius request <user> <pwd>  radius send <server>  radius parse <data>  radius test");
        print("SHA256:   sha256 <text>  sha256 test");
        print("DHCPSrv:  dhcpsrv start  dhcpsrv pool <start> <end>  dhcpsrv options <subnet> <router> <dns>  dhcpsrv leases  dhcpsrv test");
        print("SIP:      sip local <ip> <port>  sip invite <from> <to> <host>  sip ack <to> <host>  sip bye <to> <host>  sip register <user> <reg>  sip test");
        print("Bcrypt:   bcrypt cost <n>  bcrypt hash <pwd>  bcrypt verify <pwd> <hash>  bcrypt test");
        print("RTSP:     rtsp options <url>  rtsp describe <url>  rtsp setup <url> <port>  rtsp play <url>  rtsp pause <url>  rtsp teardown <url>  rtsp test");
        print("STUN:     stun request  stun parse <data>  stun addr  stun test");
        print("RTP:      rtp create <len> <mark>  rtp parse <data>  rtp setpt <pt>  rtp info  rtp test");
        print("SOCKS:    socks proxy <host> <port>  socks auth <user> <pass>  socks connect <host> <port>  socks close  socks test");
        print("ZLIB:     zlib compress <data>  zlib decompress <data>  zlib level <n>  zlib ratio <orig> <comp>  zlib test");
        print("LZMA:     lzma compress <data>  lzma decompress <data>  lzma ratio  lzma test");
        print("Protobuf: protobuf start  protobuf addint <f> <v>  protobuf addstr <f> <s>  protobuf decode <data>  protobuf test");
        print("ChaCha20: chacha20 key <key>  chacha20 nonce <nonce>  chacha20 encrypt <data>  chacha20 decrypt <data>  chacha20 test");
        print("RSA:      rsa genkey  rsa encrypt <msg>  rsa decrypt <cipher>  rsa pubkey  rsa test");
        print("Ed25519:  ed25519 genkey  ed25519 sign <msg>  ed25519 verify <msg> <sig>  ed25519 pubkey  ed25519 test");
        print("Avro:     avro start  avro addint <val>  avro addstr <str>  avro person <name> <age>  avro test");
        print("Bzip2:    bzip2 compress <data>  bzip2 decompress <data>  bzip2 output  bzip2 ratio  bzip2 test");
        print("Scrypt:   scrypt derive <pwd> <salt>  scrypt cost <n>  scrypt key  scrypt hex  scrypt test");
        print("BLAKE2:   blake2 hash <data>  blake2 hex  blake2 digest  blake2 size  blake2 test");
        print("Snappy:   snappy compress <data>  snappy decompress <data>  snappy output  snappy len  snappy test");
        print("Argon2:   argon2 hash <pwd> <salt>  argon2 variant <id>  argon2 cost <n>  argon2 hex  argon2 test");
        print("Poly1305: poly1305 key <key>  poly1305 update <msg>  poly1305 tag  poly1305 verify <tag>  poly1305 test");
        print("xxHash:   xxhash seed <n>  xxhash hash <data>  xxhash64 <data>  xxhash hex  xxhash test");
        print("SipHash:  siphash key <key>  siphash hash <data>  siphash hex  siphash result  siphash test");
        print("Zstd:     zstd compress <data>  zstd decompress <data>  zstd level <n>  zstd ratio <orig>  zstd test");
        print("Brotli:   brotli compress <data>  brotli decompress <data>  brotli quality <n>  brotli ratio <orig>  brotli test");
        print("SM3:      sm3 hash <data>  sm3 hex  sm3 test");
        print("SM4:      sm4 key <key>  sm4 encrypt <data>  sm4 decrypt <data>  sm4 hex  sm4 test");
        print("X25519:   curve25519 scalar <key>  curve25519 pubkey  curve25519 shared <peer_pub>  curve25519 pubhex  curve25519 test");
        print("AES-GCM:  aesgcm key <key>  aesgcm nonce <nonce>  aesgcm aad <data>  aesgcm encrypt <data>  aesgcm tag  aesgcm test");
        print("CP1305:   cp1305 key <key>  cp1305 nonce <nonce>  cp1305 encrypt <data>  cp1305 tag  cp1305 test");
        print("X.509:    x509 parse <der>  x509 pem <data>  x509 list  x509 info <n>  x509 subject <n>  x509 issuer <n>  x509 key <n>  x509 clear  x509 test");
        print("gRPC:     grpc svc <name>  grpc method <svc> <name>  grpc call <path>  grpc list  grpc status  grpc meta <k> <v>  grpc test");
        print("PNG:      png load <path>  png info  png pixel <x> <y>  png show  png test");
        print("HTTP/2:   h2 connect  h2 get <path>  h2 post <path> <body>  h2 status  h2 stream <sid>  h2 ping  h2 goaway  h2 settings  h2 test");
        print("JPEG:     jpeg load <path>  jpeg info  jpeg pixel <x> <y>  jpeg idct  jpeg test");
        print("Raft:     raft init <id> <size>  raft peer <id>  raft propose <cmd>  raft tick <ms>  raft status  raft test");
        print("Gossip:   gossip init <id> <addr>  gossip join <id> <addr>  gossip tick <ms>  gossip members  gossip status  gossip test");
        print("Matrix:   mat new <rows> <cols>  mat identity <n>  mat mul <a> <b>  mat inv <m>  mat norm <m>  mat info <m>  mat test");
        print("Neural:   nn layer <size> <act>  nn init  nn forward <inputs>  nn loss  nn train  nn info  nn test");
        print("Attention: attn config <dm> <heads> <dff>  attn forward <seq>  attn ffn  attn info  attn test");
        print("Bloom:    bloom add <item>  bloom query <item>  bloom delete <item>  bloom status  bloom test");
        print("CRDT:     crdt gc inc  crdt pn inc  crdt pn dec  crdt gset add <e>  crdt lww add <e>  crdt orset add <e>  crdt status  crdt test");
        print("SkipList: skip insert <k> <v>  skip get <k>  skip delete <k>  skip range <lo> <hi>  skip status  skip test");
        print("HyperLogLog: hll add <item>  hll add_int <n>  hll estimate  hll merge  hll status  hll test");
        print("ConsistentHash: chash add <id> <addr>  chash remove <id>  chash get <key>  chash replicas <key> <r>  chash status  chash test");
        print("CMS:      cms add <key> <n>  cms query <key>  cms add_str <s> <n>  cms query_str <s>  cms status  cms test");
        print("LRU:      lru get <key>  lru put <key> <val>  lru peek <key>  lru del <key>  lru status  lru test");
        print("Merkle:   merkle build <n>  merkle root  merkle proof <leaf>  merkle verify <data> <leaf>  merkle update <leaf> <val>  merkle test");
        print("tDigest:  td add <val>  td p50  td p90  td p99  td quantile <q>  td status  td test");
        print("Wavelet:  wv load <n>  wv forward <levels>  wv inverse <levels>  wv threshold <t>  wv info  wv test");
        print("Reservoir: rs add <item>  rs add_batch <n>  rs contains <x>  rs bern_init <p>  rs bern_add <item>  rs status  rs test");
        print("Fenwick:  fw build <n>  fw update <i> <d>  fw query <i>  fw range <l> <r>  fw kth <k>  fw range_update <l> <r> <d>  fw point_query <i>  fw 2d_update <r> <c> <d>  fw 2d_query <r> <c>  fw status  fw test");
        print("SegTree:  seg build <n>  seg update <i> <v>  seg range_add <l> <r> <d>  seg sum <l> <r>  seg min <l> <r>  seg max <l> <r>  seg status  seg test");
        print("Cuckoo:   cf insert <item>  cf contains <item>  cf delete <item>  cf status  cf test");
        print("DSU:      dsu union <x> <y>  dsu find <x>  dsu connected <x> <y>  dsu size <x>  dsu kruskal  dsu status  dsu test");
        print("Treap:    treap insert <k> <v>  treap delete <k>  treap search <k>  treap kth <k>  treap rank <k>  treap min  treap max  treap status  treap test");
        print("SuffixArray: sa build <n>  sa lcp  sa search <p>  sa lrs  sa distinct  sa status  sa test");
        print("AhoCorasick: ac init  ac build  ac search <text>  ac status  ac test");
        print("KMP:      kmp search <pat> <text>  kmp z <pat> <text>  kmp rk <pat> <text>  kmp test");
        print("IntervalTree: it insert <lo> <hi>  it stab <q>  it overlap <lo> <hi>  it status  it test");
        print("SparseTable: st build <n>  st min <l> <r>  st max <l> <r>  st status  st test");
        print("BinaryHeap:  bh insert <v>  bh extract  bh peek  bh heapsort <n>  bh status  bh test");
        print("KDTree:      kd add <x> <y>  kd build  kd nearest <x> <y>  kd range <x> <y> <r2>  kd status  kd test");
        print("LeftistHeap: lh insert <v>  lh insert2 <v>  lh extract  lh peek  lh merge  lh status  lh test");
        print("LCS:         lcs compute <alen> <blen>  lcs edit <alen> <blen>  lcs lis <n>  lcs test");
        print("ConvexHull:  ch add <x> <y>  ch build  ch hull_n  ch test");
        print("Dijkstra:    dijk add <u> <v> <w>  dijk run <src>  dijk dist <v>  dijk setn <n>  dijk test");
        print("TopoSort:    topo add <u> <v>  topo run  topo order  topo cycle  topo setn <n>  topo test");
        print("BellmanFord: bf add <u> <v> <w>  bf run <src>  bf dist <v>  bf setn <n>  bf negcycle  bf test");
        print("Prim MST:    prim add <u> <v> <w>  prim run  prim weight  prim setn <n>  prim test");
        print("Kruskal MST: kr add <u> <v> <w>  kr run  kr weight  kr setn <n>  kr test");
        print("FloydWarsh:  fw add <u> <v> <w>  fw run  fw dist <u> <v>  fw setn <n>  fw test");
        print("AStar:       as add <u> <v> <w>  as setpos <v> <x> <y>  as run <src> <dst>  as setn <n>  as test");
        print("MaxFlow:     mf add <u> <v> <c>  mf run <src> <sink>  mf flow  mf setn <n>  mf test");
        print("BipartMatch: bm add <l> <r>  bm run  bm size  bm setnl <nl>  bm test");
