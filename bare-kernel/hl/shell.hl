        return "ior: submit_id=" + to_string(ior_id);
    }
    if _starts_with(cmd, "ior read ") {
        let ior_args2 = str_sub(cmd, 9, len(cmd));
        let ior_id2 = ior_submit(IOR_READ, 1, 0x2000, to_int(ior_args2));
        return "ior: submit_id=" + to_string(ior_id2);
