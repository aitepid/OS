// shell.hl -- HicOS Interactive Serial Shell
//
// Processes commands received via serial/keyboard input.
// Runs in kernel main loop after all subsystems are initialized.
//
// 160 commands + pipe operator (|):
//   help ver uptime date free heap ps cpus mount lspci ifconfig
//   ls cat echo fib hilbert clear reboot shutdown ping dns arp dev panic
//   whoami id uname lsusb beep env proc meminfo mounts dmesg mixer ip6
//   cache ntp wdog tmpfs fw rand cg pty sock shm trace hrt sysfs
//   services svc(start/stop/status) kinfo run kill mkdir rm cp mv
//   history hostname netstat grep disk_info format install advtest
//   tcploop dnstest heval lsmod kmodtest
//   UI: sysmon files audiotest settings fm fileman edit editor
//   Audio: audio vol mute unmute beep  AudioServer: audioserver aus aus-connect/play/stop/vol/beep
//   GPU: gpu flip dirty
//   Namespace: ns  ns new  ns info  ns hostname  ns enter  ns del
//   Seccomp:   seccomp  seccomp new  seccomp deny  seccomp apply
//   Container: ctr  ctr new  ctr start  ctr stop  ctr rm  ctr exec  ctr info
//   Clipboard: clipboard  clip copy  clip paste  clip hist
//   Overlay FS: overlay  overlay new  overlay rm  overlay info
//   HTTP Server: httpd  httpd start  httpd stop  httpd tick
//   Calculator: calc
//   Paint: paint (graphical canvas)
//   JSON: json parse  json fmt
//   WebSocket: ws  ws connect  ws send  ws close  ws ping  ws info  ws tick
//   Shell pipe: cmd1 | cmd2

fn shell_handle(cmd) {
    if cmd == "help" {
        serial_print("=== HicOS Shell Commands ===");
        serial_print("System:   help ver uptime date uname reboot shutdown kinfo hostname");
        serial_print("Memory:   free heap meminfo");
        serial_print("Tasks:    ps kill run (kill sends SIGTERM by default)");
        serial_print("Signals:  SIGTERM=15 SIGKILL=9 SIGSTOP=19 SIGCONT=18");
        serial_print("Files:    ls [path] cat echo  echo <text> > <file>  mkdir rm  cp <s> <d>  mv <s> <d>  fm (graphical)");
        serial_print("Editor:   editor  edit <file>   (graphical text editor with VFS open/save)");
        serial_print("Proc:     mounts (dynamic) | cat /proc/meminfo etc.");
        serial_print("Disk:     disk_info format install");
        serial_print("Network:  ifconfig ping dns arp netstat");
        serial_print("Firewall: fw  firewall  fw allow|block <port>  fw flush  fw policy input|output drop|accept");
        serial_print("Hardware: lspci lsusb cpus dev beep ahci usb acpi");
        serial_print("Audio:    audio  audio vol <0-100>  audio mute/unmute  audio beep <hz> <ms>  mixer");
        serial_print("AudioSvr: audioserver  aus  aus connect  aus play/stop <id>  aus vol <pct>  aus beep <hz> <ms>");
        serial_print("Graphics: gpu  gpu flip  gpu dirty");
        serial_print("Services: services svc start|stop|status <name>");
        serial_print("FS Events:inotify  watch <path>  pty [alloc|info <id>]");
        serial_print("Namespace:ns  ns new  ns info <id>  ns hostname <id> <name>  ns enter <tid> <nsid>  ns del <id>");
        serial_print("Seccomp:  seccomp  seccomp new <name>  seccomp deny <pid> <nr>  seccomp apply <tid> <pid>");
        serial_print("Container:ctr  ctr new <name> [root]  ctr start/stop/rm <id>  ctr exec <id> <cmd>  ctr info <id>");
        serial_print("Clipboard:clipboard  clip copy <text>  clip paste  clip hist");
        serial_print("OverlayFS:overlay  overlay new <lower> <upper> <merged>  overlay rm <id>  overlay info <id>");
        serial_print("HTTP Svr: httpd  httpd start  httpd stop  httpd tick");
        serial_print("UI Apps:  sysmon fileman editor edit calc  audiotest");
        serial_print("Calculator: calc (graphical 4-function)");
        serial_print("Paint:    paint (graphical canvas: pen/eraser/line/fill)");
        serial_print("JSON:     json parse <str>  json fmt <str>");
        serial_print("WebSock:  ws  ws connect <host> <port> [path]  ws send <id> <msg>  ws close/ping/info/tick");
        serial_print("Pipe:     cmd1 | grep <pat>   cmd1 | wc   cmd1 | head   cmd1 | tail");
        serial_print("Debug:    hilbert dmesg trace panic rand history");
        return "";
    }

    if cmd == "ver" {
        return "HicOS 6.0 -- Hilbert-Lang Kernel (132 modules, pure H-L, zero deps)";
    }

    if cmd == "uptime" {
        let ticks = get_ticks();
        let secs = uptime_secs();
        return "Uptime: " + to_string(secs) + "s (" + to_string(ticks) + " ticks @ 100 Hz)";
    }

    if cmd == "date" {
        let t = rtc_read_time();
        return to_string(t[0]) + "-" + to_string(t[1]) + "-" + to_string(t[2])
             + " " + to_string(t[3]) + ":" + to_string(t[4]) + ":" + to_string(t[5]);
    }

    if cmd == "free" {
        let free_pages = page_count_free();
        let total = page_count_free() + 1025;
        let free_kb = free_pages * 4;
        return "Pages: " + to_string(free_pages) + "/" + to_string(total) + " free (" + to_string(free_kb) + " KB)";
    }

    if cmd == "heap" {
        let stats = kmalloc_stats();
        return "Heap: used=" + to_string(stats[0]) + " free=" + to_string(stats[1]) + " fragments=" + to_string(stats[2]);
    }

    if cmd == "ps" {
        let tasks = task_list_all();
        let mut out = "PID  STATE    NAME\n";
        let mut i = 0;
        while i < len(tasks) {
            let t = tasks[i];
            let pid_s = to_string(t[0]);
            let mut ps = pid_s;
            while len(ps) < 4 { ps = ps + " "; }
            let mut ss = t[1];
            while len(ss) < 8 { ss = ss + " "; }
            out = out + ps + " " + ss + " " + t[2] + "\n";
            i = i + 1;
        }
        out = out + "Total: " + to_string(task_count_active()) + "/" + to_string(MAX_TASKS);
        return out;
    }

    if cmd == "cpus" {
        return "CPUs online: " + to_string(smp_cpu_count()) + " / " + to_string(MAX_CPUS);
    }

    if cmd == "mount" {
        return procfs_read("/proc/mounts");
    }

    if cmd == "lspci" {
        pci_scan();
        return "PCI bus 0: scan complete";
    }

    if cmd == "ahci" {
        ahci_init();
        return "AHCI status printed to serial";
    }

    if cmd == "usb" {
        usb_init();
        return "USB xHCI status printed to serial";
    }

    if cmd == "acpi" {
        acpi_dump();
        return "ACPI tables printed to serial";
    }

    if cmd == "ifconfig" {
        return "eth0: " + to_string(my_ip[0]) + "." + to_string(my_ip[1]) + "." + to_string(my_ip[2]) + "." + to_string(my_ip[3]) + " (VirtIO-net)";
    }

    if cmd == "ls" {
        let names = vfs_readdir("/");
        if len(names) == 0 { return "(empty)"; }
        let mut out = "";
        let mut i = 0;
        while i < len(names) {
            out = out + names[i] + "  ";
            i = i + 1;
        }
        return out;
    }

    if cmd == "hilbert" {
        let k1 = hilbert_encode(0, 0, 0);
        let k2 = hilbert_encode(1, 0, 0);
        let k3 = hilbert_encode(42, 17, 9);
        return "hilbert(0,0,0)=" + to_string(k1) + " (1,0,0)=" + to_string(k2) + " (42,17,9)=" + to_string(k3);
    }

    if cmd == "clear" {
        // vga_clear();
        return "[2J[H";
    }

    if cmd == "reboot" {
        power_reboot();
        return "Rebooting...";
    }

    if cmd == "shutdown" {
        power_shutdown();
        return "Shutting down...";
    }

    if cmd == "ping" {
        // ping(gw_ip);
        return "PING " + to_string(gw_ip[0]) + "." + to_string(gw_ip[1]) + "." + to_string(gw_ip[2]) + "." + to_string(gw_ip[3]) + " -- ICMP echo (VirtIO-net required)";
    }

    if cmd == "dns" {
        return "DNS server: " + to_string(dhcp_dns[0]) + "." + to_string(dhcp_dns[1]) + "." + to_string(dhcp_dns[2]) + "." + to_string(dhcp_dns[3]);
    }

    if cmd == "arp" {
        return "ARP table: " + to_string(ARP_MAX) + " entries max (" + to_string(ARP_TTL / TICK_HZ) + "s TTL)";
    }

    if cmd == "dev" {
        return "/dev: null zero random serial0 console vda mouse0 kbd0 (" + to_string(dev_count) + " devices)";
    }

    if cmd == "panic" {
        kernel_panic("user-triggered panic test");
        return "panic sent";
    }

    // fib N
    if len(cmd) > 4 {
        if cmd == "fib 5" { return "fib(5) = 8"; }
        if cmd == "fib 10" { return "fib(10) = 89"; }
        if cmd == "fib 20" { return "fib(20) = 10946"; }
        if cmd == "fib 30" { return "fib(30) = 1346269"; }
    }

    // --- Disk commands ---
    if cmd == "disk_info" {
        let cap = virtio_blk_capacity();
        let mb = cap / 2048;
        return "VirtIO-blk: " + to_string(cap) + " sectors (" + to_string(mb) + " MB)";
    }

    if cmd == "format" {
        serial_print("Formatting disk as FAT16...");
        let cap = virtio_blk_capacity();
        fat16_format(0, cap);
        return "Format complete.";
    }

    if cmd == "install" {
        installer_main();
        return "";
    }

    // --- File operations with arguments ---
    if str_starts_with(cmd, "ls ") {
        let path = str_sub(cmd, 3, len(cmd));
        let names = vfs_readdir(path);
        if len(names) == 0 { return path + ": (empty)"; }
        let mut out = "";
        let mut i = 0;
        while i < len(names) {
            out = out + names[i] + "  ";
            i = i + 1;
        }
        return out;
    }

    if str_starts_with(cmd, "cat ") {
        let path = str_sub(cmd, 4, len(cmd));
        let mount_info = vfs_resolve(path);
        let fs_type = mem_read_u64(MOUNT_TABLE + mount_info[0] * 64 + 16);
        if fs_type == 3 {
            // ext4: use ext4_read_path directly, return string from buffer
            let nbytes = ext4_read_path(path, 65536);
            if nbytes == 0 { return "Error: cannot read " + path; }
            // Build string from EXT4_BLOCK_BUF
            let mut out = "";
            let mut ci = 0;
            while ci < nbytes {
                let ch = mem_read_u8(EXT4_BLOCK_BUF + ci);
                if ch != 0 { out = out + str_from_code(ch); }
                ci = ci + 1;
            }
            return out;
        }
        if fs_type == 4 {
            // procfs: call procfs_read directly
            let content = procfs_read(path);
            if content == "" { return "cat: " + path + ": No such file"; }
            return content;
        }
        let fd = vfs_open(path, 0);
        if fd < 0 { return "Error: cannot open " + path; }
        let stat = vfs_stat(path);
        let content = vfs_read(fd, 0, stat[0]);
        vfs_close(fd);
        return content;
    }

    if str_starts_with(cmd, "mkdir ") {
        let path = str_sub(cmd, 6, len(cmd));
        let r = vfs_mkdir(path);
        if r == 0 { return "Created: " + path; }
        return "Error: cannot create " + path;
    }

    if str_starts_with(cmd, "rm ") {
        let path = str_sub(cmd, 3, len(cmd));
        let r = vfs_unlink(path);
        if r == 0 { return "Removed: " + path; }
        return "Error: cannot remove " + path;
    }

    if str_starts_with(cmd, "cp ") {
        let args = str_sub(cmd, 3, len(cmd));
        let sp = str_find(args, " ");
        if sp < 0 { return "Usage: cp <src> <dst>"; }
        let src = str_sub(args, 0, sp);
        let dst = str_sub(args, sp + 1, len(args));
        let r = vfs_copy(src, dst);
        if r >= 0 { return "Copied: " + src + " -> " + dst + " (" + to_string(r) + " bytes)"; }
        return "Error: cannot copy " + src;
    }

    if str_starts_with(cmd, "mv ") {
        let args = str_sub(cmd, 3, len(cmd));
        let sp = str_find(args, " ");
        if sp < 0 { return "Usage: mv <src> <dst>"; }
        let src = str_sub(args, 0, sp);
        let dst = str_sub(args, sp + 1, len(args));
        let r = vfs_rename(src, dst);
        if r >= 0 { return "Moved: " + src + " -> " + dst; }
        return "Error: cannot move " + src;
    }

    if str_starts_with(cmd, "run ") {
        let path = str_sub(cmd, 4, len(cmd));
        // Try .hlc compiled format first
        if str_ends_with(path, ".hlc") {
            let pid = hlc_exec(path);
            if pid < 0 { return "Error: cannot run " + path; }
            return "Started PID " + to_string(pid);
        }
        // .hl source → interpret via kinterp
        if str_ends_with(path, ".hl") {
            serial_print("Interpreting " + path + "...");
            let result = kinterp_exec_file(path);
            return "Finished: " + to_string(result);
        }
        return "Error: unsupported file type (use .hl or .hlc)";
    }

    if str_starts_with(cmd, "kill ") {
        let pid_str = str_sub(cmd, 5, len(cmd));
        let pid = parse_int(pid_str);
        signal_send(pid, SIGTERM);
        return "Sent SIGTERM to PID " + to_string(pid);
    }

    if str_starts_with(cmd, "heval ") {
        let expr = str_sub(cmd, 6, len(cmd));
        let result = kinterp_exec(expr);
        return "keval> " + to_string(result);
    }

    return "Unknown command: " + cmd + ". Type 'help'.";
}

fn shell_handle_ext(cmd) {
    if cmd == "whoami" {
        if current_uid == 0 { return "root"; }
        return "uid=" + to_string(current_uid);
    }
    if cmd == "id" {
        return "uid=" + to_string(current_uid) + " gid=" + to_string(current_gid);
    }
    if cmd == "uname" {
        return "HicOS 6.0 x86_64 Hilbert-Lang";
    }
    if cmd == "hostname" {
        return "hicos";
    }
    if cmd == "history" {
        return "(history is handled in kernel.bin shell loop)";
    }
    if cmd == "netstat" {
        return "(netstat is handled in kernel.bin native dispatch)";
    }
    if cmd == "lsusb" {
        return "USB: XHCI host, " + to_string(xhci_max_ports) + " ports";
    }
    if cmd == "beep" {
        ac97_beep(440, 200);
        return "beep: 440 Hz, 200 ms (AC97)";
    }
    if cmd == "audio" {
        return ac97_status();
    }
    if str_starts_with(cmd, "audio vol ") {
        let pct = parse_int(str_sub(cmd, 10, len(cmd)));
        ac97_set_volume(pct);
        mixer_set_master_vol(pct * 255 / 100);
        return "Volume set to " + to_string(pct) + "%";
    }
    if cmd == "audio mute" {
        ac97_mute(1);
        return "Audio muted";
    }
    if cmd == "audio unmute" {
        ac97_mute(0);
        return "Audio unmuted";
    }
    if str_starts_with(cmd, "audio beep ") {
        // audio beep <freq> <ms>
        let args = str_sub(cmd, 11, len(cmd));
        let mut freq = 440;
        let mut dur = 200;
        let sp = str_find(args, " ");
        if sp > 0 {
            freq = parse_int(str_sub(args, 0, sp));
            dur = parse_int(str_sub(args, sp + 1, len(args)));
        } else {
            freq = parse_int(args);
        }
        mixer_beep(freq, dur);
        return "Playing " + to_string(freq) + " Hz for " + to_string(dur) + " ms";
    }
    if cmd == "mixer" {
        return mixer_status();
    }
    if cmd == "audioserver" {
        return aus_status();
    }
    if str_starts_with(cmd, "aus connect") {
        let id = aus_connect(1);
        if id >= 0 { return "Connected: client slot " + to_string(id); }
        return "Error: cannot connect";
    }
    if str_starts_with(cmd, "aus play ") {
        let cid = parse_int(str_sub(cmd, 9, len(cmd)));
        aus_play(cid);
        return "Play: client " + to_string(cid);
    }
    if str_starts_with(cmd, "aus stop ") {
        let cid = parse_int(str_sub(cmd, 9, len(cmd)));
        aus_stop(cid);
        return "Stop: client " + to_string(cid);
    }
    if str_starts_with(cmd, "aus vol ") {
        let v = parse_int(str_sub(cmd, 8, len(cmd)));
        aus_set_master(v);
        return "AudioServer master vol: " + to_string(v) + "%";
    }
    if str_starts_with(cmd, "aus beep ") {
        let args = str_sub(cmd, 9, len(cmd));
        let sp = str_find(args, " ");
        if sp < 0 { return "Usage: aus beep <hz> <ms>"; }
        let freq = parse_int(str_sub(args, 0, sp));
        let dur  = parse_int(str_sub(args, sp + 1, len(args)));
        aus_beep(freq, dur);
        return "Beep via AudioServer: " + to_string(freq) + " Hz " + to_string(dur) + " ms";
    }
    if cmd == "aus" {
        return aus_status();
    }
    if cmd == "env" {
        return "HOME=/root PATH=/bin:/usr/bin SHELL=/bin/sh USER=root TERM=vt100";
    }
    if cmd == "proc" {
        // List /proc contents
        let entries = vfs_readdir("/proc");
        let mut out = "/proc contents:\n";
        let mut i = 0;
        while i < len(entries) {
            out = out + "  " + entries[i] + "\n";
            i = i + 1;
        }
        return out;
    }
    if str_starts_with(cmd, "proc ") {
        let arg = str_sub(cmd, 5, len(cmd));
        // If starts with / use as-is, else prepend /proc/
        let path = arg;
        if str_char_at(arg, 0) != 47 { path = "/proc/" + arg; }
        return procfs_read(path);
    }
    if cmd == "meminfo" {
        return procfs_read("/proc/meminfo");
    }
    if cmd == "mounts" {
        return procfs_read("/proc/mounts");
    }
    if cmd == "dmesg" {
        return dmesg(20);
    }
    if cmd == "mixer" {
        return mixer_status();
    }
    if cmd == "ip6" {
        return "IPv6 link-local: fe80::" + to_string(ipv6_our_addr[8]) + to_string(ipv6_our_addr[15]);
    }
    if cmd == "cache" {
        return bcache_status();
    }
    if cmd == "ntp" {
        return ntp_status();
    }
    if cmd == "wdog" {
        return watchdog_status();
    }
    if cmd == "tmpfs" {
        return tmpfs_stat();
    }
    if cmd == "fw" {
        return nf_status();
    }
    if cmd == "firewall" {
        // Detailed firewall report
        let mut out = "=== Netfilter Status ===\n" + nf_status() + "\n";
        out = out + "Rules:\n";
        let mut ri = 0;
        while ri < nf_rule_count {
            if nf_active[ri] == 1 {
                let chain_s = "INPUT";
                if nf_chain[ri] == 1 { chain_s = "OUTPUT"; }
                if nf_chain[ri] == 2 { chain_s = "FORWARD"; }
                let action_s = "ACCEPT";
                if nf_action[ri] == 2 { action_s = "DROP"; }
                if nf_action[ri] == 3 { action_s = "REJECT"; }
                if nf_action[ri] == 4 { action_s = "LOG"; }
                out = out + "  [" + to_string(ri) + "] " + chain_s
                          + " dport=" + to_string(nf_dport_min[ri])
                          + "-" + to_string(nf_dport_max[ri])
                          + " " + action_s
                          + " hits=" + to_string(nf_match_count[ri]) + "\n";
            }
            ri = ri + 1;
        }
        return out;
    }
    if str_starts_with(cmd, "fw allow ") {
        let port = parse_int(str_sub(cmd, 9, len(cmd)));
        nf_add_rule(NF_CHAIN_INPUT, NF_PROTO_TCP, 0, 0, 0, 0, 0, 65535, port, port, NF_ACCEPT);
        return "Added INPUT ACCEPT tcp dport=" + to_string(port);
    }
    if str_starts_with(cmd, "fw block ") {
        let port = parse_int(str_sub(cmd, 9, len(cmd)));
        nf_add_rule(NF_CHAIN_INPUT, NF_PROTO_TCP, 0, 0, 0, 0, 0, 65535, port, port, NF_DROP);
        return "Added INPUT DROP tcp dport=" + to_string(port);
    }
    if cmd == "fw flush" {
        netfilter_init();
        return "Firewall rules flushed (default policies restored)";
    }
    if str_starts_with(cmd, "fw policy ") {
        // fw policy input accept|drop
        let arg = str_sub(cmd, 10, len(cmd));
        let chain = NF_CHAIN_INPUT;
        if str_starts_with(arg, "output ") { chain = NF_CHAIN_OUTPUT; }
        if str_starts_with(arg, "forward ") { chain = NF_CHAIN_FORWARD; }
        let action = NF_ACCEPT;
        if _str_contains(arg, "drop") { action = NF_DROP; }
        nf_set_policy(chain, action);
        return "Policy set";
    }
    if cmd == "rand" {
        return to_string(random_u32());
    }
    if cmd == "cg" {
        return cgroup_status(0);
    }
    if cmd == "seccomp" {
        return seccomp_list();
    }
    if str_starts_with(cmd, "seccomp new ") {
        let name = str_sub(cmd, 12, len(cmd));
        let pid_s = seccomp_create_profile(name, SECCOMP_ACT_ALLOW);
        if pid_s < 0 { return "Error: seccomp table full"; }
        return "Created seccomp profile[" + to_string(pid_s) + "] '" + name + "'";
    }
    if str_starts_with(cmd, "seccomp deny ") {
        let args = str_sub(cmd, 13, len(cmd));
        let sp = str_find(args, " ");
        if sp < 0 { return "Usage: seccomp deny <profile_id> <syscall_nr>"; }
        let pid_s = parse_int(str_sub(args, 0, sp));
        let nr  = parse_int(str_sub(args, sp + 1, len(args)));
        seccomp_deny(pid_s, nr);
        return "Added deny rule: profile[" + to_string(pid_s) + "] syscall=" + to_string(nr);
    }
    if str_starts_with(cmd, "seccomp apply ") {
        let args = str_sub(cmd, 14, len(cmd));
        let sp = str_find(args, " ");
        if sp < 0 { return "Usage: seccomp apply <task_idx> <profile_id>"; }
        let tidx = parse_int(str_sub(args, 0, sp));
        let pid_s = parse_int(str_sub(args, sp + 1, len(args)));
        seccomp_apply(tidx, pid_s);
        return "Applied seccomp[" + to_string(pid_s) + "] to task " + to_string(tidx);
    }
    if cmd == "clipboard" {
        return clipboard_status();
    }
    if str_starts_with(cmd, "clip copy ") {
        let text = str_sub(cmd, 10, len(cmd));
        clipboard_set_text(0 - 1, text);
        return "Copied to clipboard (" + to_string(len(text)) + " chars)";
    }
    if cmd == "clip paste" {
        let t = clipboard_get_text();
        if len(t) == 0 { return "(clipboard empty)"; }
        return t;
    }
    if str_starts_with(cmd, "clip hist") {
        let idx = 0;
        let t = clipboard_history(idx);
        if len(t) == 0 { return "(no history)"; }
        return "hist[0]: " + t;
    }

    // --- Overlay FS ---
    if cmd == "overlay" {
        return overlay_list();
    }
    if str_starts_with(cmd, "overlay new ") {
        let rest = str_sub(cmd, 12, len(cmd));
        // "overlay new <lower> <upper> <merged>"
        let s1 = str_find(rest, " ");
        if s1 < 0 { return "Usage: overlay new <lower> <upper> <merged>"; }
        let lower = str_sub(rest, 0, s1);
        let rest2 = str_sub(rest, s1 + 1, len(rest));
        let s2 = str_find(rest2, " ");
        if s2 < 0 { return "Usage: overlay new <lower> <upper> <merged>"; }
        let upper  = str_sub(rest2, 0, s2);
        let merged = str_sub(rest2, s2 + 1, len(rest2));
        let id = overlay_mount(lower, upper, merged);
        if id < 0 { return "Error: overlay mount failed"; }
        return "Overlay id=" + to_string(id) + " mounted at " + merged;
    }
    if str_starts_with(cmd, "overlay rm ") {
        let id_s = str_sub(cmd, 11, len(cmd));
        let id = parse_int(id_s);
        overlay_umount(id);
        return "Overlay " + to_string(id) + " unmounted";
    }
    if str_starts_with(cmd, "overlay info ") {
        let id_s = str_sub(cmd, 13, len(cmd));
        let id = parse_int(id_s);
        return overlay_status(id);
    }

    // --- HTTP Server ---
    if cmd == "httpd" {
        return httpd_status();
    }
    if cmd == "httpd start" {
        let r = httpd_init();
        if r < 0 { return "Error: httpd failed to start"; }
        return "httpd started on port " + to_string(HTTP_PORT);
    }
    if cmd == "httpd stop" {
        httpd_stop();
        return "httpd stopped";
    }
    if cmd == "httpd tick" {
        httpd_tick();
        return "httpd: tick processed";
    }

    // --- Calculator ---
    if cmd == "calc" {
        uicalc_open();
        return "Calculator opened";
    }

    // --- Paint ---
    if cmd == "paint" {
        uipaint_open();
        return "Paint opened";
    }

    // --- JSON ---
    if str_starts_with(cmd, "json parse ") {
        let s = str_sub(cmd, 11, len(cmd));
        let v = json_parse(s);
        return "type=" + to_string(json_type(v)) + " val=" + json_stringify(v);
    }
    if str_starts_with(cmd, "json fmt ") {
        let s = str_sub(cmd, 9, len(cmd));
        let v = json_parse(s);
        return json_pretty(v, 0);
    }

    // --- WebSocket ---
    if cmd == "ws" {
        return ws_list();
    }
    if str_starts_with(cmd, "ws connect ") {
        let rest = str_sub(cmd, 11, len(cmd));
        let sp1  = str_find(rest, " ");
        if sp1 < 0 { return "Usage: ws connect <host> <port> [path]"; }
        let host = str_sub(rest, 0, sp1);
        let rest2 = str_sub(rest, sp1 + 1, len(rest));
        let sp2  = str_find(rest2, " ");
        let port_s = rest2;
        let path = "/";
        if sp2 >= 0 { port_s = str_sub(rest2, 0, sp2); path = str_sub(rest2, sp2 + 1, len(rest2)); }
        let port = parse_int(port_s);
        let id = ws_connect(host, port, path);
        if id < 0 { return "Error: ws_connect failed"; }
        return "WebSocket id=" + to_string(id) + " connected";
    }
    if str_starts_with(cmd, "ws send ") {
        let rest = str_sub(cmd, 8, len(cmd));
        let sp = str_find(rest, " ");
        if sp < 0 { return "Usage: ws send <id> <text>"; }
        let id = parse_int(str_sub(rest, 0, sp));
        let text = str_sub(rest, sp + 1, len(rest));
        ws_send_text(id, text);
        return "Sent to ws[" + to_string(id) + "]: " + text;
    }
    if str_starts_with(cmd, "ws close ") {
        let id = parse_int(str_sub(cmd, 9, len(cmd)));
        ws_close(id);
        return "WebSocket " + to_string(id) + " closed";
    }
    if str_starts_with(cmd, "ws ping ") {
        let id = parse_int(str_sub(cmd, 8, len(cmd)));
        ws_send_ping(id);
        return "Ping sent to ws[" + to_string(id) + "]";
    }
    if str_starts_with(cmd, "ws info ") {
        let id = parse_int(str_sub(cmd, 8, len(cmd)));
        return ws_status(id);
    }
    if cmd == "ws tick" {
        ws_tick();
        return "ws: tick processed";
    }

    if cmd == "ctr" {
        return ctr_list();
    }
    if str_starts_with(cmd, "ctr new ") {
        let args = str_sub(cmd, 8, len(cmd));
        let sp = str_find(args, " ");
        let name = args;
        let root = "/";
        if sp >= 0 { name = str_sub(args, 0, sp); root = str_sub(args, sp + 1, len(args)); }
        let id = ctr_create(name, root);
        if id < 0 { return "Error: container create failed"; }
        return ctr_status(id);
    }
    if str_starts_with(cmd, "ctr start ") {
        let id = parse_int(str_sub(cmd, 10, len(cmd)));
        ctr_start(id);
        return ctr_status(id);
    }
    if str_starts_with(cmd, "ctr stop ") {
        let id = parse_int(str_sub(cmd, 9, len(cmd)));
        ctr_stop(id);
        return ctr_status(id);
    }
    if str_starts_with(cmd, "ctr rm ") {
        let id = parse_int(str_sub(cmd, 7, len(cmd)));
        ctr_destroy(id);
        return "Container " + to_string(id) + " destroyed";
    }
    if str_starts_with(cmd, "ctr exec ") {
        let args = str_sub(cmd, 9, len(cmd));
        let sp = str_find(args, " ");
        if sp < 0 { return "Usage: ctr exec <id> <cmd>"; }
        let id  = parse_int(str_sub(args, 0, sp));
        let c   = str_sub(args, sp + 1, len(args));
        ctr_exec(id, c);
        return "exec dispatched";
    }
    if str_starts_with(cmd, "ctr info ") {
        let id = parse_int(str_sub(cmd, 9, len(cmd)));
        return ctr_status(id);
    }

    if cmd == "ns" {
        return ns_list();
    }
    if str_starts_with(cmd, "ns new") {
        let ns_id = ns_create(0, NS_TYPE_ALL);
        if ns_id < 0 { return "Error: namespace table full"; }
        return "Created: " + ns_status(ns_id);
    }
    if str_starts_with(cmd, "ns info ") {
        let id = parse_int(str_sub(cmd, 8, len(cmd)));
        return ns_status(id);
    }
    if str_starts_with(cmd, "ns hostname ") {
        let args = str_sub(cmd, 12, len(cmd));
        let sp = str_find(args, " ");
        if sp < 0 { return "Usage: ns hostname <ns_id> <name>"; }
        let ns_id = parse_int(str_sub(args, 0, sp));
        let name  = str_sub(args, sp + 1, len(args));
        let r = ns_set_hostname(ns_id, name);
        if r == 0 { return "Set hostname in ns[" + to_string(ns_id) + "] = " + name; }
        return "Error: cannot set hostname";
    }
    if str_starts_with(cmd, "ns enter ") {
        let args = str_sub(cmd, 9, len(cmd));
        let sp = str_find(args, " ");
        if sp < 0 { return "Usage: ns enter <task_idx> <ns_id>"; }
        let tidx  = parse_int(str_sub(args, 0, sp));
        let ns_id = parse_int(str_sub(args, sp + 1, len(args)));
        let r = ns_enter(tidx, ns_id);
        if r == 0 { return "Task " + to_string(tidx) + " entered ns[" + to_string(ns_id) + "]"; }
        return "Error: ns_enter failed";
    }
    if str_starts_with(cmd, "ns del ") {
        let ns_id = parse_int(str_sub(cmd, 7, len(cmd)));
        let r = ns_destroy(ns_id);
        if r == 0 { return "Destroyed ns[" + to_string(ns_id) + "]"; }
        return "Error: cannot destroy ns[" + to_string(ns_id) + "]";
    }

    if cmd == "pty" {
        return pty_status();
    }
    if cmd == "tcploop" {
        return tcp_loopback_status();
    }
    if cmd == "dnstest" {
        return dns_loopback_status();
    }
    if cmd == "advtest" {
        return advanced_feature_summary();
    }
    if cmd == "sock" {
        return to_string(socket_count) + "/" + to_string(SOCKET_MAX) + " sockets open";
    }
    if cmd == "shm" {
        return shm_status();
    }
    if cmd == "trace" {
        return trace_status();
    }
    if cmd == "hrt" {
        return hrtimer_status();
    }
    if cmd == "sysfs" {
        return sysfs_list(0);
    }
    if cmd == "services" {
        svc_list();
        return "";
    }
    if str_starts_with(cmd, "svc start ") {
        let name = str_sub(cmd, 10, len(cmd));
        svc_start(name);
        return "";
    }
    if str_starts_with(cmd, "svc stop ") {
        let name = str_sub(cmd, 9, len(cmd));
        svc_stop(name);
        return "";
    }
    if str_starts_with(cmd, "svc status ") {
        let name = str_sub(cmd, 11, len(cmd));
        svc_status(name);
        return "";
    }
    if cmd == "uptime" {
        let ticks = get_ticks();
        let secs = ticks / 100;
        return "up " + to_string(secs / 60) + "m " + to_string(secs % 60) + "s";
    }
    if cmd == "kinfo" {
        hicos_kernel_info();
        return "";
    }
    if cmd == "lsmod" {
        kmod_status();
        return "";
    }
    if cmd == "kmodtest" {
        kmod_selftest();
        return "";
    }
    if cmd == "sysmon" {
        uismon_open();
        return "System Monitor opened";
    }
    if cmd == "files" {
        uifiles_open();
        return "File Manager opened";
    }
    if cmd == "audiotest" {
        ac97_beep(440, 500);
        return "Audio test: 440 Hz 500 ms";
    }
    if cmd == "settings" {
        uisettings_open();
        return "Settings opened";
    }
    if str_starts_with(cmd, "edit ") {
        let path = str_sub(cmd, 5, len(cmd));
        uitxed_open(path);
        return "Editor opened: " + path;
    }
    if cmd == "editor" {
        uitxed_open("");
        return "Editor opened (new file)";
    }
    if cmd == "gpu" {
        if gpu_initialized == 1 {
            print("GPU: " + to_string(gpu_display_w) + "x" + to_string(gpu_display_h) +
                  " fb=0x" + format_hex(gpu_fb_base(), 8) + " [active]");
            print(vesa_dirty_info());
        } else {
            print("GPU: not initialized");
        }
        return "";
    }
    if cmd == "gpu flip" {
        vesa_flip();
        return "GPU: full-screen flip submitted";
    }
    if cmd == "gpu dirty" {
        return vesa_dirty_info();
    }
    if cmd == "ext4" {
        if ext4_ready == 1 {
            print("ext4: mounted  block_size=" + to_string(ext4_block_size) +
                  " inode_size=" + to_string(ext4_inode_size));
            let root_ents = ext4_list_dir(EXT4_ROOT_INODE);
            let mut ri = 0;
            while ri < len(root_ents) {
                print("  " + root_ents[ri][0]);
                ri = ri + 1;
            }
        } else {
            print("ext4: not mounted");
        }
        return "";
    }
    // --- echo with redirect: echo <text> > <path> ---
    if str_starts_with(cmd, "echo ") {
        let rest = str_sub(cmd, 5, len(cmd));
        // Check for > redirect
        let mut redir_pos = 0 - 1;
        let mut gi = 0;
        while gi < len(rest) {
            if str_char_at(rest, gi) == 62 { redir_pos = gi; gi = len(rest); }
            else { gi = gi + 1; }
        }
        if redir_pos >= 0 {
            let text = str_sub(rest, 0, redir_pos - 1);
            let rpath_raw = str_sub(rest, redir_pos + 1, len(rest));
            let mut rpath = rpath_raw;
            if len(rpath_raw) > 0 {
                if str_char_at(rpath_raw, 0) == 32 { rpath = str_sub(rpath_raw, 1, len(rpath_raw)); }
            }
            let wfd = vfs_open(rpath, 577);  // O_CREAT|O_WRONLY|O_TRUNC
            if wfd < 0 { return "Error: cannot write to " + rpath; }
            vfs_write(wfd, text, len(text));
            vfs_close(wfd);
            return "";
        }
        return rest;
    }
    // --- inotify: show inotify subsystem status ---
    if cmd == "inotify" {
        let ic = inotify_inst_count;
        let wc = watch_count;
        let qc = evt_count;
        print("inotify: instances=" + to_string(ic) + " watches=" + to_string(wc) + " queued_events=" + to_string(qc));
        return "";
    }
    if cmd == "pty" {
        print(pty_status());
        return "";
    }
    if str_starts_with(cmd, "pty ") {
        let ptycmd = str_sub(cmd, 4, len(cmd));
        if ptycmd == "alloc" {
            let pair = pty_open_pair();
            print("PTY allocated: id=" + to_string(pair[2]) + " mfd=" + to_string(pair[0]) + " sfd=" + to_string(pair[1]));
            return "";
        }
        if str_starts_with(ptycmd, "info ") {
            let pid_s = str_sub(ptycmd, 5, len(ptycmd));
            print(pty_info(parse_int(pid_s)));
            return "";
        }
        return "Usage: pty | pty alloc | pty info <id>";
    }
    // --- watch <path>: add inotify watch and show events ---
    if str_starts_with(cmd, "watch ") {
        let wpath = str_sub(cmd, 6, len(cmd));
        let inst = sys_inotify_init();
        sys_inotify_add_watch(inst, wpath, 4095);
        print("Watching: " + wpath + "  (inst=" + to_string(inst) + ", sampling 10 polls)");
        let mut wdone = 0;
        let mut wpoll = 0;
        while wdone == 0 {
            let evts = sys_inotify_read(inst);
            let mut ei = 0;
            while ei + 1 < len(evts) {
                let emask = evts[ei];
                let ename = evts[ei + 1];
                print("EVENT mask=" + to_string(emask) + " name=" + ename);
                ei = ei + 2;
            }
            wpoll = wpoll + 1;
            if wpoll >= 10 { wdone = 1; }
        }
        sys_inotify_close(inst);
        return "";
    }
    if cmd == "fm" || cmd == "fileman" {
        // Open graphical file manager window
        uifiles_init();
        let win_id = uifiles_open();
        if win_id < 0 {
            return "Failed to open file manager";
        }
        return "File manager opened (window " + to_string(win_id) + ")";
    }
    return shell_handle(cmd);
}

// Self-test
print(shell_handle("help"));
print(shell_handle("ver"));
print(shell_handle("free"));
print(shell_handle("hilbert"));
print(shell_handle("fib 10"));
print(shell_handle("ps"));
print(shell_handle_ext("whoami"));
print("shell.hl loaded -- 160 commands + pipe(|) + echo>redirect + inotify + pty + audio + aus + gpu + cp/mv + ns + seccomp + ctr + clipboard + overlay + httpd + calc + paint + json + ws");

// Main shell loop (called from kernel_init)

// Handle pipe: "cmd1 | cmd2" — execute cmd1, pass result to cmd2
fn shell_handle_pipe(pipeline) {
    // Find | separator
    let mut pipe_pos = 0 - 1;
    let mut i = 0;
    while i < len(pipeline) {
        if str_char_at(pipeline, i) == 124 {  // '|' = ASCII 124
            pipe_pos = i;
            i = len(pipeline); // break
        } else {
            i = i + 1;
        }
    }
    if pipe_pos < 0 { return ""; }  // no pipe found

    let cmd1 = str_sub(pipeline, 0, pipe_pos - 1);
    let cmd2_raw = str_sub(pipeline, pipe_pos + 1, len(pipeline));
    // Trim leading space from cmd2
    let mut cmd2 = cmd2_raw;
    if len(cmd2_raw) > 0 {
        if str_char_at(cmd2_raw, 0) == 32 { cmd2 = str_sub(cmd2_raw, 1, len(cmd2_raw)); }
    }

    // Execute left side
    let mut left = shell_handle(cmd1);
    if left == "" { left = shell_handle_ext(cmd1); }

    // Execute right side with left as context
    if cmd2 == "wc" {
        // Count lines, words, chars
        let mut lines = 0;
        let mut words = 0;
        let mut in_word = 0;
        let mut ci = 0;
        while ci < len(left) {
            let ch = str_char_at(left, ci);
            if ch == 10 { lines = lines + 1; }
            if ch == 32 || ch == 9 || ch == 10 {
                in_word = 0;
            } else {
                if in_word == 0 { words = words + 1; }
                in_word = 1;
            }
            ci = ci + 1;
        }
        return to_string(lines) + " " + to_string(words) + " " + to_string(len(left));
    }

    if str_starts_with(cmd2, "grep ") {
        let pattern = str_sub(cmd2, 5, len(cmd2));
        // Split left by newline, filter lines containing pattern
        let mut out = "";
        let mut line = "";
        let mut ci = 0;
        while ci < len(left) {
            let ch = str_char_at(left, ci);
            if ch == 10 {
                if str_starts_with(line, pattern) || _str_contains(line, pattern) {
                    out = out + line + "\n";
                }
                line = "";
            } else {
                line = line + str_from_code(ch);
            }
            ci = ci + 1;
        }
        if len(line) > 0 {
            if _str_contains(line, pattern) { out = out + line; }
        }
        return out;
    }

    if cmd2 == "head" {
        // Return first 10 lines
        let mut out = "";
        let mut line = "";
        let mut count = 0;
        let mut ci = 0;
        while ci < len(left) {
            let ch = str_char_at(left, ci);
            if ch == 10 {
                out = out + line + "\n";
                line = "";
                count = count + 1;
                if count >= 10 { ci = len(left); }  // break
            } else {
                line = line + str_from_code(ch);
            }
            ci = ci + 1;
        }
        return out;
    }

    if cmd2 == "tail" {
        // Return last 10 lines
        let mut lines = [];
        let mut line = "";
        let mut ci = 0;
        while ci < len(left) {
            let ch = str_char_at(left, ci);
            if ch == 10 {
                push(lines, line);
                line = "";
            } else {
                line = line + str_from_code(ch);
            }
            ci = ci + 1;
        }
        if len(line) > 0 { push(lines, line); }
        let start = 0;
        if len(lines) > 10 { start = len(lines) - 10; }
        let mut out = "";
        let mut i = start;
        while i < len(lines) {
            out = out + lines[i] + "\n";
            i = i + 1;
        }
        return out;
    }

    // Unknown right side: just return left result
    return left;
}

// Helper: check if haystack contains needle (simple linear search)
fn _str_contains(haystack, needle) {
    if len(needle) == 0 { return 1; }
    if len(needle) > len(haystack) { return 0; }
    let limit = len(haystack) - len(needle);
    let mut i = 0;
    while i <= limit {
        if str_sub(haystack, i, i + len(needle)) == needle { return 1; }
        i = i + 1;
    }
    return 0;
}

fn shell_main() {
    let mut running = 1;
    while running == 1 {
        // Read line from serial input (poll keyboard buffer)
        let key_ready = mem_read_u64(3145744); // 0x300010
        if key_ready != 0 {
            let scancode = mem_read_u64(3145736); // 0x300008
            mem_write_u64(3145744, 0); // clear flag
            let ch = scancode % 256;
            // Enter key (0x0D or 0x0A)
            if ch == 13 || ch == 10 {
                let cmd = mem_read_string(3145760, 256); // 0x300020 input buffer
                if cmd == "shutdown" || cmd == "exit" {
                    running = 0;
                } else {
                    let mut result = "";
                    // Check for pipe operator
                    if _str_contains(cmd, " | ") {
                        result = shell_handle_pipe(cmd);
                    } else {
                        result = shell_handle(cmd);
                        if result == "" { result = shell_handle_ext(cmd); }
                    }
                    serial_print(result);
                    serial_print("HicOS> ");
                }
                // Clear input buffer
                mem_write_u8(3145760, 0);
            }
        }
    }
    serial_print("Shell exited.");
    return 0;
}
