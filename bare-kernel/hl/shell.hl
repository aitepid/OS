    // ── dc_dp (iter 330) ─────────────────────────────────────────────────────
    if cmd == "dcdp init"  { dc_init(); return "dcdp: init"; }
    if cmd == "dcdp test"  { let dcr = dc_test(); return "dcdp: " + to_string(dcr); }
    if cmd == "dcdp n"     { return "dcdp: n=" + to_string(dc_n); }
    if _starts_with(cmd, "dcdp prev ") {
        let dc_pv  = str_sub(cmd, 10, len(cmd));
        let dc_pi  = to_int(dc_pv);
        let dc_pval = to_int(str_sub(dc_pv, 2, len(dc_pv)));
        set_at(dc_prev, dc_pi, dc_pval);
        return "dcdp: prev[" + to_string(dc_pi) + "]=" + to_string(dc_pval);
    }
    if _starts_with(cmd, "dcdp run ") {
        let dc_rn = to_int(str_sub(cmd, 9, len(cmd)));
        let dc_rv = dc_run(dc_rn);
        return "dcdp: run n=" + to_string(dc_rn) + " dp[n-1]=" + to_string(dc_rv);
    }
    if _starts_with(cmd, "dcdp dp ") {
        let dc_di = to_int(str_sub(cmd, 8, len(cmd)));
        return "dcdp: dp[" + to_string(dc_di) + "]=" + to_string(dc_dp[dc_di]);
    }

    // ── monotone_queue (iter 331) ────────────────────────────────────────────
    if cmd == "mq init"      { mq_init(); return "mq: init"; }
    if cmd == "mq test"      { let mqr = mq_test(); return "mq: " + to_string(mqr); }
    if cmd == "mq n"         { return "mq: n=" + to_string(mq_n); }
    if _starts_with(cmd, "mq k ") {
        mq_k = to_int(str_sub(cmd, 5, len(cmd)));
        return "mq: k=" + to_string(mq_k);
    }
    if _starts_with(cmd, "mq set ") {
        let mq_sv  = str_sub(cmd, 7, len(cmd));
        let mq_si  = to_int(mq_sv);
        let mq_sv2 = to_int(str_sub(mq_sv, 2, len(mq_sv)));
        set_at(mq_data, mq_si, mq_sv2);
        return "mq: data[" + to_string(mq_si) + "]=" + to_string(mq_sv2);
    }
    if _starts_with(cmd, "mq slide_min ") {
        let mq_sn = to_int(str_sub(cmd, 13, len(cmd)));
        mq_n = mq_sn;
        mq_slide_min(mq_sn, mq_k);
        return "mq: slide_min n=" + to_string(mq_sn) + " k=" + to_string(mq_k);
    }
    if _starts_with(cmd, "mq slide_max ") {
        let mq_sn = to_int(str_sub(cmd, 13, len(cmd)));
        mq_n = mq_sn;
        mq_slide_max(mq_sn, mq_k);
        return "mq: slide_max n=" + to_string(mq_sn) + " k=" + to_string(mq_k);
    }
    if _starts_with(cmd, "mq min ") {
        let mq_qi = to_int(str_sub(cmd, 7, len(cmd)));
        return "mq: min[" + to_string(mq_qi) + "]=" + to_string(mq_min_res[mq_qi]);
    }
    if _starts_with(cmd, "mq max ") {
        let mq_qi = to_int(str_sub(cmd, 7, len(cmd)));
        return "mq: max[" + to_string(mq_qi) + "]=" + to_string(mq_max_res[mq_qi]);
    }

    // ── seg_beats (iter 332) ─────────────────────────────────────────────────
    if cmd == "sb init"    { sb_init(); return "sb: init"; }
    if cmd == "sb test"    { let sbr = sb_test(); return "sb: " + to_string(sbr); }
    if cmd == "sb n"       { return "sb: n=" + to_string(sb_n); }
    if _starts_with(cmd, "sb set ") {
        let sb_sv  = str_sub(cmd, 7, len(cmd));
        let sb_si  = to_int(sb_sv);
        let sb_sv2 = to_int(str_sub(sb_sv, 2, len(sb_sv)));
        set_at(sb_data, sb_si, sb_sv2);
        return "sb: data[" + to_string(sb_si) + "]=" + to_string(sb_sv2);
    }
    if _starts_with(cmd, "sb build ") {
        let sb_bn = to_int(str_sub(cmd, 9, len(cmd)));
        sb_build(sb_bn);
        return "sb: built n=" + to_string(sb_bn);
    }
    if _starts_with(cmd, "sb chmin ") {
        let sb_cs  = str_sub(cmd, 9, len(cmd));
        let sb_cl  = to_int(sb_cs);
        let sb_cr  = to_int(str_sub(sb_cs, 2, len(sb_cs)));
        let sb_cv  = to_int(str_sub(sb_cs, 4, len(sb_cs)));
        sb_chmin(sb_cl, sb_cr, sb_cv);
        return "sb: chmin [" + to_string(sb_cl) + "," + to_string(sb_cr) + "] val=" + to_string(sb_cv);
    }
    if _starts_with(cmd, "sb query ") {
        let sb_qs  = str_sub(cmd, 9, len(cmd));
        let sb_ql  = to_int(sb_qs);
        let sb_qr  = to_int(str_sub(sb_qs, 2, len(sb_qs)));
        return "sb: sum[" + to_string(sb_ql) + ".." + to_string(sb_qr) + "]=" + to_string(sb_query(sb_ql, sb_qr));
    }

    // ── link_cut_tree (iter 333) ─────────────────────────────────────────────
    if _starts_with(cmd, "lk init ") {
        let lk_in = to_int(str_sub(cmd, 8, len(cmd)));
        lk_init(lk_in);
        return "lk: init n=" + to_string(lk_in);
    }
    if cmd == "lk test" { let lkr = lk_test(); return "lk: " + to_string(lkr); }
    if cmd == "lk n"    { return "lk: n=" + to_string(lk_n); }
    if _starts_with(cmd, "lk link ") {
        let lk_ls  = str_sub(cmd, 8, len(cmd));
        let lk_lu  = to_int(lk_ls);
        let lk_lv  = to_int(str_sub(lk_ls, 2, len(lk_ls)));
        lk_link(lk_lu, lk_lv);
        return "lk: linked " + to_string(lk_lu) + "-" + to_string(lk_lv);
    }
    if _starts_with(cmd, "lk cut ") {
        let lk_cs  = str_sub(cmd, 7, len(cmd));
        let lk_cu  = to_int(lk_cs);
        let lk_cv  = to_int(str_sub(lk_cs, 2, len(lk_cs)));
        lk_cut(lk_cu, lk_cv);
        return "lk: cut " + to_string(lk_cu) + "-" + to_string(lk_cv);
    }
    if _starts_with(cmd, "lk conn ") {
        let lk_ks  = str_sub(cmd, 8, len(cmd));
        let lk_ku  = to_int(lk_ks);
        let lk_kv  = to_int(str_sub(lk_ks, 2, len(lk_ks)));
        return "lk: connected=" + to_string(lk_connected(lk_ku, lk_kv));
    }
    if _starts_with(cmd, "lk path ") {
        let lk_ps  = str_sub(cmd, 8, len(cmd));
        let lk_pu  = to_int(lk_ps);
        let lk_pv  = to_int(str_sub(lk_ps, 2, len(lk_ps)));
        return "lk: pathsum=" + to_string(lk_pathsum(lk_pu, lk_pv));
    }
    if _starts_with(cmd, "lk val ") {
        let lk_vs  = str_sub(cmd, 7, len(cmd));
        let lk_vi  = to_int(lk_vs);
        let lk_vv  = to_int(str_sub(lk_vs, 2, len(lk_vs)));
        set_at(lk_val, lk_vi, lk_vv);
        set_at(lk_sum, lk_vi, lk_vv);
        return "lk: val[" + to_string(lk_vi) + "]=" + to_string(lk_vv);
    }
    if _starts_with(cmd, "lk root ") {
        let lk_rv = to_int(str_sub(cmd, 8, len(cmd)));
        return "lk: root=" + to_string(lk_findroot(lk_rv));
    }

    // ── quickselect (iter 334) ───────────────────────────────────────────────
    if cmd == "qs init"  { qs_n = 0; return "qs: init"; }
    if cmd == "qs test"  { let qsr = qs_test(); return "qs: " + to_string(qsr); }
    if _starts_with(cmd, "qs n ") {
        qs_n = to_int(str_sub(cmd, 5, len(cmd)));
        return "qs: n=" + to_string(qs_n);
    }
    if _starts_with(cmd, "qs set ") {
        let qs_ss = str_sub(cmd, 7, len(cmd));
        let qs_si = to_int(qs_ss);
        let qs_sv = to_int(str_sub(qs_ss, 2, len(qs_ss)));
        set_at(qs_data, qs_si, qs_sv);
        return "qs: data[" + to_string(qs_si) + "]=" + to_string(qs_sv);
    }
    if _starts_with(cmd, "qs kth ") {
        let qs_k = to_int(str_sub(cmd, 7, len(cmd)));
        return "qs: kth(" + to_string(qs_k) + ")=" + to_string(qs_kth(qs_k));
    }
    if cmd == "qs sort" { qs_sort(); return "qs: sorted"; }
    if _starts_with(cmd, "qs get ") {
        let qs_gi = to_int(str_sub(cmd, 7, len(cmd)));
        return "qs: data[" + to_string(qs_gi) + "]=" + to_string(qs_data[qs_gi]);
    }

    // ── ntt (iter 335) ──────────────────────────────────────────────────────
    if cmd == "ntt init" {
        let ni = 0;
        while ni < NTT_MAX { set_at(ntt_a, ni, 0); set_at(ntt_b, ni, 0); set_at(ntt_c, ni, 0); ni += 1; }
        ntt_rn = 0;
        return "ntt: init";
    }
    if cmd == "ntt test" { let ntr = ntt_test(); return "ntt: " + to_string(ntr); }
    if _starts_with(cmd, "ntt n ") {
        ntt_rn = to_int(str_sub(cmd, 6, len(cmd)));
        return "ntt: rn=" + to_string(ntt_rn);
    }
    if _starts_with(cmd, "ntt a ") {
        let ntt_as = str_sub(cmd, 6, len(cmd));
        let ntt_ai = to_int(ntt_as);
        let ntt_av = to_int(str_sub(ntt_as, 2, len(ntt_as)));
        set_at(ntt_a, ntt_ai, ntt_av);
        return "ntt: a[" + to_string(ntt_ai) + "]=" + to_string(ntt_av);
    }
    if _starts_with(cmd, "ntt b ") {
        let ntt_bs = str_sub(cmd, 6, len(cmd));
        let ntt_bi = to_int(ntt_bs);
        let ntt_bv = to_int(str_sub(ntt_bs, 2, len(ntt_bs)));
        set_at(ntt_b, ntt_bi, ntt_bv);
        return "ntt: b[" + to_string(ntt_bi) + "]=" + to_string(ntt_bv);
    }
    if _starts_with(cmd, "ntt mul ") {
        let ntt_ms = str_sub(cmd, 8, len(cmd));
        let ntt_mna = to_int(ntt_ms);
        let ntt_mnb = to_int(str_sub(ntt_ms, 2, len(ntt_ms)));
        let ntt_nc = ntt_multiply(ntt_mna, ntt_mnb);
        return "ntt: mul na=" + to_string(ntt_mna) + " nb=" + to_string(ntt_mnb) + " nc=" + to_string(ntt_nc);
    }
    if _starts_with(cmd, "ntt c ") {
        let ntt_ci = to_int(str_sub(cmd, 6, len(cmd)));
        return "ntt: c[" + to_string(ntt_ci) + "]=" + to_string(ntt_c[ntt_ci]);
    }

    // ── seg_merge (iter 336) ─────────────────────────────────────────────────
    if cmd == "sm init"  { sm_cnt = 1; set_at(sm_roots, 0, 0); set_at(sm_roots, 1, 0); return "sm: init"; }
    if cmd == "sm test"  { let smr = sm_test(); return "sm: " + to_string(smr); }
    if cmd == "sm cnt"   { return "sm: cnt=" + to_string(sm_cnt); }
    if _starts_with(cmd, "sm update ") {
        let sm_us  = str_sub(cmd, 10, len(cmd));
        let sm_uri = to_int(sm_us);
        let sm_us2 = str_sub(sm_us, 2, len(sm_us));
        let sm_upo = to_int(sm_us2);
        let sm_uva = to_int(str_sub(sm_us2, 2, len(sm_us2)));
        let sm_nr  = sm_update(sm_roots[sm_uri], 0, SM_XMAX - 1, sm_upo, sm_uva);
        set_at(sm_roots, sm_uri, sm_nr);
        return "sm: updated root[" + to_string(sm_uri) + "] pos=" + to_string(sm_upo);
    }
    if _starts_with(cmd, "sm query ") {
        let sm_qs  = str_sub(cmd, 9, len(cmd));
        let sm_qri = to_int(sm_qs);
        let sm_qs2 = str_sub(sm_qs, 2, len(sm_qs));
        let sm_ql  = to_int(sm_qs2);
        let sm_qr  = to_int(str_sub(sm_qs2, 2, len(sm_qs2)));
        return "sm: query root[" + to_string(sm_qri) + "] [" + to_string(sm_ql) + ".." + to_string(sm_qr) + "]=" + to_string(sm_query(sm_roots[sm_qri], 0, SM_XMAX - 1, sm_ql, sm_qr));
    }
    if _starts_with(cmd, "sm merge ") {
        let sm_ms  = str_sub(cmd, 9, len(cmd));
        let sm_mu  = to_int(sm_ms);
        let sm_mv  = to_int(str_sub(sm_ms, 2, len(sm_ms)));
        let sm_mr  = sm_merge(sm_roots[sm_mu], sm_roots[sm_mv], 0, SM_XMAX - 1);
        set_at(sm_roots, sm_mu, sm_mr);
        return "sm: merged root[" + to_string(sm_mu) + "] <- root[" + to_string(sm_mv) + "]";
    }
    if _starts_with(cmd, "sm root ") {
        let sm_ri = to_int(str_sub(cmd, 8, len(cmd)));
        return "sm: root[" + to_string(sm_ri) + "]=" + to_string(sm_roots[sm_ri]);
    }

    // ── palindrome_dp (iter 337) ─────────────────────────────────────────────
    if cmd == "pl init"  { pl_init(); return "pl: init"; }
    if cmd == "pl test"  { let plr = pl_test(); return "pl: " + to_string(plr); }
    if _starts_with(cmd, "pl n ") {
        pl_n = to_int(str_sub(cmd, 5, len(cmd)));
        return "pl: n=" + to_string(pl_n);
    }
    if _starts_with(cmd, "pl set ") {
        let pl_ss = str_sub(cmd, 7, len(cmd));
        let pl_si = to_int(pl_ss);
        let pl_sv = to_int(str_sub(pl_ss, 2, len(pl_ss)));
        set_at(pl_s, pl_si, pl_sv);
        return "pl: s[" + to_string(pl_si) + "]=" + to_string(pl_sv);
    }
    if _starts_with(cmd, "pl build ") {
        let pl_bn = to_int(str_sub(cmd, 9, len(cmd)));
        pl_build(pl_bn);
        return "pl: built n=" + to_string(pl_bn);
    }
    if _starts_with(cmd, "pl pal ") {
        let pl_ps = str_sub(cmd, 7, len(cmd));
        let pl_pi = to_int(pl_ps);
        let pl_pj = to_int(str_sub(pl_ps, 2, len(pl_ps)));
        return "pl: pal[" + to_string(pl_pi) + ".." + to_string(pl_pj) + "]=" + to_string(pl_pal(pl_pi, pl_pj));
    }
    if cmd == "pl cuts" { return "pl: min_cuts=" + to_string(pl_min_cuts()); }

    // ── knuth_dp (iter 338) ──────────────────────────────────────────────────
    if cmd == "kn init"  { kn_init(); return "kn: init"; }
    if cmd == "kn test"  { let knr = kn_test(); return "kn: " + to_string(knr); }
    if _starts_with(cmd, "kn n ") {
        kn_n = to_int(str_sub(cmd, 5, len(cmd)));
        return "kn: n=" + to_string(kn_n);
    }
    if _starts_with(cmd, "kn set ") {
        let kn_ss = str_sub(cmd, 7, len(cmd));
        let kn_si = to_int(kn_ss);
        let kn_sv = to_int(str_sub(kn_ss, 2, len(kn_ss)));
        set_at(kn_w, kn_si, kn_sv);
        return "kn: w[" + to_string(kn_si) + "]=" + to_string(kn_sv);
    }
    if _starts_with(cmd, "kn build ") {
        let kn_bn = to_int(str_sub(cmd, 9, len(cmd)));
        kn_build(kn_bn);
        return "kn: built n=" + to_string(kn_bn);
    }
    if _starts_with(cmd, "kn dp ") {
        let kn_ds = str_sub(cmd, 6, len(cmd));
        let kn_di = to_int(kn_ds);
        let kn_dj = to_int(str_sub(kn_ds, 2, len(kn_ds)));
        return "kn: dp[" + to_string(kn_di) + "][" + to_string(kn_dj) + "]=" + to_string(kn_dp_get(kn_di, kn_dj));
    }
    if cmd == "kn cost" { return "kn: cost=" + to_string(kn_cost()); }

    // ── bitset_ops (iter 339) ────────────────────────────────────────────────
    if cmd == "bts init"  { bts_init(); return "bts: init"; }
    if cmd == "bts test"  { let btsr = bts_run_test(); return "bts: " + to_string(btsr); }
    if _starts_with(cmd, "bts set ") {
        let bts_si = to_int(str_sub(cmd, 8, len(cmd)));
        bts_set(bts_si);
        return "bts: set bit " + to_string(bts_si);
    }
    if _starts_with(cmd, "bts clear ") {
        let bts_ci = to_int(str_sub(cmd, 10, len(cmd)));
        bts_clear(bts_ci);
        return "bts: cleared bit " + to_string(bts_ci);
    }
    if _starts_with(cmd, "bts get ") {
        let bts_gi = to_int(str_sub(cmd, 8, len(cmd)));
        return "bts: bit[" + to_string(bts_gi) + "]=" + to_string(bts_get(bts_gi));
    }
    if cmd == "bts count" { return "bts: count=" + to_string(bts_count()); }
    if cmd == "bts and"   { bts_and_a(); return "bts: a &= b done"; }
    if cmd == "bts or"    { bts_or_a();  return "bts: a |= b done"; }

    // ── miller_rabin (iter 340) ──────────────────────────────────────────────
    if cmd == "mr init"   { mr_init(); return "mr: init"; }
    if cmd == "mr test"   { let mrr = mr_test(); return "mr: " + to_string(mrr); }
    if _starts_with(cmd, "mr prime ") {
        let n = to_int(str_sub(cmd, 9, len(cmd)));
        return "mr: is_prime(" + to_string(n) + ")=" + to_string(mr_is_prime(n));
    }
    if _starts_with(cmd, "mr next ") {
        let n = to_int(str_sub(cmd, 8, len(cmd)));
        return "mr: next_prime(" + to_string(n) + ")=" + to_string(mr_next_prime(n));
    }
    if _starts_with(cmd, "mr count ") {
        let lim = to_int(str_sub(cmd, 9, len(cmd)));
        return "mr: count_primes(" + to_string(lim) + ")=" + to_string(mr_count_primes(lim));
    }
    if _starts_with(cmd, "mr wit ") {
        let i = to_int(str_sub(cmd, 7, len(cmd)));
        return "mr: wit[" + to_string(i) + "]=" + to_string(mr_wit[i]);
    }
    if cmd == "mr nwits"  { return "mr: nwits=" + to_string(MR_WITS); }

    // ── pollard_rho (iter 341) ───────────────────────────────────────────────
    if cmd == "pr init"   { pr_init(); return "pr: init"; }
    if cmd == "pr test"   { let prr = pr_test(); return "pr: " + to_string(prr); }
    if _starts_with(cmd, "pr factor ") {
        let n = to_int(str_sub(cmd, 10, len(cmd)));
        return "pr: factor(" + to_string(n) + ")=" + to_string(pr_factor(n));
    }
    if _starts_with(cmd, "pr factorize ") {
        let n = to_int(str_sub(cmd, 13, len(cmd)));
        let cnt = pr_factorize(n);
        return "pr: factorize(" + to_string(n) + ")=" + to_string(cnt) + " factors";
    }
    if cmd == "pr product" { return "pr: product=" + to_string(pr_product()); }
    if cmd == "pr fcount"  { return "pr: fcount=" + to_string(pr_fcount); }
    if _starts_with(cmd, "pr get ") {
        let i = to_int(str_sub(cmd, 7, len(cmd)));
        return "pr: factors[" + to_string(i) + "]=" + to_string(pr_factors[i]);
    }

    // ── linear_basis (iter 342) ──────────────────────────────────────────────
    if cmd == "lb init"   { lb_init(); return "lb: init"; }
    if cmd == "lb test"   { let lbr = lb_test(); return "lb: " + to_string(lbr); }
    if _starts_with(cmd, "lb insert ") {
        let x = to_int(str_sub(cmd, 10, len(cmd)));
        let dep = lb_insert(x);
        return "lb: insert(" + to_string(x) + ")=" + to_string(dep);
    }
    if cmd == "lb max"    { return "lb: max_xor=" + to_string(lb_query_max()); }
    if cmd == "lb size"   { return "lb: size=" + to_string(lb_size()); }
    if _starts_with(cmd, "lb get ") {
        let i = to_int(str_sub(cmd, 7, len(cmd)));
        return "lb: basis[" + to_string(i) + "]=" + to_string(lb_basis[i]);
    }
    if cmd == "lb clear"  { lb_init(); return "lb: cleared"; }

    // ── geometry_2d (iter 343) ───────────────────────────────────────────────
    if cmd == "g2 init"  { g2_init(); return "g2: init"; }
    if cmd == "g2 test"  { let g2r = g2_test(); return "g2: " + to_string(g2r); }
    if cmd == "g2 area"  { return "g2: area2=" + to_string(g2_area2()); }
    if cmd == "g2 n"     { return "g2: n=" + to_string(g2_n); }
    if _starts_with(cmd, "g2 add ") {
        let g2args = str_sub(cmd, 7, len(cmd));
        let g2sp = _find_space(g2args);
        if g2sp < 0 { return "g2 add: usage g2 add <x> <y>"; }
        let g2x = to_int(str_sub(g2args, 0, g2sp));
        let g2y = to_int(str_sub(g2args, g2sp + 1, len(g2args)));
        let g2r = g2_add(g2x, g2y);
        return "g2: added (" + to_string(g2x) + "," + to_string(g2y) + ") n=" + to_string(g2r);
    }
    if _starts_with(cmd, "g2 pip ") {
        let g2pargs = str_sub(cmd, 7, len(cmd));
        let g2psp = _find_space(g2pargs);
        if g2psp < 0 { return "g2 pip: usage g2 pip <x> <y>"; }
        let g2px = to_int(str_sub(g2pargs, 0, g2psp));
        let g2py = to_int(str_sub(g2pargs, g2psp + 1, len(g2pargs)));
        return "g2: pip(" + to_string(g2px) + "," + to_string(g2py) + ")=" + to_string(g2_pip(g2px, g2py));
    }
    if _starts_with(cmd, "g2 cross ") {
        let g2cargs = str_sub(cmd, 9, len(cmd));
        let g2cs1 = _find_space(g2cargs);
        if g2cs1 < 0 { return "g2 cross: usage g2 cross <ax> <ay> <bx> <by>"; }
        let g2ax = to_int(str_sub(g2cargs, 0, g2cs1));
        let g2cr1 = str_sub(g2cargs, g2cs1 + 1, len(g2cargs));
        let g2cs2 = _find_space(g2cr1);
        if g2cs2 < 0 { return "g2 cross: usage g2 cross <ax> <ay> <bx> <by>"; }
        let g2ay = to_int(str_sub(g2cr1, 0, g2cs2));
        let g2cr2 = str_sub(g2cr1, g2cs2 + 1, len(g2cr1));
        let g2cs3 = _find_space(g2cr2);
        if g2cs3 < 0 { return "g2 cross: usage g2 cross <ax> <ay> <bx> <by>"; }
        let g2bx = to_int(str_sub(g2cr2, 0, g2cs3));
        let g2by = to_int(str_sub(g2cr2, g2cs3 + 1, len(g2cr2)));
        return "g2: cross=" + to_string(g2_cross(g2ax, g2ay, g2bx, g2by));
    }

    // ── rotating_calipers (iter 344) ─────────────────────────────────────────
    if cmd == "rc init"  { rc_init(); return "rc: init"; }
    if cmd == "rc test"  { let rcr = rc_test(); return "rc: " + to_string(rcr); }
    if cmd == "rc diam"  { return "rc: diameter2=" + to_string(rc_diameter2()); }
    if cmd == "rc mbr"   { return "rc: mbr_area=" + to_string(rc_mbr_area()); }
    if _starts_with(cmd, "rc setn ") {
        let rcn = to_int(str_sub(cmd, 8, len(cmd)));
        rc_setn(rcn);
        return "rc: n=" + to_string(rc_n);
    }
    if _starts_with(cmd, "rc get ") {
        let rci = to_int(str_sub(cmd, 7, len(cmd)));
        return "rc: [" + to_string(rci) + "]=(" + to_string(rc_px[rci]) + "," + to_string(rc_py[rci]) + ")";
    }
    if _starts_with(cmd, "rc set ") {
        let rcargs = str_sub(cmd, 7, len(cmd));
        let rcsp1 = _find_space(rcargs);
        if rcsp1 < 0 { return "rc set: usage rc set <i> <x> <y>"; }
        let rci = to_int(str_sub(rcargs, 0, rcsp1));
        let rcrem = str_sub(rcargs, rcsp1 + 1, len(rcargs));
        let rcsp2 = _find_space(rcrem);
        if rcsp2 < 0 { return "rc set: usage rc set <i> <x> <y>"; }
        let rcx = to_int(str_sub(rcrem, 0, rcsp2));
        let rcy = to_int(str_sub(rcrem, rcsp2 + 1, len(rcrem)));
        rc_set(rci, rcx, rcy);
        return "rc: set[" + to_string(rci) + "]=(" + to_string(rcx) + "," + to_string(rcy) + ")";
    }

    // ── half_plane (iter 345) ────────────────────────────────────────────────
    if cmd == "hp init"  { hp_init(); return "hp: init"; }
    if cmd == "hp test"  { let hpr = hp_test(); return "hp: " + to_string(hpr); }
    if cmd == "hp clip"  { let hpn = hp_clip_all(); return "hp: clipped n=" + to_string(hpn); }
    if cmd == "hp area"  { return "hp: area2=" + to_string(hp_area2()); }
    if _starts_with(cmd, "hp inside ") {
        let hpiargs = str_sub(cmd, 10, len(cmd));
        let hpisp = _find_space(hpiargs);
        if hpisp < 0 { return "hp inside: usage hp inside <px> <py>"; }
        let hpipx = to_int(str_sub(hpiargs, 0, hpisp));
        let hpipy = to_int(str_sub(hpiargs, hpisp + 1, len(hpiargs)));
        return "hp: inside(" + to_string(hpipx) + "," + to_string(hpipy) + ")=" + to_string(hp_inside(hpipx, hpipy));
    }
    if _starts_with(cmd, "hp box ") {
        let hpbargs = str_sub(cmd, 7, len(cmd));
        let hpbs1 = _find_space(hpbargs);
        if hpbs1 < 0 { return "hp box: usage hp box <x0> <y0> <x1> <y1>"; }
        let hpbx0 = to_int(str_sub(hpbargs, 0, hpbs1));
        let hpbr1 = str_sub(hpbargs, hpbs1 + 1, len(hpbargs));
        let hpbs2 = _find_space(hpbr1);
        if hpbs2 < 0 { return "hp box: usage hp box <x0> <y0> <x1> <y1>"; }
        let hpby0 = to_int(str_sub(hpbr1, 0, hpbs2));
        let hpbr2 = str_sub(hpbr1, hpbs2 + 1, len(hpbr1));
        let hpbs3 = _find_space(hpbr2);
        if hpbs3 < 0 { return "hp box: usage hp box <x0> <y0> <x1> <y1>"; }
        let hpbx1 = to_int(str_sub(hpbr2, 0, hpbs3));
        let hpby1 = to_int(str_sub(hpbr2, hpbs3 + 1, len(hpbr2)));
        hp_set_box(hpbx0, hpby0, hpbx1, hpby1);
        return "hp: box set n=4";
    }
    if _starts_with(cmd, "hp add ") {
        let hpaargs = str_sub(cmd, 7, len(cmd));
        let hpas1 = _find_space(hpaargs);
        if hpas1 < 0 { return "hp add: usage hp add <ax> <ay> <bx> <by>"; }
        let hpaax = to_int(str_sub(hpaargs, 0, hpas1));
        let hpar1 = str_sub(hpaargs, hpas1 + 1, len(hpaargs));
        let hpas2 = _find_space(hpar1);
        if hpas2 < 0 { return "hp add: usage hp add <ax> <ay> <bx> <by>"; }
        let hpaay = to_int(str_sub(hpar1, 0, hpas2));
        let hpar2 = str_sub(hpar1, hpas2 + 1, len(hpar1));
        let hpas3 = _find_space(hpar2);
        if hpas3 < 0 { return "hp add: usage hp add <ax> <ay> <bx> <by>"; }
        let hpabx = to_int(str_sub(hpar2, 0, hpas3));
        let hpaby = to_int(str_sub(hpar2, hpas3 + 1, len(hpar2)));
        hp_add_hp(hpaax, hpaay, hpabx, hpaby);
        return "hp: added halfplane hn=" + to_string(hp_hn);
    }

    // ── dinic (iter 346) ────────────────────────────────────────────────────
    if cmd == "di init"  { di_init(); return "di: init"; }
    if cmd == "di test"  { let dir = di_test(); return "di: " + to_string(dir); }
    if cmd == "di ecnt"  { return "di: ecnt=" + to_string(di_ecnt); }
    if _starts_with(cmd, "di add ") {
        let diaargs = str_sub(cmd, 7, len(cmd));
        let diasp1  = _find_space(diaargs);
        let diau    = to_int(str_sub(diaargs, 0, diasp1));
        let diaargs2 = str_sub(diaargs, diasp1 + 1, len(diaargs));
        let diasp2  = _find_space(diaargs2);
        let diav    = to_int(str_sub(diaargs2, 0, diasp2));
        let diacap  = to_int(str_sub(diaargs2, diasp2 + 1, len(diaargs2)));
        di_add_edge(diau, diav, diacap);
        return "di: added " + to_string(diau) + "->" + to_string(diav) + " cap=" + to_string(diacap);
    }
    if _starts_with(cmd, "di flow ") {
        let diflargs = str_sub(cmd, 8, len(cmd));
        let diflsp   = _find_space(diflargs);
        let difls    = to_int(str_sub(diflargs, 0, diflsp));
        let diflt    = to_int(str_sub(diflargs, diflsp + 1, len(diflargs)));
        let diflf    = di_max_flow(difls, diflt);
        return "di: max_flow(" + to_string(difls) + "," + to_string(diflt) + ")=" + to_string(diflf);
    }
    if _starts_with(cmd, "di level ") {
        let dilv = to_int(str_sub(cmd, 9, len(cmd)));
        return "di: level[" + to_string(dilv) + "]=" + to_string(di_level[dilv]);
    }
    if _starts_with(cmd, "di cap ") {
        let dice = to_int(str_sub(cmd, 7, len(cmd)));
        return "di: cap[" + to_string(dice) + "]=" + to_string(di_cap[dice]);
    }

    // ── block_cut_tree (iter 347) ────────────────────────────────────────────
    if cmd == "bct init"    { bct_init(); return "bct: init"; }
    if cmd == "bct test"    { let bctr = bct_test(); return "bct: " + to_string(bctr); }
    if cmd == "bct build"   { bct_build(); return "bct: built n_cut=" + to_string(bct_n_cut) + " n_blocks=" + to_string(bct_n_blocks); }
    if cmd == "bct ncut"    { return "bct: n_cut=" + to_string(bct_n_cut); }
    if cmd == "bct nblocks" { return "bct: n_blocks=" + to_string(bct_n_blocks); }
    if _starts_with(cmd, "bct add ") {
        let bctaargs = str_sub(cmd, 8, len(cmd));
        let bctasp   = _find_space(bctaargs);
        let bctau    = to_int(str_sub(bctaargs, 0, bctasp));
        let bctav    = to_int(str_sub(bctaargs, bctasp + 1, len(bctaargs)));
        bct_add_edge(bctau, bctav);
        return "bct: added " + to_string(bctau) + "-" + to_string(bctav);
    }
    if _starts_with(cmd, "bct iscut ") {
        let bctiv = to_int(str_sub(cmd, 10, len(cmd)));
        return "bct: iscut[" + to_string(bctiv) + "]=" + to_string(bct_is_cut[bctiv]);
    }

    // ── bridge_tree (iter 348) ───────────────────────────────────────────────
    if cmd == "bt init"     { bt_init(); return "bt: init"; }
    if cmd == "bt test"     { let btr = bt_test(); return "bt: " + to_string(btr); }
    if cmd == "bt build"    { bt_build(); return "bt: built n_bridges=" + to_string(bt_n_bridges) + " n_comp=" + to_string(bt_n_comp); }
    if cmd == "bt nbridges" { return "bt: n_bridges=" + to_string(bt_n_bridges); }
    if cmd == "bt ncomp"    { return "bt: n_comp=" + to_string(bt_n_comp); }
    if _starts_with(cmd, "bt add ") {
        let btaargs = str_sub(cmd, 7, len(cmd));
        let btasp   = _find_space(btaargs);
        let btau    = to_int(str_sub(btaargs, 0, btasp));
        let btav    = to_int(str_sub(btaargs, btasp + 1, len(btaargs)));
        bt_add_edge(btau, btav);
        return "bt: added " + to_string(btau) + "-" + to_string(btav);
    }
    if _starts_with(cmd, "bt comp ") {
        let btcv = to_int(str_sub(cmd, 8, len(cmd)));
        return "bt: comp[" + to_string(btcv) + "]=" + to_string(bt_comp[btcv]);
    }

    // ── poly_inv (iter 349) ──────────────────────────────────────────────────
    if cmd == "pinv init"  { pinv_init(); return "pinv: init"; }
    if cmd == "pinv test"  { let pinvr = pinv_test(); return "pinv: " + to_string(pinvr); }
    if _starts_with(cmd, "pinv set ") {
        let pinvsargs = str_sub(cmd, 9, len(cmd));
        let pinvssp   = _find_space(pinvsargs);
        let pinvsi    = to_int(str_sub(pinvsargs, 0, pinvssp));
        let pinvsv    = to_int(str_sub(pinvsargs, pinvssp + 1, len(pinvsargs)));
        set_at(pinv_f, pinvsi, pinvsv);
        return "pinv: f[" + to_string(pinvsi) + "]=" + to_string(pinvsv);
    }
    if _starts_with(cmd, "pinv inv ") {
        let pinvn = to_int(str_sub(cmd, 9, len(cmd)));
        pinv_compute(pinvn);
        return "pinv: computed g=f^-1 mod x^" + to_string(pinvn);
    }
    if _starts_with(cmd, "pinv get ") {
        let pinvgi = to_int(str_sub(cmd, 9, len(cmd)));
        return "pinv: g[" + to_string(pinvgi) + "]=" + to_string(pinv_g[pinvgi]);
    }
    if _starts_with(cmd, "pinv fget ") {
        let pinvfi = to_int(str_sub(cmd, 10, len(cmd)));
        return "pinv: f[" + to_string(pinvfi) + "]=" + to_string(pinv_f[pinvfi]);
    }
    if _starts_with(cmd, "pinv check ") {
        let pinvcn = to_int(str_sub(cmd, 11, len(cmd)));
        let pinvok = 1;
        let pinvk = 0;
        while pinvk < pinvcn {
            let pinvs = 0;
            let pinvi = 0;
            while pinvi <= pinvk {
                pinvs = _pinv_add(pinvs, _pinv_mul(pinv_f[pinvi], pinv_g[pinvk - pinvi]));
                pinvi += 1;
            }
            if pinvk == 0 { if pinvs != 1 { pinvok = 0; } }
            if pinvk > 0  { if pinvs != 0 { pinvok = 0; } }
            pinvk += 1;
        }
        return "pinv: check=" + to_string(pinvok);
    }

    // ── poly_ln_exp (iter 350) ───────────────────────────────────────────────
    if cmd == "ple init" { ple_init(); return "ple: init"; }
    if cmd == "ple test" { let pler = ple_test(); return "ple: " + to_string(pler); }
    if _starts_with(cmd, "ple set ") {
        let plesargs = str_sub(cmd, 8, len(cmd));
        let plessp   = _find_space(plesargs);
        let plesi    = to_int(str_sub(plesargs, 0, plessp));
        let plesv    = to_int(str_sub(plesargs, plessp + 1, len(plesargs)));
        set_at(ple_f, plesi, plesv);
        return "ple: f[" + to_string(plesi) + "]=" + to_string(plesv);
    }
    if _starts_with(cmd, "ple exp ") {
        let pleen = to_int(str_sub(cmd, 8, len(cmd)));
        ple_exp(pleen);
        return "ple: exp computed mod x^" + to_string(pleen);
    }
    if _starts_with(cmd, "ple ln ") {
        let pleln = to_int(str_sub(cmd, 7, len(cmd)));
        ple_ln(pleln);
        return "ple: ln computed mod x^" + to_string(pleln);
    }
    if _starts_with(cmd, "ple get ") {
        let plegi = to_int(str_sub(cmd, 8, len(cmd)));
        return "ple: g[" + to_string(plegi) + "]=" + to_string(ple_g[plegi]);
    }
    if _starts_with(cmd, "ple fget ") {
        let plefi = to_int(str_sub(cmd, 9, len(cmd)));
        return "ple: f[" + to_string(plefi) + "]=" + to_string(ple_f[plefi]);
    }

    // ── poly_sqrt (iter 351) ─────────────────────────────────────────────────
    if cmd == "psq init" { psq_init(); return "psq: init"; }
    if cmd == "psq test" { let psqr = psq_test(); return "psq: " + to_string(psqr); }
    if _starts_with(cmd, "psq set ") {
        let psqsargs = str_sub(cmd, 8, len(cmd));
        let psqssp   = _find_space(psqsargs);
        let psqsi    = to_int(str_sub(psqsargs, 0, psqssp));
        let psqsv    = to_int(str_sub(psqsargs, psqssp + 1, len(psqsargs)));
        set_at(psq_f, psqsi, psqsv);
        return "psq: f[" + to_string(psqsi) + "]=" + to_string(psqsv);
    }
    if _starts_with(cmd, "psq sqrt ") {
        let psqn = to_int(str_sub(cmd, 9, len(cmd)));
        psq_sqrt(psqn);
        return "psq: sqrt computed mod x^" + to_string(psqn);
    }
    if _starts_with(cmd, "psq eval ") {
        let psqeargs = str_sub(cmd, 9, len(cmd));
        let psqesp   = _find_space(psqeargs);
        let psqedeg  = to_int(str_sub(psqeargs, 0, psqesp));
        let psqeval  = to_int(str_sub(psqeargs, psqesp + 1, len(psqeargs)));
        let psqeres  = psq_eval(psqedeg, psqeval);
        return "psq: eval(" + to_string(psqedeg) + "," + to_string(psqeval) + ")=" + to_string(psqeres);
    }
    if _starts_with(cmd, "psq get ") {
        let psqgi = to_int(str_sub(cmd, 8, len(cmd)));
        return "psq: g[" + to_string(psqgi) + "]=" + to_string(psq_g[psqgi]);
    }
    if _starts_with(cmd, "psq fget ") {
        let psqfi = to_int(str_sub(cmd, 9, len(cmd)));
        return "psq: f[" + to_string(psqfi) + "]=" + to_string(psq_f[psqfi]);
    }

    // --- BitmaskDP ---
    if cmd == "bdm init" { bdm_init(); return "bdm: init"; }
    if cmd == "bdm test" { let bdmr = bdm_test(); return "bdm: " + to_string(bdmr); }
    if _starts_with(cmd, "bdm dist ") {
        let bdma = str_sub(cmd, 9, len(cmd));
        let bdms1 = _find_space(bdma);
        let bdmu  = to_int(str_sub(bdma, 0, bdms1));
        let bdma2 = str_sub(bdma, bdms1 + 1, len(bdma));
        let bdms2 = _find_space(bdma2);
        let bdmv  = to_int(str_sub(bdma2, 0, bdms2));
        let bdmw  = to_int(str_sub(bdma2, bdms2 + 1, len(bdma2)));
        bdm_set_dist(bdmu, bdmv, bdmw);
        return "bdm: dist[" + to_string(bdmu) + "][" + to_string(bdmv) + "]=" + to_string(bdmw);
    }
    if cmd == "bdm tsp" { let bdmans = bdm_tsp(); return "bdm: tsp=" + to_string(bdmans); }
    if _starts_with(cmd, "bdm get ") {
        let bdmga = str_sub(cmd, 8, len(cmd));
        let bdmgs = _find_space(bdmga);
        let bdmgm = to_int(str_sub(bdmga, 0, bdmgs));
        let bdmgv = to_int(str_sub(bdmga, bdmgs + 1, len(bdmga)));
        return "bdm: dp[" + to_string(bdmgm) + "][" + to_string(bdmgv) + "]=" + to_string(bdm_get_dp(bdmgm, bdmgv));
    }
    if cmd == "bdm n" { return "bdm: N=" + to_string(BDM_N); }
    if cmd == "bdm full" { return "bdm: FULL=" + to_string(BDM_FULL); }

    // --- DigitDP ---
    if cmd == "ddm init" { ddm_init(); return "ddm: init"; }
    if cmd == "ddm test" { let ddmr = ddm_test(); return "ddm: " + to_string(ddmr); }
    if _starts_with(cmd, "ddm count ") {
        let ddmca = str_sub(cmd, 10, len(cmd));
        let ddmcs = _find_space(ddmca);
        let ddmcn = to_int(str_sub(ddmca, 0, ddmcs));
        let ddmct = to_int(str_sub(ddmca, ddmcs + 1, len(ddmca)));
        let ddmcr = ddm_solve(ddmcn, ddmct);
        return "ddm: count[0.." + to_string(ddmcn) + "] sum=" + to_string(ddmct) + " -> " + to_string(ddmcr);
    }
    if cmd == "ddm nd" { return "ddm: nd=" + to_string(ddm_nd); }
    if _starts_with(cmd, "ddm lim ") {
        let ddmli = to_int(str_sub(cmd, 8, len(cmd)));
        return "ddm: lim[" + to_string(ddmli) + "]=" + to_string(ddm_lim[ddmli]);
    }
    if cmd == "ddm maxs" { return "ddm: MAXS=" + to_string(DDM_MAXS); }
    if cmd == "ddm maxd" { return "ddm: MAXD=" + to_string(DDM_MAXD); }

    // --- BrokenProfileDP ---
    if cmd == "bpd init" { bpd_init(); return "bpd: init"; }
    if cmd == "bpd test" { let bpdr = bpd_test(); return "bpd: " + to_string(bpdr); }
    if _starts_with(cmd, "bpd count ") {
        let bpdcw = to_int(str_sub(cmd, 10, len(cmd)));
        let bpdca = bpd_count(bpdcw);
        return "bpd: 2x" + to_string(bpdcw) + " tilings=" + to_string(bpdca);
    }
    if _starts_with(cmd, "bpd dp ") {
        let bpddm = to_int(str_sub(cmd, 7, len(cmd)));
        return "bpd: dp[" + to_string(bpddm) + "]=" + to_string(bpd_dp[bpddm]);
    }
    if cmd == "bpd h" { return "bpd: H=" + to_string(BPD_H); }
    if cmd == "bpd w" { return "bpd: W=" + to_string(BPD_W); }
    if cmd == "bpd maxmask" { return "bpd: MAXMASK=" + to_string(BPD_MAXMASK); }

    // --- WaveletTree ---
    if cmd == "wvr init" { wvr_init(); return "wvr: init"; }
    if cmd == "wvr test" { let wvrr = wvr_test(); return "wvr: " + to_string(wvrr); }
    if _starts_with(cmd, "wvr set ") {
        let wvrsa = str_sub(cmd, 8, len(cmd));
        let wvrss = _find_space(wvrsa);
        let wvrsi = to_int(str_sub(wvrsa, 0, wvrss));
        let wvrsv = to_int(str_sub(wvrsa, wvrss + 1, len(wvrsa)));
        wvr_set(wvrsi, wvrsv);
        return "wvr: arr[" + to_string(wvrsi) + "]=" + to_string(wvrsv);
    }
    if _starts_with(cmd, "wvr build ") {
        let wvrbn = to_int(str_sub(cmd, 10, len(cmd)));
        wvr_build(wvrbn);
        return "wvr: built n=" + to_string(wvrbn);
    }
    if _starts_with(cmd, "wvr kth ") {
        let wvrka  = str_sub(cmd, 8, len(cmd));
        let wvrks1 = _find_space(wvrka);
        let wvrkql = to_int(str_sub(wvrka, 0, wvrks1));
        let wvrka2 = str_sub(wvrka, wvrks1 + 1, len(wvrka));
        let wvrks2 = _find_space(wvrka2);
        let wvrkqr = to_int(str_sub(wvrka2, 0, wvrks2));
        let wvrkk  = to_int(str_sub(wvrka2, wvrks2 + 1, len(wvrka2)));
        let wvrkr  = wvr_kth(wvrkql, wvrkqr, wvrkk);
        return "wvr: kth[" + to_string(wvrkql) + ".." + to_string(wvrkqr) + "]," + to_string(wvrkk) + "=" + to_string(wvrkr);
    }
    if cmd == "wvr n" { return "wvr: n=" + to_string(wvr_n); }
    if _starts_with(cmd, "wvr cnt ") {
        let wvrca  = str_sub(cmd, 8, len(cmd));
        let wvrcs  = _find_space(wvrca);
        let wvrcl  = to_int(str_sub(wvrca, 0, wvrcs));
        let wvrci  = to_int(str_sub(wvrca, wvrcs + 1, len(wvrca)));
        return "wvr: cnt[" + to_string(wvrcl) + "][" + to_string(wvrci) + "]=" + to_string(wvr_cnt[wvrcl * 9 + wvrci]);
    }

    // --- ImplicitTreap ---
    if cmd == "it init" { it_init(); return "it: init"; }
    if cmd == "it test" { let itr = it_test(); return "it: " + to_string(itr); }
    if _starts_with(cmd, "it insert ") {
        let itia  = str_sub(cmd, 10, len(cmd));
        let itis  = _find_space(itia);
        let itipos = to_int(str_sub(itia, 0, itis));
        let itiv   = to_int(str_sub(itia, itis + 1, len(itia)));
        it_insert(itipos, itiv);
        return "it: inserted " + to_string(itiv) + " at " + to_string(itipos);
    }
    if _starts_with(cmd, "it rev ") {
        let itra  = str_sub(cmd, 7, len(cmd));
        let itrs  = _find_space(itra);
        let itrl  = to_int(str_sub(itra, 0, itrs));
        let itrr  = to_int(str_sub(itra, itrs + 1, len(itra)));
        it_reverse(itrl, itrr);
        return "it: reversed [" + to_string(itrl) + ".." + to_string(itrr) + "]";
    }
    if _starts_with(cmd, "it kth ") {
        let itkk = to_int(str_sub(cmd, 7, len(cmd)));
        return "it: kth(" + to_string(itkk) + ")=" + to_string(it_kth(itkk));
    }
    if cmd == "it sz"  { return "it: sz=" + to_string(it_sz()); }
    if cmd == "it rng" { return "it: rng=" + to_string(it_rng); }

    // --- ChthollyTree ---
    if _starts_with(cmd, "odt init ") {
        let odtia  = str_sub(cmd, 9, len(cmd));
        let odtis  = _find_space(odtia);
        let odtin  = to_int(str_sub(odtia, 0, odtis));
        let odtiv  = to_int(str_sub(odtia, odtis + 1, len(odtia)));
        odt_init(odtin, odtiv);
        return "odt: init n=" + to_string(odtin) + " val=" + to_string(odtiv);
    }
    if cmd == "odt test" { let odtr = odt_test(); return "odt: " + to_string(odtr); }
    if _starts_with(cmd, "odt assign ") {
        let odtaa  = str_sub(cmd, 11, len(cmd));
        let odtas1 = _find_space(odtaa);
        let odtal  = to_int(str_sub(odtaa, 0, odtas1));
        let odtaa2 = str_sub(odtaa, odtas1 + 1, len(odtaa));
        let odtas2 = _find_space(odtaa2);
        let odtar  = to_int(str_sub(odtaa2, 0, odtas2));
        let odtav  = to_int(str_sub(odtaa2, odtas2 + 1, len(odtaa2)));
        odt_assign(odtal, odtar, odtav);
        return "odt: assign [" + to_string(odtal) + ".." + to_string(odtar) + "]=" + to_string(odtav);
    }
    if _starts_with(cmd, "odt sum ") {
        let odtsa  = str_sub(cmd, 8, len(cmd));
        let odtss  = _find_space(odtsa);
        let odtsl  = to_int(str_sub(odtsa, 0, odtss));
        let odtsr  = to_int(str_sub(odtsa, odtss + 1, len(odtsa)));
        return "odt: sum[" + to_string(odtsl) + ".." + to_string(odtsr) + "]=" + to_string(odt_sum(odtsl, odtsr));
    }
    if cmd == "odt n" { return "odt: n=" + to_string(odt_n); }
    if _starts_with(cmd, "odt get ") {
        let odtgi = to_int(str_sub(cmd, 8, len(cmd)));
        return "odt: [" + to_string(odt_l[odtgi]) + ".." + to_string(odt_r[odtgi]) + "]=" + to_string(odt_v[odtgi]);
    }
    if cmd == "odt maxpos" { return "odt: maxpos=" + to_string(odt_maxpos); }

    // --- SuffixTree ---
    if _starts_with(cmd, "st init ") {
        let stin = to_int(str_sub(cmd, 8, len(cmd)));
        st_init(stin);
        return "st: init n=" + to_string(stin);
    }
    if cmd == "st test"  { let str2 = st_test();  return "st: " + to_string(str2); }
    if cmd == "st build" { st_build(); return "st: built n=" + to_string(st_n); }
    if _starts_with(cmd, "st schar ") {
        let stca  = str_sub(cmd, 9, len(cmd));
        let stcs  = _find_space(stca);
        let stci  = to_int(str_sub(stca, 0, stcs));
        let stcv  = to_int(str_sub(stca, stcs + 1, len(stca)));
        st_set_char(stci, stcv);
        return "st: str[" + to_string(stci) + "]=" + to_string(stcv);
    }
    if cmd == "st nodes" { return "st: nodes=" + to_string(st_node_count()); }
    if cmd == "st n"     { return "st: n=" + to_string(st_n); }

    // --- BSGS ---
    if cmd == "bsgs init" { bsgs_init(); return "bsgs: init"; }
    if cmd == "bsgs test" { let bgr = bsgs_test(); return "bsgs: " + to_string(bgr); }
    if _starts_with(cmd, "bsgs solve ") {
        let bgsa  = str_sub(cmd, 11, len(cmd));
        let bgss1 = _find_space(bgsa);
        let bgsa2 = to_int(str_sub(bgsa, 0, bgss1));
        let bgsa3 = str_sub(bgsa, bgss1 + 1, len(bgsa));
        let bgss2 = _find_space(bgsa3);
        let bgsb  = to_int(str_sub(bgsa3, 0, bgss2));
        let bgsp  = to_int(str_sub(bgsa3, bgss2 + 1, len(bgsa3)));
        let bgsx  = bsgs_solve(bgsa2, bgsb, bgsp);
        return "bsgs: " + to_string(bgsa2) + "^x=" + to_string(bgsb) + " mod " + to_string(bgsp) + " -> x=" + to_string(bgsx);
    }
    if _starts_with(cmd, "bsgs powmod ") {
        let bpma  = str_sub(cmd, 12, len(cmd));
        let bpms1 = _find_space(bpma);
        let bpma2 = to_int(str_sub(bpma, 0, bpms1));
        let bpma3 = str_sub(bpma, bpms1 + 1, len(bpma));
        let bpms2 = _find_space(bpma3);
        let bpme  = to_int(str_sub(bpma3, 0, bpms2));
        let bpmp  = to_int(str_sub(bpma3, bpms2 + 1, len(bpma3)));
        return "bsgs: " + to_string(bpma2) + "^" + to_string(bpme) + " mod " + to_string(bpmp) + "=" + to_string(_bsgs_powmod(bpma2, bpme, bpmp));
    }
    if cmd == "bsgs m" { return "bsgs: M=" + to_string(BSGS_M); }
    if cmd == "bsgs a" { return "bsgs: a=" + to_string(bsgs_a); }
    if cmd == "bsgs b" { return "bsgs: b=" + to_string(bsgs_b); }
    if cmd == "bsgs p" { return "bsgs: p=" + to_string(bsgs_p); }

    // --- MinEnclosing Circle ---
    if cmd == "mec init" { mec_init(); return "mec: init"; }
    if cmd == "mec test" { let mecr = mec_test(); return "mec: " + to_string(mecr); }
    if _starts_with(cmd, "mec add ") {
        let meca  = str_sub(cmd, 8, len(cmd));
        let mecs  = _find_space(meca);
        let mecx  = to_int(str_sub(meca, 0, mecs));
        let mecy  = to_int(str_sub(meca, mecs + 1, len(meca)));
        mec_add(mecx, mecy);
        return "mec: added (" + to_string(mecx) + "," + to_string(mecy) + ") n=" + to_string(mec_n);
    }
    if cmd == "mec compute" { mec_compute(); return "mec: cx=" + to_string(mec_cx) + " cy=" + to_string(mec_cy) + " r2=" + to_string(mec_cr2); }
    if cmd == "mec cx"  { return "mec: cx=" + to_string(mec_cx); }
    if cmd == "mec cy"  { return "mec: cy=" + to_string(mec_cy); }
    if cmd == "mec r2"  { return "mec: r2=" + to_string(mec_cr2); }
    if cmd == "mec n"   { return "mec: n=" + to_string(mec_n); }

    // --- GVN ---
    if cmd == "gvn init" { gvn_init(); return "gvn: init"; }
    if cmd == "gvn test" { let gvnr = gvn_test(); return "gvn: " + to_string(gvnr); }
    if _starts_with(cmd, "gvn add ") {
        let gvna  = str_sub(cmd, 8, len(cmd));
        let gvns1 = _find_space(gvna);
        let gvnop = to_int(str_sub(gvna, 0, gvns1));
        let gvna2 = str_sub(gvna, gvns1 + 1, len(gvna));
        let gvns2 = _find_space(gvna2);
        let gvnds = to_int(str_sub(gvna2, 0, gvns2));
        let gvna3 = str_sub(gvna2, gvns2 + 1, len(gvna2));
        let gvns3 = _find_space(gvna3);
        let gvns0 = to_int(str_sub(gvna3, 0, gvns3));
        let gvns4 = to_int(str_sub(gvna3, gvns3 + 1, len(gvna3)));
        let gvnid = gvn_add_instr(gvnop, gvnds, gvns0, gvns4);
        return "gvn: added instr " + to_string(gvnid);
    }
    if cmd == "gvn run" { let gvnec = gvn_run(); return "gvn: eliminated=" + to_string(gvnec); }
    if _starts_with(cmd, "gvn vn ") {
        let gvnvi = to_int(str_sub(cmd, 7, len(cmd)));
        return "gvn: vn[" + to_string(gvnvi) + "]=" + to_string(gvn_get_vn(gvnvi));
    }
    if _starts_with(cmd, "gvn elim ") {
        let gvnei = to_int(str_sub(cmd, 9, len(cmd)));
        return "gvn: elim[" + to_string(gvnei) + "]=" + to_string(gvn_is_elim(gvnei));
    }
    if cmd == "gvn cnt" { return "gvn: elim_count=" + to_string(gvn_elim_count); }
    if cmd == "gvn n"   { return "gvn: n=" + to_string(gvn_n); }

    // --- LICM ---
    if cmd == "licm init" { licm_init(); return "licm: init"; }
    if cmd == "licm test" { let licmr = licm_test(); return "licm: " + to_string(licmr); }
    if _starts_with(cmd, "licm addi ") {
        let licma  = str_sub(cmd, 10, len(cmd));
        let licms1 = _find_space(licma);
        let licmop = to_int(str_sub(licma, 0, licms1));
        let licma2 = str_sub(licma, licms1 + 1, len(licma));
        let licms2 = _find_space(licma2);
        let licmds = to_int(str_sub(licma2, 0, licms2));
        let licma3 = str_sub(licma2, licms2 + 1, len(licma2));
        let licms3 = _find_space(licma3);
        let licms0 = to_int(str_sub(licma3, 0, licms3));
        let licma4 = str_sub(licma3, licms3 + 1, len(licma3));
        let licms4 = _find_space(licma4);
        let licms1b = to_int(str_sub(licma4, 0, licms4));
        let licmbb = to_int(str_sub(licma4, licms4 + 1, len(licma4)));
        let licmid = licm_add_instr(licmop, licmds, licms0, licms1b, licmbb);
        return "licm: added instr " + to_string(licmid);
    }
    if _starts_with(cmd, "licm loop ") {
        let licmlh = to_int(str_sub(cmd, 10, len(cmd)));
        let licmll = licm_add_loop(licmlh);
        return "licm: loop " + to_string(licmll) + " hdr=" + to_string(licmlh);
    }
    if _starts_with(cmd, "licm body ") {
        let licmba  = str_sub(cmd, 10, len(cmd));
        let licmbs  = _find_space(licmba);
        let licmbl  = to_int(str_sub(licmba, 0, licmbs));
        let licmbb2 = to_int(str_sub(licmba, licmbs + 1, len(licmba)));
        licm_add_body(licmbl, licmbb2);
        return "licm: body loop=" + to_string(licmbl) + " bb=" + to_string(licmbb2);
    }
    if cmd == "licm run" { let licmhc = licm_run(); return "licm: hoisted=" + to_string(licmhc); }
    if _starts_with(cmd, "licm hoisted ") {
        let licmhi = to_int(str_sub(cmd, 13, len(cmd)));
        return "licm: hoisted[" + to_string(licmhi) + "]=" + to_string(licm_is_hoisted(licmhi));
    }
    if cmd == "licm cnt" { return "licm: hoist_count=" + to_string(licm_hoist_count()); }

    // --- DCE2 ---
    if cmd == "dce2 init" { dce2_init(); return "dce2: init"; }
    if cmd == "dce2 test" { let dce2r = dce2_test(); return "dce2: " + to_string(dce2r); }
    if _starts_with(cmd, "dce2 add ") {
        let dcea  = str_sub(cmd, 9, len(cmd));
        let dces1 = _find_space(dcea);
        let dceop = to_int(str_sub(dcea, 0, dces1));
        let dcea2 = str_sub(dcea, dces1 + 1, len(dcea));
        let dces2 = _find_space(dcea2);
        let dceds = to_int(str_sub(dcea2, 0, dces2));
        let dcea3 = str_sub(dcea2, dces2 + 1, len(dcea2));
        let dces3 = _find_space(dcea3);
        let dces0 = to_int(str_sub(dcea3, 0, dces3));
        let dces4 = to_int(str_sub(dcea3, dces3 + 1, len(dcea3)));
        let dceid = dce2_add_instr(dceop, dceds, dces0, dces4);
        return "dce2: added instr " + to_string(dceid);
    }
    if _starts_with(cmd, "dce2 phi ") {
        let dcepd = to_int(str_sub(cmd, 9, len(cmd)));
        let dcepi = dce2_add_phi(dcepd);
        return "dce2: phi " + to_string(dcepi) + " dst=" + to_string(dcepd);
    }
    if _starts_with(cmd, "dce2 parg ") {
        let dcepaa = str_sub(cmd, 10, len(cmd));
        let dcepas = _find_space(dcepaa);
        let dcepai = to_int(str_sub(dcepaa, 0, dcepas));
        let dcepar = to_int(str_sub(dcepaa, dcepas + 1, len(dcepaa)));
        dce2_phi_add_arg(dcepai, dcepar);
        return "dce2: phi[" + to_string(dcepai) + "] arg=" + to_string(dcepar);
    }
    if cmd == "dce2 run" { let dcedc = dce2_run(); return "dce2: dead=" + to_string(dcedc); }
    if _starts_with(cmd, "dce2 live ") {
        let dceli = to_int(str_sub(cmd, 10, len(cmd)));
        return "dce2: live[" + to_string(dceli) + "]=" + to_string(dce2_is_live(dceli));
    }
    if cmd == "dce2 dead" { return "dce2: dead_count=" + to_string(dce2_dead_count()); }
    if cmd == "dce2 n"    { return "dce2: n=" + to_string(dce2_n); }

    // --- LinearScanRA ---
    if cmd == "rls init" { rls_init(); return "rls: init"; }
    if cmd == "rls test" { let rlsr = rls_test(); return "rls: " + to_string(rlsr); }
    if _starts_with(cmd, "rls add ") {
        let rlsa  = str_sub(cmd, 8, len(cmd));
        let rlssp = _find_space(rlsa);
        let rlss  = to_int(str_sub(rlsa, 0, rlssp));
        let rlse  = to_int(str_sub(rlsa, rlssp + 1, len(rlsa)));
        let rlsid = rls_add_interval(rlss, rlse);
        return "rls: interval " + to_string(rlsid) + " [" + to_string(rlss) + ".." + to_string(rlse) + "]";
    }
    if cmd == "rls run" { let rlssc = rls_run(); return "rls: spills=" + to_string(rlssc); }
    if _starts_with(cmd, "rls reg ") {
        let rlsri = to_int(str_sub(cmd, 8, len(cmd)));
        return "rls: reg[" + to_string(rlsri) + "]=" + to_string(rls_get_reg(rlsri));
    }
    if _starts_with(cmd, "rls spilled ") {
        let rlssi = to_int(str_sub(cmd, 12, len(cmd)));
        return "rls: spilled[" + to_string(rlssi) + "]=" + to_string(rls_is_spilled(rlssi));
    }
    if cmd == "rls n"      { return "rls: n=" + to_string(rls_n); }
    if cmd == "rls spills" { return "rls: spill_cnt=" + to_string(rls_spill_cnt); }

    // --- RegCoalesce ---
    if cmd == "rc init" { rc_init(); return "rc: init"; }
    if cmd == "rc test" { let rcr = rc_test(); return "rc: " + to_string(rcr); }
    if _starts_with(cmd, "rc setn ") {
        let rcsn = to_int(str_sub(cmd, 8, len(cmd)));
        rc_set_n(rcsn);
        return "rc: n=" + to_string(rcsn);
    }
    if _starts_with(cmd, "rc inter ") {
        let rcia  = str_sub(cmd, 9, len(cmd));
        let rcis  = _find_space(rcia);
        let rciu  = to_int(str_sub(rcia, 0, rcis));
        let rciv  = to_int(str_sub(rcia, rcis + 1, len(rcia)));
        rc_add_interfere(rciu, rciv);
        return "rc: interfere " + to_string(rciu) + "<->" + to_string(rciv);
    }
    if _starts_with(cmd, "rc copy ") {
        let rcca  = str_sub(cmd, 8, len(cmd));
        let rccs  = _find_space(rcca);
        let rccu  = to_int(str_sub(rcca, 0, rccs));
        let rccv  = to_int(str_sub(rcca, rccs + 1, len(rcca)));
        rc_add_copy(rccu, rccv);
        return "rc: copy " + to_string(rccu) + "<->" + to_string(rccv);
    }
    if cmd == "rc run" { let rcc = rc_run(); return "rc: coalesced=" + to_string(rcc); }
    if _starts_with(cmd, "rc color ") {
        let rcci = to_int(str_sub(cmd, 9, len(cmd)));
        return "rc: color[" + to_string(rcci) + "]=" + to_string(rc_get_color(rcci));
    }
    if _starts_with(cmd, "rc coalesced ") {
        let rccoi = to_int(str_sub(cmd, 13, len(cmd)));
        return "rc: coalesced[" + to_string(rccoi) + "]=" + to_string(rc_is_coalesced(rccoi));
    }
    if cmd == "rc cnt" { return "rc: coalesce_cnt=" + to_string(rc_coalesce_count()); }
    if cmd == "rc n"   { return "rc: n=" + to_string(rc_n); }

    // --- CallingConv ---
    if cmd == "cc init"  { cc_init();         return "cc: init"; }
    if cmd == "cc test"  { let ccr = cc_test(); return "cc: " + to_string(ccr); }
    if cmd == "cc reset" { cc_reset_call();   return "cc: call reset"; }
    if cmd == "cc iarg"  { let ccia = cc_add_int_arg();   return "cc: int arg " + to_string(ccia) + " -> reg=" + to_string(cc_arg_reg[ccia]); }
    if cmd == "cc farg"  { let ccfa = cc_add_float_arg(); return "cc: flt arg " + to_string(ccfa) + " -> reg=" + to_string(cc_arg_reg[ccfa]); }
    if _starts_with(cmd, "cc frame ") {
        let ccfa2  = str_sub(cmd, 9, len(cmd));
        let ccfs   = _find_space(ccfa2);
        let ccfl   = to_int(str_sub(ccfa2, 0, ccfs));
        let ccfn   = to_int(str_sub(ccfa2, ccfs + 1, len(ccfa2)));
        let ccfsz  = cc_compute_frame(ccfl, ccfn);
        return "cc: frame=" + to_string(ccfsz) + " locals=" + to_string(ccfl) + " saved=" + to_string(ccfn);
    }
    if _starts_with(cmd, "cc argreg ") {
        let ccai = to_int(str_sub(cmd, 10, len(cmd)));
        return "cc: arg[" + to_string(ccai) + "].reg=" + to_string(cc_arg_reg[ccai]);
    }
    if _starts_with(cmd, "cc argstk ") {
        let ccasi = to_int(str_sub(cmd, 10, len(cmd)));
        return "cc: arg[" + to_string(ccasi) + "].stk=" + to_string(cc_arg_stack[ccasi]);
    }
    if _starts_with(cmd, "cc callee ") {
        let ccri = to_int(str_sub(cmd, 10, len(cmd)));
        return "cc: r" + to_string(ccri) + " callee_saved=" + to_string(cc_is_callee_saved(ccri));
    }
    if _starts_with(cmd, "cc caller ") {
        let ccrj = to_int(str_sub(cmd, 10, len(cmd)));
        return "cc: r" + to_string(ccrj) + " caller_saved=" + to_string(cc_is_caller_saved(ccrj));
    }
    if cmd == "cc nargs"  { return "cc: nargs=" + to_string(cc_nargs); }
    if cmd == "cc stksz"  { return "cc: stack_size=" + to_string(cc_stack_size); }

    // --- TypeInfer ---
    if cmd == "ti init" { ti_init(); return "ti: init"; }
    if cmd == "ti test" { let tir = ti_test(); return "ti: " + to_string(tir); }
    if _starts_with(cmd, "ti node ") {
        let tina  = str_sub(cmd, 8, len(cmd));
        let tins1 = _find_space(tina);
        let tink  = to_int(str_sub(tina, 0, tins1));
        let tina2 = str_sub(tina, tins1 + 1, len(tina));
        let tins2 = _find_space(tina2);
        let tinf0 = to_int(str_sub(tina2, 0, tins2));
        let tinf1 = to_int(str_sub(tina2, tins2 + 1, len(tina2)));
        let tinid = ti_add_node(tink, tinf0, tinf1);
        return "ti: node " + to_string(tinid);
    }
    if _starts_with(cmd, "ti run ") {
        let tirr = to_int(str_sub(cmd, 7, len(cmd)));
        let tirt = ti_run(tirr);
        return "ti: type=" + to_string(tirt) + " error=" + to_string(ti_error);
    }
    if _starts_with(cmd, "ti type ") {
        let titi = to_int(str_sub(cmd, 8, len(cmd)));
        return "ti: node[" + to_string(titi) + "].type=" + to_string(ti_get_type(titi));
    }
    if cmd == "ti error" { return "ti: error=" + to_string(ti_error); }
    if cmd == "ti tvn"   { return "ti: tv_n=" + to_string(ti_tv_n); }
    if cmd == "ti fnn"   { return "ti: fun_n=" + to_string(ti_fun_n); }
    if cmd == "ti n"     { return "ti: n=" + to_string(ti_nd_n); }

    // --- TypeChecker ---
    if cmd == "tc init" { tc_init(); return "tc: init"; }
    if cmd == "tc test" { let tct = tc_test(); return "tc: " + to_string(tct); }
    if _starts_with(cmd, "tc decl ") {
        let tcda  = str_sub(cmd, 8, len(cmd));
        let tcds  = _find_space(tcda);
        let tcdn  = to_int(str_sub(tcda, 0, tcds));
        let tcdt  = to_int(str_sub(tcda, tcds + 1, len(tcda)));
        tc_declare(tcdn, tcdt);
        return "tc: decl name=" + to_string(tcdn) + " type=" + to_string(tcdt);
    }
    if _starts_with(cmd, "tc assign ") {
        let tcaa  = str_sub(cmd, 10, len(cmd));
        let tcas  = _find_space(tcaa);
        let tcan  = to_int(str_sub(tcaa, 0, tcas));
        let tcat  = to_int(str_sub(tcaa, tcas + 1, len(tcaa)));
        tc_add_assign(tcan, tcat);
        return "tc: assign var=" + to_string(tcan) + " type=" + to_string(tcat);
    }
    if _starts_with(cmd, "tc binop ") {
        let tcboa = str_sub(cmd, 9, len(cmd));
        let tcbos = _find_space(tcboa);
        let tcbop = to_int(str_sub(tcboa, 0, tcbos));
        let tcboa2 = str_sub(tcboa, tcbos + 1, len(tcboa));
        let tcbos2 = _find_space(tcboa2);
        let tcbol  = to_int(str_sub(tcboa2, 0, tcbos2));
        let tcboa3 = str_sub(tcboa2, tcbos2 + 1, len(tcboa2));
        let tcbos3 = _find_space(tcboa3);
        let tcbor  = to_int(str_sub(tcboa3, 0, tcbos3));
        let tcbod  = to_int(str_sub(tcboa3, tcbos3 + 1, len(tcboa3)));
        tc_add_binop(tcbop, tcbol, tcbor, tcbod);
        return "tc: binop op=" + to_string(tcbop);
    }
    if _starts_with(cmd, "tc ret ") {
        let tcrv = to_int(str_sub(cmd, 7, len(cmd)));
        tc_add_ret(tcrv);
        return "tc: ret var=" + to_string(tcrv);
    }
    if cmd == "tc run"  { let tce = tc_run(); return "tc: errors=" + to_string(tce); }
    if cmd == "tc errs" { return "tc: error_count=" + to_string(tc_error_count()); }
    if _starts_with(cmd, "tc err ") {
        let tcei = to_int(str_sub(cmd, 7, len(cmd)));
        return "tc: err[" + to_string(tcei) + "] node=" + to_string(tc_get_err_node(tcei)) + " exp=" + to_string(tc_get_err_exp(tcei)) + " got=" + to_string(tc_get_err_got(tcei));
    }

    // --- Generics ---
    if cmd == "gn init" { gn_init(); return "gn: init"; }
    if cmd == "gn test" { let gnr = gn_test(); return "gn: " + to_string(gnr); }
    if _starts_with(cmd, "gn templ ") {
        let gnta  = str_sub(cmd, 9, len(cmd));
        let gnts  = _find_space(gnta);
        let gntn  = to_int(str_sub(gnta, 0, gnts));
        let gntp  = to_int(str_sub(gnta, gnts + 1, len(gnta)));
        let gntid = gn_begin_template(gntn, gntp);
        return "gn: template " + to_string(gntid) + " params=" + to_string(gntp);
    }
    if _starts_with(cmd, "gn op ") {
        let gnoa  = str_sub(cmd, 6, len(cmd));
        let gnos1 = _find_space(gnoa);
        let gnot  = to_int(str_sub(gnoa, 0, gnos1));
        let gnoa2 = str_sub(gnoa, gnos1 + 1, len(gnoa));
        let gnos2 = _find_space(gnoa2);
        let gnok  = to_int(str_sub(gnoa2, 0, gnos2));
        let gnoa3 = str_sub(gnoa2, gnos2 + 1, len(gnoa2));
        let gnos3 = _find_space(gnoa3);
        let gnof0 = to_int(str_sub(gnoa3, 0, gnos3));
        let gnoa4 = str_sub(gnoa3, gnos3 + 1, len(gnoa3));
        let gnos4 = _find_space(gnoa4);
        let gnof1 = to_int(str_sub(gnoa4, 0, gnos4));
        let gnof2 = to_int(str_sub(gnoa4, gnos4 + 1, len(gnoa4)));
        let gnoid = gn_add_op(gnot, gnok, gnof0, gnof1, gnof2);
        return "gn: op " + to_string(gnoid);
    }
    if _starts_with(cmd, "gn inst ") {
        let gnia  = str_sub(cmd, 8, len(cmd));
        let gnis1 = _find_space(gnia);
        let gnit  = to_int(str_sub(gnia, 0, gnis1));
        let gnia2 = str_sub(gnia, gnis1 + 1, len(gnia));
        let gnis2 = _find_space(gnia2);
        let gnit0 = to_int(str_sub(gnia2, 0, gnis2));
        let gnit1 = to_int(str_sub(gnia2, gnis2 + 1, len(gnia2)));
        let gniid = gn_instantiate(gnit, gnit0, gnit1, 0, 0);
        return "gn: inst " + to_string(gniid);
    }
    if _starts_with(cmd, "gn itype ") {
        let gnitya = str_sub(cmd, 9, len(cmd));
        let gnitys = _find_space(gnitya);
        let gnityii = to_int(str_sub(gnitya, 0, gnitys));
        let gnityoi = to_int(str_sub(gnitya, gnitys + 1, len(gnitya)));
        return "gn: inst[" + to_string(gnityii) + "].op[" + to_string(gnityoi) + "].type=" + to_string(gn_get_inst_op_type(gnityii, gnityoi));
    }
    if cmd == "gn nt" { return "gn: tmpl_n=" + to_string(gn_tmpl_count()); }
    if cmd == "gn ni" { return "gn: inst_n=" + to_string(gn_inst_count()); }

    // --- LinkerELF ---
    if cmd == "elf init" { elf_init(); return "elf: init"; }
    if cmd == "elf test" { let elfr = elf_test(); return "elf: " + to_string(elfr); }
    if _starts_with(cmd, "elf setsz ") {
        let elfsa  = str_sub(cmd, 10, len(cmd));
        let elfss1 = _find_space(elfsa);
        let elfst  = to_int(str_sub(elfsa, 0, elfss1));
        let elfsa2 = str_sub(elfsa, elfss1 + 1, len(elfsa));
        let elfss2 = _find_space(elfsa2);
        let elfsd  = to_int(str_sub(elfsa2, 0, elfss2));
        let elfsb  = to_int(str_sub(elfsa2, elfss2 + 1, len(elfsa2)));
        elf_set_section_size(elfst, elfsd, elfsb);
        return "elf: text=" + to_string(elfst) + " data=" + to_string(elfsd) + " bss=" + to_string(elfsb);
    }
    if cmd == "elf layout" { let elfsz = elf_layout(); return "elf: file_size=" + to_string(elfsz); }
    if cmd == "elf entry"  { return "elf: entry=0x" + to_string(elf_entry_addr); }
    if cmd == "elf fsz"    { return "elf: file_size=" + to_string(elf_file_size); }
    if _starts_with(cmd, "elf secoff ") {
        let elfoi = to_int(str_sub(cmd, 11, len(cmd)));
        return "elf: sec[" + to_string(elfoi) + "].offset=" + to_string(elf_get_section_offset(elfoi));
    }
    if _starts_with(cmd, "elf secsz ") {
        let elfozi = to_int(str_sub(cmd, 10, len(cmd)));
        return "elf: sec[" + to_string(elfozi) + "].size=" + to_string(elf_get_section_size(elfozi));
    }
    if cmd == "elf symn"   { return "elf: sym_n=" + to_string(elf_sym_n); }
    if cmd == "elf reln"   { return "elf: rel_n=" + to_string(elf_rel_n); }

    // --- LinkerAR ---
    if cmd == "ar init" { ar_init(); return "ar: init"; }
    if cmd == "ar test" { let arr = ar_test(); return "ar: " + to_string(arr); }
    if _starts_with(cmd, "ar mem ") {
        let arma  = str_sub(cmd, 7, len(cmd));
        let arms  = _find_space(arma);
        let armn  = to_int(str_sub(arma, 0, arms));
        let armsz = to_int(str_sub(arma, arms + 1, len(arma)));
        let armid = ar_add_member(armn, armsz);
        return "ar: member " + to_string(armid) + " size=" + to_string(armsz);
    }
    if _starts_with(cmd, "ar sym ") {
        let arsa  = str_sub(cmd, 7, len(cmd));
        let arss  = _find_space(arsa);
        let arsn  = to_int(str_sub(arsa, 0, arss));
        let arsm  = to_int(str_sub(arsa, arss + 1, len(arsa)));
        ar_add_symbol(arsn, arsm);
        return "ar: sym " + to_string(arsn) + " -> member " + to_string(arsm);
    }
    if _starts_with(cmd, "ar undef ") {
        let arun = to_int(str_sub(cmd, 9, len(cmd)));
        ar_add_undef(arun);
        return "ar: undef " + to_string(arun);
    }
    if cmd == "ar link" { let arsel = ar_link(); return "ar: selected=" + to_string(arsel); }
    if _starts_with(cmd, "ar sel ") {
        let arsi = to_int(str_sub(cmd, 7, len(cmd)));
        return "ar: member[" + to_string(arsi) + "].selected=" + to_string(ar_is_selected(arsi));
    }
    if cmd == "ar tsz" { return "ar: total_size=" + to_string(ar_total_size()); }
    if cmd == "ar nm"  { return "ar: member_n=" + to_string(ar_member_count()); }
    if cmd == "ar ns"  { return "ar: sym_n=" + to_string(ar_sym_count()); }

    // --- DynLinker ---
    if cmd == "dl init" { dl_init(); return "dl: init"; }
    if cmd == "dl test" { let dlr = dl_test(); return "dl: " + to_string(dlr); }
    if _starts_with(cmd, "dl lib ") {
        let dlla  = str_sub(cmd, 7, len(cmd));
        let dlls  = _find_space(dlla);
        let dlln  = to_int(str_sub(dlla, 0, dlls));
        let dllb  = to_int(str_sub(dlla, dlls + 1, len(dlla)));
        let dllid = dl_add_library(dlln, dllb);
        return "dl: lib " + to_string(dllid) + " base=0x" + to_string(dllb);
    }
    if _starts_with(cmd, "dl import ") {
        let dlia  = str_sub(cmd, 10, len(cmd));
        let dlis  = _find_space(dlia);
        let dlin  = to_int(str_sub(dlia, 0, dlis));
        let dlil  = to_int(str_sub(dlia, dlis + 1, len(dlia)));
        let dliid = dl_add_import(dlin, dlil);
        return "dl: import sym=" + to_string(dlin) + " id=" + to_string(dliid);
    }
    if _starts_with(cmd, "dl resolve ") {
        let dlra  = str_sub(cmd, 11, len(cmd));
        let dlrs  = _find_space(dlra);
        let dlrsi = to_int(str_sub(dlra, 0, dlrs));
        let dlrof = to_int(str_sub(dlra, dlrs + 1, len(dlra)));
        let dlrad = dl_resolve(dlrsi, dlrof);
        return "dl: resolved sym " + to_string(dlrsi) + " addr=0x" + to_string(dlrad);
    }
    if cmd == "dl resolveall" { let dlrc = dl_resolve_all(); return "dl: resolved=" + to_string(dlrc); }
    if _starts_with(cmd, "dl got ") {
        let dlgi = to_int(str_sub(cmd, 7, len(cmd)));
        return "dl: got[" + to_string(dlgi) + "]=0x" + to_string(dl_got_addr(dlgi));
    }
    if _starts_with(cmd, "dl plt ") {
        let dlpi = to_int(str_sub(cmd, 7, len(cmd)));
        return "dl: plt[" + to_string(dlpi) + "]=0x" + to_string(dl_plt_addr(dlpi));
    }
    if _starts_with(cmd, "dl addr ") {
        let dlai = to_int(str_sub(cmd, 8, len(cmd)));
        return "dl: sym " + to_string(dlai) + " addr=0x" + to_string(dl_lookup(dlai));
    }
    if cmd == "dl ns" { return "dl: sym_n=" + to_string(dl_sym_count()); }
    if cmd == "dl nl" { return "dl: lib_n=" + to_string(dl_lib_count()); }

    // --- DWARF ---
    if cmd == "dw init" { dw_init(); return "dw: init"; }
    if cmd == "dw test" { let dwr = dw_test(); return "dw: " + to_string(dwr); }
    if _starts_with(cmd, "dw addfile ") {
        let dwfa  = str_sub(cmd, 11, len(cmd));
        let dwfs  = _find_space(dwfa);
        let dwfn  = to_int(str_sub(dwfa, 0, dwfs));
        let dwfd  = to_int(str_sub(dwfa, dwfs + 1, len(dwfa)));
        let dwfid = dw_add_file(dwfn, dwfd);
        return "dw: file " + to_string(dwfid);
    }
    if _starts_with(cmd, "dw addline ") {
        let dwla  = str_sub(cmd, 11, len(cmd));
        let dwls0 = _find_space(dwla);
        let dwlad = to_int(str_sub(dwla, 0, dwls0));
        let dwla1 = str_sub(dwla, dwls0 + 1, len(dwla));
        let dwls1 = _find_space(dwla1);
        let dwlfi = to_int(str_sub(dwla1, 0, dwls1));
        let dwla2 = str_sub(dwla1, dwls1 + 1, len(dwla1));
        let dwls2 = _find_space(dwla2);
        let dwlln = to_int(str_sub(dwla2, 0, dwls2));
        let dwlco = to_int(str_sub(dwla2, dwls2 + 1, len(dwla2)));
        let dwlid = dw_add_line(dwlad, dwlfi, dwlln, dwlco, 1);
        return "dw: line " + to_string(dwlid);
    }
    if _starts_with(cmd, "dw addvar ") {
        let dwva  = str_sub(cmd, 10, len(cmd));
        let dwvs0 = _find_space(dwva);
        let dwvnm = to_int(str_sub(dwva, 0, dwvs0));
        let dwva1 = str_sub(dwva, dwvs0 + 1, len(dwva));
        let dwvs1 = _find_space(dwva1);
        let dwvtp = to_int(str_sub(dwva1, 0, dwvs1));
        let dwva2 = str_sub(dwva1, dwvs1 + 1, len(dwva1));
        let dwvs2 = _find_space(dwva2);
        let dwvlk = to_int(str_sub(dwva2, 0, dwvs2));
        let dwva3 = str_sub(dwva2, dwvs2 + 1, len(dwva2));
        let dwvs3 = _find_space(dwva3);
        let dwvof = to_int(str_sub(dwva3, 0, dwvs3));
        let dwvfu = to_int(str_sub(dwva3, dwvs3 + 1, len(dwva3)));
        let dwvid = dw_add_var(dwvnm, dwvtp, dwvlk, dwvof, dwvfu);
        return "dw: var " + to_string(dwvid);
    }
    if cmd == "dw emit"  { let dwsz = dw_emit_line_table(); return "dw: debug_line=" + to_string(dwsz) + "B"; }
    if cmd == "dw lines" { return "dw: lines=" + to_string(dw_line_count()); }
    if cmd == "dw vars"  { return "dw: vars="  + to_string(dw_var_count()); }
    if cmd == "dw outsz" { return "dw: out="   + to_string(dw_out_size()) + "B"; }

    // --- PerfCounter ---
    if cmd == "pc init" { pc_init(); return "pc: init"; }
    if cmd == "pc test" { let pcr = pc_test(); return "pc: " + to_string(pcr); }
    if _starts_with(cmd, "pc add ") {
        let pca  = str_sub(cmd, 7, len(cmd));
        let pcs  = _find_space(pca);
        let pcev = to_int(str_sub(pca, 0, pcs));
        let pcum = to_int(str_sub(pca, pcs + 1, len(pca)));
        let pcid = pc_add_counter(pcev, pcum);
        return "pc: counter " + to_string(pcid) + " evt=" + to_string(pcev);
    }
    if cmd == "pc snap"    { pc_snapshot(); return "pc: snapshot taken"; }
    if cmd == "pc ipc"     { return "pc: IPC*100=" + to_string(pc_ipc()); }
    if cmd == "pc llcrate" { return "pc: LLC/1000inst=" + to_string(pc_llc_miss_rate()); }
    if cmd == "pc brrate"  { return "pc: BR/1000inst="  + to_string(pc_br_miss_rate()); }
    if cmd == "pc total"   { return "pc: inst=" + to_string(pc_total_inst) + " cyc=" + to_string(pc_total_cycles); }
    if cmd == "pc stats"   { pc_print_stats(); return "pc: stats printed"; }
    if cmd == "pc samples" { return "pc: samples=" + to_string(pc_sample_count()); }

    // --- JITStub ---
    if cmd == "jit init" { jit_init(); return "jit: init"; }
    if cmd == "jit test" { let jitr = jit_test(); return "jit: " + to_string(jitr); }
    if _starts_with(cmd, "jit reg ") {
        let jitri = to_int(str_sub(cmd, 8, len(cmd)));
        let jitrs = jit_register(jitri);
        return "jit: registered fid=" + to_string(jitri) + " slot=" + to_string(jitrs);
    }
    if _starts_with(cmd, "jit call ") {
        let jitci = to_int(str_sub(cmd, 9, len(cmd)));
        let jitcr = jit_call(jitci);
        return "jit: call fid=" + to_string(jitci) + " ret=" + to_string(jitcr);
    }
    if _starts_with(cmd, "jit hot ") {
        let jiths = to_int(str_sub(cmd, 8, len(cmd)));
        return "jit: hot=" + to_string(jit_is_hot(jiths));
    }
    if _starts_with(cmd, "jit compconst ") {
        let jitca  = str_sub(cmd, 14, len(cmd));
        let jitcs  = _find_space(jitca);
        let jitcsl = to_int(str_sub(jitca, 0, jitcs));
        let jitcrv = to_int(str_sub(jitca, jitcs + 1, len(jitca)));
        let jitcby = jit_compile_const(jitcsl, jitcrv);
        return "jit: compiled const slot=" + to_string(jitcsl) + " bytes=" + to_string(jitcby);
    }
    if _starts_with(cmd, "jit compadd ") {
        let jitaa  = str_sub(cmd, 12, len(cmd));
        let jitas0 = _find_space(jitaa);
        let jitasl = to_int(str_sub(jitaa, 0, jitas0));
        let jitaa1 = str_sub(jitaa, jitas0 + 1, len(jitaa));
        let jitas1 = _find_space(jitaa1);
        let jitabv = to_int(str_sub(jitaa1, 0, jitas1));
        let jitaav = to_int(str_sub(jitaa1, jitas1 + 1, len(jitaa1)));
        let jitaby = jit_compile_add(jitasl, jitabv, jitaav);
        return "jit: compiled add slot=" + to_string(jitasl) + " bytes=" + to_string(jitaby);
    }
    if cmd == "jit nc"    { return "jit: compiled=" + to_string(jit_compiled_count()); }
    if cmd == "jit nhits" { return "jit: hits="     + to_string(jit_hit_count()); }
    if cmd == "jit sz"    { return "jit: code_bytes=" + to_string(jit_code_n); }

    // --- BTree ---
    if cmd == "bt init" { bt_init(); return "bt: init"; }
    if cmd == "bt test" { let btr = bt_test(); return "bt: " + to_string(btr); }
    if _starts_with(cmd, "bt insert ") {
        let btia  = str_sub(cmd, 10, len(cmd));
        let btis  = _find_space(btia);
        let btik  = to_int(str_sub(btia, 0, btis));
        let btiv  = to_int(str_sub(btia, btis + 1, len(btia)));
        bt_insert(btik, btiv);
        return "bt: inserted k=" + to_string(btik);
    }
    if _starts_with(cmd, "bt search ") {
        let btsk = to_int(str_sub(cmd, 10, len(cmd)));
        let btsv = bt_search(bt_root, btsk);
        return "bt: search k=" + to_string(btsk) + " v=" + to_string(btsv);
    }
    if cmd == "bt size"   { return "bt: size="   + to_string(bt_size_get()); }
    if cmd == "bt nodes"  { return "bt: nodes="  + to_string(bt_node_count()); }
    if cmd == "bt height" { return "bt: height=" + to_string(bt_height()); }

    // --- BPlusTree ---
    if cmd == "btp init" { btp_init(); return "btp: init"; }
    if cmd == "btp test" { let btpr = btp_test(); return "btp: " + to_string(btpr); }
    if _starts_with(cmd, "btp insert ") {
        let btpia  = str_sub(cmd, 11, len(cmd));
        let btpis  = _find_space(btpia);
        let btpik  = to_int(str_sub(btpia, 0, btpis));
        let btpiv  = to_int(str_sub(btpia, btpis + 1, len(btpia)));
        btp_insert(btpik, btpiv);
        return "btp: inserted k=" + to_string(btpik);
    }
    if _starts_with(cmd, "btp search ") {
        let btpsk = to_int(str_sub(cmd, 11, len(cmd)));
        let btpsv = btp_search(btp_root, btpsk);
        return "btp: search k=" + to_string(btpsk) + " v=" + to_string(btpsv);
    }
    if _starts_with(cmd, "btp range ") {
        let btpra  = str_sub(cmd, 10, len(cmd));
        let btprs  = _find_space(btpra);
        let btprlo = to_int(str_sub(btpra, 0, btprs));
        let btprhi = to_int(str_sub(btpra, btprs + 1, len(btpra)));
        let btprc  = btp_range(btprlo, btprhi);
        return "btp: range[" + to_string(btprlo) + "," + to_string(btprhi) + "]=" + to_string(btprc);
    }
    if cmd == "btp rqn"  { return "btp: rq_n=" + to_string(btp_rq_n); }
    if _starts_with(cmd, "btp rqk ") {
        let btpri = to_int(str_sub(cmd, 8, len(cmd)));
        return "btp: rq[" + to_string(btpri) + "]=" + to_string(btp_rq_keys[btpri]);
    }
    if cmd == "btp size"  { return "btp: size="  + to_string(btp_size_get()); }
    if cmd == "btp nodes" { return "btp: nodes=" + to_string(btp_node_count()); }

    // --- LSMMemtable ---
    if cmd == "lsm init" { lsm_init(); return "lsm: init"; }
    if cmd == "lsm test" { let lsmr = lsm_test(); return "lsm: " + to_string(lsmr); }
    if _starts_with(cmd, "lsm put ") {
        let lsmpa  = str_sub(cmd, 8, len(cmd));
        let lsmps  = _find_space(lsmpa);
        let lsmpk  = to_int(str_sub(lsmpa, 0, lsmps));
        let lsmpv  = to_int(str_sub(lsmpa, lsmps + 1, len(lsmpa)));
        lsm_put(lsmpk, lsmpv);
        return "lsm: put k=" + to_string(lsmpk);
    }
    if _starts_with(cmd, "lsm get ") {
        let lsmgk = to_int(str_sub(cmd, 8, len(cmd)));
        let lsmgv = lsm_get(lsmgk);
        return "lsm: get k=" + to_string(lsmgk) + " v=" + to_string(lsmgv);
    }
    if cmd == "lsm flush"  { let lsmf = lsm_flush(); return "lsm: flushed=" + to_string(lsmf); }
    if _starts_with(cmd, "lsm ssget ") {
        let lsmssk = to_int(str_sub(cmd, 10, len(cmd)));
        let lsmsv  = lsm_ss_get(lsmssk);
        return "lsm: ssget k=" + to_string(lsmssk) + " v=" + to_string(lsmsv);
    }
    if cmd == "lsm compact" { let lsmc = lsm_compact(lsm_keys, lsm_vals, lsm_n, ss_keys, ss_vals, ss_n); return "lsm: compacted=" + to_string(lsmc); }
    if cmd == "lsm size"    { return "lsm: n="    + to_string(lsm_size()); }
    if cmd == "lsm sssize"  { return "lsm: ss_n=" + to_string(lsm_ss_size()); }
    if cmd == "lsm seq"     { return "lsm: seq="  + to_string(lsm_seq_num()); }

    // --- WAL ---
    if cmd == "wal init" { wal_init(); return "wal: init"; }
    if cmd == "wal test" { let walr = wal_test(); return "wal: " + to_string(walr); }
    if _starts_with(cmd, "wal begin ") {
        let wabt = to_int(str_sub(cmd, 10, len(cmd)));
        let wabl = wal_begin(wabt);
        return "wal: BEGIN txid=" + to_string(wabt) + " lsn=" + to_string(wabl);
    }
    if _starts_with(cmd, "wal write ") {
        let wawa  = str_sub(cmd, 10, len(cmd));
        let waws0 = _find_space(wawa);
        let wawt  = to_int(str_sub(wawa, 0, waws0));
        let wawa1 = str_sub(wawa, waws0 + 1, len(wawa));
        let waws1 = _find_space(wawa1);
        let wawk  = to_int(str_sub(wawa1, 0, waws1));
        let wawv  = to_int(str_sub(wawa1, waws1 + 1, len(wawa1)));
        let wawl  = wal_write(wawt, wawk, wawv);
        return "wal: WRITE lsn=" + to_string(wawl);
    }
    if _starts_with(cmd, "wal commit ") {
        let wact = to_int(str_sub(cmd, 11, len(cmd)));
        let wacl = wal_commit(wact);
        return "wal: COMMIT txid=" + to_string(wact) + " lsn=" + to_string(wacl);
    }
    if _starts_with(cmd, "wal abort ") {
        let waat = to_int(str_sub(cmd, 10, len(cmd)));
        let waal = wal_abort(waat);
        return "wal: ABORT txid=" + to_string(waat) + " lsn=" + to_string(waal);
    }
    if cmd == "wal ckpt"   { let wckl = wal_checkpoint(); return "wal: CHECKPOINT lsn=" + to_string(wckl); }
    if cmd == "wal replay" { let wrn = wal_replay(wal_checkpoint_lsn); return "wal: redo=" + to_string(wrn); }
    if cmd == "wal nrecs"  { return "wal: n=" + to_string(wal_rec_count()); }
    if cmd == "wal redo"   { return "wal: redo_n=" + to_string(wal_redo_count()); }

    // --- MVCC ---
    if cmd == "mvcc init" { mvcc_init(); return "mvcc: init"; }
    if cmd == "mvcc test" { let mvr = mvcc_test(); return "mvcc: " + to_string(mvr); }
    if _starts_with(cmd, "mvcc write ") {
        let mvwa  = str_sub(cmd, 11, len(cmd));
        let mvws0 = _find_space(mvwa);
        let mvwk  = to_int(str_sub(mvwa, 0, mvws0));
        let mvwa1 = str_sub(mvwa, mvws0 + 1, len(mvwa));
        let mvws1 = _find_space(mvwa1);
        let mvwv  = to_int(str_sub(mvwa1, 0, mvws1));
        let mvwts = to_int(str_sub(mvwa1, mvws1 + 1, len(mvwa1)));
        let mvwid = mvcc_write(mvwk, mvwv, mvwts);
        return "mvcc: wrote ver=" + to_string(mvwid);
    }
    if _starts_with(cmd, "mvcc read ") {
        let mvra  = str_sub(cmd, 10, len(cmd));
        let mvrs  = _find_space(mvra);
        let mvrk  = to_int(str_sub(mvra, 0, mvrs));
        let mvrts = to_int(str_sub(mvra, mvrs + 1, len(mvra)));
        let mvrv  = mvcc_read(mvrk, mvrts);
        return "mvcc: read k=" + to_string(mvrk) + "@" + to_string(mvrts) + "=" + to_string(mvrv);
    }
    if _starts_with(cmd, "mvcc vacuum ") {
        let mvvh = to_int(str_sub(cmd, 12, len(cmd)));
        let mvvr = mvcc_vacuum(mvvh);
        return "mvcc: vacuumed=" + to_string(mvvr);
    }
    if cmd == "mvcc tick"  { let mvt = mvcc_tick(); return "mvcc: clock=" + to_string(mvt); }
    if cmd == "mvcc nver"  { return "mvcc: ver_n="  + to_string(mvcc_ver_count()); }
    if cmd == "mvcc nlive" { return "mvcc: live_n=" + to_string(mvcc_live_count()); }

    // --- Transaction ---
    if cmd == "tx init" { tx_init(); return "tx: init"; }
    if cmd == "tx test" { let txr = tx_test(); return "tx: " + to_string(txr); }
    if cmd == "tx begin" { let tbs = tx_begin(); return "tx: slot=" + to_string(tbs) + " snap=" + to_string(tx_snap_ts[tbs]); }
    if _starts_with(cmd, "tx write ") {
        let txwa  = str_sub(cmd, 9, len(cmd));
        let txws0 = _find_space(txwa);
        let txwsl = to_int(str_sub(txwa, 0, txws0));
        let txwa1 = str_sub(txwa, txws0 + 1, len(txwa));
        let txws1 = _find_space(txwa1);
        let txwk  = to_int(str_sub(txwa1, 0, txws1));
        let txwv  = to_int(str_sub(txwa1, txws1 + 1, len(txwa1)));
        tx_write(txwsl, txwk, txwv);
        return "tx: write slot=" + to_string(txwsl) + " k=" + to_string(txwk);
    }
    if _starts_with(cmd, "tx read ") {
        let txra  = str_sub(cmd, 8, len(cmd));
        let txrs  = _find_space(txra);
        let txrsl = to_int(str_sub(txra, 0, txrs));
        let txrk  = to_int(str_sub(txra, txrs + 1, len(txra)));
        let txrv  = tx_read(txrsl, txrk);
        return "tx: read slot=" + to_string(txrsl) + " k=" + to_string(txrk) + "=" + to_string(txrv);
    }
    if _starts_with(cmd, "tx commit ") {
        let txcsl = to_int(str_sub(cmd, 10, len(cmd)));
        let txcts = tx_commit(txcsl);
        return "tx: commit slot=" + to_string(txcsl) + " cts=" + to_string(txcts);
    }
    if _starts_with(cmd, "tx abort ") {
        let txasl = to_int(str_sub(cmd, 9, len(cmd)));
        tx_abort(txasl);
        return "tx: aborted slot=" + to_string(txasl);
    }
    if _starts_with(cmd, "tx status ") {
        let txssl = to_int(str_sub(cmd, 10, len(cmd)));
        return "tx: status[" + to_string(txssl) + "]=" + to_string(tx_status(txssl));
    }
    if cmd == "tx active" { return "tx: active=" + to_string(tx_active_count()); }

    // --- HashIndex ---
    if cmd == "ih init" { ih_init(); return "ih: init"; }
    if cmd == "ih test" { let ihr = ih_test(); return "ih: " + to_string(ihr); }
    if _starts_with(cmd, "ih insert ") {
        let ihia  = str_sub(cmd, 10, len(cmd));
        let ihis  = _find_space(ihia);
        let ihik  = to_int(str_sub(ihia, 0, ihis));
        let ihir  = to_int(str_sub(ihia, ihis + 1, len(ihia)));
        let ihie  = ih_insert(ihik, ihir);
        return "ih: inserted k=" + to_string(ihik) + " rid=" + to_string(ihir) + " slot=" + to_string(ihie);
    }
    if _starts_with(cmd, "ih lookup ") {
        let ihlk = to_int(str_sub(cmd, 10, len(cmd)));
        let ihlv = ih_lookup(ihlk);
        return "ih: lookup k=" + to_string(ihlk) + " rid=" + to_string(ihlv);
    }
    if _starts_with(cmd, "ih delete ") {
        let ihdk = to_int(str_sub(cmd, 10, len(cmd)));
        let ihdr = ih_delete(ihdk);
        return "ih: delete k=" + to_string(ihdk) + " ok=" + to_string(ihdr);
    }
    if cmd == "ih size" { return "ih: size=" + to_string(ih_size_get()); }
    if cmd == "ih load" { return "ih: load=" + to_string(ih_load_factor()) + "%"; }

    // --- BTreeIndex ---
    if cmd == "ibt init" { ibt_init(); return "ibt: init"; }
    if cmd == "ibt test" { let ibtr = ibt_test(); return "ibt: " + to_string(ibtr); }
    if _starts_with(cmd, "ibt insert ") {
        let ibtia  = str_sub(cmd, 11, len(cmd));
        let ibtis  = _find_space(ibtia);
        let ibtik  = to_int(str_sub(ibtia, 0, ibtis));
        let ibtir  = to_int(str_sub(ibtia, ibtis + 1, len(ibtia)));
        let ibtip  = ibt_insert(ibtik, ibtir);
        return "ibt: inserted k=" + to_string(ibtik) + " pos=" + to_string(ibtip);
    }
    if _starts_with(cmd, "ibt lookup ") {
        let ibtlk = to_int(str_sub(cmd, 11, len(cmd)));
        let ibtlv = ibt_lookup(ibtlk);
        return "ibt: lookup k=" + to_string(ibtlk) + " rid=" + to_string(ibtlv);
    }
    if _starts_with(cmd, "ibt range ") {
        let ibtra  = str_sub(cmd, 10, len(cmd));
        let ibtrs  = _find_space(ibtra);
        let ibtrlo = to_int(str_sub(ibtra, 0, ibtrs));
        let ibtrhi = to_int(str_sub(ibtra, ibtrs + 1, len(ibtra)));
        let ibtrc  = ibt_range_scan(ibtrlo, ibtrhi);
        return "ibt: range[" + to_string(ibtrlo) + "," + to_string(ibtrhi) + "]=" + to_string(ibtrc);
    }
    if cmd == "ibt size" { return "ibt: keys=" + to_string(ibt_size()); }
    if cmd == "ibt scan" { return "ibt: scan_n=" + to_string(ibt_scan_n()); }

    // --- QueryPlan ---
    if cmd == "qp init" { qp_init(); return "qp: init"; }
    if cmd == "qp test" { let qpr = qp_test(); return "qp: " + to_string(qpr); }
    if _starts_with(cmd, "qp scan ") {
        let qpsa  = str_sub(cmd, 8, len(cmd));
        let qpss0 = _find_space(qpsa);
        let qpst  = to_int(str_sub(qpsa, 0, qpss0));
        let qpsa1 = str_sub(qpsa, qpss0 + 1, len(qpsa));
        let qpss1 = _find_space(qpsa1);
        let qpsn  = to_int(str_sub(qpsa1, 0, qpss1));
        let qpsa2 = str_sub(qpsa1, qpss1 + 1, len(qpsa1));
        let qpss2 = _find_space(qpsa2);
        let qpsix = to_int(str_sub(qpsa2, 0, qpss2));
        let qpssl = to_int(str_sub(qpsa2, qpss2 + 1, len(qpsa2)));
        let qpsnd = qp_scan(qpst, qpsn, qpsix, qpssl);
        return "qp: scan node=" + to_string(qpsnd) + " cost=" + to_string(qp_cost[qpsnd]);
    }
    if _starts_with(cmd, "qp join ") {
        let qpja  = str_sub(cmd, 8, len(cmd));
        let qpjs  = _find_space(qpja);
        let qpjl  = to_int(str_sub(qpja, 0, qpjs));
        let qpjr  = to_int(str_sub(qpja, qpjs + 1, len(qpja)));
        let qpjnd = qp_join(qpjl, qpjr);
        return "qp: join node=" + to_string(qpjnd) + " cost=" + to_string(qp_cost[qpjnd]);
    }
    if _starts_with(cmd, "qp sort ") {
        let qpsrnd = to_int(str_sub(cmd, 8, len(cmd)));
        let qpsrn  = qp_sort(qpsrnd);
        return "qp: sort node=" + to_string(qpsrn) + " cost=" + to_string(qp_cost[qpsrn]);
    }
    if _starts_with(cmd, "qp agg ") {
        let qpaga  = str_sub(cmd, 7, len(cmd));
        let qpags  = _find_space(qpaga);
        let qpagc  = to_int(str_sub(qpaga, 0, qpags));
        let qpagg  = to_int(str_sub(qpaga, qpags + 1, len(qpaga)));
        let qpagn  = qp_agg(qpagc, qpagg);
        return "qp: agg node=" + to_string(qpagn) + " groups=" + to_string(qpagg);
    }
    if _starts_with(cmd, "qp filter ") {
        let qpfla  = str_sub(cmd, 10, len(cmd));
        let qpfls  = _find_space(qpfla);
        let qpflc  = to_int(str_sub(qpfla, 0, qpfls));
        let qpfls2 = to_int(str_sub(qpfla, qpfls + 1, len(qpfla)));
        let qpfln  = qp_filter(qpflc, qpfls2);
        return "qp: filter node=" + to_string(qpfln);
    }
    if cmd == "qp explain" { qp_explain(qp_root); return "qp: explained"; }
    if _starts_with(cmd, "qp cost ") {
        let qpcnd = to_int(str_sub(cmd, 8, len(cmd)));
        return "qp: cost[" + to_string(qpcnd) + "]=" + to_string(qp_total_cost(qpcnd));
    }
    if cmd == "qp nodes" { return "qp: nodes=" + to_string(qp_node_count()); }

    // --- DBEngine ---
    if cmd == "dbe init" { dbeng_init(); return "dbe: init"; }
    if cmd == "dbe test" { let dber = db_test(); return "dbe: " + to_string(dber); }
    if _starts_with(cmd, "dbe create ") {
        let dbeca = str_sub(cmd, 11, len(cmd));
        let dbes0 = _find_space(dbeca);
        let dbet  = to_int(str_sub(dbeca, 0, dbes0));
        let dben  = to_int(str_sub(dbeca, dbes0 + 1, len(dbeca)));
        db_create_table(dbet, dben);
        return "dbe: created table=" + to_string(dbet) + " ncols=" + to_string(dben);
    }
    if _starts_with(cmd, "dbe insert ") {
        let dbiia = str_sub(cmd, 11, len(cmd));
        let dbis0 = _find_space(dbiia);
        let dbiti = to_int(str_sub(dbiia, 0, dbis0));
        let dbia1 = str_sub(dbiia, dbis0 + 1, len(dbiia));
        let dbis1 = _find_space(dbia1);
        let dbic0 = to_int(str_sub(dbia1, 0, dbis1));
        let dbia2 = str_sub(dbia1, dbis1 + 1, len(dbia1));
        let dbis2 = _find_space(dbia2);
        let dbic1 = to_int(str_sub(dbia2, 0, dbis2));
        let dbia3 = str_sub(dbia2, dbis2 + 1, len(dbia2));
        let dbis3 = _find_space(dbia3);
        let dbic2 = to_int(str_sub(dbia3, 0, dbis3));
        let dbic3 = to_int(str_sub(dbia3, dbis3 + 1, len(dbia3)));
        let dbrid = db_insert(dbiti, dbic0, dbic1, dbic2, dbic3);
        return "dbe: inserted rid=" + to_string(dbrid);
    }
    if _starts_with(cmd, "dbe select ") {
        let dbsea = str_sub(cmd, 11, len(cmd));
        let dbes0 = _find_space(dbsea);
        let dbset = to_int(str_sub(dbsea, 0, dbes0));
        let dbsea1= str_sub(dbsea, dbes0 + 1, len(dbsea));
        let dbes1 = _find_space(dbsea1);
        let dbsec = to_int(str_sub(dbsea1, 0, dbes1));
        let dbsev = to_int(str_sub(dbsea1, dbes1 + 1, len(dbsea1)));
        let dbser = db_select_eq(dbset, dbsec, dbsev);
        return "dbe: rid=" + to_string(dbser) + " scan=" + to_string(db_last_scan());
    }
    if _starts_with(cmd, "dbe range ") {
        let dbrga = str_sub(cmd, 10, len(cmd));
        let dbrgs0= _find_space(dbrga);
        let dbrgt = to_int(str_sub(dbrga, 0, dbrgs0));
        let dbrga1= str_sub(dbrga, dbrgs0 + 1, len(dbrga));
        let dbrgs1= _find_space(dbrga1);
        let dbrgc = to_int(str_sub(dbrga1, 0, dbrgs1));
        let dbrga2= str_sub(dbrga1, dbrgs1 + 1, len(dbrga1));
        let dbrgs2= _find_space(dbrga2);
        let dbrgl = to_int(str_sub(dbrga2, 0, dbrgs2));
        let dbrgh = to_int(str_sub(dbrga2, dbrgs2 + 1, len(dbrga2)));
        let dbrgn = db_select_range(dbrgt, dbrgc, dbrgl, dbrgh);
        return "dbe: range_count=" + to_string(dbrgn);
    }
    if _starts_with(cmd, "dbe index ") {
        let dbeit = to_int(str_sub(cmd, 10, len(cmd)));
        db_create_index(dbeit);
        return "dbe: index built on table=" + to_string(dbeit);
    }

    // --- WireGuard ---
    if cmd == "wg init" { wg_init(); return "wg: init"; }
    if cmd == "wg test" { let wgr = wg_test(); return "wg: " + to_string(wgr); }
    if _starts_with(cmd, "wg addpeer ") {
        let wgaa  = str_sub(cmd, 11, len(cmd));
        let wgas0 = _find_space(wgaa);
        let wgprv = to_int(str_sub(wgaa, 0, wgas0));
        let wgaa1 = str_sub(wgaa, wgas0 + 1, len(wgaa));
        let wgas1 = _find_space(wgaa1);
        let wgpub = to_int(str_sub(wgaa1, 0, wgas1));
        let wgpsk = to_int(str_sub(wgaa1, wgas1 + 1, len(wgaa1)));
        let wgid  = wg_add_peer(wgprv, wgpub, wgpsk);
        return "wg: peer id=" + to_string(wgid);
    }
    if _starts_with(cmd, "wg handshake ") {
        let wghid = to_int(str_sub(cmd, 13, len(cmd)));
        wg_handshake_init(wghid);
        return "wg: handshake init sent id=" + to_string(wghid);
    }
    if _starts_with(cmd, "wg establish ") {
        let wgeid = to_int(str_sub(cmd, 13, len(cmd)));
        let wgesk = wg_establish(wgeid);
        return "wg: established sk=" + to_string(wgesk);
    }
    if _starts_with(cmd, "wg encrypt ") {
        let wgena = str_sub(cmd, 11, len(cmd));
        let wgens = _find_space(wgena);
        let wgeni = to_int(str_sub(wgena, 0, wgens));
        let wgenp = to_int(str_sub(wgena, wgens + 1, len(wgena)));
        let wgenct= wg_encrypt(wgeni, wgenp);
        return "wg: ct=" + to_string(wgenct);
    }
    if _starts_with(cmd, "wg decrypt ") {
        let wgdca = str_sub(cmd, 11, len(cmd));
        let wgdcs0= _find_space(wgdca);
        let wgdci = to_int(str_sub(wgdca, 0, wgdcs0));
        let wgdca1= str_sub(wgdca, wgdcs0 + 1, len(wgdca));
        let wgdcs1= _find_space(wgdca1);
        let wgdcct= to_int(str_sub(wgdca1, 0, wgdcs1));
        let wgdccr= to_int(str_sub(wgdca1, wgdcs1 + 1, len(wgdca1)));
        let wgdcpt= wg_decrypt(wgdci, wgdcct, wgdccr);
        return "wg: pt=" + to_string(wgdcpt);
    }

    // --- TLS 1.3 ---
    if cmd == "tls init" { tls_init(); return "tls: init"; }
    if cmd == "tls test" { let tlsr = tls_test(); return "tls: " + to_string(tlsr); }
    if cmd == "tls new"  { let tlsid = tls_new_session(); return "tls: sid=" + to_string(tlsid); }
    if _starts_with(cmd, "tls hello ") {
        let tlsha  = str_sub(cmd, 10, len(cmd));
        let tlshs0 = _find_space(tlsha);
        let tlshsi = to_int(str_sub(tlsha, 0, tlshs0));
        let tlsha1 = str_sub(tlsha, tlshs0 + 1, len(tlsha));
        let tlshs1 = _find_space(tlsha1);
        let tlshrn = to_int(str_sub(tlsha1, 0, tlshs1));
        let tlshep = to_int(str_sub(tlsha1, tlshs1 + 1, len(tlsha1)));
        let tlshpb = tls_client_hello(tlshsi, tlshrn, tlshep);
        return "tls: epub=" + to_string(tlshpb);
    }
    if _starts_with(cmd, "tls shello ") {
        let tlssha  = str_sub(cmd, 11, len(cmd));
        let tlsshs0 = _find_space(tlssha);
        let tlsshsi = to_int(str_sub(tlssha, 0, tlsshs0));
        let tlssha1 = str_sub(tlssha, tlsshs0 + 1, len(tlssha));
        let tlsshs1 = _find_space(tlssha1);
        let tlsshrn = to_int(str_sub(tlssha1, 0, tlsshs1));
        let tlsshsp = to_int(str_sub(tlssha1, tlsshs1 + 1, len(tlssha1)));
        let tlsshck = tls_server_hello(tlsshsi, tlsshrn, tlsshsp);
        return "tls: ck=" + to_string(tlsshck);
    }
    if _starts_with(cmd, "tls finish ") {
        let tlsfsi = to_int(str_sub(cmd, 11, len(cmd)));
        tls_handshake_finish(tlsfsi);
        return "tls: established sid=" + to_string(tlsfsi);
    }
    if _starts_with(cmd, "tls send ") {
        let tlssna = str_sub(cmd, 9, len(cmd));
        let tlssns = _find_space(tlssna);
        let tlssnsi= to_int(str_sub(tlssna, 0, tlssns));
        let tlssnpt= to_int(str_sub(tlssna, tlssns + 1, len(tlssna)));
        let tlssnct= tls_send(tlssnsi, tlssnpt);
        return "tls: ct=" + to_string(tlssnct);
    }

    // --- HTTP/3 over QUIC ---
    if cmd == "h3q init" { h3_init(); return "h3q: init"; }
    if cmd == "h3q test" { let h3r = h3_test(); return "h3q: " + to_string(h3r); }
    if _starts_with(cmd, "h3q connect ") {
        let h3ca  = str_sub(cmd, 12, len(cmd));
        let h3cs0 = _find_space(h3ca);
        let h3cid = to_int(str_sub(h3ca, 0, h3cs0));
        let h3csv = to_int(str_sub(h3ca, h3cs0 + 1, len(h3ca)));
        let h3cst = h3_connect(h3cid, h3csv);
        return "h3q: state=" + to_string(h3cst);
    }
    if _starts_with(cmd, "h3q get ") {
        let h3ga  = str_sub(cmd, 8, len(cmd));
        let h3gs0 = _find_space(h3ga);
        let h3gci = to_int(str_sub(h3ga, 0, h3gs0));
        let h3gph = to_int(str_sub(h3ga, h3gs0 + 1, len(h3ga)));
        let h3gsi = h3_get(h3gci, h3gph);
        return "h3q: stream=" + to_string(h3gsi) + " status=" + to_string(h3_recv_status(h3gci, h3gsi));
    }
    if _starts_with(cmd, "h3q post ") {
        let h3pa  = str_sub(cmd, 9, len(cmd));
        let h3ps0 = _find_space(h3pa);
        let h3pci = to_int(str_sub(h3pa, 0, h3ps0));
        let h3pa1 = str_sub(h3pa, h3ps0 + 1, len(h3pa));
        let h3ps1 = _find_space(h3pa1);
        let h3pph = to_int(str_sub(h3pa1, 0, h3ps1));
        let h3pbh = to_int(str_sub(h3pa1, h3ps1 + 1, len(h3pa1)));
        let h3psi = h3_post(h3pci, h3pph, h3pbh);
        return "h3q: stream=" + to_string(h3psi) + " data=" + to_string(h3_recv_data(h3pci, h3psi));
    }
    if _starts_with(cmd, "h3q status ") {
        let h3ssa  = str_sub(cmd, 11, len(cmd));
        let h3sss0 = _find_space(h3ssa);
        let h3ssci = to_int(str_sub(h3ssa, 0, h3sss0));
        let h3sssi = to_int(str_sub(h3ssa, h3sss0 + 1, len(h3ssa)));
        return "h3q: status=" + to_string(h3_recv_status(h3ssci, h3sssi));
    }
    if _starts_with(cmd, "h3q close ") {
        let h3clci = to_int(str_sub(cmd, 10, len(cmd)));
        h3_close(h3clci);
        return "h3q: closed cid=" + to_string(h3clci);
    }

    // --- DNS over HTTPS ---
    if cmd == "doh init" { doh_init(); return "doh: init"; }
    if cmd == "doh test" { let dohr = doh_test(); return "doh: " + to_string(dohr); }
    if _starts_with(cmd, "doh query ") {
        let dohqa  = str_sub(cmd, 10, len(cmd));
        let dohqs0 = _find_space(dohqa);
        let dohqd  = to_int(str_sub(dohqa, 0, dohqs0));
        let dohqt  = to_int(str_sub(dohqa, dohqs0 + 1, len(dohqa)));
        let dohqr  = doh_query(dohqd, dohqt);
        return "doh: rdata=" + to_string(dohqr);
    }
    if cmd == "doh cache" { return "doh: cache_size=" + to_string(doh_cache_size()); }
    if _starts_with(cmd, "doh server ") {
        let dohsh = to_int(str_sub(cmd, 11, len(cmd)));
        let dohsi = doh_set_server(dohsh);
        return "doh: server added id=" + to_string(dohsi);
    }
    if cmd == "doh flush" { doh_flush(); return "doh: cache flushed"; }
    if cmd == "doh tick"  { let exp = doh_tick(); return "doh: expired=" + to_string(exp); }

    // --- Kademlia DHT ---
    if cmd == "dht init" { dht_init(); return "dht: init"; }
    if cmd == "dht test" { let dhtr = dht_test(); return "dht: " + to_string(dhtr); }
    if _starts_with(cmd, "dht self ") {
        let dhtsi = to_int(str_sub(cmd, 9, len(cmd)));
        dht_set_self(dhtsi);
        return "dht: self=" + to_string(dhtsi);
    }
    if _starts_with(cmd, "dht add ") {
        let dhtaa  = str_sub(cmd, 8, len(cmd));
        let dhtas0 = _find_space(dhtaa);
        let dhtaid = to_int(str_sub(dhtaa, 0, dhtas0));
        let dhtaad = to_int(str_sub(dhtaa, dhtas0 + 1, len(dhtaa)));
        let dhtani = dht_add_node(dhtaid, dhtaad);
        return "dht: node_idx=" + to_string(dhtani);
    }
    if _starts_with(cmd, "dht put ") {
        let dhtpa  = str_sub(cmd, 8, len(cmd));
        let dhtps0 = _find_space(dhtpa);
        let dhtpk  = to_int(str_sub(dhtpa, 0, dhtps0));
        let dhtpv  = to_int(str_sub(dhtpa, dhtps0 + 1, len(dhtpa)));
        dht_store(dhtpk, dhtpv);
        return "dht: stored k=" + to_string(dhtpk);
    }
    if _starts_with(cmd, "dht get ") {
        let dhtgk = to_int(str_sub(cmd, 8, len(cmd)));
        let dhtgv = dht_lookup(dhtgk);
        return "dht: val=" + to_string(dhtgv);
    }
    if _starts_with(cmd, "dht find ") {
        let dhtft = to_int(str_sub(cmd, 9, len(cmd)));
        let dhtfn = dht_find_node(dhtft);
        return "dht: closest_count=" + to_string(dhtfn);
    }

    // --- BitTorrent ---
    if cmd == "bt init" { bt_init(); return "bt: init"; }
    if cmd == "bt test" { let btr = bt_test(); return "bt: " + to_string(btr); }
    if _starts_with(cmd, "bt torrent ") {
        let bttra  = str_sub(cmd, 11, len(cmd));
        let btts0  = _find_space(bttra);
        let bttih  = to_int(str_sub(bttra, 0, btts0));
        let bttra1 = str_sub(bttra, btts0 + 1, len(bttra));
        let btts1  = _find_space(bttra1);
        let bttln  = to_int(str_sub(bttra1, 0, btts1));
        let bttra2 = str_sub(bttra1, btts1 + 1, len(bttra1));
        let btts2  = _find_space(bttra2);
        let bttnp  = to_int(str_sub(bttra2, 0, btts2));
        let bttps  = to_int(str_sub(bttra2, btts2 + 1, len(bttra2)));
        bt_set_torrent(bttih, bttln, bttnp, bttps);
        return "bt: torrent set pieces=" + to_string(bttnp);
    }
    if _starts_with(cmd, "bt addpeer ") {
        let btaph = to_int(str_sub(cmd, 11, len(cmd)));
        let btapi = bt_add_peer(btaph);
        return "bt: peer id=" + to_string(btapi);
    }
    if _starts_with(cmd, "bt handshake ") {
        let bthsi = to_int(str_sub(cmd, 13, len(cmd)));
        let bthsr = bt_handshake(bthsi);
        return "bt: state=" + to_string(bthsr);
    }
    if _starts_with(cmd, "bt request ") {
        let btrqa  = str_sub(cmd, 11, len(cmd));
        let btrqs0 = _find_space(btrqa);
        let btrqpi = to_int(str_sub(btrqa, 0, btrqs0));
        let btrqpc = to_int(str_sub(btrqa, btrqs0 + 1, len(btrqa)));
        let btrqv  = bt_request_piece(btrqpi, btrqpc);
        return "bt: piece_data=" + to_string(btrqv);
    }
    if cmd == "bt progress" {
        return "bt: progress=" + to_string(bt_download_progress()) + "/10000 complete=" + to_string(bt_complete_count());
    }

    // --- OpenTelemetry ---
    if cmd == "otel init" { otel_init(); return "otel: init"; }
    if cmd == "otel test" { let otr = otel_test(); return "otel: " + to_string(otr); }
    if cmd == "otel trace" {
        let otid = otel_trace_new();
        return "otel: trace_idx=" + to_string(otid);
    }
    if _starts_with(cmd, "otel span ") {
        let otsa  = str_sub(cmd, 10, len(cmd));
        let otss0 = _find_space(otsa);
        let otstid= to_int(str_sub(otsa, 0, otss0));
        let otsa1 = str_sub(otsa, otss0 + 1, len(otsa));
        let otss1 = _find_space(otsa1);
        let otspar= to_int(str_sub(otsa1, 0, otss1));
        let otsnm = to_int(str_sub(otsa1, otss1 + 1, len(otsa1)));
        let otssl = otel_span_start(otstid, otspar, otsnm);
        return "otel: span_slot=" + to_string(otssl);
    }
    if _starts_with(cmd, "otel attr ") {
        let otaa  = str_sub(cmd, 10, len(cmd));
        let otas0 = _find_space(otaa);
        let otasl = to_int(str_sub(otaa, 0, otas0));
        let otaa1 = str_sub(otaa, otas0 + 1, len(otaa));
        let otas1 = _find_space(otaa1);
        let otakv = to_int(str_sub(otaa1, 0, otas1));
        let otavv = to_int(str_sub(otaa1, otas1 + 1, len(otaa1)));
        otel_span_attr(otasl, otakv, otavv);
        return "otel: attr added";
    }
    if _starts_with(cmd, "otel end ") {
        let otens = to_int(str_sub(cmd, 9, len(cmd)));
        let otend = otel_span_end(otens);
        return "otel: duration=" + to_string(otend);
    }
    if cmd == "otel export" {
        let oten = otel_export();
        return "otel: exported=" + to_string(oten);
    }

    // --- Prometheus ---
    if cmd == "pm init" { pm_init(); return "pm: init"; }
    if cmd == "pm test" { let pmr = pm_test(); return "pm: " + to_string(pmr); }
    if _starts_with(cmd, "pm counter ") {
        let pmcn = to_int(str_sub(cmd, 11, len(cmd)));
        let pmci = pm_counter(pmcn);
        return "pm: counter id=" + to_string(pmci);
    }
    if _starts_with(cmd, "pm gauge ") {
        let pmgn = to_int(str_sub(cmd, 9, len(cmd)));
        let pmgi = pm_gauge(pmgn);
        return "pm: gauge id=" + to_string(pmgi);
    }
    if _starts_with(cmd, "pm set ") {
        let pmsa  = str_sub(cmd, 7, len(cmd));
        let pmss0 = _find_space(pmsa);
        let pmsid = to_int(str_sub(pmsa, 0, pmss0));
        let pmsv  = to_int(str_sub(pmsa, pmss0 + 1, len(pmsa)));
        pm_set(pmsid, pmsv);
        return "pm: set id=" + to_string(pmsid) + " val=" + to_string(pmsv);
    }
    if _starts_with(cmd, "pm observe ") {
        let pmoa  = str_sub(cmd, 11, len(cmd));
        let pmos0 = _find_space(pmoa);
        let pmoid = to_int(str_sub(pmoa, 0, pmos0));
        let pmov  = to_int(str_sub(pmoa, pmos0 + 1, len(pmoa)));
        pm_observe(pmoid, pmov);
        return "pm: observed";
    }
    if _starts_with(cmd, "pm quantile ") {
        let pmqа  = str_sub(cmd, 12, len(cmd));
        let pmqs0 = _find_space(pmqа);
        let pmqid = to_int(str_sub(pmqа, 0, pmqs0));
        let pmqpct= to_int(str_sub(pmqа, pmqs0 + 1, len(pmqа)));
        let pmqv  = pm_quantile(pmqid, pmqpct);
        return "pm: p" + to_string(pmqpct) + "=" + to_string(pmqv);
    }

    // --- gRPC Streaming ---
    if cmd == "gs init" { gs_init(); return "gs: init"; }
    if cmd == "gs test" { let gsr = gs_test(); return "gs: " + to_string(gsr); }
    if _starts_with(cmd, "gs open ") {
        let gsoa  = str_sub(cmd, 8, len(cmd));
        let gsos0 = _find_space(gsoa);
        let gsosv = to_int(str_sub(gsoa, 0, gsos0));
        let gsoa1 = str_sub(gsoa, gsos0 + 1, len(gsoa));
        let gsos1 = _find_space(gsoa1);
        let gsomh = to_int(str_sub(gsoa1, 0, gsos1));
        let gsotp = to_int(str_sub(gsoa1, gsos1 + 1, len(gsoa1)));
        let gsoid = gs_open(gsosv, gsomh, gsotp);
        return "gs: stream_id=" + to_string(gsoid);
    }
    if _starts_with(cmd, "gs send ") {
        let gssa  = str_sub(cmd, 8, len(cmd));
        let gsss0 = _find_space(gssa);
        let gssid = to_int(str_sub(gssa, 0, gsss0));
        let gssmh = to_int(str_sub(gssa, gsss0 + 1, len(gssa)));
        let gssq  = gs_send(gssid, gssmh);
        return "gs: sent seq=" + to_string(gssq);
    }
    if _starts_with(cmd, "gs recv ") {
        let gsrid = to_int(str_sub(cmd, 8, len(cmd)));
        let gsrm  = gs_recv(gsrid);
        return "gs: msg=" + to_string(gsrm);
    }
    if _starts_with(cmd, "gs close ") {
        let gscid = to_int(str_sub(cmd, 9, len(cmd)));
        let gscst = gs_close(gscid);
        return "gs: status=" + to_string(gscst);
    }
    if _starts_with(cmd, "gs status ") {
        let gstsid = to_int(str_sub(cmd, 10, len(cmd)));
        return "gs: state=" + to_string(gs_stream_state(gstsid)) + " sent=" + to_string(gs_sent_count(gstsid));
    }

    // --- WebSocket Compression ---
    if cmd == "wc init" { wc_init(); return "wc: init"; }
    if cmd == "wc test" { let wcr = wc_test(); return "wc: " + to_string(wcr); }
    if _starts_with(cmd, "wc connect ") {
        let wcctk = to_int(str_sub(cmd, 11, len(cmd)));
        let wccid = wc_connect(wcctk);
        return "wc: conn_id=" + to_string(wccid);
    }
    if _starts_with(cmd, "wc compress ") {
        let wcca  = str_sub(cmd, 12, len(cmd));
        let wccs0 = _find_space(wcca);
        let wccid = to_int(str_sub(wcca, 0, wccs0));
        let wcca1 = str_sub(wcca, wccs0 + 1, len(wcca));
        let wccs1 = _find_space(wcca1);
        let wccdh = to_int(str_sub(wcca1, 0, wccs1));
        let wccdl = to_int(str_sub(wcca1, wccs1 + 1, len(wcca1)));
        let wccl  = wc_compress(wccid, wccdh, wccdl);
        return "wc: comp_len=" + to_string(wccl);
    }
    if _starts_with(cmd, "wc decompress ") {
        let wcdca  = str_sub(cmd, 14, len(cmd));
        let wcdcs0 = _find_space(wcdca);
        let wcdcid = to_int(str_sub(wcdca, 0, wcdcs0));
        let wcdca1 = str_sub(wcdca, wcdcs0 + 1, len(wcdca));
        let wcdcs1 = _find_space(wcdca1);
        let wcdcch = to_int(str_sub(wcdca1, 0, wcdcs1));
        let wcdccl = to_int(str_sub(wcdca1, wcdcs1 + 1, len(wcdca1)));
        let wcdcv  = wc_decompress(wcdcid, wcdcch, wcdccl);
        return "wc: decomp_hash=" + to_string(wcdcv);
    }
    if _starts_with(cmd, "wc ratio ") {
        let wcrid = to_int(str_sub(cmd, 9, len(cmd)));
        return "wc: ratio=" + to_string(wc_ratio(wcrid));
    }
    if _starts_with(cmd, "wc reset ") {
        let wcreid = to_int(str_sub(cmd, 9, len(cmd)));
        wc_reset(wcreid);
        return "wc: window reset";
    }

    // --- Conv2D ---
    if cmd == "cv init" { cv_init(); return "cv: init"; }
    if cmd == "cv test" { let cvr = cv_test(); return "cv: " + to_string(cvr); }
    if _starts_with(cmd, "cv setinput ") {
        let cvia  = str_sub(cmd, 12, len(cmd));
        let cvis0 = _find_space(cvia);
        let cvir  = to_int(str_sub(cvia, 0, cvis0));
        let cvia1 = str_sub(cvia, cvis0 + 1, len(cvia));
        let cvis1 = _find_space(cvia1);
        let cvic  = to_int(str_sub(cvia1, 0, cvis1));
        let cvia2 = str_sub(cvia1, cvis1 + 1, len(cvia1));
        let cvis2 = _find_space(cvia2);
        let cvicc = to_int(str_sub(cvia2, 0, cvis2));
        let cviv  = to_int(str_sub(cvia2, cvis2 + 1, len(cvia2)));
        cv_set_input(cvir, cvic, cvicc, cviv);
        return "cv: input set";
    }
    if _starts_with(cmd, "cv setkernel ") {
        let cvka  = str_sub(cmd, 13, len(cmd));
        let cvks0 = _find_space(cvka);
        let cvkoc = to_int(str_sub(cvka, 0, cvks0));
        let cvka1 = str_sub(cvka, cvks0 + 1, len(cvka));
        let cvks1 = _find_space(cvka1);
        let cvkic = to_int(str_sub(cvka1, 0, cvks1));
        let cvka2 = str_sub(cvka1, cvks1 + 1, len(cvka1));
        let cvks2 = _find_space(cvka2);
        let cvkkr = to_int(str_sub(cvka2, 0, cvks2));
        let cvka3 = str_sub(cvka2, cvks2 + 1, len(cvka2));
        let cvks3 = _find_space(cvka3);
        let cvkkc = to_int(str_sub(cvka3, 0, cvks3));
        let cvkv  = to_int(str_sub(cvka3, cvks3 + 1, len(cvka3)));
        cv_set_kernel(cvkoc, cvkic, cvkkr, cvkkc, cvkv);
        return "cv: kernel set";
    }
    if _starts_with(cmd, "cv forward ") {
        let cvfa  = str_sub(cmd, 11, len(cmd));
        let cvfs0 = _find_space(cvfa);
        let cvfic = to_int(str_sub(cvfa, 0, cvfs0));
        let cvfa1 = str_sub(cvfa, cvfs0 + 1, len(cvfa));
        let cvfs1 = _find_space(cvfa1);
        let cvfoc = to_int(str_sub(cvfa1, 0, cvfs1));
        let cvfks = to_int(str_sub(cvfa1, cvfs1 + 1, len(cvfa1)));
        let cvfn  = conv2d_forward(cvfic, cvfoc, cvfks, 1, 1);
        return "cv: out_elements=" + to_string(cvfn);
    }
    if _starts_with(cmd, "cv output ") {
        let cvoa  = str_sub(cmd, 10, len(cmd));
        let cvos0 = _find_space(cvoa);
        let cvor  = to_int(str_sub(cvoa, 0, cvos0));
        let cvoa1 = str_sub(cvoa, cvos0 + 1, len(cvoa));
        let cvos1 = _find_space(cvoa1);
        let cvoc  = to_int(str_sub(cvoa1, 0, cvos1));
        let cvocc = to_int(str_sub(cvoa1, cvos1 + 1, len(cvoa1)));
        return "cv: output=" + to_string(cv_get_output(cvor, cvoc, cvocc));
    }
    if cmd == "cv info" {
        return "cv: h=" + to_string(cv_output_h()) + " w=" + to_string(cv_output_w()) + " ch=" + to_string(cv_output_ch());
    }

    // --- Pooling ---
    if cmd == "pool init" { pl_init(); return "pool: init"; }
    if cmd == "pool test" { let plr = pool_test(); return "pool: " + to_string(plr); }
    if _starts_with(cmd, "pool set ") {
        let plsa  = str_sub(cmd, 9, len(cmd));
        let plss0 = _find_space(plsa);
        let plsr  = to_int(str_sub(plsa, 0, plss0));
        let plsa1 = str_sub(plsa, plss0 + 1, len(plsa));
        let plss1 = _find_space(plsa1);
        let plsc  = to_int(str_sub(plsa1, 0, plss1));
        let plsa2 = str_sub(plsa1, plss1 + 1, len(plsa1));
        let plss2 = _find_space(plsa2);
        let plsch = to_int(str_sub(plsa2, 0, plss2));
        let plsv  = to_int(str_sub(plsa2, plss2 + 1, len(plsa2)));
        pl_set_input(plsr, plsc, plsch, plsv);
        return "pool: input set";
    }
    if _starts_with(cmd, "pool get ") {
        let plga  = str_sub(cmd, 9, len(cmd));
        let plgs0 = _find_space(plga);
        let plgr  = to_int(str_sub(plga, 0, plgs0));
        let plga1 = str_sub(plga, plgs0 + 1, len(plga));
        let plgs1 = _find_space(plga1);
        let plgc  = to_int(str_sub(plga1, 0, plgs1));
        let plgch = to_int(str_sub(plga1, plgs1 + 1, len(plga1)));
        return "pool: " + to_string(pl_get_output(plgr, plgc, plgch));
    }
    if _starts_with(cmd, "pool max ") {
        let plma  = str_sub(cmd, 9, len(cmd));
        let plms0 = _find_space(plma);
        let plmic = to_int(str_sub(plma, 0, plms0));
        let plma1 = str_sub(plma, plms0 + 1, len(plma));
        let plms1 = _find_space(plma1);
        let plmps = to_int(str_sub(plma1, 0, plms1));
        let plmst = to_int(str_sub(plma1, plms1 + 1, len(plma1)));
        let plmn  = pool_max_forward(plmic, plmps, plmst);
        return "pool: max elements=" + to_string(plmn);
    }
    if _starts_with(cmd, "pool avg ") {
        let plaa  = str_sub(cmd, 9, len(cmd));
        let plas0 = _find_space(plaa);
        let plaic = to_int(str_sub(plaa, 0, plas0));
        let plaa1 = str_sub(plaa, plas0 + 1, len(plaa));
        let plas1 = _find_space(plaa1);
        let plaps = to_int(str_sub(plaa1, 0, plas1));
        let plast = to_int(str_sub(plaa1, plas1 + 1, len(plaa1)));
        let plan  = pool_avg_forward(plaic, plaps, plast);
        return "pool: avg elements=" + to_string(plan);
    }
    if cmd == "pool info" {
        return "pool: h=" + to_string(pl_output_h()) + " w=" + to_string(pl_output_w()) + " ch=" + to_string(pl_output_ch());
    }

    // --- RNN ---
    if cmd == "rnn init" { rn_init(); return "rnn: init"; }
    if cmd == "rnn test" { let rnr = rnn_test(); return "rnn: " + to_string(rnr); }
    if _starts_with(cmd, "rnn wxh ") {
        let rnxa  = str_sub(cmd, 8, len(cmd));
        let rnxs0 = _find_space(rnxa);
        let rnxi  = to_int(str_sub(rnxa, 0, rnxs0));
        let rnxa1 = str_sub(rnxa, rnxs0 + 1, len(rnxa));
        let rnxs1 = _find_space(rnxa1);
        let rnxj  = to_int(str_sub(rnxa1, 0, rnxs1));
        let rnxv  = to_int(str_sub(rnxa1, rnxs1 + 1, len(rnxa1)));
        rn_set_wxh(rnxi, rnxj, rnxv);
        return "rnn: W_xh set";
    }
    if _starts_with(cmd, "rnn whh ") {
        let rnha  = str_sub(cmd, 8, len(cmd));
        let rnhs0 = _find_space(rnha);
        let rnhi  = to_int(str_sub(rnha, 0, rnhs0));
        let rnha1 = str_sub(rnha, rnhs0 + 1, len(rnha));
        let rnhs1 = _find_space(rnha1);
        let rnhj  = to_int(str_sub(rnha1, 0, rnhs1));
        let rnhv  = to_int(str_sub(rnha1, rnhs1 + 1, len(rnha1)));
        rn_set_whh(rnhi, rnhj, rnhv);
        return "rnn: W_hh set";
    }
    if _starts_with(cmd, "rnn input ") {
        let rnia  = str_sub(cmd, 10, len(cmd));
        let rnis0 = _find_space(rnia);
        let rnii  = to_int(str_sub(rnia, 0, rnis0));
        let rniv  = to_int(str_sub(rnia, rnis0 + 1, len(rnia)));
        rn_set_input(rnii, rniv);
        return "rnn: input set";
    }
    if cmd == "rnn step" { let rnst = rnn_step(); return "rnn: h0=" + to_string(rnst); }
    if _starts_with(cmd, "rnn hidden ") {
        let rnhid = to_int(str_sub(cmd, 11, len(cmd)));
        return "rnn: hidden[" + to_string(rnhid) + "]=" + to_string(rn_get_hidden(rnhid));
    }

    // --- LSTM ---
    if cmd == "lstm init" { lm_init(); return "lstm: init"; }
    if cmd == "lstm test" { let lmr = lstm_test(); return "lstm: " + to_string(lmr); }
    if _starts_with(cmd, "lstm wxi ") {
        let lxia  = str_sub(cmd, 9, len(cmd));
        let lxis0 = _find_space(lxia);
        let lxii  = to_int(str_sub(lxia, 0, lxis0));
        let lxia1 = str_sub(lxia, lxis0 + 1, len(lxia));
        let lxis1 = _find_space(lxia1);
        let lxij  = to_int(str_sub(lxia1, 0, lxis1));
        let lxiv  = to_int(str_sub(lxia1, lxis1 + 1, len(lxia1)));
        lm_set_wxi(lxii, lxij, lxiv);
        return "lstm: W_xi set";
    }
    if _starts_with(cmd, "lstm wxg ") {
        let lxga  = str_sub(cmd, 9, len(cmd));
        let lxgs0 = _find_space(lxga);
        let lxgi  = to_int(str_sub(lxga, 0, lxgs0));
        let lxga1 = str_sub(lxga, lxgs0 + 1, len(lxga));
        let lxgs1 = _find_space(lxga1);
        let lxgj  = to_int(str_sub(lxga1, 0, lxgs1));
        let lxgv  = to_int(str_sub(lxga1, lxgs1 + 1, len(lxga1)));
        lm_set_wxg(lxgi, lxgj, lxgv);
        return "lstm: W_xg set";
    }
    if _starts_with(cmd, "lstm input ") {
        let lmia  = str_sub(cmd, 11, len(cmd));
        let lmis0 = _find_space(lmia);
        let lmii  = to_int(str_sub(lmia, 0, lmis0));
        let lmiv  = to_int(str_sub(lmia, lmis0 + 1, len(lmia)));
        lm_set_input(lmii, lmiv);
        return "lstm: input set";
    }
    if cmd == "lstm step" { let lmst = lstm_step(); return "lstm: h0=" + to_string(lmst); }
    if _starts_with(cmd, "lstm hidden ") {
        let lmhid = to_int(str_sub(cmd, 12, len(cmd)));
        return "lstm: hidden[" + to_string(lmhid) + "]=" + to_string(lm_get_hidden(lmhid));
    }

    // --- Autograd ---
    if cmd == "ag init" { ag_init(); return "ag: init"; }
    if cmd == "ag test" { let agr = ag_test(); return "ag: " + to_string(agr); }
    if _starts_with(cmd, "ag const ") {
        let agcv = to_int(str_sub(cmd, 9, len(cmd)));
        let agci = ag_const(agcv);
        return "ag: node=" + to_string(agci);
    }
    if _starts_with(cmd, "ag add ") {
        let agaa  = str_sub(cmd, 7, len(cmd));
        let agas0 = _find_space(agaa);
        let agaa0 = to_int(str_sub(agaa, 0, agas0));
        let agab0 = to_int(str_sub(agaa, agas0 + 1, len(agaa)));
        let agaid = ag_add(agaa0, agab0);
        return "ag: node=" + to_string(agaid);
    }
    if _starts_with(cmd, "ag mul ") {
        let agma  = str_sub(cmd, 7, len(cmd));
        let agms0 = _find_space(agma);
        let agma0 = to_int(str_sub(agma, 0, agms0));
        let agmb0 = to_int(str_sub(agma, agms0 + 1, len(agma)));
        let agmid = ag_mul(agma0, agmb0);
        return "ag: node=" + to_string(agmid);
    }
    if cmd == "ag forward" { let agfn = ag_forward(); return "ag: nodes=" + to_string(agfn); }
    if _starts_with(cmd, "ag run ") {
        let aglid = to_int(str_sub(cmd, 7, len(cmd)));
        ag_forward();
        ag_backward_from(aglid);
        return "ag: val=" + to_string(ag_get_val(aglid)) + " grad_done";
    }
    if _starts_with(cmd, "ag grad ") {
        let aggid = to_int(str_sub(cmd, 8, len(cmd)));
        return "ag: grad[" + to_string(aggid) + "]=" + to_string(ag_get_grad(aggid));
    }

    // --- Optimizer ---
    if cmd == "op init" { op_init(); return "op: init"; }
    if cmd == "op test" { let opr = op_test(); return "op: " + to_string(opr); }
    if _starts_with(cmd, "op set ") {
        let opsa  = str_sub(cmd, 7, len(cmd));
        let opss0 = _find_space(opsa);
        let opsi  = to_int(str_sub(opsa, 0, opss0));
        let opsv  = to_int(str_sub(opsa, opss0 + 1, len(opsa)));
        op_set_param(opsi, opsv);
        if opsi >= op_n_params { op_n_params = opsi + 1; }
        return "op: param set";
    }
    if _starts_with(cmd, "op setgrad ") {
        let opga  = str_sub(cmd, 11, len(cmd));
        let opgs0 = _find_space(opga);
        let opgi  = to_int(str_sub(opga, 0, opgs0));
        let opgv  = to_int(str_sub(opga, opgs0 + 1, len(opga)));
        op_set_grad(opgi, opgv);
        return "op: grad set";
    }
    if cmd == "op sgd"  { let opsp = op_sgd_step();  return "op: param[0]=" + to_string(opsp); }
    if cmd == "op adam" { let opap = op_adam_step(); return "op: param[0]=" + to_string(opap); }
    if _starts_with(cmd, "op get ") {
        let opgid = to_int(str_sub(cmd, 7, len(cmd)));
        return "op: param[" + to_string(opgid) + "]=" + to_string(op_get_param(opgid));
    }

    // --- Tokenizer ---
    if cmd == "tk init" { tk_init(); return "tk: init"; }
    if cmd == "tk test" { let tkr = tk_test(); return "tk: " + to_string(tkr); }
    if _starts_with(cmd, "tk char ") {
        let tkca  = str_sub(cmd, 8, len(cmd));
        let tkcs0 = _find_space(tkca);
        let tkci  = to_int(str_sub(tkca, 0, tkcs0));
        let tkcv  = to_int(str_sub(tkca, tkcs0 + 1, len(tkca)));
        tk_set_text(tkci, tkcv);
        return "tk: text set";
    }
    if _starts_with(cmd, "tk textlen ") {
        let tkln = to_int(str_sub(cmd, 11, len(cmd)));
        tk_set_text_len(tkln);
        return "tk: text_len=" + to_string(tkln);
    }
    if _starts_with(cmd, "tk train ") {
        let tktr  = to_int(str_sub(cmd, 9, len(cmd)));
        let tktrd = tk_bpe_train(tktr);
        return "tk: rounds=" + to_string(tktrd) + " vocab=" + to_string(tk_get_vocab_n());
    }
    if cmd == "tk encode" {
        let tken = tk_encode();
        return "tk: tokens=" + to_string(tken);
    }
    if _starts_with(cmd, "tk token ") {
        let tktid = to_int(str_sub(cmd, 9, len(cmd)));
        return "tk: token[" + to_string(tktid) + "]=" + to_string(tk_get_token(tktid));
    }

    // --- Embedding ---
    if cmd == "emb init" { em_init(); return "emb: init"; }
    if cmd == "emb test" { let emr = em_test(); return "emb: " + to_string(emr); }
    if _starts_with(cmd, "emb set ") {
        let emsa  = str_sub(cmd, 8, len(cmd));
        let emss0 = _find_space(emsa);
        let emsi  = to_int(str_sub(emsa, 0, emss0));
        let emsa1 = str_sub(emsa, emss0 + 1, len(emsa));
        let emss1 = _find_space(emsa1);
        let emsd  = to_int(str_sub(emsa1, 0, emss1));
        let emsv  = to_int(str_sub(emsa1, emss1 + 1, len(emsa1)));
        em_set(emsi, emsd, emsv);
        return "emb: set";
    }
    if _starts_with(cmd, "emb get ") {
        let emga  = str_sub(cmd, 8, len(cmd));
        let emgs0 = _find_space(emga);
        let emgi  = to_int(str_sub(emga, 0, emgs0));
        let emga1 = str_sub(emga, emgs0 + 1, len(emga));
        let emgd  = to_int(emga1);
        return "emb: " + to_string(em_get(emgi, emgd));
    }
    if _starts_with(cmd, "emb lookup ") {
        let emli = to_int(str_sub(cmd, 11, len(cmd)));
        let emlv = em_lookup(emli);
        return "emb: result[0]=" + to_string(emlv);
    }
    if _starts_with(cmd, "emb query ") {
        let emqa  = str_sub(cmd, 10, len(cmd));
        let emqs0 = _find_space(emqa);
        let emqd  = to_int(str_sub(emqa, 0, emqs0));
        let emqv  = to_int(str_sub(emqa, emqs0 + 1, len(emqa)));
        em_set_query(emqd, emqv);
        return "emb: query set";
    }
    if _starts_with(cmd, "emb dot ") {
        let emdi = to_int(str_sub(cmd, 8, len(cmd)));
        return "emb: dot=" + to_string(em_dot(emdi));
    }

    // --- Model Serialize ---
    if cmd == "ms init" { ms_init(); return "ms: init"; }
    if cmd == "ms test" { let msr = ms_test(); return "ms: " + to_string(msr); }
    if _starts_with(cmd, "ms layer ") {
        let msla  = str_sub(cmd, 9, len(cmd));
        let msls0 = _find_space(msla);
        let mslt  = to_int(str_sub(msla, 0, msls0));
        let msla1 = str_sub(msla, msls0 + 1, len(msla));
        let msls1 = _find_space(msla1);
        let mslnw = to_int(str_sub(msla1, 0, msls1));
        let mslnb = to_int(str_sub(msla1, msls1 + 1, len(msla1)));
        let mslid = ms_add_layer(mslt, mslnw, mslnb);
        return "ms: layer=" + to_string(mslid);
    }
    if _starts_with(cmd, "ms weight ") {
        let mswa  = str_sub(cmd, 10, len(cmd));
        let msws0 = _find_space(mswa);
        let mswli = to_int(str_sub(mswa, 0, msws0));
        let mswa1 = str_sub(mswa, msws0 + 1, len(mswa));
        let msws1 = _find_space(mswa1);
        let mswwi = to_int(str_sub(mswa1, 0, msws1));
        let mswv  = to_int(str_sub(mswa1, msws1 + 1, len(mswa1)));
        ms_set_weight(mswli, mswwi, mswv);
        return "ms: weight set";
    }
    if cmd == "ms save" {
        let msbl = ms_serialize();
        return "ms: bytes=" + to_string(msbl) + " ck=" + to_string(ms_get_checksum());
    }
    if cmd == "ms load" {
        let msnl = ms_deserialize();
        return "ms: layers=" + to_string(msnl);
    }
    if cmd == "ms checksum" { return "ms: ck=" + to_string(ms_get_checksum()); }

    // --- GPU Inference ---
    if cmd == "gi init" { gi_init(); return "gi: init"; }
    if cmd == "gi test" { let gir = gi_test(); return "gi: " + to_string(gir); }
    if _starts_with(cmd, "gi input ") {
        let giia  = str_sub(cmd, 9, len(cmd));
        let giis0 = _find_space(giia);
        let giix  = to_int(str_sub(giia, 0, giis0));
        let giiv  = to_int(str_sub(giia, giis0 + 1, len(giia)));
        gi_set_input(giix, giiv);
        return "gi: input set";
    }
    if _starts_with(cmd, "gi op ") {
        let gioa  = str_sub(cmd, 6, len(cmd));
        let gios0 = _find_space(gioa);
        let giot  = to_int(str_sub(gioa, 0, gios0));
        let gioa1 = str_sub(gioa, gios0 + 1, len(gioa));
        let gios1 = _find_space(gioa1);
        let gioio = to_int(str_sub(gioa1, 0, gios1));
        let gioa2 = str_sub(gioa1, gios1 + 1, len(gioa1));
        let gios2 = _find_space(gioa2);
        let giooo = to_int(str_sub(gioa2, 0, gios2));
        let gioa3 = str_sub(gioa2, gios2 + 1, len(gioa2));
        let gios3 = _find_space(gioa3);
        let gioid = to_int(str_sub(gioa3, 0, gios3));
        let giood = to_int(str_sub(gioa3, gios3 + 1, len(gioa3)));
        let gioqn = gi_add_op(giot, gioio, giooo, gioid, giood);
        return "gi: op[" + to_string(gioqn) + "] queued";
    }
    if cmd == "gi dispatch" {
        let gicyc = gi_dispatch();
        return "gi: cycles=" + to_string(gicyc);
    }
    if _starts_with(cmd, "gi output ") {
        let giox = to_int(str_sub(cmd, 10, len(cmd)));
        return "gi: output[" + to_string(giox) + "]=" + to_string(gi_get_output(giox));
    }
    if cmd == "gi info" {
        return "gi: ops=" + to_string(gi_queue_len()) + " cycles=" + to_string(gi_cycles_used());
    }

    // --- CFS Scheduler ---
    if cmd == "sc init" { sc_init(); return "sc: init"; }
    if cmd == "sc test" { let scr = sc_test(); return "sc: " + to_string(scr); }
    if _starts_with(cmd, "sc add ") {
        let scaw = to_int(str_sub(cmd, 7, len(cmd)));
        let scid = sc_add_task(scaw);
        return "sc: added task " + to_string(scid) + " weight=" + to_string(scaw);
    }
    if _starts_with(cmd, "sc tick ") {
        let sctn = to_int(str_sub(cmd, 8, len(cmd)));
        sc_tick(sctn);
        return "sc: ticked " + to_string(sctn) + " cur=" + to_string(sc_get_current());
    }
    if cmd == "sc next" {
        let scnx = sc_pick_next();
        return "sc: next=" + to_string(scnx) + " vr=" + to_string(sc_get_vruntime(scnx));
    }
    if _starts_with(cmd, "sc vruntime ") {
        let sctid = to_int(str_sub(cmd, 12, len(cmd)));
        return "sc: vruntime[" + to_string(sctid) + "]=" + to_string(sc_get_vruntime(sctid));
    }
    if cmd == "sc info" {
        return "sc: tasks=" + to_string(sc_get_n_tasks()) + " ticks=" + to_string(sc_get_ticks()) + " cur=" + to_string(sc_get_current());
    }

    // --- NUMA Allocator ---
    if cmd == "na init" { na_init(); return "na: init"; }
    if cmd == "na test" { let nar = na_test(); return "na: " + to_string(nar); }
    if _starts_with(cmd, "na node ") {
        let nand = to_int(str_sub(cmd, 8, len(cmd)));
        na_set_node(nand);
        return "na: current_node=" + to_string(nand);
    }
    if cmd == "na alloc" {
        let naaddr = na_alloc();
        return "na: addr=" + to_string(naaddr);
    }
    if _starts_with(cmd, "na free ") {
        let nafas  = str_sub(cmd, 8, len(cmd));
        let nafsp  = _find_space(nafas);
        let nafnd  = to_int(str_sub(nafas, 0, nafsp));
        let nafidx = to_int(str_sub(nafas, nafsp + 1, len(nafas)));
        na_free(nafnd, nafidx);
        return "na: freed node=" + to_string(nafnd) + " idx=" + to_string(nafidx);
    }
    if cmd == "na info" {
        return "na: node=" + to_string(na_get_cur_node()) + " free[0]=" + to_string(na_node_free_count(0)) + " free[1]=" + to_string(na_node_free_count(1));
    }
    if cmd == "na stat" {
        return "na: allocs=" + to_string(na_get_allocs()) + " frees=" + to_string(na_get_frees());
    }

    // --- Ftrace ---
    if cmd == "ft init"    { ft_init();    return "ft: init"; }
    if cmd == "ft test"    { let ftr = ft_test(); return "ft: " + to_string(ftr); }
    if cmd == "ft enable"  { ft_enable();  return "ft: enabled"; }
    if cmd == "ft disable" { ft_disable(); return "ft: disabled"; }
    if _starts_with(cmd, "ft enter ") {
        let ftef = to_int(str_sub(cmd, 9, len(cmd)));
        ft_enter(ftef);
        return "ft: enter func=" + to_string(ftef) + " depth=" + to_string(ft_get_n_events());
    }
    if _starts_with(cmd, "ft exit ") {
        let ftxf = to_int(str_sub(cmd, 8, len(cmd)));
        ft_exit(ftxf);
        return "ft: exit func=" + to_string(ftxf) + " events=" + to_string(ft_get_n_events());
    }
    if cmd == "ft show" {
        return "ft: events=" + to_string(ft_get_n_events()) + " dropped=" + to_string(ft_get_dropped());
    }

    // --- Kprobe ---
    if cmd == "kp init" { kp_init(); return "kp: init"; }
    if cmd == "kp test" { let kpr = kp_test(); return "kp: " + to_string(kpr); }
    if _starts_with(cmd, "kp register ") {
        let kprf = to_int(str_sub(cmd, 12, len(cmd)));
        let kpid = kp_register(kprf);
        return "kp: probe " + to_string(kpid) + " on func=" + to_string(kprf);
    }
    if _starts_with(cmd, "kp unregister ") {
        let kpup = to_int(str_sub(cmd, 14, len(cmd)));
        kp_unregister(kpup);
        return "kp: probe " + to_string(kpup) + " removed";
    }
    if _starts_with(cmd, "kp trigger ") {
        let kpta  = str_sub(cmd, 11, len(cmd));
        let kpts  = _find_space(kpta);
        let kptf  = to_int(str_sub(kpta, 0, kpts));
        let kptag = to_int(str_sub(kpta, kpts + 1, len(kpta)));
        kp_trigger(kptf, kptag);
        return "kp: triggered func=" + to_string(kptf) + " arg=" + to_string(kptag);
    }
    if _starts_with(cmd, "kp hits ") {
        let kphp = to_int(str_sub(cmd, 8, len(cmd)));
        return "kp: probe[" + to_string(kphp) + "] hits=" + to_string(kp_get_hits(kphp));
    }
    if cmd == "kp info" {
        return "kp: probes=" + to_string(kp_get_n_probes()) + " total_hits=" + to_string(kp_get_total_hits());
    }

    // --- Memory Profiler ---
    if cmd == "mp init" { mp_init(); return "mp: init"; }
    if cmd == "mp test" { let mpr = mp_test(); return "mp: " + to_string(mpr); }
    if _starts_with(cmd, "mp alloc ") {
        let mpaa  = str_sub(cmd, 9, len(cmd));
        let mpas  = _find_space(mpaa);
        let mpast = to_int(str_sub(mpaa, 0, mpas));
        let mpasz = to_int(str_sub(mpaa, mpas + 1, len(mpaa)));
        mp_record_alloc(mpast, mpasz);
        return "mp: alloc site=" + to_string(mpast) + " size=" + to_string(mpasz) + " live=" + to_string(mp_get_live());
    }
    if _starts_with(cmd, "mp free ") {
        let mpfz = to_int(str_sub(cmd, 8, len(cmd)));
        mp_record_free(mpfz);
        return "mp: free size=" + to_string(mpfz) + " live=" + to_string(mp_get_live());
    }
    if cmd == "mp live" { return "mp: live=" + to_string(mp_get_live()); }
    if cmd == "mp peak" { return "mp: peak=" + to_string(mp_get_peak()); }
    if _starts_with(cmd, "mp site ") {
        let mpsi = to_int(str_sub(cmd, 8, len(cmd)));
        return "mp: site[" + to_string(mpsi) + "] bytes=" + to_string(mp_get_site_bytes(mpsi)) + " cnt=" + to_string(mp_get_site_count(mpsi));
    }

    // --- Heap Checker ---
    if cmd == "hc init" { hc_init(); return "hc: init"; }
    if cmd == "hc test" { let hcr = hc_test(); return "hc: " + to_string(hcr); }
    if _starts_with(cmd, "hc track ") {
        let hcta  = str_sub(cmd, 9, len(cmd));
        let hcts  = _find_space(hcta);
        let hctb  = to_int(str_sub(hcta, 0, hcts));
        let hctsz = to_int(str_sub(hcta, hcts + 1, len(hcta)));
        let hctid = hc_track(hctb, hctsz);
        return "hc: tracked id=" + to_string(hctid) + " base=" + to_string(hctb) + " size=" + to_string(hctsz);
    }
    if _starts_with(cmd, "hc corrupt ") {
        let hcca  = str_sub(cmd, 11, len(cmd));
        let hccs  = _find_space(hcca);
        let hccid = to_int(str_sub(hcca, 0, hccs));
        let hccsd = to_int(str_sub(hcca, hccs + 1, len(hcca)));
        hc_corrupt(hccid, hccsd);
        return "hc: corrupted id=" + to_string(hccid) + " side=" + to_string(hccsd);
    }
    if _starts_with(cmd, "hc check ") {
        let hcckid = to_int(str_sub(cmd, 9, len(cmd)));
        let hcckr  = hc_check(hcckid);
        return "hc: check[" + to_string(hcckid) + "]=" + to_string(hcckr);
    }
    if cmd == "hc checkall" {
        let hcviol = hc_check_all();
        return "hc: violations=" + to_string(hcviol);
    }
    if cmd == "hc info" {
        return "hc: allocs=" + to_string(hc_get_n_allocs()) + " violations=" + to_string(hc_get_violations());
    }

    // --- Crash Reporter ---
    if cmd == "cr init"  { cr_init(); return "cr: init"; }
    if cmd == "cr test"  { let crr = cr_test(); return "cr: " + to_string(crr); }
    if _starts_with(cmd, "cr record ") {
        let crra  = str_sub(cmd, 10, len(cmd));
        let crrs0 = _find_space(crra);
        let crrt  = to_int(str_sub(crra, 0, crrs0));
        let crra2 = str_sub(crra, crrs0 + 1, len(crra));
        let crrs1 = _find_space(crra2);
        let crrad = to_int(str_sub(crra2, 0, crrs1));
        let crra3 = str_sub(crra2, crrs1 + 1, len(crra2));
        let crrs2 = _find_space(crra3);
        let crrip = to_int(str_sub(crra3, 0, crrs2));
        let crrsp = to_int(str_sub(crra3, crrs2 + 1, len(crra3)));
        cr_record(crrt, crrad, crrip, crrsp);
        return "cr: recorded type=" + to_string(crrt) + " addr=" + to_string(crrad);
    }
    if _starts_with(cmd, "cr frame ") {
        let crfa = to_int(str_sub(cmd, 9, len(cmd)));
        cr_push_frame(crfa);
        return "cr: frame pushed depth=" + to_string(cr_get_stack_depth());
    }
    if cmd == "cr show" {
        return "cr: type=" + to_string(cr_get_fault_type()) + " addr=" + to_string(cr_get_fault_addr()) + " rip=" + to_string(cr_get_rip()) + " depth=" + to_string(cr_get_stack_depth());
    }
    if cmd == "cr count" { return "cr: crashes=" + to_string(cr_get_crash_count()); }
    if cmd == "cr clear" { cr_clear(); return "cr: cleared"; }

    // --- Core Dump ---
    if cmd == "cd init" { cd_init(); return "cd: init"; }
    if cmd == "cd test" { let cdr = cd_test(); return "cd: " + to_string(cdr); }
    if _starts_with(cmd, "cd setreg ") {
        let cdra  = str_sub(cmd, 10, len(cmd));
        let cdrs  = _find_space(cdra);
        let cdri  = to_int(str_sub(cdra, 0, cdrs));
        let cdrv  = to_int(str_sub(cdra, cdrs + 1, len(cdra)));
        cd_set_reg(cdri, cdrv);
        return "cd: reg[" + to_string(cdri) + "]=" + to_string(cdrv);
    }
    if _starts_with(cmd, "cd setmem ") {
        let cdma  = str_sub(cmd, 10, len(cmd));
        let cdms  = _find_space(cdma);
        let cdmi  = to_int(str_sub(cdma, 0, cdms));
        let cdmv  = to_int(str_sub(cdma, cdms + 1, len(cdma)));
        cd_set_mem(cdmi, cdmv);
        return "cd: mem[" + to_string(cdmi) + "]=" + to_string(cdmv);
    }
    if cmd == "cd dump" {
        let cdn = cd_dump();
        return "cd: dumped len=" + to_string(cdn);
    }
    if _starts_with(cmd, "cd buf ") {
        let cdbi = to_int(str_sub(cmd, 7, len(cmd)));
        return "cd: buf[" + to_string(cdbi) + "]=" + to_string(cd_get_buf_word(cdbi));
    }
    if cmd == "cd info" {
        return "cd: dumps=" + to_string(cd_get_n_dumps()) + " buf_len=" + to_string(cd_get_buf_len());
    }

    // --- HotPatch ---
    if cmd == "hp init" { hp_init(); return "hp: init"; }
    if cmd == "hp test" { let hpr = hp_test(); return "hp: " + to_string(hpr); }
    if _starts_with(cmd, "hp apply ") {
        let hpaa  = str_sub(cmd, 9, len(cmd));
        let hpas  = _find_space(hpaa);
        let hpaof = to_int(str_sub(hpaa, 0, hpas));
        let hparf = to_int(str_sub(hpaa, hpas + 1, len(hpaa)));
        let hpid  = hp_apply(hpaof, hparf);
        return "hp: patch " + to_string(hpid) + " orig=" + to_string(hpaof) + " repl=" + to_string(hparf);
    }
    if _starts_with(cmd, "hp revert ") {
        let hprp = to_int(str_sub(cmd, 10, len(cmd)));
        hp_revert(hprp);
        return "hp: patch " + to_string(hprp) + " reverted";
    }
    if _starts_with(cmd, "hp dispatch ") {
        let hpdf = to_int(str_sub(cmd, 12, len(cmd)));
        let hpdr = hp_dispatch(hpdf);
        return "hp: dispatch(" + to_string(hpdf) + ")=" + to_string(hpdr);
    }
    if cmd == "hp list" {
        return "hp: patches=" + to_string(hp_get_n_patches()) + " dispatches=" + to_string(hp_get_total_dispatches());
    }
    if cmd == "hp info" {
        return "hp: patches=" + to_string(hp_get_n_patches());
    }

    // --- LivePatch ---
    if cmd == "lp init" { lp_init(); return "lp: init"; }
    if cmd == "lp test" { let lpr = lp_test(); return "lp: " + to_string(lpr); }
    if _starts_with(cmd, "lp register ") {
        let lpvr = to_int(str_sub(cmd, 12, len(cmd)));
        let lpid = lp_register(lpvr);
        return "lp: patch " + to_string(lpid) + " ver=" + to_string(lpvr);
    }
    if _starts_with(cmd, "lp addfunc ") {
        let lpafa  = str_sub(cmd, 11, len(cmd));
        let lpas0  = _find_space(lpafa);
        let lpapid = to_int(str_sub(lpafa, 0, lpas0));
        let lpafa2 = str_sub(lpafa, lpas0 + 1, len(lpafa));
        let lpas1  = _find_space(lpafa2);
        let lpaof  = to_int(str_sub(lpafa2, 0, lpas1));
        let lparf  = to_int(str_sub(lpafa2, lpas1 + 1, len(lpafa2)));
        lp_add_func(lpapid, lpaof, lparf);
        return "lp: added orig=" + to_string(lpaof) + " repl=" + to_string(lparf);
    }
    if _starts_with(cmd, "lp apply ") {
        let lpap = to_int(str_sub(cmd, 9, len(cmd)));
        lp_apply(lpap);
        return "lp: patch " + to_string(lpap) + " applied";
    }
    if _starts_with(cmd, "lp revert ") {
        let lprp = to_int(str_sub(cmd, 10, len(cmd)));
        lp_revert(lprp);
        return "lp: patch " + to_string(lprp) + " reverted";
    }
    if _starts_with(cmd, "lp resolve ") {
        let lprf = to_int(str_sub(cmd, 11, len(cmd)));
        let lprr = lp_resolve(lprf);
        return "lp: resolve(" + to_string(lprf) + ")=" + to_string(lprr);
    }

    // --- Power Management ---
    if cmd == "pm init" { pm_init(); return "pm: init"; }
    if cmd == "pm test" { let pmr = pm_test(); return "pm: " + to_string(pmr); }
    if _starts_with(cmd, "pm state ") {
        let pmss = to_int(str_sub(cmd, 9, len(cmd)));
        pm_set_state(pmss);
        return "pm: state=" + to_string(pmss);
    }
    if _starts_with(cmd, "pm battery ") {
        let pmbp = to_int(str_sub(cmd, 11, len(cmd)));
        pm_set_battery(pmbp);
        return "pm: battery=" + to_string(pmbp) + "%";
    }
    if _starts_with(cmd, "pm ac ") {
        let pmac = to_int(str_sub(cmd, 6, len(cmd)));
        pm_set_ac(pmac);
        return "pm: ac=" + to_string(pmac);
    }
    if cmd == "pm event" {
        let pmev = pm_pop_event();
        return "pm: event=" + to_string(pmev);
    }
    if cmd == "pm info" {
        return "pm: state=" + to_string(pm_get_state()) + " bat=" + to_string(pm_get_battery()) + "% ac=" + to_string(pm_get_ac()) + " events=" + to_string(pm_get_n_events());
    }

    // --- Thermal ---
    if cmd == "th init" { th_init(); return "th: init"; }
    if cmd == "th test" { let thr = th_test(); return "th: " + to_string(thr); }
    if _starts_with(cmd, "th temp ") {
        let thta  = str_sub(cmd, 8, len(cmd));
        let thts  = _find_space(thta);
        let thtzo = to_int(str_sub(thta, 0, thts));
        let thttm = to_int(str_sub(thta, thts + 1, len(thta)));
        th_set_temp(thtzo, thttm);
        return "th: zone=" + to_string(thtzo) + " temp=" + to_string(thttm) + " state=" + to_string(th_get_state(thtzo));
    }
    if _starts_with(cmd, "th state ") {
        let thsz = to_int(str_sub(cmd, 9, len(cmd)));
        return "th: zone=" + to_string(thsz) + " state=" + to_string(th_get_state(thsz));
    }
    if _starts_with(cmd, "th throttle ") {
        let ththz = to_int(str_sub(cmd, 12, len(cmd)));
        return "th: zone=" + to_string(ththz) + " throttle=" + to_string(th_get_throttle(ththz)) + "%";
    }
    if cmd == "th fan" {
        let thf = th_update_fan();
        return "th: fan=" + to_string(thf) + "%";
    }
    if cmd == "th info" {
        return "th: zones=" + to_string(th_get_n_zones()) + " fan=" + to_string(th_get_fan_speed()) + "% alerts=" + to_string(th_get_alerts());
    }

    // --- CPUFreq ---
    if cmd == "cf init" { cf_init(); return "cf: init"; }
    if cmd == "cf test" { let cfr = cf_test(); return "cf: " + to_string(cfr); }
    if _starts_with(cmd, "cf gov ") {
        let cfga  = str_sub(cmd, 7, len(cmd));
        let cfgs  = _find_space(cfga);
        let cfgc  = to_int(str_sub(cfga, 0, cfgs));
        let cfgg  = to_int(str_sub(cfga, cfgs + 1, len(cfga)));
        cf_set_gov(cfgc, cfgg);
        return "cf: cpu=" + to_string(cfgc) + " gov=" + to_string(cfgg);
    }
    if _starts_with(cmd, "cf load ") {
        let cfla  = str_sub(cmd, 8, len(cmd));
        let cfls  = _find_space(cfla);
        let cflc  = to_int(str_sub(cfla, 0, cfls));
        let cfll  = to_int(str_sub(cfla, cfls + 1, len(cfla)));
        cf_set_load(cflc, cfll);
        return "cf: cpu=" + to_string(cflc) + " load=" + to_string(cfll) + "%";
    }
    if _starts_with(cmd, "cf adjust ") {
        let cfac = to_int(str_sub(cmd, 10, len(cmd)));
        let cfaf = cf_adjust(cfac);
        return "cf: cpu=" + to_string(cfac) + " freq=" + to_string(cfaf) + "MHz";
    }
    if _starts_with(cmd, "cf freq ") {
        let cffc = to_int(str_sub(cmd, 8, len(cmd)));
        return "cf: cpu=" + to_string(cffc) + " freq=" + to_string(cf_get_freq(cffc)) + "MHz";
    }
    if cmd == "cf info" {
        return "cf: cpus=" + to_string(cf_n_cpus) + " cpu0=" + to_string(cf_get_freq(0)) + "MHz cpu1=" + to_string(cf_get_freq(1)) + "MHz";
    }

    // --- Hypervisor ---
    if cmd == "hv init" { hv_init(); return "hv: init"; }
    if cmd == "hv test" { let hvr = hv_test(); return "hv: " + to_string(hvr); }
    if _starts_with(cmd, "hv create ") {
        let hvca  = str_sub(cmd, 10, len(cmd));
        let hvcs  = _find_space(hvca);
        let hvcv  = to_int(str_sub(hvca, 0, hvcs));
        let hvcm  = to_int(str_sub(hvca, hvcs + 1, len(hvca)));
        let hvid  = hv_create_vm(hvcv, hvcm);
        return "hv: vm " + to_string(hvid) + " vcpus=" + to_string(hvcv) + " mem=" + to_string(hvcm) + "MB";
    }
    if _starts_with(cmd, "hv start ") {
        let hvsi = to_int(str_sub(cmd, 9, len(cmd)));
        hv_start(hvsi);
        return "hv: vm " + to_string(hvsi) + " running";
    }
    if _starts_with(cmd, "hv pause ") {
        let hvpi = to_int(str_sub(cmd, 9, len(cmd)));
        hv_pause(hvpi);
        return "hv: vm " + to_string(hvpi) + " paused";
    }
    if _starts_with(cmd, "hv stop ") {
        let hvti = to_int(str_sub(cmd, 8, len(cmd)));
        hv_stop(hvti);
        return "hv: vm " + to_string(hvti) + " stopped";
    }
    if _starts_with(cmd, "hv info ") {
        let hvii = to_int(str_sub(cmd, 8, len(cmd)));
        return "hv: vm=" + to_string(hvii) + " state=" + to_string(hv_get_state(hvii)) + " exits=" + to_string(hv_get_exits(hvii)) + " vcpus=" + to_string(hv_get_vcpus(hvii));
    }

    // --- VMX ---
    if cmd == "vx init" { vx_init(); return "vx: init"; }
    if cmd == "vx test" { let vxr = vx_test(); return "vx: " + to_string(vxr); }
    if _starts_with(cmd, "vx setup ") {
        let vxsa  = str_sub(cmd, 9, len(cmd));
        let vxss0 = _find_space(vxsa);
        let vxsvc = to_int(str_sub(vxsa, 0, vxss0));
        let vxsa2 = str_sub(vxsa, vxss0 + 1, len(vxsa));
        let vxss1 = _find_space(vxsa2);
        let vxsrp = to_int(str_sub(vxsa2, 0, vxss1));
        let vxsrs = to_int(str_sub(vxsa2, vxss1 + 1, len(vxsa2)));
        vx_vmcs_setup(vxsvc, vxsrp, vxsrs);
        return "vx: vcpu=" + to_string(vxsvc) + " rip=" + to_string(vxsrp) + " rsp=" + to_string(vxsrs);
    }
    if _starts_with(cmd, "vx write ") {
        let vxwa  = str_sub(cmd, 9, len(cmd));
        let vxws0 = _find_space(vxwa);
        let vxwvc = to_int(str_sub(vxwa, 0, vxws0));
        let vxwa2 = str_sub(vxwa, vxws0 + 1, len(vxwa));
        let vxws1 = _find_space(vxwa2);
        let vxwf  = to_int(str_sub(vxwa2, 0, vxws1));
        let vxwv  = to_int(str_sub(vxwa2, vxws1 + 1, len(vxwa2)));
        vx_vmwrite(vxwvc, vxwf, vxwv);
        return "vx: vcpu=" + to_string(vxwvc) + " field=" + to_string(vxwf) + " val=" + to_string(vxwv);
    }
    if _starts_with(cmd, "vx read ") {
        let vxra  = str_sub(cmd, 8, len(cmd));
        let vxrs  = _find_space(vxra);
        let vxrvc = to_int(str_sub(vxra, 0, vxrs));
        let vxrf  = to_int(str_sub(vxra, vxrs + 1, len(vxra)));
        let vxrv  = vx_vmread(vxrvc, vxrf);
        return "vx: vcpu=" + to_string(vxrvc) + " field=" + to_string(vxrf) + " val=" + to_string(vxrv);
    }
    if _starts_with(cmd, "vx launch ") {
        let vxlvc = to_int(str_sub(cmd, 10, len(cmd)));
        vx_vmlaunch(vxlvc);
        return "vx: launched vcpu=" + to_string(vxlvc) + " exits=" + to_string(vx_get_exits(vxlvc));
    }
    if _starts_with(cmd, "vx info ") {
        let vxivc = to_int(str_sub(cmd, 8, len(cmd)));
        return "vx: vcpu=" + to_string(vxivc) + " exits=" + to_string(vx_get_exits(vxivc)) + " reason=" + to_string(vx_get_exit_reason(vxivc)) + " rip=" + to_string(vx_vmread(vxivc, VX_F_RIP));
    }

    // --- Package Manager ---
    if cmd == "pm init"  { pm_init(); return "pm: init"; }
    if cmd == "pm test"  { let pmr = pm_test(); return "pm: " + to_string(pmr); }
    if cmd == "pm count" { return "pm: installed=" + to_string(pm_count_installed()); }
    if _starts_with(cmd, "pm install ") {
        let pmia  = str_sub(cmd, 11, len(cmd));
        let pmis  = _find_space(pmia);
        let pmiid = to_int(str_sub(pmia, 0, pmis));
        let pmiv  = to_int(str_sub(pmia, pmis + 1, len(pmia)));
        let pmir  = pm_install(pmiid, pmiv);
        return "pm: installed id=" + to_string(pmiid) + " ver=" + to_string(pmiv) + " slot=" + to_string(pmir);
    }
    if _starts_with(cmd, "pm remove ") {
        let pmrid = to_int(str_sub(cmd, 10, len(cmd)));
        pm_remove(pmrid);
        return "pm: removed id=" + to_string(pmrid);
    }
    if _starts_with(cmd, "pm find ") {
        let pmfid = to_int(str_sub(cmd, 8, len(cmd)));
        let pmfi  = pm_find(pmfid);
        return "pm: id=" + to_string(pmfid) + " idx=" + to_string(pmfi);
    }
    if _starts_with(cmd, "pm version ") {
        let pmvid = to_int(str_sub(cmd, 11, len(cmd)));
        let pmvv  = pm_get_version(pmvid);
        return "pm: id=" + to_string(pmvid) + " ver=" + to_string(pmvv);
    }

    // --- Package Registry ---
    if cmd == "pr init"  { pr_init(); return "pr: init"; }
    if cmd == "pr test"  { let prr = pr_test(); return "pr: " + to_string(prr); }
    if cmd == "pr count" { return "pr: entries=" + to_string(pr_count()); }
    if _starts_with(cmd, "pr register ") {
        let prra  = str_sub(cmd, 12, len(cmd));
        let prrs0 = _find_space(prra);
        let prrid = to_int(str_sub(prra, 0, prrs0));
        let prra2 = str_sub(prra, prrs0 + 1, len(prra));
        let prrs1 = _find_space(prra2);
        let prrv  = to_int(str_sub(prra2, 0, prrs1));
        let prsz  = to_int(str_sub(prra2, prrs1 + 1, len(prra2)));
        let prri  = pr_register(prrid, prrv, prsz);
        return "pr: registered id=" + to_string(prrid) + " ver=" + to_string(prrv) + " slot=" + to_string(prri);
    }
    if _starts_with(cmd, "pr lookup ") {
        let prlid = to_int(str_sub(cmd, 10, len(cmd)));
        let prli  = pr_lookup(prlid);
        return "pr: id=" + to_string(prlid) + " idx=" + to_string(prli);
    }
    if _starts_with(cmd, "pr version ") {
        let prvid = to_int(str_sub(cmd, 11, len(cmd)));
        let prvv  = pr_get_version(prvid);
        return "pr: id=" + to_string(prvid) + " ver=" + to_string(prvv);
    }
    if _starts_with(cmd, "pr size ") {
        let prsid = to_int(str_sub(cmd, 8, len(cmd)));
        let prssz = pr_get_size(prsid);
        return "pr: id=" + to_string(prsid) + " size=" + to_string(prssz) + "KB";
    }

    // --- Package Build System ---
    if cmd == "pb init"     { pb_init(); return "pb: init"; }
    if cmd == "pb test"     { let pbr = pb_test(); return "pb: " + to_string(pbr); }
    if cmd == "pb count"    { return "pb: targets=" + to_string(pb_count()); }
    if _starts_with(cmd, "pb add ") {
        let pbaid = to_int(str_sub(cmd, 7, len(cmd)));
        let pbas  = pb_add_target(pbaid);
        return "pb: target added id=" + to_string(pbaid) + " slot=" + to_string(pbas);
    }
    if _starts_with(cmd, "pb dep ") {
        let pbda  = str_sub(cmd, 7, len(cmd));
        let pbds  = _find_space(pbda);
        let pbdtid = to_int(str_sub(pbda, 0, pbds));
        let pbddid = to_int(str_sub(pbda, pbds + 1, len(pbda)));
        pb_add_dep(pbdtid, pbddid);
        return "pb: dep added target=" + to_string(pbdtid) + " dep=" + to_string(pbddid);
    }
    if _starts_with(cmd, "pb build ") {
        let pbbid = to_int(str_sub(cmd, 9, len(cmd)));
        let pbbs  = pb_build(pbbid);
        return "pb: target=" + to_string(pbbid) + " status=" + to_string(pbbs);
    }
    if _starts_with(cmd, "pb status ") {
        let pbsid = to_int(str_sub(cmd, 10, len(cmd)));
        let pbss  = pb_get_status(pbsid);
        return "pb: target=" + to_string(pbsid) + " status=" + to_string(pbss);
    }

    // --- HLDoc ---
    if cmd == "hd init"    { hd_init(); return "hd: init"; }
    if cmd == "hd test"    { let hdr = hd_test(); return "hd: " + to_string(hdr); }
    if cmd == "hd count"   { return "hd: entries=" + to_string(hd_count()); }
    if _starts_with(cmd, "hd register ") {
        let hdra  = str_sub(cmd, 12, len(cmd));
        let hdrs0 = _find_space(hdra);
        let hdrid = to_int(str_sub(hdra, 0, hdrs0));
        let hdra2 = str_sub(hdra, hdrs0 + 1, len(hdra));
        let hdrs1 = _find_space(hdra2);
        let hdrtp = to_int(str_sub(hdra2, 0, hdrs1));
        let hdrmd = to_int(str_sub(hdra2, hdrs1 + 1, len(hdra2)));
        let hdrr  = hd_register(hdrid, hdrtp, hdrmd);
        return "hd: registered id=" + to_string(hdrid) + " type=" + to_string(hdrtp) + " slot=" + to_string(hdrr);
    }
    if _starts_with(cmd, "hd find ") {
        let hdfid = to_int(str_sub(cmd, 8, len(cmd)));
        let hdfi  = hd_find(hdfid);
        return "hd: id=" + to_string(hdfid) + " idx=" + to_string(hdfi);
    }
    if _starts_with(cmd, "hd type ") {
        let hdtid = to_int(str_sub(cmd, 8, len(cmd)));
        let hdtt  = hd_get_type(hdtid);
        return "hd: id=" + to_string(hdtid) + " type=" + to_string(hdtt);
    }
    if _starts_with(cmd, "hd countby ") {
        let hdctp = to_int(str_sub(cmd, 11, len(cmd)));
        let hdcc  = hd_count_by_type(hdctp);
        return "hd: type=" + to_string(hdctp) + " count=" + to_string(hdcc);
    }

    // --- HLTest ---
    if cmd == "ht init"    { ht_init(); return "ht: init"; }
    if cmd == "ht test"    { let htr = ht_test(); return "ht: " + to_string(htr); }
    if cmd == "ht count"   { return "ht: tests=" + to_string(ht_count()); }
    if cmd == "ht summary" { return "ht: pass=" + to_string(ht_summary()) + " fail=" + to_string(ht_n_fail); }
    if _starts_with(cmd, "ht register ") {
        let htrid = to_int(str_sub(cmd, 12, len(cmd)));
        let htrr  = ht_register(htrid);
        return "ht: registered id=" + to_string(htrid) + " slot=" + to_string(htrr);
    }
    if _starts_with(cmd, "ht record ") {
        let htrca  = str_sub(cmd, 10, len(cmd));
        let htrcs  = _find_space(htrca);
        let htrcid = to_int(str_sub(htrca, 0, htrcs));
        let htrcr  = to_int(str_sub(htrca, htrcs + 1, len(htrca)));
        ht_record(htrcid, htrcr);
        return "ht: id=" + to_string(htrcid) + " result=" + to_string(htrcr);
    }
    if _starts_with(cmd, "ht result ") {
        let htrsid = to_int(str_sub(cmd, 10, len(cmd)));
        let htrsr  = ht_get_result(htrsid);
        return "ht: id=" + to_string(htrsid) + " result=" + to_string(htrsr);
    }

    // --- HLBench ---
    if cmd == "hb init"    { hb_init(); return "hb: init"; }
    if cmd == "hb test"    { let hbr = hb_test(); return "hb: " + to_string(hbr); }
    if cmd == "hb count"   { return "hb: benches=" + to_string(hb_count()); }
    if _starts_with(cmd, "hb register ") {
        let hbra  = str_sub(cmd, 12, len(cmd));
        let hbrs  = _find_space(hbra);
        let hbrid = to_int(str_sub(hbra, 0, hbrs));
        let hbrit = to_int(str_sub(hbra, hbrs + 1, len(hbra)));
        let hbrr  = hb_register(hbrid, hbrit);
        return "hb: registered id=" + to_string(hbrid) + " iters=" + to_string(hbrit) + " slot=" + to_string(hbrr);
    }
    if _starts_with(cmd, "hb time ") {
        let hbta  = str_sub(cmd, 8, len(cmd));
        let hbts  = _find_space(hbta);
        let hbtid = to_int(str_sub(hbta, 0, hbts));
        let hbttk = to_int(str_sub(hbta, hbts + 1, len(hbta)));
        hb_record_time(hbtid, hbttk);
        return "hb: id=" + to_string(hbtid) + " ticks=" + to_string(hbttk);
    }
    if _starts_with(cmd, "hb result ") {
        let hbrid = to_int(str_sub(cmd, 10, len(cmd)));
        let hbrt  = hb_get_time(hbrid);
        return "hb: id=" + to_string(hbrid) + " time=" + to_string(hbrt) + " iters=" + to_string(hb_get_iters(hbrid));
    }
    if _starts_with(cmd, "hb thru ") {
        let hbthid = to_int(str_sub(cmd, 8, len(cmd)));
        let hbthr  = hb_throughput(hbthid);
        return "hb: id=" + to_string(hbthid) + " throughput=" + to_string(hbthr);
    }

    // --- LSP Server ---
    if cmd == "ls init"   { ls_init(); return "ls: init"; }
    if cmd == "ls test"   { let lsr = ls_test(); return "ls: " + to_string(lsr); }
    if cmd == "ls ndocs"  { return "ls: docs=" + to_string(ls_ndocs()); }
    if _starts_with(cmd, "ls open ") {
        let lsoa  = str_sub(cmd, 8, len(cmd));
        let lsos  = _find_space(lsoa);
        let lsoid = to_int(str_sub(lsoa, 0, lsos));
        let lsov  = to_int(str_sub(lsoa, lsos + 1, len(lsoa)));
        let lsor  = ls_open(lsoid, lsov);
        return "ls: opened doc=" + to_string(lsoid) + " ver=" + to_string(lsov) + " slot=" + to_string(lsor);
    }
    if _starts_with(cmd, "ls close ") {
        let lscid = to_int(str_sub(cmd, 9, len(cmd)));
        ls_close(lscid);
        return "ls: closed doc=" + to_string(lscid);
    }
    if _starts_with(cmd, "ls diag ") {
        let lsda  = str_sub(cmd, 8, len(cmd));
        let lsds  = _find_space(lsda);
        let lsdid = to_int(str_sub(lsda, 0, lsds));
        let lsdc  = to_int(str_sub(lsda, lsds + 1, len(lsda)));
        ls_add_diag(lsdid, lsdc);
        return "ls: diag added doc=" + to_string(lsdid) + " code=" + to_string(lsdc);
    }
    if _starts_with(cmd, "ls diagcount ") {
        let lsdcid = to_int(str_sub(cmd, 13, len(cmd)));
        let lsdcc  = ls_get_diag_count(lsdcid);
        return "ls: doc=" + to_string(lsdcid) + " diags=" + to_string(lsdcc);
    }

    // --- Syntax Highlight ---
    if cmd == "sh init"  { sh_init(); return "sh: init"; }
    if cmd == "sh test"  { let shr = sh_test(); return "sh: " + to_string(shr); }
    if cmd == "sh count" { return "sh: rules=" + to_string(sh_count()); }
    if _starts_with(cmd, "sh add ") {
        let shaa  = str_sub(cmd, 7, len(cmd));
        let shas0 = _find_space(shaa);
        let shatk = to_int(str_sub(shaa, 0, shas0));
        let shaa2 = str_sub(shaa, shas0 + 1, len(shaa));
        let shas1 = _find_space(shaa2);
        let shacl = to_int(str_sub(shaa2, 0, shas1));
        let shatp = to_int(str_sub(shaa2, shas1 + 1, len(shaa2)));
        let shar  = sh_add_rule(shatk, shacl, shatp);
        return "sh: added token=" + to_string(shatk) + " color=" + to_string(shacl) + " slot=" + to_string(shar);
    }
    if _starts_with(cmd, "sh color ") {
        let shctk = to_int(str_sub(cmd, 9, len(cmd)));
        let shcc  = sh_get_color(shctk);
        return "sh: token=" + to_string(shctk) + " color=" + to_string(shcc);
    }
    if _starts_with(cmd, "sh type ") {
        let shttk = to_int(str_sub(cmd, 8, len(cmd)));
        let shtt  = sh_get_type(shttk);
        return "sh: token=" + to_string(shttk) + " type=" + to_string(shtt);
    }
    if _starts_with(cmd, "sh find ") {
        let shftk = to_int(str_sub(cmd, 8, len(cmd)));
        let shfi  = sh_find_rule(shftk);
        return "sh: token=" + to_string(shftk) + " idx=" + to_string(shfi);
    }

    // --- Code Complete ---
    if cmd == "cc init"  { cc_init(); return "cc: init"; }
    if cmd == "cc test"  { let ccr = cc_test(); return "cc: " + to_string(ccr); }
    if cmd == "cc count" { return "cc: items=" + to_string(cc_count()); }
    if cmd == "cc best"  { let ccb = cc_get_best(); return "cc: best id=" + to_string(ccb); }
    if _starts_with(cmd, "cc add ") {
        let ccaa  = str_sub(cmd, 7, len(cmd));
        let ccas0 = _find_space(ccaa);
        let ccaid = to_int(str_sub(ccaa, 0, ccas0));
        let ccaa2 = str_sub(ccaa, ccas0 + 1, len(ccaa));
        let ccas1 = _find_space(ccaa2);
        let ccatp = to_int(str_sub(ccaa2, 0, ccas1));
        let ccasc = to_int(str_sub(ccaa2, ccas1 + 1, len(ccaa2)));
        let ccar  = cc_add(ccaid, ccatp, ccasc);
        return "cc: added id=" + to_string(ccaid) + " score=" + to_string(ccasc) + " slot=" + to_string(ccar);
    }
    if _starts_with(cmd, "cc score ") {
        let ccsid = to_int(str_sub(cmd, 9, len(cmd)));
        let ccss  = cc_get_score(ccsid);
        return "cc: id=" + to_string(ccsid) + " score=" + to_string(ccss);
    }
    if _starts_with(cmd, "cc find ") {
        let ccfid = to_int(str_sub(cmd, 8, len(cmd)));
        let ccfi  = cc_find(ccfid);
        return "cc: id=" + to_string(ccfid) + " idx=" + to_string(ccfi);
    }

    // --- Debugger ---
    if cmd == "dbg init" { dbg_init(); return "dbg: init"; }
    if cmd == "dbg test" { let dr = dbg_test(); return "dbg: " + to_string(dr); }
    if _starts_with(cmd, "dbg attach ") {
        let dba   = str_sub(cmd, 11, len(cmd));
        let dbs0  = _find_space(dba);
        let dbsid = to_int(str_sub(dba, 0, dbs0));
        let dba2  = str_sub(dba, dbs0 + 1, len(dba));
        let dbs1  = _find_space(dba2);
        let dbrip = to_int(str_sub(dba2, 0, dbs1));
        let dbrsp = to_int(str_sub(dba2, dbs1 + 1, len(dba2)));
        dbg_attach(dbsid, dbrip, dbrsp);
        return "dbg: attached id=" + to_string(dbsid) + " rip=" + to_string(dbrip);
    }
    if _starts_with(cmd, "dbg step ") {
        let dbstid = to_int(str_sub(cmd, 9, len(cmd)));
        let dbstr  = dbg_step(dbstid);
        return "dbg: id=" + to_string(dbstid) + " rip=" + to_string(dbstr);
    }
    if _starts_with(cmd, "dbg cont ") {
        let dbcid = to_int(str_sub(cmd, 9, len(cmd)));
        dbg_continue(dbcid);
        return "dbg: id=" + to_string(dbcid) + " state=RUNNING";
    }
    if _starts_with(cmd, "dbg rip ") {
        let dbrid = to_int(str_sub(cmd, 8, len(cmd)));
        let dbrv  = dbg_get_rip(dbrid);
        return "dbg: id=" + to_string(dbrid) + " rip=" + to_string(dbrv);
    }
    if _starts_with(cmd, "dbg steps ") {
        let dbssid = to_int(str_sub(cmd, 10, len(cmd)));
        let dbssv  = dbg_get_steps(dbssid);
        return "dbg: id=" + to_string(dbssid) + " steps=" + to_string(dbssv);
    }

    // --- GDB Stub ---
    if cmd == "gs init"   { gs_init(); return "gs: init"; }
    if cmd == "gs test"   { let gsr = gs_test(); return "gs: " + to_string(gsr); }
    if cmd == "gs count"  { return "gs: pkts=" + to_string(gs_count()); }
    if cmd == "gs halted" { return "gs: halted=" + to_string(gs_is_halted()); }
    if _starts_with(cmd, "gs pkt ") {
        let gspa  = str_sub(cmd, 7, len(cmd));
        let gsps  = _find_space(gspa);
        let gspc  = to_int(str_sub(gspa, 0, gsps));
        let gspa2 = to_int(str_sub(gspa, gsps + 1, len(gspa)));
        let gspr  = gs_send_pkt(gspc, gspa2);
        return "gs: cmd=" + to_string(gspc) + " result=" + to_string(gspr);
    }
    if _starts_with(cmd, "gs reg ") {
        let gsri  = to_int(str_sub(cmd, 7, len(cmd)));
        let gsrv  = gs_read_reg(gsri);
        return "gs: reg[" + to_string(gsri) + "]=" + to_string(gsrv);
    }
    if _starts_with(cmd, "gs wreg ") {
        let gswra = str_sub(cmd, 8, len(cmd));
        let gswrs = _find_space(gswra);
        let gswri = to_int(str_sub(gswra, 0, gswrs));
        let gswrv = to_int(str_sub(gswra, gswrs + 1, len(gswra)));
        gs_write_reg(gswri, gswrv);
        return "gs: reg[" + to_string(gswri) + "]=" + to_string(gswrv);
    }

    // --- Breakpoints ---
    if cmd == "bp init" { bp_init(); return "bp: init"; }
    if cmd == "bp test" { let bpr = bp_test(); return "bp: " + to_string(bpr); }
    if _starts_with(cmd, "bp set ") {
        let bpsa = to_int(str_sub(cmd, 7, len(cmd)));
        let bpsr = bp_set(bpsa);
        return "bp: set addr=" + to_string(bpsa) + " slot=" + to_string(bpsr);
    }
    if _starts_with(cmd, "bp enable ") {
        let bpea = to_int(str_sub(cmd, 10, len(cmd)));
        bp_enable(bpea);
        return "bp: enabled addr=" + to_string(bpea);
    }
    if _starts_with(cmd, "bp disable ") {
        let bpda = to_int(str_sub(cmd, 11, len(cmd)));
        bp_disable(bpda);
        return "bp: disabled addr=" + to_string(bpda);
    }
    if _starts_with(cmd, "bp hit ") {
        let bpha = to_int(str_sub(cmd, 7, len(cmd)));
        let bphr = bp_hit(bpha);
        return "bp: addr=" + to_string(bpha) + " hits=" + to_string(bphr);
    }
    if _starts_with(cmd, "bp hits ") {
        let bphsa = to_int(str_sub(cmd, 8, len(cmd)));
        let bphsv = bp_get_hits(bphsa);
        return "bp: addr=" + to_string(bphsa) + " total_hits=" + to_string(bphsv);
    }

    // --- H-L REPL ---
    if cmd == "repl init" { repl_init(); return "repl: init"; }
    if cmd == "repl test" { let repltr = hl_repl_test(); return "repl: " + to_string(repltr); }
    if _starts_with(cmd, "repl exec ") {
        let replexpr = to_int(str_sub(cmd, 10, len(cmd)));
        let replres = repl_exec_line(replexpr);
        return "repl: expr=" + to_string(replexpr) + " result=" + to_string(replres);
    }
    if _starts_with(cmd, "repl setvar ") {
        let replsv_sp = _find_space(str_sub(cmd, 12, len(cmd)));
        let replsv_id = to_int(str_sub(cmd, 12, 12 + replsv_sp));
        let replsv_val = to_int(str_sub(cmd, 12 + replsv_sp + 1, len(cmd)));
        repl_set_var(replsv_id, replsv_val);
        return "repl: setvar id=" + to_string(replsv_id) + " val=" + to_string(replsv_val);
    }
    if _starts_with(cmd, "repl getvar ") {
        let replgv_id = to_int(str_sub(cmd, 12, len(cmd)));
        let replgv_val = repl_get_var(replgv_id);
        return "repl: getvar id=" + to_string(replgv_id) + " val=" + to_string(replgv_val);
    }
    if cmd == "repl history" { let replhc = repl_get_history_count(); return "repl: history_count=" + to_string(replhc); }
    if cmd == "repl clear" { repl_clear_history(); return "repl: history cleared"; }

    // --- H-L Formatter ---
    if cmd == "fmt init" { fmt_init(); return "fmt: init"; }
    if cmd == "fmt test" { let fmttr = hl_fmt_test(); return "fmt: " + to_string(fmttr); }
    if _starts_with(cmd, "fmt add ") {
        let fmtln = to_int(str_sub(cmd, 8, len(cmd)));
        let fmtidx = fmt_add_line(fmtln);
        return "fmt: added line=" + to_string(fmtln) + " idx=" + to_string(fmtidx);
    }
    if cmd == "fmt count" { let fmtcnt = fmt_get_line_count(); return "fmt: line_count=" + to_string(fmtcnt); }
    if cmd == "fmt depth" { let fmtdep = fmt_get_current_depth(); return "fmt: brace_depth=" + to_string(fmtdep); }
    if cmd == "fmt reset" { fmt_reset(); return "fmt: reset"; }
    if _starts_with(cmd, "fmt indent ") {
        let fmtil_line = to_int(str_sub(cmd, 11, len(cmd)));
        let fmtil = fmt_get_indent_level(fmtil_line);
        return "fmt: indent_level=" + to_string(fmtil);
    }

    // --- H-L Enhanced Lint ---
    if cmd == "lint init" { lint_init(); return "lint: init"; }
    if cmd == "lint test" { let linttr = hl_lint2_test(); return "lint: " + to_string(linttr); }
    if _starts_with(cmd, "lint defvar ") {
        let lintdv = to_int(str_sub(cmd, 12, len(cmd)));
        lint_define_var(lintdv);
        return "lint: defined var=" + to_string(lintdv);
    }
    if _starts_with(cmd, "lint usevar ") {
        let lintuv = to_int(str_sub(cmd, 12, len(cmd)));
        lint_use_var(lintuv);
        return "lint: used var=" + to_string(lintuv);
    }
    if cmd == "lint check" { let lintwc = lint_check_unused_vars(); return "lint: warnings=" + to_string(lintwc); }
    if cmd == "lint complexity" { let lintcx = lint_get_complexity(); return "lint: complexity=" + to_string(lintcx); }
    if cmd == "lint issues" { let lintis = lint_get_issue_count(); return "lint: issues=" + to_string(lintis); }

    // --- POSIX Compat ---
    if cmd == "pc init" { posix_compat_init(); return "pc: init"; }
    if cmd == "pc test" { let pctr = posix_compat_test(); return "pc: " + to_string(pctr); }
    if _starts_with(cmd, "pc sigaction ") {
        let pcsa_sp  = _find_space(str_sub(cmd, 13, len(cmd)));
        let pcsa_sig = to_int(str_sub(cmd, 13, 13 + pcsa_sp));
        let pcsa_h   = to_int(str_sub(cmd, 13 + pcsa_sp + 1, len(cmd)));
        pc_sigaction(pcsa_sig, pcsa_h);
        return "pc: sigaction sig=" + to_string(pcsa_sig) + " handler=" + to_string(pcsa_h);
    }
    if _starts_with(cmd, "pc raise ") {
        let pcra = to_int(str_sub(cmd, 9, len(cmd)));
        pc_raise(pcra);
        return "pc: raised sig=" + to_string(pcra);
    }
    if cmd == "pc fork" { let pcfpid = pc_fork(); return "pc: forked pid=" + to_string(pcfpid); }
    if _starts_with(cmd, "pc waitpid ") {
        let pcwp = to_int(str_sub(cmd, 11, len(cmd)));
        pc_waitpid(pcwp);
        return "pc: waited pid=" + to_string(pcwp);
    }
    if _starts_with(cmd, "pc kill ") {
        let pcksp  = _find_space(str_sub(cmd, 8, len(cmd)));
        let pckpid = to_int(str_sub(cmd, 8, 8 + pcksp));
        let pcksig = to_int(str_sub(cmd, 8 + pcksp + 1, len(cmd)));
        pc_kill(pckpid, pcksig);
        return "pc: kill pid=" + to_string(pckpid) + " sig=" + to_string(pcksig);
    }

    // --- musl shim ---
    if cmd == "ms init" { musl_shim_init(); return "ms: init"; }
    if cmd == "ms test" { let mstr = musl_shim_test(); return "ms: " + to_string(mstr); }
    if _starts_with(cmd, "ms malloc ") {
        let mssz  = to_int(str_sub(cmd, 10, len(cmd)));
        let msadr = ms_malloc(mssz);
        return "ms: malloc sz=" + to_string(mssz) + " addr=" + to_string(msadr);
    }
    if _starts_with(cmd, "ms free ") {
        let msfa = to_int(str_sub(cmd, 8, len(cmd)));
        ms_free(msfa);
        return "ms: free addr=" + to_string(msfa);
    }
    if _starts_with(cmd, "ms fopen ") {
        let msfop_sp = _find_space(str_sub(cmd, 9, len(cmd)));
        let msfop_id = to_int(str_sub(cmd, 9, 9 + msfop_sp));
        let msfop_md = to_int(str_sub(cmd, 9 + msfop_sp + 1, len(cmd)));
        let msfoph = ms_fopen(msfop_id, msfop_md);
        return "ms: fopen id=" + to_string(msfop_id) + " handle=" + to_string(msfoph);
    }
    if _starts_with(cmd, "ms fwrite ") {
        let msfwsp = _find_space(str_sub(cmd, 10, len(cmd)));
        let msfwh  = to_int(str_sub(cmd, 10, 10 + msfwsp));
        let msfwn  = to_int(str_sub(cmd, 10 + msfwsp + 1, len(cmd)));
        let msfwr  = ms_fwrite(msfwh, msfwn);
        return "ms: fwrite handle=" + to_string(msfwh) + " n=" + to_string(msfwn) + " wrote=" + to_string(msfwr);
    }
    if _starts_with(cmd, "ms fread ") {
        let msfrsp = _find_space(str_sub(cmd, 9, len(cmd)));
        let msfrh  = to_int(str_sub(cmd, 9, 9 + msfrsp));
        let msfrn  = to_int(str_sub(cmd, 9 + msfrsp + 1, len(cmd)));
        let msfrr  = ms_fread(msfrh, msfrn);
        return "ms: fread handle=" + to_string(msfrh) + " n=" + to_string(msfrn) + " got=" + to_string(msfrr);
    }

    // --- Linux syscall ---
    if cmd == "ls init" { linux_syscall_init(); return "ls: init"; }
    if cmd == "ls test" { let lstr = linux_syscall_test(); return "ls: " + to_string(lstr); }
    if _starts_with(cmd, "ls syscall ") {
        let lssc_s1 = _find_space(str_sub(cmd, 11, len(cmd)));
        let lsno    = to_int(str_sub(cmd, 11, 11 + lssc_s1));
        let lsrest  = str_sub(cmd, 11 + lssc_s1 + 1, len(cmd));
        let lssc_s2 = _find_space(lsrest);
        let lsarg0  = to_int(str_sub(lsrest, 0, lssc_s2));
        let lsarg1  = to_int(str_sub(lsrest, lssc_s2 + 1, len(lsrest)));
        let lsres   = ls_syscall(lsno, lsarg0, lsarg1);
        return "ls: syscall no=" + to_string(lsno) + " result=" + to_string(lsres);
    }
    if cmd == "ls reads"  { return "ls: total_reads="  + to_string(ls_get_total_reads()); }
    if cmd == "ls writes" { return "ls: total_writes=" + to_string(ls_get_total_writes()); }
    if cmd == "ls brk"    { return "ls: brk="          + to_string(ls_get_brk()); }
    if cmd == "ls maps"   { return "ls: map_count="    + to_string(ls_get_map_count()); }

    // --- WASM Runtime ---
    if cmd == "wr init" { wasm_runtime_init(); return "wr: init"; }
    if cmd == "wr test" { let wrtr = wasm_runtime_test(); return "wr: " + to_string(wrtr); }
    if _starts_with(cmd, "wr defunc ") {
        let wrdf = to_int(str_sub(cmd, 10, len(cmd)));
        wr_define_func(wrdf);
        return "wr: defined func=" + to_string(wrdf);
    }
    if _starts_with(cmd, "wr emit ") {
        let wre_rest = str_sub(cmd, 8, len(cmd));
        let wre_s1   = _find_space(wre_rest);
        let wre_fid  = to_int(str_sub(wre_rest, 0, wre_s1));
        let wre_r2   = str_sub(wre_rest, wre_s1 + 1, len(wre_rest));
        let wre_s2   = _find_space(wre_r2);
        let wre_op   = to_int(str_sub(wre_r2, 0, wre_s2));
        let wre_arg  = to_int(str_sub(wre_r2, wre_s2 + 1, len(wre_r2)));
        let wre_pos  = wr_emit(wre_fid, wre_op, wre_arg);
        return "wr: emitted func=" + to_string(wre_fid) + " op=" + to_string(wre_op) + " pos=" + to_string(wre_pos);
    }
    if _starts_with(cmd, "wr call ") {
        let wrcid = to_int(str_sub(cmd, 8, len(cmd)));
        let wrcr  = wr_call(wrcid);
        return "wr: call func=" + to_string(wrcid) + " result=" + to_string(wrcr);
    }
    if _starts_with(cmd, "wr calls ") {
        let wrcci = to_int(str_sub(cmd, 9, len(cmd)));
        let wrccv = wr_get_call_count(wrcci);
        return "wr: func=" + to_string(wrcci) + " calls=" + to_string(wrccv);
    }
    if cmd == "wr funcs" { let wrfc = wr_get_func_count(); return "wr: func_count=" + to_string(wrfc); }

    // --- WASM JIT ---
    if cmd == "wj init" { wasm_jit_init(); return "wj: init"; }
    if cmd == "wj test" { let wjtr = wasm_jit_test(); return "wj: " + to_string(wjtr); }
    if _starts_with(cmd, "wj reg ") {
        let wjreg = to_int(str_sub(cmd, 7, len(cmd)));
        wj_register(wjreg);
        return "wj: registered func=" + to_string(wjreg);
    }
    if _starts_with(cmd, "wj tick ") {
        let wjtid  = to_int(str_sub(cmd, 8, len(cmd)));
        let wjtst  = wj_tick(wjtid);
        return "wj: tick func=" + to_string(wjtid) + " state=" + to_string(wjtst);
    }
    if _starts_with(cmd, "wj hot ") {
        let wjhid = to_int(str_sub(cmd, 7, len(cmd)));
        let wjhv  = wj_is_hot(wjhid);
        return "wj: func=" + to_string(wjhid) + " hot=" + to_string(wjhv);
    }
    if _starts_with(cmd, "wj stub ") {
        let wjsid = to_int(str_sub(cmd, 8, len(cmd)));
        let wjsa  = wj_get_stub_addr(wjsid);
        let wjsb  = wj_get_stub_bytes(wjsid);
        return "wj: func=" + to_string(wjsid) + " stub_addr=" + to_string(wjsa) + " bytes=" + to_string(wjsb);
    }
    if cmd == "wj compiled" { let wjc = wj_get_total_compiled(); return "wj: total_compiled=" + to_string(wjc); }
}

// Self-test
print(shell_handle("help"));
print(shell_handle("ver"));
print(shell_handle("free"));
print(shell_handle("hilbert"));
print(shell_handle("fib 10"));
print(shell_handle("ps"));
print(shell_handle_ext("whoami"));
