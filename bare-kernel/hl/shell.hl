        print("Hungarian:   hu set <i> <j> <w>  hu run  hu cost  hu match <i>  hu setn <n>  hu test");
        print("HopcroftKarp: hk add <l> <r>  hk run  hk size  hk setnl <nl>  hk setnr <nr>  hk test");
        print("MinCostFlow: mcf add <u> <v> <cap> <cost>  mcf run <src> <sink>  mcf flow  mcf cost  mcf setn <n>  mcf test");
