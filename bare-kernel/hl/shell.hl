        let raiu = to_int(str_sub(raiargs, 0, raisp));
        let raiv = to_int(str_sub(raiargs, raisp + 1, len(raiargs)));
        ra_add_interfere(raiu, raiv);
        return "ra: interfere " + to_string(raiu) + "," + to_string(raiv);
    }

    if cmd == "cg init" { cg_init(); return "cg: init"; }
    if cmd == "cg test" { let cgt = cg_test(); return "cg: " + to_string(cgt); }
