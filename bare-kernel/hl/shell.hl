    if cmd == "pst init"  { ps_init(); return "pst: init"; }
    if cmd == "pst test"  { let pstt = pst_test(); return "pst: " + to_string(pstt); }
    if cmd == "pst ver"   { return "pst: ver=" + to_string(ps_ver); }
    if cmd == "pst pool"  { return "pst: pool=" + to_string(ps_pool); }
