        let ireargs = str_sub(cmd, 8, len(cmd));
        let iresp   = _find_space(ireargs);
        if iresp < 0 { return "ir edge: usage ir edge <pred> <succ>"; }
        let irep = to_int(str_sub(ireargs, 0, iresp));
        let ires = to_int(str_sub(ireargs, iresp + 1, len(ireargs)));
        ir_add_edge(irep, ires);
        return "ir: edge " + to_string(irep) + "->" + to_string(ires);
    }

    if cmd == "ra init"   { ra_init(); return "ra: init"; }
    if cmd == "ra test"   { let rat = ra_test(); return "ra: " + to_string(rat); }
    if cmd == "ra run"    { let rar = ra_run(); return "ra: spills=" + to_string(rar); }
    if cmd == "ra spills" { return "ra: spills=" + to_string(ra_spill); }
