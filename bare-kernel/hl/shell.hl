        let nt_a  = to_int(nt_ia);
        let nt_m  = to_int(str_sub(nt_ia, 2, len(nt_ia)));
        return "nt: inv(" + to_string(nt_a) + "," + to_string(nt_m) + ")=" + to_string(nt_mod_inv(nt_a, nt_m));
    }
    if cmd == "nt crt"  { return "nt: crt(2,3,3,5)=" + to_string(nt_crt(2, 3, 3, 5)); }
    if _starts_with(cmd, "nt gcd ") {
        let nt_ga  = str_sub(cmd, 7, len(cmd));
        let nt_ga1 = to_int(nt_ga);
        let nt_gb1 = to_int(str_sub(nt_ga, 2, len(nt_ga)));
        nt_gcd_ext(nt_ga1, nt_gb1);
        return "nt: gcd=" + to_string(nt_gcd) + " x=" + to_string(nt_x) + " y=" + to_string(nt_y);
