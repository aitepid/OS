// codegen.hl -- Peephole Optimizer + Dead Code Elimination
// Operates on a copied instruction stream (same opcode set as ir.hl).
// cg_peephole(): identity copies, add-zero, mul-one → COPY; returns change count.
// cg_dce(): single-pass dead register elimination; returns removed count.
// Runtime buffer: 0x1720000

let CG_MAX_INST = 64;
let CG_MAX_REG  = 32;

let CG_COPY = 1;
let CG_ADD  = 2;
let CG_MUL  = 4;
let CG_RET  = 8;

let cg_op       = array(64, 0);
let cg_dst      = array(64, 0);
let cg_src1     = array(64, 0);
let cg_src2     = array(64, 0);
let cg_live     = array(64, 1);
let cg_reg_used = array(32, 0);
let cg_n        = 0;
let cg_opts     = 0;

fn cg_init() {
    cg_n    = 0;
    cg_opts = 0;
    let mut i = 0;
    while i < 64 {
        set_at(cg_op,   i, 0); set_at(cg_dst,  i, 0);
        set_at(cg_src1, i, 0); set_at(cg_src2, i, 0);
        set_at(cg_live, i, 1);
        i += 1;
    }
    i = 0;
    while i < 32 { set_at(cg_reg_used, i, 0); i += 1; }
    return 0;
}

fn cg_emit(op, dst, src1, src2) {
    let mut idx = cg_n;
    set_at(cg_op,   idx, op);
    set_at(cg_dst,  idx, dst);
    set_at(cg_src1, idx, src1);
    set_at(cg_src2, idx, src2);
    set_at(cg_live, idx, 1);
    cg_n += 1;
    return idx;
}

fn cg_peephole() {
    let i       = 0;
    let count   = 0;
    let changed = 1;
    while changed == 1 {
        changed = 0;
        i = 0;
        while i < cg_n {
            if cg_live[i] == 1 {
                if cg_op[i] == CG_COPY {
                    if cg_dst[i] == cg_src1[i] {
                        set_at(cg_live, i, 0);
                        count   += 1;
                        changed  = 1;
                    }
                }
                if cg_live[i] == 1 {
                    if cg_op[i] == CG_ADD {
                        if cg_src2[i] == 0 {
                            set_at(cg_op,   i, CG_COPY);
                            count   += 1;
                            changed  = 1;
                        }
                    }
                }
                if cg_live[i] == 1 {
                    if cg_op[i] == CG_MUL {
                        if cg_src2[i] == 1 {
                            set_at(cg_op,   i, CG_COPY);
                            set_at(cg_src2, i, 0);
                            count   += 1;
                            changed  = 1;
                        }
                    }
                }
            }
            i += 1;
        }
    }
    cg_opts += count;
    return count;
}

fn cg_dce() {
    let i     = 0;
    let mut count = 0;
    while i < 32 { set_at(cg_reg_used, i, 0); i += 1; }
    i = 0;
    while i < cg_n {
        if cg_live[i] == 1 {
            if cg_src1[i] < 32 { set_at(cg_reg_used, cg_src1[i], 1); }
            if cg_src2[i] < 32 { set_at(cg_reg_used, cg_src2[i], 1); }
        }
        i += 1;
    }
    i = 0;
    while i < cg_n {
        if cg_live[i] == 1 {
            if cg_op[i] != 0 {
                if cg_op[i] != CG_RET {
                    if cg_dst[i] < 32 {
                        if cg_reg_used[cg_dst[i]] == 0 {
                            set_at(cg_live, i, 0);
                            count += 1;
                        }
                    }
                }
            }
        }
        i += 1;
    }
    cg_opts += count;
    return count;
}

fn cg_test() {
    cg_init();
    cg_emit(CG_ADD,  2, 1, 0);
    cg_emit(CG_COPY, 0, 0, 0);
    cg_emit(CG_MUL,  3, 4, 1);
    let cnt = cg_peephole();
    print("cg_test: opts=" + to_string(cnt) + " live0=" + to_string(cg_live[0]) + " live1=" + to_string(cg_live[1]) + " live2=" + to_string(cg_live[2]));
    if cnt == 3 {
        if cg_live[1] == 0 {
            print("cg_test: PASS");
            return 1;
        }
    }
    print("cg_test: FAIL");
    return 0;
}

print("codegen.hl loaded");
