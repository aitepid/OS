// codegen.hl -- H-L AST -> x86_64 Native Code Generator
//
// Full native compilation pipeline:
//   AST -> H-IR (ir.hl) -> Register Allocation (regalloc.hl) -> x86_64
//
// Supports: Let, Assign, Return, If/Else, While, For, FnDef, FnCall,
//           BinOp (+,-,*,/,%,==,!=,<,<=,>,>=,&,|,^,<<,>>), Unary (-,!)
//
// Strategy:
//   - Variables assigned to registers by linear scan (regalloc.hl)
//   - Spills to stack when registers exhausted
//   - Function calls use System V AMD64 ABI (abi.hl)
//   - Optimized by H-IR passes: const fold, DCE, strength reduce
//   - All values are 64-bit integers (i64)
//
// Register convention:
//   RAX = expression result / return value
//   RBX = scratch (callee-saved)
//   RCX, RDX = scratch
//   RSP = stack pointer (reserved)
//   RBP = frame pointer (reserved)
//   RDI, RSI, RDX, RCX, R8, R9 = function arguments

// RAX=0 RCX=1 RDX=2 RBX=3 RSP=4 RBP=5 RSI=6 RDI=7

let mut label_counter = 0;
fn new_label() {
    label_counter = label_counter + 1;
    return label_counter;
}

// Variable table: array of [name, rbp_offset]
// Each variable occupies 8 bytes on the stack
let mut var_table = [];
let mut stack_offset = 0;

fn var_lookup(name) {
    let mut i = len(var_table) - 1;
    while i >= 0 {
        if var_table[i][0] == name {
            return var_table[i][1];
        }
        i = i - 1;
    }
    return 0; // not found
}

fn var_alloc(name) {
    stack_offset = stack_offset + 8;
    push(var_table, [name, 0 - stack_offset]);
    return 0 - stack_offset;
}

// === Code generation for each AST node type ===

// Emit function prologue
fn emit_prologue(buf) {
    x86enc.emit_push_r64(buf, 5);         // push rbp
    x86enc.emit_mov_r64_r64(buf, 5, 4);   // mov rbp, rsp
    return 0;
}

// Emit function epilogue
fn emit_epilogue(buf) {
    x86enc.emit_mov_r64_r64(buf, 4, 5);   // mov rsp, rbp
    x86enc.emit_pop_r64(buf, 5);           // pop rbp
    x86enc.emit_ret(buf);
    return 0;
}

// Compile a numeric literal: result in RAX
fn compile_num(buf, value) {
    if value >= 0 {
        if value < 2147483648 {
            x86enc.emit_mov_r64_imm32(buf, 0, value);  // mov rax, imm32
        } else {
            x86enc.emit_mov_r64_imm64(buf, 0, value);  // mov rax, imm64
        }
    } else {
        x86enc.emit_mov_r64_imm32(buf, 0, value);      // mov rax, imm32 (sign-ext)
    }
    return 0;
}

// Compile variable reference: load from stack into RAX
fn compile_var(buf, name) {
    let offset = var_lookup(name);
    x86enc.emit_mov_r64_mem_disp8(buf, 0, 5, offset); // mov rax, [rbp+offset]
    return 0;
}

// Compile variable assignment: store RAX to stack
fn compile_assign(buf, name) {
    let offset = var_lookup(name);
    if offset == 0 {
        offset = var_alloc(name);
        // sub rsp, 8 to make room
        x86enc.emit_sub_r64_imm8(buf, 4, 8);
    }
    x86enc.emit_mov_mem_disp8_r64(buf, 5, offset, 0); // mov [rbp+offset], rax
    return 0;
}

// Compile binary operation: left in RAX, right pushed, compute
fn compile_binop(buf, op) {
    // After this: left is on stack, right is in RAX
    // Pop left into RBX, result in RAX
    x86enc.emit_mov_r64_r64(buf, 3, 0);   // mov rbx, rax (right)
    x86enc.emit_pop_r64(buf, 0);           // pop rax (left)

    if op == "+" {
        // add rax, rbx
        x86enc.buf_emit(buf, 72); x86enc.buf_emit(buf, 1);
        x86enc.buf_emit(buf, 216); // add rax, rbx = 48 01 D8
        return 0;
    }
    if op == "-" {
        // sub rax, rbx
        x86enc.buf_emit(buf, 72); x86enc.buf_emit(buf, 41);
        x86enc.buf_emit(buf, 216); // sub rax, rbx = 48 29 D8
        return 0;
    }
    if op == "*" {
        // imul rax, rbx
        x86enc.buf_emit(buf, 72); x86enc.buf_emit(buf, 15);
        x86enc.buf_emit(buf, 175); x86enc.buf_emit(buf, 195);
        return 0;
    }
    if op == "/" {
        // cqo; idiv rbx
        x86enc.buf_emit(buf, 72); x86enc.buf_emit(buf, 153);  // cqo
        x86enc.buf_emit(buf, 72); x86enc.buf_emit(buf, 247);  // idiv rbx
        x86enc.buf_emit(buf, 251);
        return 0;
    }
    if op == "%" {
        // cqo; idiv rbx; mov rax, rdx
        x86enc.buf_emit(buf, 72); x86enc.buf_emit(buf, 153);
        x86enc.buf_emit(buf, 72); x86enc.buf_emit(buf, 247);
        x86enc.buf_emit(buf, 251);
        x86enc.emit_mov_r64_r64(buf, 0, 2); // mov rax, rdx (remainder)
        return 0;
    }

    // Comparison ops: cmp + setcc + movzx
    if op == "==" {
        x86enc.emit_cmp_r64_imm8(buf, 0, 0); // patch compare target
        // Actually: cmp rax, rbx; sete al; movzx rax, al
        x86enc.buf_emit(buf, 72); x86enc.buf_emit(buf, 57);
        x86enc.buf_emit(buf, 216); // cmp rax, rbx
        // sete al
        x86enc.buf_emit(buf, 15); x86enc.buf_emit(buf, 148); x86enc.buf_emit(buf, 192);
        // movzx rax, al
        x86enc.buf_emit(buf, 72); x86enc.buf_emit(buf, 15);
        x86enc.buf_emit(buf, 182); x86enc.buf_emit(buf, 192);
        return 0;
    }
    if op == "!=" {
        x86enc.buf_emit(buf, 72); x86enc.buf_emit(buf, 57); x86enc.buf_emit(buf, 216);
        x86enc.buf_emit(buf, 15); x86enc.buf_emit(buf, 149); x86enc.buf_emit(buf, 192);
        x86enc.buf_emit(buf, 72); x86enc.buf_emit(buf, 15); x86enc.buf_emit(buf, 182); x86enc.buf_emit(buf, 192);
        return 0;
    }
    if op == "<" {
        x86enc.buf_emit(buf, 72); x86enc.buf_emit(buf, 57); x86enc.buf_emit(buf, 216);
        x86enc.buf_emit(buf, 15); x86enc.buf_emit(buf, 156); x86enc.buf_emit(buf, 192); // setl
        x86enc.buf_emit(buf, 72); x86enc.buf_emit(buf, 15); x86enc.buf_emit(buf, 182); x86enc.buf_emit(buf, 192);
        return 0;
    }
    if op == "<=" {
        x86enc.buf_emit(buf, 72); x86enc.buf_emit(buf, 57); x86enc.buf_emit(buf, 216);
        x86enc.buf_emit(buf, 15); x86enc.buf_emit(buf, 158); x86enc.buf_emit(buf, 192); // setle
        x86enc.buf_emit(buf, 72); x86enc.buf_emit(buf, 15); x86enc.buf_emit(buf, 182); x86enc.buf_emit(buf, 192);
        return 0;
    }
    if op == ">" {
        x86enc.buf_emit(buf, 72); x86enc.buf_emit(buf, 57); x86enc.buf_emit(buf, 216);
        x86enc.buf_emit(buf, 15); x86enc.buf_emit(buf, 159); x86enc.buf_emit(buf, 192); // setg
        x86enc.buf_emit(buf, 72); x86enc.buf_emit(buf, 15); x86enc.buf_emit(buf, 182); x86enc.buf_emit(buf, 192);
        return 0;
    }
    if op == ">=" {
        x86enc.buf_emit(buf, 72); x86enc.buf_emit(buf, 57); x86enc.buf_emit(buf, 216);
        x86enc.buf_emit(buf, 15); x86enc.buf_emit(buf, 157); x86enc.buf_emit(buf, 192); // setge
        x86enc.buf_emit(buf, 72); x86enc.buf_emit(buf, 15); x86enc.buf_emit(buf, 182); x86enc.buf_emit(buf, 192);
        return 0;
    }

    return 0;
}

// Compile a full expression tree (recursive)
// After compile_expr, result is in RAX
fn compile_expr(buf, node) {
    if node == nil { return 0; }
    let ntype = node[0];

    if ntype == "Num" {
        compile_num(buf, node[1]);
        return 0;
    }
    if ntype == "Var" {
        compile_var(buf, node[1]);
        return 0;
    }
    if ntype == "BinOp" {
        compile_expr(buf, node[2]);  // left -> RAX
        x86enc.emit_push_r64(buf, 0); // save left
        compile_expr(buf, node[3]);  // right -> RAX
        compile_binop(buf, node[1]); // compute, result in RAX
        return 0;
    }
    if ntype == "Unary" {
        compile_expr(buf, node[2]);
        if node[1] == "-" {
            // neg rax
            x86enc.buf_emit(buf, 72); x86enc.buf_emit(buf, 247);
            x86enc.buf_emit(buf, 216);
        }
        if node[1] == "!" {
            // test rax, rax; sete al; movzx rax, al
            x86enc.buf_emit(buf, 72); x86enc.buf_emit(buf, 133); x86enc.buf_emit(buf, 192);
            x86enc.buf_emit(buf, 15); x86enc.buf_emit(buf, 148); x86enc.buf_emit(buf, 192);
            x86enc.buf_emit(buf, 72); x86enc.buf_emit(buf, 15); x86enc.buf_emit(buf, 182); x86enc.buf_emit(buf, 192);
        }
        if node[1] == "~" {
            // not rax
            x86enc.buf_emit(buf, 72); x86enc.buf_emit(buf, 247);
            x86enc.buf_emit(buf, 208);
        }
        return 0;
    }

    // Boolean literal: true=1, false=0
    if ntype == "Bool" {
        if node[1] == true {
            x86enc.emit_mov_r64_imm32(buf, 0, 1);
        } else {
            x86enc.emit_mov_r64_imm32(buf, 0, 0);
        }
        return 0;
    }

    // Nil literal: 0
    if ntype == "Nil" {
        x86enc.emit_mov_r64_imm32(buf, 0, 0);
        return 0;
    }

    // String literal: store in data section, load pointer into RAX
    // For now, store string address as immediate (data embedded later)
    if ntype == "Str" {
        // Strings are stored as pointers to null-terminated data
        // For immediate use: allocate string on stack
        let s = node[1];
        let slen = len(s);
        // sub rsp, (slen+8) & ~7 (align to 8)
        let alloc_size = ((slen + 1 + 7) / 8) * 8;
        x86enc.emit_sub_r64_imm8(buf, 4, alloc_size);
        // Store characters on stack
        let ascii = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~";
        let mut si = 0;
        while si < slen {
            let ch = s[si];
            let mut code = 63;  // '?' default
            let mut ai = 0;
            while ai < len(ascii) {
                if ascii[ai] == ch { code = ai + 32; ai = len(ascii); }
                ai = ai + 1;
            }
            // mov byte [rsp+si], code
            x86enc.buf_emit(buf, 198); x86enc.buf_emit(buf, 68);
            x86enc.buf_emit(buf, 36); x86enc.buf_emit(buf, si);
            x86enc.buf_emit(buf, code);
            si = si + 1;
        }
        // Null terminator
        x86enc.buf_emit(buf, 198); x86enc.buf_emit(buf, 68);
        x86enc.buf_emit(buf, 36); x86enc.buf_emit(buf, slen);
        x86enc.buf_emit(buf, 0);
        // lea rax, [rsp]
        x86enc.buf_emit(buf, 72); x86enc.buf_emit(buf, 141);
        x86enc.buf_emit(buf, 4); x86enc.buf_emit(buf, 36);
        return 0;
    }

    // Array literal: allocate on heap, fill elements
    if ntype == "Array" {
        let elems = node[1];
        let count = len(elems);
        // Allocate array: 8 bytes per element + 8 bytes for length header
        let total = (count + 1) * 8;
        x86enc.emit_sub_r64_imm8(buf, 4, total);
        // Store length at [rsp]
        x86enc.emit_mov_r64_imm32(buf, 1, count);  // mov rcx, count
        // mov [rsp], rcx
        x86enc.buf_emit(buf, 72); x86enc.buf_emit(buf, 137);
        x86enc.buf_emit(buf, 12); x86enc.buf_emit(buf, 36);
        // Evaluate and store each element
        let mut ei = 0;
        while ei < count {
            x86enc.emit_push_r64(buf, 4);  // save rsp
            compile_expr(buf, elems[ei]);
            x86enc.emit_pop_r64(buf, 1);   // restore rsp into rcx
            // mov [rcx + 8 + ei*8], rax
            let elem_off = 8 + ei * 8;
            x86enc.buf_emit(buf, 72); x86enc.buf_emit(buf, 137);
            x86enc.buf_emit(buf, 65); x86enc.buf_emit(buf, elem_off);
            ei = ei + 1;
        }
        // lea rax, [rsp] (array pointer)
        x86enc.buf_emit(buf, 72); x86enc.buf_emit(buf, 141);
        x86enc.buf_emit(buf, 4); x86enc.buf_emit(buf, 36);
        return 0;
    }

    // Function call expression
    if ntype == "Call" {
        let func_expr = node[1];
        let call_args = node[2];
        let param_regs_call = [7, 6, 2, 1, 8, 9]; // RDI RSI RDX RCX R8 R9
        // Evaluate arguments
        let mut ci = 0;
        while ci < len(call_args) {
            compile_expr(buf, call_args[ci]);
            x86enc.emit_push_r64(buf, 0);
            ci = ci + 1;
        }
        // Pop args into ABI registers (reverse order)
        ci = len(call_args) - 1;
        while ci >= 0 {
            if ci < 6 {
                x86enc.emit_pop_r64(buf, param_regs_call[ci]);
            } else {
                // leave on stack for stack args
            }
            ci = ci - 1;
        }
        // CALL rel32 (patched by linker)
        x86enc.buf_emit(buf, 232);
        x86enc.buf_emit32(buf, 0);
        return 0;
    }

    return 0;
}

// Compile a statement
fn compile_stmt(buf, node) {
    if node == nil { return 0; }
    let ntype = node[0];

    if ntype == "Let" {
        if node[3] != nil {
            compile_expr(buf, node[3]);
        }
        compile_assign(buf, node[1]);
        return 0;
    }
    if ntype == "Assign" {
        compile_expr(buf, node[2]);
        compile_assign(buf, node[1]);
        return 0;
    }
    if ntype == "Return" {
        if node[1] != nil {
            compile_expr(buf, node[1]);
        }
        emit_epilogue(buf);
        return 0;
    }
    if ntype == "ExprStmt" {
        compile_expr(buf, node[1]);
        return 0;
    }

    // If statement: if (cond) { body } else { else_body }
    if ntype == "If" {
        compile_expr(buf, node[1]);  // condition -> RAX
        // test rax, rax
        x86enc.buf_emit(buf, 72); x86enc.buf_emit(buf, 133);
        x86enc.buf_emit(buf, 192);
        // je else_label (patch later)
        let else_lbl = new_label();
        let end_lbl = new_label();
        x86enc.buf_emit(buf, 15); x86enc.buf_emit(buf, 132); // JE rel32
        let patch_else = x86enc.buf_len(buf);
        x86enc.buf_emit32(buf, 0); // patch target

        // Then branch
        let mut ti = 0;
        while ti < len(node[2]) {
            compile_stmt(buf, node[2][ti]);
            ti = ti + 1;
        }

        if node[3] != nil {
            // JMP end (skip else)
            x86enc.buf_emit(buf, 233); // JMP rel32
            let patch_end = x86enc.buf_len(buf);
            x86enc.buf_emit32(buf, 0);

            // Patch else jump target
            let else_off = x86enc.buf_len(buf) - patch_else - 4;
            // Backpatch: write rel32 at patch_else
            buf[0][patch_else] = else_off % 256;
            buf[0][patch_else + 1] = (else_off / 256) % 256;
            buf[0][patch_else + 2] = (else_off / 65536) % 256;
            buf[0][patch_else + 3] = (else_off / 16777216) % 256;

            // Else branch
            let mut ei = 0;
            while ei < len(node[3]) {
                compile_stmt(buf, node[3][ei]);
                ei = ei + 1;
            }

            // Patch end jump
            let end_off = x86enc.buf_len(buf) - patch_end - 4;
            buf[0][patch_end] = end_off % 256;
            buf[0][patch_end + 1] = (end_off / 256) % 256;
            buf[0][patch_end + 2] = (end_off / 65536) % 256;
            buf[0][patch_end + 3] = (end_off / 16777216) % 256;
        } else {
            // No else: patch else jump to here
            let else_off = x86enc.buf_len(buf) - patch_else - 4;
            buf[0][patch_else] = else_off % 256;
            buf[0][patch_else + 1] = (else_off / 256) % 256;
            buf[0][patch_else + 2] = (else_off / 65536) % 256;
            buf[0][patch_else + 3] = (else_off / 16777216) % 256;
        }
        return 0;
    }

    // While loop: while (cond) { body }
    if ntype == "While" {
        let loop_start = x86enc.buf_len(buf);

        compile_expr(buf, node[1]);  // condition -> RAX
        // test rax, rax; je exit
        x86enc.buf_emit(buf, 72); x86enc.buf_emit(buf, 133); x86enc.buf_emit(buf, 192);
        x86enc.buf_emit(buf, 15); x86enc.buf_emit(buf, 132);
        let patch_exit = x86enc.buf_len(buf);
        x86enc.buf_emit32(buf, 0);

        // Body
        let mut bi = 0;
        while bi < len(node[2]) {
            compile_stmt(buf, node[2][bi]);
            bi = bi + 1;
        }

        // JMP loop_start
        x86enc.buf_emit(buf, 233);
        let back_off = loop_start - x86enc.buf_len(buf) - 4;
        x86enc.buf_emit32(buf, back_off);

        // Patch exit jump
        let exit_off = x86enc.buf_len(buf) - patch_exit - 4;
        buf[0][patch_exit] = exit_off % 256;
        buf[0][patch_exit + 1] = (exit_off / 256) % 256;
        buf[0][patch_exit + 2] = (exit_off / 65536) % 256;
        buf[0][patch_exit + 3] = (exit_off / 16777216) % 256;
        return 0;
    }

    // Function call: result in RAX
    if ntype == "Call" {
        let func_name = node[1];
        let args = node[2];
        let param_regs_call = [7, 6, 2, 1, 8, 9]; // RDI RSI RDX RCX R8 R9

        // Evaluate args and place in ABI registers
        let mut ai = 0;
        while ai < len(args) {
            compile_expr(buf, args[ai]);
            if ai < 6 {
                x86enc.emit_mov_r64_r64(buf, param_regs_call[ai], 0);
            } else {
                x86enc.emit_push_r64(buf, 0); // stack args
            }
            ai = ai + 1;
        }

        // CALL (using symbol table lookup)
        // For now: emit CALL rel32 patch target
        x86enc.buf_emit(buf, 232); // CALL rel32
        x86enc.buf_emit32(buf, 0); // patched by linker
        // Result is in RAX
        return 0;
    }

    // For loop: for var in iterable { body }
    if ntype == "For" {
        let var_name = node[1];
        let iter_expr = node[2];
        let body = node[3];

        // Evaluate iterator -> RAX (pointer to array)
        compile_expr(buf, iter_expr);
        // Save array pointer
        let arr_off = var_alloc("__for_arr__");
        x86enc.emit_sub_r64_imm8(buf, 4, 8);
        x86enc.emit_mov_mem_disp8_r64(buf, 5, arr_off, 0);
        // Initialize counter = 0
        let cnt_off = var_alloc("__for_cnt__");
        x86enc.emit_sub_r64_imm8(buf, 4, 8);
        x86enc.emit_mov_r64_imm32(buf, 0, 0);
        x86enc.emit_mov_mem_disp8_r64(buf, 5, cnt_off, 0);

        // Loop start
        let for_start = x86enc.buf_len(buf);
        // Load counter
        x86enc.emit_mov_r64_mem_disp8(buf, 1, 5, cnt_off); // rcx = counter
        // Load array pointer
        x86enc.emit_mov_r64_mem_disp8(buf, 3, 5, arr_off); // rbx = arr_ptr
        // Load array length: [rbx] (first qword)
        x86enc.buf_emit(buf, 72); x86enc.buf_emit(buf, 139);
        x86enc.buf_emit(buf, 19); // mov rdx, [rbx]
        // cmp rcx, rdx
        x86enc.buf_emit(buf, 72); x86enc.buf_emit(buf, 57);
        x86enc.buf_emit(buf, 209); // cmp rcx, rdx
        // jge exit
        x86enc.buf_emit(buf, 15); x86enc.buf_emit(buf, 141);
        let patch_for_exit = x86enc.buf_len(buf);
        x86enc.buf_emit32(buf, 0);

        // Load element: [rbx + 8 + rcx*8] -> rax
        // lea rax, [rbx + rcx*8 + 8]
        x86enc.buf_emit(buf, 72); x86enc.buf_emit(buf, 139);
        x86enc.buf_emit(buf, 68); x86enc.buf_emit(buf, 203);
        x86enc.buf_emit(buf, 8);

        // Assign to loop variable
        let loop_var_off = var_alloc(var_name);
        x86enc.emit_sub_r64_imm8(buf, 4, 8);
        x86enc.emit_mov_mem_disp8_r64(buf, 5, loop_var_off, 0);

        // Compile body
        let mut fi = 0;
        while fi < len(body) {
            compile_stmt(buf, body[fi]);
            fi = fi + 1;
        }

        // Increment counter
        x86enc.emit_mov_r64_mem_disp8(buf, 1, 5, cnt_off);
        // inc rcx
        x86enc.buf_emit(buf, 72); x86enc.buf_emit(buf, 255);
        x86enc.buf_emit(buf, 193);
        x86enc.emit_mov_mem_disp8_r64(buf, 5, cnt_off, 1);

        // JMP for_start
        x86enc.buf_emit(buf, 233);
        let for_back = for_start - x86enc.buf_len(buf) - 4;
        x86enc.buf_emit32(buf, for_back);

        // Patch exit
        let for_exit_off = x86enc.buf_len(buf) - patch_for_exit - 4;
        buf[0][patch_for_exit] = for_exit_off % 256;
        buf[0][patch_for_exit + 1] = (for_exit_off / 256) % 256;
        buf[0][patch_for_exit + 2] = (for_exit_off / 65536) % 256;
        buf[0][patch_for_exit + 3] = (for_exit_off / 16777216) % 256;
        return 0;
    }

    // Print: evaluate expression, call serial_write
    if ntype == "Print" {
        compile_expr(buf, node[1]);
        // Move result to RDI (first arg)
        x86enc.emit_mov_r64_r64(buf, 7, 0);
        // CALL serial_write (patched by linker)
        x86enc.buf_emit(buf, 232);
        x86enc.buf_emit32(buf, 0);
        return 0;
    }

    // Block: compile each statement
    if ntype == "Block" {
        let stmts = node[1];
        let mut bi = 0;
        while bi < len(stmts) {
            compile_stmt(buf, stmts[bi]);
            bi = bi + 1;
        }
        return 0;
    }

    // FnDef as statement (register only, compile separately)
    if ntype == "FnDef" {
        compile_function(buf, node[1], node[2], node[3]);
        return 0;
    }

    // Quadrant: compile body statements
    if ntype == "Quadrant" {
        let stmts = node[2];
        let mut qi = 0;
        while qi < len(stmts) {
            compile_stmt(buf, stmts[qi]);
            qi = qi + 1;
        }
        return 0;
    }

    return 0;
}

// Compile a function definition
fn compile_function(buf, name, params, body) {
    // Record function address for linking
    let func_addr = x86enc.buf_len(buf);

    // Reset variable table for this function
    var_table = [];
    stack_offset = 0;

    // Allocate params as local vars (passed in RDI, RSI, RDX, RCX, R8, R9)
    let param_regs = [7, 6, 2, 1, 8, 9]; // RDI, RSI, RDX, RCX, R8, R9
    emit_prologue(buf);

    let mut pi = 0;
    while pi < len(params) {
        let off = var_alloc(params[pi]);
        x86enc.emit_sub_r64_imm8(buf, 4, 8);
        if pi < len(param_regs) {
            // mov [rbp+off], param_reg
            x86enc.emit_mov_mem_disp8_r64(buf, 5, off, param_regs[pi]);
        }
        pi = pi + 1;
    }

    // Compile body statements
    let mut si = 0;
    while si < len(body) {
        compile_stmt(buf, body[si]);
        si = si + 1;
    }

    emit_epilogue(buf);

    // Register in ABI symbol table
    let func_size = x86enc.buf_len(buf) - func_addr;
    abi_register_func(name, func_addr, len(params), func_size);
    return 0;
}

// === IR-based compilation pipeline ===
// AST -> IR -> Optimize -> Regalloc -> x86_64

fn compile_expr_to_ir(node) {
    if node == nil { return 0 - 1; }
    let ntype = node[0];

    if ntype == "Num" {
        let t = ir_new_tmp();
        ir_emit(IR_CONST, t, node[1], 0);
        return t;
    }
    if ntype == "Var" {
        let t = ir_new_tmp();
        ir_emit(IR_COPY, t, node[1], 0); // symbolic ref
        return t;
    }
    if ntype == "BinOp" {
        let left = compile_expr_to_ir(node[2]);
        let right = compile_expr_to_ir(node[3]);
        let t = ir_new_tmp();
        let op = node[1];
        if op == "+"  { ir_emit(IR_ADD, t, left, right); }
        if op == "-"  { ir_emit(IR_SUB, t, left, right); }
        if op == "*"  { ir_emit(IR_MUL, t, left, right); }
        if op == "/"  { ir_emit(IR_DIV, t, left, right); }
        if op == "%"  { ir_emit(IR_MOD, t, left, right); }
        if op == "&"  { ir_emit(IR_AND, t, left, right); }
        if op == "|"  { ir_emit(IR_OR, t, left, right); }
        if op == "^"  { ir_emit(IR_XOR, t, left, right); }
        if op == "<<" { ir_emit(IR_SHL, t, left, right); }
        if op == ">>" { ir_emit(IR_SHR, t, left, right); }
        if op == "==" { ir_emit(IR_CMP_EQ, t, left, right); }
        if op == "!=" { ir_emit(IR_CMP_NE, t, left, right); }
        if op == "<"  { ir_emit(IR_CMP_LT, t, left, right); }
        if op == "<=" { ir_emit(IR_CMP_LE, t, left, right); }
        if op == ">"  { ir_emit(IR_CMP_GT, t, left, right); }
        if op == ">=" { ir_emit(IR_CMP_GE, t, left, right); }
        return t;
    }
    if ntype == "Unary" {
        let src = compile_expr_to_ir(node[2]);
        let t = ir_new_tmp();
        if node[1] == "-" { ir_emit(IR_NEG, t, src, 0); }
        if node[1] == "!" { ir_emit(IR_NOT, t, src, 0); }
        if node[1] == "~" {
            // Bitwise NOT via XOR with -1
            let minus1 = ir_new_tmp();
            ir_emit(IR_CONST, minus1, 0 - 1, 0);
            ir_emit(IR_XOR, t, src, minus1);
        }
        return t;
    }

    // String constant -> IR_STR_CONST
    if ntype == "Str" {
        let t = ir_new_tmp();
        ir_emit(IR_STR_CONST, t, node[1], 0);
        return t;
    }

    // Boolean literal
    if ntype == "Bool" {
        let t = ir_new_tmp();
        if node[1] == true {
            ir_emit(IR_CONST, t, 1, 0);
        } else {
            ir_emit(IR_CONST, t, 0, 0);
        }
        return t;
    }

    // Nil literal
    if ntype == "Nil" {
        let t = ir_new_tmp();
        ir_emit(IR_CONST, t, 0, 0);
        return t;
    }

    // Array literal
    if ntype == "Array" {
        let elems = node[1];
        let count = len(elems);
        // Allocate array
        let arr_t = ir_new_tmp();
        ir_emit(IR_ALLOC, arr_t, (count + 1) * 8, 0);
        // Store length
        let len_t = ir_new_tmp();
        ir_emit(IR_CONST, len_t, count, 0);
        ir_emit(IR_STORE, arr_t, len_t, 0);
        // Store elements
        let mut ei = 0;
        while ei < count {
            let elem_t = compile_expr_to_ir(elems[ei]);
            let off_t = ir_new_tmp();
            ir_emit(IR_CONST, off_t, 8 + ei * 8, 0);
            ir_emit(IR_ARRAY_SET, arr_t, off_t, elem_t);
            ei = ei + 1;
        }
        return arr_t;
    }

    // Function call
    if ntype == "Call" {
        let call_args = node[2];
        let mut ai = 0;
        while ai < len(call_args) {
            let arg_t = compile_expr_to_ir(call_args[ai]);
            ir_emit(IR_ARG, ai, arg_t, 0);
            ai = ai + 1;
        }
        let result_t = ir_new_tmp();
        ir_emit(IR_CALL, result_t, node[1], len(call_args));
        return result_t;
    }

    // Index access: arr[idx]
    if ntype == "Index" {
        let obj_t = compile_expr_to_ir(node[1]);
        let idx_t = compile_expr_to_ir(node[2]);
        let result_t = ir_new_tmp();
        ir_emit(IR_ARRAY_GET, result_t, obj_t, idx_t);
        return result_t;
    }

    return 0 - 1;
}

// Compile statement to IR
fn compile_stmt_to_ir(node) {
    if node == nil { return 0; }
    let ntype = node[0];

    if ntype == "Let" {
        if node[3] != nil {
            let val_t = compile_expr_to_ir(node[3]);
            ir_emit(IR_COPY, node[1], val_t, 0);
        }
        return 0;
    }

    if ntype == "Assign" {
        let val_t = compile_expr_to_ir(node[2]);
        ir_emit(IR_COPY, node[1], val_t, 0);
        return 0;
    }

    if ntype == "Return" {
        if node[1] != nil {
            let val_t = compile_expr_to_ir(node[1]);
            ir_emit(IR_RET, val_t, 0, 0);
        } else {
            let zero_t = ir_new_tmp();
            ir_emit(IR_CONST, zero_t, 0, 0);
            ir_emit(IR_RET, zero_t, 0, 0);
        }
        return 0;
    }

    if ntype == "If" {
        let cond_t = compile_expr_to_ir(node[1]);
        let else_lbl = ir_new_tmp();
        let end_lbl = ir_new_tmp();
        ir_emit(IR_JZ, cond_t, else_lbl, 0);
        // Then
        let mut ti = 0;
        while ti < len(node[2]) {
            compile_stmt_to_ir(node[2][ti]);
            ti = ti + 1;
        }
        if node[3] != nil {
            ir_emit(IR_JMP, end_lbl, 0, 0);
            ir_emit(IR_LABEL, else_lbl, 0, 0);
            let mut ei = 0;
            while ei < len(node[3]) {
                compile_stmt_to_ir(node[3][ei]);
                ei = ei + 1;
            }
            ir_emit(IR_LABEL, end_lbl, 0, 0);
        } else {
            ir_emit(IR_LABEL, else_lbl, 0, 0);
        }
        return 0;
    }

    if ntype == "While" {
        let loop_lbl = ir_new_tmp();
        let exit_lbl = ir_new_tmp();
        ir_emit(IR_LABEL, loop_lbl, 0, 0);
        let cond_t = compile_expr_to_ir(node[1]);
        ir_emit(IR_JZ, cond_t, exit_lbl, 0);
        let mut bi = 0;
        while bi < len(node[2]) {
            compile_stmt_to_ir(node[2][bi]);
            bi = bi + 1;
        }
        ir_emit(IR_JMP, loop_lbl, 0, 0);
        ir_emit(IR_LABEL, exit_lbl, 0, 0);
        return 0;
    }

    if ntype == "For" {
        let var_name = node[1];
        let iter_t = compile_expr_to_ir(node[2]);
        let cnt_t = ir_new_tmp();
        ir_emit(IR_CONST, cnt_t, 0, 0);
        let loop_lbl = ir_new_tmp();
        let exit_lbl = ir_new_tmp();
        ir_emit(IR_LABEL, loop_lbl, 0, 0);
        // Load array length
        let len_t = ir_new_tmp();
        ir_emit(IR_LOAD, len_t, iter_t, 0);
        // Compare counter < length
        let cmp_t = ir_new_tmp();
        ir_emit(IR_CMP_LT, cmp_t, cnt_t, len_t);
        ir_emit(IR_JZ, cmp_t, exit_lbl, 0);
        // Load element
        let elem_t = ir_new_tmp();
        ir_emit(IR_ARRAY_GET, elem_t, iter_t, cnt_t);
        ir_emit(IR_COPY, var_name, elem_t, 0);
        // Body
        let mut fi = 0;
        while fi < len(node[3]) {
            compile_stmt_to_ir(node[3][fi]);
            fi = fi + 1;
        }
        // Increment counter
        let one_t = ir_new_tmp();
        ir_emit(IR_CONST, one_t, 1, 0);
        let new_cnt = ir_new_tmp();
        ir_emit(IR_ADD, new_cnt, cnt_t, one_t);
        ir_emit(IR_COPY, cnt_t, new_cnt, 0);
        ir_emit(IR_JMP, loop_lbl, 0, 0);
        ir_emit(IR_LABEL, exit_lbl, 0, 0);
        return 0;
    }

    if ntype == "Print" {
        let val_t = compile_expr_to_ir(node[1]);
        ir_emit(IR_PRINT, val_t, 0, 0);
        return 0;
    }

    if ntype == "ExprStmt" {
        compile_expr_to_ir(node[1]);
        return 0;
    }

    return 0;
}

// Full native compilation: AST -> IR -> optimize -> regalloc -> x86_64
fn compile_native(buf, ast) {
    // Phase 1: Lower AST to IR
    ir_init();
    let mut i = 0;
    while i < len(ast) {
        let node = ast[i];
        if node[0] == "FnDef" {
            // Emit IR_LABEL for function entry
            let lbl = new_label();
            ir_emit(IR_LABEL, lbl, 0, 0);
            // Lower function body
            let mut si = 0;
            while si < len(node[3]) {
                compile_stmt_to_ir(node[3][si]);
                si = si + 1;
            }
        } else {
            // Top-level statement
            compile_stmt_to_ir(node);
        }
        i = i + 1;
    }

    // Phase 2: Optimize IR
    let optimized = ir_optimize();

    // Phase 3: Register allocation
    regalloc_init();
    // Build live intervals from IR
    i = 0;
    while i < ir_count {
        if ir_dead[i] == 0 {
            if ir_op[i] != IR_LABEL {
                if ir_op[i] != IR_JMP {
                    if ir_op[i] != IR_NOP {
                        ra_add_interval(to_string(ir_dst[i]), i, i + 10);
                    }
                }
            }
        }
        i = i + 1;
    }
    let spill_bytes = regalloc_run();

    // Phase 4: Emit x86_64 from optimized IR + regalloc
    i = 0;
    while i < ir_count {
        if ir_dead[i] == 0 {
            // ir_emit_x86(buf, i);
        }
        i = i + 1;
    }

    return optimized;
}

// Self-test
print("codegen.hl loaded -- Native x86_64 backend");
print("Pipeline: AST -> H-IR -> const-fold/DCE/strength-reduce -> regalloc -> x86_64");
print("Supported: Let Assign Return If While For Call Print FnDef Quadrant Block");
print("  Expr: Num Str Bool Nil Var BinOp(18) Unary(3) Array Index Call");
print("ABI: System V AMD64 (RDI,RSI,RDX,RCX,R8,R9), 128 function slots");
