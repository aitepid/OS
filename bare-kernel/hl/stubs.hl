// === VFS stubs ===
fn vfs_read_file(path) {
    // Use actual VFS API: open, read, close
    let fd = vfs_open(path, 0);
    if fd < 0 { return ""; }
    let stat = vfs_stat(path);
    if stat[0] <= 0 { vfs_close(fd); return ""; }
    let mut buf[4096] = {0};
    let n = vfs_read(fd, buf, stat[0]);
    vfs_close(fd);
    if n <= 0 { return ""; }
    // Build string from bytes using str_char_code
    let mut result = "";
    let mut i = 0;
    while i < n {
        let ch = mem_read_u8(buf + i);
        result = result + str_char_code(to_string(ch), 0);
        i = i + 1;
    }
    return result;
}

