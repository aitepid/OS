// app_settings.hl -- 响应式设置中心（Sprint G6）
//
// 布局规则：
//   xs/sm -> 单栏：顶部分类列表，点击进入子页（push 历史）
//   md+   -> 左 Sidebar 分类 + 右内容区
// 分类：Display / Network / Sound / Personalization / Accessibility / About
// 控件示例：Toggle、Slider、ComboBox

let SET_CAT_DISPLAY       = 0;
let SET_CAT_NETWORK       = 1;
let SET_CAT_SOUND         = 2;
let SET_CAT_PERSONALIZE   = 3;
let SET_CAT_ACCESSIBILITY = 4;
let SET_CAT_ABOUT         = 5;
let SET_CAT_COUNT         = 6;

let mut appset_initialized = 0;
let mut appset_win         = 0;
let mut appset_sidebar     = 0;
let mut appset_current_cat = 0;
let mut appset_toggle_eyecare = 0;
let mut appset_toggle_darkmode = 0;
let mut appset_slider_brightness = 0;
let mut appset_combo_resolution = 0;

fn app_settings_init() {
    if appset_initialized == 1 { return 0; }
    appset_current_cat = SET_CAT_DISPLAY;
    appset_initialized = 1;
    print("app_settings: responsive settings center ready");
    return 0;
}

fn app_settings_open() {
    if appset_initialized == 0 { app_settings_init(); }
    let mut sw = vesa_width;  if sw == 0 { sw = 1024; }
    let mut sh = vesa_height; if sh == 0 { sh = 768; }
    let mut w = 760; let mut h = 540;
    let mut bp = al_breakpoint_get();
    if bp <= AL_BP_SM { w = sw; h = sh - shell_topbar_height(); }
    appset_win = widget_new(WIDGET_KIND_GROUPBOX, 0,
                            (sw - w) / 2, (sh - h) / 2, w, h);
    widget_set_label(appset_win, "Settings");
    if bp >= AL_BP_MD {
        appset_sidebar = sidebar_new(appset_win,
            widget_x[appset_win], widget_y[appset_win] + 32,
            200, h - 32, SET_CAT_COUNT);
        widget_set_extra(appset_sidebar, appset_current_cat);
    }
    let mut cx = widget_x[appset_win] + 220;
    if bp <= AL_BP_SM { cx = widget_x[appset_win] + 16; }
    let mut cy = widget_y[appset_win] + 60;
    appset_toggle_darkmode = toggle_new(0, cx + 180, cy, 0);
    cy = cy + 40;
    appset_toggle_eyecare  = toggle_new(0, cx + 180, cy,
        eyecare_enabled);
    cy = cy + 40;
    appset_slider_brightness = slider_new(0, cx, cy, 240, 24, 0, 100, 80);
    cy = cy + 40;
    appset_combo_resolution = combobox_new(0, cx, cy, 240, 32, "1024×768");
    return appset_win;
}

fn appset_cat_label(i) {
    if i == SET_CAT_DISPLAY       { return "Display"; }
    if i == SET_CAT_NETWORK       { return "Network"; }
    if i == SET_CAT_SOUND         { return "Sound"; }
    if i == SET_CAT_PERSONALIZE   { return "Personalize"; }
    if i == SET_CAT_ACCESSIBILITY { return "Accessibility"; }
    return "About";
}

fn appset_paint_content_display() {
    let mut sw = vesa_width;  if sw == 0 { sw = 1024; }
    let mut bp = al_breakpoint_get();
    let mut cx = widget_x[appset_win] + 220;
    if bp <= AL_BP_SM { cx = widget_x[appset_win] + 16; }
    let mut cy = widget_y[appset_win] + 36;
    font_atlas_draw_str(cx, cy, "Display", 17, ui_theme_text_primary());
    cy = cy + 24;
    font_atlas_draw_str(cx, cy + 4, "Dark mode", 15, ui_theme_text_primary());
    toggle_paint(appset_toggle_darkmode);
    cy = cy + 40;
    font_atlas_draw_str(cx, cy + 4, "Eye care", 15, ui_theme_text_primary());
    toggle_paint(appset_toggle_eyecare);
    cy = cy + 40;
    font_atlas_draw_str(cx, cy - 16, "Brightness", 13, ui_theme_text_secondary());
    slider_paint(appset_slider_brightness);
    cy = cy + 40;
    font_atlas_draw_str(cx, cy - 16, "Resolution", 13, ui_theme_text_secondary());
    combobox_paint(appset_combo_resolution);
    return 0;
}

fn appset_paint_content_generic(cat) {
    let mut bp = al_breakpoint_get();
    let mut cx = widget_x[appset_win] + 220;
    if bp <= AL_BP_SM { cx = widget_x[appset_win] + 16; }
    let mut cy = widget_y[appset_win] + 36;
    font_atlas_draw_str(cx, cy, appset_cat_label(cat), 17, ui_theme_text_primary());
    font_atlas_draw_str(cx, cy + 32, "Coming soon — placeholder page.", 13,
                        ui_theme_text_secondary());
    return 0;
}

fn app_settings_paint() {
    if appset_initialized == 0 { return 0; }
    if appset_win == 0 { return 0; }
    groupbox_paint(appset_win);
    if appset_sidebar != 0 { sidebar_paint(appset_sidebar); }
    if appset_current_cat == SET_CAT_DISPLAY { appset_paint_content_display(); }
    else { appset_paint_content_generic(appset_current_cat); }
    return 0;
}

print("app_settings.hl loaded");
