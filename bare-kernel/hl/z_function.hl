// z_function.hl -- Z-Function (Z-Array)
// O(n). zf_z[i] = length of longest common prefix of s and s[i..].
// zf_result = max(zf_z[1..n-1]) for substring repetition detection.
// Runtime buffer: 0x16F0000

let ZF_MAX_N = 32;

let zf_input  = array(32, 0);
let zf_z      = array(32, 0);
let mut zf_n      = 0;
let mut zf_result = 0;

fn zf_init() {
    zf_n      = 0;
    zf_result = 0;
    let mut i = 0;
    while i < 32 { set_at(zf_input, i, 0); set_at(zf_z, i, 0); i += 1; }
    return 0;
}

fn zf_add(c) {
    if zf_n < ZF_MAX_N { set_at(zf_input, zf_n, c); zf_n += 1; }
    return 0;
}

fn zf_run() {
    let mut l = 0;
    let mut r = 0;
    let mut i = 1;
    let mut zi = 0;
    let mut diff = 0;
    let mut zm = 0;
    let mut done = 0;
    set_at(zf_z, 0, zf_n);
    zf_result = 0;
    while i < zf_n {
        zi = 0;
        if i < r {
            diff = r - i;
            zm   = zf_z[i - l];
            if diff < zm { zi = diff; } else { zi = zm; }
        }
        done = 0;
        while done == 0 {
            if i + zi >= zf_n {
                done = 1;
            } else {
                if zf_input[zi] != zf_input[i + zi] {
                    done = 1;
                } else {
                    zi += 1;
                }
            }
        }
        set_at(zf_z, i, zi);
        if i + zi > r { l = i; r = i + zi; }
        if zi > zf_result { zf_result = zi; }
        i += 1;
    }
    return zf_result;
}

fn zf_test() {
    zf_init();
    zf_add(0); zf_add(1); zf_add(2);
    zf_add(0); zf_add(1); zf_add(2);
    let mut res = zf_run();
    print("zf_test: z=[" + to_string(zf_z[0]) + "," + to_string(zf_z[1]) + "," + to_string(zf_z[2]) + "," + to_string(zf_z[3]) + "," + to_string(zf_z[4]) + "," + to_string(zf_z[5]) + "] max=" + to_string(res));
    if res == 3 {
        print("zf_test: PASS");
        return 1;
    }
    print("zf_test: FAIL");
    return 0;
}

print("z_function.hl loaded");
