// mixer.hl -- Audio Mixer (Multi-Stream)
//
// Mixes multiple audio streams into the AC97 output buffer.
// Each stream has volume, pan, mute state.
// Software mixing: sum samples with clamping.
//
// Supports up to 8 simultaneous audio streams.
// Each stream: sample buffer pointer, position, length, volume, loop flag.

let MIXER_MAX_STREAMS = 8;
let MIXER_SAMPLE_RATE = 44100;
let MIXER_BUF_SAMPLES = 4096;
let MIXER_OUTPUT_ADDR = 9830400;  // 0x960000
let MIXER_BEEP_ADDR   = 9896960;  // 0x970000 -- scratch buf for generated tones

let mut mixer_stream_count = 0;
let mut mixer_master_vol = 255;  // 0-255 global master volume

// Stream state (per stream)
let mixer_active = [0, 0, 0, 0, 0, 0, 0, 0];
let mixer_buf_addr = [0, 0, 0, 0, 0, 0, 0, 0];
let mixer_buf_len = [0, 0, 0, 0, 0, 0, 0, 0];
let mixer_position = [0, 0, 0, 0, 0, 0, 0, 0];
let mixer_volume = [255, 255, 255, 255, 255, 255, 255, 255]; // 0-255
let mixer_loop = [0, 0, 0, 0, 0, 0, 0, 0];
let mixer_pan = [128, 128, 128, 128, 128, 128, 128, 128]; // 0=left, 128=center, 255=right

// Clamp value to [lo, hi] range
fn mixer_clamp(v, lo, hi) {
    if v < lo { return lo; }
    if v > hi { return hi; }
    return v;
}

fn mixer_init() {
    mixer_stream_count = 0;
    mixer_master_vol = 255;
    let mut i = 0;
    while i < MIXER_MAX_STREAMS {
        mixer_active[i] = 0;
        mixer_volume[i] = 255;
        mixer_pan[i] = 128;
        i = i + 1;
    }
    return 0;
}

fn mixer_set_master_vol(vol) {
    if vol > 255 { vol = 255; }
    if vol < 0   { vol = 0; }
    mixer_master_vol = vol;
    // Sync to AC97 hardware (convert 0-255 → 0-100)
    ac97_set_volume(vol * 100 / 255);
    return 0;
}

fn mixer_play(buf_addr, buf_len, volume, do_loop) {
    // Find free stream slot
    let mut i = 0;
    while i < MIXER_MAX_STREAMS {
        if mixer_active[i] == 0 {
            mixer_active[i] = 1;
            mixer_buf_addr[i] = buf_addr;
            mixer_buf_len[i] = buf_len;
            mixer_position[i] = 0;
            mixer_volume[i] = volume;
            mixer_loop[i] = do_loop;
            mixer_stream_count = mixer_stream_count + 1;
            return i;
        }
        i = i + 1;
    }
    return 0 - 1; // no free slot
}

fn mixer_stop(stream_id) {
    if stream_id < 0 { return 0; }
    if stream_id >= MIXER_MAX_STREAMS { return 0; }
    mixer_active[stream_id] = 0;
    mixer_stream_count = mixer_stream_count - 1;
    return 0;
}

fn mixer_set_volume(stream_id, vol) {
    if stream_id < 0 { return 0; }
    if stream_id >= MIXER_MAX_STREAMS { return 0; }
    mixer_volume[stream_id] = vol;
    return 0;
}

fn mixer_set_pan(stream_id, pan) {
    if stream_id < 0 { return 0; }
    if stream_id >= MIXER_MAX_STREAMS { return 0; }
    mixer_pan[stream_id] = pan;
    return 0;
}

// Mix all active streams into output buffer
// Called by AC97 DMA interrupt handler
fn mixer_mix(num_samples) {
    // Clear output buffer (stereo: L+R = 2 i16 samples per frame = 4 bytes)
    let mut s = 0;
    while s < num_samples * 2 {
        mem_write_i16(MIXER_OUTPUT_ADDR + s * 2, 0);
        s = s + 1;
    }

    // Mix each active stream into the output buffer
    let mut i = 0;
    while i < MIXER_MAX_STREAMS {
        if mixer_active[i] == 1 {
            let mut si = 0;
            let mut stream_done = 0;
            while si < num_samples {
                if stream_done == 0 {
                    let pos = mixer_position[i] + si;
                    if pos >= mixer_buf_len[i] {
                        if mixer_loop[i] == 1 {
                            // Wrap position (looping stream)
                            mixer_position[i] = 0;
                        } else {
                            // Stream exhausted: deactivate and stop mixing
                            mixer_active[i] = 0;
                            mixer_stream_count = mixer_stream_count - 1;
                            stream_done = 1;
                        }
                    }
                    if stream_done == 0 {
                        let real_pos = mixer_position[i] + si;
                        let sample = mem_read_i16(mixer_buf_addr[i] + real_pos * 2);
                        // Apply per-stream volume (0-255) + master volume
                        let scaled = sample * mixer_volume[i] / 255;
                        let master_scaled = scaled * mixer_master_vol / 255;
                        // Pan: left_vol = (256 - pan), right_vol = pan
                        let left_vol  = 256 - mixer_pan[i];
                        let right_vol = mixer_pan[i];
                        // Mix into output buffer with saturation clamping
                        let out_off = MIXER_OUTPUT_ADDR + si * 4;
                        let cur_l = mem_read_i16(out_off);
                        let cur_r = mem_read_i16(out_off + 2);
                        mem_write_i16(out_off,     mixer_clamp(cur_l + master_scaled * left_vol  / 256, -32768, 32767));
                        mem_write_i16(out_off + 2, mixer_clamp(cur_r + master_scaled * right_vol / 256, -32768, 32767));
                    }
                }
                si = si + 1;
            }
            if stream_done == 0 {
                mixer_position[i] = mixer_position[i] + num_samples;
            }
        }
        i = i + 1;
    }

    // Submit mixed buffer to AC97 DMA for playback
    ac97_play(MIXER_OUTPUT_ADDR, num_samples);
    return 0;
}

// Generate a square-wave tone and play it through the mixer
fn mixer_beep(freq_hz, duration_ms) {
    if freq_hz <= 0 { return 0; }
    let total_samples = MIXER_SAMPLE_RATE * duration_ms / 1000;
    if total_samples <= 0 { return 0; }
    let half_period = MIXER_SAMPLE_RATE / (2 * freq_hz);
    let mut i = 0;
    let mut high = 1;
    let mut count = 0;
    while i < total_samples {
        if count >= half_period { high = 1 - high; count = 0; }
        let sample = 0;
        if high == 1 { sample = 16384; } else { sample = 0 - 16384; }
        // Apply master volume
        let s = sample * mixer_master_vol / 255;
        mem_write_i16(MIXER_BEEP_ADDR + i * 4, s);
        mem_write_i16(MIXER_BEEP_ADDR + i * 4 + 2, s);
        count = count + 1;
        i = i + 1;
    }
    return mixer_play(MIXER_BEEP_ADDR, total_samples, mixer_master_vol, 0);
}

fn mixer_status() {
    let mut active = 0;
    let mut i = 0;
    while i < MIXER_MAX_STREAMS {
        if mixer_active[i] == 1 { active = active + 1; }
        i = i + 1;
    }
    return to_string(active) + "/" + to_string(MIXER_MAX_STREAMS) + " streams active, master=" + to_string(mixer_master_vol);
}

// --- AudioServer-friendly wrappers ---

// Reserve a silent stream slot for a client; returns stream_id or -1
fn mixer_alloc_stream() {
    let mut i = 0;
    while i < MIXER_MAX_STREAMS {
        if mixer_active[i] == 0 {
            mixer_active[i] = 1;
            mixer_buf_addr[i] = 0;
            mixer_buf_len[i] = 0;
            mixer_position[i] = 0;
            mixer_volume[i] = 255;
            mixer_loop[i] = 0;
            mixer_stream_count = mixer_stream_count + 1;
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

fn mixer_stream_play(stream_id) {
    if stream_id < 0 { return 0; }
    if stream_id >= MIXER_MAX_STREAMS { return 0; }
    mixer_active[stream_id] = 1;
    return 0;
}

fn mixer_stream_stop(stream_id) {
    return mixer_stop(stream_id);
}

fn mixer_stream_set_vol(stream_id, vol) {
    return mixer_set_volume(stream_id, vol);
}

print("mixer.hl loaded");
print("Audio mixer: " + to_string(MIXER_MAX_STREAMS) + " streams, master vol, pan, loop, beep, saturation clamp");

