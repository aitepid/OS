        // "format" (6): 102 111 114 109 97 116
        if c0 == 102 { if c1 == 111 { if c2 == 114 { if c3 == 109 { if c4 == 97 { if c5 == 116 {
            _ke_cmd_format(); return 0;
        } } } } } }
    }

    // "reboot" = 114 101 98 111 111 116
    if buf_len == 6 {
        if c0 == 114 { if c1 == 101 {
            mem_write_u64(3211264, 0);
            mem_write_u64(3211272, 0);
            lidt(3211264);
            return 0;
        } }
    }

    // Unknown command: "?\r\n"
    _ke_putc(63); _ke_putc(13); _ke_putc(10);
    return 0;
}

// === Iteration 75: Command History + Arrow Keys ===
//
// Memory layout:
//   0x350000: History ring buffer — 32 entries × 64 bytes = 2048 bytes
//   0x350800: hist_count  (u64) — total commands stored
//   0x350808: hist_browse (u64) — current browse index (while pressing up/down)
//   0x350810: e0_prefix   (u64) — flag: next scancode is extended (0xE0 prefix seen)
//   0x350818: cursor_pos  (u64) — cursor position within current line (for left/right)
//
// Arrow key PS/2 Set 1 scancodes (extended, preceded by 0xE0):
//   Up:    0x48   Down:  0x50
//   Left:  0x4B   Right: 0x4D

let HIST_BASE = 3407872;   // 0x350000
let HIST_MAX = 32;
let HIST_ENTRY_SIZE = 64;
let HIST_COUNT_ADDR = 3409920;   // 0x350800
let HIST_BROWSE_ADDR = 3409928;  // 0x350808
let E0_PREFIX_ADDR = 3409936;    // 0x350810
let CURSOR_POS_ADDR = 3409944;   // 0x350818

// Initialize history system
fn _ke_hist_init() {
    mem_write_u64(HIST_COUNT_ADDR, 0);
    mem_write_u64(HIST_BROWSE_ADDR, 0);
    mem_write_u64(E0_PREFIX_ADDR, 0);
    mem_write_u64(CURSOR_POS_ADDR, 0);
    // Zero-fill history buffer
    let mut i = 0;
    while i < HIST_MAX * HIST_ENTRY_SIZE {
        mem_write_u8(HIST_BASE + i, 0);
        i = i + 1;
    }
    return 0;
}

// Save command to history ring buffer
fn _ke_hist_push(buf_addr, buf_len) {
    if buf_len == 0 { return 0; }
    let count = mem_read_u64(HIST_COUNT_ADDR);
    let slot = count % HIST_MAX;
    let dest = HIST_BASE + slot * HIST_ENTRY_SIZE;
    // Clear slot
    let mut i = 0;
    while i < HIST_ENTRY_SIZE {
        mem_write_u8(dest + i, 0);
        i = i + 1;
    }
    // Copy command bytes (up to HIST_ENTRY_SIZE - 1)
    let copy_len = buf_len;
    if copy_len > HIST_ENTRY_SIZE - 1 { copy_len = HIST_ENTRY_SIZE - 1; }
    i = 0;
    while i < copy_len {
        mem_write_u8(dest + i, mem_read_u8(buf_addr + i));
        i = i + 1;
    }
    mem_write_u64(HIST_COUNT_ADDR, count + 1);
    return 0;
}

// Get length of a history entry
fn _ke_hist_entry_len(slot) {
    let base = HIST_BASE + slot * HIST_ENTRY_SIZE;
    let mut l = 0;
    while l < HIST_ENTRY_SIZE - 1 {
        if mem_read_u8(base + l) == 0 { return l; }
        l = l + 1;
    }
    return l;
}

// Load history entry into command buffer, return its length
fn _ke_hist_load(buf_addr, index) {
    let count = mem_read_u64(HIST_COUNT_ADDR);
    if count == 0 { return 0; }
    // Clamp index
    let max_back = count;
    if max_back > HIST_MAX { max_back = HIST_MAX; }
    if index > max_back { index = max_back; }
    if index < 1 { return 0; }
    // Map: index=1 → most recent, index=max_back → oldest
    let abs_idx = count - index;
    let slot = abs_idx % HIST_MAX;
    let src = HIST_BASE + slot * HIST_ENTRY_SIZE;
    let entry_len = _ke_hist_entry_len(slot);
    // Copy to command buffer
    let mut i = 0;
    while i < entry_len {
        mem_write_u8(buf_addr + i, mem_read_u8(src + i));
        i = i + 1;
    }
    // Null-terminate
    mem_write_u8(buf_addr + entry_len, 0);
    return entry_len;
}

// Erase current line on terminal (backspace over buf_len chars)
fn _ke_line_erase(buf_len) {
    let mut i = 0;
    while i < buf_len {
        _ke_putc(8); _ke_putc(32); _ke_putc(8);
        i = i + 1;
    }
    return 0;
}

// Reprint command buffer to terminal
fn _ke_line_reprint(buf_addr, buf_len) {
    let mut i = 0;
    while i < buf_len {
        _ke_putc(mem_read_u8(buf_addr + i));
        i = i + 1;
    }
    return 0;
}

// Print history listing (called by "history" command dispatch)
fn _ke_cmd_history() {
    let count = mem_read_u64(HIST_COUNT_ADDR);
    if count == 0 {
        // "  (empty)\r\n"
        _ke_putc(32); _ke_putc(32); _ke_putc(40);
        _ke_putc(101); _ke_putc(109); _ke_putc(112);
        _ke_putc(116); _ke_putc(121); _ke_putc(41);
        _ke_putc(13); _ke_putc(10);
        return 0;
    }
    let mut show = count;
    if show > HIST_MAX { show = HIST_MAX; }
    let start = count - show;
    let mut idx = start;
    while idx < count {
        let slot = idx % HIST_MAX;
        let entry_len = _ke_hist_entry_len(slot);
        // Print index number
        _ke_putc(32); _ke_putc(32);
        _ke_put_dec(idx + 1);
        _ke_putc(32); _ke_putc(32);
        // Print entry text
        let src = HIST_BASE + slot * HIST_ENTRY_SIZE;
        let mut c = 0;
        while c < entry_len {
            _ke_putc(mem_read_u8(src + c));
            c = c + 1;
        }
        _ke_putc(13); _ke_putc(10);
        idx = idx + 1;
    }
    return 0;
}

// Interactive shell loop
fn _ke_shell() {
    let cmd_buf = 3211264;     // 0x310000: command buffer (64 bytes)
    let mut buf_len = 0;
    let mut hist_nav = 0;      // 0 = not browsing; 1+ = how many entries back

    _ke_hist_init();
    _ke_prompt();

    while 1 == 1 {
        hlt();

        // Check keyboard flag at 0x300010
        let key_ready = mem_read_u64(3145744);
        if key_ready != 0 {
            mem_write_u64(3145744, 0);       // clear flag
            let sc = mem_read_u64(3145736);  // read scancode

            // Handle E0 prefix for extended scancodes (arrow keys)
            let e0_flag = mem_read_u64(E0_PREFIX_ADDR);
            if sc == 224 {
                // 0xE0 prefix: set flag, wait for next scancode
                mem_write_u64(E0_PREFIX_ADDR, 1);
            } else if e0_flag == 1 {
                // Extended scancode follows 0xE0
                mem_write_u64(E0_PREFIX_ADDR, 0);
                // Ignore key-up events (bit 7 set) for extended keys
                if sc < 128 {
                    if sc == 72 {
                        // Up arrow (0x48): navigate history backward
                        let count = mem_read_u64(HIST_COUNT_ADDR);
                        let max_back = count;
                        if max_back > HIST_MAX { max_back = HIST_MAX; }
                        if hist_nav < max_back {
                            _ke_line_erase(buf_len);
                            hist_nav = hist_nav + 1;
                            buf_len = _ke_hist_load(cmd_buf, hist_nav);
                            _ke_line_reprint(cmd_buf, buf_len);
                        }
                    } else if sc == 80 {
                        // Down arrow (0x50): navigate history forward
                        if hist_nav > 0 {
                            _ke_line_erase(buf_len);
                            hist_nav = hist_nav - 1;
                            if hist_nav == 0 {
                                // Back to empty new line
                                buf_len = 0;
                            } else {
                                buf_len = _ke_hist_load(cmd_buf, hist_nav);
                            }
                            _ke_line_reprint(cmd_buf, buf_len);
                        }
                    } else if sc == 75 {
                        // Left arrow (0x4B): move cursor left
                        let cpos = mem_read_u64(CURSOR_POS_ADDR);
                        if cpos < buf_len {
                            _ke_putc(8);  // backspace (move cursor left)
                            mem_write_u64(CURSOR_POS_ADDR, cpos + 1);
                        }
                    } else if sc == 77 {
                        // Right arrow (0x4D): move cursor right
                        let cpos = mem_read_u64(CURSOR_POS_ADDR);
                        if cpos > 0 {
                            // Re-echo char at cursor position to move right
                            let char_idx = buf_len - cpos;
                            _ke_putc(mem_read_u8(cmd_buf + char_idx));
                            mem_write_u64(CURSOR_POS_ADDR, cpos - 1);
                        }
                    }
                }
            } else {
                // Normal (non-extended) scancode
                // Ignore key-up events (bit 7 set)
                if sc < 128 {
                    let ch = _ke_sc2ascii(sc);
                    if ch == 10 {
                        // Enter: save to history, execute command
                        mem_write_u64(CURSOR_POS_ADDR, 0);
                        _ke_putc(13); _ke_putc(10);
                        if buf_len > 0 {
                            _ke_hist_push(cmd_buf, buf_len);
                        }
                        // Check for "history" command (7 bytes: 104 105 115 116 111 114 121)
                        let mut handled = 0;
                        if buf_len == 7 {
                            if mem_read_u8(cmd_buf) == 104 {
                            if mem_read_u8(cmd_buf + 1) == 105 {
                            if mem_read_u8(cmd_buf + 2) == 115 {
                            if mem_read_u8(cmd_buf + 3) == 116 {
                            if mem_read_u8(cmd_buf + 4) == 111 {
                            if mem_read_u8(cmd_buf + 5) == 114 {
                            if mem_read_u8(cmd_buf + 6) == 121 {
                                _ke_cmd_history();
                                handled = 1;
                            } } } } } } }
                        }
                        if handled == 0 {
                            if buf_len > 0 {
                                // Try pipe execution first
                                let piped = _ke_pipe_exec(cmd_buf, buf_len);
                                if piped == 0 {
                                    _ke_dispatch(cmd_buf, buf_len);
                                }
                            }
                        }
                        buf_len = 0;
                        hist_nav = 0;
                        _ke_prompt();
                    } else if ch == 8 {
                        // Backspace
                        if buf_len > 0 {
                            buf_len = buf_len - 1;
                            _ke_putc(8); _ke_putc(32); _ke_putc(8);
                        }
                    } else if ch > 0 {
                        // Printable char: store and echo
                        if buf_len < 60 {
                            mem_write_u8(cmd_buf + buf_len, ch);
                            buf_len = buf_len + 1;
                            _ke_putc(ch);
                        }
                    }
                }
            }
        }
    }
    return 0;
}

fn _start() {
    // Clear pipe capture state very early.
    // Iteration 79 added _ke_putc capture redirection via 0x371000/0x371008;
    // these locations must be zero before the first serial output or early
    // boot logs may be redirected into the pipe buffer instead of COM1.
    mem_write_u64(3608576, 0);  // 0x371000: PIPE_CAP_FLAG_ADDR
    mem_write_u64(3608584, 0);  // 0x371008: PIPE_CAP_POS_ADDR

    // Phase 1: Serial init (COM1 38400 8N1)
    port_out_u8(1017, 0);    // COM1+1: disable interrupts
    port_out_u8(1019, 128);  // COM1+3: set DLAB
    port_out_u8(1016, 3);    // COM1+0: divisor lo = 3 (38400)
    port_out_u8(1017, 0);    // COM1+1: divisor hi = 0
    port_out_u8(1019, 3);    // COM1+3: 8N1
    port_out_u8(1018, 199);  // COM1+2: enable FIFO
    port_out_u8(1020, 11);   // COM1+4: IRQs + RTS/DSR
    _ke_puts_kb_ok();

    // Phase 2: PIC remap
    _ke_pic_remap();
    _ke_puts_pic_ok();

    // Phase 3: PIT 100Hz
    _ke_pit_init();
    _ke_puts_pit_ok();

    // Phase 4: IDT build + load
    _ke_idt_build();
    _ke_puts_idt_ok();

    // Phase 5: Enable interrupts
    sti();
    _ke_puts_int_ok();

    // Phase 6: Physical page allocator init (iteration 26)
    _ke_pa_init();
    _ke_cmd_pmem();

    // Phase 6b: Heap allocator init (iteration 27)
    _ke_heap_init();

    // Phase 6c: Task scheduler init (iteration 28)
    _ke_task_init();

    // Phase 7: PCI bus scan (iteration 24)
    _ke_pci_scan();

    // Phase 7b: VirtIO-net init (iteration 29)
    let vnet_dev = _ke_virtio_find();
    if vnet_dev != 255 {
        let vbar = _ke_virtio_bar0(vnet_dev);
        _ke_virtio_init(vbar);
    }

    // Phase 7c: VirtIO-blk init (iteration 41)
    let vblk_dev = _ke_virtio_blk_find();
    if vblk_dev != 255 {
        let bbar = _ke_pci_bar0(0, vblk_dev, 0);
        let bbar_io = (bbar / 4) * 4;
        _ke_virtio_blk_init(bbar_io);
    }

    // Phase 7d: Font init (iteration 32)
    _ke_font_init();

    // Phase 7e: SHA-256 constants init (iteration 48)
    _ke_sha256_init_k();

    // Phase 7f: User system init (iteration 67)
    _ke_user_init();

    // Phase 7g: Environment variables init (iteration 73)
    _ke_env_init();

    // Phase 7h: Signal system ready (iteration 74)
    // Signal fields (pending/blocked at task+48/+56) zeroed by _ke_task_init

    // Phase 7i: Command history init (iteration 75)
    // History ring buffer at 0x350000, initialized in _ke_shell via _ke_hist_init

    // Phase 7j: hostname/uname/date native commands (iteration 76)
    // No init needed — commands read RTC/static strings directly

    // Phase 7k: ARP cache init (iteration 77)
    _ke_arp_init();

    // Phase 7l: Shell pipe support (iteration 78) + grep (iteration 79)
    // Pipe capture buffer at 0x370000, initialized on use
    // _ke_putc checks capture flag for proper pipe redirection

    // Phase 8: Interactive shell (iteration 25, enhanced iter 75-79)
    _ke_shell();

    return 0;
}

// === Self-test (runs in H-L interpreter for verification) ===

print("Bootstrapping H-L: Space-locality initiated.");

let key = hilbert_encode(42, 17, 9);
print(key);

fn _ke_fib(n) {
    let mut a = 0;
    let mut b = 1;
    let mut i = 0;
    while i < n {
        let t = a + b;
        a = b;
        b = t;
        i = i + 1;
    }
    return b;
}
print(_ke_fib(10));

fn _ke_gcd(a, b) {
    while b != 0 {
        let t = b;
        b = a % b;
        a = t;
    }
    return a;
}
print(_ke_gcd(48, 18));

fn _ke_power(base, exp) {
    let mut r = 1;
    let mut i = 0;
    while i < exp {
        r = r * base;
        i = i + 1;
    }
    return r;
}
print(_ke_power(2, 10));

let mut sum = 0;
let mut i = 1;
while i <= 100 {
    sum = sum + i;
    i = i + 1;
}
print(sum);

// === Kernel Initialization Sequence ===
// Called by the native kernel after basic hardware setup.
// The interpreter runs these functions as self-test during build.

fn kernel_init() {
    print("=== HicOS Kernel Init ===");

    // Phase 0: Detect boot mode (UEFI vs Legacy BIOS)
    let is_uefi = uefi_is_boot();
    if is_uefi == 1 {
        print("[0] UEFI boot detected");
    } else {
        print("[0] Legacy BIOS boot");
    }

    // Phase 1: Memory detection
    if is_uefi == 1 {
        print("[1] UEFI memory map...");
        uefi_parse_memory_map();
        uefi_init_page_alloc();
    } else {
        print("[1] E820 memory map...");
        e820_dump();
        page_alloc_init_e820();
    }
    print("  Free pages: " + to_string(page_count_free()));

    // Phase 2: Virtual memory -- map all RAM
    print("[2] Virtual memory -- mapping all usable RAM...");
    map_all_ram();

    // Phase 3: Block cache init
    print("[3] Block cache init...");
    bcache_init();

    // Phase 4: Display
    if is_uefi == 1 {
        print("[4] UEFI GOP framebuffer...");
        uefi_init_framebuffer();
    } else {
        print("[4] VESA framebuffer...");
        vesa_auto_init();
        vesa_info();
    }

    // Phase 5: VFS + ramfs
    print("[5] Filesystem init...");
    fs_init();
    vfs_init();

    // Phase 6: Swap
    print("[6] Swap init...");
    swap_init();

    // Phase 7: Task scheduler + POSIX process model
    print("[7] Task scheduler init...");
    task_init();
    fd_init_task(0);  // setup stdin/stdout/stderr for idle task
    print("  Scheduler: CFS min-heap O(log n)");
    print("  Max tasks: " + to_string(MAX_TASKS));

    // Phase 8: Hardware detection (AHCI/USB)
    print("[8] Hardware detection...");
    ahci_init();
    usb_init();

    // Phase 9: Network stack
    print("[9] Network init...");
    net_init();
    dhcp_discover();

    // Phase 10: SMP (multi-core)
    print("[10] SMP init...");
    smp_init();

    // Phase 11: ACPI power management
    print("[11] ACPI power management...");
    power_init();

    // Phase 12: Firmware loader
    print("[12] Firmware loader...");
    firmware_init();

    // Phase 13: Secure Boot verification
    print("[13] Secure Boot...");
    secboot_init();

    // Phase 14: GPT partition detection
    print("[14] Partition table...");
    let gpt_count = gpt_read();
    if gpt_count > 0 {
        print("  GPT: " + to_string(gpt_count) + " partition(s)");
    } else {
        print("  MBR layout (legacy)");
    }

    print("=== Kernel init complete ===");
    if is_uefi == 1 { print("Boot: UEFI"); } else { print("Boot: Legacy BIOS"); }
    print("CPUs: " + to_string(smp_cpu_count()));
    return 0;
}

print("H-L kernel ready. All systems nominal.");

