            // Parse optional size after space
            let mut sz = 64;
            if buf_len > 7 {
                sz = 0;
                let mut di = 7;
                while di < buf_len {
                    let dch = mem_read_u8(buf_addr + di);
                    if dch >= 48 { if dch <= 57 { sz = sz * 10 + dch - 48; } }
                    di = di + 1;
                }
                if sz == 0 { sz = 64; }
            }
            _ke_cmd_malloc(sz); return 0;
        } } } } } }
        // "uptime" (6): 117 112 116 105 109 101
        if c0 == 117 { if c1 == 112 { if c2 == 116 { if c3 == 105 { if c4 == 109 { if c5 == 101 {
            _ke_cmd_uptime(); return 0;
