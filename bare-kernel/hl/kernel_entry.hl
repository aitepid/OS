// Draw one 8x16 character at pixel (px,py) on VESA framebuffer
fn _ke_vesa_draw_char(px, py, ch, fg, bg) {
    if ch < 32 { return 0; }
    if ch > 126 { return 0; }
    let glyph = 3211520 + (ch - 32) * 16;
    let fb = 4244635648;
    let mut row = 0;
    while row < 16 {
        let bits = mem_read_u8(glyph + row);
        let mut col = 0;
        while col < 8 {
            let paddr = fb + (py + row) * 4096 + (px + col) * 4;
            let shift = 7 - col;
            let mut mask = 1;
            let mut si = 0;
            while si < shift { mask = mask * 2; si = si + 1; }
            let mut color = bg;
            if (bits / mask) % 2 == 1 { color = fg; }
            _ke_mem_w32(paddr, color);
            col = col + 1;
        }
        row = row + 1;
    }
    return 0;
}

// Command: gfxtest — draw "HicOS v6.0" on VESA framebuffer
fn _ke_cmd_gfxtest() {
    let fg = 16777215;
    let bg = 64;
    let y = 100;
    let mut x = 100;
    _ke_vesa_draw_char(x, y, 72, fg, bg); x = x + 8;
    _ke_vesa_draw_char(x, y, 105, fg, bg); x = x + 8;
    _ke_vesa_draw_char(x, y, 99, fg, bg); x = x + 8;
    _ke_vesa_draw_char(x, y, 79, fg, bg); x = x + 8;
    _ke_vesa_draw_char(x, y, 83, fg, bg); x = x + 8;
    _ke_vesa_draw_char(x, y, 32, fg, bg); x = x + 8;
    _ke_vesa_draw_char(x, y, 118, fg, bg); x = x + 8;
    _ke_vesa_draw_char(x, y, 54, fg, bg); x = x + 8;
    _ke_vesa_draw_char(x, y, 46, fg, bg); x = x + 8;
    _ke_vesa_draw_char(x, y, 48, fg, bg);
    // "GFX: OK\r\n"
    _ke_putc(71); _ke_putc(70); _ke_putc(88);
    _ke_putc(58); _ke_putc(32); _ke_putc(79); _ke_putc(75);
    _ke_putc(13); _ke_putc(10);
    return 0;
}

// === Iteration 33: Window Manager + Graphical Desktop ===
// Renders a multi-window desktop on VESA framebuffer (0xFD000000)
// Uses font renderer from iteration 32 for title/content text

// Fill rectangle on VESA LFB (1024x768x32, pitch=4096)
fn _ke_vesa_fill_rect(rx, ry, rw, rh, color) {
    let fb = 4244635648;
    let mut dy = 0;
    while dy < rh {
        let row_addr = fb + (ry + dy) * 4096;
        let mut dx = 0;
        while dx < rw {
            _ke_mem_w32(row_addr + (rx + dx) * 4, color);
            dx = dx + 1;
        }
        dy = dy + 1;
    }
    return 0;
}

// Draw triangle mouse cursor (10px tall, white with black edge)
fn _ke_wm_draw_cursor(cx, cy) {
    let fb = 4244635648;
    let mut i = 0;
    while i < 10 {
        let w = i / 2 + 1;
        let mut j = 0;
        while j < w {
            let addr = fb + (cy + i) * 4096 + (cx + j) * 4;
            if j == 0 { _ke_mem_w32(addr, 0); }
            if j > 0 { _ke_mem_w32(addr, 16777215); }
            if j == w - 1 { _ke_mem_w32(addr, 0); }
            j = j + 1;
        }
        i = i + 1;
    }
    return 0;
}

// Command: wm — render graphical desktop with 2 windows + cursor
fn _ke_cmd_wm() {
    let white = 16777215;
    let black = 0;
    let desk = 2113664;
    let tb_act = 3368652;
    let tb_ina = 6710886;

    // Desktop background
    _ke_vesa_fill_rect(0, 0, 1024, 768, desk);

    // Window 1 (active): "HicOS" at (50,50) 400x300
    _ke_vesa_fill_rect(50, 50, 400, 20, tb_act);
    _ke_vesa_fill_rect(50, 70, 400, 280, white);
    _ke_vesa_draw_char(54, 52, 72, white, tb_act);
    _ke_vesa_draw_char(62, 52, 105, white, tb_act);
    _ke_vesa_draw_char(70, 52, 99, white, tb_act);
    _ke_vesa_draw_char(78, 52, 79, white, tb_act);
    _ke_vesa_draw_char(86, 52, 83, white, tb_act);
    // Content: "Welcome"
    let mut tx = 58;
    _ke_vesa_draw_char(tx, 78, 87, black, white); tx = tx + 8;
    _ke_vesa_draw_char(tx, 78, 101, black, white); tx = tx + 8;
    _ke_vesa_draw_char(tx, 78, 108, black, white); tx = tx + 8;
    _ke_vesa_draw_char(tx, 78, 99, black, white); tx = tx + 8;
    _ke_vesa_draw_char(tx, 78, 111, black, white); tx = tx + 8;
    _ke_vesa_draw_char(tx, 78, 109, black, white); tx = tx + 8;
    _ke_vesa_draw_char(tx, 78, 101, black, white);

    // Window 2 (inactive): "Shell" at (300,200) 350x250
    _ke_vesa_fill_rect(300, 200, 350, 20, tb_ina);
    _ke_vesa_fill_rect(300, 220, 350, 230, white);
    _ke_vesa_draw_char(304, 202, 83, white, tb_ina);
    _ke_vesa_draw_char(312, 202, 104, white, tb_ina);
    _ke_vesa_draw_char(320, 202, 101, white, tb_ina);
    _ke_vesa_draw_char(328, 202, 108, white, tb_ina);
    _ke_vesa_draw_char(336, 202, 108, white, tb_ina);
    // Content: "HicOS>"
    tx = 308;
    _ke_vesa_draw_char(tx, 228, 72, black, white); tx = tx + 8;
    _ke_vesa_draw_char(tx, 228, 105, black, white); tx = tx + 8;
    _ke_vesa_draw_char(tx, 228, 99, black, white); tx = tx + 8;
    _ke_vesa_draw_char(tx, 228, 79, black, white); tx = tx + 8;
    _ke_vesa_draw_char(tx, 228, 83, black, white); tx = tx + 8;
    _ke_vesa_draw_char(tx, 228, 62, black, white);

    // Mouse cursor at current position
    let mx = mem_read_u64(3145768);
    let my = mem_read_u64(3145776);
    _ke_wm_draw_cursor(mx, my);

    // "WM: OK\r\n"
    _ke_putc(87); _ke_putc(77); _ke_putc(58); _ke_putc(32);
    _ke_putc(79); _ke_putc(75);
    _ke_putc(13); _ke_putc(10);
    return 0;
}

// === Iteration 34: SMP Multi-core Bootstrap ===
// LAPIC MMIO: 0xFEE00000 (4276092928), AP counter: 0x300040 (3145792)
// Trampoline: 0x8000, GDT: 0x8080, real→PM→LM transition

// Map LAPIC MMIO page via page tables (PD[503] for 0xFEE00000)
fn _ke_smp_map_lapic() {
    let pdpt3 = mem_read_u64(8216);
    let pd_base = pdpt3 - (pdpt3 % 4096);
    mem_write_u64(pd_base + 4024, 4276093075);
    return 0;
}

// LAPIC register read/write
fn _ke_lapic_r(off) {
    return mem_read_u32(4276092928 + off);
}

fn _ke_lapic_w(off, val) {
    _ke_mem_w32(4276092928 + off, val);
    return 0;
}

// Build AP trampoline at 0x8000 (real→PM→LM, signals via 0x300040)
fn _ke_smp_trampoline() {
    let t = 32768;
    let mut i = 0;
    while i < 256 { mem_write_u8(t + i, 0); i = i + 1; }

    // === 16-bit real mode (offset 0x00) ===
    mem_write_u8(t, 250);                            // CLI
    mem_write_u8(t+1, 49); mem_write_u8(t+2, 192);  // XOR AX,AX
    mem_write_u8(t+3, 142); mem_write_u8(t+4, 216); // MOV DS,AX
    // LGDT [0x8070]: 0F 01 16 70 80
    mem_write_u8(t+5, 15); mem_write_u8(t+6, 1); mem_write_u8(t+7, 22);
    mem_write_u8(t+8, 112); mem_write_u8(t+9, 128);
    // MOV EAX,CR0; OR AL,1; MOV CR0,EAX (enable PE)
    mem_write_u8(t+10, 15); mem_write_u8(t+11, 32); mem_write_u8(t+12, 192);
    mem_write_u8(t+13, 12); mem_write_u8(t+14, 1);
    mem_write_u8(t+15, 15); mem_write_u8(t+16, 34); mem_write_u8(t+17, 192);
    // JMP FAR 0x08:0x00008020 (66 EA 20 80 00 00 08 00)
    mem_write_u8(t+18, 102); mem_write_u8(t+19, 234);
    mem_write_u8(t+20, 32); mem_write_u8(t+21, 128);
    mem_write_u8(t+22, 0); mem_write_u8(t+23, 0);
    mem_write_u8(t+24, 8); mem_write_u8(t+25, 0);

    // === 32-bit protected mode (offset 0x20) ===
    // MOV EAX,0x10; MOV DS/ES/SS,AX
    mem_write_u8(t+32, 184); mem_write_u8(t+33, 16);
    mem_write_u8(t+34, 0); mem_write_u8(t+35, 0); mem_write_u8(t+36, 0);
    mem_write_u8(t+37, 142); mem_write_u8(t+38, 216);
    mem_write_u8(t+39, 142); mem_write_u8(t+40, 192);
    mem_write_u8(t+41, 142); mem_write_u8(t+42, 208);
    // MOV EAX,CR4; OR EAX,0x20; MOV CR4,EAX (PAE)
    mem_write_u8(t+43, 15); mem_write_u8(t+44, 32); mem_write_u8(t+45, 224);
    mem_write_u8(t+46, 131); mem_write_u8(t+47, 200); mem_write_u8(t+48, 32);
    mem_write_u8(t+49, 15); mem_write_u8(t+50, 34); mem_write_u8(t+51, 224);
    // MOV EAX,0x1000; MOV CR3,EAX (PML4)
    mem_write_u8(t+52, 184); mem_write_u8(t+53, 0); mem_write_u8(t+54, 16);
    mem_write_u8(t+55, 0); mem_write_u8(t+56, 0);
    mem_write_u8(t+57, 15); mem_write_u8(t+58, 34); mem_write_u8(t+59, 216);
    // MOV ECX,0xC0000080; RDMSR; OR EAX,0x100; WRMSR (LME)
    mem_write_u8(t+60, 185); mem_write_u8(t+61, 128); mem_write_u8(t+62, 0);
    mem_write_u8(t+63, 0); mem_write_u8(t+64, 192);
    mem_write_u8(t+65, 15); mem_write_u8(t+66, 50);
    mem_write_u8(t+67, 13); mem_write_u8(t+68, 0); mem_write_u8(t+69, 1);
    mem_write_u8(t+70, 0); mem_write_u8(t+71, 0);
    mem_write_u8(t+72, 15); mem_write_u8(t+73, 48);
    // MOV EAX,CR0; OR EAX,0x80000000; MOV CR0,EAX (PG)
    mem_write_u8(t+74, 15); mem_write_u8(t+75, 32); mem_write_u8(t+76, 192);
    mem_write_u8(t+77, 13); mem_write_u8(t+78, 0); mem_write_u8(t+79, 0);
    mem_write_u8(t+80, 0); mem_write_u8(t+81, 128);
    mem_write_u8(t+82, 15); mem_write_u8(t+83, 34); mem_write_u8(t+84, 192);
    // JMP FAR 0x18:0x00008060 (EA 60 80 00 00 18 00)
    mem_write_u8(t+85, 234); mem_write_u8(t+86, 96); mem_write_u8(t+87, 128);
    mem_write_u8(t+88, 0); mem_write_u8(t+89, 0);
    mem_write_u8(t+90, 24); mem_write_u8(t+91, 0);

    // === 64-bit long mode (offset 0x60) ===
    // INC QWORD [0x300040]: 48 FF 04 25 40 00 30 00
    mem_write_u8(t+96, 72); mem_write_u8(t+97, 255);
    mem_write_u8(t+98, 4); mem_write_u8(t+99, 37);
    mem_write_u8(t+100, 64); mem_write_u8(t+101, 0);
    mem_write_u8(t+102, 48); mem_write_u8(t+103, 0);
    // HLT; JMP -3
    mem_write_u8(t+104, 244);
    mem_write_u8(t+105, 235); mem_write_u8(t+106, 253);

    // === GDT descriptor at offset 0x70 ===
    mem_write_u8(t+112, 31); mem_write_u8(t+113, 0);
    mem_write_u8(t+114, 128); mem_write_u8(t+115, 128);
    mem_write_u8(t+116, 0); mem_write_u8(t+117, 0);

    // === GDT entries at offset 0x80 (null/code32/data32/code64) ===
    // Entry 1 (0x08) code32: FF FF 00 00 00 9A CF 00
    mem_write_u8(t+136, 255); mem_write_u8(t+137, 255);
    mem_write_u8(t+140, 0); mem_write_u8(t+141, 154);
    mem_write_u8(t+142, 207); mem_write_u8(t+143, 0);
    // Entry 2 (0x10) data32: FF FF 00 00 00 92 CF 00
    mem_write_u8(t+144, 255); mem_write_u8(t+145, 255);
    mem_write_u8(t+148, 0); mem_write_u8(t+149, 146);
    mem_write_u8(t+150, 207); mem_write_u8(t+151, 0);
    // Entry 3 (0x18) code64: 00 00 00 00 00 9A 20 00
    mem_write_u8(t+157, 154); mem_write_u8(t+158, 32);
    return 0;
}

// Boot APs via INIT-SIPI-SIPI (all-excluding-self broadcast)
fn _ke_smp_boot() {
    _ke_smp_map_lapic();
    _ke_smp_trampoline();
    mem_write_u64(3145792, 0);
    // INIT IPI (all excl self): 0xC4500 = 804096
    _ke_lapic_w(768, 804096);
    let mut d = 0;
    while d < 100000 { d = d + 1; }
    // SIPI #1 (all excl self, vector 8): 0xC4608 = 804360
    _ke_lapic_w(768, 804360);
    d = 0;
    while d < 2000 { d = d + 1; }
    // SIPI #2
    _ke_lapic_w(768, 804360);
    d = 0;
    while d < 200000 { d = d + 1; }
    return mem_read_u64(3145792);
}

// Command: smp — detect BSP APIC ID, boot APs, show CPU count
fn _ke_cmd_smp() {
    _ke_smp_map_lapic();
    let apic_raw = _ke_lapic_r(32);
    let apic_id = apic_raw / 16777216;
    // "BSP ID: N\r\n"
    _ke_putc(66); _ke_putc(83); _ke_putc(80); _ke_putc(32);
    _ke_putc(73); _ke_putc(68); _ke_putc(58); _ke_putc(32);
    _ke_put_dec(apic_id);
    _ke_putc(13); _ke_putc(10);
    let ap_count = _ke_smp_boot();
    let total = 1 + ap_count;
    // "CPUs: N online\r\n"
    _ke_putc(67); _ke_putc(80); _ke_putc(85); _ke_putc(115);
    _ke_putc(58); _ke_putc(32);
    _ke_put_dec(total);
    _ke_putc(32);
    _ke_putc(111); _ke_putc(110); _ke_putc(108); _ke_putc(105);
    _ke_putc(110); _ke_putc(101);
    _ke_putc(13); _ke_putc(10);
    return 0;
}

// === Iteration 35: AHCI/SATA Disk Controller Detection ===
// AHCI class=0x01 subclass=0x06 on PCI
// ABAR (BAR5) = HBA MMIO base, mapped via page tables
// HBA registers: +0=CAP, +0xC=PI, +0x10=VS
// Port regs: ABAR+0x100+port*0x80, +0x28=SSTS (DET in bits 3:0)

// Read PCI BAR5 for a device (ABAR)
fn _ke_pci_bar5(bus, dev, func) {
    return _ke_pci_read32(bus, dev, func, 36);
}

// Map AHCI ABAR MMIO page in page tables (2MB page via PD entry)
fn _ke_ahci_map(abar) {
    let pdpt3 = mem_read_u64(8216);
    let pd_base = pdpt3 - (pdpt3 % 4096);
    // PD index = (abar within 3rd GB) >> 21
    let offset_3g = abar - 3221225472;
    let pd_idx = offset_3g / 2097152;
    // Entry: 2MB-aligned base | P|RW|PS|PCD (0x93 = 147)
    let base_2m = (abar / 2097152) * 2097152;
    mem_write_u64(pd_base + pd_idx * 8, base_2m + 147);
    return 0;
}

// Read AHCI HBA register (32-bit MMIO)
fn _ke_ahci_r(abar, off) {
    return mem_read_u32(abar + off);
}

// Read AHCI port register
fn _ke_ahci_pr(abar, port, off) {
    return mem_read_u32(abar + 256 + port * 128 + off);
}

// Command: ahci — detect AHCI controller, show ports and devices
fn _ke_cmd_ahci() {
    // Scan PCI for class=0x01, subclass=0x06
    let mut ahci_dev = 255;
    let mut ahci_vendor = 0;
    let mut ahci_devid = 0;
    let mut d = 0;
    while d < 32 {
        let v = _ke_pci_vendor(0, d, 0);
        if v != 65535 {
            let cls = _ke_pci_class(0, d, 0);
            let sub = _ke_pci_subclass(0, d, 0);
            if cls == 1 {
                if sub == 6 {
                    ahci_dev = d;
                    ahci_vendor = v;
                    ahci_devid = _ke_pci_device(0, d, 0);
                }
            }
        }
        d = d + 1;
    }

    if ahci_dev == 255 {
        // "AHCI: none\r\n"
        _ke_putc(65); _ke_putc(72); _ke_putc(67); _ke_putc(73);
        _ke_putc(58); _ke_putc(32); _ke_putc(110); _ke_putc(111);
        _ke_putc(110); _ke_putc(101);
        _ke_putc(13); _ke_putc(10);
        return 0;
    }

    // Read BAR5 (ABAR)
    let bar5 = _ke_pci_bar5(0, ahci_dev, 0);
    let abar = (bar5 / 16) * 16;

    // Map ABAR MMIO
    _ke_ahci_map(abar);

    // Read HBA registers
    let cap = _ke_ahci_r(abar, 0);
    let pi = _ke_ahci_r(abar, 12);
    let vs = _ke_ahci_r(abar, 16);
    let nports = (cap % 32) + 1;

    // "AHCI: VVVV:DDDD\r\n"
    _ke_putc(65); _ke_putc(72); _ke_putc(67); _ke_putc(73);
    _ke_putc(58); _ke_putc(32);
    _ke_put_hex16(ahci_vendor); _ke_putc(58); _ke_put_hex16(ahci_devid);
    _ke_putc(13); _ke_putc(10);

    // "ABAR: " + hex
    _ke_putc(65); _ke_putc(66); _ke_putc(65); _ke_putc(82);
    _ke_putc(58); _ke_putc(32);
    _ke_put_hex16(abar / 65536); _ke_put_hex16(abar);
    _ke_putc(13); _ke_putc(10);

    // "Ver: M.m  Ports: N\r\n"
    _ke_putc(86); _ke_putc(101); _ke_putc(114); _ke_putc(58); _ke_putc(32);
    _ke_put_dec((vs / 65536) % 65536);
    _ke_putc(46);
    _ke_put_dec(vs % 65536);
    _ke_putc(32); _ke_putc(32);
    _ke_putc(80); _ke_putc(58); _ke_put_dec(nports);
    _ke_putc(13); _ke_putc(10);

    // Check each port for connected device
    let mut p = 0;
    while p < 32 {
        // Check PI bit
        let mut pi_mask = 1;
        let mut s = 0;
        while s < p { pi_mask = pi_mask * 2; s = s + 1; }
        if (pi / pi_mask) % 2 == 1 {
            let ssts = _ke_ahci_pr(abar, p, 40);
            let det = ssts % 16;
            let sig = _ke_ahci_pr(abar, p, 36);
            // "  Pn: DET=d SIG=XXXX\r\n"
            _ke_putc(32); _ke_putc(32);
            _ke_putc(80); _ke_put_dec(p); _ke_putc(58); _ke_putc(32);
            _ke_putc(68); _ke_putc(61); _ke_put_dec(det); _ke_putc(32);
            _ke_putc(83); _ke_putc(73); _ke_putc(71); _ke_putc(61);
            _ke_put_hex16(sig / 65536); _ke_put_hex16(sig);
            _ke_putc(13); _ke_putc(10);
        }
        p = p + 1;
    }
    return 0;
}

// === Iteration 36: USB xHCI Controller Detection ===
// xHCI: PCI class=0x0C subclass=0x03 prog_if=0x30
// BAR0 = MMIO base, capability regs at BAR0, operational at BAR0+CAPLENGTH
// HCSPARAMS1: MaxSlots[7:0], MaxPorts[31:24]
// Port status: op_base + 0x400 + port*0x10, CCS=bit0, speed=bits[13:10]

// Read PCI prog_if (bits 15:8 of register 0x08)
fn _ke_pci_progif(bus, dev, func) {
    let reg = _ke_pci_read32(bus, dev, func, 8);
    return (reg / 256) % 256;
}

// Read PCI BAR0
fn _ke_pci_bar0(bus, dev, func) {
    return _ke_pci_read32(bus, dev, func, 16);
}

// Map an arbitrary MMIO address via page tables (reuse AHCI pattern)
fn _ke_mmio_map(addr) {
    if addr < 3221225472 { return 0; }
    let pdpt3 = mem_read_u64(8216);
    let pd_base = pdpt3 - (pdpt3 % 4096);
    let offset_3g = addr - 3221225472;
    let pd_idx = offset_3g / 2097152;
    let base_2m = (addr / 2097152) * 2097152;
    mem_write_u64(pd_base + pd_idx * 8, base_2m + 147);
    return 0;
}

// Command: usb — detect xHCI controller, show ports and devices
fn _ke_cmd_usb() {
    // Scan PCI for class=0x0C, subclass=0x03, prog_if=0x30
    let mut usb_dev = 255;
    let mut usb_vendor = 0;
    let mut usb_devid = 0;
    let mut d = 0;
    while d < 32 {
        let v = _ke_pci_vendor(0, d, 0);
        if v != 65535 {
            let cls = _ke_pci_class(0, d, 0);
            let sub = _ke_pci_subclass(0, d, 0);
            let pif = _ke_pci_progif(0, d, 0);
            if cls == 12 {
                if sub == 3 {
                    if pif == 48 {
                        usb_dev = d;
                        usb_vendor = v;
                        usb_devid = _ke_pci_device(0, d, 0);
                    }
                }
            }
        }
        d = d + 1;
    }

    if usb_dev == 255 {
        // "USB: none\r\n"
        _ke_putc(85); _ke_putc(83); _ke_putc(66);
        _ke_putc(58); _ke_putc(32); _ke_putc(110); _ke_putc(111);
        _ke_putc(110); _ke_putc(101);
        _ke_putc(13); _ke_putc(10);
        return 0;
    }

    // Read BAR0
    let bar0 = _ke_pci_bar0(0, usb_dev, 0);
    let xbar = (bar0 / 16) * 16;

    // Map xHCI MMIO
    _ke_mmio_map(xbar);

    // Read capability registers
    let cap0 = mem_read_u32(xbar);
    let caplen = cap0 % 256;
    let hciver = (cap0 / 65536) % 65536;
    let hcsp1 = mem_read_u32(xbar + 4);
    let max_slots = hcsp1 % 256;
    let max_ports = (hcsp1 / 16777216) % 256;

    // "xHCI: VVVV:DDDD\r\n"
    _ke_putc(120); _ke_putc(72); _ke_putc(67); _ke_putc(73);
    _ke_putc(58); _ke_putc(32);
    _ke_put_hex16(usb_vendor); _ke_putc(58); _ke_put_hex16(usb_devid);
    _ke_putc(13); _ke_putc(10);

    // "BAR0: XXXXXXXX\r\n"
    _ke_putc(66); _ke_putc(65); _ke_putc(82); _ke_putc(48);
    _ke_putc(58); _ke_putc(32);
    _ke_put_hex16(xbar / 65536); _ke_put_hex16(xbar);
    _ke_putc(13); _ke_putc(10);

    // "Ver: X.X  Slots: N  Ports: N\r\n"
    _ke_putc(86); _ke_putc(58);
    _ke_put_dec((hciver / 256) % 256);
    _ke_putc(46);
    _ke_put_dec(hciver % 256);
    _ke_putc(32); _ke_putc(83); _ke_putc(58); _ke_put_dec(max_slots);
    _ke_putc(32); _ke_putc(80); _ke_putc(58); _ke_put_dec(max_ports);
    _ke_putc(13); _ke_putc(10);

    // Scan ports: op_base + 0x400 + port*0x10
    let op = xbar + caplen;
    let mut p = 0;
    while p < max_ports {
        let portsc = mem_read_u32(op + 1024 + p * 16);
        let ccs = portsc % 2;
        let speed = (portsc / 1024) % 16;
        // "  Pn: " + status
        _ke_putc(32); _ke_putc(32); _ke_putc(80);
        _ke_put_dec(p); _ke_putc(58); _ke_putc(32);
        if ccs == 1 {
            // "DEV spd=N\r\n"
            _ke_putc(68); _ke_putc(69); _ke_putc(86);
            _ke_putc(32); _ke_putc(115); _ke_putc(61);
            _ke_put_dec(speed);
        }
        if ccs == 0 {
            // "---"
            _ke_putc(45); _ke_putc(45); _ke_putc(45);
        }
        _ke_putc(13); _ke_putc(10);
        p = p + 1;
    }
    return 0;
}

// === Iteration 37: ACPI Power Management ===
// RSDP: "RSD PTR " signature at EBDA or 0xE0000-0xFFFFF (16-byte aligned)
// RSDT: array of 32-bit pointers to ACPI tables
// FADT: signature "FACP", PM1a_CNT_BLK at offset +64

// Search for RSDP signature ("RSD PTR " = 0x2052545020445352)
// Returns RSDP physical address, or 0 if not found
fn _ke_acpi_find_rsdp() {
    // Scan 0xE0000 - 0xFFFFF (128 KB) at 16-byte boundaries
    let mut addr = 917504;
    while addr < 1048576 {
        let lo = mem_read_u64(addr);
        // "RSD PTR " in little-endian: 0x2052545020445352
        // = 32+82*256+... too complex, check bytes instead
        let b0 = mem_read_u8(addr);
        let b1 = mem_read_u8(addr + 1);
        let b2 = mem_read_u8(addr + 2);
        let b3 = mem_read_u8(addr + 3);
        let b4 = mem_read_u8(addr + 4);
        let b5 = mem_read_u8(addr + 5);
        let b6 = mem_read_u8(addr + 6);
        let b7 = mem_read_u8(addr + 7);
        // 'R'=82 'S'=83 'D'=68 ' '=32 'P'=80 'T'=84 'R'=82 ' '=32
        if b0 == 82 { if b1 == 83 { if b2 == 68 { if b3 == 32 {
            if b4 == 80 { if b5 == 84 { if b6 == 82 { if b7 == 32 {
                return addr;
            } } } }
        } } } }
        addr = addr + 16;
    }
    return 0;
}

// Read RSDT address from RSDP (offset +16, 32-bit)
fn _ke_acpi_rsdt(rsdp) {
    return mem_read_u32(rsdp + 16);
}

// Search RSDT for a table with given 4-byte signature
// sig0..sig3 are ASCII bytes of the signature
fn _ke_acpi_find_table(rsdt, sig0, sig1, sig2, sig3) {
    if rsdt == 0 { return 0; }
    let rsdt_len = mem_read_u32(rsdt + 4);
    let entries = (rsdt_len - 36) / 4;
    let mut i = 0;
    while i < entries {
        let tbl = mem_read_u32(rsdt + 36 + i * 4);
        if tbl != 0 {
            let t0 = mem_read_u8(tbl);
            let t1 = mem_read_u8(tbl + 1);
            let t2 = mem_read_u8(tbl + 2);
            let t3 = mem_read_u8(tbl + 3);
            if t0 == sig0 { if t1 == sig1 { if t2 == sig2 { if t3 == sig3 {
                return tbl;
            } } } }
        }
        i = i + 1;
    }
    return 0;
}

// Command: acpi — find RSDP, parse RSDT, show FADT info, offer shutdown
fn _ke_cmd_acpi() {
    let rsdp = _ke_acpi_find_rsdp();
    if rsdp == 0 {
        // "ACPI: none\r\n"
        _ke_putc(65); _ke_putc(67); _ke_putc(80); _ke_putc(73);
        _ke_putc(58); _ke_putc(32); _ke_putc(110); _ke_putc(111);
        _ke_putc(110); _ke_putc(101);
        _ke_putc(13); _ke_putc(10);
        return 0;
    }

    // "RSDP: XXXXXXXX\r\n"
    _ke_putc(82); _ke_putc(83); _ke_putc(68); _ke_putc(80);
    _ke_putc(58); _ke_putc(32);
    _ke_put_hex16(rsdp / 65536); _ke_put_hex16(rsdp);
    _ke_putc(13); _ke_putc(10);

    let rsdt = _ke_acpi_rsdt(rsdp);
    // "RSDT: XXXXXXXX\r\n"
    _ke_putc(82); _ke_putc(83); _ke_putc(68); _ke_putc(84);
    _ke_putc(58); _ke_putc(32);
    _ke_put_hex16(rsdt / 65536); _ke_put_hex16(rsdt);
    _ke_putc(13); _ke_putc(10);

    // Count RSDT entries
    let rsdt_len = mem_read_u32(rsdt + 4);
    let entries = (rsdt_len - 36) / 4;
    // "Tables: N\r\n"
    _ke_putc(84); _ke_putc(58); _ke_put_dec(entries);
    _ke_putc(13); _ke_putc(10);

    // Print each table's 4-byte signature
    let mut i = 0;
    while i < entries {
        let tbl = mem_read_u32(rsdt + 36 + i * 4);
        if tbl != 0 {
            _ke_putc(32); _ke_putc(32);
            _ke_putc(mem_read_u8(tbl));
            _ke_putc(mem_read_u8(tbl + 1));
            _ke_putc(mem_read_u8(tbl + 2));
            _ke_putc(mem_read_u8(tbl + 3));
            _ke_putc(32);
            _ke_put_hex16(tbl / 65536); _ke_put_hex16(tbl);
            _ke_putc(13); _ke_putc(10);
        }
        i = i + 1;
    }

    // Find FADT ("FACP" = 70,65,67,80)
    let fadt = _ke_acpi_find_table(rsdt, 70, 65, 67, 80);
    if fadt != 0 {
        let pm1a = mem_read_u32(fadt + 64);
        let fadt_rev = mem_read_u8(fadt + 8);
        // "FADT: rev=R PM1a=XXXX\r\n"
        _ke_putc(70); _ke_putc(65); _ke_putc(68); _ke_putc(84);
        _ke_putc(58); _ke_putc(32);
        _ke_putc(114); _ke_putc(61); _ke_put_dec(fadt_rev);
        _ke_putc(32);
        _ke_putc(80); _ke_putc(77); _ke_putc(49); _ke_putc(97); _ke_putc(61);
        _ke_put_hex16(pm1a);
        _ke_putc(13); _ke_putc(10);

        // Perform ACPI S5 shutdown: PM1a_CNT = SLP_TYP(5)<<10 | SLP_EN(bit13)
        // value = 5*1024 + 8192 = 5120 + 8192 = 13312
        port_out_u16(pm1a, 13312);
    }

    // "ACPI: OK\r\n"
    _ke_putc(65); _ke_putc(67); _ke_putc(80); _ke_putc(73);
    _ke_putc(58); _ke_putc(32); _ke_putc(79); _ke_putc(75);
    _ke_putc(13); _ke_putc(10);
    return 0;
}

// === Iteration 38: AC97 Audio (beep command) ===

// Write 32 bits to PCI config space
fn _ke_pci_write32(bus, dev, func, offset, val) {
    let addr = 2147483648 + bus * 65536 + dev * 2048 + func * 256 + (offset / 4) * 4;
    port_out_u32(3320, addr);
    port_out_u32(3324, val);
    return 0;
}

// Read 16-bit from PCI config
fn _ke_pci_read16(bus, dev, func, offset) {
    let dword = _ke_pci_read32(bus, dev, func, offset);
    if offset % 4 == 0 { return dword % 65536; }
    return (dword / 65536) % 65536;
}

// Write 16-bit to PCI config
fn _ke_pci_write16(bus, dev, func, offset, val) {
    let old = _ke_pci_read32(bus, dev, func, offset);
    let mut new_val = 0;
    if offset % 4 == 0 {
        new_val = (old / 65536) * 65536 + (val % 65536);
    } else {
        new_val = (val % 65536) * 65536 + (old % 65536);
    }
    _ke_pci_write32(bus, dev, func, offset, new_val);
    return 0;
}

// Write 16-bit little-endian value
fn _ke_mem_w16(addr, val) {
    mem_write_u8(addr, val % 256);
    mem_write_u8(addr + 1, (val / 256) % 256);
    return 0;
}

// Scan PCI bus 0 for AC97: vendor=0x8086(32902) device=0x2415(9237)
fn _ke_ac97_find() {
    let mut dev = 0;
    while dev < 32 {
        let vendor = _ke_pci_vendor(0, dev, 0);
        if vendor == 32902 {
            let devid = _ke_pci_device(0, dev, 0);
            if devid == 9237 { return dev; }
        }
        dev = dev + 1;
    }
    return 255;
}

// Command: beep — AC97 440Hz tone playback
fn _ke_cmd_beep() {
    let ac97_dev = _ke_ac97_find();
    if ac97_dev == 255 {
        // "AC97: none\r\n"
        _ke_putc(65); _ke_putc(67); _ke_putc(57); _ke_putc(55);
        _ke_putc(58); _ke_putc(32); _ke_putc(110); _ke_putc(111);
        _ke_putc(110); _ke_putc(101);
        _ke_putc(13); _ke_putc(10);
        return 0;
    }

    // Read BAR0 (mixer I/O) and BAR1 (NABM I/O)
    let bar0_raw = _ke_pci_read32(0, ac97_dev, 0, 16);
    let bar1_raw = _ke_pci_read32(0, ac97_dev, 0, 20);
    let mixer = (bar0_raw / 4) * 4;
    let nabm = (bar1_raw / 4) * 4;

    // Enable PCI bus mastering + I/O space (bits 0+2 of command register)
    let cmd = _ke_pci_read16(0, ac97_dev, 0, 4);
    _ke_pci_write16(0, ac97_dev, 0, 4, cmd + 5);

    // Reset mixer
    port_out_u16(mixer, 1);

    // Global control: cold reset
    port_out_u32(nabm + 44, 2);

    // Wait for codec reset
    let mut wait = 0;
    while wait < 100000 { wait = wait + 1; }

    // Master volume = 0 (max), PCM volume = 0x0808
    port_out_u16(mixer + 2, 0);
    port_out_u16(mixer + 24, 2056);

    // Generate 440Hz square wave: 48000 Hz sample rate, 0.5 sec
    // samples = 24000, half_period = 48000/(2*440) = 54
    let buf = 8978688;    // 0x890100: PCM buffer
    let bdl = 8978432;    // 0x890000: BDL
    let samples = 24000;
    let half = 54;
    let mut i = 0;
    let mut high = 1;
    let mut cnt = 0;
    while i < samples {
        if cnt >= half { high = 1 - high; cnt = 0; }
        if high == 1 {
            _ke_mem_w16(buf + i * 4, 16384);
            _ke_mem_w16(buf + i * 4 + 2, 16384);
        } else {
            _ke_mem_w16(buf + i * 4, 49152);
            _ke_mem_w16(buf + i * 4 + 2, 49152);
        }
        cnt = cnt + 1;
        i = i + 1;
    }

    // BDL entry 0: [buffer_addr(4), sample_count(2), flags(2)]
    _ke_mem_w32(bdl, buf);
    _ke_mem_w16(bdl + 4, samples);
    _ke_mem_w16(bdl + 6, 49152);    // 0xC000: last + IOC

    // Set BDL base address
    port_out_u32(nabm + 16, bdl);
    // Set last valid index
    port_out_u8(nabm + 21, 0);
    // Start playback
    port_out_u8(nabm + 27, 1);

    // "Beep 440Hz\r\n"
    _ke_putc(66); _ke_putc(101); _ke_putc(101); _ke_putc(112);
    _ke_putc(32); _ke_putc(52); _ke_putc(52); _ke_putc(48);
    _ke_putc(72); _ke_putc(122);
    _ke_putc(13); _ke_putc(10);
    return 0;
}

// === Iteration 39: RTC Time (time command) ===

// Read CMOS register (port 0x70 addr, 0x71 data)
fn _ke_rtc_read(reg) {
    port_out_u8(112, reg);
    return port_in_u8(113);
}

// BCD to binary
fn _ke_bcd2bin(bcd) {
    return (bcd / 16) * 10 + bcd % 16;
}

// Print 2-digit decimal with leading zero
fn _ke_put_dec2(val) {
    if val < 10 { _ke_putc(48); }
    _ke_put_dec(val);
    return 0;
}

// Command: time — read and display CMOS RTC date/time
fn _ke_cmd_time() {
    // Wait for update-in-progress to clear (Status Register A bit 7)
    let mut timeout = 10000;
    while timeout > 0 {
        let a = _ke_rtc_read(10);
        if (a / 128) % 2 == 0 { timeout = 0; }
        else { timeout = timeout - 1; }
    }

    let raw_sec = _ke_rtc_read(0);
    let raw_min = _ke_rtc_read(2);
    let raw_hour = _ke_rtc_read(4);
    let raw_day = _ke_rtc_read(7);
    let raw_month = _ke_rtc_read(8);
    let raw_year = _ke_rtc_read(9);

    let sec = _ke_bcd2bin(raw_sec);
    let min = _ke_bcd2bin(raw_min);
    let hour = _ke_bcd2bin(raw_hour);
    let day = _ke_bcd2bin(raw_day);
    let month = _ke_bcd2bin(raw_month);
    let year = _ke_bcd2bin(raw_year) + 2000;

    // Print "YYYY-MM-DD HH:MM:SS\r\n"
    _ke_put_dec(year);
    _ke_putc(45);
    _ke_put_dec2(month);
    _ke_putc(45);
    _ke_put_dec2(day);
    _ke_putc(32);
    _ke_put_dec2(hour);
    _ke_putc(58);
    _ke_put_dec2(min);
    _ke_putc(58);
    _ke_put_dec2(sec);
    _ke_putc(13); _ke_putc(10);
    return 0;
}

// === Iteration 41: VirtIO-blk + System Commands ===
//
// VirtIO-blk PCI: vendor=0x1AF4(6900) device=0x1001(4097)
// Memory layout:
//   0x920000: virtqueue descriptors (128 × 16 = 2048 bytes)
//   0x920800: avail ring
//   0x921000: used ring (page-aligned)
//   0x922000: request header (16 bytes)
//   0x922010: request status (1 byte)
//   0x922100: data buffer (512 bytes)
//   0x310060: blk_bar (stored)

// Read 16-bit little-endian from memory
fn _ke_mem_r16(addr) {
    let lo = mem_read_u8(addr);
    let hi = mem_read_u8(addr + 1);
    return hi * 256 + lo;
}

// Scan PCI for VirtIO-blk device
fn _ke_virtio_blk_find() {
    let mut dev = 0;
    while dev < 32 {
        let vendor = _ke_pci_vendor(0, dev, 0);
        if vendor == 6900 {
            let devid = _ke_pci_device(0, dev, 0);
            if devid == 4097 { return dev; }
        }
        dev = dev + 1;
    }
    return 255;
}

// Initialize VirtIO-blk device
fn _ke_virtio_blk_init(bar) {
    // Reset → ACK → DRIVER
    port_out_u8(bar + 18, 0);
    port_out_u8(bar + 18, 1);
    port_out_u8(bar + 18, 3);

    // Negotiate features (none needed)
    port_out_u32(bar + 4, 0);
    // FEATURES_OK
    port_out_u8(bar + 18, 11);

    // Select queue 0
    port_out_u16(bar + 14, 0);

    // Queue memory
    let qbase = 9568256;     // 0x920000: descriptors
    let avail = 9570304;     // 0x920800: avail ring
    let used_base = 9572352; // 0x921000: used ring

    // Zero descriptor area (2048 bytes)
    let mut i = 0;
    while i < 2048 {
        mem_write_u8(qbase + i, 0);
        i = i + 1;
    }
    // Zero avail ring (260 bytes)
    i = 0;
    while i < 260 {
        mem_write_u8(avail + i, 0);
        i = i + 1;
    }
    // Zero used ring (1028 bytes)
    i = 0;
    while i < 1028 {
        mem_write_u8(used_base + i, 0);
        i = i + 1;
    }

    // Tell device queue address (PFN)
    port_out_u32(bar + 8, qbase / 4096);

    // DRIVER_OK
    port_out_u8(bar + 18, 15);

    // Store BAR
    mem_write_u32(3211360, bar);  // 0x310060

    // "BLK: OK\r\n"
    _ke_putc(66); _ke_putc(76); _ke_putc(75); _ke_putc(58); _ke_putc(32);
    _ke_putc(79); _ke_putc(75);
    _ke_putc(13); _ke_putc(10);
    return 0;
}

// Read one sector from VirtIO-blk
// Returns 0 on success, nonzero on failure
fn _ke_virtio_blk_read(sector) {
    let bar = mem_read_u32(3211360);  // blk_bar
    if bar == 0 { return 1; }

    let qbase = 9568256;     // 0x920000
    let avail = 9570304;     // 0x920800
    let used_base = 9572352; // 0x921000
    let hdr = 9576448;       // 0x922000
    let status = 9576464;    // 0x922010
    let data = 9576704;      // 0x922100

    // Request header: type=0 (read), sector
    _ke_mem_w32(hdr, 0);
    _ke_mem_w32(hdr + 4, 0);
    _ke_mem_w32(hdr + 8, sector);
    _ke_mem_w32(hdr + 12, 0);

    // Clear status
    mem_write_u8(status, 255);

    // Descriptor 0: header (16 bytes, device-readable, NEXT→1)
    mem_write_u64(qbase, hdr);
    _ke_mem_w32(qbase + 8, 16);
    _ke_mem_w16(qbase + 12, 1);     // flags = NEXT
    _ke_mem_w16(qbase + 14, 1);     // next = 1

    // Descriptor 1: data (512 bytes, device-writable, NEXT→2)
    mem_write_u64(qbase + 16, data);
    _ke_mem_w32(qbase + 24, 512);
    _ke_mem_w16(qbase + 28, 3);     // flags = WRITE|NEXT
    _ke_mem_w16(qbase + 30, 2);     // next = 2

    // Descriptor 2: status (1 byte, device-writable)
    mem_write_u64(qbase + 32, status);
    _ke_mem_w32(qbase + 40, 1);
    _ke_mem_w16(qbase + 44, 2);     // flags = WRITE
    _ke_mem_w16(qbase + 46, 0);     // next = 0

    // Add to avail ring
    let aidx = _ke_mem_r16(avail + 2);
    let ring_off = 4 + (aidx % 128) * 2;
    _ke_mem_w16(avail + ring_off, 0);
    _ke_mem_w16(avail + 2, aidx + 1);

    // Notify queue 0
    port_out_u16(bar + 16, 0);

    // Poll used ring
    let old_used = _ke_mem_r16(used_base + 2);
    let mut timeout = 10000000;
    while timeout > 0 {
        let cur = _ke_mem_r16(used_base + 2);
        if cur != old_used { return mem_read_u8(status); }
        timeout = timeout - 1;
    }
    return 1;  // timeout
}

// Command: disk — VirtIO-blk info + sector 0 read
fn _ke_cmd_disk() {
    let bar = mem_read_u32(3211360);
    if bar == 0 {
        // "BLK: none\r\n"
        _ke_putc(66); _ke_putc(76); _ke_putc(75);
        _ke_putc(58); _ke_putc(32); _ke_putc(110); _ke_putc(111);
        _ke_putc(110); _ke_putc(101);
        _ke_putc(13); _ke_putc(10);
        return 0;
    }

    // Read capacity from device config (BAR+0x14, 8 bytes)
    let cap = port_in_u32(bar + 20);
    // "Disk: NNNN sectors (M MB)\r\n"
    _ke_putc(68); _ke_putc(105); _ke_putc(115); _ke_putc(107);
    _ke_putc(58); _ke_putc(32);
    _ke_put_dec(cap);
    // " sect "
    _ke_putc(32); _ke_putc(115); _ke_putc(101); _ke_putc(99); _ke_putc(116);
    _ke_putc(32);
    // "("
    _ke_putc(40);
    _ke_put_dec(cap / 2048);
    // " MB)\r\n"
    _ke_putc(32); _ke_putc(77); _ke_putc(66); _ke_putc(41);
    _ke_putc(13); _ke_putc(10);

    // Read sector 0
    let result = _ke_virtio_blk_read(0);
    if result == 0 {
        // "Sect0: " + first 16 bytes hex
        _ke_putc(83); _ke_putc(48); _ke_putc(58); _ke_putc(32);
        let data = 9576704;  // 0x922100
        let mut i = 0;
        while i < 16 {
            let b = mem_read_u8(data + i);
            _ke_put_hex4(b / 16); _ke_put_hex4(b);
            _ke_putc(32);
            i = i + 1;
        }
        _ke_putc(13); _ke_putc(10);
        // Check MBR signature (0x55AA at offset 510-511)
        let s510 = mem_read_u8(data + 510);
        let s511 = mem_read_u8(data + 511);
        if s510 == 85 {
            if s511 == 170 {
                // "MBR: 55AA\r\n"
                _ke_putc(77); _ke_putc(66); _ke_putc(82); _ke_putc(58); _ke_putc(32);
                _ke_putc(53); _ke_putc(53); _ke_putc(65); _ke_putc(65);
                _ke_putc(13); _ke_putc(10);
            }
        }
    } else {
        // "Read: FAIL\r\n"
        _ke_putc(82); _ke_putc(100); _ke_putc(58); _ke_putc(32);
        _ke_putc(70); _ke_putc(65); _ke_putc(73); _ke_putc(76);
        _ke_putc(13); _ke_putc(10);
    }
    return 0;
}

// Command: uptime — show system uptime from tick counter
fn _ke_cmd_uptime() {
    let ticks = mem_read_u64(3145728);  // 0x300000
    let secs = ticks / 100;
    let mins = secs / 60;
    let hours = mins / 60;
    let rem_m = mins % 60;
    let rem_s = secs % 60;
    // "Up: Xh Xm Xs\r\n"
    _ke_putc(85); _ke_putc(112); _ke_putc(58); _ke_putc(32);
    _ke_put_dec(hours);
    _ke_putc(104); _ke_putc(32);  // "h "
    _ke_put_dec(rem_m);
    _ke_putc(109); _ke_putc(32);  // "m "
    _ke_put_dec(rem_s);
    _ke_putc(115);                 // "s"
    _ke_putc(13); _ke_putc(10);
    return 0;
}

// Command: shutdown — ACPI S5 power off
fn _ke_cmd_shutdown() {
    // "Shutdown...\r\n"
    _ke_putc(83); _ke_putc(104); _ke_putc(117); _ke_putc(116);
    _ke_putc(100); _ke_putc(111); _ke_putc(119); _ke_putc(110);
    _ke_putc(46); _ke_putc(46); _ke_putc(46);
    _ke_putc(13); _ke_putc(10);

    let rsdp = _ke_acpi_find_rsdp();
    if rsdp != 0 {
        let rsdt = _ke_acpi_rsdt(rsdp);
        let fadt = _ke_acpi_find_table(rsdt, 70, 65, 67, 80);
        if fadt != 0 {
            let pm1a = mem_read_u32(fadt + 64);
            // PM1a_CNT: SLP_TYP(5)<<10 | SLP_EN(bit13) = 13312
            port_out_u16(pm1a, 13312);
        }
    }
    // Fallback: halt
    hlt();
    return 0;
}

// === Iteration 42: FAT16 Format + ls in kernel.bin ===
//
// FAT16 layout on VirtIO-blk data disk (hicos-disk.img):
//   Sector   0: BPB (BIOS Parameter Block)
//   Sectors  1-3: reserved
//   Sectors  4-67: FAT1 (64 sectors)
//   Sectors 68-131: FAT2 (64 sectors)
//   Sectors 132-163: root directory (512 entries)
//   Sectors 164+: data area (4 sectors/cluster = 2KB)
//
// Constants
//   FAT16_RESERVED = 4
//   FAT16_FAT_SECTORS = 64
//   FAT16_ROOT_START = 132
//   FAT16_ROOT_SECTORS = 32
//   FAT16_DATA_START = 164
//   FAT16_CLUSTER_SECTORS = 4

// Write one sector from data buffer (0x922100) to VirtIO-blk disk
fn _ke_virtio_blk_write(sector) {
    let bar = mem_read_u32(3211360);
    if bar == 0 { return 1; }

    let qbase = 9568256;     // 0x920000
    let avail = 9570304;     // 0x920800
    let used_base = 9572352; // 0x921000
    let hdr = 9576448;       // 0x922000
    let status = 9576464;    // 0x922010
    let data = 9576704;      // 0x922100

    // Request header: type=1 (WRITE)
    _ke_mem_w32(hdr, 1);
    _ke_mem_w32(hdr + 4, 0);
    _ke_mem_w32(hdr + 8, sector);
    _ke_mem_w32(hdr + 12, 0);

    mem_write_u8(status, 255);

    // Desc 0: header (readable, NEXT→1)
    mem_write_u64(qbase, hdr);
    _ke_mem_w32(qbase + 8, 16);
    _ke_mem_w16(qbase + 12, 1);
    _ke_mem_w16(qbase + 14, 1);

    // Desc 1: data buffer (readable by device, NEXT→2)
    mem_write_u64(qbase + 16, data);
    _ke_mem_w32(qbase + 24, 512);
    _ke_mem_w16(qbase + 28, 1);     // flags = NEXT only (device reads)
    _ke_mem_w16(qbase + 30, 2);

    // Desc 2: status (writable)
    mem_write_u64(qbase + 32, status);
    _ke_mem_w32(qbase + 40, 1);
    _ke_mem_w16(qbase + 44, 2);     // flags = WRITE
    _ke_mem_w16(qbase + 46, 0);

    let aidx = _ke_mem_r16(avail + 2);
    let ring_off = 4 + (aidx % 128) * 2;
    _ke_mem_w16(avail + ring_off, 0);
    _ke_mem_w16(avail + 2, aidx + 1);

    port_out_u16(bar + 16, 0);

    let old_used = _ke_mem_r16(used_base + 2);
    let mut timeout = 10000000;
    while timeout > 0 {
        let cur = _ke_mem_r16(used_base + 2);
        if cur != old_used { return mem_read_u8(status); }
        timeout = timeout - 1;
    }
    return 1;
}

// Zero the 512-byte data buffer at 0x922100
fn _ke_blk_zero_buf() {
    let data = 9576704;
    let mut i = 0;
    while i < 512 { mem_write_u8(data + i, 0); i = i + 1; }
    return 0;
}

// Command: format — create FAT16 filesystem on VirtIO-blk disk
fn _ke_cmd_format() {
    let bar = mem_read_u32(3211360);
    if bar == 0 {
        _ke_putc(66); _ke_putc(76); _ke_putc(75); _ke_putc(58); _ke_putc(32);
        _ke_putc(110); _ke_putc(111); _ke_putc(110); _ke_putc(101);
        _ke_putc(13); _ke_putc(10);
        return 0;
    }

    let data = 9576704;
    // --- Sector 0: BPB ---
    _ke_blk_zero_buf();
    // JMP short + NOP
    mem_write_u8(data, 235); mem_write_u8(data + 1, 60); mem_write_u8(data + 2, 144);
    // OEM "HicOS   "
    mem_write_u8(data + 3, 72); mem_write_u8(data + 4, 105); mem_write_u8(data + 5, 99);
    mem_write_u8(data + 6, 79); mem_write_u8(data + 7, 83);
    mem_write_u8(data + 8, 32); mem_write_u8(data + 9, 32); mem_write_u8(data + 10, 32);
    _ke_mem_w16(data + 11, 512);    // bytes/sector
    mem_write_u8(data + 13, 4);     // sectors/cluster
    _ke_mem_w16(data + 14, 4);      // reserved sectors
    mem_write_u8(data + 16, 2);     // FAT count
    _ke_mem_w16(data + 17, 512);    // root entries
    _ke_mem_w16(data + 19, 0);      // total sectors 16 = 0 (use 32)
    mem_write_u8(data + 21, 248);   // media = 0xF8
    _ke_mem_w16(data + 22, 64);     // sectors/FAT
    _ke_mem_w16(data + 24, 32);     // sectors/track
    _ke_mem_w16(data + 26, 8);      // heads
    _ke_mem_w32(data + 28, 0);      // hidden sectors
    _ke_mem_w32(data + 32, 65536);  // total sectors 32 (32 MB)
    mem_write_u8(data + 36, 128);   // drive = 0x80
    mem_write_u8(data + 38, 41);    // boot sig = 0x29
    _ke_mem_w32(data + 39, 1215259475); // serial "HicS"
    // label "HicOS      "
    mem_write_u8(data + 43, 72); mem_write_u8(data + 44, 105); mem_write_u8(data + 45, 99);
    mem_write_u8(data + 46, 79); mem_write_u8(data + 47, 83);
    let mut li = 48;
    while li < 54 { mem_write_u8(data + li, 32); li = li + 1; }
    // "FAT16   "
    mem_write_u8(data + 54, 70); mem_write_u8(data + 55, 65); mem_write_u8(data + 56, 84);
    mem_write_u8(data + 57, 49); mem_write_u8(data + 58, 54);
    mem_write_u8(data + 59, 32); mem_write_u8(data + 60, 32); mem_write_u8(data + 61, 32);
    // MBR signature
    mem_write_u8(data + 510, 85); mem_write_u8(data + 511, 170);
    _ke_virtio_blk_write(0);

    // --- Reserved sectors 1-3: zeros ---
    _ke_blk_zero_buf();
    _ke_virtio_blk_write(1);
    _ke_virtio_blk_write(2);
    _ke_virtio_blk_write(3);

    // --- FAT1 (sectors 4-67) ---
    // First FAT sector: F8 FF FF FF + zeros
    _ke_blk_zero_buf();
    mem_write_u8(data, 248); mem_write_u8(data + 1, 255);
    mem_write_u8(data + 2, 255); mem_write_u8(data + 3, 255);
    _ke_virtio_blk_write(4);
    // Rest of FAT1
    _ke_blk_zero_buf();
    let mut s = 5;
    while s < 68 { _ke_virtio_blk_write(s); s = s + 1; }

    // --- FAT2 (sectors 68-131) ---
    _ke_blk_zero_buf();
    mem_write_u8(data, 248); mem_write_u8(data + 1, 255);
    mem_write_u8(data + 2, 255); mem_write_u8(data + 3, 255);
    _ke_virtio_blk_write(68);
    _ke_blk_zero_buf();
    s = 69;
    while s < 132 { _ke_virtio_blk_write(s); s = s + 1; }

    // --- Root directory (sectors 132-163) ---
    _ke_blk_zero_buf();
    s = 132;
    while s < 164 { _ke_virtio_blk_write(s); s = s + 1; }

    // "FAT16 OK (164 sect)\r\n"
    _ke_putc(70); _ke_putc(65); _ke_putc(84); _ke_putc(49); _ke_putc(54);
    _ke_putc(32); _ke_putc(79); _ke_putc(75);
    _ke_putc(13); _ke_putc(10);
    return 0;
}

// Command: ls — list FAT16 root directory entries
fn _ke_cmd_ls() {
    let bar = mem_read_u32(3211360);
    if bar == 0 {
        _ke_putc(66); _ke_putc(76); _ke_putc(75); _ke_putc(58); _ke_putc(32);
        _ke_putc(110); _ke_putc(111); _ke_putc(110); _ke_putc(101);
        _ke_putc(13); _ke_putc(10);
        return 0;
    }

    let data = 9576704;
    let mut total_files = 0;
    let mut sect = 132;  // root dir start

    while sect < 164 {
        let result = _ke_virtio_blk_read(sect);
        if result != 0 { sect = 164; } else {
            // Parse 16 entries per sector
            let mut e = 0;
            while e < 16 {
                let off = data + e * 32;
                let b0 = mem_read_u8(off);
                // End of directory
                if b0 == 0 { e = 16; sect = 163; }
                // Skip deleted (0xE5)
                else if b0 != 229 {
                    let attr = mem_read_u8(off + 11);
                    // Skip LFN (0x0F) and volume label (0x08)
                    if attr != 15 {
                        if (attr / 8) % 2 == 0 {
                            // Print filename (8 bytes, trim trailing spaces)
                            let mut fi = 0;
                            while fi < 8 {
                                let ch = mem_read_u8(off + fi);
                                if ch != 32 { _ke_putc(ch); }
                                fi = fi + 1;
                            }
                            // Extension
                            let ext0 = mem_read_u8(off + 8);
                            if ext0 != 32 {
                                _ke_putc(46); // '.'
                                fi = 8;
                                while fi < 11 {
                                    let ch = mem_read_u8(off + fi);
                                    if ch != 32 { _ke_putc(ch); }
                                    fi = fi + 1;
                                }
                            }
                            // Padding + size
                            _ke_putc(32); _ke_putc(32);
                            let size = mem_read_u32(off + 28);
                            _ke_put_dec(size);
                            _ke_putc(66); // 'B'
                            _ke_putc(13); _ke_putc(10);
                            total_files = total_files + 1;
                        }
                    }
                }
                e = e + 1;
            }
        }
        sect = sect + 1;
    }
    // "N files\r\n"
    _ke_put_dec(total_files);
    _ke_putc(32); _ke_putc(102); _ke_putc(105); _ke_putc(108);
    _ke_putc(101); _ke_putc(115);
    _ke_putc(13); _ke_putc(10);
    return 0;
}

// === Iteration 43: FAT16 mkfile + cat in kernel.bin ===
//
// mkfile FILENAME.EXT content text here
// cat FILENAME.EXT
//
// 8.3 name buffer at 0x310080 (11 bytes), safe from data buffer overwrite
// FAT16 constants:
//   FAT1_START = 4, FAT2_START = 68, ROOT_START = 132
//   DATA_START = 164, CLUSTER_SECTORS = 4 (2KB/cluster)

// Convert filename at (addr, length) to 8.3 format at 0x310080
fn _ke_parse_83name(addr, length) {
    let name83 = 3211392;  // 0x310080
    let mut i = 0;
    while i < 11 { mem_write_u8(name83 + i, 32); i = i + 1; }

    // Find dot position
    let mut dot_pos = length;
    i = 0;
    while i < length {
        if mem_read_u8(addr + i) == 46 { dot_pos = i; i = length; }
        i = i + 1;
    }

    // Name part (before dot, max 8, uppercase)
    i = 0;
    while i < 8 {
        if i < dot_pos {
            let mut ch = mem_read_u8(addr + i);
            if ch >= 97 { if ch <= 122 { ch = ch - 32; } }
            mem_write_u8(name83 + i, ch);
        }
        i = i + 1;
    }

    // Extension (after dot, max 3, uppercase)
    if dot_pos < length {
        i = 0;
        while i < 3 {
            let pos = dot_pos + 1 + i;
            if pos < length {
                let mut ch = mem_read_u8(addr + pos);
                if ch >= 97 { if ch <= 122 { ch = ch - 32; } }
                mem_write_u8(name83 + 8 + i, ch);
            }
            i = i + 1;
        }
    }
    return name83;
}

// Command: mkfile — create a file on FAT16 disk
// Usage: "mkfile test.txt Hello World"
fn _ke_cmd_mkfile(buf_addr, buf_len) {
    let bar = mem_read_u32(3211360);
    if bar == 0 {
        _ke_putc(66); _ke_putc(76); _ke_putc(75); _ke_putc(58); _ke_putc(32);
        _ke_putc(110); _ke_putc(111); _ke_putc(110); _ke_putc(101);
        _ke_putc(13); _ke_putc(10);
        return 0;
    }

    let data = 9576704;

    // Parse: "mkfile " = 7 chars, then filename until space, then content
    if buf_len < 8 {
        _ke_putc(63); _ke_putc(13); _ke_putc(10); return 0;
    }
    let fname_start = buf_addr + 7;

    // Find end of filename (first space after position 7)
    let mut fname_end = fname_start;
    while fname_end < buf_addr + buf_len {
        if mem_read_u8(fname_end) != 32 { fname_end = fname_end + 1; }
        else { fname_end = buf_addr + buf_len + 1; } // signal: space found
    }
    // If space was found, fname_end overflowed; recalculate
    let mut actual_end = fname_start;
    let mut scan = fname_start;
    while scan < buf_addr + buf_len {
        if mem_read_u8(scan) != 32 { actual_end = scan + 1; scan = scan + 1; }
        else { scan = buf_addr + buf_len; }
    }

    let fname_len = actual_end - fname_start;
    let content_start = actual_end + 1;
    let mut content_len = 0;
    if content_start < buf_addr + buf_len {
        content_len = buf_addr + buf_len - content_start;
    }

    // Convert filename to 8.3
    let name83 = _ke_parse_83name(fname_start, fname_len);

    // Find free cluster in FAT1 (cluster 2+)
    let mut free_cluster = 0;
    let mut fs = 4;
    while fs < 68 {
        if free_cluster == 0 {
            _ke_virtio_blk_read(fs);
            let mut ei = 0;
            while ei < 256 {
                let cluster_idx = (fs - 4) * 256 + ei;
                if cluster_idx >= 2 {
                    if free_cluster == 0 {
                        let fat_val = _ke_mem_r16(data + ei * 2);
                        if fat_val == 0 { free_cluster = cluster_idx; }
                    }
                }
                ei = ei + 1;
            }
        }
        fs = fs + 1;
    }

    if free_cluster == 0 {
        // "Full\r\n"
        _ke_putc(70); _ke_putc(117); _ke_putc(108); _ke_putc(108);
        _ke_putc(13); _ke_putc(10);
        return 0;
    }

    // Write content to the cluster's first sector
    let first_sector = 164 + (free_cluster - 2) * 4;
    _ke_blk_zero_buf();
    let mut i = 0;
    while i < content_len {
        if i < 512 {
            mem_write_u8(data + i, mem_read_u8(content_start + i));
        }
        i = i + 1;
    }
    _ke_virtio_blk_write(first_sector);

    // Update FAT: mark cluster as end-of-chain (0xFFFF)
    let fat_sector = 4 + (free_cluster * 2) / 512;
    let fat_offset = (free_cluster * 2) % 512;
    _ke_virtio_blk_read(fat_sector);
    _ke_mem_w16(data + fat_offset, 65535);
    _ke_virtio_blk_write(fat_sector);          // write FAT1
    _ke_virtio_blk_write(fat_sector + 64);     // write FAT2 (same data)

    // Find free directory entry and create it
    let mut dir_sect = 132;
    let mut wrote_dir = 0;
    while dir_sect < 164 {
        if wrote_dir == 0 {
            _ke_virtio_blk_read(dir_sect);
            let mut de = 0;
            while de < 16 {
                if wrote_dir == 0 {
                    let off = data + de * 32;
                    let b0 = mem_read_u8(off);
                    if b0 == 0 {
                        // Write 8.3 name
                        i = 0;
                        while i < 11 {
                            mem_write_u8(off + i, mem_read_u8(name83 + i));
                            i = i + 1;
                        }
                        mem_write_u8(off + 11, 32); // attr = 0x20 (archive)
                        i = 12;
                        while i < 26 { mem_write_u8(off + i, 0); i = i + 1; }
                        _ke_mem_w16(off + 26, free_cluster);
                        _ke_mem_w32(off + 28, content_len);
                        _ke_virtio_blk_write(dir_sect);
                        wrote_dir = 1;
                    }
                    if b0 == 229 {
                        i = 0;
                        while i < 11 {
                            mem_write_u8(off + i, mem_read_u8(name83 + i));
                            i = i + 1;
                        }
                        mem_write_u8(off + 11, 32);
                        i = 12;
                        while i < 26 { mem_write_u8(off + i, 0); i = i + 1; }
                        _ke_mem_w16(off + 26, free_cluster);
                        _ke_mem_w32(off + 28, content_len);
                        _ke_virtio_blk_write(dir_sect);
                        wrote_dir = 1;
                    }
                }
                de = de + 1;
            }
        }
        dir_sect = dir_sect + 1;
    }

    // "OK: NB\r\n"
    _ke_putc(79); _ke_putc(75); _ke_putc(58); _ke_putc(32);
    _ke_put_dec(content_len);
    _ke_putc(66);
    _ke_putc(13); _ke_putc(10);
    return 0;
}

// Command: cat — read and display a file from FAT16
// Usage: "cat test.txt"
fn _ke_cmd_cat(buf_addr, buf_len) {
    let bar = mem_read_u32(3211360);
    if bar == 0 {
        _ke_putc(66); _ke_putc(76); _ke_putc(75); _ke_putc(58); _ke_putc(32);
        _ke_putc(110); _ke_putc(111); _ke_putc(110); _ke_putc(101);
        _ke_putc(13); _ke_putc(10);
        return 0;
    }

    let data = 9576704;

    // Parse filename: "cat " = 4 chars
    if buf_len < 5 {
        _ke_putc(63); _ke_putc(13); _ke_putc(10); return 0;
    }
    let fname_start = buf_addr + 4;
    let fname_len = buf_len - 4;

    // Convert to 8.3
    let name83 = _ke_parse_83name(fname_start, fname_len);

    // Search root directory
    let mut found_cluster = 0;
    let mut found_size = 0;
    let mut sect = 132;
    while sect < 164 {
        if found_cluster == 0 {
            _ke_virtio_blk_read(sect);
            let mut de = 0;
            while de < 16 {
                if found_cluster == 0 {
                    let off = data + de * 32;
                    let b0 = mem_read_u8(off);
                    if b0 != 0 {
                        if b0 != 229 {
                            let attr = mem_read_u8(off + 11);
                            if attr != 15 {
                                if (attr / 8) % 2 == 0 {
                                    // Compare 11 bytes
                                    let mut match_ok = 1;
                                    let mut ci = 0;
                                    while ci < 11 {
                                        if mem_read_u8(off + ci) != mem_read_u8(name83 + ci) {
                                            match_ok = 0; ci = 11;
                                        }
                                        ci = ci + 1;
                                    }
                                    if match_ok == 1 {
                                        found_cluster = _ke_mem_r16(off + 26);
                                        found_size = mem_read_u32(off + 28);
                                    }
                                }
                            }
                        }
                    }
                }
                de = de + 1;
            }
        }
        sect = sect + 1;
    }

    if found_cluster == 0 {
        // "Not found\r\n"
        _ke_putc(78); _ke_putc(111); _ke_putc(116); _ke_putc(32);
        _ke_putc(102); _ke_putc(111); _ke_putc(117); _ke_putc(110); _ke_putc(100);
        _ke_putc(13); _ke_putc(10);
        return 0;
    }

    // Read and output file content following FAT chain
    let mut remaining = found_size;
    let mut cluster = found_cluster;
    while remaining > 0 {
        if cluster < 2 { remaining = 0; }
        else if cluster >= 65520 { remaining = 0; }
        else {
            let csect = 164 + (cluster - 2) * 4;
            let mut s = 0;
            while s < 4 {
                if remaining > 0 {
                    _ke_virtio_blk_read(csect + s);
                    let mut bi = 0;
                    while bi < 512 {
                        if remaining > 0 {
                            _ke_putc(mem_read_u8(data + bi));
                            remaining = remaining - 1;
                        }
                        bi = bi + 1;
                    }
                }
                s = s + 1;
            }
            // Follow FAT chain
            let fat_s = 4 + (cluster * 2) / 512;
            let fat_o = (cluster * 2) % 512;
            _ke_virtio_blk_read(fat_s);
            cluster = _ke_mem_r16(data + fat_o);
        }
    }
    _ke_putc(13); _ke_putc(10);
    return 0;
}

// === Iteration 44: run command — micro H-L interpreter ===
//
// "run hello.hl" → read .hl file from FAT16 → interpret → serial output
//
// Supported syntax:
//   print("string literal");
//   print(integer);
//   let x = expr;   (x stored in variable table)
//   print(x);       (variable lookup)
//   Expressions: number, +, -, *, /
//
// File buffer: 0x930000 (4KB max)
// Variable table: 0x931000 (32 entries × 24 bytes = name_hash(8) + value(8) + type(8))

// Find a file in FAT16, load into buffer at 0x930000, return file size (0=fail)
fn _ke_load_file(fname_addr, fname_len) {
    let data = 9576704;
    let fbuf = 9633792;    // 0x930000
    let name83 = _ke_parse_83name(fname_addr, fname_len);

    // Search root directory
    let mut found_cluster = 0;
    let mut found_size = 0;
    let mut sect = 132;
    while sect < 164 {
        if found_cluster == 0 {
            _ke_virtio_blk_read(sect);
            let mut de = 0;
            while de < 16 {
                if found_cluster == 0 {
                    let off = data + de * 32;
                    let b0 = mem_read_u8(off);
                    if b0 != 0 { if b0 != 229 {
                        let attr = mem_read_u8(off + 11);
                        if attr != 15 { if (attr / 8) % 2 == 0 {
                            let mut match_ok = 1;
                            let mut ci = 0;
                            while ci < 11 {
                                if mem_read_u8(off + ci) != mem_read_u8(name83 + ci) {
                                    match_ok = 0; ci = 11;
                                }
                                ci = ci + 1;
                            }
                            if match_ok == 1 {
                                found_cluster = _ke_mem_r16(off + 26);
                                found_size = mem_read_u32(off + 28);
                            }
                        } }
                    } }
                }
                de = de + 1;
            }
        }
        sect = sect + 1;
    }

    if found_cluster == 0 { return 0; }
    if found_size > 4096 { found_size = 4096; }

    // Load file content sector by sector
    let csect = 164 + (found_cluster - 2) * 4;
    let mut loaded = 0;
    let mut s = 0;
    while s < 4 {
        if loaded < found_size {
            _ke_virtio_blk_read(csect + s);
            let mut bi = 0;
            while bi < 512 {
                if loaded < found_size {
                    mem_write_u8(fbuf + loaded, mem_read_u8(data + bi));
                    loaded = loaded + 1;
                }
                bi = bi + 1;
            }
        }
        s = s + 1;
    }
    return found_size;
}

// Simple hash for variable name (up to 8 bytes)
fn _ke_var_hash(fbuf, start, length) {
    let mut h = 0;
    let mut i = 0;
    while i < length {
        if i < 8 {
            let ch = mem_read_u8(fbuf + start + i);
            h = h * 31 + ch;
        }
        i = i + 1;
    }
    return h;
}

// Store variable: table at 0x931000, 32 entries × 16 bytes [hash(8), value(8)]
fn _ke_var_set(hash, value) {
    let tbl = 9637888;  // 0x931000
    let mut i = 0;
    // Find existing or first empty slot
    while i < 32 {
        let eh = mem_read_u64(tbl + i * 16);
        if eh == hash {
            mem_write_u64(tbl + i * 16 + 8, value);
            return 0;
        }
        if eh == 0 {
            mem_write_u64(tbl + i * 16, hash);
            mem_write_u64(tbl + i * 16 + 8, value);
            return 0;
        }
        i = i + 1;
    }
    return 0;
}

// Lookup variable, return value (0 if not found)
fn _ke_var_get(hash) {
    let tbl = 9637888;
    let mut i = 0;
    while i < 32 {
        if mem_read_u64(tbl + i * 16) == hash {
            return mem_read_u64(tbl + i * 16 + 8);
        }
        i = i + 1;
    }
    return 0;
}

// Skip whitespace, return new position
fn _ke_skip_ws(fbuf, pos, limit) {
    while pos < limit {
        let ch = mem_read_u8(fbuf + pos);
        if ch == 32 { pos = pos + 1; }
        else if ch == 9 { pos = pos + 1; }
        else if ch == 13 { pos = pos + 1; }
        else if ch == 10 { pos = pos + 1; }
        else { return pos; }
    }
    return pos;
}

// Parse a number at position, return [value, new_pos]
// Result stored in memory at 0x931200
fn _ke_parse_num(fbuf, pos, limit) {
    let mut val = 0;
    let mut found = 0;
    while pos < limit {
        let ch = mem_read_u8(fbuf + pos);
        if ch >= 48 { if ch <= 57 {
            val = val * 10 + ch - 48;
            found = 1;
            pos = pos + 1;
        } else { pos = limit + 1; } }
        else { pos = limit + 1; }
    }
    // Store result at 0x931200
    mem_write_u64(9638400, val);
    mem_write_u64(9638408, pos);
    return found;
}

// Parse simple expression: number, variable, or number OP number
// Returns value, stores consumed position at 0x931210
fn _ke_eval_expr(fbuf, pos, limit) {
    pos = _ke_skip_ws(fbuf, pos, limit);
    let ch = mem_read_u8(fbuf + pos);
    let mut val = 0;

    // Number literal
    if ch >= 48 { if ch <= 57 {
        while pos < limit {
            let d = mem_read_u8(fbuf + pos);
            if d >= 48 { if d <= 57 { val = val * 10 + d - 48; pos = pos + 1; }
            else { pos = limit + 1; } }
            else { pos = limit + 1; }
        }
        if pos > limit { pos = pos - limit - 1 + limit; }
    } }
    // Variable name (identifier)
    else if ch >= 97 { if ch <= 122 {
        let var_start = pos;
        while pos < limit {
            let d = mem_read_u8(fbuf + pos);
            if d >= 97 { if d <= 122 { pos = pos + 1; } else { pos = limit + 1; } }
            else if d >= 48 { if d <= 57 { pos = pos + 1; } else { pos = limit + 1; } }
            else if d == 95 { pos = pos + 1; }
            else { pos = limit + 1; }
        }
        if pos > limit { pos = pos - limit - 1 + limit; }
        let vh = _ke_var_hash(fbuf, var_start, pos - var_start);
        val = _ke_var_get(vh);
    } }

    // Check for binary operator
    pos = _ke_skip_ws(fbuf, pos, limit);
    if pos < limit {
        let op = mem_read_u8(fbuf + pos);
        if op == 43 { // '+'
            pos = pos + 1;
            let rhs = _ke_eval_expr(fbuf, pos, limit);
            let rpos = mem_read_u64(9638416);
            mem_write_u64(9638416, rpos);
            val = val + rhs;
            pos = rpos;
        }
        if op == 45 { // '-'
            pos = pos + 1;
            let rhs = _ke_eval_expr(fbuf, pos, limit);
            let rpos = mem_read_u64(9638416);
            val = val - rhs;
            pos = rpos;
        }
        if op == 42 { // '*'
            pos = pos + 1;
            let rhs = _ke_eval_expr(fbuf, pos, limit);
            let rpos = mem_read_u64(9638416);
            val = val * rhs;
            pos = rpos;
        }
    }

    mem_write_u64(9638416, pos);  // 0x931210: consumed position
    return val;
}

// Command: run — execute a .hl file from FAT16
fn _ke_cmd_run(buf_addr, buf_len) {
    let bar = mem_read_u32(3211360);
    if bar == 0 {
        _ke_putc(66); _ke_putc(76); _ke_putc(75); _ke_putc(58); _ke_putc(32);
        _ke_putc(110); _ke_putc(111); _ke_putc(110); _ke_putc(101);
        _ke_putc(13); _ke_putc(10);
        return 0;
    }

    if buf_len < 5 {
        _ke_putc(63); _ke_putc(13); _ke_putc(10); return 0;
    }

    let fbuf = 9633792;  // 0x930000
    let fsize = _ke_load_file(buf_addr + 4, buf_len - 4);
    if fsize == 0 {
        // "Not found\r\n"
        _ke_putc(78); _ke_putc(111); _ke_putc(116); _ke_putc(32);
        _ke_putc(102); _ke_putc(111); _ke_putc(117); _ke_putc(110); _ke_putc(100);
        _ke_putc(13); _ke_putc(10);
        return 0;
    }

    // Clear variable table
    let tbl = 9637888;
    let mut vi = 0;
    while vi < 512 { mem_write_u8(tbl + vi, 0); vi = vi + 1; }

    // Interpret statements
    let mut pos = 0;
    while pos < fsize {
        pos = _ke_skip_ws(fbuf, pos, fsize);
        if pos >= fsize { pos = fsize; }
        else {
            let b0 = mem_read_u8(fbuf + pos);

            // "print(" = 112 114 105 110 116 40
            if b0 == 112 {
                if pos + 6 < fsize {
                    let mut is_print = 1;
                    if mem_read_u8(fbuf + pos + 1) != 114 { is_print = 0; }
                    if mem_read_u8(fbuf + pos + 2) != 105 { is_print = 0; }
                    if mem_read_u8(fbuf + pos + 3) != 110 { is_print = 0; }
                    if mem_read_u8(fbuf + pos + 4) != 116 { is_print = 0; }
                    if mem_read_u8(fbuf + pos + 5) != 40  { is_print = 0; }

                    if is_print == 1 {
                        pos = pos + 6;
                        let next = mem_read_u8(fbuf + pos);
                        // print("string")
                        if next == 34 {
                            pos = pos + 1;
                            let mut done = 0;
                            while pos < fsize {
                                if done == 0 {
                                    let ch = mem_read_u8(fbuf + pos);
                                    if ch == 34 { done = 1; }
                                    else { _ke_putc(ch); }
                                }
                                pos = pos + 1;
                            }
                            _ke_putc(13); _ke_putc(10);
                        } else {
                            // print(expr) — number or variable
                            // Find closing ')'
                            let mut end = pos;
                            while end < fsize {
                                if mem_read_u8(fbuf + end) == 41 { end = fsize + 1; }
                                else { end = end + 1; }
                            }
                            if end > fsize { end = end - fsize - 1 + fsize; }
                            let val = _ke_eval_expr(fbuf, pos, end);
                            _ke_put_dec(val);
                            _ke_putc(13); _ke_putc(10);
                            pos = end + 1;
                        }
                        // Skip to next ';' or newline
                        while pos < fsize {
                            let sk = mem_read_u8(fbuf + pos);
                            if sk == 59 { pos = pos + 1; pos = fsize + 1; }
                            else if sk == 10 { pos = fsize + 1; }
                            else { pos = pos + 1; }
                        }
                        if pos > fsize { pos = pos - fsize - 1 + fsize; }
                    } else { pos = pos + 1; }
                } else { pos = pos + 1; }
            }
            // "let " = 108 101 116 32
            else if b0 == 108 {
                if pos + 4 < fsize {
                    let mut is_let = 1;
                    if mem_read_u8(fbuf + pos + 1) != 101 { is_let = 0; }
                    if mem_read_u8(fbuf + pos + 2) != 116 { is_let = 0; }
                    if mem_read_u8(fbuf + pos + 3) != 32  { is_let = 0; }

                    if is_let == 1 {
                        pos = pos + 4;
                        // Skip optional "mut "
                        if pos + 4 < fsize {
                            if mem_read_u8(fbuf + pos) == 109 {
                                if mem_read_u8(fbuf + pos + 1) == 117 {
                                    if mem_read_u8(fbuf + pos + 2) == 116 {
                                        if mem_read_u8(fbuf + pos + 3) == 32 {
                                            pos = pos + 4;
                                        }
                                    }
                                }
                            }
                        }
                        // Parse variable name
                        let vname_start = pos;
                        while pos < fsize {
                            let d = mem_read_u8(fbuf + pos);
                            if d >= 97 { if d <= 122 { pos = pos + 1; } else { pos = fsize + 1; } }
                            else if d >= 48 { if d <= 57 { pos = pos + 1; } else { pos = fsize + 1; } }
                            else if d == 95 { pos = pos + 1; }
                            else { pos = fsize + 1; }
                        }
                        if pos > fsize { pos = pos - fsize - 1 + fsize; }
                        let vname_len = pos - vname_start;
                        let vh = _ke_var_hash(fbuf, vname_start, vname_len);

                        // Skip " = "
                        pos = _ke_skip_ws(fbuf, pos, fsize);
                        if pos < fsize {
                            if mem_read_u8(fbuf + pos) == 61 { pos = pos + 1; }
                        }

                        // Find ';' to delimit expression
                        let mut expr_end = pos;
                        while expr_end < fsize {
                            if mem_read_u8(fbuf + expr_end) == 59 { expr_end = fsize + 1; }
                            else if mem_read_u8(fbuf + expr_end) == 10 { expr_end = fsize + 1; }
                            else { expr_end = expr_end + 1; }
                        }
                        if expr_end > fsize { expr_end = expr_end - fsize - 1 + fsize; }

                        let val = _ke_eval_expr(fbuf, pos, expr_end);
                        _ke_var_set(vh, val);
                        pos = expr_end + 1;
                    } else { pos = pos + 1; }
                } else { pos = pos + 1; }
            }
            // "//" comment — skip to end of line
            else if b0 == 47 {
                if pos + 1 < fsize {
                    if mem_read_u8(fbuf + pos + 1) == 47 {
                        while pos < fsize {
                            if mem_read_u8(fbuf + pos) == 10 { pos = fsize + 1; }
                            else { pos = pos + 1; }
                        }
                        if pos > fsize { pos = pos - fsize - 1 + fsize; }
                    } else { pos = pos + 1; }
                } else { pos = pos + 1; }
            }
            else { pos = pos + 1; }
        }
    }

    // "Run OK\r\n"
    _ke_putc(82); _ke_putc(117); _ke_putc(110);
    _ke_putc(32); _ke_putc(79); _ke_putc(75);
    _ke_putc(13); _ke_putc(10);
    return 0;
}

// === Iteration 45: HicOS Installer ===
//
// "install" — 7-step disk installer:
//   [1] Detect disk    [2] Create MBR partition table
//   [3] Format FAT16   [4] Write HICOS.SYS marker
//   [5] Write BOOT.CFG [6] Verify MBR   [7] Done

// Print "[N/7] " step prefix
fn _ke_install_step(n) {
    _ke_putc(91);  // '['
    _ke_putc(48 + n); // digit
    _ke_putc(47);  // '/'
    _ke_putc(55);  // '7'
    _ke_putc(93);  // ']'
    _ke_putc(32);  // ' '
    return 0;
}

// Command: install — install HicOS to VirtIO-blk disk
fn _ke_cmd_install() {
    let bar = mem_read_u32(3211360);
    if bar == 0 {
        _ke_putc(66); _ke_putc(76); _ke_putc(75); _ke_putc(58); _ke_putc(32);
        _ke_putc(110); _ke_putc(111); _ke_putc(110); _ke_putc(101);
        _ke_putc(13); _ke_putc(10);
        return 0;
    }

    let data = 9576704;

    // Banner "=== HicOS Installer v5.0 ===\r\n"
    _ke_putc(61); _ke_putc(61); _ke_putc(61); _ke_putc(32);
    // "HicOS Installer v5.0"
    _ke_putc(72); _ke_putc(105); _ke_putc(99); _ke_putc(79); _ke_putc(83);
    _ke_putc(32);
    _ke_putc(73); _ke_putc(110); _ke_putc(115); _ke_putc(116);
    _ke_putc(97); _ke_putc(108); _ke_putc(108); _ke_putc(101); _ke_putc(114);
    _ke_putc(32); _ke_putc(118); _ke_putc(54); _ke_putc(46); _ke_putc(48);
    _ke_putc(32); _ke_putc(61); _ke_putc(61); _ke_putc(61);
    _ke_putc(13); _ke_putc(10);

    // [1/7] Detect disk
    _ke_install_step(1);
    // "Disk: "
    _ke_putc(68); _ke_putc(105); _ke_putc(115); _ke_putc(107);
    _ke_putc(58); _ke_putc(32);
    let cap = port_in_u32(bar + 20);
    _ke_put_dec(cap);
    // " sect ("
    _ke_putc(32); _ke_putc(115); _ke_putc(101); _ke_putc(99); _ke_putc(116);
    _ke_putc(32); _ke_putc(40);
    _ke_put_dec(cap / 2048);
    // " MB)\r\n"
    _ke_putc(32); _ke_putc(77); _ke_putc(66); _ke_putc(41);
    _ke_putc(13); _ke_putc(10);

    // [2/7] Create MBR partition table
    _ke_install_step(2);
    // "MBR partition\r\n"
    _ke_putc(77); _ke_putc(66); _ke_putc(82); _ke_putc(32);
    _ke_putc(112); _ke_putc(97); _ke_putc(114); _ke_putc(116);
    _ke_putc(105); _ke_putc(116); _ke_putc(105); _ke_putc(111); _ke_putc(110);
    _ke_putc(13); _ke_putc(10);
    // Read current sector 0 (will be overwritten by format, but write partition first)
    _ke_blk_zero_buf();
    // Partition entry 1 at offset 446 (16 bytes)
    mem_write_u8(data + 446, 128);   // 0x80 = bootable
    mem_write_u8(data + 446 + 1, 0); // CHS start head
    mem_write_u8(data + 446 + 2, 2); // CHS start sector
    mem_write_u8(data + 446 + 3, 0); // CHS start cylinder
    mem_write_u8(data + 446 + 4, 6); // Type: 0x06 FAT16 LBA
    mem_write_u8(data + 446 + 5, 254); // CHS end
    mem_write_u8(data + 446 + 6, 255);
    mem_write_u8(data + 446 + 7, 255);
    _ke_mem_w32(data + 446 + 8, 1);        // LBA start = 1
    _ke_mem_w32(data + 446 + 12, cap - 1); // LBA sectors
    mem_write_u8(data + 510, 85);   // 0x55
    mem_write_u8(data + 511, 170);  // 0xAA
    _ke_virtio_blk_write(0);

    // [3/7] Format FAT16
    _ke_install_step(3);
    // "FAT16 format\r\n"
    _ke_putc(70); _ke_putc(65); _ke_putc(84); _ke_putc(49); _ke_putc(54);
    _ke_putc(32); _ke_putc(102); _ke_putc(111); _ke_putc(114); _ke_putc(109);
    _ke_putc(97); _ke_putc(116);
    _ke_putc(13); _ke_putc(10);
    _ke_cmd_format();

    // [4/7] Write HICOS.SYS — after format, cluster 2 is free
    _ke_install_step(4);
    // "HICOS.SYS\r\n"
    _ke_putc(72); _ke_putc(73); _ke_putc(67); _ke_putc(79); _ke_putc(83);
    _ke_putc(46); _ke_putc(83); _ke_putc(89); _ke_putc(83);
    _ke_putc(13); _ke_putc(10);
    // Content: "HicOS v6.0 kernel\n" (18 bytes)
    _ke_blk_zero_buf();
    mem_write_u8(data, 72); mem_write_u8(data+1, 105);
    mem_write_u8(data+2, 99); mem_write_u8(data+3, 79);
    mem_write_u8(data+4, 83); mem_write_u8(data+5, 32);
    mem_write_u8(data+6, 118); mem_write_u8(data+7, 54);
    mem_write_u8(data+8, 46); mem_write_u8(data+9, 48);
    mem_write_u8(data+10, 32);
    mem_write_u8(data+11, 107); mem_write_u8(data+12, 101);
    mem_write_u8(data+13, 114); mem_write_u8(data+14, 110);
    mem_write_u8(data+15, 101); mem_write_u8(data+16, 108);
    mem_write_u8(data+17, 10);
    _ke_virtio_blk_write(164);  // cluster 2 → sector 164

    // Update FAT: cluster 2 = 0xFFFF (end of chain)
    _ke_virtio_blk_read(4);
    _ke_mem_w16(data + 4, 65535);   // FAT entry 2 at byte offset 4
    _ke_virtio_blk_write(4);        // FAT1
    _ke_virtio_blk_write(68);       // FAT2

    // Create directory entry at root dir sector 132
    _ke_virtio_blk_read(132);
    let off = data;
    // "HICOS   SYS" (8.3 format)
    mem_write_u8(off, 72); mem_write_u8(off+1, 73);
    mem_write_u8(off+2, 67); mem_write_u8(off+3, 79);
    mem_write_u8(off+4, 83); mem_write_u8(off+5, 32);
    mem_write_u8(off+6, 32); mem_write_u8(off+7, 32);
    mem_write_u8(off+8, 83); mem_write_u8(off+9, 89);
    mem_write_u8(off+10, 83);
    mem_write_u8(off+11, 32);  // attr = 0x20 archive
    let mut i = 12;
    while i < 26 { mem_write_u8(off + i, 0); i = i + 1; }
    _ke_mem_w16(off + 26, 2);   // first cluster = 2
    _ke_mem_w32(off + 28, 18);  // file size = 18 bytes
    _ke_virtio_blk_write(132);

    // [5/7] Write BOOT.CFG — cluster 3, dir entry 1
    _ke_install_step(5);
    // "BOOT.CFG\r\n"
    _ke_putc(66); _ke_putc(79); _ke_putc(79); _ke_putc(84);
    _ke_putc(46); _ke_putc(67); _ke_putc(70); _ke_putc(71);
    _ke_putc(13); _ke_putc(10);
    // Content: "boot=hicos\nmode=text\n" (21 bytes)
    _ke_blk_zero_buf();
    // "boot=hicos\n"
    mem_write_u8(data, 98); mem_write_u8(data+1, 111);
    mem_write_u8(data+2, 111); mem_write_u8(data+3, 116);
    mem_write_u8(data+4, 61);  // '='
    mem_write_u8(data+5, 104); mem_write_u8(data+6, 105);
    mem_write_u8(data+7, 99); mem_write_u8(data+8, 111);
    mem_write_u8(data+9, 115); mem_write_u8(data+10, 10);
    // "mode=text\n"
    mem_write_u8(data+11, 109); mem_write_u8(data+12, 111);
    mem_write_u8(data+13, 100); mem_write_u8(data+14, 101);
    mem_write_u8(data+15, 61);
    mem_write_u8(data+16, 116); mem_write_u8(data+17, 101);
    mem_write_u8(data+18, 120); mem_write_u8(data+19, 116);
    mem_write_u8(data+20, 10);
    _ke_virtio_blk_write(168);  // cluster 3 → sector 168

    // FAT: cluster 3 = 0xFFFF
    _ke_virtio_blk_read(4);
    _ke_mem_w16(data + 6, 65535);   // FAT entry 3 at byte offset 6
    _ke_virtio_blk_write(4);
    _ke_virtio_blk_write(68);

    // Dir entry 1 for BOOT.CFG
    _ke_virtio_blk_read(132);
    let off2 = data + 32;  // second entry
    // "BOOT    CFG"
    mem_write_u8(off2, 66); mem_write_u8(off2+1, 79);
    mem_write_u8(off2+2, 79); mem_write_u8(off2+3, 84);
    mem_write_u8(off2+4, 32); mem_write_u8(off2+5, 32);
    mem_write_u8(off2+6, 32); mem_write_u8(off2+7, 32);
    mem_write_u8(off2+8, 67); mem_write_u8(off2+9, 70);
    mem_write_u8(off2+10, 71);
    mem_write_u8(off2+11, 32); // attr = 0x20
    i = 12;
    while i < 26 { mem_write_u8(off2 + i, 0); i = i + 1; }
    _ke_mem_w16(off2 + 26, 3);   // cluster 3
    _ke_mem_w32(off2 + 28, 21);  // size 21
    _ke_virtio_blk_write(132);

    // [6/7] Verify MBR
    _ke_install_step(6);
    _ke_virtio_blk_read(0);
    let s510 = mem_read_u8(data + 510);
    let s511 = mem_read_u8(data + 511);
    if s510 == 85 {
        if s511 == 170 {
            // "MBR 55AA OK\r\n"
            _ke_putc(77); _ke_putc(66); _ke_putc(82); _ke_putc(32);
            _ke_putc(53); _ke_putc(53); _ke_putc(65); _ke_putc(65);
            _ke_putc(32); _ke_putc(79); _ke_putc(75);
            _ke_putc(13); _ke_putc(10);
        }
    }

    // [7/7] Done
    _ke_install_step(7);
    // "Done!\r\n"
    _ke_putc(68); _ke_putc(111); _ke_putc(110); _ke_putc(101); _ke_putc(33);
    _ke_putc(13); _ke_putc(10);
    // "=== Installation Complete! ===\r\n"
    _ke_putc(61); _ke_putc(61); _ke_putc(61); _ke_putc(32);
    _ke_putc(73); _ke_putc(110); _ke_putc(115); _ke_putc(116);
    _ke_putc(97); _ke_putc(108); _ke_putc(108); _ke_putc(32);
    _ke_putc(79); _ke_putc(75); _ke_putc(33);
    _ke_putc(32); _ke_putc(61); _ke_putc(61); _ke_putc(61);
    _ke_putc(13); _ke_putc(10);
    return 0;
}

// === Iteration 25: Scancode → ASCII + Interactive Shell ===

// PS/2 set 1 scancode to ASCII (lowercase, common keys only)
fn _ke_sc2ascii(sc) {
    if sc == 2 { return 49; }    // '1'
    if sc == 3 { return 50; }    // '2'
    if sc == 4 { return 51; }    // '3'
    if sc == 5 { return 52; }    // '4'
    if sc == 6 { return 53; }    // '5'
    if sc == 7 { return 54; }    // '6'
    if sc == 8 { return 55; }    // '7'
    if sc == 9 { return 56; }    // '8'
    if sc == 10 { return 57; }   // '9'
    if sc == 11 { return 48; }   // '0'
    if sc == 16 { return 113; }  // 'q'
    if sc == 17 { return 119; }  // 'w'
    if sc == 18 { return 101; }  // 'e'
    if sc == 19 { return 114; }  // 'r'
    if sc == 20 { return 116; }  // 't'
    if sc == 21 { return 121; }  // 'y'
    if sc == 22 { return 117; }  // 'u'
    if sc == 23 { return 105; }  // 'i'
    if sc == 24 { return 111; }  // 'o'
    if sc == 25 { return 112; }  // 'p'
    if sc == 30 { return 97; }   // 'a'
    if sc == 31 { return 115; }  // 's'
    if sc == 32 { return 100; }  // 'd'
    if sc == 33 { return 102; }  // 'f'
    if sc == 34 { return 103; }  // 'g'
    if sc == 35 { return 104; }  // 'h'
    if sc == 36 { return 106; }  // 'j'
    if sc == 37 { return 107; }  // 'k'
    if sc == 38 { return 108; }  // 'l'
    if sc == 44 { return 122; }  // 'z'
    if sc == 45 { return 120; }  // 'x'
    if sc == 46 { return 99; }   // 'c'
    if sc == 47 { return 118; }  // 'v'
    if sc == 48 { return 98; }   // 'b'
    if sc == 49 { return 110; }  // 'n'
    if sc == 50 { return 109; }  // 'm'
    if sc == 57 { return 32; }   // space
    if sc == 28 { return 10; }   // Enter -> LF
    if sc == 14 { return 8; }    // Backspace -> BS
    if sc == 12 { return 45; }   // '-'
    if sc == 13 { return 61; }   // '='
    if sc == 39 { return 59; }   // ';'
    if sc == 40 { return 39; }   // '''
    if sc == 51 { return 44; }   // ','
    if sc == 52 { return 46; }   // '.'
    if sc == 53 { return 47; }   // '/'
    if sc == 43 { return 124; }  // '|' (backslash key, used as pipe)
    if sc == 26 { return 91; }   // '['
    if sc == 27 { return 93; }   // ']'
    if sc == 41 { return 96; }   // '`'
    return 0;
}

// === Iteration 48: SHA-256 Cryptographic Hash ===
//
// Memory layout:
//   0x940000: K[0..63] round constants (64 × 4 = 256 bytes)
//   0x940100: W[0..63] message schedule (64 × 4 = 256 bytes)
//   0x940200: padded message buffer (128 bytes max)
//   0x940280: hash state a..h (8 × 4 = 32 bytes)
//   0x9402A0: hash output (32 bytes)

// Read 32-bit big-endian from memory
fn _ke_mem_r32be(addr) {
    let b0 = mem_read_u8(addr);
    let b1 = mem_read_u8(addr + 1);
    let b2 = mem_read_u8(addr + 2);
    let b3 = mem_read_u8(addr + 3);
    return b0 * 16777216 + b1 * 65536 + b2 * 256 + b3;
}

// Write 32-bit big-endian to memory
fn _ke_mem_w32be(addr, val) {
    let v = val % 4294967296;
    mem_write_u8(addr, (v / 16777216) % 256);
    mem_write_u8(addr + 1, (v / 65536) % 256);
    mem_write_u8(addr + 2, (v / 256) % 256);
    mem_write_u8(addr + 3, v % 256);
    return 0;
}

// Read 32-bit LE from memory (generic)
fn _ke_mem_r32(addr) {
    let b0 = mem_read_u8(addr);
    let b1 = mem_read_u8(addr + 1);
    let b2 = mem_read_u8(addr + 2);
    let b3 = mem_read_u8(addr + 3);
    return b3 * 16777216 + b2 * 65536 + b1 * 256 + b0;
}

// Print 8-bit hex value (2 digits)
fn _ke_put_hex8(val) {
    _ke_put_hex4(val / 16);
    _ke_put_hex4(val);
    return 0;
}

// Print 32-bit hex value (8 digits)
fn _ke_put_hex32(val) {
    _ke_put_hex8((val / 16777216) % 256);
    _ke_put_hex8((val / 65536) % 256);
    _ke_put_hex8((val / 256) % 256);
    _ke_put_hex8(val % 256);
    return 0;
}

// 32-bit right rotate
fn _ke_sha256_rotr(val, bits) {
    let mask = 4294967295;
    let v = val % 4294967296;
    // v >> bits
    let mut divisor = 1;
    let mut i = 0;
    while i < bits { divisor = divisor * 2; i = i + 1; }
    let right = v / divisor;
    // v << (32 - bits)
    let mut left_mul = 1;
    i = 0;
    while i < 32 - bits { left_mul = left_mul * 2; i = i + 1; }
    let left = (v % divisor) * left_mul;
    return (right + left) % 4294967296;
}

// 32-bit right shift
fn _ke_sha256_shr(val, bits) {
    let v = val % 4294967296;
    let mut divisor = 1;
    let mut i = 0;
    while i < bits { divisor = divisor * 2; i = i + 1; }
    return v / divisor;
}

// Initialize SHA-256 K constants at 0x940000 (64 × 4 bytes, LE)
fn _ke_sha256_init_k() {
    let base = 9699328; // 0x940000
    // K[0..63] — SHA-256 round constants (first 32 bits of fractional parts of cube roots of first 64 primes)
    _ke_mem_w32(base +   0, 1116352408);  _ke_mem_w32(base +   4, 1899447441);
    _ke_mem_w32(base +   8, 3049323471);  _ke_mem_w32(base +  12, 3921009573);
    _ke_mem_w32(base +  16,  961987163);  _ke_mem_w32(base +  20, 1508970993);
    _ke_mem_w32(base +  24, 2453635748);  _ke_mem_w32(base +  28, 2870763221);
    _ke_mem_w32(base +  32, 3624381080);  _ke_mem_w32(base +  36,  310598401);
    _ke_mem_w32(base +  40,  607225278);  _ke_mem_w32(base +  44, 1426881987);
    _ke_mem_w32(base +  48, 1925078388);  _ke_mem_w32(base +  52, 2162078206);
    _ke_mem_w32(base +  56, 2614888103);  _ke_mem_w32(base +  60, 3248222580);
    _ke_mem_w32(base +  64, 3835390401);  _ke_mem_w32(base +  68, 4022224774);
    _ke_mem_w32(base +  72,  264347078);  _ke_mem_w32(base +  76,  604807628);
    _ke_mem_w32(base +  80,  770255983);  _ke_mem_w32(base +  84, 1249150122);
    _ke_mem_w32(base +  88, 1555081692);  _ke_mem_w32(base +  92, 1996064986);
    _ke_mem_w32(base +  96, 2554220882);  _ke_mem_w32(base + 100, 2821834349);
    _ke_mem_w32(base + 104, 2952996808);  _ke_mem_w32(base + 108, 3210313671);
    _ke_mem_w32(base + 112, 3336571891);  _ke_mem_w32(base + 116, 3584528711);
    _ke_mem_w32(base + 120,  113926993);  _ke_mem_w32(base + 124,  338241895);
    _ke_mem_w32(base + 128,  666307205);  _ke_mem_w32(base + 132,  773529912);
    _ke_mem_w32(base + 136, 1294757372);  _ke_mem_w32(base + 140, 1396182291);
    _ke_mem_w32(base + 144, 1695183700);  _ke_mem_w32(base + 148, 1986661051);
    _ke_mem_w32(base + 152, 2177026350);  _ke_mem_w32(base + 156, 2456956037);
    _ke_mem_w32(base + 160, 2730485921);  _ke_mem_w32(base + 164, 2820302411);
    _ke_mem_w32(base + 168, 3259730800);  _ke_mem_w32(base + 172, 3345764771);
    _ke_mem_w32(base + 176, 3516065817);  _ke_mem_w32(base + 180, 3600352804);
    _ke_mem_w32(base + 184, 4094571909);  _ke_mem_w32(base + 188,  275423344);
    _ke_mem_w32(base + 192,  430227734);  _ke_mem_w32(base + 196,  506948616);
    _ke_mem_w32(base + 200,  659060556);  _ke_mem_w32(base + 204,  883997877);
    _ke_mem_w32(base + 208,  958139571);  _ke_mem_w32(base + 212, 1322822218);
    _ke_mem_w32(base + 216, 1537002063);  _ke_mem_w32(base + 220, 1747873779);
    _ke_mem_w32(base + 224, 1955562222);  _ke_mem_w32(base + 228, 2024104815);
    _ke_mem_w32(base + 232, 2227730452);  _ke_mem_w32(base + 236, 2361852424);
    _ke_mem_w32(base + 240, 2428436474);  _ke_mem_w32(base + 244, 2756734187);
    _ke_mem_w32(base + 248, 3204031479);  _ke_mem_w32(base + 252, 3329325298);
    return 0;
}

// SHA-256 hash: data at data_addr, length data_len bytes
// Result: 32 bytes at 0x9402A0 (8 × 32-bit words, big-endian)
fn _ke_sha256_hash(data_addr, data_len) {
    let k_base = 9699328;       // 0x940000: K constants
    let w_base = 9699584;       // 0x940100: W schedule
    let pad_base = 9699840;     // 0x940200: padded message
    let state_base = 9699968;   // 0x940280: hash state
    let out_base = 9700000;     // 0x9402A0: hash output

    // === Step 1: Pad message ===
    // Copy data to pad buffer
    let mut pi = 0;
    while pi < data_len {
        mem_write_u8(pad_base + pi, mem_read_u8(data_addr + pi));
        pi = pi + 1;
    }
    // Append 0x80
    mem_write_u8(pad_base + pi, 128);
    pi = pi + 1;
    // Pad with zeros to 56 mod 64
    while pi % 64 != 56 {
        mem_write_u8(pad_base + pi, 0);
        pi = pi + 1;
    }
    // Append length in bits as 64-bit big-endian
    let bit_len = data_len * 8;
    mem_write_u8(pad_base + pi, 0); pi = pi + 1;
    mem_write_u8(pad_base + pi, 0); pi = pi + 1;
    mem_write_u8(pad_base + pi, 0); pi = pi + 1;
    mem_write_u8(pad_base + pi, 0); pi = pi + 1;
    mem_write_u8(pad_base + pi, (bit_len / 16777216) % 256); pi = pi + 1;
    mem_write_u8(pad_base + pi, (bit_len / 65536) % 256); pi = pi + 1;
    mem_write_u8(pad_base + pi, (bit_len / 256) % 256); pi = pi + 1;
    mem_write_u8(pad_base + pi, bit_len % 256); pi = pi + 1;
    let pad_len = pi;

    // === Step 2: Initialize hash values (H0..H7) ===
    _ke_mem_w32(state_base +  0, 1779033703);  // H0 = 0x6a09e667
    _ke_mem_w32(state_base +  4, 3144134277);  // H1 = 0xbb67ae85
    _ke_mem_w32(state_base +  8, 1013904242);  // H2 = 0x3c6ef372
    _ke_mem_w32(state_base + 12, 2773480762);  // H3 = 0xa54ff53a
    _ke_mem_w32(state_base + 16, 1359893119);  // H4 = 0x510e527f
    _ke_mem_w32(state_base + 20, 2600822924);  // H5 = 0x9b05688c
    _ke_mem_w32(state_base + 24,  528734635);  // H6 = 0x1f83d9ab
    _ke_mem_w32(state_base + 28, 1541459225);  // H7 = 0x5be0cd19

    // === Step 3: Process each 64-byte block ===
    let num_blocks = pad_len / 64;
    let mut blk = 0;
    while blk < num_blocks {
        let boff = blk * 64;

        // Parse 16 words from block (big-endian → native u32)
        let mut wi = 0;
        while wi < 16 {
            let addr = pad_base + boff + wi * 4;
            let word = _ke_mem_r32be(addr);
            _ke_mem_w32(w_base + wi * 4, word);
            wi = wi + 1;
        }

        // Extend to 64 words: W[i] = sig1(W[i-2]) + W[i-7] + sig0(W[i-15]) + W[i-16]
        wi = 16;
        while wi < 64 {
            let w2  = _ke_mem_r32(w_base + (wi - 2) * 4);
            let w7  = _ke_mem_r32(w_base + (wi - 7) * 4);
            let w15 = _ke_mem_r32(w_base + (wi - 15) * 4);
            let w16 = _ke_mem_r32(w_base + (wi - 16) * 4);

            // sig0 = ROTR(w15, 7) XOR ROTR(w15, 18) XOR SHR(w15, 3)
            let r7  = _ke_sha256_rotr(w15, 7);
            let r18 = _ke_sha256_rotr(w15, 18);
            let s3  = _ke_sha256_shr(w15, 3);
            // XOR via: a^b = (a+b) - 2*(a AND b)  — but we don't have AND
            // Use bit-by-bit XOR through arithmetic:
            // XOR3(a,b,c) = a+b+c - 2*(pairs) ... too complex
            // Alternative: compute XOR bit-by-bit using div/mod
            let s0 = _ke_xor3(r7, r18, s3);

            // sig1 = ROTR(w2, 17) XOR ROTR(w2, 19) XOR SHR(w2, 10)
            let r17 = _ke_sha256_rotr(w2, 17);
            let r19 = _ke_sha256_rotr(w2, 19);
            let s10 = _ke_sha256_shr(w2, 10);
            let s1 = _ke_xor3(r17, r19, s10);

            let wval = (s1 + w7 + s0 + w16) % 4294967296;
            _ke_mem_w32(w_base + wi * 4, wval);
            wi = wi + 1;
        }

        // Initialize working variables
        let mut a = _ke_mem_r32(state_base +  0);
        let mut b = _ke_mem_r32(state_base +  4);
        let mut c = _ke_mem_r32(state_base +  8);
        let mut d = _ke_mem_r32(state_base + 12);
        let mut e = _ke_mem_r32(state_base + 16);
        let mut f = _ke_mem_r32(state_base + 20);
        let mut g = _ke_mem_r32(state_base + 24);
        let mut h = _ke_mem_r32(state_base + 28);

        // 64 rounds
        let mut ri = 0;
        while ri < 64 {
            let ki = _ke_mem_r32(k_base + ri * 4);
            let wi_val = _ke_mem_r32(w_base + ri * 4);

            // Sigma1 = ROTR(e,6) XOR ROTR(e,11) XOR ROTR(e,25)
            let Sigma1 = _ke_xor3(_ke_sha256_rotr(e, 6), _ke_sha256_rotr(e, 11), _ke_sha256_rotr(e, 25));

            // Ch = (e AND f) XOR ((NOT e) AND g)
            let ch = _ke_ch(e, f, g);

            let temp1 = (h + Sigma1 + ch + ki + wi_val) % 4294967296;

            // Sigma0 = ROTR(a,2) XOR ROTR(a,13) XOR ROTR(a,22)
            let Sigma0 = _ke_xor3(_ke_sha256_rotr(a, 2), _ke_sha256_rotr(a, 13), _ke_sha256_rotr(a, 22));

            // Maj = (a AND b) XOR (a AND c) XOR (b AND c)
            let maj = _ke_maj(a, b, c);

            let temp2 = (Sigma0 + maj) % 4294967296;

            h = g;
            g = f;
            f = e;
            e = (d + temp1) % 4294967296;
            d = c;
            c = b;
            b = a;
            a = (temp1 + temp2) % 4294967296;

            ri = ri + 1;
        }

        // Add to hash state
        _ke_mem_w32(state_base +  0, (a + _ke_mem_r32(state_base +  0)) % 4294967296);
        _ke_mem_w32(state_base +  4, (b + _ke_mem_r32(state_base +  4)) % 4294967296);
        _ke_mem_w32(state_base +  8, (c + _ke_mem_r32(state_base +  8)) % 4294967296);
        _ke_mem_w32(state_base + 12, (d + _ke_mem_r32(state_base + 12)) % 4294967296);
        _ke_mem_w32(state_base + 16, (e + _ke_mem_r32(state_base + 16)) % 4294967296);
        _ke_mem_w32(state_base + 20, (f + _ke_mem_r32(state_base + 20)) % 4294967296);
        _ke_mem_w32(state_base + 24, (g + _ke_mem_r32(state_base + 24)) % 4294967296);
        _ke_mem_w32(state_base + 28, (h + _ke_mem_r32(state_base + 28)) % 4294967296);

        blk = blk + 1;
    }

    // === Step 4: Output hash (32 bytes, big-endian) at out_base ===
    let mut oi = 0;
    while oi < 8 {
        let hval = _ke_mem_r32(state_base + oi * 4);
        _ke_mem_w32be(out_base + oi * 4, hval);
        oi = oi + 1;
    }

    return 0;
}

// Bitwise XOR of two 32-bit values (bit-by-bit using div/mod)
fn _ke_xor2(a, b) {
    let va = a % 4294967296;
    let vb = b % 4294967296;
    let mut result = 0;
    let mut bit = 1;
    let mut i = 0;
    while i < 32 {
        let ba = (va / bit) % 2;
        let bb = (vb / bit) % 2;
        if ba != bb {
            result = result + bit;
        }
        bit = bit * 2;
        i = i + 1;
    }
    return result;
}

// Bitwise XOR of three 32-bit values
fn _ke_xor3(a, b, c) {
    return _ke_xor2(_ke_xor2(a, b), c);
}

// Bitwise AND of two 32-bit values
fn _ke_and32(a, b) {
    let va = a % 4294967296;
    let vb = b % 4294967296;
    let mut result = 0;
    let mut bit = 1;
    let mut i = 0;
    while i < 32 {
        let ba = (va / bit) % 2;
        let bb = (vb / bit) % 2;
        if ba == 1 { if bb == 1 {
            result = result + bit;
        } }
        bit = bit * 2;
        i = i + 1;
    }
    return result;
}

// Bitwise NOT of a 32-bit value
fn _ke_not32(a) {
    return _ke_xor2(a, 4294967295);
}

// Ch(e, f, g) = (e AND f) XOR ((NOT e) AND g)
fn _ke_ch(e, f, g) {
    let ef = _ke_and32(e, f);
    let neg = _ke_not32(e);
    let ng = _ke_and32(neg, g);
    return _ke_xor2(ef, ng);
}

// Maj(a, b, c) = (a AND b) XOR (a AND c) XOR (b AND c)
fn _ke_maj(a, b, c) {
    let ab = _ke_and32(a, b);
    let ac = _ke_and32(a, c);
    let bc = _ke_and32(b, c);
    return _ke_xor3(ab, ac, bc);
}

// Command: sha256 <text> — compute SHA-256 hash and print as hex
fn _ke_cmd_sha256(buf_addr, buf_len) {
    // Parse: "sha256 <text>" — text starts at offset 7
    let text_start = buf_addr + 7;
    let text_len = buf_len - 7;

    if text_len <= 0 {
        // "Usage: sha256 <text>\r\n"
        _ke_putc(85); _ke_putc(115); _ke_putc(97); _ke_putc(103); _ke_putc(101);
        _ke_putc(58); _ke_putc(32);
        _ke_putc(115); _ke_putc(104); _ke_putc(97); _ke_putc(50); _ke_putc(53); _ke_putc(54);
        _ke_putc(32); _ke_putc(60); _ke_putc(116); _ke_putc(101); _ke_putc(120); _ke_putc(116); _ke_putc(62);
        _ke_putc(13); _ke_putc(10);
        return 0;
    }

    // Initialize K constants
    _ke_sha256_init_k();

    // Compute hash
    _ke_sha256_hash(text_start, text_len);

    // Print "SHA256: " prefix
    _ke_putc(83); _ke_putc(72); _ke_putc(65); _ke_putc(50);
    _ke_putc(53); _ke_putc(54); _ke_putc(58); _ke_putc(32);

    // Print 32 bytes as hex (64 hex chars)
    let out_base = 9700000; // 0x9402A0
    let mut i = 0;
    while i < 32 {
        let byte = mem_read_u8(out_base + i);
        _ke_put_hex8(byte);
        i = i + 1;
    }
    _ke_putc(13); _ke_putc(10);
    return 0;
}

// === Iteration 49: HMAC-SHA-256 + HKDF ===
//
// HMAC(K, m) = SHA-256((K' XOR opad) || SHA-256((K' XOR ipad) || m))
//   K' = K if len(K) <= 64, else SHA-256(K); padded to 64 bytes with zeros
//   ipad = 0x36 repeated 64 times
//   opad = 0x5c repeated 64 times
//
// HKDF-Extract(salt, IKM) = HMAC-SHA-256(salt, IKM)
// HKDF-Expand(PRK, info, L) = T(1)||T(2)||... truncated to L bytes
//   T(i) = HMAC-SHA-256(PRK, T(i-1) || info || i)
//
// Memory layout (0x940300-0x94053F):
//   0x940300: K' padded key (64 bytes)
//   0x940340: inner input buffer (128 bytes: K'^ipad || msg)
//   0x9403C0: outer input buffer (128 bytes: K'^opad || inner_hash)
//   0x940440: HMAC result (32 bytes)
//   0x940460: HKDF PRK (32 bytes)
//   0x940480: HKDF T(i) (32 bytes)
//   0x9404A0: HKDF concat buffer (128 bytes)
//   0x940520: HKDF OKM output (64 bytes)

// HMAC-SHA-256: compute HMAC with given key and message
// Result: 32 bytes at 0x940440
fn _ke_hmac_sha256(key_addr, key_len, msg_addr, msg_len) {
    let kbuf = 9700096;     // 0x940300: padded key (64 bytes)
    let ibuf = 9700160;     // 0x940340: inner input
    let obuf = 9700288;     // 0x9403C0: outer input
    let hmac_out = 9700416; // 0x940440: HMAC result
    let sha_out = 9700000;  // 0x9402A0: SHA-256 output

    // Step 1: Prepare K' (key padded to 64 bytes)
    // Clear kbuf to zeros
    let mut ki = 0;
    while ki < 64 {
        mem_write_u8(kbuf + ki, 0);
        ki = ki + 1;
    }

    if key_len > 64 {
        // Key too long: hash it first
        _ke_sha256_hash(key_addr, key_len);
        // Copy 32-byte hash to kbuf
        ki = 0;
        while ki < 32 {
            mem_write_u8(kbuf + ki, mem_read_u8(sha_out + ki));
            ki = ki + 1;
        }
    } else {
        // Copy key to kbuf (rest already zeroed)
        ki = 0;
        while ki < key_len {
            mem_write_u8(kbuf + ki, mem_read_u8(key_addr + ki));
            ki = ki + 1;
        }
    }

    // Step 2: Build inner input = (K' XOR ipad) || message
    ki = 0;
    while ki < 64 {
        let kb = mem_read_u8(kbuf + ki);
        // XOR with ipad (0x36 = 54)
        let xb = _ke_xor_byte(kb, 54);
        mem_write_u8(ibuf + ki, xb);
        ki = ki + 1;
    }
    // Append message
    ki = 0;
    while ki < msg_len {
        mem_write_u8(ibuf + 64 + ki, mem_read_u8(msg_addr + ki));
        ki = ki + 1;
    }

    // Step 3: inner_hash = SHA-256(inner_input)
    _ke_sha256_hash(ibuf, 64 + msg_len);

    // Copy inner hash from sha_out to temp area (ibuf reusable)
    // We'll store it at ibuf temporarily (overwriting, that's fine)
    ki = 0;
    while ki < 32 {
        mem_write_u8(ibuf + ki, mem_read_u8(sha_out + ki));
        ki = ki + 1;
    }

    // Step 4: Build outer input = (K' XOR opad) || inner_hash
    ki = 0;
    while ki < 64 {
        let kb = mem_read_u8(kbuf + ki);
        // XOR with opad (0x5c = 92)
        let xb = _ke_xor_byte(kb, 92);
        mem_write_u8(obuf + ki, xb);
        ki = ki + 1;
    }
    // Append inner hash (32 bytes from ibuf temp)
    ki = 0;
    while ki < 32 {
        mem_write_u8(obuf + 64 + ki, mem_read_u8(ibuf + ki));
        ki = ki + 1;
    }

    // Step 5: result = SHA-256(outer_input)
    _ke_sha256_hash(obuf, 96);

    // Copy result to HMAC output
    ki = 0;
    while ki < 32 {
        mem_write_u8(hmac_out + ki, mem_read_u8(sha_out + ki));
        ki = ki + 1;
    }

    return 0;
}

// XOR two bytes (0-255) using arithmetic
fn _ke_xor_byte(a, b) {
    let mut result = 0;
    let mut bit = 1;
    let mut i = 0;
    while i < 8 {
        let ba = (a / bit) % 2;
        let bb = (b / bit) % 2;
        if ba != bb {
            result = result + bit;
        }
        bit = bit * 2;
        i = i + 1;
    }
    return result;
}

// HKDF-Extract (RFC 5869): PRK = HMAC-SHA-256(salt, IKM)
// Result: 32 bytes at 0x940460
fn _ke_hkdf_extract(salt_addr, salt_len, ikm_addr, ikm_len) {
    let prk_out = 9700448; // 0x940460
    let hmac_out = 9700416; // 0x940440

    _ke_hmac_sha256(salt_addr, salt_len, ikm_addr, ikm_len);

    // Copy HMAC result to PRK output
    let mut i = 0;
    while i < 32 {
        mem_write_u8(prk_out + i, mem_read_u8(hmac_out + i));
        i = i + 1;
    }
    return 0;
}

// HKDF-Expand (RFC 5869): OKM = T(1) || T(2) || ... truncated to out_len
// T(i) = HMAC-SHA-256(PRK, T(i-1) || info || i)
// PRK at prk_addr (32 bytes), info at info_addr, output at 0x940520
// Max out_len = 64 (2 iterations)
fn _ke_hkdf_expand(prk_addr, info_addr, info_len, out_len) {
    let t_buf = 9700480;     // 0x940480: T(i) result (32 bytes)
    let cat_buf = 9700512;   // 0x9404A0: concat buffer
    let okm_out = 9700640;   // 0x940520: OKM output
    let hmac_out = 9700416;  // 0x940440: HMAC result

    let mut t_len = 0;  // T(0) = empty
    let mut done = 0;
    let mut iter = 1;

    while done < out_len {
        // Build concat: T(i-1) || info || iter
        let mut ci = 0;

        // Copy T(i-1) if not first iteration
        if iter > 1 {
            let mut ti = 0;
            while ti < 32 {
                mem_write_u8(cat_buf + ci, mem_read_u8(t_buf + ti));
                ci = ci + 1;
                ti = ti + 1;
            }
        }

        // Append info
        let mut ii = 0;
        while ii < info_len {
            mem_write_u8(cat_buf + ci, mem_read_u8(info_addr + ii));
            ci = ci + 1;
            ii = ii + 1;
        }

        // Append iteration counter (1 byte)
        mem_write_u8(cat_buf + ci, iter);
        ci = ci + 1;

        // T(i) = HMAC-SHA-256(PRK, concat)
        _ke_hmac_sha256(prk_addr, 32, cat_buf, ci);

        // Copy HMAC result to T buffer
        let mut ti = 0;
        while ti < 32 {
            mem_write_u8(t_buf + ti, mem_read_u8(hmac_out + ti));
            ti = ti + 1;
        }

        // Copy T(i) to OKM output
        ti = 0;
        while ti < 32 {
            if done + ti < out_len {
                mem_write_u8(okm_out + done + ti, mem_read_u8(t_buf + ti));
            }
            ti = ti + 1;
        }

        done = done + 32;
        iter = iter + 1;

        // Safety: max 2 iterations (64 bytes)
        if iter > 8 { done = out_len; }
    }

    return 0;
}

// Command: hmac <text> — compute HMAC-SHA-256 with test key and print hex
// Uses fixed test key "key" (3 bytes) for demonstration
fn _ke_cmd_hmac(buf_addr, buf_len) {
    // Parse: "hmac <text>" — text starts at offset 5
    let text_start = buf_addr + 5;
    let text_len = buf_len - 5;

    if text_len <= 0 {
        // "Usage: hmac <text>\r\n"
        _ke_putc(85); _ke_putc(115); _ke_putc(97); _ke_putc(103); _ke_putc(101);
        _ke_putc(58); _ke_putc(32);
        _ke_putc(104); _ke_putc(109); _ke_putc(97); _ke_putc(99);
        _ke_putc(32); _ke_putc(60); _ke_putc(116); _ke_putc(101); _ke_putc(120); _ke_putc(116); _ke_putc(62);
        _ke_putc(13); _ke_putc(10);
        return 0;
    }

    // Fixed test key: store "key" at a temp location (0x9404A0)
    let key_tmp = 9700512; // 0x9404A0: reuse concat buf as temp key
    mem_write_u8(key_tmp, 107);     // 'k'
    mem_write_u8(key_tmp + 1, 101); // 'e'
    mem_write_u8(key_tmp + 2, 121); // 'y'

    // Initialize K constants (needed by SHA-256)
    _ke_sha256_init_k();

    // Compute HMAC-SHA-256("key", text)
    _ke_hmac_sha256(key_tmp, 3, text_start, text_len);

    // Print "HMAC: " prefix
    _ke_putc(72); _ke_putc(77); _ke_putc(65); _ke_putc(67);
    _ke_putc(58); _ke_putc(32);

    // Print 32 bytes as hex from HMAC output (0x940440)
    let hmac_out = 9700416; // 0x940440
    let mut i = 0;
    while i < 32 {
        let byte = mem_read_u8(hmac_out + i);
        _ke_put_hex8(byte);
        i = i + 1;
    }
    _ke_putc(13); _ke_putc(10);
    return 0;
}

// Command: hkdf — run HKDF extract+expand demo and print OKM
fn _ke_cmd_hkdf() {
    // Initialize K constants
    _ke_sha256_init_k();

    // Demo: HKDF with salt="salt" (4B), IKM="input" (5B), info="info" (4B), L=32
    let salt_tmp = 9700512; // 0x9404A0: temp
    mem_write_u8(salt_tmp, 115); mem_write_u8(salt_tmp + 1, 97);     // "sa"
    mem_write_u8(salt_tmp + 2, 108); mem_write_u8(salt_tmp + 3, 116); // "lt"

    let ikm_tmp = 9700520;  // salt_tmp + 8
    mem_write_u8(ikm_tmp, 105); mem_write_u8(ikm_tmp + 1, 110);     // "in"
    mem_write_u8(ikm_tmp + 2, 112); mem_write_u8(ikm_tmp + 3, 117); // "pu"
    mem_write_u8(ikm_tmp + 4, 116);                                   // "t"

    let info_tmp = 9700528; // ikm_tmp + 8
    mem_write_u8(info_tmp, 105); mem_write_u8(info_tmp + 1, 110);     // "in"
    mem_write_u8(info_tmp + 2, 102); mem_write_u8(info_tmp + 3, 111); // "fo"

    // Extract: PRK = HMAC("salt", "input")
    _ke_hkdf_extract(salt_tmp, 4, ikm_tmp, 5);

    // Expand: OKM = HKDF-Expand(PRK, "info", 32)
    let prk_out = 9700448; // 0x940460
    _ke_hkdf_expand(prk_out, info_tmp, 4, 32);

    // Print "HKDF: " prefix
    _ke_putc(72); _ke_putc(75); _ke_putc(68); _ke_putc(70);
    _ke_putc(58); _ke_putc(32);

    // Print 32 bytes as hex from OKM output (0x940520)
    let okm_out = 9700640; // 0x940520
    let mut i = 0;
    while i < 32 {
        let byte = mem_read_u8(okm_out + i);
        _ke_put_hex8(byte);
        i = i + 1;
    }
    _ke_putc(13); _ke_putc(10);
    return 0;
}

// === Iteration 50: AES-128 Block Cipher ===
//
// Memory layout (0x950000-0x9503FF):
//   0x950000: S-Box (256 bytes)
//   0x950100: Inverse S-Box (256 bytes)
//   0x950200: Round keys (176 bytes = 11 × 16)
//   0x9502B0: AES state (16 bytes)
//   0x9502C0: AES temp/output (16 bytes)

// Initialize AES S-Box at 0x950000
