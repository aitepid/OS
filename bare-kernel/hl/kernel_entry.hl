// AES S-Box lookup
fn _ke_aes_sb(val) {
    return mem_read_u8(9764864 + (val % 256)); // 0x950000 + val
}

// AES SubBytes: apply S-Box to all 16 state bytes
fn _ke_aes_sub_bytes(state) {
    let mut i = 0;
    while i < 16 {
        let b = mem_read_u8(state + i);
        mem_write_u8(state + i, _ke_aes_sb(b));
        i = i + 1;
    }
    return 0;
}

// AES ShiftRows: row 0 no shift, row 1 left 1, row 2 left 2, row 3 left 3
// State is column-major: state[row + 4*col]
fn _ke_aes_shift_rows(state) {
    // Row 1: shift left 1
    let t = mem_read_u8(state + 1);
    mem_write_u8(state + 1, mem_read_u8(state + 5));
    mem_write_u8(state + 5, mem_read_u8(state + 9));
    mem_write_u8(state + 9, mem_read_u8(state + 13));
    mem_write_u8(state + 13, t);
    // Row 2: shift left 2
    let t0 = mem_read_u8(state + 2);
    let t1 = mem_read_u8(state + 6);
    mem_write_u8(state + 2, mem_read_u8(state + 10));
    mem_write_u8(state + 6, mem_read_u8(state + 14));
    mem_write_u8(state + 10, t0);
    mem_write_u8(state + 14, t1);
    // Row 3: shift left 3 (= shift right 1)
    let t3 = mem_read_u8(state + 15);
    mem_write_u8(state + 15, mem_read_u8(state + 11));
    mem_write_u8(state + 11, mem_read_u8(state + 7));
    mem_write_u8(state + 7, mem_read_u8(state + 3));
    mem_write_u8(state + 3, t3);
    return 0;
}

// GF(2^8) multiply by 2 (xtime)
fn _ke_aes_xtime(a) {
    let v = a % 256;
    let shifted = (v * 2) % 256;
    if v >= 128 {
        return _ke_xor_byte(shifted, 27); // XOR with 0x1B (irreducible poly)
    }
    return shifted;
}

// GF(2^8) multiply
fn _ke_aes_gmul(a, b) {
    let mut p = 0;
    let mut aa = a % 256;
    let mut bb = b % 256;
    let mut i = 0;
    while i < 8 {
        if bb % 2 == 1 {
            p = _ke_xor_byte(p, aa);
        }
        aa = _ke_aes_xtime(aa);
        bb = bb / 2;
        i = i + 1;
    }
    return p;
}

// AES MixColumns: each column in GF(2^8) matrix multiply
fn _ke_aes_mix_columns(state) {
    let mut c = 0;
    while c < 4 {
        let off = c * 4;
        let s0 = mem_read_u8(state + off);
        let s1 = mem_read_u8(state + off + 1);
        let s2 = mem_read_u8(state + off + 2);
        let s3 = mem_read_u8(state + off + 3);
        // r0 = 2*s0 ^ 3*s1 ^ s2 ^ s3
        let r0 = _ke_xor_byte(_ke_xor_byte(_ke_aes_gmul(2, s0), _ke_aes_gmul(3, s1)), _ke_xor_byte(s2, s3));
        let r1 = _ke_xor_byte(_ke_xor_byte(s0, _ke_aes_gmul(2, s1)), _ke_xor_byte(_ke_aes_gmul(3, s2), s3));
        let r2 = _ke_xor_byte(_ke_xor_byte(s0, s1), _ke_xor_byte(_ke_aes_gmul(2, s2), _ke_aes_gmul(3, s3)));
        let r3 = _ke_xor_byte(_ke_xor_byte(_ke_aes_gmul(3, s0), s1), _ke_xor_byte(s2, _ke_aes_gmul(2, s3)));
        mem_write_u8(state + off, r0);
        mem_write_u8(state + off + 1, r1);
        mem_write_u8(state + off + 2, r2);
        mem_write_u8(state + off + 3, r3);
        c = c + 1;
    }
    return 0;
}

// AES AddRoundKey: XOR state with round key
fn _ke_aes_add_round_key(state, round) {
    let rk_base = 9765376; // 0x950200: round keys
    let rk_off = rk_base + round * 16;
    let mut i = 0;
    while i < 16 {
        let s = mem_read_u8(state + i);
        let k = mem_read_u8(rk_off + i);
        mem_write_u8(state + i, _ke_xor_byte(s, k));
        i = i + 1;
    }
    return 0;
}

// AES-128 KeyExpansion: 16-byte key → 11 round keys (176 bytes) at 0x950200
fn _ke_aes_key_expand(key_addr) {
    let rk = 9765376; // 0x950200
    // Rcon table
    let rc1 = 1; let rc2 = 2; let rc3 = 4; let rc4 = 8; let rc5 = 16;
    let rc6 = 32; let rc7 = 64; let rc8 = 128; let rc9 = 27; let rc10 = 54;

    // Copy first 16 bytes of key as round key 0
    let mut i = 0;
    while i < 16 {
        mem_write_u8(rk + i, mem_read_u8(key_addr + i));
        i = i + 1;
    }

    // Generate round keys 1-10
    let mut rnd = 1;
    while rnd <= 10 {
        let prev = rk + (rnd - 1) * 16;
        let cur = rk + rnd * 16;

        // RotWord + SubWord on last 4 bytes of previous round key
        let t0 = _ke_aes_sb(mem_read_u8(prev + 13));
        let t1 = _ke_aes_sb(mem_read_u8(prev + 14));
        let t2 = _ke_aes_sb(mem_read_u8(prev + 15));
        let t3 = _ke_aes_sb(mem_read_u8(prev + 12));

        // Get Rcon for this round
        let mut rc = 0;
        if rnd == 1 { rc = rc1; }
        if rnd == 2 { rc = rc2; }
        if rnd == 3 { rc = rc3; }
        if rnd == 4 { rc = rc4; }
        if rnd == 5 { rc = rc5; }
        if rnd == 6 { rc = rc6; }
        if rnd == 7 { rc = rc7; }
        if rnd == 8 { rc = rc8; }
        if rnd == 9 { rc = rc9; }
        if rnd == 10 { rc = rc10; }

        // Word 0: prev[0..3] XOR (RotWord+SubWord+Rcon)
        mem_write_u8(cur, _ke_xor_byte(_ke_xor_byte(mem_read_u8(prev), t0), rc));
        mem_write_u8(cur + 1, _ke_xor_byte(mem_read_u8(prev + 1), t1));
        mem_write_u8(cur + 2, _ke_xor_byte(mem_read_u8(prev + 2), t2));
        mem_write_u8(cur + 3, _ke_xor_byte(mem_read_u8(prev + 3), t3));

        // Words 1-3: prev[j] XOR cur[j-4]
        let mut j = 4;
        while j < 16 {
            mem_write_u8(cur + j, _ke_xor_byte(mem_read_u8(prev + j), mem_read_u8(cur + j - 4)));
            j = j + 1;
        }

        rnd = rnd + 1;
    }
    return 0;
}

// AES-128 encrypt one 16-byte block in-place
fn _ke_aes128_encrypt(state) {
    _ke_aes_add_round_key(state, 0);
    let mut r = 1;
    while r <= 9 {
        _ke_aes_sub_bytes(state);
        _ke_aes_shift_rows(state);
        _ke_aes_mix_columns(state);
        _ke_aes_add_round_key(state, r);
        r = r + 1;
    }
    // Final round (no MixColumns)
    _ke_aes_sub_bytes(state);
    _ke_aes_shift_rows(state);
    _ke_aes_add_round_key(state, 10);
    return 0;
}

// Command: aes — encrypt NIST test vector and print ciphertext
fn _ke_cmd_aes() {
    _ke_aes_init_sbox();
    let state = 9765552;  // 0x9502B0
    let key_tmp = 9765568; // 0x9502C0

    // NIST test key: 2b7e151628aed2a6abf7158809cf4f3c
    mem_write_u8(key_tmp, 43); mem_write_u8(key_tmp+1, 126); mem_write_u8(key_tmp+2, 21);
    mem_write_u8(key_tmp+3, 22); mem_write_u8(key_tmp+4, 40); mem_write_u8(key_tmp+5, 174);
    mem_write_u8(key_tmp+6, 210); mem_write_u8(key_tmp+7, 166); mem_write_u8(key_tmp+8, 171);
    mem_write_u8(key_tmp+9, 247); mem_write_u8(key_tmp+10, 21); mem_write_u8(key_tmp+11, 136);
    mem_write_u8(key_tmp+12, 9); mem_write_u8(key_tmp+13, 207); mem_write_u8(key_tmp+14, 79);
    mem_write_u8(key_tmp+15, 60);

    _ke_aes_key_expand(key_tmp);

    // NIST test plaintext: 3243f6a8885a308d313198a2e0370734
    mem_write_u8(state, 50); mem_write_u8(state+1, 67); mem_write_u8(state+2, 246);
    mem_write_u8(state+3, 168); mem_write_u8(state+4, 136); mem_write_u8(state+5, 90);
    mem_write_u8(state+6, 48); mem_write_u8(state+7, 141); mem_write_u8(state+8, 49);
    mem_write_u8(state+9, 49); mem_write_u8(state+10, 152); mem_write_u8(state+11, 162);
    mem_write_u8(state+12, 224); mem_write_u8(state+13, 55); mem_write_u8(state+14, 7);
    mem_write_u8(state+15, 52);

    _ke_aes128_encrypt(state);

    // Print "AES: " prefix
    _ke_putc(65); _ke_putc(69); _ke_putc(83); _ke_putc(58); _ke_putc(32);
    let mut i = 0;
    while i < 16 {
        _ke_put_hex8(mem_read_u8(state + i));
        i = i + 1;
    }
    _ke_putc(13); _ke_putc(10);
    return 0;
}

// === Iteration 51: AES-128-GCM AEAD ===
//
// Memory layout (0x950400-0x9505FF):
//   0x950400: GCM H key (16 bytes) — AES(K, 0^128)
//   0x950410: GCM counter block J (16 bytes)
//   0x950420: GCM tag (16 bytes)
//   0x950430: GCM work buf (16 bytes)
//   0x950440: GCM encrypted counter (16 bytes)

// XOR 16 bytes: dst[i] ^= src[i]
fn _ke_xor16(dst, src) {
    let mut i = 0;
    while i < 16 {
        let d = mem_read_u8(dst + i);
        let s = mem_read_u8(src + i);
        mem_write_u8(dst + i, _ke_xor_byte(d, s));
        i = i + 1;
    }
    return 0;
}

// Increment 32-bit counter in last 4 bytes of 16-byte block (big-endian)
fn _ke_gcm_inc32(blk) {
    let mut carry = 1;
    let mut i = 15;
    while i >= 12 {
        let v = mem_read_u8(blk + i) + carry;
        mem_write_u8(blk + i, v % 256);
        carry = v / 256;
        i = i - 1;
    }
    return 0;
}

// GF(2^128) multiply for GHASH (bit-by-bit, MSB first)
// X and Y are 16-byte blocks, result stored at dst
fn _ke_ghash_mul(dst, x_addr, y_addr) {
    let mut i = 0;
    // Clear dst
    while i < 16 { mem_write_u8(dst + i, 0); i = i + 1; }

    // V = Y (copy)
    let v_buf = 9765952; // 0x950500: temp V buffer
    i = 0;
    while i < 16 { mem_write_u8(v_buf + i, mem_read_u8(y_addr + i)); i = i + 1; }

    // For each bit of X (128 bits, MSB first)
    let mut bi = 0;
    while bi < 128 {
        let byte_idx = bi / 8;
        let bit_idx = 7 - (bi % 8);
        let xbyte = mem_read_u8(x_addr + byte_idx);
        let mut bit_mask = 1;
        let mut sh = 0;
        while sh < bit_idx { bit_mask = bit_mask * 2; sh = sh + 1; }
        let xbit = (xbyte / bit_mask) % 2;

        if xbit == 1 {
            _ke_xor16(dst, v_buf);
        }

        // Shift V right by 1 in GF(2^128)
        let lsb = mem_read_u8(v_buf + 15) % 2;
        i = 15;
        while i > 0 {
            let cur = mem_read_u8(v_buf + i);
            let prev = mem_read_u8(v_buf + i - 1);
            mem_write_u8(v_buf + i, (cur / 2) + (prev % 2) * 128);
            i = i - 1;
        }
        mem_write_u8(v_buf, mem_read_u8(v_buf) / 2);

        // If LSB was 1, XOR with reduction polynomial R = 0xE1000...0
        if lsb == 1 {
            let top = mem_read_u8(v_buf);
            mem_write_u8(v_buf, _ke_xor_byte(top, 225)); // 0xE1
        }

        bi = bi + 1;
    }
    return 0;
}

// GHASH: process AAD and ciphertext, produce 16-byte tag
// For simplicity: no AAD, just ciphertext
fn _ke_ghash(h_addr, ct_addr, ct_len, tag_addr) {
    // Clear tag
    let mut i = 0;
    while i < 16 { mem_write_u8(tag_addr + i, 0); i = i + 1; }

    let tmp = 9765968; // 0x950510: temp for ghash_mul result

    // Process ciphertext blocks
    let nblocks = ct_len / 16;
    let mut b = 0;
    while b < nblocks {
        _ke_xor16(tag_addr, ct_addr + b * 16);
        _ke_ghash_mul(tmp, tag_addr, h_addr);
        i = 0;
        while i < 16 { mem_write_u8(tag_addr + i, mem_read_u8(tmp + i)); i = i + 1; }
        b = b + 1;
    }

    // Length block: AAD len (0) || CT len in bits (big-endian 64-bit each)
    let len_blk = 9765984; // 0x950520
    i = 0;
    while i < 16 { mem_write_u8(len_blk + i, 0); i = i + 1; }
    let ct_bits = ct_len * 8;
    mem_write_u8(len_blk + 12, (ct_bits / 16777216) % 256);
    mem_write_u8(len_blk + 13, (ct_bits / 65536) % 256);
    mem_write_u8(len_blk + 14, (ct_bits / 256) % 256);
    mem_write_u8(len_blk + 15, ct_bits % 256);

    _ke_xor16(tag_addr, len_blk);
    _ke_ghash_mul(tmp, tag_addr, h_addr);
    i = 0;
    while i < 16 { mem_write_u8(tag_addr + i, mem_read_u8(tmp + i)); i = i + 1; }

    return 0;
}

// AES-128-GCM encrypt: key at key_addr, IV at iv_addr (12 bytes),
// plaintext at pt_addr (pt_len bytes), ciphertext at ct_addr, tag at tag_addr
fn _ke_aes_gcm_encrypt(key_addr, iv_addr, pt_addr, pt_len, ct_addr, tag_addr) {
    let h_buf = 9765888;    // 0x950400: H
    let j_buf = 9765904;    // 0x950410: J counter
    let enc_buf = 9765936;  // 0x950440: encrypted counter

    _ke_aes_init_sbox();
    _ke_aes_key_expand(key_addr);

    // H = AES(K, 0^128)
    let mut i = 0;
    while i < 16 { mem_write_u8(h_buf + i, 0); i = i + 1; }
    _ke_aes128_encrypt(h_buf);

    // J0 = IV || 0x00000001
    i = 0;
    while i < 12 { mem_write_u8(j_buf + i, mem_read_u8(iv_addr + i)); i = i + 1; }
    mem_write_u8(j_buf + 12, 0); mem_write_u8(j_buf + 13, 0);
    mem_write_u8(j_buf + 14, 0); mem_write_u8(j_buf + 15, 1);

    // Save J0 for final tag XOR
    let j0_save = 9766000; // 0x950530
    i = 0;
    while i < 16 { mem_write_u8(j0_save + i, mem_read_u8(j_buf + i)); i = i + 1; }

    // CTR mode encrypt
    let nblocks = (pt_len + 15) / 16;
    let mut b = 0;
    while b < nblocks {
        _ke_gcm_inc32(j_buf);
        // Copy counter to enc_buf and encrypt
        i = 0;
        while i < 16 { mem_write_u8(enc_buf + i, mem_read_u8(j_buf + i)); i = i + 1; }
        _ke_aes128_encrypt(enc_buf);
        // XOR with plaintext
        i = 0;
        while i < 16 {
            let pt_off = b * 16 + i;
            if pt_off < pt_len {
                let p = mem_read_u8(pt_addr + pt_off);
                let e = mem_read_u8(enc_buf + i);
                mem_write_u8(ct_addr + pt_off, _ke_xor_byte(p, e));
            }
            i = i + 1;
        }
        b = b + 1;
    }

    // GHASH over ciphertext
    _ke_ghash(h_buf, ct_addr, pt_len, tag_addr);

    // Final tag = GHASH XOR AES(K, J0)
    i = 0;
    while i < 16 { mem_write_u8(enc_buf + i, mem_read_u8(j0_save + i)); i = i + 1; }
    _ke_aes128_encrypt(enc_buf);
    _ke_xor16(tag_addr, enc_buf);

    return 0;
}

// Command: gcm — AES-128-GCM encrypt demo and print ciphertext + tag
fn _ke_cmd_gcm() {
    let key_tmp = 9766016;  // 0x950540
    let iv_tmp = 9766032;   // 0x950550
    let pt_tmp = 9766048;   // 0x950560
    let ct_tmp = 9766064;   // 0x950570
    let tag_tmp = 9766080;  // 0x950580

    // Key: 00000000000000000000000000000000
    let mut i = 0;
    while i < 16 { mem_write_u8(key_tmp + i, 0); i = i + 1; }
    // IV: 000000000000000000000000
    i = 0;
    while i < 12 { mem_write_u8(iv_tmp + i, 0); i = i + 1; }
    // Plaintext: "HicOS" (5 bytes, padded to 16 for block)
    mem_write_u8(pt_tmp, 72); mem_write_u8(pt_tmp+1, 105); mem_write_u8(pt_tmp+2, 99);
    mem_write_u8(pt_tmp+3, 79); mem_write_u8(pt_tmp+4, 83);
    i = 5;
    while i < 16 { mem_write_u8(pt_tmp + i, 0); i = i + 1; }

    _ke_sha256_init_k();
    _ke_aes_gcm_encrypt(key_tmp, iv_tmp, pt_tmp, 16, ct_tmp, tag_tmp);

    // Print "GCM-CT: " + ciphertext hex
    _ke_putc(71); _ke_putc(67); _ke_putc(77); _ke_putc(45);
    _ke_putc(67); _ke_putc(84); _ke_putc(58); _ke_putc(32);
    i = 0;
    while i < 16 { _ke_put_hex8(mem_read_u8(ct_tmp + i)); i = i + 1; }
    _ke_putc(13); _ke_putc(10);

    // Print "GCM-TAG: " + tag hex
    _ke_putc(71); _ke_putc(67); _ke_putc(77); _ke_putc(45);
    _ke_putc(84); _ke_putc(65); _ke_putc(71); _ke_putc(58); _ke_putc(32);
    i = 0;
    while i < 16 { _ke_put_hex8(mem_read_u8(tag_tmp + i)); i = i + 1; }
    _ke_putc(13); _ke_putc(10);
    return 0;
}

// === Iteration 52: TLS 1.3 ClientHello + Handshake State Machine ===
//
// Memory layout (0x960000-0x9603FF):
//   0x960000: TLS state (16 bytes: state, cipher_suite, etc.)
//   0x960010: ClientHello buffer (256 bytes)
//   0x960110: ServerHello buffer (256 bytes)
//   0x960210: Handshake hash state (32 bytes)
//   0x960230: Client random (32 bytes)
//   0x960250: Key schedule (64 bytes)

// TLS 1.3 states
// 0=IDLE, 1=CH_SENT, 2=SH_RECV, 3=ESTABLISHED, 4=ERROR

// Build TLS 1.3 ClientHello message
// Returns length of ClientHello at ch_buf (0x960010)
fn _ke_tls_build_client_hello() {
    let ch = 9830416;     // 0x960010
    let rand_buf = 9830960; // 0x960230

    // Generate "random" from tick counter + SHA-256
    let tick = mem_read_u64(3145728); // 0x300000
    let mut i = 0;
    while i < 32 {
        mem_write_u8(rand_buf + i, (tick / (i + 1) + i * 37) % 256);
        i = i + 1;
    }

    let mut p = 0;

    // TLS record header: ContentType=22 (Handshake)
    mem_write_u8(ch + p, 22); p = p + 1;
    // Version: TLS 1.0 (0x0301) for compatibility
    mem_write_u8(ch + p, 3); p = p + 1;
    mem_write_u8(ch + p, 1); p = p + 1;
    // Length placeholder (2 bytes) — filled later
    let len_off = p;
    p = p + 2;

    // Handshake header: type=1 (ClientHello)
    let hs_start = p;
    mem_write_u8(ch + p, 1); p = p + 1;
    // Handshake length placeholder (3 bytes) — filled later
    let hs_len_off = p;
    p = p + 3;

    // ClientHello body
    let body_start = p;
    // Protocol version: TLS 1.2 (0x0303) — real version in extension
    mem_write_u8(ch + p, 3); p = p + 1;
    mem_write_u8(ch + p, 3); p = p + 1;

    // Random (32 bytes)
    i = 0;
    while i < 32 { mem_write_u8(ch + p, mem_read_u8(rand_buf + i)); p = p + 1; i = i + 1; }

    // Session ID length: 0
    mem_write_u8(ch + p, 0); p = p + 1;

    // Cipher suites: length=2, TLS_AES_128_GCM_SHA256 (0x1301)
    mem_write_u8(ch + p, 0); p = p + 1;
    mem_write_u8(ch + p, 2); p = p + 1;
    mem_write_u8(ch + p, 19); p = p + 1;  // 0x13
    mem_write_u8(ch + p, 1); p = p + 1;   // 0x01

    // Compression methods: length=1, null (0x00)
    mem_write_u8(ch + p, 1); p = p + 1;
    mem_write_u8(ch + p, 0); p = p + 1;

    // Extensions
    let ext_len_off = p;
    p = p + 2; // extensions length placeholder

    let ext_start = p;

    // Extension: supported_versions (0x002B)
    mem_write_u8(ch + p, 0); p = p + 1;
    mem_write_u8(ch + p, 43); p = p + 1;  // type 0x002B
    mem_write_u8(ch + p, 0); p = p + 1;
    mem_write_u8(ch + p, 3); p = p + 1;   // ext data len = 3
    mem_write_u8(ch + p, 2); p = p + 1;   // versions list len = 2
    mem_write_u8(ch + p, 3); p = p + 1;   // TLS 1.3 = 0x0304
    mem_write_u8(ch + p, 4); p = p + 1;

    // Extension: supported_groups (0x000A) — x25519 (0x001D)
    mem_write_u8(ch + p, 0); p = p + 1;
    mem_write_u8(ch + p, 10); p = p + 1;  // type 0x000A
    mem_write_u8(ch + p, 0); p = p + 1;
    mem_write_u8(ch + p, 4); p = p + 1;   // ext data len = 4
    mem_write_u8(ch + p, 0); p = p + 1;
    mem_write_u8(ch + p, 2); p = p + 1;   // groups list len = 2
    mem_write_u8(ch + p, 0); p = p + 1;
    mem_write_u8(ch + p, 29); p = p + 1;  // x25519 = 0x001D

    // Extension: signature_algorithms (0x000D) — rsa_pss_rsae_sha256 (0x0804)
    mem_write_u8(ch + p, 0); p = p + 1;
    mem_write_u8(ch + p, 13); p = p + 1;  // type 0x000D
    mem_write_u8(ch + p, 0); p = p + 1;
    mem_write_u8(ch + p, 4); p = p + 1;   // ext data len = 4
    mem_write_u8(ch + p, 0); p = p + 1;
    mem_write_u8(ch + p, 2); p = p + 1;   // algos list len = 2
    mem_write_u8(ch + p, 8); p = p + 1;   // 0x0804
    mem_write_u8(ch + p, 4); p = p + 1;

    // Extension: key_share (0x0033) — x25519 public key (32 bytes, demo)
    mem_write_u8(ch + p, 0); p = p + 1;
    mem_write_u8(ch + p, 51); p = p + 1;  // type 0x0033
    mem_write_u8(ch + p, 0); p = p + 1;
    mem_write_u8(ch + p, 38); p = p + 1;  // ext data len = 38
    mem_write_u8(ch + p, 0); p = p + 1;
    mem_write_u8(ch + p, 36); p = p + 1;  // client shares len = 36
    mem_write_u8(ch + p, 0); p = p + 1;
    mem_write_u8(ch + p, 29); p = p + 1;  // group = x25519
    mem_write_u8(ch + p, 0); p = p + 1;
    mem_write_u8(ch + p, 32); p = p + 1;  // key len = 32
    // Public key (32 bytes demo — derived from random)
    i = 0;
    while i < 32 {
        mem_write_u8(ch + p, _ke_xor_byte(mem_read_u8(rand_buf + i), 42 + i));
        p = p + 1;
        i = i + 1;
    }

    let ext_len = p - ext_start;
    mem_write_u8(ch + ext_len_off, (ext_len / 256) % 256);
    mem_write_u8(ch + ext_len_off + 1, ext_len % 256);

    // Fill handshake length
    let hs_len = p - body_start;
    mem_write_u8(ch + hs_len_off, 0);
    mem_write_u8(ch + hs_len_off + 1, (hs_len / 256) % 256);
    mem_write_u8(ch + hs_len_off + 2, hs_len % 256);

    // Fill record length
    let rec_len = p - hs_start;
    mem_write_u8(ch + len_off, (rec_len / 256) % 256);
    mem_write_u8(ch + len_off + 1, rec_len % 256);

    return p;
}

// TLS 1.3 key schedule: derive keys from shared secret
fn _ke_tls_key_schedule(shared_secret_addr) {
    let ks = 9831248; // 0x960250: key schedule output
    let prk_out = 9700448; // 0x940460

    // Early secret: HKDF-Extract(0, 0^32)
    let zero_buf = 9831312; // 0x960290
    let mut i = 0;
    while i < 32 { mem_write_u8(zero_buf + i, 0); i = i + 1; }

    _ke_sha256_init_k();
    _ke_hkdf_extract(zero_buf, 32, zero_buf, 32);

    // Copy early secret to key schedule
    i = 0;
    while i < 32 { mem_write_u8(ks + i, mem_read_u8(prk_out + i)); i = i + 1; }

    // Handshake secret: HKDF-Extract(derive_secret, shared_secret)
    _ke_hkdf_extract(ks, 32, shared_secret_addr, 32);
    i = 0;
    while i < 32 { mem_write_u8(ks + 32 + i, mem_read_u8(prk_out + i)); i = i + 1; }

    return 0;
}

// Command: tls — build ClientHello, simulate handshake, show state
fn _ke_cmd_tls() {
    _ke_sha256_init_k();

    // Build ClientHello
    let ch_len = _ke_tls_build_client_hello();

    // Print "TLS: ClientHello " + length + " bytes\r\n"
    _ke_putc(84); _ke_putc(76); _ke_putc(83); _ke_putc(58); _ke_putc(32);
    // "ClientHello "
    _ke_putc(67); _ke_putc(108); _ke_putc(105); _ke_putc(101); _ke_putc(110);
    _ke_putc(116); _ke_putc(72); _ke_putc(101); _ke_putc(108); _ke_putc(108);
    _ke_putc(111); _ke_putc(32);
    _ke_put_dec(ch_len);
    // " bytes"
    _ke_putc(32); _ke_putc(98); _ke_putc(121); _ke_putc(116); _ke_putc(101); _ke_putc(115);
    _ke_putc(13); _ke_putc(10);

    // Print first 16 bytes as hex
    _ke_putc(32); _ke_putc(32);
    let ch = 9830416; // 0x960010
    let mut i = 0;
    while i < 16 {
        _ke_put_hex8(mem_read_u8(ch + i));
        _ke_putc(32);
        i = i + 1;
    }
    _ke_putc(13); _ke_putc(10);

    // Run key schedule with demo shared secret
    let ss_tmp = 9831312; // 0x960290
    i = 0;
    while i < 32 { mem_write_u8(ss_tmp + i, (i * 7 + 13) % 256); i = i + 1; }
    _ke_tls_key_schedule(ss_tmp);

    // Print "TLS: KeySchedule OK\r\n"
    _ke_putc(84); _ke_putc(76); _ke_putc(83); _ke_putc(58); _ke_putc(32);
    _ke_putc(75); _ke_putc(101); _ke_putc(121); _ke_putc(83); _ke_putc(99);
    _ke_putc(104); _ke_putc(101); _ke_putc(100); _ke_putc(117); _ke_putc(108);
    _ke_putc(101); _ke_putc(32); _ke_putc(79); _ke_putc(75);
    _ke_putc(13); _ke_putc(10);

    // Print "TLS: Cipher TLS_AES_128_GCM_SHA256\r\n"
    _ke_putc(84); _ke_putc(76); _ke_putc(83); _ke_putc(58); _ke_putc(32);
    // "Cipher TLS_AES_128_GCM_SHA256"
    _ke_putc(67); _ke_putc(105); _ke_putc(112); _ke_putc(104); _ke_putc(101); _ke_putc(114);
    _ke_putc(32); _ke_putc(84); _ke_putc(76); _ke_putc(83); _ke_putc(95);
    _ke_putc(65); _ke_putc(69); _ke_putc(83); _ke_putc(95); _ke_putc(49);
    _ke_putc(50); _ke_putc(56); _ke_putc(95); _ke_putc(71); _ke_putc(67);
    _ke_putc(77); _ke_putc(95); _ke_putc(83); _ke_putc(72); _ke_putc(65);
    _ke_putc(50); _ke_putc(53); _ke_putc(54);
    _ke_putc(13); _ke_putc(10);

    // Print handshake key (first 16 bytes)
    _ke_putc(84); _ke_putc(76); _ke_putc(83); _ke_putc(58); _ke_putc(32);
    // "HS-Key: "
    _ke_putc(72); _ke_putc(83); _ke_putc(45); _ke_putc(75);
    _ke_putc(101); _ke_putc(121); _ke_putc(58); _ke_putc(32);
    let ks = 9831248; // 0x960250
    i = 0;
    while i < 16 {
        _ke_put_hex8(mem_read_u8(ks + 32 + i));
        i = i + 1;
    }
    _ke_putc(13); _ke_putc(10);

    return 0;
}

// Print "HicOS> " prompt
fn _ke_prompt() {
    _ke_putc(72); _ke_putc(105); _ke_putc(99);      // "Hic"
    _ke_putc(79); _ke_putc(83); _ke_putc(62);        // "OS>"
    _ke_putc(32);                                      // " "
    return 0;
}

// Command: help
fn _ke_cmd_help() {
    // "Cmds: help tick pci pmem palloc pfree\r\n"
    _ke_putc(67); _ke_putc(109); _ke_putc(100); _ke_putc(115); _ke_putc(58); _ke_putc(32);
    _ke_putc(104); _ke_putc(101); _ke_putc(108); _ke_putc(112); _ke_putc(32);
    _ke_putc(116); _ke_putc(105); _ke_putc(99); _ke_putc(107); _ke_putc(32);
    _ke_putc(112); _ke_putc(99); _ke_putc(105); _ke_putc(32);
