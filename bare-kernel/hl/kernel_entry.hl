    _ke_putc(45);
    _ke_putc(76); _ke_putc(97); _ke_putc(110); _ke_putc(103);
    _ke_putc(13); _ke_putc(10);
    return 0;
}

// Command: date — display date/time (delegates to _ke_cmd_time)
fn _ke_cmd_date() {
    _ke_cmd_time();
    return 0;
}

// === Iteration 77: netstat / arp ===
//
// netstat: scan TCP connection table at 0x800000 (64 TCBs × 256 bytes)
//   Displays: local_port, remote_ip:port, state
// arp: display native ARP cache at 0x360000
//   Layout: 16 entries × 16 bytes each (4B ip + 6B mac + 2B flags + 4B padding)

let ARP_NATIVE_BASE = 3538944;  // 0x360000
let ARP_NATIVE_MAX = 16;
let ARP_NATIVE_ENTRY = 16;
let ARP_NATIVE_COUNT_ADDR = 3539200;  // 0x360100

// Initialize native ARP cache
fn _ke_arp_init() {
    mem_write_u64(ARP_NATIVE_COUNT_ADDR, 0);
    let mut i = 0;
    while i < ARP_NATIVE_MAX * ARP_NATIVE_ENTRY {
        mem_write_u8(ARP_NATIVE_BASE + i, 0);
        i = i + 1;
    }
    return 0;
}

// Print IP address from 32-bit big-endian packed value
fn _ke_print_ip(ip) {
    _ke_put_dec((ip / 16777216) % 256);
    _ke_putc(46);
    _ke_put_dec((ip / 65536) % 256);
    _ke_putc(46);
    _ke_put_dec((ip / 256) % 256);
    _ke_putc(46);
    _ke_put_dec(ip % 256);
    return 0;
}

// Print MAC address from 6 bytes at addr
fn _ke_print_mac(addr) {
    let mut i = 0;
    while i < 6 {
        let b = mem_read_u8(addr + i);
        _ke_put_hex8(b);
        if i < 5 { _ke_putc(58); }  // ':'
        i = i + 1;
    }
    return 0;
}

// Print TCP state name
fn _ke_print_tcp_state(state) {
    if state == 0 { _ke_putc(67); _ke_putc(76); _ke_putc(79); _ke_putc(83); _ke_putc(69); _ke_putc(68); return 0; }
    if state == 1 { _ke_putc(76); _ke_putc(73); _ke_putc(83); _ke_putc(84); _ke_putc(69); _ke_putc(78); return 0; }
    if state == 2 { _ke_putc(83); _ke_putc(89); _ke_putc(78); _ke_putc(95); _ke_putc(83); _ke_putc(69); _ke_putc(78); _ke_putc(84); return 0; }
    if state == 3 { _ke_putc(83); _ke_putc(89); _ke_putc(78); _ke_putc(95); _ke_putc(82); _ke_putc(67); _ke_putc(86); _ke_putc(68); return 0; }
    if state == 4 { _ke_putc(69); _ke_putc(83); _ke_putc(84); _ke_putc(65); _ke_putc(66); return 0; }
    if state == 5 { _ke_putc(70); _ke_putc(73); _ke_putc(78); _ke_putc(95); _ke_putc(87); _ke_putc(49); return 0; }
    if state == 6 { _ke_putc(70); _ke_putc(73); _ke_putc(78); _ke_putc(95); _ke_putc(87); _ke_putc(50); return 0; }
    if state == 7 { _ke_putc(67); _ke_putc(76); _ke_putc(83); _ke_putc(95); _ke_putc(87); _ke_putc(65); _ke_putc(73); _ke_putc(84); return 0; }
    if state == 8 { _ke_putc(67); _ke_putc(76); _ke_putc(79); _ke_putc(83); _ke_putc(73); _ke_putc(78); _ke_putc(71); return 0; }
    if state == 9 { _ke_putc(76); _ke_putc(65); _ke_putc(83); _ke_putc(84); _ke_putc(95); _ke_putc(65); _ke_putc(67); _ke_putc(75); return 0; }
    if state == 10 { _ke_putc(84); _ke_putc(73); _ke_putc(77); _ke_putc(69); _ke_putc(95); _ke_putc(87); return 0; }
    _ke_putc(63);
    return 0;
}

// Command: netstat — display active TCP connections
fn _ke_cmd_netstat() {
    let tcb_base = 8388608;  // 0x800000
    let tcb_size = 256;
    let max_tcp = 64;

    // Header: "Proto Local      Remote          State\r\n"
    _ke_putc(80); _ke_putc(114); _ke_putc(111); _ke_putc(116); _ke_putc(111); // "Proto"
    _ke_putc(32);
    _ke_putc(76); _ke_putc(111); _ke_putc(99); _ke_putc(97); _ke_putc(108); // "Local"
    _ke_putc(32); _ke_putc(32); _ke_putc(32); _ke_putc(32); _ke_putc(32);
    _ke_putc(32);
    _ke_putc(82); _ke_putc(101); _ke_putc(109); _ke_putc(111); _ke_putc(116); _ke_putc(101); // "Remote"
    _ke_putc(32); _ke_putc(32); _ke_putc(32); _ke_putc(32); _ke_putc(32);
    _ke_putc(32); _ke_putc(32); _ke_putc(32); _ke_putc(32);
    _ke_putc(83); _ke_putc(116); _ke_putc(97); _ke_putc(116); _ke_putc(101); // "State"
    _ke_putc(13); _ke_putc(10);

    let mut count = 0;
    let mut i = 0;
    while i < max_tcp {
        let addr = tcb_base + i * tcb_size;
        let state = mem_read_u64(addr);
        if state != 0 {
            // "tcp  "
            _ke_putc(116); _ke_putc(99); _ke_putc(112);
            _ke_putc(32); _ke_putc(32);

            // Local: 0.0.0.0:port
            let lip = mem_read_u32(addr + 8);
            let lport = mem_read_u32(addr + 12);
            _ke_print_ip(lip);
            _ke_putc(58);  // ':'
            _ke_put_dec(lport);
            _ke_putc(32);

            // Remote: ip:port
            let rip = mem_read_u32(addr + 16);
            let rport = mem_read_u32(addr + 20);
            _ke_print_ip(rip);
            _ke_putc(58);
            _ke_put_dec(rport);
            _ke_putc(32);

            // State
            _ke_print_tcp_state(state);
            _ke_putc(13); _ke_putc(10);
            count = count + 1;
        }
        i = i + 1;
    }

    if count == 0 {
        // "(no active connections)\r\n"
        _ke_putc(40);
        _ke_putc(110); _ke_putc(111); _ke_putc(32);
        _ke_putc(97); _ke_putc(99); _ke_putc(116); _ke_putc(105); _ke_putc(118); _ke_putc(101);
        _ke_putc(32);
        _ke_putc(99); _ke_putc(111); _ke_putc(110); _ke_putc(110); _ke_putc(101);
        _ke_putc(99); _ke_putc(116); _ke_putc(105); _ke_putc(111); _ke_putc(110); _ke_putc(115);
        _ke_putc(41);
        _ke_putc(13); _ke_putc(10);
    } else {
        _ke_put_dec(count);
        // " connection(s)\r\n"
        _ke_putc(32);
        _ke_putc(99); _ke_putc(111); _ke_putc(110); _ke_putc(110); _ke_putc(101);
        _ke_putc(99); _ke_putc(116); _ke_putc(105); _ke_putc(111); _ke_putc(110);
        _ke_putc(40); _ke_putc(115); _ke_putc(41);
        _ke_putc(13); _ke_putc(10);
    }
    return 0;
}

// Command: arp — display ARP cache
fn _ke_cmd_arp() {
    let count = mem_read_u64(ARP_NATIVE_COUNT_ADDR);

    // Header: "IP Address       MAC Address       Flags\r\n"
    _ke_putc(73); _ke_putc(80); _ke_putc(32);  // "IP "
    _ke_putc(65); _ke_putc(100); _ke_putc(100); _ke_putc(114); _ke_putc(101); _ke_putc(115); _ke_putc(115); // "Address"
    _ke_putc(32); _ke_putc(32); _ke_putc(32); _ke_putc(32); _ke_putc(32); _ke_putc(32); _ke_putc(32); _ke_putc(32);
    _ke_putc(77); _ke_putc(65); _ke_putc(67);  // "MAC"
    _ke_putc(32);
    _ke_putc(65); _ke_putc(100); _ke_putc(100); _ke_putc(114); _ke_putc(101); _ke_putc(115); _ke_putc(115); // "Address"
    _ke_putc(13); _ke_putc(10);

    if count == 0 {
        // "(empty)\r\n"
        _ke_putc(40);
        _ke_putc(101); _ke_putc(109); _ke_putc(112); _ke_putc(116); _ke_putc(121);
        _ke_putc(41);
        _ke_putc(13); _ke_putc(10);

        // Also display our network config
        // "Config: 10.0.2.15 gw 10.0.2.2\r\n"
        _ke_putc(67); _ke_putc(111); _ke_putc(110); _ke_putc(102); _ke_putc(105); _ke_putc(103); _ke_putc(58); _ke_putc(32);
        // Our IP (from VirtIO-net init at 0x902020)
        _ke_putc(49); _ke_putc(48); _ke_putc(46); _ke_putc(48); _ke_putc(46);
        _ke_putc(50); _ke_putc(46); _ke_putc(49); _ke_putc(53);
        // " gw "
        _ke_putc(32); _ke_putc(103); _ke_putc(119); _ke_putc(32);
        // Gateway
        _ke_putc(49); _ke_putc(48); _ke_putc(46); _ke_putc(48); _ke_putc(46);
        _ke_putc(50); _ke_putc(46); _ke_putc(50);
        _ke_putc(13); _ke_putc(10);
        return 0;
    }

    let mut i = 0;
    while i < count {
        if i >= ARP_NATIVE_MAX { i = count; }
        else {
            let entry = ARP_NATIVE_BASE + i * ARP_NATIVE_ENTRY;
            let ip = _ke_mem_r32be(entry);
            // IP
            _ke_print_ip(ip);
            // Pad to 16 chars
            _ke_putc(32); _ke_putc(32); _ke_putc(32); _ke_putc(32);
            _ke_putc(32); _ke_putc(32);
            // MAC (6 bytes at entry+4)
            _ke_print_mac(entry + 4);
            _ke_putc(13); _ke_putc(10);
            i = i + 1;
        }
    }

    _ke_put_dec(count);
    // " entries\r\n"
    _ke_putc(32);
    _ke_putc(101); _ke_putc(110); _ke_putc(116); _ke_putc(114); _ke_putc(105); _ke_putc(101); _ke_putc(115);
    _ke_putc(13); _ke_putc(10);
    return 0;
}

// === Iteration 78: Shell Pipe ===
//
// Memory layout:
//   0x370000: pipe capture buffer (4096 bytes)
//   0x371000: pipe_capture_flag (u64) — 1 = capturing, 0 = normal
//   0x371008: pipe_capture_pos  (u64) — current write position in capture buffer
//   0x371010: pipe_right_buf    (64 bytes) — right-side command buffer
//
// When pipe_capture_flag == 1, _ke_putc_pipe routes output to capture buffer
// instead of serial port.

let PIPE_CAP_BUF = 3604480;       // 0x370000
let PIPE_CAP_SIZE = 4096;
let PIPE_CAP_FLAG_ADDR = 3608576;  // 0x371000
let PIPE_CAP_POS_ADDR = 3608584;   // 0x371008
let PIPE_RIGHT_BUF = 3608592;      // 0x371010

// Start capturing output
fn _ke_pipe_cap_start() {
    // Zero capture buffer
    let mut i = 0;
    while i < PIPE_CAP_SIZE {
        mem_write_u8(PIPE_CAP_BUF + i, 0);
        i = i + 1;
    }
    mem_write_u64(PIPE_CAP_POS_ADDR, 0);
    mem_write_u64(PIPE_CAP_FLAG_ADDR, 1);
    return 0;
}

// Stop capturing output, return bytes captured
fn _ke_pipe_cap_stop() {
    mem_write_u64(PIPE_CAP_FLAG_ADDR, 0);
    return mem_read_u64(PIPE_CAP_POS_ADDR);
}

// Output one char — either to serial or to capture buffer
fn _ke_putc_pipe(ch) {
    let capturing = mem_read_u64(PIPE_CAP_FLAG_ADDR);
    if capturing == 1 {
        let pos = mem_read_u64(PIPE_CAP_POS_ADDR);
        if pos < PIPE_CAP_SIZE {
            mem_write_u8(PIPE_CAP_BUF + pos, ch);
            mem_write_u64(PIPE_CAP_POS_ADDR, pos + 1);
        }
        return 0;
    }
    _ke_putc(ch);
    return 0;
}

// Find pipe character '|' (ASCII 124) in command buffer
// Returns position of '|' or -1 if not found
fn _ke_find_pipe(buf_addr, buf_len) {
    let mut i = 0;
    while i < buf_len {
        if mem_read_u8(buf_addr + i) == 124 { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

// Execute a piped command: "cmd1 | cmd2"
// - Run cmd1 with output captured to pipe buffer (not printed to serial)
// - Run cmd2 which can read the captured output (e.g. grep filters it)
// Returns 1 if pipe was found and executed, 0 if no pipe
fn _ke_pipe_exec(buf_addr, buf_len) {
    let pipe_pos = _ke_find_pipe(buf_addr, buf_len);
    if pipe_pos < 0 { return 0; }

    // Left command: bytes [0..pipe_pos), trim trailing spaces
    let mut left_len = pipe_pos;
    let mut trimming = 1;
    while trimming == 1 {
        if left_len == 0 { trimming = 0; }
        else {
            if mem_read_u8(buf_addr + left_len - 1) == 32 { left_len = left_len - 1; }
            else { trimming = 0; }
        }
    }

    // Right command: bytes [pipe_pos+1..buf_len), skip leading spaces
    let mut right_start = pipe_pos + 1;
    let mut skipping = 1;
    while skipping == 1 {
        if right_start >= buf_len { skipping = 0; }
        else {
            if mem_read_u8(buf_addr + right_start) == 32 { right_start = right_start + 1; }
            else { skipping = 0; }
        }
    }
    let right_len = buf_len - right_start;

    if left_len == 0 { return 0; }
    if right_len == 0 { return 0; }

    // Step 1: Capture left command output to pipe buffer
    // _ke_putc itself checks capture flag, so all output goes to buffer
    _ke_pipe_cap_start();
    _ke_dispatch(buf_addr, left_len);
    let cap_len = _ke_pipe_cap_stop();

    // Store captured length for right-side command to read
    mem_write_u64(PIPE_CAP_POS_ADDR, cap_len);

    // Step 2: Copy right command to PIPE_RIGHT_BUF and dispatch
    let mut ri = 0;
    let mut rlen = right_len;
    if rlen > 60 { rlen = 60; }
    while ri < rlen {
        mem_write_u8(PIPE_RIGHT_BUF + ri, mem_read_u8(buf_addr + right_start + ri));
        ri = ri + 1;
    }

    _ke_dispatch(PIPE_RIGHT_BUF, rlen);

    return 1;
}

// === Iteration 79: grep ===
//
// "grep <pattern>" — when used after pipe, scans pipe capture buffer
//   for lines containing <pattern> substring and prints matching lines.
// "grep <pattern>" standalone — prints usage hint.
//
// Memory: reads from PIPE_CAP_BUF (0x370000), length at PIPE_CAP_POS_ADDR.
// Line delimiter: LF (10) or CR (13).

// Check if line [line_addr..line_addr+line_len) contains pattern [pat_addr..+pat_len)
fn _ke_grep_match(line_addr, line_len, pat_addr, pat_len) {
    if pat_len == 0 { return 1; }
    if line_len < pat_len { return 0; }
    let limit = line_len - pat_len + 1;
    let mut i = 0;
    while i < limit {
        let mut j = 0;
        let mut ok = 1;
        while j < pat_len {
            if ok == 1 {
                if mem_read_u8(line_addr + i + j) != mem_read_u8(pat_addr + j) {
                    ok = 0;
                }
            }
            j = j + 1;
        }
        if ok == 1 { return 1; }
        i = i + 1;
    }
    return 0;
}

// Command: grep <pattern> — filter piped input or show usage
fn _ke_cmd_grep(buf_addr, buf_len) {
    // Parse pattern: "grep " = 5 chars
    if buf_len <= 5 {
        // "Usage: cmd | grep <pattern>\r\n"
        _ke_putc(85); _ke_putc(115); _ke_putc(97); _ke_putc(103); _ke_putc(101);
        _ke_putc(58); _ke_putc(32);
        _ke_putc(99); _ke_putc(109); _ke_putc(100);
        _ke_putc(32); _ke_putc(124); _ke_putc(32);
        _ke_putc(103); _ke_putc(114); _ke_putc(101); _ke_putc(112);
        _ke_putc(32); _ke_putc(60);
        _ke_putc(112); _ke_putc(97); _ke_putc(116); _ke_putc(116);
        _ke_putc(101); _ke_putc(114); _ke_putc(110);
        _ke_putc(62);
        _ke_putc(13); _ke_putc(10);
        return 0;
    }

    let pat_addr = buf_addr + 5;
    let pat_len = buf_len - 5;

    // Read pipe capture buffer
    let cap_len = mem_read_u64(PIPE_CAP_POS_ADDR);

    if cap_len == 0 {
        // No piped input — show hint
        // "(no piped input)\r\n"
        _ke_putc(40);
        _ke_putc(110); _ke_putc(111); _ke_putc(32);
        _ke_putc(112); _ke_putc(105); _ke_putc(112); _ke_putc(101); _ke_putc(100);
        _ke_putc(32);
        _ke_putc(105); _ke_putc(110); _ke_putc(112); _ke_putc(117); _ke_putc(116);
        _ke_putc(41);
        _ke_putc(13); _ke_putc(10);
        return 0;
    }

    // Scan capture buffer line by line
    let mut line_start = 0;
    let mut matches = 0;
    let mut pos = 0;
    while pos <= cap_len {
        let mut is_eol = 0;
        if pos == cap_len { is_eol = 1; }
        else {
            let ch = mem_read_u8(PIPE_CAP_BUF + pos);
            if ch == 10 { is_eol = 1; }
        }

        if is_eol == 1 {
            let line_len = pos - line_start;
            // Skip empty lines and CR-only
            let mut real_len = line_len;
            // Trim trailing CR
            if real_len > 0 {
                if mem_read_u8(PIPE_CAP_BUF + line_start + real_len - 1) == 13 {
                    real_len = real_len - 1;
                }
            }

            if real_len > 0 {
                if _ke_grep_match(PIPE_CAP_BUF + line_start, real_len, pat_addr, pat_len) == 1 {
                    // Print matching line
                    let mut pi = 0;
                    while pi < real_len {
                        _ke_putc(mem_read_u8(PIPE_CAP_BUF + line_start + pi));
                        pi = pi + 1;
                    }
                    _ke_putc(13); _ke_putc(10);
                    matches = matches + 1;
                }
            }

            line_start = pos + 1;
        }
        pos = pos + 1;
    }

    if matches == 0 {
        // "(no match)\r\n"
        _ke_putc(40);
        _ke_putc(110); _ke_putc(111); _ke_putc(32);
        _ke_putc(109); _ke_putc(97); _ke_putc(116); _ke_putc(99); _ke_putc(104);
        _ke_putc(41);
        _ke_putc(13); _ke_putc(10);
    }

    return 0;
}

// === Iteration 117: tcploop — TCP loopback self-test ===
fn _ke_cmd_tcploop() {
    let result = tcp_loopback_test();
    if result == 1 {
        // "TCP loopback: OK\r\n"
        _ke_putc(84); _ke_putc(67); _ke_putc(80); _ke_putc(32);
        _ke_putc(108); _ke_putc(111); _ke_putc(111); _ke_putc(112);
        _ke_putc(98); _ke_putc(97); _ke_putc(99); _ke_putc(107);
        _ke_putc(58); _ke_putc(32);
        _ke_putc(79); _ke_putc(75);
        _ke_putc(13); _ke_putc(10);
        // "SYN>SYN_RCVD>ESTABLISHED>DATA(5B)>FIN>CLOSE_WAIT\r\n"
        _ke_putc(83); _ke_putc(89); _ke_putc(78); _ke_putc(62);
        _ke_putc(83); _ke_putc(89); _ke_putc(78); _ke_putc(95);
        _ke_putc(82); _ke_putc(67); _ke_putc(86); _ke_putc(68); _ke_putc(62);
        _ke_putc(69); _ke_putc(83); _ke_putc(84); _ke_putc(65);
        _ke_putc(66); _ke_putc(76); _ke_putc(73); _ke_putc(83);
        _ke_putc(72); _ke_putc(69); _ke_putc(68); _ke_putc(62);
        _ke_putc(68); _ke_putc(65); _ke_putc(84); _ke_putc(65);
        _ke_putc(40); _ke_putc(53); _ke_putc(66); _ke_putc(41); _ke_putc(62);
        _ke_putc(70); _ke_putc(73); _ke_putc(78); _ke_putc(62);
        _ke_putc(67); _ke_putc(76); _ke_putc(79); _ke_putc(83);
        _ke_putc(69); _ke_putc(95); _ke_putc(87); _ke_putc(65);
        _ke_putc(73); _ke_putc(84);
        _ke_putc(13); _ke_putc(10);
    } else {
        // "TCP loopback: FAIL\r\n"
        _ke_putc(84); _ke_putc(67); _ke_putc(80); _ke_putc(32);
        _ke_putc(108); _ke_putc(111); _ke_putc(111); _ke_putc(112);
        _ke_putc(98); _ke_putc(97); _ke_putc(99); _ke_putc(107);
        _ke_putc(58); _ke_putc(32);
        _ke_putc(70); _ke_putc(65); _ke_putc(73); _ke_putc(76);
        _ke_putc(13); _ke_putc(10);
    }
    return 0;
}

// === Iteration 118: dnstest — DNS loopback self-test ===
fn _ke_cmd_dnstest() {
    let result = dns_loopback_test();
    if result == 1 {
        // "DNS loopback: OK\r\n"
        _ke_putc(68); _ke_putc(78); _ke_putc(83); _ke_putc(32);
        _ke_putc(108); _ke_putc(111); _ke_putc(111); _ke_putc(112);
        _ke_putc(98); _ke_putc(97); _ke_putc(99); _ke_putc(107);
        _ke_putc(58); _ke_putc(32);
        _ke_putc(79); _ke_putc(75);
        _ke_putc(13); _ke_putc(10);
        // "query>parse>cache>hit>expire>miss>static\r\n"
        _ke_putc(113); _ke_putc(117); _ke_putc(101); _ke_putc(114); _ke_putc(121); _ke_putc(62);
        _ke_putc(112); _ke_putc(97); _ke_putc(114); _ke_putc(115); _ke_putc(101); _ke_putc(62);
        _ke_putc(99); _ke_putc(97); _ke_putc(99); _ke_putc(104); _ke_putc(101); _ke_putc(62);
        _ke_putc(104); _ke_putc(105); _ke_putc(116); _ke_putc(62);
        _ke_putc(101); _ke_putc(120); _ke_putc(112); _ke_putc(105); _ke_putc(114); _ke_putc(101); _ke_putc(62);
        _ke_putc(109); _ke_putc(105); _ke_putc(115); _ke_putc(115); _ke_putc(62);
        _ke_putc(115); _ke_putc(116); _ke_putc(97); _ke_putc(116); _ke_putc(105); _ke_putc(99);
        _ke_putc(13); _ke_putc(10);
    } else {
        // "DNS loopback: FAIL\r\n"
        _ke_putc(68); _ke_putc(78); _ke_putc(83); _ke_putc(32);
        _ke_putc(108); _ke_putc(111); _ke_putc(111); _ke_putc(112);
        _ke_putc(98); _ke_putc(97); _ke_putc(99); _ke_putc(107);
        _ke_putc(58); _ke_putc(32);
        _ke_putc(70); _ke_putc(65); _ke_putc(73); _ke_putc(76);
        _ke_putc(13); _ke_putc(10);
    }
    return 0;
}

// === Iteration 116: heval — kernel self-bootstrap prototype ===
// Evaluate H-L expression inside kernel via kinterp_exec.
// Usage: heval <expr>
// This proves the kernel can lex → parse → eval its own language.
fn _ke_cmd_heval(buf_addr, buf_len) {
    // "heval " = 6 chars (including trailing space)
    if buf_len <= 6 {
        // "Usage: heval <expr>\r\n"
        _ke_putc(85); _ke_putc(115); _ke_putc(97); _ke_putc(103); _ke_putc(101);
        _ke_putc(58); _ke_putc(32);
        _ke_putc(104); _ke_putc(101); _ke_putc(118); _ke_putc(97); _ke_putc(108);
        _ke_putc(32); _ke_putc(60);
        _ke_putc(101); _ke_putc(120); _ke_putc(112); _ke_putc(114);
        _ke_putc(62);
        _ke_putc(13); _ke_putc(10);
        return 0;
    }

    // Extract expression as string: build from bytes at buf_addr+6..buf_len-1
    let expr_start = 6;
    let expr_len = buf_len - expr_start;
    let mut expr = "";
    let mut xi = 0;
    while xi < expr_len {
        let ch = mem_read_u8(buf_addr + expr_start + xi);
        expr = expr + char_from_code(ch);
        xi = xi + 1;
    }

    // "keval> " prefix
    _ke_putc(107); _ke_putc(101); _ke_putc(118); _ke_putc(97); _ke_putc(108);
    _ke_putc(62); _ke_putc(32);

    // Execute via tree-walk interpreter
    let result = kinterp_exec(expr);

    // Print result
    let result_str = to_string(result);
    let rlen = len(result_str);
    let mut ri = 0;
    while ri < rlen {
        _ke_putc(char_code(result_str, ri));
        ri = ri + 1;
    }
    _ke_putc(13); _ke_putc(10);
    return 0;
}

// Command dispatch: compare command buffer bytes
// Uses fixed memory at 0x310000-0x31003F as command buffer
fn _ke_dispatch(buf_addr, buf_len) {
    if buf_len == 0 { return 0; }
    let c0 = mem_read_u8(buf_addr);
    let c1 = 0; if buf_len > 1 { c1 = mem_read_u8(buf_addr + 1); }
    let c2 = 0; if buf_len > 2 { c2 = mem_read_u8(buf_addr + 2); }
    let c3 = 0; if buf_len > 3 { c3 = mem_read_u8(buf_addr + 3); }
    let c4 = 0; if buf_len > 4 { c4 = mem_read_u8(buf_addr + 4); }
    let c5 = 0; if buf_len > 5 { c5 = mem_read_u8(buf_addr + 5); }
    let c6 = 0; if buf_len > 6 { c6 = mem_read_u8(buf_addr + 6); }
    let c7 = 0; if buf_len > 7 { c7 = mem_read_u8(buf_addr + 7); }

    // "shutdown" (8): 115 104 117 116 100 111 119 110
    if buf_len == 8 {
        if c0 == 115 { if c1 == 104 { if c2 == 117 { if c3 == 116 {
            if c4 == 100 { if c5 == 111 { if c6 == 119 { if c7 == 110 {
                _ke_cmd_shutdown(); return 0;
            } } } }
        } } } }
        // "hostname" (8): 104 111 115 116 110 97 109 101
        if c0 == 104 { if c1 == 111 { if c2 == 115 { if c3 == 116 {
            if c4 == 110 { if c5 == 97 { if c6 == 109 { if c7 == 101 {
                _ke_cmd_hostname(); return 0;
            } } } }
        } } } }
    }

    // "compile " prefix (8+): 99 111 109 112 105 108 101 32
    if buf_len >= 9 {
        if c0 == 99 { if c1 == 111 { if c2 == 109 { if c3 == 112 { if c4 == 105 { if c5 == 108 {
            let c6 = mem_read_u8(buf_addr + 6);
            let c7 = mem_read_u8(buf_addr + 7);
            if c6 == 101 { if c7 == 32 {
                _ke_cmd_compile(buf_addr, buf_len); return 0;
            } }
        } } } } } }
    }

    // "adduser " prefix (8+): 97 100 100 117 115 101 114 32
    if buf_len >= 9 {
        if c0 == 97 { if c1 == 100 { if c2 == 100 { if c3 == 117 { if c4 == 115 { if c5 == 101 {
            let c6 = mem_read_u8(buf_addr + 6);
            let c7 = mem_read_u8(buf_addr + 7);
            if c6 == 114 { if c7 == 32 {
                _ke_cmd_adduser(buf_addr, buf_len); return 0;
            } }
        } } } } } }
    }

    // "setenv " prefix (7+): 115 101 116 101 110 118 32
    if buf_len >= 8 {
        if c0 == 115 { if c1 == 101 { if c2 == 116 { if c3 == 101 { if c4 == 110 { if c5 == 118 {
            if c6 == 32 {
                _ke_cmd_setenv(buf_addr, buf_len); return 0;
            }
        } } } } } }
    }

    // "install" (7): 105 110 115 116 97 108 108
    if buf_len == 7 {
        if c0 == 105 { if c1 == 110 { if c2 == 115 { if c3 == 116 {
            if c4 == 97 { if c5 == 108 { if c6 == 108 {
                _ke_cmd_install(); return 0;
            } } }
        } } } }
        // "tcploop" (7): 116 99 112 108 111 111 112
        if c0 == 116 { if c1 == 99 { if c2 == 112 { if c3 == 108 {
            if c4 == 111 { if c5 == 111 { if c6 == 112 {
                _ke_cmd_tcploop(); return 0;
            } } }
        } } } }
        // "dnstest" (7): 100 110 115 116 101 115 116
        if c0 == 100 { if c1 == 110 { if c2 == 115 { if c3 == 116 {
            if c4 == 101 { if c5 == 115 { if c6 == 116 {
                _ke_cmd_dnstest(); return 0;
            } } }
        } } } }
    }

    // "mkfile " prefix (7+): 109 107 102 105 108 101 32
    if buf_len >= 8 {
        if c0 == 109 { if c1 == 107 { if c2 == 102 { if c3 == 105 { if c4 == 108 { if c5 == 101 {
            if c6 == 32 {
