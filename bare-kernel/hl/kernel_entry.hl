// Command: tick — show timer tick count
fn _ke_cmd_tick() {
    let tick = mem_read_u64(3145728);  // 0x300000
    // "Tick: " then decimal
    _ke_putc(84); _ke_putc(105); _ke_putc(99); _ke_putc(107); _ke_putc(58); _ke_putc(32);
    _ke_put_dec(tick);
    _ke_putc(13); _ke_putc(10);
    return 0;
}

// Command dispatch: compare command buffer bytes
// Uses fixed memory at 0x310000-0x31003F as command buffer
fn _ke_dispatch(buf_addr, buf_len) {
    if buf_len == 0 { return 0; }
    let c0 = mem_read_u8(buf_addr);
    let c1 = 0; if buf_len > 1 { c1 = mem_read_u8(buf_addr + 1); }
    let c2 = 0; if buf_len > 2 { c2 = mem_read_u8(buf_addr + 2); }
    let c3 = 0; if buf_len > 3 { c3 = mem_read_u8(buf_addr + 3); }
    let c4 = 0; if buf_len > 4 { c4 = mem_read_u8(buf_addr + 4); }
    let c5 = 0; if buf_len > 5 { c5 = mem_read_u8(buf_addr + 5); }
    let c6 = 0; if buf_len > 6 { c6 = mem_read_u8(buf_addr + 6); }
    let c7 = 0; if buf_len > 7 { c7 = mem_read_u8(buf_addr + 7); }

    // "shutdown" (8): 115 104 117 116 100 111 119 110
    if buf_len == 8 {
        if c0 == 115 { if c1 == 104 { if c2 == 117 { if c3 == 116 {
            if c4 == 100 { if c5 == 111 { if c6 == 119 { if c7 == 110 {
                _ke_cmd_shutdown(); return 0;
            } } } }
        } } } }
    }

    // "install" (7): 105 110 115 116 97 108 108
    if buf_len == 7 {
        if c0 == 105 { if c1 == 110 { if c2 == 115 { if c3 == 116 {
            if c4 == 97 { if c5 == 108 { if c6 == 108 {
                _ke_cmd_install(); return 0;
            } } }
        } } } }
    }

    // "mkfile " prefix (7+): 109 107 102 105 108 101 32
    if buf_len >= 8 {
        if c0 == 109 { if c1 == 107 { if c2 == 102 { if c3 == 105 { if c4 == 108 { if c5 == 101 {
            if c6 == 32 {
                _ke_cmd_mkfile(buf_addr, buf_len); return 0;
            }
        } } } } } }
    }

    // "sha256 " prefix (7+): 115 104 97 50 53 54 32
    if buf_len >= 7 {
        if c0 == 115 { if c1 == 104 { if c2 == 97 { if c3 == 50 { if c4 == 53 { if c5 == 54 {
            if c6 == 32 {
                _ke_cmd_sha256(buf_addr, buf_len); return 0;
            }
        } } } } } }
    }

    // "cat " prefix (4+): 99 97 116 32
    if buf_len >= 5 {
        if c0 == 99 { if c1 == 97 { if c2 == 116 { if c3 == 32 {
            _ke_cmd_cat(buf_addr, buf_len); return 0;
        } } } }
    }

    // "hmac " prefix (5+): 104 109 97 99 32
    if buf_len >= 6 {
        if c0 == 104 { if c1 == 109 { if c2 == 97 { if c3 == 99 { if c4 == 32 {
            _ke_cmd_hmac(buf_addr, buf_len); return 0;
        } } } } }
    }

    // "run " prefix (4+): 114 117 110 32
    if buf_len >= 5 {
        if c0 == 114 { if c1 == 117 { if c2 == 110 { if c3 == 32 {
            _ke_cmd_run(buf_addr, buf_len); return 0;
        } } } }
    }

    // "help" = 104 101 108 112
    if buf_len == 4 {
        if c0 == 104 { if c1 == 101 { if c2 == 108 { if c3 == 112 {
            _ke_cmd_help(); return 0;
        } } } }
        // "hkdf" = 104 107 100 102
        if c0 == 104 { if c1 == 107 { if c2 == 100 { if c3 == 102 {
            _ke_cmd_hkdf(); return 0;
        } } } }
        // "tick" = 116 105 99 107
        if c0 == 116 { if c1 == 105 { if c2 == 99 { if c3 == 107 {
            _ke_cmd_tick(); return 0;
        } } } }
        // "pmem" = 112 109 101 109
        if c0 == 112 { if c1 == 109 { if c2 == 101 { if c3 == 109 {
            _ke_cmd_pmem(); return 0;
        } } } }
        // "wget" = 119 103 101 116
        if c0 == 119 { if c1 == 103 { if c2 == 101 { if c3 == 116 {
            _ke_cmd_wget(); return 0;
        } } } }
        // "ahci" = 97 104 99 105
        if c0 == 97 { if c1 == 104 { if c2 == 99 { if c3 == 105 {
            _ke_cmd_ahci(); return 0;
        } } } }
        // "acpi" = 97 99 112 105
        if c0 == 97 { if c1 == 99 { if c2 == 112 { if c3 == 105 {
            _ke_cmd_acpi(); return 0;
        } } } }
        // "beep" = 98 101 101 112
        if c0 == 98 { if c1 == 101 { if c2 == 101 { if c3 == 112 {
            _ke_cmd_beep(); return 0;
        } } } }
        // "time" = 116 105 109 101
        if c0 == 116 { if c1 == 105 { if c2 == 109 { if c3 == 101 {
            _ke_cmd_time(); return 0;
        } } } }
        // "disk" = 100 105 115 107
        if c0 == 100 { if c1 == 105 { if c2 == 115 { if c3 == 107 {
            _ke_cmd_disk(); return 0;
        } } } }
    }

    // "pci" = 112 99 105
    if buf_len == 3 {
        if c0 == 112 { if c1 == 99 { if c2 == 105 {
            _ke_pci_scan(); return 0;
        } } }
        // "smp" = 115 109 112
        if c0 == 115 { if c1 == 109 { if c2 == 112 {
            _ke_cmd_smp(); return 0;
        } } }
        // "usb" = 117 115 98
        if c0 == 117 { if c1 == 115 { if c2 == 98 {
            _ke_cmd_usb(); return 0;
        } } }
        // "aes" = 97 101 115
        if c0 == 97 { if c1 == 101 { if c2 == 115 {
            _ke_cmd_aes(); return 0;
        } } }
        // "gcm" = 103 99 109
        if c0 == 103 { if c1 == 99 { if c2 == 109 {
            _ke_cmd_gcm(); return 0;
        } } }
        // "tls" = 116 108 115
        if c0 == 116 { if c1 == 108 { if c2 == 115 {
            _ke_cmd_tls(); return 0;
        } } }
    }

    // "ps" = 112 115
    if buf_len == 2 {
        if c0 == 112 { if c1 == 115 {
            _ke_cmd_ps(); return 0;
        } }
        // "wm" = 119 109
        if c0 == 119 { if c1 == 109 {
            _ke_cmd_wm(); return 0;
        } }
        // "ls" = 108 115
        if c0 == 108 { if c1 == 115 {
            _ke_cmd_ls(); return 0;
        } }
    }

    // "tcptest" (7): 116 99 112 116 101 115 116
    if buf_len == 7 {
        if c0 == 116 { if c1 == 99 { if c2 == 112 { if c3 == 116 { if c4 == 101 { if c5 == 115 { if c6 == 116 {
            _ke_cmd_tcptest(); return 0;
        } } } } } } }
        // "gfxtest" (7): 103 102 120 116 101 115 116
        if c0 == 103 { if c1 == 102 { if c2 == 120 { if c3 == 116 { if c4 == 101 { if c5 == 115 { if c6 == 116 {
            _ke_cmd_gfxtest(); return 0;
        } } } } } } }
    }

    // "palloc" (6) or "palloc N" (7+): 112 97 108 108 111 99
    if buf_len >= 6 {
        if c0 == 112 { if c1 == 97 { if c2 == 108 { if c3 == 108 { if c4 == 111 { if c5 == 99 {
            // Parse optional count after space
            let mut n = 1;
            if buf_len > 7 {
                // "palloc N" — read single digit after space
                let digit = mem_read_u8(buf_addr + 7);
                if digit >= 48 { if digit <= 57 { n = digit - 48; } }
                if n == 0 { n = 1; }
            }
            _ke_cmd_palloc(n); return 0;
        } } } } } }
    }

    // "pfree" (5): 112 102 114 101 101
    if buf_len == 5 {
        if c0 == 112 { if c1 == 102 { if c2 == 114 { if c3 == 101 { if c4 == 101 {
            let last = mem_read_u64(3211328);  // 0x310040
            _ke_cmd_pfree(last); return 0;
        } } } } }
        // "mfree" (5): 109 102 114 101 101
        if c0 == 109 { if c1 == 102 { if c2 == 114 { if c3 == 101 { if c4 == 101 {
            _ke_cmd_mfree(); return 0;
        } } } } }
        // "mouse" (5): 109 111 117 115 101
        if c0 == 109 { if c1 == 111 { if c2 == 117 { if c3 == 115 { if c4 == 101 {
            _ke_cmd_mouse(); return 0;
        } } } } }
    }

    // "malloc" (6) or "malloc N" (7+): 109 97 108 108 111 99
    if buf_len >= 6 {
        if c0 == 109 { if c1 == 97 { if c2 == 108 { if c3 == 108 { if c4 == 111 { if c5 == 99 {
            // Parse optional size after space
            let mut sz = 64;
            if buf_len > 7 {
                sz = 0;
                let mut di = 7;
                while di < buf_len {
                    let dch = mem_read_u8(buf_addr + di);
                    if dch >= 48 { if dch <= 57 { sz = sz * 10 + dch - 48; } }
                    di = di + 1;
                }
                if sz == 0 { sz = 64; }
            }
            _ke_cmd_malloc(sz); return 0;
        } } } } } }
        // "uptime" (6): 117 112 116 105 109 101
        if c0 == 117 { if c1 == 112 { if c2 == 116 { if c3 == 105 { if c4 == 109 { if c5 == 101 {
            _ke_cmd_uptime(); return 0;
        } } } } } }
        // "format" (6): 102 111 114 109 97 116
        if c0 == 102 { if c1 == 111 { if c2 == 114 { if c3 == 109 { if c4 == 97 { if c5 == 116 {
            _ke_cmd_format(); return 0;
        } } } } } }
    }

    // "reboot" = 114 101 98 111 111 116
    if buf_len == 6 {
        if c0 == 114 { if c1 == 101 {
            mem_write_u64(3211264, 0);
            mem_write_u64(3211272, 0);
            lidt(3211264);
            return 0;
        } }
    }

    // Unknown command: "?\r\n"
    _ke_putc(63); _ke_putc(13); _ke_putc(10);
    return 0;
}

// Interactive shell loop
fn _ke_shell() {
    let cmd_buf = 3211264;     // 0x310000: command buffer (64 bytes)
    let mut buf_len = 0;

    _ke_prompt();

    while 1 == 1 {
        hlt();

        // Check keyboard flag at 0x300010
        let key_ready = mem_read_u64(3145744);
        if key_ready != 0 {
            mem_write_u64(3145744, 0);       // clear flag
            let sc = mem_read_u64(3145736);  // read scancode

            // Ignore key-up events (bit 7 set)
            if sc < 128 {
                let ch = _ke_sc2ascii(sc);
                if ch == 10 {
                    // Enter: execute command
                    _ke_putc(13); _ke_putc(10);
                    _ke_dispatch(cmd_buf, buf_len);
                    buf_len = 0;
                    _ke_prompt();
                } else if ch == 8 {
                    // Backspace
                    if buf_len > 0 {
                        buf_len = buf_len - 1;
                        _ke_putc(8); _ke_putc(32); _ke_putc(8);
                    }
                } else if ch > 0 {
                    // Printable char: store and echo
                    if buf_len < 60 {
                        mem_write_u8(cmd_buf + buf_len, ch);
                        buf_len = buf_len + 1;
                        _ke_putc(ch);
                    }
                }
            }
        }
    }
    return 0;
}

fn _start() {
    // Phase 1: Serial init (COM1 38400 8N1)
    port_out_u8(1017, 0);    // COM1+1: disable interrupts
    port_out_u8(1019, 128);  // COM1+3: set DLAB
    port_out_u8(1016, 3);    // COM1+0: divisor lo = 3 (38400)
    port_out_u8(1017, 0);    // COM1+1: divisor hi = 0
    port_out_u8(1019, 3);    // COM1+3: 8N1
    port_out_u8(1018, 199);  // COM1+2: enable FIFO
    port_out_u8(1020, 11);   // COM1+4: IRQs + RTS/DSR
    _ke_puts_kb_ok();

    // Phase 2: PIC remap
    _ke_pic_remap();
    _ke_puts_pic_ok();

    // Phase 3: PIT 100Hz
    _ke_pit_init();
    _ke_puts_pit_ok();

    // Phase 4: IDT build + load
    _ke_idt_build();
    _ke_puts_idt_ok();

    // Phase 5: Enable interrupts
    sti();
    _ke_puts_int_ok();

    // Phase 6: Physical page allocator init (iteration 26)
    _ke_pa_init();
    _ke_cmd_pmem();

    // Phase 6b: Heap allocator init (iteration 27)
    _ke_heap_init();

    // Phase 6c: Task scheduler init (iteration 28)
    _ke_task_init();

    // Phase 7: PCI bus scan (iteration 24)
    _ke_pci_scan();

    // Phase 7b: VirtIO-net init (iteration 29)
    let vnet_dev = _ke_virtio_find();
    if vnet_dev != 255 {
        let vbar = _ke_virtio_bar0(vnet_dev);
        _ke_virtio_init(vbar);
    }

    // Phase 7c: VirtIO-blk init (iteration 41)
    let vblk_dev = _ke_virtio_blk_find();
    if vblk_dev != 255 {
        let bbar = _ke_pci_bar0(0, vblk_dev, 0);
        let bbar_io = (bbar / 4) * 4;
        _ke_virtio_blk_init(bbar_io);
    }

    // Phase 7d: Font init (iteration 32)
    _ke_font_init();

    // Phase 7e: SHA-256 constants init (iteration 48)
    _ke_sha256_init_k();

    // Phase 8: Interactive shell (iteration 25)
    _ke_shell();

    return 0;
}

// === Self-test (runs in H-L interpreter for verification) ===

print("Bootstrapping H-L: Space-locality initiated.");

let key = hilbert_encode(42, 17, 9);
print(key);

fn _ke_fib(n) {
    let mut a = 0;
    let mut b = 1;
    let mut i = 0;
    while i < n {
        let t = a + b;
        a = b;
        b = t;
        i = i + 1;
    }
    return b;
}
print(_ke_fib(10));

fn _ke_gcd(a, b) {
    while b != 0 {
        let t = b;
        b = a % b;
        a = t;
    }
    return a;
}
print(_ke_gcd(48, 18));

fn _ke_power(base, exp) {
    let mut r = 1;
    let mut i = 0;
    while i < exp {
        r = r * base;
        i = i + 1;
    }
    return r;
}
print(_ke_power(2, 10));

let mut sum = 0;
let mut i = 1;
while i <= 100 {
    sum = sum + i;
    i = i + 1;
}
print(sum);

// === Kernel Initialization Sequence ===
// Called by the native kernel after basic hardware setup.
// The interpreter runs these functions as self-test during build.

fn kernel_init() {
    print("=== HicOS Kernel Init ===");

    // Phase 0: Detect boot mode (UEFI vs Legacy BIOS)
    let is_uefi = uefi_is_boot();
    if is_uefi == 1 {
        print("[0] UEFI boot detected");
    } else {
        print("[0] Legacy BIOS boot");
    }

    // Phase 1: Memory detection
    if is_uefi == 1 {
        print("[1] UEFI memory map...");
        uefi_parse_memory_map();
        uefi_init_page_alloc();
    } else {
        print("[1] E820 memory map...");
        e820_dump();
        page_alloc_init_e820();
    }
    print("  Free pages: " + to_string(page_count_free()));

    // Phase 2: Virtual memory -- map all RAM
    print("[2] Virtual memory -- mapping all usable RAM...");
    map_all_ram();

    // Phase 3: Block cache init
    print("[3] Block cache init...");
    bcache_init();

    // Phase 4: Display
    if is_uefi == 1 {
        print("[4] UEFI GOP framebuffer...");
        uefi_init_framebuffer();
    } else {
        print("[4] VESA framebuffer...");
        vesa_auto_init();
        vesa_info();
    }

    // Phase 5: VFS + ramfs
    print("[5] Filesystem init...");
    fs_init();
    vfs_init();

    // Phase 6: Swap
    print("[6] Swap init...");
    swap_init();

    // Phase 7: Task scheduler + POSIX process model
    print("[7] Task scheduler init...");
    task_init();
    fd_init_task(0);  // setup stdin/stdout/stderr for idle task
    print("  Scheduler: CFS min-heap O(log n)");
    print("  Max tasks: " + to_string(MAX_TASKS));

    // Phase 8: Hardware detection (AHCI/USB)
    print("[8] Hardware detection...");
    ahci_init();
    usb_init();

    // Phase 9: Network stack
    print("[9] Network init...");
    net_init();
    dhcp_discover();

    // Phase 10: SMP (multi-core)
    print("[10] SMP init...");
    smp_init();

    // Phase 11: ACPI power management
    print("[11] ACPI power management...");
    power_init();

    // Phase 12: Firmware loader
    print("[12] Firmware loader...");
    firmware_init();

    // Phase 13: Secure Boot verification
    print("[13] Secure Boot...");
    secboot_init();

    // Phase 14: GPT partition detection
    print("[14] Partition table...");
    let gpt_count = gpt_read();
    if gpt_count > 0 {
        print("  GPT: " + to_string(gpt_count) + " partition(s)");
    } else {
        print("  MBR layout (legacy)");
    }

    print("=== Kernel init complete ===");
    if is_uefi == 1 { print("Boot: UEFI"); } else { print("Boot: Legacy BIOS"); }
    print("CPUs: " + to_string(smp_cpu_count()));
    return 0;
}

print("H-L kernel ready. All systems nominal.");

