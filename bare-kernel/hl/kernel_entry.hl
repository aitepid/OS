// kernel_entry.hl -- H-L Native Kernel Entry Point
//
// This is the first H-L code that runs in 64-bit long mode.
// The machine code is generated by image_builder.build() in hl-bootstrap.hl.
//
// == Boot Sequence (what the native kernel actually does) ==
//   1. Initialize COM1 serial port (8250 UART, 38400 baud)
//   2. Print boot banner: "HicOS 2.1 -- Hilbert-Lang Kernel"
//   3. Remap 8259A PIC: IRQ0-7 -> vectors 32-39, IRQ8-15 -> 40-47
//   4. Program PIT channel 0 for 100 Hz tick
//   5. Build IDT at 0x200000 (256 entries, 16 bytes each)
//      - Vector 32 (timer):   increment tick counter at 0x300000, send EOI
//      - Vector 33 (keyboard): read PS/2 scancode to 0x300008, set flag, EOI
//      - All others: IRETQ (default handler)
//   6. Load IDTR, STI (enable interrupts)
//   7. Print "IDT OK  PIT OK  KBD OK" + "HicOS> " prompt
//   8. Main loop: HLT -> check key_ready flag -> echo char via serial -> repeat
//
// == Memory Map ==
//   0x000000 - 0x000FFF : IVT / BDA (BIOS)
//   0x001000 - 0x003FFF : Page tables (PML4/PDPT/PD)
//   0x007C00 - 0x007DFF : Stage 1 (MBR)
//   0x008000 - 0x00BFFF : Stage 2
//   0x070000            : Stack top
//   0x100000 - 0x1FFFFF : Kernel code (1 MB)
//   0x1FFFF6 - 0x1FFFFF : IDTR (10 bytes)
//   0x200000 - 0x200FFF : IDT (4096 bytes)
//   0x300000            : Tick counter (u64)
//   0x300008            : Last scancode (u64)
//   0x300010            : Key ready flag (u64)
//
// == H-L Spatial Representation ==
// The kernel occupies quadrant (2,0,0) in the Hilbert address space.
//   (2,0,0) -- entry + serial init
//   (2,1,0) -- memory/heap
//   (2,0,1) -- scheduler
//   (2,1,1) -- IPC
//   (2,2,0) -- filesystem
//   (2,2,1) -- drivers

// === Native Entry Point (_start) ===
// This is the FIRST function in kernel.bin (offset 0).
// Called by the handwritten Stage2 kernel via CALL after hardware init.
//
// Iteration 23: Full boot sequence
//   1. Serial init (COM1 38400 8N1)
//   2. PIC remap (IRQ0→32, IRQ8→40)
//   3. PIT 100Hz timer
//   4. IDT build (256 entries + ISR thunks + common handler)
//   5. LIDT + STI
//   6. Main loop: HLT → check timer tick → check keyboard → echo
//
// ABI contract:
//   - CPU is in 64-bit long mode, interrupts disabled (by handwritten kernel)
//   - Stack pointer is valid (set by Stage2)
//   - kernel.bin is loaded at 0x120000
//   - Tick counter at 0x300000, last scancode at 0x300008, key_ready at 0x300010

// Helper: check if vector has CPU-pushed error code
fn _ke_has_cpu_err(vec) {
    if vec == 8 { return 1; }
    if vec == 10 { return 1; }
    if vec == 11 { return 1; }
    if vec == 12 { return 1; }
    if vec == 13 { return 1; }
    if vec == 14 { return 1; }
    if vec == 17 { return 1; }
    if vec == 21 { return 1; }
    if vec == 29 { return 1; }
    if vec == 30 { return 1; }
    return 0;
}

// Helper: serial putchar (blocking TX wait)
fn _ke_putc(ch) {
    let mut ready = 0;
    while ready == 0 {
        let status = port_in_u8(1021); // COM1+5: line status
        ready = status / 32 % 2;       // bit 5 = TX empty
    }
    port_out_u8(1016, ch);             // COM1+0: data
    return 0;
}

// Helper: print a short fixed string via serial (avoids arrays)
fn _ke_puts_kb_ok() {
    _ke_putc(75); _ke_putc(66); _ke_putc(45);       // "KB-"
    _ke_putc(79); _ke_putc(75);                       // "OK"
    _ke_putc(13); _ke_putc(10);                       // "\r\n"
    return 0;
}

fn _ke_puts_pic_ok() {
    _ke_putc(80); _ke_putc(73); _ke_putc(67);        // "PIC"
    _ke_putc(32); _ke_putc(79); _ke_putc(75);        // " OK"
    _ke_putc(13); _ke_putc(10);
    return 0;
}

fn _ke_puts_pit_ok() {
    _ke_putc(80); _ke_putc(73); _ke_putc(84);        // "PIT"
    _ke_putc(32); _ke_putc(79); _ke_putc(75);        // " OK"
    _ke_putc(13); _ke_putc(10);
    return 0;
}

fn _ke_puts_idt_ok() {
    _ke_putc(73); _ke_putc(68); _ke_putc(84);        // "IDT"
    _ke_putc(32); _ke_putc(79); _ke_putc(75);        // " OK"
    _ke_putc(13); _ke_putc(10);
    return 0;
}

fn _ke_puts_int_ok() {
    _ke_putc(73); _ke_putc(78); _ke_putc(84);        // "INT"
    _ke_putc(45); _ke_putc(79); _ke_putc(75);        // "-OK"
    _ke_putc(13); _ke_putc(10);
    return 0;
}

// PIC remap: IRQ0-7 → vectors 32-39, IRQ8-15 → vectors 40-47
fn _ke_pic_remap() {
    // ICW1: init + ICW4 needed
    port_out_u8(32, 17);    // 0x20: PIC1 command
    port_out_u8(160, 17);   // 0xA0: PIC2 command
    // ICW2: vector offset
    port_out_u8(33, 32);    // 0x21: PIC1 data → IRQ0 = vector 32
    port_out_u8(161, 40);   // 0xA1: PIC2 data → IRQ8 = vector 40
    // ICW3: cascade
    port_out_u8(33, 4);     // 0x21: PIC1 has slave on IRQ2
    port_out_u8(161, 2);    // 0xA1: PIC2 cascade identity 2
    // ICW4: 8086 mode
    port_out_u8(33, 1);     // 0x21
    port_out_u8(161, 1);    // 0xA1
    // Mask all except IRQ0 (timer) and IRQ1 (keyboard)
    port_out_u8(33, 252);   // 0x21: 0xFC
    port_out_u8(161, 255);  // 0xA1: 0xFF
    return 0;
}

// PIT channel 0, mode 3 (square wave), 100 Hz
fn _ke_pit_init() {
    port_out_u8(67, 54);    // 0x43: 0x36 = channel 0, mode 3, lo/hi
    // Divisor = 11932 (1193182 / 100 Hz): lo=0x9C(156) hi=0x2E(46)
    port_out_u8(64, 156);   // 0x40: lo byte
    port_out_u8(64, 46);    // 0x40: hi byte
    return 0;
}

// Write a 32-bit little-endian value via 4x mem_write_u8
fn _ke_mem_w32(addr, val) {
    mem_write_u8(addr, val % 256);
    mem_write_u8(addr + 1, (val / 256) % 256);
    mem_write_u8(addr + 2, (val / 65536) % 256);
    mem_write_u8(addr + 3, (val / 16777216) % 256);
    return 0;
}

// Build ISR thunks at isr_base, common handler, and IDT entries
fn _ke_idt_build() {
    let idt_base = 2097152;   // 0x200000
    let isr_base = 2162688;   // 0x210000
    let common_addr = isr_base + 4096;  // 256 * 16 = 4096

    // === Write per-vector ISR thunks (256 x 16 bytes) ===
    let mut vec = 0;
    while vec < 256 {
        let ta = isr_base + vec * 16;
        let mut off = 0;

        if _ke_has_cpu_err(vec) == 0 {
            // push 0 (dummy error code): 6A 00
            mem_write_u8(ta + off, 106); off = off + 1;
            mem_write_u8(ta + off, 0);   off = off + 1;
        }
        // push vector#: 6A vec
        mem_write_u8(ta + off, 106); off = off + 1;
        mem_write_u8(ta + off, vec % 256); off = off + 1;

        // jmp common: E9 rel32
        let jmp_src = ta + off + 5;
        let rel = common_addr - jmp_src;
        mem_write_u8(ta + off, 233); off = off + 1;
        _ke_mem_w32(ta + off, rel); off = off + 4;

        // Pad to 16 bytes with NOP (0x90)
        while off < 16 {
            mem_write_u8(ta + off, 144);
            off = off + 1;
        }
        vec = vec + 1;
    }

    // === Common ISR handler at common_addr ===
    let ca = common_addr;
    let mut p = 0;

    // Save GP regs: push rax rcx rdx rbx rsi rdi
    mem_write_u8(ca + p, 80); p = p + 1;   // push rax
    mem_write_u8(ca + p, 81); p = p + 1;   // push rcx
    mem_write_u8(ca + p, 82); p = p + 1;   // push rdx
    mem_write_u8(ca + p, 83); p = p + 1;   // push rbx
    mem_write_u8(ca + p, 86); p = p + 1;   // push rsi
    mem_write_u8(ca + p, 87); p = p + 1;   // push rdi
    // push r8-r15 (REX.B + push)
    let mut ri = 8;
    while ri <= 15 {
        mem_write_u8(ca + p, 65); p = p + 1;
        mem_write_u8(ca + p, 80 + ri - 8); p = p + 1;
        ri = ri + 1;
    }

    // Load vector# from stack: mov rdi, [rsp+112] (14 regs * 8 = 112)
    // 48 8B 7C 24 70
    mem_write_u8(ca + p, 72); p = p + 1;
    mem_write_u8(ca + p, 139); p = p + 1;
    mem_write_u8(ca + p, 124); p = p + 1;
    mem_write_u8(ca + p, 36); p = p + 1;
    mem_write_u8(ca + p, 112); p = p + 1;

    // --- Timer (vector 32): inc tick counter ---
    // cmp rdi, 32: 48 83 FF 20
    mem_write_u8(ca + p, 72); p = p + 1;
    mem_write_u8(ca + p, 131); p = p + 1;
    mem_write_u8(ca + p, 255); p = p + 1;
    mem_write_u8(ca + p, 32); p = p + 1;
    // jne +14: 75 0E
    mem_write_u8(ca + p, 117); p = p + 1;
    mem_write_u8(ca + p, 14); p = p + 1;
    // inc qword [0x300000]: 48 FF 04 25 00 00 30 00
    mem_write_u8(ca + p, 72); p = p + 1;
    mem_write_u8(ca + p, 255); p = p + 1;
    mem_write_u8(ca + p, 4); p = p + 1;
    mem_write_u8(ca + p, 37); p = p + 1;
    _ke_mem_w32(ca + p, 3145728); p = p + 4;  // 0x300000
    // jmp send_eoi: EB 1A (26 bytes forward)
    mem_write_u8(ca + p, 235); p = p + 1;
    mem_write_u8(ca + p, 26); p = p + 1;

    // --- Keyboard (vector 33): read scancode ---
    // cmp rdi, 33: 48 83 FF 21
    mem_write_u8(ca + p, 72); p = p + 1;
    mem_write_u8(ca + p, 131); p = p + 1;
    mem_write_u8(ca + p, 255); p = p + 1;
    mem_write_u8(ca + p, 33); p = p + 1;
    // jne +18: 75 12
    mem_write_u8(ca + p, 117); p = p + 1;
    mem_write_u8(ca + p, 18); p = p + 1;
    // in al, 0x60: E4 60
    mem_write_u8(ca + p, 228); p = p + 1;
    mem_write_u8(ca + p, 96); p = p + 1;
    // movzx rax, al: 48 0F B6 C0
    mem_write_u8(ca + p, 72); p = p + 1;
    mem_write_u8(ca + p, 15); p = p + 1;
    mem_write_u8(ca + p, 182); p = p + 1;
    mem_write_u8(ca + p, 192); p = p + 1;
    // mov [0x300008], rax: 48 89 04 25 08 00 30 00
    mem_write_u8(ca + p, 72); p = p + 1;
    mem_write_u8(ca + p, 137); p = p + 1;
    mem_write_u8(ca + p, 4); p = p + 1;
    mem_write_u8(ca + p, 37); p = p + 1;
    _ke_mem_w32(ca + p, 3145736); p = p + 4;  // 0x300008
    // mov qword [0x300010], 1: 48 C7 04 25 10 00 30 00 01 00 00 00
    mem_write_u8(ca + p, 72); p = p + 1;
    mem_write_u8(ca + p, 199); p = p + 1;
    mem_write_u8(ca + p, 4); p = p + 1;
    mem_write_u8(ca + p, 37); p = p + 1;
    _ke_mem_w32(ca + p, 3145744); p = p + 4;  // 0x300010
    _ke_mem_w32(ca + p, 1); p = p + 4;        // value = 1

    // --- send_eoi ---
    // mov al, 0x20; out 0x20, al: B0 20 E6 20
    mem_write_u8(ca + p, 176); p = p + 1;
    mem_write_u8(ca + p, 32); p = p + 1;
    mem_write_u8(ca + p, 230); p = p + 1;
    mem_write_u8(ca + p, 32); p = p + 1;
    // cmp rdi, 40; jb +4: 48 83 FF 28 72 04
    mem_write_u8(ca + p, 72); p = p + 1;
    mem_write_u8(ca + p, 131); p = p + 1;
    mem_write_u8(ca + p, 255); p = p + 1;
    mem_write_u8(ca + p, 40); p = p + 1;
    mem_write_u8(ca + p, 114); p = p + 1;
    mem_write_u8(ca + p, 4); p = p + 1;
    // PIC2 EOI: mov al, 0x20; out 0xA0, al: B0 20 E6 A0
    mem_write_u8(ca + p, 176); p = p + 1;
    mem_write_u8(ca + p, 32); p = p + 1;
    mem_write_u8(ca + p, 230); p = p + 1;
    mem_write_u8(ca + p, 160); p = p + 1;

    // --- Restore GP regs ---
    ri = 15;
    while ri >= 8 {
        mem_write_u8(ca + p, 65); p = p + 1;
        mem_write_u8(ca + p, 88 + ri - 8); p = p + 1;
        ri = ri - 1;
    }
    mem_write_u8(ca + p, 95); p = p + 1;   // pop rdi
    mem_write_u8(ca + p, 94); p = p + 1;   // pop rsi
    mem_write_u8(ca + p, 91); p = p + 1;   // pop rbx
    mem_write_u8(ca + p, 90); p = p + 1;   // pop rdx
    mem_write_u8(ca + p, 89); p = p + 1;   // pop rcx
    mem_write_u8(ca + p, 88); p = p + 1;   // pop rax
    // add rsp, 16: 48 83 C4 10
    mem_write_u8(ca + p, 72); p = p + 1;
    mem_write_u8(ca + p, 131); p = p + 1;
    mem_write_u8(ca + p, 196); p = p + 1;
    mem_write_u8(ca + p, 16); p = p + 1;
    // iretq: 48 CF
    mem_write_u8(ca + p, 72); p = p + 1;
    mem_write_u8(ca + p, 207); p = p + 1;

    // === Build IDT entries (256 x 16 bytes at idt_base) ===
    vec = 0;
    while vec < 256 {
        let isr_addr = isr_base + vec * 16;
        let ent = idt_base + vec * 16;
        // offset_low (bits 0-15)
        mem_write_u8(ent, isr_addr % 256);
        mem_write_u8(ent + 1, (isr_addr / 256) % 256);
        // selector = 0x08 (kernel CS)
        mem_write_u8(ent + 2, 8);
        mem_write_u8(ent + 3, 0);
        // IST = 0
        mem_write_u8(ent + 4, 0);
        // type_attr = 0x8E (present, DPL=0, 64-bit interrupt gate)
        mem_write_u8(ent + 5, 142);
        // offset_mid (bits 16-31)
        mem_write_u8(ent + 6, (isr_addr / 65536) % 256);
        mem_write_u8(ent + 7, (isr_addr / 16777216) % 256);
        // offset_high (bits 32-63) = 0 (addresses < 4 GB)
        _ke_mem_w32(ent + 8, 0);
        // reserved
        _ke_mem_w32(ent + 12, 0);
        vec = vec + 1;
    }

    // === IDTR descriptor at 0x1FFFF6 (limit 2B + base 8B) ===
    let idtr = 2097142;  // 0x1FFFF6
    // limit = 256*16 - 1 = 4095 = 0x0FFF
    mem_write_u8(idtr, 255);     // 0xFF
    mem_write_u8(idtr + 1, 15);  // 0x0F
    // base = 0x200000
    mem_write_u8(idtr + 2, 0);
    mem_write_u8(idtr + 3, 0);
    mem_write_u8(idtr + 4, 32);  // 0x20
    mem_write_u8(idtr + 5, 0);
    mem_write_u8(idtr + 6, 0);
    mem_write_u8(idtr + 7, 0);
    mem_write_u8(idtr + 8, 0);
    mem_write_u8(idtr + 9, 0);

    lidt(idtr);
    return 0;
}

// === Iteration 24: PCI Bus Scan ===
// PCI config space via I/O ports 0xCF8 (address) / 0xCFC (data)

fn _ke_pci_read32(bus, dev, func, offset) {
    let addr = 2147483648       // bit 31 = enable (0x80000000)
             + bus * 65536      // bits 23:16
             + dev * 2048       // bits 15:11
             + func * 256       // bits 10:8
             + (offset / 4) * 4; // bits 7:2
    port_out_u32(3320, addr);   // 0xCF8
    return port_in_u32(3324);   // 0xCFC
}

fn _ke_pci_vendor(bus, dev, func) {
    let dword = _ke_pci_read32(bus, dev, func, 0);
    return dword % 65536;       // lower 16 bits
}

fn _ke_pci_device(bus, dev, func) {
    let dword = _ke_pci_read32(bus, dev, func, 0);
    return (dword / 65536) % 65536;
}

fn _ke_pci_class(bus, dev, func) {
    let reg = _ke_pci_read32(bus, dev, func, 8);
    return (reg / 16777216) % 256;  // bits 31:24
}

fn _ke_pci_subclass(bus, dev, func) {
    let reg = _ke_pci_read32(bus, dev, func, 8);
    return (reg / 65536) % 256;     // bits 23:16
}

// Print hex nibble (0-F) via serial
fn _ke_put_hex4(val) {
    let n = val % 16;
    if n < 10 {
        _ke_putc(48 + n);      // '0'-'9'
    } else {
        _ke_putc(55 + n);      // 'A'-'F'
    }
    return 0;
}

// Print 16-bit hex value via serial
fn _ke_put_hex16(val) {
    _ke_put_hex4(val / 4096);
    _ke_put_hex4(val / 256);
    _ke_put_hex4(val / 16);
    _ke_put_hex4(val);
    return 0;
}

fn _ke_puts_pci_ok(count) {
    // "PCI: " + count + " dev\r\n"
    _ke_putc(80); _ke_putc(67); _ke_putc(73); _ke_putc(58); _ke_putc(32);
    // print count as decimal (0-99)
    if count >= 10 { _ke_putc(48 + count / 10); }
    _ke_putc(48 + count % 10);
    // " dev\r\n"
    _ke_putc(32); _ke_putc(100); _ke_putc(101); _ke_putc(118);
    _ke_putc(13); _ke_putc(10);
    return 0;
}

// Print one PCI device: "  DD: VVVV:DDDD cls=CC.SS\r\n"
fn _ke_pci_print_dev(dev, vendor, devid, cls, sub) {
    _ke_putc(32); _ke_putc(32);              // "  "
    _ke_put_hex4(dev / 16); _ke_put_hex4(dev); // device slot
    _ke_putc(58); _ke_putc(32);              // ": "
    _ke_put_hex16(vendor);                    // vendor ID
    _ke_putc(58);                             // ":"
    _ke_put_hex16(devid);                     // device ID
    _ke_putc(32);                             // " "
    _ke_put_hex4(cls / 16); _ke_put_hex4(cls); // class
    _ke_putc(46);                             // "."
    _ke_put_hex4(sub / 16); _ke_put_hex4(sub); // subclass
    _ke_putc(13); _ke_putc(10);              // "\r\n"
    return 0;
}

// Scan PCI bus 0, report devices via serial
fn _ke_pci_scan() {
    let mut count = 0;
    let mut dev = 0;
    while dev < 32 {
        let vendor = _ke_pci_vendor(0, dev, 0);
        if vendor != 65535 {     // 0xFFFF = no device
            let devid = _ke_pci_device(0, dev, 0);
            let cls = _ke_pci_class(0, dev, 0);
            let sub = _ke_pci_subclass(0, dev, 0);
            _ke_pci_print_dev(dev, vendor, devid, cls, sub);
            count = count + 1;
        }
        dev = dev + 1;
    }
    _ke_puts_pci_ok(count);
    return count;
}

// === Iteration 26: Physical Page Allocator ===
// Bitmap at 0x400000, 4KB pages, reserved 0..1535 (0x000000-0x5FFFFF)

fn _ke_pa_init() {
    let bm = 4194304;           // 0x400000: bitmap addr
    let total = 32768;          // 128MB / 4KB = 32768 pages
    let bm_bytes = 4096;        // 32768 / 8 = 4096 bytes
    let reserved = 1536;        // pages 0..1535 reserved

    // Zero entire bitmap
    let mut i = 0;
    while i < bm_bytes {
        mem_write_u8(bm + i, 0);
        i = i + 1;
    }
    // Mark reserved pages as used (192 full bytes = 1536 bits = 1536 pages)
    let full = reserved / 8;
    i = 0;
    while i < full {
        mem_write_u8(bm + i, 255);
        i = i + 1;
    }
    // Store total pages at 0x400FFC and free count at 0x400FF8
    _ke_mem_w32(4198396, total);            // 0x400FFC: total pages
    _ke_mem_w32(4198392, total - reserved); // 0x400FF8: free count
    return 0;
}

// Allocate one 4KB page, return physical address or 0
fn _ke_pa_alloc() {
    let bm = 4194304;
    let total = mem_read_u32(4198396);  // read total from 0x400FFC
    let mut page = 1536;                // start at first free page
    while page < total {
        let bidx = page / 8;
        let boff = page % 8;
        let bval = mem_read_u8(bm + bidx);
        // Check bit: (bval >> boff) & 1
        let mut shift = 1;
        let mut s = 0;
        while s < boff { shift = shift * 2; s = s + 1; }
        if bval / shift % 2 == 0 {
            // Free — mark used
            mem_write_u8(bm + bidx, bval + shift);
            // Decrement free count
            let fc = mem_read_u32(4198392);
            _ke_mem_w32(4198392, fc - 1);
            return page * 4096;
        }
        page = page + 1;
    }
    return 0;
}

// Allocate N contiguous pages, return base physical address or 0
fn _ke_pa_alloc_n(count) {
    let bm = 4194304;
    let total = mem_read_u32(4198396);
    let mut start = 1536;
    while start + count <= total {
        let mut ok = 1;
        let mut i = 0;
        while i < count {
            let page = start + i;
            let bidx = page / 8;
            let boff = page % 8;
            let bval = mem_read_u8(bm + bidx);
            let mut shift = 1;
            let mut s = 0;
            while s < boff { shift = shift * 2; s = s + 1; }
            if bval / shift % 2 == 1 {
                ok = 0;
                i = count; // break
            }
            i = i + 1;
        }
        if ok == 1 {
            i = 0;
            while i < count {
                let page = start + i;
                let bidx = page / 8;
                let boff = page % 8;
                let bval = mem_read_u8(bm + bidx);
                let mut shift = 1;
                let mut s = 0;
                while s < boff { shift = shift * 2; s = s + 1; }
                mem_write_u8(bm + bidx, bval + shift);
                i = i + 1;
            }
            let fc = mem_read_u32(4198392);
            _ke_mem_w32(4198392, fc - count);
            return start * 4096;
        }
        start = start + 1;
    }
    return 0;
}

// Free a page by physical address
fn _ke_pa_free(addr) {
    let page = addr / 4096;
    if page < 1536 { return 0; }
    let total = mem_read_u32(4198396);
    if page >= total { return 0; }
    let bm = 4194304;
    let bidx = page / 8;
    let boff = page % 8;
    let bval = mem_read_u8(bm + bidx);
    let mut shift = 1;
    let mut s = 0;
    while s < boff { shift = shift * 2; s = s + 1; }
    if bval / shift % 2 == 1 {
        mem_write_u8(bm + bidx, bval - shift);
        let fc = mem_read_u32(4198392);
        _ke_mem_w32(4198392, fc + 1);
        return 1;
    }
    return 0;
}

// Count free pages
fn _ke_pa_free_count() {
    return mem_read_u32(4198392);
}

// Print memory status
fn _ke_cmd_pmem() {
    let total = mem_read_u32(4198396);
    let free = mem_read_u32(4198392);
    let used = total - free;
    // "MEM: T=NNNNN F=NNNNN U=NNNNN\r\n"
    _ke_putc(77); _ke_putc(69); _ke_putc(77); _ke_putc(58); _ke_putc(32);
    // T=
    _ke_putc(84); _ke_putc(61);
    _ke_put_dec(total);
    _ke_putc(32);
    // F=
    _ke_putc(70); _ke_putc(61);
    _ke_put_dec(free);
    _ke_putc(32);
    // U=
    _ke_putc(85); _ke_putc(61);
    _ke_put_dec(used);
    _ke_putc(13); _ke_putc(10);
    return 0;
}

// Print decimal number (generic, up to 10 digits)
fn _ke_put_dec(val) {
    if val == 0 { _ke_putc(48); return 0; }
    let mut d9 = val / 1000000000;
    let mut rem = val % 1000000000;
    let mut d8 = rem / 100000000; rem = rem % 100000000;
    let mut d7 = rem / 10000000; rem = rem % 10000000;
    let mut d6 = rem / 1000000; rem = rem % 1000000;
    let mut d5 = rem / 100000; rem = rem % 100000;
    let mut d4 = rem / 10000; rem = rem % 10000;
    let mut d3 = rem / 1000; rem = rem % 1000;
    let mut d2 = rem / 100; rem = rem % 100;
    let mut d1 = rem / 10;
    let mut d0 = rem % 10;
    let mut started = 0;
    if d9 > 0 { _ke_putc(48 + d9); started = 1; }
    if d8 > 0 { _ke_putc(48 + d8); started = 1; } else if started != 0 { _ke_putc(48); }
    if d7 > 0 { _ke_putc(48 + d7); started = 1; } else if started != 0 { _ke_putc(48); }
    if d6 > 0 { _ke_putc(48 + d6); started = 1; } else if started != 0 { _ke_putc(48); }
    if d5 > 0 { _ke_putc(48 + d5); started = 1; } else if started != 0 { _ke_putc(48); }
    if d4 > 0 { _ke_putc(48 + d4); started = 1; } else if started != 0 { _ke_putc(48); }
    if d3 > 0 { _ke_putc(48 + d3); started = 1; } else if started != 0 { _ke_putc(48); }
    if d2 > 0 { _ke_putc(48 + d2); started = 1; } else if started != 0 { _ke_putc(48); }
    if d1 > 0 { _ke_putc(48 + d1); started = 1; } else if started != 0 { _ke_putc(48); }
    _ke_putc(48 + d0);
    return 0;
}

// Command: palloc N — allocate N pages, show address
fn _ke_cmd_palloc(n) {
    if n < 1 { n = 1; }
    let addr = 0;
    if n == 1 {
        addr = _ke_pa_alloc();
    } else {
        addr = _ke_pa_alloc_n(n);
    }
    if addr == 0 {
        // "OOM\r\n"
        _ke_putc(79); _ke_putc(79); _ke_putc(77); _ke_putc(13); _ke_putc(10);
    } else {
        // Store last alloc addr at 0x310040 for pfree
        mem_write_u64(3211328, addr);
        // "0x" + hex address + "\r\n"
        _ke_putc(48); _ke_putc(120);
        _ke_put_hex16(addr / 65536);
        _ke_put_hex16(addr);
        _ke_putc(13); _ke_putc(10);
    }
    return 0;
}

// Command: pfree ADDR — free page (hex addr parsed from 2nd char onward)
fn _ke_cmd_pfree(addr) {
    let result = _ke_pa_free(addr);
    if result == 1 {
        _ke_putc(79); _ke_putc(75); _ke_putc(13); _ke_putc(10);
    } else {
        _ke_putc(69); _ke_putc(82); _ke_putc(82); _ke_putc(13); _ke_putc(10);
    }
    return 0;
}

// === Iteration 27: Heap Allocator (kmalloc/kfree) ===
// Simple first-fit free-list allocator on top of page allocator.
// Heap region: 0x700000 - 0x7FFFFF (1MB, 256 pages)
// Each block header (16 bytes at block start):
//   [0..7]  : size (u64) — usable size, not including header
//   [8..15] : next_free (u64) — pointer to next free block, 0 = none
// Allocated blocks: header.next_free = 0xDEAD (sentinel: in-use)
// Free list head stored at 0x6FFFF0 (u64)
// Heap initialized flag at 0x6FFFF8 (u64, 1 = initialized)

fn _ke_heap_init() {
    // Allocate 256 pages (1MB) starting at 0x700000
    // Since this is within our known-free range, just mark pages used
    let heap_base = 7340032;     // 0x700000
    let heap_size = 1048576;     // 0x100000 = 1MB
    let hdr_size = 16;

    // Mark heap pages as used in page allocator
    let mut pg = heap_base / 4096;
    let pg_end = (heap_base + heap_size) / 4096;
    while pg < pg_end {
        // Just mark them used (they're in the free range)
        let bm = 4194304;
        let bidx = pg / 8;
        let boff = pg % 8;
        let bval = mem_read_u8(bm + bidx);
        let mut shift = 1;
        let mut s = 0;
        while s < boff { shift = shift * 2; s = s + 1; }
        if bval / shift % 2 == 0 {
            mem_write_u8(bm + bidx, bval + shift);
            let fc = mem_read_u32(4198392);
            _ke_mem_w32(4198392, fc - 1);
        }
        pg = pg + 1;
    }

    // Initialize heap: one big free block spanning entire heap
    // Block header at heap_base: size = heap_size - hdr_size, next_free = 0
    mem_write_u64(heap_base, heap_size - hdr_size);
    mem_write_u64(heap_base + 8, 0);

    // Free list head → heap_base
    mem_write_u64(7340016, heap_base);   // 0x6FFFF0: free list head
    mem_write_u64(7340024, 1);           // 0x6FFFF8: initialized flag
    return 0;
}

// kmalloc: allocate 'size' bytes, return pointer or 0
fn _ke_kmalloc(size) {
    let hdr_size = 16;
    // Round size up to 16-byte alignment
    let alloc_size = ((size + 15) / 16) * 16;
    if alloc_size < 16 { alloc_size = 16; }

    // Walk free list
    let mut prev_ptr = 7340016;    // address that holds pointer to current block
    let mut cur = mem_read_u64(7340016);  // free list head

    while cur != 0 {
        let blk_size = mem_read_u64(cur);
        let blk_next = mem_read_u64(cur + 8);

        if blk_size >= alloc_size {
            // Found a fit
            if blk_size >= alloc_size + hdr_size + 16 {
                // Split: create new free block after allocated portion
                let new_blk = cur + hdr_size + alloc_size;
                let new_size = blk_size - alloc_size - hdr_size;
                mem_write_u64(new_blk, new_size);
                mem_write_u64(new_blk + 8, blk_next);

                // Update current block
                mem_write_u64(cur, alloc_size);
                mem_write_u64(cur + 8, 57005);  // 0xDEAD = in-use sentinel

                // Update prev pointer to skip current, point to new_blk
                mem_write_u64(prev_ptr, new_blk);
            } else {
                // Use entire block (no split)
                mem_write_u64(cur + 8, 57005);  // 0xDEAD
                // Unlink from free list
                mem_write_u64(prev_ptr, blk_next);
            }
            // Return pointer after header
            return cur + hdr_size;
        }

        prev_ptr = cur + 8;
        cur = blk_next;
    }
    return 0;  // out of memory
}

// kfree: free block at ptr (pointer returned by kmalloc)
fn _ke_kfree(ptr) {
    if ptr == 0 { return 0; }
    let hdr_size = 16;
    let blk = ptr - hdr_size;
    let blk_size = mem_read_u64(blk);

    // Sanity check: must have been allocated (sentinel 0xDEAD)
    let sentinel = mem_read_u64(blk + 8);
    if sentinel != 57005 { return 0; }

    // Add to free list head
    let old_head = mem_read_u64(7340016);
    mem_write_u64(blk + 8, old_head);
    mem_write_u64(7340016, blk);
    return 1;
}

// Command: malloc N — allocate N bytes
fn _ke_cmd_malloc(size) {
    if size < 1 { size = 64; }
    let ptr = _ke_kmalloc(size);
    if ptr == 0 {
        _ke_putc(79); _ke_putc(79); _ke_putc(77); _ke_putc(13); _ke_putc(10);
    } else {
        // Store last malloc ptr at 0x310048 for mfree
        mem_write_u64(3211336, ptr);  // 0x310048
        _ke_putc(48); _ke_putc(120);
        _ke_put_hex16(ptr / 65536);
        _ke_put_hex16(ptr);
        _ke_putc(32);
        // Show size
        _ke_put_dec(size);
        _ke_putc(66);  // 'B'
        _ke_putc(13); _ke_putc(10);
    }
    return 0;
}

// Command: mfree — free last malloc'd block
fn _ke_cmd_mfree() {
    let ptr = mem_read_u64(3211336);  // 0x310048
    if ptr == 0 {
        _ke_putc(69); _ke_putc(82); _ke_putc(82); _ke_putc(13); _ke_putc(10);
    } else {
        let result = _ke_kfree(ptr);
        mem_write_u64(3211336, 0);
        if result == 1 {
            _ke_putc(79); _ke_putc(75); _ke_putc(13); _ke_putc(10);
        } else {
            _ke_putc(69); _ke_putc(82); _ke_putc(82); _ke_putc(13); _ke_putc(10);
        }
    }
    return 0;
}

// === Iteration 28: Cooperative Task Scheduler ===
// Task table at 0x320000 (up to 16 tasks, 64 bytes each = 1024 bytes)
// Per-task layout (64 bytes at 0x320000 + tid*64):
//   [0..7]   : state (0=free, 1=ready, 2=running, 3=blocked)
//   [8..15]  : rsp (saved stack pointer)
//   [16..23] : rip (entry point / resume address)
//   [24..31] : vruntime (virtual runtime counter)
//   [32..39] : stack_base (allocated stack base address)
//   [40..47] : name char 0-7
// Current task ID at 0x320400 (u64)
// Task count at 0x320408 (u64)

fn _ke_task_init() {
    let tbl = 3276800;  // 0x320000
    // Zero task table (16 * 64 = 1024 bytes)
    let mut i = 0;
    while i < 1024 {
        mem_write_u8(tbl + i, 0);
        i = i + 1;
    }
    // Task 0 = idle/shell (state=2 running)
    mem_write_u64(tbl, 2);        // state = running
    mem_write_u64(tbl + 24, 0);   // vruntime = 0
    // Name: "idle"
    mem_write_u8(tbl + 40, 105); mem_write_u8(tbl + 41, 100);
    mem_write_u8(tbl + 42, 108); mem_write_u8(tbl + 43, 101);

    // Current task = 0, count = 1
    mem_write_u64(3277828, 0);    // 0x320400 + 4 = current
    mem_write_u64(3277832, 1);    // 0x320408: count
    return 0;
}

// Create a new task (returns tid or -1)
fn _ke_task_create(entry, name_ch) {
    let tbl = 3276800;
    let count = mem_read_u64(3277832);
    if count >= 16 { return 0; }

    let tid = count;
    let base = tbl + tid * 64;

    // Allocate 4KB stack
    let stack = _ke_pa_alloc();
    if stack == 0 { return 0; }

    mem_write_u64(base, 1);              // state = ready
    mem_write_u64(base + 8, stack + 4088); // rsp = top of 4KB stack (16-aligned)
    mem_write_u64(base + 16, entry);     // rip = entry point
    mem_write_u64(base + 24, 0);         // vruntime = 0
    mem_write_u64(base + 32, stack);     // stack_base
    mem_write_u8(base + 40, name_ch);    // single-char name

    mem_write_u64(3277832, count + 1);
    return tid;
}

// Command: ps — show task list
fn _ke_cmd_ps() {
    let tbl = 3276800;
    let count = mem_read_u64(3277832);
    let cur = mem_read_u64(3277828);
    // "PID ST VRT  NAME\r\n"
    _ke_putc(80); _ke_putc(73); _ke_putc(68); _ke_putc(32);
    _ke_putc(83); _ke_putc(84); _ke_putc(32);
    _ke_putc(86); _ke_putc(82); _ke_putc(84); _ke_putc(32); _ke_putc(32);
    _ke_putc(78); _ke_putc(65); _ke_putc(77); _ke_putc(69);
    _ke_putc(13); _ke_putc(10);

    let mut tid = 0;
    while tid < count {
        let base = tbl + tid * 64;
        let state = mem_read_u64(base);
        if state > 0 {
            // TID
            _ke_put_dec(tid); _ke_putc(32); _ke_putc(32); _ke_putc(32);
            // State
            if state == 1 { _ke_putc(82); }       // R(eady)
            else if state == 2 { _ke_putc(42); }  // * (running)
            else if state == 3 { _ke_putc(66); }  // B(locked)
            else { _ke_putc(63); }
            _ke_putc(32); _ke_putc(32);
            // vruntime
            let vrt = mem_read_u64(base + 24);
            _ke_put_dec(vrt);
            _ke_putc(32); _ke_putc(32);
            // Name (first char)
            let nch = mem_read_u8(base + 40);
            if nch > 0 { _ke_putc(nch); }
            _ke_putc(13); _ke_putc(10);
        }
        tid = tid + 1;
    }
    return 0;
}

// === Iteration 25: Scancode → ASCII + Interactive Shell ===

// PS/2 set 1 scancode to ASCII (lowercase, common keys only)
fn _ke_sc2ascii(sc) {
    if sc == 2 { return 49; }    // '1'
    if sc == 3 { return 50; }    // '2'
    if sc == 4 { return 51; }    // '3'
    if sc == 5 { return 52; }    // '4'
    if sc == 6 { return 53; }    // '5'
    if sc == 7 { return 54; }    // '6'
    if sc == 8 { return 55; }    // '7'
    if sc == 9 { return 56; }    // '8'
    if sc == 10 { return 57; }   // '9'
    if sc == 11 { return 48; }   // '0'
    if sc == 16 { return 113; }  // 'q'
    if sc == 17 { return 119; }  // 'w'
    if sc == 18 { return 101; }  // 'e'
    if sc == 19 { return 114; }  // 'r'
    if sc == 20 { return 116; }  // 't'
    if sc == 21 { return 121; }  // 'y'
    if sc == 22 { return 117; }  // 'u'
    if sc == 23 { return 105; }  // 'i'
    if sc == 24 { return 111; }  // 'o'
    if sc == 25 { return 112; }  // 'p'
    if sc == 30 { return 97; }   // 'a'
    if sc == 31 { return 115; }  // 's'
    if sc == 32 { return 100; }  // 'd'
    if sc == 33 { return 102; }  // 'f'
    if sc == 34 { return 103; }  // 'g'
    if sc == 35 { return 104; }  // 'h'
    if sc == 36 { return 106; }  // 'j'
    if sc == 37 { return 107; }  // 'k'
    if sc == 38 { return 108; }  // 'l'
    if sc == 44 { return 122; }  // 'z'
    if sc == 45 { return 120; }  // 'x'
    if sc == 46 { return 99; }   // 'c'
    if sc == 47 { return 118; }  // 'v'
    if sc == 48 { return 98; }   // 'b'
    if sc == 49 { return 110; }  // 'n'
    if sc == 50 { return 109; }  // 'm'
    if sc == 57 { return 32; }   // space
    if sc == 28 { return 10; }   // Enter -> LF
    if sc == 14 { return 8; }    // Backspace -> BS
    if sc == 12 { return 45; }   // '-'
    if sc == 13 { return 61; }   // '='
    if sc == 39 { return 59; }   // ';'
    if sc == 40 { return 39; }   // '''
    if sc == 51 { return 44; }   // ','
    if sc == 52 { return 46; }   // '.'
    if sc == 53 { return 47; }   // '/'
    return 0;
}

// Print "HicOS> " prompt
fn _ke_prompt() {
    _ke_putc(72); _ke_putc(105); _ke_putc(99);      // "Hic"
    _ke_putc(79); _ke_putc(83); _ke_putc(62);        // "OS>"
    _ke_putc(32);                                      // " "
    return 0;
}

// Command: help
fn _ke_cmd_help() {
    // "Cmds: help tick pci pmem palloc malloc mfree reboot\r\n"
    _ke_putc(67); _ke_putc(109); _ke_putc(100); _ke_putc(115); _ke_putc(58); _ke_putc(32);
    _ke_putc(104); _ke_putc(101); _ke_putc(108); _ke_putc(112); _ke_putc(32);
    _ke_putc(116); _ke_putc(105); _ke_putc(99); _ke_putc(107); _ke_putc(32);
    _ke_putc(112); _ke_putc(99); _ke_putc(105); _ke_putc(32);
    _ke_putc(112); _ke_putc(109); _ke_putc(101); _ke_putc(109); _ke_putc(32);
    _ke_putc(112); _ke_putc(97); _ke_putc(108); _ke_putc(108); _ke_putc(111); _ke_putc(99); _ke_putc(32);
    // "malloc "
    _ke_putc(109); _ke_putc(97); _ke_putc(108); _ke_putc(108); _ke_putc(111); _ke_putc(99); _ke_putc(32);
    // "mfree "
    _ke_putc(109); _ke_putc(102); _ke_putc(114); _ke_putc(101); _ke_putc(101); _ke_putc(32);
    // "ps "
    _ke_putc(112); _ke_putc(115); _ke_putc(32);
    // "reboot\r\n"
    _ke_putc(114); _ke_putc(101); _ke_putc(98); _ke_putc(111); _ke_putc(111); _ke_putc(116);
    _ke_putc(13); _ke_putc(10);
    return 0;
}

// Command: tick — show timer tick count
fn _ke_cmd_tick() {
    let tick = mem_read_u64(3145728);  // 0x300000
    // "Tick: " then decimal
    _ke_putc(84); _ke_putc(105); _ke_putc(99); _ke_putc(107); _ke_putc(58); _ke_putc(32);
    _ke_put_dec(tick);
    _ke_putc(13); _ke_putc(10);
    return 0;
}

// Command dispatch: compare command buffer bytes
// Uses fixed memory at 0x310000-0x31003F as command buffer
fn _ke_dispatch(buf_addr, buf_len) {
    if buf_len == 0 { return 0; }
    let c0 = mem_read_u8(buf_addr);
    let c1 = 0; if buf_len > 1 { c1 = mem_read_u8(buf_addr + 1); }
    let c2 = 0; if buf_len > 2 { c2 = mem_read_u8(buf_addr + 2); }
    let c3 = 0; if buf_len > 3 { c3 = mem_read_u8(buf_addr + 3); }
    let c4 = 0; if buf_len > 4 { c4 = mem_read_u8(buf_addr + 4); }
    let c5 = 0; if buf_len > 5 { c5 = mem_read_u8(buf_addr + 5); }

    // "help" = 104 101 108 112
    if buf_len == 4 {
        if c0 == 104 { if c1 == 101 { if c2 == 108 { if c3 == 112 {
            _ke_cmd_help(); return 0;
        } } } }
        // "tick" = 116 105 99 107
        if c0 == 116 { if c1 == 105 { if c2 == 99 { if c3 == 107 {
            _ke_cmd_tick(); return 0;
        } } } }
        // "pmem" = 112 109 101 109
        if c0 == 112 { if c1 == 109 { if c2 == 101 { if c3 == 109 {
            _ke_cmd_pmem(); return 0;
        } } } }
    }

    // "pci" = 112 99 105
    if buf_len == 3 {
        if c0 == 112 { if c1 == 99 { if c2 == 105 {
            _ke_pci_scan(); return 0;
        } } }
    }

    // "ps" = 112 115
    if buf_len == 2 {
        if c0 == 112 { if c1 == 115 {
            _ke_cmd_ps(); return 0;
        } }
    }

    // "palloc" (6) or "palloc N" (7+): 112 97 108 108 111 99
    if buf_len >= 6 {
        if c0 == 112 { if c1 == 97 { if c2 == 108 { if c3 == 108 { if c4 == 111 { if c5 == 99 {
            // Parse optional count after space
            let mut n = 1;
            if buf_len > 7 {
                // "palloc N" — read single digit after space
                let digit = mem_read_u8(buf_addr + 7);
                if digit >= 48 { if digit <= 57 { n = digit - 48; } }
                if n == 0 { n = 1; }
            }
            _ke_cmd_palloc(n); return 0;
        } } } } } }
    }

    // "pfree" (5): 112 102 114 101 101
    if buf_len == 5 {
        if c0 == 112 { if c1 == 102 { if c2 == 114 { if c3 == 101 { if c4 == 101 {
            let last = mem_read_u64(3211328);  // 0x310040
            _ke_cmd_pfree(last); return 0;
        } } } } }
        // "mfree" (5): 109 102 114 101 101
        if c0 == 109 { if c1 == 102 { if c2 == 114 { if c3 == 101 { if c4 == 101 {
            _ke_cmd_mfree(); return 0;
        } } } } }
    }

    // "malloc" (6) or "malloc N" (7+): 109 97 108 108 111 99
    if buf_len >= 6 {
        if c0 == 109 { if c1 == 97 { if c2 == 108 { if c3 == 108 { if c4 == 111 { if c5 == 99 {
            // Parse optional size after space
            let mut sz = 64;
            if buf_len > 7 {
                sz = 0;
                let mut di = 7;
                while di < buf_len {
                    let dch = mem_read_u8(buf_addr + di);
                    if dch >= 48 { if dch <= 57 { sz = sz * 10 + dch - 48; } }
                    di = di + 1;
                }
                if sz == 0 { sz = 64; }
            }
            _ke_cmd_malloc(sz); return 0;
        } } } } } }
    }

    // "reboot" = 114 101 98 111 111 116
    if buf_len == 6 {
        if c0 == 114 { if c1 == 101 {
            mem_write_u64(3211264, 0);
            mem_write_u64(3211272, 0);
            lidt(3211264);
            return 0;
        } }
    }

    // Unknown command: "?\r\n"
    _ke_putc(63); _ke_putc(13); _ke_putc(10);
    return 0;
}

// Interactive shell loop
fn _ke_shell() {
    let cmd_buf = 3211264;     // 0x310000: command buffer (64 bytes)
    let mut buf_len = 0;

    _ke_prompt();

    while 1 == 1 {
        hlt();

        // Check keyboard flag at 0x300010
        let key_ready = mem_read_u64(3145744);
        if key_ready != 0 {
            mem_write_u64(3145744, 0);       // clear flag
            let sc = mem_read_u64(3145736);  // read scancode

            // Ignore key-up events (bit 7 set)
            if sc < 128 {
                let ch = _ke_sc2ascii(sc);
                if ch == 10 {
                    // Enter: execute command
                    _ke_putc(13); _ke_putc(10);
                    _ke_dispatch(cmd_buf, buf_len);
                    buf_len = 0;
                    _ke_prompt();
                } else if ch == 8 {
                    // Backspace
                    if buf_len > 0 {
                        buf_len = buf_len - 1;
                        _ke_putc(8); _ke_putc(32); _ke_putc(8);
                    }
                } else if ch > 0 {
                    // Printable char: store and echo
                    if buf_len < 60 {
                        mem_write_u8(cmd_buf + buf_len, ch);
                        buf_len = buf_len + 1;
                        _ke_putc(ch);
                    }
                }
            }
        }
    }
    return 0;
}

fn _start() {
    // Phase 1: Serial init (COM1 38400 8N1)
    port_out_u8(1017, 0);    // COM1+1: disable interrupts
    port_out_u8(1019, 128);  // COM1+3: set DLAB
    port_out_u8(1016, 3);    // COM1+0: divisor lo = 3 (38400)
    port_out_u8(1017, 0);    // COM1+1: divisor hi = 0
    port_out_u8(1019, 3);    // COM1+3: 8N1
    port_out_u8(1018, 199);  // COM1+2: enable FIFO
    port_out_u8(1020, 11);   // COM1+4: IRQs + RTS/DSR
    _ke_puts_kb_ok();

    // Phase 2: PIC remap
    _ke_pic_remap();
    _ke_puts_pic_ok();

    // Phase 3: PIT 100Hz
    _ke_pit_init();
    _ke_puts_pit_ok();

    // Phase 4: IDT build + load
    _ke_idt_build();
    _ke_puts_idt_ok();

    // Phase 5: Enable interrupts
    sti();
    _ke_puts_int_ok();

    // Phase 6: Physical page allocator init (iteration 26)
    _ke_pa_init();
    _ke_cmd_pmem();

    // Phase 6b: Heap allocator init (iteration 27)
    _ke_heap_init();

    // Phase 6c: Task scheduler init (iteration 28)
    _ke_task_init();

    // Phase 7: PCI bus scan (iteration 24)
    _ke_pci_scan();

    // Phase 8: Interactive shell (iteration 25)
    _ke_shell();

    return 0;
}

// === Self-test (runs in H-L interpreter for verification) ===

print("Bootstrapping H-L: Space-locality initiated.");

let key = hilbert_encode(42, 17, 9);
print(key);

fn _ke_fib(n) {
    let mut a = 0;
    let mut b = 1;
    let mut i = 0;
    while i < n {
        let t = a + b;
        a = b;
        b = t;
        i = i + 1;
    }
    return b;
}
print(_ke_fib(10));

fn _ke_gcd(a, b) {
    while b != 0 {
        let t = b;
        b = a % b;
        a = t;
    }
    return a;
}
print(_ke_gcd(48, 18));

fn _ke_power(base, exp) {
    let mut r = 1;
    let mut i = 0;
    while i < exp {
        r = r * base;
        i = i + 1;
    }
    return r;
}
print(_ke_power(2, 10));

let mut sum = 0;
let mut i = 1;
while i <= 100 {
    sum = sum + i;
    i = i + 1;
}
print(sum);

// === Kernel Initialization Sequence ===
// Called by the native kernel after basic hardware setup.
// The interpreter runs these functions as self-test during build.

fn kernel_init() {
    print("=== HicOS Kernel Init ===");

    // Phase 0: Detect boot mode (UEFI vs Legacy BIOS)
    let is_uefi = uefi_is_boot();
    if is_uefi == 1 {
        print("[0] UEFI boot detected");
    } else {
        print("[0] Legacy BIOS boot");
    }

    // Phase 1: Memory detection
    if is_uefi == 1 {
        print("[1] UEFI memory map...");
        uefi_parse_memory_map();
        uefi_init_page_alloc();
    } else {
        print("[1] E820 memory map...");
        e820_dump();
        page_alloc_init_e820();
    }
    print("  Free pages: " + to_string(page_count_free()));

    // Phase 2: Virtual memory -- map all RAM
    print("[2] Virtual memory -- mapping all usable RAM...");
    map_all_ram();

    // Phase 3: Block cache init
    print("[3] Block cache init...");
    bcache_init();

    // Phase 4: Display
    if is_uefi == 1 {
        print("[4] UEFI GOP framebuffer...");
        uefi_init_framebuffer();
    } else {
        print("[4] VESA framebuffer...");
        vesa_auto_init();
        vesa_info();
    }

    // Phase 5: VFS + ramfs
    print("[5] Filesystem init...");
    fs_init();
    vfs_init();

    // Phase 6: Swap
    print("[6] Swap init...");
    swap_init();

    // Phase 7: Task scheduler + POSIX process model
    print("[7] Task scheduler init...");
    task_init();
    fd_init_task(0);  // setup stdin/stdout/stderr for idle task
    print("  Scheduler: CFS min-heap O(log n)");
    print("  Max tasks: " + to_string(MAX_TASKS));

    // Phase 8: Hardware detection (AHCI/USB)
    print("[8] Hardware detection...");
    ahci_init();
    usb_init();

    // Phase 9: Network stack
    print("[9] Network init...");
    net_init();
    dhcp_discover();

    // Phase 10: SMP (multi-core)
    print("[10] SMP init...");
    smp_init();

    // Phase 11: ACPI power management
    print("[11] ACPI power management...");
    power_init();

    // Phase 12: Firmware loader
    print("[12] Firmware loader...");
    firmware_init();

    // Phase 13: Secure Boot verification
    print("[13] Secure Boot...");
    secboot_init();

    // Phase 14: GPT partition detection
    print("[14] Partition table...");
    let gpt_count = gpt_read();
    if gpt_count > 0 {
        print("  GPT: " + to_string(gpt_count) + " partition(s)");
    } else {
        print("  MBR layout (legacy)");
    }

    print("=== Kernel init complete ===");
    if is_uefi == 1 { print("Boot: UEFI"); } else { print("Boot: Legacy BIOS"); }
    print("CPUs: " + to_string(smp_cpu_count()));
    return 0;
}

print("H-L kernel ready. All systems nominal.");
