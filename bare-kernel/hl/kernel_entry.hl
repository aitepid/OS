    _ke_mem_w32(sb + 72, 3017161554); _ke_mem_w32(sb + 76, 2217730857);
    _ke_mem_w32(sb + 80, 3976253779); _ke_mem_w32(sb + 84, 1538391072);
    _ke_mem_w32(sb + 88, 968805226);  _ke_mem_w32(sb + 92, 3478670410);
    _ke_mem_w32(sb + 96, 4222283728); _ke_mem_w32(sb + 100, 2234731843);
    _ke_mem_w32(sb + 104, 2130901317); _ke_mem_w32(sb + 108, 2829007952);
    _ke_mem_w32(sb + 112, 2403378001); _ke_mem_w32(sb + 116, 4114128274);
    _ke_mem_w32(sb + 120, 567981756); _ke_mem_w32(sb + 124, 3539205904);
    _ke_mem_w32(sb + 128, 3960671437); _ke_mem_w32(sb + 132, 390371167);
