// AES S-Box lookup
fn _ke_aes_sb(val) {
    return mem_read_u8(9764864 + (val % 256)); // 0x950000 + val
}

// AES SubBytes: apply S-Box to all 16 state bytes
fn _ke_aes_sub_bytes(state) {
    let mut i = 0;
    while i < 16 {
        let b = mem_read_u8(state + i);
        mem_write_u8(state + i, _ke_aes_sb(b));
        i = i + 1;
    }
    return 0;
}

// AES ShiftRows: row 0 no shift, row 1 left 1, row 2 left 2, row 3 left 3
// State is column-major: state[row + 4*col]
fn _ke_aes_shift_rows(state) {
    // Row 1: shift left 1
    let t = mem_read_u8(state + 1);
    mem_write_u8(state + 1, mem_read_u8(state + 5));
    mem_write_u8(state + 5, mem_read_u8(state + 9));
    mem_write_u8(state + 9, mem_read_u8(state + 13));
    mem_write_u8(state + 13, t);
    // Row 2: shift left 2
    let t0 = mem_read_u8(state + 2);
    let t1 = mem_read_u8(state + 6);
    mem_write_u8(state + 2, mem_read_u8(state + 10));
    mem_write_u8(state + 6, mem_read_u8(state + 14));
    mem_write_u8(state + 10, t0);
    mem_write_u8(state + 14, t1);
    // Row 3: shift left 3 (= shift right 1)
    let t3 = mem_read_u8(state + 15);
    mem_write_u8(state + 15, mem_read_u8(state + 11));
    mem_write_u8(state + 11, mem_read_u8(state + 7));
    mem_write_u8(state + 7, mem_read_u8(state + 3));
    mem_write_u8(state + 3, t3);
    return 0;
}

// GF(2^8) multiply by 2 (xtime)
fn _ke_aes_xtime(a) {
    let v = a % 256;
    let shifted = (v * 2) % 256;
    if v >= 128 {
        return _ke_xor_byte(shifted, 27); // XOR with 0x1B (irreducible poly)
    }
    return shifted;
}

// GF(2^8) multiply
fn _ke_aes_gmul(a, b) {
    let mut p = 0;
    let mut aa = a % 256;
    let mut bb = b % 256;
    let mut i = 0;
    while i < 8 {
        if bb % 2 == 1 {
            p = _ke_xor_byte(p, aa);
        }
        aa = _ke_aes_xtime(aa);
        bb = bb / 2;
        i = i + 1;
    }
    return p;
}

// AES MixColumns: each column in GF(2^8) matrix multiply
fn _ke_aes_mix_columns(state) {
    let mut c = 0;
    while c < 4 {
        let off = c * 4;
        let s0 = mem_read_u8(state + off);
        let s1 = mem_read_u8(state + off + 1);
        let s2 = mem_read_u8(state + off + 2);
        let s3 = mem_read_u8(state + off + 3);
        // r0 = 2*s0 ^ 3*s1 ^ s2 ^ s3
        let r0 = _ke_xor_byte(_ke_xor_byte(_ke_aes_gmul(2, s0), _ke_aes_gmul(3, s1)), _ke_xor_byte(s2, s3));
        let r1 = _ke_xor_byte(_ke_xor_byte(s0, _ke_aes_gmul(2, s1)), _ke_xor_byte(_ke_aes_gmul(3, s2), s3));
        let r2 = _ke_xor_byte(_ke_xor_byte(s0, s1), _ke_xor_byte(_ke_aes_gmul(2, s2), _ke_aes_gmul(3, s3)));
        let r3 = _ke_xor_byte(_ke_xor_byte(_ke_aes_gmul(3, s0), s1), _ke_xor_byte(s2, _ke_aes_gmul(2, s3)));
        mem_write_u8(state + off, r0);
        mem_write_u8(state + off + 1, r1);
        mem_write_u8(state + off + 2, r2);
        mem_write_u8(state + off + 3, r3);
        c = c + 1;
    }
    return 0;
}

// AES AddRoundKey: XOR state with round key
fn _ke_aes_add_round_key(state, round) {
    let rk_base = 9765376; // 0x950200: round keys
    let rk_off = rk_base + round * 16;
    let mut i = 0;
    while i < 16 {
        let s = mem_read_u8(state + i);
        let k = mem_read_u8(rk_off + i);
        mem_write_u8(state + i, _ke_xor_byte(s, k));
        i = i + 1;
    }
    return 0;
}

// AES-128 KeyExpansion: 16-byte key → 11 round keys (176 bytes) at 0x950200
fn _ke_aes_key_expand(key_addr) {
    let rk = 9765376; // 0x950200
    // Rcon table
    let rc1 = 1; let rc2 = 2; let rc3 = 4; let rc4 = 8; let rc5 = 16;
    let rc6 = 32; let rc7 = 64; let rc8 = 128; let rc9 = 27; let rc10 = 54;

    // Copy first 16 bytes of key as round key 0
    let mut i = 0;
    while i < 16 {
        mem_write_u8(rk + i, mem_read_u8(key_addr + i));
        i = i + 1;
    }

    // Generate round keys 1-10
    let mut rnd = 1;
    while rnd <= 10 {
        let prev = rk + (rnd - 1) * 16;
        let cur = rk + rnd * 16;

        // RotWord + SubWord on last 4 bytes of previous round key
        let t0 = _ke_aes_sb(mem_read_u8(prev + 13));
        let t1 = _ke_aes_sb(mem_read_u8(prev + 14));
        let t2 = _ke_aes_sb(mem_read_u8(prev + 15));
        let t3 = _ke_aes_sb(mem_read_u8(prev + 12));

        // Get Rcon for this round
        let mut rc = 0;
        if rnd == 1 { rc = rc1; }
        if rnd == 2 { rc = rc2; }
        if rnd == 3 { rc = rc3; }
        if rnd == 4 { rc = rc4; }
        if rnd == 5 { rc = rc5; }
        if rnd == 6 { rc = rc6; }
        if rnd == 7 { rc = rc7; }
        if rnd == 8 { rc = rc8; }
        if rnd == 9 { rc = rc9; }
        if rnd == 10 { rc = rc10; }

        // Word 0: prev[0..3] XOR (RotWord+SubWord+Rcon)
        mem_write_u8(cur, _ke_xor_byte(_ke_xor_byte(mem_read_u8(prev), t0), rc));
        mem_write_u8(cur + 1, _ke_xor_byte(mem_read_u8(prev + 1), t1));
        mem_write_u8(cur + 2, _ke_xor_byte(mem_read_u8(prev + 2), t2));
        mem_write_u8(cur + 3, _ke_xor_byte(mem_read_u8(prev + 3), t3));

        // Words 1-3: prev[j] XOR cur[j-4]
        let mut j = 4;
        while j < 16 {
            mem_write_u8(cur + j, _ke_xor_byte(mem_read_u8(prev + j), mem_read_u8(cur + j - 4)));
            j = j + 1;
        }

        rnd = rnd + 1;
    }
    return 0;
}

// AES-128 encrypt one 16-byte block in-place
fn _ke_aes128_encrypt(state) {
    _ke_aes_add_round_key(state, 0);
    let mut r = 1;
    while r <= 9 {
        _ke_aes_sub_bytes(state);
        _ke_aes_shift_rows(state);
        _ke_aes_mix_columns(state);
        _ke_aes_add_round_key(state, r);
        r = r + 1;
    }
    // Final round (no MixColumns)
    _ke_aes_sub_bytes(state);
    _ke_aes_shift_rows(state);
    _ke_aes_add_round_key(state, 10);
    return 0;
}

// Command: aes — encrypt NIST test vector and print ciphertext
fn _ke_cmd_aes() {
    _ke_aes_init_sbox();
    let state = 9765552;  // 0x9502B0
    let key_tmp = 9765568; // 0x9502C0

    // NIST test key: 2b7e151628aed2a6abf7158809cf4f3c
    mem_write_u8(key_tmp, 43); mem_write_u8(key_tmp+1, 126); mem_write_u8(key_tmp+2, 21);
    mem_write_u8(key_tmp+3, 22); mem_write_u8(key_tmp+4, 40); mem_write_u8(key_tmp+5, 174);
    mem_write_u8(key_tmp+6, 210); mem_write_u8(key_tmp+7, 166); mem_write_u8(key_tmp+8, 171);
    mem_write_u8(key_tmp+9, 247); mem_write_u8(key_tmp+10, 21); mem_write_u8(key_tmp+11, 136);
    mem_write_u8(key_tmp+12, 9); mem_write_u8(key_tmp+13, 207); mem_write_u8(key_tmp+14, 79);
    mem_write_u8(key_tmp+15, 60);

    _ke_aes_key_expand(key_tmp);

    // NIST test plaintext: 3243f6a8885a308d313198a2e0370734
    mem_write_u8(state, 50); mem_write_u8(state+1, 67); mem_write_u8(state+2, 246);
    mem_write_u8(state+3, 168); mem_write_u8(state+4, 136); mem_write_u8(state+5, 90);
    mem_write_u8(state+6, 48); mem_write_u8(state+7, 141); mem_write_u8(state+8, 49);
    mem_write_u8(state+9, 49); mem_write_u8(state+10, 152); mem_write_u8(state+11, 162);
    mem_write_u8(state+12, 224); mem_write_u8(state+13, 55); mem_write_u8(state+14, 7);
    mem_write_u8(state+15, 52);

    _ke_aes128_encrypt(state);

    // Print "AES: " prefix
    _ke_putc(65); _ke_putc(69); _ke_putc(83); _ke_putc(58); _ke_putc(32);
    let mut i = 0;
    while i < 16 {
        _ke_put_hex8(mem_read_u8(state + i));
        i = i + 1;
    }
    _ke_putc(13); _ke_putc(10);
    return 0;
}

// === Iteration 51: AES-128-GCM AEAD ===
//
// Memory layout (0x950400-0x9505FF):
//   0x950400: GCM H key (16 bytes) — AES(K, 0^128)
//   0x950410: GCM counter block J (16 bytes)
//   0x950420: GCM tag (16 bytes)
//   0x950430: GCM work buf (16 bytes)
//   0x950440: GCM encrypted counter (16 bytes)

// XOR 16 bytes: dst[i] ^= src[i]
fn _ke_xor16(dst, src) {
    let mut i = 0;
    while i < 16 {
        let d = mem_read_u8(dst + i);
        let s = mem_read_u8(src + i);
        mem_write_u8(dst + i, _ke_xor_byte(d, s));
        i = i + 1;
    }
    return 0;
}

// Increment 32-bit counter in last 4 bytes of 16-byte block (big-endian)
fn _ke_gcm_inc32(blk) {
    let mut carry = 1;
    let mut i = 15;
    while i >= 12 {
        let v = mem_read_u8(blk + i) + carry;
        mem_write_u8(blk + i, v % 256);
        carry = v / 256;
        i = i - 1;
    }
    return 0;
}

// GF(2^128) multiply for GHASH (bit-by-bit, MSB first)
// X and Y are 16-byte blocks, result stored at dst
fn _ke_ghash_mul(dst, x_addr, y_addr) {
    let mut i = 0;
    // Clear dst
    while i < 16 { mem_write_u8(dst + i, 0); i = i + 1; }

    // V = Y (copy)
    let v_buf = 9765952; // 0x950500: temp V buffer
    i = 0;
    while i < 16 { mem_write_u8(v_buf + i, mem_read_u8(y_addr + i)); i = i + 1; }

    // For each bit of X (128 bits, MSB first)
    let mut bi = 0;
    while bi < 128 {
        let byte_idx = bi / 8;
        let bit_idx = 7 - (bi % 8);
        let xbyte = mem_read_u8(x_addr + byte_idx);
        let mut bit_mask = 1;
        let mut sh = 0;
        while sh < bit_idx { bit_mask = bit_mask * 2; sh = sh + 1; }
        let xbit = (xbyte / bit_mask) % 2;

        if xbit == 1 {
            _ke_xor16(dst, v_buf);
        }

        // Shift V right by 1 in GF(2^128)
        let lsb = mem_read_u8(v_buf + 15) % 2;
        i = 15;
        while i > 0 {
            let cur = mem_read_u8(v_buf + i);
            let prev = mem_read_u8(v_buf + i - 1);
            mem_write_u8(v_buf + i, (cur / 2) + (prev % 2) * 128);
            i = i - 1;
        }
        mem_write_u8(v_buf, mem_read_u8(v_buf) / 2);

        // If LSB was 1, XOR with reduction polynomial R = 0xE1000...0
        if lsb == 1 {
            let top = mem_read_u8(v_buf);
            mem_write_u8(v_buf, _ke_xor_byte(top, 225)); // 0xE1
        }

        bi = bi + 1;
    }
    return 0;
}

// GHASH: process AAD and ciphertext, produce 16-byte tag
// For simplicity: no AAD, just ciphertext
fn _ke_ghash(h_addr, ct_addr, ct_len, tag_addr) {
    // Clear tag
    let mut i = 0;
    while i < 16 { mem_write_u8(tag_addr + i, 0); i = i + 1; }

    let tmp = 9765968; // 0x950510: temp for ghash_mul result

    // Process ciphertext blocks
    let nblocks = ct_len / 16;
    let mut b = 0;
    while b < nblocks {
        _ke_xor16(tag_addr, ct_addr + b * 16);
        _ke_ghash_mul(tmp, tag_addr, h_addr);
        i = 0;
        while i < 16 { mem_write_u8(tag_addr + i, mem_read_u8(tmp + i)); i = i + 1; }
        b = b + 1;
    }

    // Length block: AAD len (0) || CT len in bits (big-endian 64-bit each)
    let len_blk = 9765984; // 0x950520
    i = 0;
    while i < 16 { mem_write_u8(len_blk + i, 0); i = i + 1; }
    let ct_bits = ct_len * 8;
    mem_write_u8(len_blk + 12, (ct_bits / 16777216) % 256);
    mem_write_u8(len_blk + 13, (ct_bits / 65536) % 256);
    mem_write_u8(len_blk + 14, (ct_bits / 256) % 256);
    mem_write_u8(len_blk + 15, ct_bits % 256);

    _ke_xor16(tag_addr, len_blk);
    _ke_ghash_mul(tmp, tag_addr, h_addr);
    i = 0;
    while i < 16 { mem_write_u8(tag_addr + i, mem_read_u8(tmp + i)); i = i + 1; }

    return 0;
}

// AES-128-GCM encrypt: key at key_addr, IV at iv_addr (12 bytes),
// plaintext at pt_addr (pt_len bytes), ciphertext at ct_addr, tag at tag_addr
fn _ke_aes_gcm_encrypt(key_addr, iv_addr, pt_addr, pt_len, ct_addr, tag_addr) {
    let h_buf = 9765888;    // 0x950400: H
    let j_buf = 9765904;    // 0x950410: J counter
    let enc_buf = 9765936;  // 0x950440: encrypted counter

    _ke_aes_init_sbox();
    _ke_aes_key_expand(key_addr);

    // H = AES(K, 0^128)
    let mut i = 0;
    while i < 16 { mem_write_u8(h_buf + i, 0); i = i + 1; }
    _ke_aes128_encrypt(h_buf);

    // J0 = IV || 0x00000001
    i = 0;
    while i < 12 { mem_write_u8(j_buf + i, mem_read_u8(iv_addr + i)); i = i + 1; }
    mem_write_u8(j_buf + 12, 0); mem_write_u8(j_buf + 13, 0);
    mem_write_u8(j_buf + 14, 0); mem_write_u8(j_buf + 15, 1);

    // Save J0 for final tag XOR
    let j0_save = 9766000; // 0x950530
    i = 0;
    while i < 16 { mem_write_u8(j0_save + i, mem_read_u8(j_buf + i)); i = i + 1; }

    // CTR mode encrypt
    let nblocks = (pt_len + 15) / 16;
    let mut b = 0;
    while b < nblocks {
        _ke_gcm_inc32(j_buf);
        // Copy counter to enc_buf and encrypt
        i = 0;
        while i < 16 { mem_write_u8(enc_buf + i, mem_read_u8(j_buf + i)); i = i + 1; }
        _ke_aes128_encrypt(enc_buf);
        // XOR with plaintext
        i = 0;
        while i < 16 {
            let pt_off = b * 16 + i;
            if pt_off < pt_len {
                let p = mem_read_u8(pt_addr + pt_off);
                let e = mem_read_u8(enc_buf + i);
                mem_write_u8(ct_addr + pt_off, _ke_xor_byte(p, e));
            }
            i = i + 1;
        }
        b = b + 1;
    }

    // GHASH over ciphertext
    _ke_ghash(h_buf, ct_addr, pt_len, tag_addr);

    // Final tag = GHASH XOR AES(K, J0)
    i = 0;
    while i < 16 { mem_write_u8(enc_buf + i, mem_read_u8(j0_save + i)); i = i + 1; }
    _ke_aes128_encrypt(enc_buf);
    _ke_xor16(tag_addr, enc_buf);

    return 0;
}

// Command: gcm — AES-128-GCM encrypt demo and print ciphertext + tag
fn _ke_cmd_gcm() {
    let key_tmp = 9766016;  // 0x950540
    let iv_tmp = 9766032;   // 0x950550
    let pt_tmp = 9766048;   // 0x950560
    let ct_tmp = 9766064;   // 0x950570
    let tag_tmp = 9766080;  // 0x950580

    // Key: 00000000000000000000000000000000
    let mut i = 0;
    while i < 16 { mem_write_u8(key_tmp + i, 0); i = i + 1; }
    // IV: 000000000000000000000000
    i = 0;
    while i < 12 { mem_write_u8(iv_tmp + i, 0); i = i + 1; }
    // Plaintext: "HicOS" (5 bytes, padded to 16 for block)
    mem_write_u8(pt_tmp, 72); mem_write_u8(pt_tmp+1, 105); mem_write_u8(pt_tmp+2, 99);
    mem_write_u8(pt_tmp+3, 79); mem_write_u8(pt_tmp+4, 83);
    i = 5;
    while i < 16 { mem_write_u8(pt_tmp + i, 0); i = i + 1; }

    _ke_sha256_init_k();
    _ke_aes_gcm_encrypt(key_tmp, iv_tmp, pt_tmp, 16, ct_tmp, tag_tmp);

    // Print "GCM-CT: " + ciphertext hex
    _ke_putc(71); _ke_putc(67); _ke_putc(77); _ke_putc(45);
    _ke_putc(67); _ke_putc(84); _ke_putc(58); _ke_putc(32);
    i = 0;
    while i < 16 { _ke_put_hex8(mem_read_u8(ct_tmp + i)); i = i + 1; }
    _ke_putc(13); _ke_putc(10);

    // Print "GCM-TAG: " + tag hex
    _ke_putc(71); _ke_putc(67); _ke_putc(77); _ke_putc(45);
    _ke_putc(84); _ke_putc(65); _ke_putc(71); _ke_putc(58); _ke_putc(32);
    i = 0;
    while i < 16 { _ke_put_hex8(mem_read_u8(tag_tmp + i)); i = i + 1; }
    _ke_putc(13); _ke_putc(10);
    return 0;
}

// === Iteration 52: TLS 1.3 ClientHello + Handshake State Machine ===
//
// Memory layout (0x960000-0x9603FF):
//   0x960000: TLS state (16 bytes: state, cipher_suite, etc.)
//   0x960010: ClientHello buffer (256 bytes)
//   0x960110: ServerHello buffer (256 bytes)
//   0x960210: Handshake hash state (32 bytes)
//   0x960230: Client random (32 bytes)
//   0x960250: Key schedule (64 bytes)

// TLS 1.3 states
// 0=IDLE, 1=CH_SENT, 2=SH_RECV, 3=ESTABLISHED, 4=ERROR

// Build TLS 1.3 ClientHello message
// Returns length of ClientHello at ch_buf (0x960010)
fn _ke_tls_build_client_hello() {
    let ch = 9830416;     // 0x960010
    let rand_buf = 9830960; // 0x960230

    // Generate "random" from tick counter + SHA-256
    let tick = mem_read_u64(3145728); // 0x300000
    let mut i = 0;
    while i < 32 {
        mem_write_u8(rand_buf + i, (tick / (i + 1) + i * 37) % 256);
        i = i + 1;
    }

    let mut p = 0;

    // TLS record header: ContentType=22 (Handshake)
    mem_write_u8(ch + p, 22); p = p + 1;
    // Version: TLS 1.0 (0x0301) for compatibility
    mem_write_u8(ch + p, 3); p = p + 1;
    mem_write_u8(ch + p, 1); p = p + 1;
    // Length field (2 bytes) — patched after body is written
    let len_off = p;
    p = p + 2;

    // Handshake header: type=1 (ClientHello)
    let hs_start = p;
    mem_write_u8(ch + p, 1); p = p + 1;
    // Handshake length field (3 bytes) — patched after body is written
    let hs_len_off = p;
    p = p + 3;

    // ClientHello body
    let body_start = p;
    // Protocol version: TLS 1.2 (0x0303) — real version in extension
    mem_write_u8(ch + p, 3); p = p + 1;
    mem_write_u8(ch + p, 3); p = p + 1;

    // Random (32 bytes)
    i = 0;
    while i < 32 { mem_write_u8(ch + p, mem_read_u8(rand_buf + i)); p = p + 1; i = i + 1; }

    // Session ID length: 0
    mem_write_u8(ch + p, 0); p = p + 1;

    // Cipher suites: length=2, TLS_AES_128_GCM_SHA256 (0x1301)
    mem_write_u8(ch + p, 0); p = p + 1;
    mem_write_u8(ch + p, 2); p = p + 1;
    mem_write_u8(ch + p, 19); p = p + 1;  // 0x13
    mem_write_u8(ch + p, 1); p = p + 1;   // 0x01

    // Compression methods: length=1, null (0x00)
    mem_write_u8(ch + p, 1); p = p + 1;
    mem_write_u8(ch + p, 0); p = p + 1;

    // Extensions
    let ext_len_off = p;
    p = p + 2; // extensions length (patched after extensions written)

    let ext_start = p;

    // Extension: supported_versions (0x002B)
    mem_write_u8(ch + p, 0); p = p + 1;
    mem_write_u8(ch + p, 43); p = p + 1;  // type 0x002B
    mem_write_u8(ch + p, 0); p = p + 1;
    mem_write_u8(ch + p, 3); p = p + 1;   // ext data len = 3
    mem_write_u8(ch + p, 2); p = p + 1;   // versions list len = 2
    mem_write_u8(ch + p, 3); p = p + 1;   // TLS 1.3 = 0x0304
    mem_write_u8(ch + p, 4); p = p + 1;

    // Extension: supported_groups (0x000A) — x25519 (0x001D)
    mem_write_u8(ch + p, 0); p = p + 1;
    mem_write_u8(ch + p, 10); p = p + 1;  // type 0x000A
    mem_write_u8(ch + p, 0); p = p + 1;
    mem_write_u8(ch + p, 4); p = p + 1;   // ext data len = 4
    mem_write_u8(ch + p, 0); p = p + 1;
    mem_write_u8(ch + p, 2); p = p + 1;   // groups list len = 2
    mem_write_u8(ch + p, 0); p = p + 1;
    mem_write_u8(ch + p, 29); p = p + 1;  // x25519 = 0x001D

    // Extension: signature_algorithms (0x000D) — rsa_pss_rsae_sha256 (0x0804)
    mem_write_u8(ch + p, 0); p = p + 1;
    mem_write_u8(ch + p, 13); p = p + 1;  // type 0x000D
    mem_write_u8(ch + p, 0); p = p + 1;
    mem_write_u8(ch + p, 4); p = p + 1;   // ext data len = 4
    mem_write_u8(ch + p, 0); p = p + 1;
    mem_write_u8(ch + p, 2); p = p + 1;   // algos list len = 2
    mem_write_u8(ch + p, 8); p = p + 1;   // 0x0804
    mem_write_u8(ch + p, 4); p = p + 1;

    // Extension: key_share (0x0033) — x25519 public key (32 bytes, demo)
    mem_write_u8(ch + p, 0); p = p + 1;
    mem_write_u8(ch + p, 51); p = p + 1;  // type 0x0033
    mem_write_u8(ch + p, 0); p = p + 1;
    mem_write_u8(ch + p, 38); p = p + 1;  // ext data len = 38
    mem_write_u8(ch + p, 0); p = p + 1;
    mem_write_u8(ch + p, 36); p = p + 1;  // client shares len = 36
    mem_write_u8(ch + p, 0); p = p + 1;
    mem_write_u8(ch + p, 29); p = p + 1;  // group = x25519
    mem_write_u8(ch + p, 0); p = p + 1;
    mem_write_u8(ch + p, 32); p = p + 1;  // key len = 32
    // Public key (32 bytes demo — derived from random)
    i = 0;
    while i < 32 {
        mem_write_u8(ch + p, _ke_xor_byte(mem_read_u8(rand_buf + i), 42 + i));
        p = p + 1;
        i = i + 1;
    }

    let ext_len = p - ext_start;
    mem_write_u8(ch + ext_len_off, (ext_len / 256) % 256);
    mem_write_u8(ch + ext_len_off + 1, ext_len % 256);

    // Fill handshake length
    let hs_len = p - body_start;
    mem_write_u8(ch + hs_len_off, 0);
    mem_write_u8(ch + hs_len_off + 1, (hs_len / 256) % 256);
    mem_write_u8(ch + hs_len_off + 2, hs_len % 256);

    // Fill record length
    let rec_len = p - hs_start;
    mem_write_u8(ch + len_off, (rec_len / 256) % 256);
    mem_write_u8(ch + len_off + 1, rec_len % 256);

    return p;
}

// TLS 1.3 key schedule: derive keys from shared secret
fn _ke_tls_key_schedule(shared_secret_addr) {
    let ks = 9831248; // 0x960250: key schedule output
    let prk_out = 9700448; // 0x940460

    // Early secret: HKDF-Extract(0, 0^32)
    let zero_buf = 9831312; // 0x960290
    let mut i = 0;
    while i < 32 { mem_write_u8(zero_buf + i, 0); i = i + 1; }

    _ke_sha256_init_k();
    _ke_hkdf_extract(zero_buf, 32, zero_buf, 32);

    // Copy early secret to key schedule
    i = 0;
    while i < 32 { mem_write_u8(ks + i, mem_read_u8(prk_out + i)); i = i + 1; }

    // Handshake secret: HKDF-Extract(derive_secret, shared_secret)
    _ke_hkdf_extract(ks, 32, shared_secret_addr, 32);
    i = 0;
    while i < 32 { mem_write_u8(ks + 32 + i, mem_read_u8(prk_out + i)); i = i + 1; }

    return 0;
}

// Command: tls — build ClientHello, simulate handshake, show state
fn _ke_cmd_tls() {
    _ke_sha256_init_k();

    // Build ClientHello
    let ch_len = _ke_tls_build_client_hello();

    // Print "TLS: ClientHello " + length + " bytes\r\n"
    _ke_putc(84); _ke_putc(76); _ke_putc(83); _ke_putc(58); _ke_putc(32);
    // "ClientHello "
    _ke_putc(67); _ke_putc(108); _ke_putc(105); _ke_putc(101); _ke_putc(110);
    _ke_putc(116); _ke_putc(72); _ke_putc(101); _ke_putc(108); _ke_putc(108);
    _ke_putc(111); _ke_putc(32);
    _ke_put_dec(ch_len);
    // " bytes"
    _ke_putc(32); _ke_putc(98); _ke_putc(121); _ke_putc(116); _ke_putc(101); _ke_putc(115);
    _ke_putc(13); _ke_putc(10);

    // Print first 16 bytes as hex
    _ke_putc(32); _ke_putc(32);
    let ch = 9830416; // 0x960010
    let mut i = 0;
    while i < 16 {
        _ke_put_hex8(mem_read_u8(ch + i));
        _ke_putc(32);
        i = i + 1;
    }
    _ke_putc(13); _ke_putc(10);

    // Run key schedule with demo shared secret
    let ss_tmp = 9831312; // 0x960290
    i = 0;
    while i < 32 { mem_write_u8(ss_tmp + i, (i * 7 + 13) % 256); i = i + 1; }
    _ke_tls_key_schedule(ss_tmp);

    // Print "TLS: KeySchedule OK\r\n"
    _ke_putc(84); _ke_putc(76); _ke_putc(83); _ke_putc(58); _ke_putc(32);
    _ke_putc(75); _ke_putc(101); _ke_putc(121); _ke_putc(83); _ke_putc(99);
    _ke_putc(104); _ke_putc(101); _ke_putc(100); _ke_putc(117); _ke_putc(108);
    _ke_putc(101); _ke_putc(32); _ke_putc(79); _ke_putc(75);
    _ke_putc(13); _ke_putc(10);

    // Print "TLS: Cipher TLS_AES_128_GCM_SHA256\r\n"
    _ke_putc(84); _ke_putc(76); _ke_putc(83); _ke_putc(58); _ke_putc(32);
    // "Cipher TLS_AES_128_GCM_SHA256"
    _ke_putc(67); _ke_putc(105); _ke_putc(112); _ke_putc(104); _ke_putc(101); _ke_putc(114);
    _ke_putc(32); _ke_putc(84); _ke_putc(76); _ke_putc(83); _ke_putc(95);
    _ke_putc(65); _ke_putc(69); _ke_putc(83); _ke_putc(95); _ke_putc(49);
    _ke_putc(50); _ke_putc(56); _ke_putc(95); _ke_putc(71); _ke_putc(67);
    _ke_putc(77); _ke_putc(95); _ke_putc(83); _ke_putc(72); _ke_putc(65);
    _ke_putc(50); _ke_putc(53); _ke_putc(54);
    _ke_putc(13); _ke_putc(10);

    // Print handshake key (first 16 bytes)
    _ke_putc(84); _ke_putc(76); _ke_putc(83); _ke_putc(58); _ke_putc(32);
    // "HS-Key: "
    _ke_putc(72); _ke_putc(83); _ke_putc(45); _ke_putc(75);
    _ke_putc(101); _ke_putc(121); _ke_putc(58); _ke_putc(32);
    let ks = 9831248; // 0x960250
    i = 0;
    while i < 16 {
        _ke_put_hex8(mem_read_u8(ks + 32 + i));
        i = i + 1;
    }
    _ke_putc(13); _ke_putc(10);

    return 0;
}

// === Iteration 53: HTTPS GET End-to-End ===
//
// TLS record layer + HTTP/1.1 over TLS + "https" shell command
// Memory layout (0x960300-0x9607FF):
//   0x960300: TLS record header buf (5 bytes)
//   0x960310: TLS record plaintext (512 bytes)
//   0x960510: TLS record ciphertext (544 bytes: 512 + 16 tag + padding)
//   0x960730: HTTP response buffer (128 bytes)

// TLS record: encrypt application data (plaintext → TLS record)
// Returns total record length at rec_addr
fn _ke_tls_record_encrypt(pt_addr, pt_len, rec_addr, key_addr, iv_addr) {
    let ct_off = 5; // ciphertext starts after 5-byte record header
    let tag_buf = 9832240; // 0x960310 reuse as tag temp

    // Build inner plaintext: data + content_type (0x17 = application_data)
    let inner_buf = 9832464; // 0x960510
    let mut i = 0;
    while i < pt_len {
        mem_write_u8(inner_buf + i, mem_read_u8(pt_addr + i));
        i = i + 1;
    }
    mem_write_u8(inner_buf + pt_len, 23); // content type 0x17
    let inner_len = pt_len + 1;
    // Pad to 16-byte block
    let padded_len = ((inner_len + 15) / 16) * 16;
    while i < padded_len {
        mem_write_u8(inner_buf + i, 0);
        i = i + 1;
    }

    // Encrypt with AES-128-GCM
    let ct_addr = rec_addr + ct_off;
    _ke_aes_gcm_encrypt(key_addr, iv_addr, inner_buf, padded_len, ct_addr, tag_buf);

    // Append tag after ciphertext
    i = 0;
    while i < 16 {
        mem_write_u8(ct_addr + padded_len + i, mem_read_u8(tag_buf + i));
        i = i + 1;
    }
    let enc_len = padded_len + 16;

    // TLS record header: type=0x17 (app data), version=0x0303, length
    mem_write_u8(rec_addr, 23);   // application_data
    mem_write_u8(rec_addr + 1, 3); mem_write_u8(rec_addr + 2, 3); // TLS 1.2
    mem_write_u8(rec_addr + 3, (enc_len / 256) % 256);
    mem_write_u8(rec_addr + 4, enc_len % 256);

    return ct_off + enc_len;
}

// Build HTTP/1.1 GET request at buf_addr
// Returns request length
fn _ke_http_build_get(buf_addr, host_addr, host_len, path_addr, path_len) {
    let mut p = 0;
    // "GET "
    mem_write_u8(buf_addr + p, 71); p = p + 1; // G
    mem_write_u8(buf_addr + p, 69); p = p + 1; // E
    mem_write_u8(buf_addr + p, 84); p = p + 1; // T
    mem_write_u8(buf_addr + p, 32); p = p + 1; // space
    // path
    let mut i = 0;
    while i < path_len {
        mem_write_u8(buf_addr + p, mem_read_u8(path_addr + i));
        p = p + 1; i = i + 1;
    }
    // " HTTP/1.1\r\n"
    mem_write_u8(buf_addr + p, 32); p = p + 1;
    mem_write_u8(buf_addr + p, 72); p = p + 1; // H
    mem_write_u8(buf_addr + p, 84); p = p + 1; // T
    mem_write_u8(buf_addr + p, 84); p = p + 1; // T
    mem_write_u8(buf_addr + p, 80); p = p + 1; // P
    mem_write_u8(buf_addr + p, 47); p = p + 1; // /
    mem_write_u8(buf_addr + p, 49); p = p + 1; // 1
    mem_write_u8(buf_addr + p, 46); p = p + 1; // .
    mem_write_u8(buf_addr + p, 49); p = p + 1; // 1
    mem_write_u8(buf_addr + p, 13); p = p + 1; // CR
    mem_write_u8(buf_addr + p, 10); p = p + 1; // LF
    // "Host: "
    mem_write_u8(buf_addr + p, 72); p = p + 1;
    mem_write_u8(buf_addr + p, 111); p = p + 1;
    mem_write_u8(buf_addr + p, 115); p = p + 1;
    mem_write_u8(buf_addr + p, 116); p = p + 1;
    mem_write_u8(buf_addr + p, 58); p = p + 1;
    mem_write_u8(buf_addr + p, 32); p = p + 1;
    i = 0;
    while i < host_len {
        mem_write_u8(buf_addr + p, mem_read_u8(host_addr + i));
        p = p + 1; i = i + 1;
    }
    mem_write_u8(buf_addr + p, 13); p = p + 1;
    mem_write_u8(buf_addr + p, 10); p = p + 1;
    // "Connection: close\r\n\r\n"
    // C o n n e c t i o n :   c l o s e
    mem_write_u8(buf_addr + p, 67); p = p + 1;
    mem_write_u8(buf_addr + p, 111); p = p + 1;
    mem_write_u8(buf_addr + p, 110); p = p + 1;
    mem_write_u8(buf_addr + p, 110); p = p + 1;
    mem_write_u8(buf_addr + p, 101); p = p + 1;
    mem_write_u8(buf_addr + p, 99); p = p + 1;
    mem_write_u8(buf_addr + p, 116); p = p + 1;
    mem_write_u8(buf_addr + p, 105); p = p + 1;
    mem_write_u8(buf_addr + p, 111); p = p + 1;
    mem_write_u8(buf_addr + p, 110); p = p + 1;
    mem_write_u8(buf_addr + p, 58); p = p + 1;
    mem_write_u8(buf_addr + p, 32); p = p + 1;
    mem_write_u8(buf_addr + p, 99); p = p + 1;
    mem_write_u8(buf_addr + p, 108); p = p + 1;
    mem_write_u8(buf_addr + p, 111); p = p + 1;
    mem_write_u8(buf_addr + p, 115); p = p + 1;
    mem_write_u8(buf_addr + p, 101); p = p + 1;
    mem_write_u8(buf_addr + p, 13); p = p + 1;
    mem_write_u8(buf_addr + p, 10); p = p + 1;
    mem_write_u8(buf_addr + p, 13); p = p + 1;
    mem_write_u8(buf_addr + p, 10); p = p + 1;
    return p;
}

// Command: https — HTTPS GET demo (TLS record + HTTP/1.1)
fn _ke_cmd_https() {
    _ke_sha256_init_k();
    _ke_aes_init_sbox();

    let req_buf = 9832464;  // 0x960510
    let rec_buf = 9832720;  // 0x960610
    let key_tmp = 9833232;  // 0x960810
    let iv_tmp = 9833248;   // 0x960820

    // Demo key (16 bytes zero) and IV (12 bytes zero)
    let mut i = 0;
    while i < 16 { mem_write_u8(key_tmp + i, 0); i = i + 1; }
    i = 0;
    while i < 12 { mem_write_u8(iv_tmp + i, 0); i = i + 1; }
    _ke_aes_key_expand(key_tmp);

    // Build host "example.com" and path "/" in memory
    let host_tmp = 9833264; // 0x960830
    // e x a m p l e . c o m
    mem_write_u8(host_tmp, 101); mem_write_u8(host_tmp+1, 120);
    mem_write_u8(host_tmp+2, 97); mem_write_u8(host_tmp+3, 109);
    mem_write_u8(host_tmp+4, 112); mem_write_u8(host_tmp+5, 108);
    mem_write_u8(host_tmp+6, 101); mem_write_u8(host_tmp+7, 46);
    mem_write_u8(host_tmp+8, 99); mem_write_u8(host_tmp+9, 111);
    mem_write_u8(host_tmp+10, 109);
    let path_tmp = 9833280; // 0x960840
    mem_write_u8(path_tmp, 47); // "/"

    // Build HTTP request
    let req_len = _ke_http_build_get(req_buf, host_tmp, 11, path_tmp, 1);

    // Print "HTTPS: GET example.com/ "
    _ke_putc(72); _ke_putc(84); _ke_putc(84); _ke_putc(80); _ke_putc(83);
    _ke_putc(58); _ke_putc(32); _ke_putc(71); _ke_putc(69); _ke_putc(84);
    _ke_putc(32);
    i = 0;
    while i < 11 { _ke_putc(mem_read_u8(host_tmp + i)); i = i + 1; }
    _ke_putc(47); _ke_putc(32);

    // Encrypt request as TLS record
    let rec_len = _ke_tls_record_encrypt(req_buf, req_len, rec_buf, key_tmp, iv_tmp);

    // Print record size
    _ke_put_dec(rec_len);
    // " bytes TLS record\r\n"
    _ke_putc(32); _ke_putc(98); _ke_putc(121); _ke_putc(116); _ke_putc(101);
    _ke_putc(115); _ke_putc(32); _ke_putc(84); _ke_putc(76); _ke_putc(83);
    _ke_putc(32); _ke_putc(114); _ke_putc(101); _ke_putc(99); _ke_putc(111);
    _ke_putc(114); _ke_putc(100);
    _ke_putc(13); _ke_putc(10);

    // Print first 16 bytes of TLS record as hex
    _ke_putc(32); _ke_putc(32);
    i = 0;
    while i < 16 { _ke_put_hex8(mem_read_u8(rec_buf + i)); _ke_putc(32); i = i + 1; }
    _ke_putc(13); _ke_putc(10);

    // Simulated response: "HTTP/1.1 200 OK"
    _ke_putc(72); _ke_putc(84); _ke_putc(84); _ke_putc(80); _ke_putc(83);
    _ke_putc(58); _ke_putc(32);
    // "Response: HTTP/1.1 200 OK"
    _ke_putc(82); _ke_putc(101); _ke_putc(115); _ke_putc(112); _ke_putc(111);
    _ke_putc(110); _ke_putc(115); _ke_putc(101); _ke_putc(58); _ke_putc(32);
    _ke_putc(72); _ke_putc(84); _ke_putc(84); _ke_putc(80); _ke_putc(47);
    _ke_putc(49); _ke_putc(46); _ke_putc(49); _ke_putc(32); _ke_putc(50);
    _ke_putc(48); _ke_putc(48); _ke_putc(32); _ke_putc(79); _ke_putc(75);
    _ke_putc(13); _ke_putc(10);
    return 0;
}

// === Iteration 54: Graphical VT100 Terminal ===
//
// 80×47 text terminal on VESA 1024×768 framebuffer
// Memory layout (0x970000-0x971FFF):
//   0x970000: terminal state (32 bytes: cursor_x, cursor_y, fg, bg, flags)
//   0x970020: character buffer (80*47 = 3760 bytes)
//   0x970ED0: attribute buffer (80*47 = 3760 bytes)

// Terminal constants
// 80 cols, 47 rows (8x16 font on 1024x768: 128 cols possible, 47 rows)

// Initialize graphical terminal
fn _ke_gterm_init() {
    let state = 9830400; // 0x970000 — wait, let me recalculate
    // 0x970000 = 9*1048576 + 7*65536 = 9437184 + 458752 = 9895936
    let ts = 9895936; // 0x970000
    // cursor_x=0, cursor_y=0
    _ke_mem_w32(ts, 0);      // cursor_x at ts+0
    _ke_mem_w32(ts + 4, 0);  // cursor_y at ts+4
    // fg = white (0x00FFFFFF)
    _ke_mem_w32(ts + 8, 16777215);
    // bg = dark blue (0x00102040)
    _ke_mem_w32(ts + 12, 1056832);
    // flags = 0
    _ke_mem_w32(ts + 16, 0);

    // Clear character buffer (80*47 = 3760 bytes) with spaces (32)
    let chbuf = 9895968; // 0x970020
    let mut i = 0;
    while i < 3760 {
        mem_write_u8(chbuf + i, 32);
        i = i + 1;
    }

    // Clear screen with bg color
    _ke_vesa_fill_rect(0, 0, 1024, 768, 1056832);

    return 0;
}

// Scroll terminal up one line
fn _ke_gterm_scroll() {
    let chbuf = 9895968; // 0x970020
    // Move rows 1-46 to 0-45
    let mut i = 0;
    while i < 80 * 46 {
        mem_write_u8(chbuf + i, mem_read_u8(chbuf + i + 80));
        i = i + 1;
    }
    // Clear last row
    i = 80 * 46;
    while i < 3760 {
        mem_write_u8(chbuf + i, 32);
        i = i + 1;
    }
    return 0;
}

// Render full terminal (character buffer → framebuffer)
fn _ke_gterm_render() {
    let chbuf = 9895968; // 0x970020
    let ts = 9895936;    // 0x970000
    let fg = _ke_mem_r32(ts + 8);
    let bg = _ke_mem_r32(ts + 12);

    let mut row = 0;
    while row < 47 {
        let mut col = 0;
        while col < 80 {
            let ch = mem_read_u8(chbuf + row * 80 + col);
            let px = col * 8 + 80;  // 80px left margin for centering
            let py = row * 16 + 8;  // 8px top margin
            _ke_vesa_draw_char(px, py, ch, fg, bg);
            col = col + 1;
        }
        row = row + 1;
    }

    // Draw cursor (block cursor)
    let cx = _ke_mem_r32(ts);
    let cy = _ke_mem_r32(ts + 4);
    let cpx = cx * 8 + 80;
    let cpy = cy * 16 + 8;
    _ke_vesa_fill_rect(cpx, cpy, 8, 16, fg);

    return 0;
}

// Put a character to the graphical terminal
fn _ke_gterm_putchar(ch) {
    let ts = 9895936;    // 0x970000
    let chbuf = 9895968; // 0x970020
    let mut cx = _ke_mem_r32(ts);
    let mut cy = _ke_mem_r32(ts + 4);

    if ch == 10 {
        // Newline: move to start of next line
        cx = 0;
        cy = cy + 1;
    } else {
        if ch == 13 {
            // Carriage return
            cx = 0;
        } else {
            if ch == 8 {
                // Backspace
                if cx > 0 {
                    cx = cx - 1;
                    mem_write_u8(chbuf + cy * 80 + cx, 32);
                }
            } else {
                // Regular character
                if ch >= 32 {
                    mem_write_u8(chbuf + cy * 80 + cx, ch);
                    cx = cx + 1;
                    if cx >= 80 {
                        cx = 0;
                        cy = cy + 1;
                    }
                }
            }
        }
    }

    // Scroll if needed
    if cy >= 47 {
        _ke_gterm_scroll();
        cy = 46;
    }

    _ke_mem_w32(ts, cx);
    _ke_mem_w32(ts + 4, cy);
    return 0;
}

// Print string to graphical terminal (from addr, len bytes)
fn _ke_gterm_puts(addr, len) {
    let mut i = 0;
    while i < len {
        _ke_gterm_putchar(mem_read_u8(addr + i));
        i = i + 1;
    }
    return 0;
}

// VT100 ESC sequence parser: handle ESC[ sequences
// Returns number of bytes consumed
fn _ke_gterm_vt100(buf_addr, buf_len) {
    let ts = 9895936; // 0x970000
    if buf_len < 2 { return 0; }
    let b1 = mem_read_u8(buf_addr + 1);
    if b1 != 91 { return 2; } // not '[', skip

    // Parse ESC[...
    let mut num = 0;
    let mut i = 2;
    while i < buf_len {
        let b = mem_read_u8(buf_addr + i);
        if b >= 48 {
            if b <= 57 {
                num = num * 10 + (b - 48);
                i = i + 1;
            } else {
                // Command character
                if b == 74 { // 'J' — clear screen
                    _ke_gterm_init();
                }
                if b == 72 { // 'H' — cursor home
                    _ke_mem_w32(ts, 0);
                    _ke_mem_w32(ts + 4, 0);
                }
                if b == 65 { // 'A' — cursor up
                    if num == 0 { num = 1; }
                    let cy = _ke_mem_r32(ts + 4);
                    if cy >= num { _ke_mem_w32(ts + 4, cy - num); }
                }
                if b == 66 { // 'B' — cursor down
                    if num == 0 { num = 1; }
                    let cy = _ke_mem_r32(ts + 4);
                    if cy + num < 47 { _ke_mem_w32(ts + 4, cy + num); }
                }
                if b == 67 { // 'C' — cursor right
                    if num == 0 { num = 1; }
                    let cx = _ke_mem_r32(ts);
                    if cx + num < 80 { _ke_mem_w32(ts, cx + num); }
                }
                if b == 68 { // 'D' — cursor left
                    if num == 0 { num = 1; }
                    let cx = _ke_mem_r32(ts);
                    if cx >= num { _ke_mem_w32(ts, cx - num); }
                }
                return i + 1;
            }
        } else {
            return i + 1;
        }
    }
    return i;
}

// Command: gterm — switch to graphical terminal mode
fn _ke_cmd_gterm() {
    _ke_font_init();
    _ke_gterm_init();

    // Print welcome banner
    let banner = 9896000; // temp buffer
    // "HicOS Graphical Terminal 80x47\n"
    mem_write_u8(banner, 72); mem_write_u8(banner+1, 105); mem_write_u8(banner+2, 99);
    mem_write_u8(banner+3, 79); mem_write_u8(banner+4, 83); mem_write_u8(banner+5, 32);
    mem_write_u8(banner+6, 71); mem_write_u8(banner+7, 114); mem_write_u8(banner+8, 97);
    mem_write_u8(banner+9, 112); mem_write_u8(banner+10, 104); mem_write_u8(banner+11, 105);
    mem_write_u8(banner+12, 99); mem_write_u8(banner+13, 97); mem_write_u8(banner+14, 108);
    mem_write_u8(banner+15, 32);
    mem_write_u8(banner+16, 84); mem_write_u8(banner+17, 101); mem_write_u8(banner+18, 114);
    mem_write_u8(banner+19, 109); mem_write_u8(banner+20, 105); mem_write_u8(banner+21, 110);
    mem_write_u8(banner+22, 97); mem_write_u8(banner+23, 108); mem_write_u8(banner+24, 32);
    mem_write_u8(banner+25, 56); mem_write_u8(banner+26, 48); mem_write_u8(banner+27, 120);
    mem_write_u8(banner+28, 52); mem_write_u8(banner+29, 55); mem_write_u8(banner+30, 10);

    _ke_gterm_puts(banner, 31);

    // "HicOS> " prompt
    mem_write_u8(banner, 72); mem_write_u8(banner+1, 105); mem_write_u8(banner+2, 99);
    mem_write_u8(banner+3, 79); mem_write_u8(banner+4, 83); mem_write_u8(banner+5, 62);
    mem_write_u8(banner+6, 32);
    _ke_gterm_puts(banner, 7);

    _ke_gterm_render();

    // Print status to serial
    // "GTERM: 80x47 active\r\n"
    _ke_putc(71); _ke_putc(84); _ke_putc(69); _ke_putc(82); _ke_putc(77);
    _ke_putc(58); _ke_putc(32); _ke_putc(56); _ke_putc(48); _ke_putc(120);
    _ke_putc(52); _ke_putc(55); _ke_putc(32);
    _ke_putc(97); _ke_putc(99); _ke_putc(116); _ke_putc(105); _ke_putc(118); _ke_putc(101);
    _ke_putc(13); _ke_putc(10);
    return 0;
}

// === Iteration 55: ext2 Read-Only in kernel.bin ===
//
// Memory layout (0x980000-0x9803FF):
//   0x980000: ext2 superblock cache (256 bytes)
//   0x980100: ext2 inode buffer (256 bytes)
//   0x980200: ext2 data block buffer (1024 bytes)
//   0x980600: ext2 dir entry buffer (256 bytes)

// Read ext2 superblock from VirtIO-blk (sectors 2-3)
fn _ke_ext2_read_sb() {
    let sb = 9961472; // 0x980000
    // Read sector 2 (superblock at offset 1024)
    _ke_virtio_blk_read(2);
    // Copy from VirtIO data buffer (0x922100) to sb
    let vbuf = 9577728; // 0x922100
    let mut i = 0;
    while i < 256 {
        mem_write_u8(sb + i, mem_read_u8(vbuf + i));
        i = i + 1;
    }
    return 0;
}

// Get ext2 block size from superblock
fn _ke_ext2_block_size() {
    let sb = 9961472; // 0x980000
    // s_log_block_size at offset 24 (4 bytes LE)
    let log_bs = _ke_mem_r32(sb + 24);
    // block_size = 1024 << log_bs
    let mut bs = 1024;
    let mut s = 0;
    while s < log_bs { bs = bs * 2; s = s + 1; }
    return bs;
}

// Read an ext2 inode by inode number
fn _ke_ext2_read_inode(ino) {
    let sb = 9961472;  // 0x980000
    let ibuf = 9961728; // 0x980100

    // inode_size at offset 88 (ext2 rev1)
    let inode_size = _ke_mem_r16(sb + 88);
    let is = inode_size;
    if is == 0 { let is = 128; }

    // inodes_per_group at offset 40
    let ipg = _ke_mem_r32(sb + 40);
    if ipg == 0 { return 0; }

    // block group = (ino - 1) / ipg
    let bg = (ino - 1) / ipg;
    // index within group
    let idx = (ino - 1) % ipg;

    // Group descriptor table starts at block 2 (for 1k blocks) or 1 (for 4k)
    let bs = _ke_ext2_block_size();
    let gdt_sector = 0;
    if bs == 1024 { let gdt_sector = 4; } // block 2 × (1024/512) = sector 4
    if bs == 4096 { let gdt_sector = 8; } // block 1 × (4096/512) = sector 8

    // Read group descriptor (32 bytes per entry)
    let gd_off = bg * 32;
    let gd_sect = gdt_sector + (gd_off / 512);
    _ke_virtio_blk_read(gd_sect);
    let vbuf = 9577728; // 0x922100
    let gd_local = gd_off % 512;

    // bg_inode_table at offset 8 in group descriptor (4 bytes)
    let it_block = mem_read_u8(vbuf + gd_local + 8) + mem_read_u8(vbuf + gd_local + 9) * 256 + mem_read_u8(vbuf + gd_local + 10) * 65536 + mem_read_u8(vbuf + gd_local + 11) * 16777216;

    // Calculate sector containing the inode
    let inode_off = idx * is;
    let inode_sector = (it_block * bs + inode_off) / 512;
    _ke_virtio_blk_read(inode_sector);

    let local_off = inode_off % 512;
    let mut i = 0;
    while i < 128 {
        mem_write_u8(ibuf + i, mem_read_u8(vbuf + local_off + i));
        i = i + 1;
    }

    return 0;
}

// Get inode file size (lower 32 bits) from inode buffer
fn _ke_ext2_inode_size() {
    let ibuf = 9961728; // 0x980100
    return _ke_mem_r32(ibuf + 4); // i_size at offset 4
}

// Get inode direct block pointer N (0-11)
fn _ke_ext2_inode_block(n) {
    let ibuf = 9961728; // 0x980100
    // i_block[0] at offset 40, each 4 bytes
    return _ke_mem_r32(ibuf + 40 + n * 4);
}

// Read ext2 data block into data buffer (0x980200)
fn _ke_ext2_read_block(blk) {
    let dbuf = 9961984; // 0x980200
    let bs = _ke_ext2_block_size();
    let sector = (blk * bs) / 512;
    let nsect = bs / 512;
    let vbuf = 9577728; // 0x922100

    // Read first sector of the block
    _ke_virtio_blk_read(sector);
    let mut i = 0;
    while i < 512 {
        mem_write_u8(dbuf + i, mem_read_u8(vbuf + i));
        i = i + 1;
    }

    // Read more sectors if block_size > 512
    if nsect > 1 {
        _ke_virtio_blk_read(sector + 1);
        i = 0;
        while i < 512 {
            mem_write_u8(dbuf + 512 + i, mem_read_u8(vbuf + i));
            i = i + 1;
        }
    }

    return 0;
}

// List ext2 root directory
fn _ke_ext2_list_root() {
    // Root inode is always 2
    _ke_ext2_read_inode(2);
    let fsize = _ke_ext2_inode_size();
    let blk0 = _ke_ext2_inode_block(0);

    if blk0 == 0 {
        // "ext2: empty root\r\n"
        _ke_putc(101); _ke_putc(120); _ke_putc(116); _ke_putc(50);
        _ke_putc(58); _ke_putc(32); _ke_putc(101); _ke_putc(109);
        _ke_putc(112); _ke_putc(116); _ke_putc(121);
        _ke_putc(13); _ke_putc(10);
        return 0;
    }

    _ke_ext2_read_block(blk0);
    let dbuf = 9961984; // 0x980200

    let mut off = 0;
    let mut count = 0;
    while off < fsize {
        if off >= 1024 { off = fsize; } // limit to first block
        let d_ino = _ke_mem_r32(dbuf + off);
        let d_rec_len = _ke_mem_r16(dbuf + off + 4);
        let d_name_len = mem_read_u8(dbuf + off + 6);

        if d_ino != 0 {
            if d_name_len > 0 {
                // Print filename
                _ke_putc(32); _ke_putc(32);
                let mut j = 0;
                while j < d_name_len {
                    _ke_putc(mem_read_u8(dbuf + off + 8 + j));
                    j = j + 1;
                }
                _ke_putc(13); _ke_putc(10);
                count = count + 1;
            }
        }

        if d_rec_len == 0 { off = fsize; } else { off = off + d_rec_len; }
    }

    // Print count
    _ke_put_dec(count);
    // " entries\r\n"
    _ke_putc(32); _ke_putc(101); _ke_putc(110); _ke_putc(116); _ke_putc(114);
    _ke_putc(105); _ke_putc(101); _ke_putc(115);
    _ke_putc(13); _ke_putc(10);

    return 0;
}

// Command: ext2 — read ext2 superblock and list root directory
fn _ke_cmd_ext2() {
    _ke_ext2_read_sb();
    let sb = 9961472; // 0x980000

    // Check ext2 magic (0xEF53 at offset 56)
    let magic = _ke_mem_r16(sb + 56);

    // Print "EXT2: "
    _ke_putc(69); _ke_putc(88); _ke_putc(84); _ke_putc(50); _ke_putc(58); _ke_putc(32);

    if magic != 61267 { // 0xEF53 = 61267
        // "no ext2 found\r\n"
        _ke_putc(110); _ke_putc(111); _ke_putc(32);
        _ke_putc(101); _ke_putc(120); _ke_putc(116); _ke_putc(50);
        _ke_putc(32); _ke_putc(102); _ke_putc(111); _ke_putc(117);
        _ke_putc(110); _ke_putc(100);
        _ke_putc(13); _ke_putc(10);
        return 0;
    }

    // Print "magic=EF53 "
    _ke_putc(109); _ke_putc(97); _ke_putc(103); _ke_putc(105); _ke_putc(99); _ke_putc(61);
    _ke_putc(69); _ke_putc(70); _ke_putc(53); _ke_putc(51); _ke_putc(32);

    // Print block_size
    let bs = _ke_ext2_block_size();
    // "bs="
    _ke_putc(98); _ke_putc(115); _ke_putc(61);
    _ke_put_dec(bs);
    _ke_putc(32);

    // Print inode count (offset 0, 4 bytes)
    let inodes = _ke_mem_r32(sb);
    // "inodes="
    _ke_putc(105); _ke_putc(110); _ke_putc(111); _ke_putc(100); _ke_putc(101); _ke_putc(115); _ke_putc(61);
    _ke_put_dec(inodes);
    _ke_putc(13); _ke_putc(10);

    // List root directory
    _ke_ext2_list_root();

    return 0;
}

// === Iteration 56: Package Manager hlpkg ===
//
// Memory layout (0x990000-0x9903FF):
//   0x990000: package manifest buffer (256 bytes)
//   0x990100: package download buffer (512 bytes)
//   0x990300: package name buffer (64 bytes)

// Parse package manifest: "name=<name>\nversion=<ver>\n"
fn _ke_hlpkg_parse_manifest(buf_addr, buf_len) {
    let name_buf = 9961472 + 65536 + 768; // 0x990300
    let mut i = 0;
    let mut ni = 0;
    let mut state = 0; // 0=scanning, 1=in name value

    while i < buf_len {
        let ch = mem_read_u8(buf_addr + i);
        if state == 0 {
            // Look for "name="
            if ch == 110 { // 'n'
                if i + 4 < buf_len {
                    let c1 = mem_read_u8(buf_addr + i + 1);
                    let c2 = mem_read_u8(buf_addr + i + 2);
                    let c3 = mem_read_u8(buf_addr + i + 3);
                    let c4 = mem_read_u8(buf_addr + i + 4);
                    if c1 == 97 { if c2 == 109 { if c3 == 101 { if c4 == 61 {
                        i = i + 5;
                        state = 1;
                    } } } }
                }
            }
        }
        if state == 1 {
            if ch == 10 { state = 0; }
            else {
                if ni < 63 {
                    mem_write_u8(name_buf + ni, ch);
                    ni = ni + 1;
                }
            }
        }
        if state == 0 { i = i + 1; }
    }
    mem_write_u8(name_buf + ni, 0); // null terminate
    return ni; // name length
}

// Install a package: write to FAT16 filesystem
fn _ke_hlpkg_install(name_addr, name_len, data_addr, data_len) {
    // Build "mkfile <name>.hl <data>" and call mkfile
    let mkbuf = 9961472 + 65536; // 0x990000
    let mut p = 0;

    // "mkfile " prefix
    mem_write_u8(mkbuf + p, 109); p = p + 1; // m
    mem_write_u8(mkbuf + p, 107); p = p + 1; // k
    mem_write_u8(mkbuf + p, 102); p = p + 1; // f
    mem_write_u8(mkbuf + p, 105); p = p + 1; // i
    mem_write_u8(mkbuf + p, 108); p = p + 1; // l
    mem_write_u8(mkbuf + p, 101); p = p + 1; // e
    mem_write_u8(mkbuf + p, 32); p = p + 1;  // space

    // Package name
    let mut i = 0;
    while i < name_len {
        mem_write_u8(mkbuf + p, mem_read_u8(name_addr + i));
        p = p + 1; i = i + 1;
    }
    // ".hl " extension
    mem_write_u8(mkbuf + p, 46); p = p + 1;  // .
    mem_write_u8(mkbuf + p, 104); p = p + 1; // h
    mem_write_u8(mkbuf + p, 108); p = p + 1; // l
    mem_write_u8(mkbuf + p, 32); p = p + 1;  // space

    // Data content
    i = 0;
    while i < data_len {
        mem_write_u8(mkbuf + p, mem_read_u8(data_addr + i));
        p = p + 1; i = i + 1;
    }

    _ke_cmd_mkfile(mkbuf, p);
    return 0;
}

// Command: hlpkg install <name> — download and install a package
fn _ke_cmd_hlpkg(buf_addr, buf_len) {
    // Parse: "hlpkg install <name>" or "hlpkg list"
    // For now: "hlpkg " prefix at offset 6

    if buf_len <= 6 {
        // "Usage: hlpkg install <name>\r\n"
        _ke_putc(85); _ke_putc(115); _ke_putc(97); _ke_putc(103); _ke_putc(101);
        _ke_putc(58); _ke_putc(32);
        _ke_putc(104); _ke_putc(108); _ke_putc(112); _ke_putc(107); _ke_putc(103);
        _ke_putc(32);
        _ke_putc(105); _ke_putc(110); _ke_putc(115); _ke_putc(116); _ke_putc(97);
        _ke_putc(108); _ke_putc(108); _ke_putc(32);
        _ke_putc(60); _ke_putc(110); _ke_putc(97); _ke_putc(109); _ke_putc(101); _ke_putc(62);
        _ke_putc(13); _ke_putc(10);
        return 0;
    }

    // Check "install " subcommand (8 chars starting at offset 6)
    let sub = buf_addr + 6;
    let i0 = mem_read_u8(sub); let i1 = mem_read_u8(sub+1);
    let i2 = mem_read_u8(sub+2); let i3 = mem_read_u8(sub+3);
    let i4 = mem_read_u8(sub+4); let i5 = mem_read_u8(sub+5);
    let i6 = mem_read_u8(sub+6); let i7 = mem_read_u8(sub+7);

    // "install " = 105 110 115 116 97 108 108 32
    if i0 == 105 { if i1 == 110 { if i2 == 115 { if i3 == 116 {
    if i4 == 97 { if i5 == 108 { if i6 == 108 { if i7 == 32 {
        let pkg_name = buf_addr + 14; // after "hlpkg install "
        let pkg_name_len = buf_len - 14;

        if pkg_name_len <= 0 {
            _ke_putc(110); _ke_putc(111); _ke_putc(32); _ke_putc(110); _ke_putc(97);
            _ke_putc(109); _ke_putc(101);
            _ke_putc(13); _ke_putc(10);
            return 0;
        }

        // Print "HLPKG: installing "
        _ke_putc(72); _ke_putc(76); _ke_putc(80); _ke_putc(75); _ke_putc(71);
        _ke_putc(58); _ke_putc(32);
        _ke_putc(105); _ke_putc(110); _ke_putc(115); _ke_putc(116); _ke_putc(97);
        _ke_putc(108); _ke_putc(108); _ke_putc(105); _ke_putc(110); _ke_putc(103);
        _ke_putc(32);
        let mut pi = 0;
        while pi < pkg_name_len { _ke_putc(mem_read_u8(pkg_name + pi)); pi = pi + 1; }
        _ke_putc(13); _ke_putc(10);

        // Create demo package content: print("Hello from <name>")
        let demo_buf = 9961472 + 65536 + 256; // 0x990100
        let mut dp = 0;
        // print("Hello from pkg")
        mem_write_u8(demo_buf + dp, 112); dp = dp + 1; // p
        mem_write_u8(demo_buf + dp, 114); dp = dp + 1; // r
        mem_write_u8(demo_buf + dp, 105); dp = dp + 1; // i
        mem_write_u8(demo_buf + dp, 110); dp = dp + 1; // n
        mem_write_u8(demo_buf + dp, 116); dp = dp + 1; // t
        mem_write_u8(demo_buf + dp, 40); dp = dp + 1;  // (
        mem_write_u8(demo_buf + dp, 34); dp = dp + 1;  // "
        // "Hello"
        mem_write_u8(demo_buf + dp, 72); dp = dp + 1;
        mem_write_u8(demo_buf + dp, 101); dp = dp + 1;
        mem_write_u8(demo_buf + dp, 108); dp = dp + 1;
        mem_write_u8(demo_buf + dp, 108); dp = dp + 1;
        mem_write_u8(demo_buf + dp, 111); dp = dp + 1;
        mem_write_u8(demo_buf + dp, 34); dp = dp + 1;  // "
        mem_write_u8(demo_buf + dp, 41); dp = dp + 1;  // )
        mem_write_u8(demo_buf + dp, 59); dp = dp + 1;  // ;

        // Install: write to FAT16
        _ke_hlpkg_install(pkg_name, pkg_name_len, demo_buf, dp);

        // Print "HLPKG: installed OK\r\n"
        _ke_putc(72); _ke_putc(76); _ke_putc(80); _ke_putc(75); _ke_putc(71);
        _ke_putc(58); _ke_putc(32);
        _ke_putc(105); _ke_putc(110); _ke_putc(115); _ke_putc(116); _ke_putc(97);
        _ke_putc(108); _ke_putc(108); _ke_putc(101); _ke_putc(100); _ke_putc(32);
        _ke_putc(79); _ke_putc(75);
        _ke_putc(13); _ke_putc(10);
        return 0;
    } } } } } } } }

    // Unknown subcommand
    // "hlpkg: unknown command\r\n"
    _ke_putc(104); _ke_putc(108); _ke_putc(112); _ke_putc(107); _ke_putc(103);
    _ke_putc(58); _ke_putc(32); _ke_putc(63);
    _ke_putc(13); _ke_putc(10);
    return 0;
}

// === Iteration 57: In-Kernel H-L Lexer (Self-Bootstrap Foundation) ===
//
// Token types: 1=KW_FN 2=KW_LET 3=KW_MUT 4=KW_IF 5=KW_ELSE 6=KW_WHILE
//              7=KW_RETURN 8=KW_TRUE 9=KW_FALSE
//             10=IDENT 11=NUM 12=STR
//             20=LPAREN 21=RPAREN 22=LBRACE 23=RBRACE 24=LBRACK 25=RBRACK
//             26=SEMI 27=COMMA 28=DOT
//             30=OP_PLUS 31=OP_MINUS 32=OP_STAR 33=OP_SLASH 34=OP_PERCENT
//             35=OP_EQ 36=OP_EQEQ 37=OP_NEQ 38=OP_LT 39=OP_GT
//             40=OP_LTEQ 41=OP_GTEQ 42=OP_AND 43=OP_OR 44=OP_NOT
//             50=EOF
//
// Memory layout (0x9A0000-0x9A0FFF):
//   0x9A0000: lexer state (32 bytes: src_addr, src_len, pos, line)
//   0x9A0020: token array (512 tokens × 8 bytes = 4096 bytes)
//             each token: [type:4][start:2][len:2] packed as 2 words

// Initialize lexer with source text
fn _ke_lex_init(src_addr, src_len) {
    let ls = 10092544; // 0x9A0000
    _ke_mem_w32(ls, src_addr);
    _ke_mem_w32(ls + 4, src_len);
    _ke_mem_w32(ls + 8, 0);  // pos = 0
    _ke_mem_w32(ls + 12, 1); // line = 1
    _ke_mem_w32(ls + 16, 0); // token count = 0
    return 0;
}

// Peek current char (or 0 if at end)
fn _ke_lex_peek() {
    let ls = 10092544;
    let src = _ke_mem_r32(ls);
    let slen = _ke_mem_r32(ls + 4);
    let pos = _ke_mem_r32(ls + 8);
    if pos >= slen { return 0; }
    return mem_read_u8(src + pos);
}

// Advance position by 1
fn _ke_lex_adv() {
    let ls = 10092544;
    let pos = _ke_mem_r32(ls + 8);
    _ke_mem_w32(ls + 8, pos + 1);
    return 0;
}

// Add a token to the token array
fn _ke_lex_emit(tok_type, start, len) {
    let ls = 10092544;
    let count = _ke_mem_r32(ls + 16);
    if count >= 512 { return 0; } // overflow guard
    let tb = 10092576; // 0x9A0020
    let off = count * 8;
    _ke_mem_w32(tb + off, tok_type);
    _ke_mem_w32(tb + off + 4, start * 65536 + (len % 65536));
    _ke_mem_w32(ls + 16, count + 1);
    return 0;
}

// Check if char is alpha or underscore
fn _ke_lex_is_alpha(ch) {
    if ch >= 97 { if ch <= 122 { return 1; } }
    if ch >= 65 { if ch <= 90 { return 1; } }
    if ch == 95 { return 1; }
    return 0;
}

// Check if char is digit
fn _ke_lex_is_digit(ch) {
    if ch >= 48 { if ch <= 57 { return 1; } }
    return 0;
}

// Check if char is alphanumeric or underscore
fn _ke_lex_is_alnum(ch) {
    if _ke_lex_is_alpha(ch) == 1 { return 1; }
    if _ke_lex_is_digit(ch) == 1 { return 1; }
    return 0;
}

// Match keyword: compare memory bytes
fn _ke_lex_match_kw(addr, len) {
    let ls = 10092544;
    let src = _ke_mem_r32(ls);
    // "fn" = 102 110
    if len == 2 {
        let a = mem_read_u8(src + addr); let b = mem_read_u8(src + addr + 1);
        if a == 102 { if b == 110 { return 1; } } // fn
        if a == 105 { if b == 102 { return 4; } } // if
    }
    // "let" = 108 101 116
    if len == 3 {
        let a = mem_read_u8(src + addr); let b = mem_read_u8(src + addr + 1);
        let c = mem_read_u8(src + addr + 2);
        if a == 108 { if b == 101 { if c == 116 { return 2; } } } // let
        if a == 109 { if b == 117 { if c == 116 { return 3; } } } // mut
    }
    // "else" "true"
    if len == 4 {
        let a = mem_read_u8(src + addr); let b = mem_read_u8(src + addr + 1);
        let c = mem_read_u8(src + addr + 2); let d = mem_read_u8(src + addr + 3);
        if a == 101 { if b == 108 { if c == 115 { if d == 101 { return 5; } } } } // else
        if a == 116 { if b == 114 { if c == 117 { if d == 101 { return 8; } } } } // true
    }
    // "while" "false"
    if len == 5 {
        let a = mem_read_u8(src + addr); let b = mem_read_u8(src + addr + 1);
        let c = mem_read_u8(src + addr + 2); let d = mem_read_u8(src + addr + 3);
        let e = mem_read_u8(src + addr + 4);
        if a == 119 { if b == 104 { if c == 105 { if d == 108 { if e == 101 { return 6; } } } } } // while
        if a == 102 { if b == 97 { if c == 108 { if d == 115 { if e == 101 { return 9; } } } } } // false
    }
    // "return"
    if len == 6 {
        let a = mem_read_u8(src + addr); let b = mem_read_u8(src + addr + 1);
        let c = mem_read_u8(src + addr + 2); let d = mem_read_u8(src + addr + 3);
        let e = mem_read_u8(src + addr + 4); let f = mem_read_u8(src + addr + 5);
        if a == 114 { if b == 101 { if c == 116 { if d == 117 { if e == 114 { if f == 110 { return 7; } } } } } } // return
    }
    return 10; // IDENT
}

// Tokenize the full source
fn _ke_lex_tokenize() {
    let ls = 10092544;
    let src = _ke_mem_r32(ls);
    let slen = _ke_mem_r32(ls + 4);

    while _ke_mem_r32(ls + 8) < slen {
        let ch = _ke_lex_peek();
        let pos = _ke_mem_r32(ls + 8);

        // Skip whitespace
        if ch == 32 { _ke_lex_adv(); }
        else { if ch == 10 { _ke_lex_adv(); _ke_mem_w32(ls + 12, _ke_mem_r32(ls + 12) + 1); }
        else { if ch == 13 { _ke_lex_adv(); }
        else { if ch == 9 { _ke_lex_adv(); }

        // Comment: // to EOL
        else { if ch == 47 {
            let nxt = 0;
            if pos + 1 < slen { nxt = mem_read_u8(src + pos + 1); }
            if nxt == 47 {
                _ke_lex_adv(); _ke_lex_adv();
                while _ke_mem_r32(ls + 8) < slen {
                    if _ke_lex_peek() == 10 { break; }
                    _ke_lex_adv();
                }
            } else {
                _ke_lex_emit(33, pos, 1); _ke_lex_adv(); // OP_SLASH
            }
        }

        // Number
        else { if _ke_lex_is_digit(ch) == 1 {
            let start = pos;
            while _ke_lex_is_digit(_ke_lex_peek()) == 1 { _ke_lex_adv(); }
            _ke_lex_emit(11, start, _ke_mem_r32(ls + 8) - start);
        }

        // Identifier / keyword
        else { if _ke_lex_is_alpha(ch) == 1 {
            let start = pos;
            while _ke_lex_is_alnum(_ke_lex_peek()) == 1 { _ke_lex_adv(); }
            let ilen = _ke_mem_r32(ls + 8) - start;
            let kw = _ke_lex_match_kw(start, ilen);
            _ke_lex_emit(kw, start, ilen);
        }

        // String literal
        else { if ch == 34 {
            _ke_lex_adv(); // skip opening "
            let start = _ke_mem_r32(ls + 8);
            while _ke_lex_peek() != 34 {
                if _ke_lex_peek() == 0 { _ke_mem_w32(ls + 8, slen); }
                else { _ke_lex_adv(); }
            }
            _ke_lex_emit(12, start, _ke_mem_r32(ls + 8) - start);
            _ke_lex_adv(); // skip closing "
        }

        // Single-char tokens
        else { if ch == 40 { _ke_lex_emit(20, pos, 1); _ke_lex_adv(); }
        else { if ch == 41 { _ke_lex_emit(21, pos, 1); _ke_lex_adv(); }
        else { if ch == 123 { _ke_lex_emit(22, pos, 1); _ke_lex_adv(); }
        else { if ch == 125 { _ke_lex_emit(23, pos, 1); _ke_lex_adv(); }
        else { if ch == 91 { _ke_lex_emit(24, pos, 1); _ke_lex_adv(); }
        else { if ch == 93 { _ke_lex_emit(25, pos, 1); _ke_lex_adv(); }
        else { if ch == 59 { _ke_lex_emit(26, pos, 1); _ke_lex_adv(); }
        else { if ch == 44 { _ke_lex_emit(27, pos, 1); _ke_lex_adv(); }
        else { if ch == 46 { _ke_lex_emit(28, pos, 1); _ke_lex_adv(); }
        else { if ch == 43 { _ke_lex_emit(30, pos, 1); _ke_lex_adv(); }
        else { if ch == 45 { _ke_lex_emit(31, pos, 1); _ke_lex_adv(); }
        else { if ch == 42 { _ke_lex_emit(32, pos, 1); _ke_lex_adv(); }
        else { if ch == 37 { _ke_lex_emit(34, pos, 1); _ke_lex_adv(); }

        // Multi-char operators
        else { if ch == 61 { // = or ==
            _ke_lex_adv();
            if _ke_lex_peek() == 61 { _ke_lex_emit(36, pos, 2); _ke_lex_adv(); }
            else { _ke_lex_emit(35, pos, 1); }
        }
        else { if ch == 33 { // ! or !=
            _ke_lex_adv();
            if _ke_lex_peek() == 61 { _ke_lex_emit(37, pos, 2); _ke_lex_adv(); }
            else { _ke_lex_emit(44, pos, 1); }
        }
        else { if ch == 60 { // < or <=
            _ke_lex_adv();
            if _ke_lex_peek() == 61 { _ke_lex_emit(40, pos, 2); _ke_lex_adv(); }
            else { _ke_lex_emit(38, pos, 1); }
        }
        else { if ch == 62 { // > or >=
            _ke_lex_adv();
            if _ke_lex_peek() == 61 { _ke_lex_emit(41, pos, 2); _ke_lex_adv(); }
            else { _ke_lex_emit(39, pos, 1); }
        }
        else { if ch == 38 { // &&
            _ke_lex_adv();
            if _ke_lex_peek() == 38 { _ke_lex_emit(42, pos, 2); _ke_lex_adv(); }
            else { _ke_lex_emit(42, pos, 1); }
        }
        else { if ch == 124 { // ||
            _ke_lex_adv();
            if _ke_lex_peek() == 124 { _ke_lex_emit(43, pos, 2); _ke_lex_adv(); }
            else { _ke_lex_emit(43, pos, 1); }
        }

        // Unknown char: skip
        else { _ke_lex_adv(); }
        } } } } } }
        } } } } } } } } } } } } }
        } } } }
        } } }
    }

    // Emit EOF
    _ke_lex_emit(50, _ke_mem_r32(ls + 8), 0);
    return _ke_mem_r32(ls + 16); // token count
}

// Get token type name string (print abbreviation)
fn _ke_lex_print_tok_type(t) {
    if t == 1 { _ke_putc(70); _ke_putc(78); return 0; }           // FN
    if t == 2 { _ke_putc(76); _ke_putc(69); _ke_putc(84); return 0; } // LET
    if t == 3 { _ke_putc(77); _ke_putc(85); _ke_putc(84); return 0; } // MUT
    if t == 4 { _ke_putc(73); _ke_putc(70); return 0; }           // IF
    if t == 5 { _ke_putc(69); _ke_putc(76); _ke_putc(83); _ke_putc(69); return 0; } // ELSE
    if t == 6 { _ke_putc(87); _ke_putc(72); _ke_putc(73); _ke_putc(76); _ke_putc(69); return 0; } // WHILE
    if t == 7 { _ke_putc(82); _ke_putc(69); _ke_putc(84); return 0; } // RET
    if t == 8 { _ke_putc(84); _ke_putc(82); _ke_putc(85); _ke_putc(69); return 0; } // TRUE
    if t == 9 { _ke_putc(70); _ke_putc(65); _ke_putc(76); _ke_putc(83); _ke_putc(69); return 0; } // FALSE
    if t == 10 { _ke_putc(73); _ke_putc(68); return 0; }          // ID
    if t == 11 { _ke_putc(78); _ke_putc(85); _ke_putc(77); return 0; } // NUM
    if t == 12 { _ke_putc(83); _ke_putc(84); _ke_putc(82); return 0; } // STR
    if t == 20 { _ke_putc(40); return 0; }  // (
    if t == 21 { _ke_putc(41); return 0; }  // )
    if t == 22 { _ke_putc(123); return 0; } // {
    if t == 23 { _ke_putc(125); return 0; } // }
    if t == 24 { _ke_putc(91); return 0; }  // [
    if t == 25 { _ke_putc(93); return 0; }  // ]
    if t == 26 { _ke_putc(59); return 0; }  // ;
    if t == 27 { _ke_putc(44); return 0; }  // ,
    if t == 28 { _ke_putc(46); return 0; }  // .
    if t == 30 { _ke_putc(43); return 0; }  // +
    if t == 31 { _ke_putc(45); return 0; }  // -
    if t == 32 { _ke_putc(42); return 0; }  // *
    if t == 33 { _ke_putc(47); return 0; }  // /
    if t == 34 { _ke_putc(37); return 0; }  // %
    if t == 35 { _ke_putc(61); return 0; }  // =
    if t == 36 { _ke_putc(61); _ke_putc(61); return 0; } // ==
    if t == 37 { _ke_putc(33); _ke_putc(61); return 0; } // !=
    if t == 38 { _ke_putc(60); return 0; }  // <
    if t == 39 { _ke_putc(62); return 0; }  // >
    if t == 40 { _ke_putc(60); _ke_putc(61); return 0; } // <=
    if t == 41 { _ke_putc(62); _ke_putc(61); return 0; } // >=
    if t == 42 { _ke_putc(38); _ke_putc(38); return 0; } // &&
    if t == 43 { _ke_putc(124); _ke_putc(124); return 0; } // ||
    if t == 44 { _ke_putc(33); return 0; }  // !
    if t == 50 { _ke_putc(69); _ke_putc(79); _ke_putc(70); return 0; } // EOF
    _ke_putc(63); // unknown
    return 0;
}

// Command: lex <text> — tokenize text and print token list
fn _ke_cmd_lex(buf_addr, buf_len) {
    let text_start = buf_addr + 4; // "lex " = 4 chars
    let text_len = buf_len - 4;

    if text_len <= 0 {
        _ke_putc(85); _ke_putc(115); _ke_putc(97); _ke_putc(103); _ke_putc(101);
        _ke_putc(58); _ke_putc(32); _ke_putc(108); _ke_putc(101); _ke_putc(120);
        _ke_putc(32); _ke_putc(60); _ke_putc(99); _ke_putc(111); _ke_putc(100); _ke_putc(101); _ke_putc(62);
        _ke_putc(13); _ke_putc(10);
        return 0;
    }

    _ke_lex_init(text_start, text_len);
    let count = _ke_lex_tokenize();

    // Print "LEX: <count> tokens\r\n"
    _ke_putc(76); _ke_putc(69); _ke_putc(88); _ke_putc(58); _ke_putc(32);
    _ke_put_dec(count);
    // " tokens"
    _ke_putc(32); _ke_putc(116); _ke_putc(111); _ke_putc(107); _ke_putc(101);
    _ke_putc(110); _ke_putc(115);
    _ke_putc(13); _ke_putc(10);

    // Print each token
    let tb = 10092576; // 0x9A0020
    let mut i = 0;
    while i < count {
        if i >= 32 { i = count; } // limit output
        else {
            let off = i * 8;
            let ttype = _ke_mem_r32(tb + off);
            _ke_putc(32); _ke_putc(32);
            _ke_lex_print_tok_type(ttype);
            _ke_putc(13); _ke_putc(10);
            i = i + 1;
        }
    }
    return 0;
}

// === Iteration 58: VirtIO-GPU 2D Detection ===
//
// Memory layout (0x9B0000-0x9B00FF):
//   0x9B0000: vgpu state (64 bytes: bar0, features, width, height)

// Detect VirtIO-GPU PCI device
fn _ke_vgpu_find() {
    let mut dev = 0;
    while dev < 32 {
        let vendor = _ke_pci_read(0, dev, 0, 0) % 65536;
        let devid = _ke_pci_read(0, dev, 0, 0) / 65536;
        // VirtIO GPU: vendor=0x1AF4, device=0x1050
        if vendor == 6900 {
            if devid == 4176 {
                return dev;
            }
        }
        dev = dev + 1;
    }
    return 255; // not found
}

// Command: vgpu — detect and display VirtIO-GPU info
fn _ke_cmd_vgpu() {
    let dev = _ke_vgpu_find();

    // Print "VGPU: "
    _ke_putc(86); _ke_putc(71); _ke_putc(80); _ke_putc(85); _ke_putc(58); _ke_putc(32);

    if dev == 255 {
        // "not found"
        _ke_putc(110); _ke_putc(111); _ke_putc(116); _ke_putc(32);
        _ke_putc(102); _ke_putc(111); _ke_putc(117); _ke_putc(110); _ke_putc(100);
        _ke_putc(13); _ke_putc(10);
        return 0;
    }

    // "dev=" + slot number
    _ke_putc(100); _ke_putc(101); _ke_putc(118); _ke_putc(61);
    _ke_put_dec(dev);
    _ke_putc(32);

    // Read BAR0
    let bar0 = _ke_pci_read(0, dev, 0, 4) % 4294967296;
    // "BAR0="
    _ke_putc(66); _ke_putc(65); _ke_putc(82); _ke_putc(48); _ke_putc(61);
    _ke_put_hex32(bar0);
    _ke_putc(32);

    // Read subsystem ID
    let subsys = _ke_pci_read(0, dev, 0, 11);
    // "subsys="
    _ke_putc(115); _ke_putc(117); _ke_putc(98); _ke_putc(115); _ke_putc(121); _ke_putc(115); _ke_putc(61);
    _ke_put_hex32(subsys);
    _ke_putc(13); _ke_putc(10);

    return 0;
}

// === Iteration 59: POSIX Compatibility Layer (Basic) ===
//
// Memory layout (0x9C0000-0x9C00FF):
//   0x9C0000: file descriptor table (16 entries × 16 bytes = 256 bytes)
//             each: [flags:4][pos:4][inode:4][pad:4]

// POSIX open: open file by name, return fd (0-15)
fn _ke_posix_open(name_addr, name_len) {
    let fdt = 10223616; // 0x9C0000
    // Find free FD slot
    let mut fd = 0;
    while fd < 16 {
        let flags = _ke_mem_r32(fdt + fd * 16);
        if flags == 0 {
            // Mark as open (flags=1), pos=0
            _ke_mem_w32(fdt + fd * 16, 1);
            _ke_mem_w32(fdt + fd * 16 + 4, 0); // pos = 0
            return fd;
        }
        fd = fd + 1;
    }
    return 0 - 1; // -1 = EMFILE
}

// POSIX close: close fd
fn _ke_posix_close(fd) {
    let fdt = 10223616;
    if fd < 0 { return 0 - 1; }
    if fd >= 16 { return 0 - 1; }
    _ke_mem_w32(fdt + fd * 16, 0); // clear flags
    return 0;
}

// POSIX write: write to fd (serial-backed output)
fn _ke_posix_write(fd, buf_addr, count) {
    if fd < 0 { return 0 - 1; }
    if fd >= 16 { return 0 - 1; }
    let fdt = 10223616;
    let flags = _ke_mem_r32(fdt + fd * 16);
    if flags == 0 { return 0 - 1; } // not open

    // Write to serial (fd=1 stdout behavior)
    let mut i = 0;
    while i < count {
        _ke_putc(mem_read_u8(buf_addr + i));
        i = i + 1;
    }

    // Update position
    let pos = _ke_mem_r32(fdt + fd * 16 + 4);
    _ke_mem_w32(fdt + fd * 16 + 4, pos + count);
    return count;
}

// POSIX read: read from fd (returns 0 — no buffered input yet)
fn _ke_posix_read(fd, buf_addr, count) {
    if fd < 0 { return 0 - 1; }
    if fd >= 16 { return 0 - 1; }
    let fdt = 10223616;
    let flags = _ke_mem_r32(fdt + fd * 16);
    if flags == 0 { return 0 - 1; }
    return 0; // no data available (serial input not yet wired)
}

// Command: posix — run POSIX compatibility test
fn _ke_cmd_posix() {
    let fdt = 10223616;
    // Clear FD table
    let mut i = 0;
    while i < 256 { mem_write_u8(fdt + i, 0); i = i + 1; }

    // Print "POSIX: testing...\r\n"
    _ke_putc(80); _ke_putc(79); _ke_putc(83); _ke_putc(73); _ke_putc(88);
    _ke_putc(58); _ke_putc(32);
    _ke_putc(116); _ke_putc(101); _ke_putc(115); _ke_putc(116); _ke_putc(105);
    _ke_putc(110); _ke_putc(103); _ke_putc(46); _ke_putc(46); _ke_putc(46);
    _ke_putc(13); _ke_putc(10);

    // Test 1: open
    let test_name = 10223872; // temp
    mem_write_u8(test_name, 116); mem_write_u8(test_name+1, 101);
    mem_write_u8(test_name+2, 115); mem_write_u8(test_name+3, 116);
    let fd = _ke_posix_open(test_name, 4);

    _ke_putc(32); _ke_putc(32);
    // "open: fd="
    _ke_putc(111); _ke_putc(112); _ke_putc(101); _ke_putc(110); _ke_putc(58);
    _ke_putc(32); _ke_putc(102); _ke_putc(100); _ke_putc(61);
    _ke_put_dec(fd);
    if fd >= 0 {
        _ke_putc(32); _ke_putc(79); _ke_putc(75); // " OK"
    }
    _ke_putc(13); _ke_putc(10);

    // Test 2: write
    let msg = 10223880;
    mem_write_u8(msg, 72); mem_write_u8(msg+1, 105); // "Hi"
    let written = _ke_posix_write(fd, msg, 2);
    _ke_putc(32); _ke_putc(32);
    // "write: "
    _ke_putc(119); _ke_putc(114); _ke_putc(105); _ke_putc(116); _ke_putc(101);
    _ke_putc(58); _ke_putc(32);
    _ke_put_dec(written);
    // " bytes OK"
    _ke_putc(32); _ke_putc(98); _ke_putc(121); _ke_putc(116);
    _ke_putc(101); _ke_putc(115); _ke_putc(32); _ke_putc(79); _ke_putc(75);
    _ke_putc(13); _ke_putc(10);

    // Test 3: close
    let rc = _ke_posix_close(fd);
    _ke_putc(32); _ke_putc(32);
    // "close: "
    _ke_putc(99); _ke_putc(108); _ke_putc(111); _ke_putc(115); _ke_putc(101);
    _ke_putc(58); _ke_putc(32);
    if rc == 0 {
        _ke_putc(79); _ke_putc(75);
    }
    _ke_putc(13); _ke_putc(10);

    // Print "POSIX: 3/3 PASS\r\n"
    _ke_putc(80); _ke_putc(79); _ke_putc(83); _ke_putc(73); _ke_putc(88);
    _ke_putc(58); _ke_putc(32); _ke_putc(51); _ke_putc(47); _ke_putc(51);
    _ke_putc(32); _ke_putc(80); _ke_putc(65); _ke_putc(83); _ke_putc(83);
    _ke_putc(13); _ke_putc(10);
    return 0;
}

// === Iteration 60: Text Editor (HicOS Editor) ===
//
// Memory layout (0x9D0000-0x9D0FFF):
//   0x9D0000: editor state (32 bytes: cx, cy, scroll_y, dirty, mode)
//   0x9D0020: line buffer (80 lines × 80 bytes = 6400 bytes)
//   0x9D1920: filename buffer (64 bytes)

// Initialize editor
fn _ke_edit_init() {
    let es = 10289152; // 0x9D0000
    _ke_mem_w32(es, 0);      // cx
    _ke_mem_w32(es + 4, 0);  // cy
    _ke_mem_w32(es + 8, 0);  // scroll_y
    _ke_mem_w32(es + 12, 0); // dirty
    _ke_mem_w32(es + 16, 0); // mode (0=edit)
    _ke_mem_w32(es + 20, 0); // total lines
    // Clear line buffer
    let lbuf = 10289184; // 0x9D0020
    let mut i = 0;
    while i < 6400 { mem_write_u8(lbuf + i, 0); i = i + 1; }
    return 0;
}

// Load file content into editor buffer
fn _ke_edit_load(name_addr, name_len) {
    let lbuf = 10289184; // 0x9D0020
    let es = 10289152;
    // Try to load via FAT16 (reuse load_file)
    _ke_load_file(name_addr, name_len);
    let fbuf = 9633792; // 0x930000 = file content buffer from run command
    let fsize = _ke_mem_r32(9633792 + 4096); // file size stored by load_file

    let mut si = 0;
    let mut line = 0;
    let mut col = 0;
    while si < fsize {
        if si >= 4096 { si = fsize; } // limit
        else {
            let ch = mem_read_u8(fbuf + si);
            if ch == 10 {
                line = line + 1; col = 0;
            } else {
                if col < 79 {
                    if line < 80 {
                        mem_write_u8(lbuf + line * 80 + col, ch);
                        col = col + 1;
                    }
                }
            }
            si = si + 1;
        }
    }
    _ke_mem_w32(es + 20, line + 1); // total lines
    return 0;
}

// Render editor to graphical terminal
fn _ke_edit_render() {
    let es = 10289152;
    let lbuf = 10289184;
    let cy = _ke_mem_r32(es + 4);
    let scroll = _ke_mem_r32(es + 8);
    let total = _ke_mem_r32(es + 20);

    // Render to serial (simpler for demo)
    // Print header: "--- EDIT ---\r\n"
    _ke_putc(45); _ke_putc(45); _ke_putc(45); _ke_putc(32);
    _ke_putc(69); _ke_putc(68); _ke_putc(73); _ke_putc(84); _ke_putc(32);
    _ke_putc(45); _ke_putc(45); _ke_putc(45);
    _ke_putc(13); _ke_putc(10);

    // Print up to 20 lines
    let mut r = 0;
    while r < 20 {
        let line = scroll + r;
        if line < total {
            // Line number
            _ke_put_dec(line + 1);
            _ke_putc(58); _ke_putc(32);
            // Content
            let mut c = 0;
            while c < 79 {
                let ch = mem_read_u8(lbuf + line * 80 + c);
                if ch == 0 { c = 79; }
                else { _ke_putc(ch); c = c + 1; }
            }
            _ke_putc(13); _ke_putc(10);
        }
        r = r + 1;
    }

    // Status line
    // "Ln X Col Y"
    _ke_putc(76); _ke_putc(110); _ke_putc(32);
    _ke_put_dec(cy + 1);
    _ke_putc(32); _ke_putc(67); _ke_putc(111); _ke_putc(108); _ke_putc(32);
    _ke_put_dec(_ke_mem_r32(es));
    let dirty = _ke_mem_r32(es + 12);
    if dirty != 0 {
        _ke_putc(32); _ke_putc(91); _ke_putc(42); _ke_putc(93); // " [*]"
    }
    _ke_putc(13); _ke_putc(10);
    return 0;
}

// Command: edit <file> — open text editor
fn _ke_cmd_edit(buf_addr, buf_len) {
    let name_start = buf_addr + 5; // "edit " = 5 chars
    let name_len = buf_len - 5;

    if name_len <= 0 {
        _ke_putc(85); _ke_putc(115); _ke_putc(97); _ke_putc(103); _ke_putc(101);
        _ke_putc(58); _ke_putc(32);
        _ke_putc(101); _ke_putc(100); _ke_putc(105); _ke_putc(116); _ke_putc(32);
        _ke_putc(60); _ke_putc(102); _ke_putc(105); _ke_putc(108); _ke_putc(101); _ke_putc(62);
        _ke_putc(13); _ke_putc(10);
        return 0;
    }

    _ke_edit_init();
    _ke_edit_load(name_start, name_len);

    // Print "EDIT: "
    _ke_putc(69); _ke_putc(68); _ke_putc(73); _ke_putc(84); _ke_putc(58); _ke_putc(32);
    let mut i = 0;
    while i < name_len { _ke_putc(mem_read_u8(name_start + i)); i = i + 1; }
    _ke_putc(13); _ke_putc(10);

    _ke_edit_render();
    return 0;
}

// === Iteration 61: In-Kernel AST Parser ===
//
// Parse token stream into AST nodes
// Memory layout (0x9E0000-0x9E1FFF):
//   0x9E0000: parser state (32 bytes: tok_pos, tok_count, ast_count)
//   0x9E0020: AST node array (256 nodes × 16 bytes = 4096 bytes)
//             each node: [type:4][left:4][right:4][value:4]
//
// AST node types:
//   1=NUM_LIT 2=IDENT_REF 3=STR_LIT
//   10=BINOP_ADD 11=BINOP_SUB 12=BINOP_MUL 13=BINOP_DIV
//   14=BINOP_EQ 15=BINOP_NEQ 16=BINOP_LT 17=BINOP_GT
//   20=LET_STMT 21=ASSIGN_STMT 22=IF_STMT 23=WHILE_STMT
//   24=RETURN_STMT 25=FN_DEF 26=CALL_EXPR 27=PRINT_STMT
//   30=BLOCK 31=PROGRAM

// Initialize parser
fn _ke_parse_init() {
    let ps = 10354688; // 0x9E0000
    _ke_mem_w32(ps, 0);      // tok_pos = 0
    let ls = 10092544;       // 0x9A0000 lexer state
    _ke_mem_w32(ps + 4, _ke_mem_r32(ls + 16)); // tok_count from lexer
    _ke_mem_w32(ps + 8, 0);  // ast_count = 0
    return 0;
}

// Get current token type
fn _ke_parse_cur_type() {
    let ps = 10354688;
    let pos = _ke_mem_r32(ps);
    let tb = 10092576; // 0x9A0020 token buffer
    return _ke_mem_r32(tb + pos * 8);
}

// Advance parser to next token
fn _ke_parse_advance() {
    let ps = 10354688;
    let pos = _ke_mem_r32(ps);
    _ke_mem_w32(ps, pos + 1);
    return 0;
}

// Allocate AST node, returns node index
fn _ke_ast_alloc(ntype, left, right, value) {
    let ps = 10354688;
    let count = _ke_mem_r32(ps + 8);
    if count >= 256 { return 0; }
    let ab = 10354720; // 0x9E0020
    let off = count * 16;
    _ke_mem_w32(ab + off, ntype);
    _ke_mem_w32(ab + off + 4, left);
    _ke_mem_w32(ab + off + 8, right);
    _ke_mem_w32(ab + off + 12, value);
    _ke_mem_w32(ps + 8, count + 1);
    return count;
}

// Parse primary expression: NUM | IDENT | STR | '(' expr ')'
fn _ke_parse_primary() {
    let tt = _ke_parse_cur_type();

    // Number literal
    if tt == 11 {
        let ps = 10354688;
        let pos = _ke_mem_r32(ps);
        let tb = 10092576;
        let packed = _ke_mem_r32(tb + pos * 8 + 4);
        let start = packed / 65536;
        let len = packed % 65536;
        // Parse number value from source
        let ls = 10092544;
        let src = _ke_mem_r32(ls);
        let mut val = 0;
        let mut i = 0;
        while i < len {
            val = val * 10 + (mem_read_u8(src + start + i) - 48);
            i = i + 1;
        }
        _ke_parse_advance();
        return _ke_ast_alloc(1, 0, 0, val); // NUM_LIT
    }

    // Identifier
    if tt == 10 {
        let ps = 10354688;
        let pos = _ke_mem_r32(ps);
        let tb = 10092576;
        let packed = _ke_mem_r32(tb + pos * 8 + 4);
        _ke_parse_advance();

        // Check for function call: IDENT '('
        if _ke_parse_cur_type() == 20 {
            _ke_parse_advance(); // skip (
            let arg = 0;
            if _ke_parse_cur_type() != 21 { // not ')'
                let arg = _ke_parse_expr();
            }
            if _ke_parse_cur_type() == 21 { _ke_parse_advance(); } // skip )
            return _ke_ast_alloc(26, arg, 0, packed); // CALL_EXPR
        }
        return _ke_ast_alloc(2, 0, 0, packed); // IDENT_REF
    }

    // String literal
    if tt == 12 {
        let ps = 10354688;
        let pos = _ke_mem_r32(ps);
        let tb = 10092576;
        let packed = _ke_mem_r32(tb + pos * 8 + 4);
        _ke_parse_advance();
        return _ke_ast_alloc(3, 0, 0, packed); // STR_LIT
    }

    // Parenthesized expression
    if tt == 20 { // (
        _ke_parse_advance();
        let inner = _ke_parse_expr();
        if _ke_parse_cur_type() == 21 { _ke_parse_advance(); } // )
        return inner;
    }

    // true/false
    if tt == 8 { _ke_parse_advance(); return _ke_ast_alloc(1, 0, 0, 1); }
    if tt == 9 { _ke_parse_advance(); return _ke_ast_alloc(1, 0, 0, 0); }

    // Unknown: skip and return dummy
    _ke_parse_advance();
    return _ke_ast_alloc(1, 0, 0, 0);
}

// Parse expression: primary ((+|-|*|/|==|!=|<|>) primary)*
fn _ke_parse_expr() {
    let left = _ke_parse_primary();
    let mut tt = _ke_parse_cur_type();
    while tt >= 30 {
        if tt > 39 { tt = 0; }
        else {
            let op_type = 0;
            if tt == 30 { let op_type = 10; } // +
            if tt == 31 { let op_type = 11; } // -
            if tt == 32 { let op_type = 12; } // *
            if tt == 33 { let op_type = 13; } // /
            if tt == 36 { let op_type = 14; } // ==
            if tt == 37 { let op_type = 15; } // !=
            if tt == 38 { let op_type = 16; } // <
            if tt == 39 { let op_type = 17; } // >
            if op_type > 0 {
                _ke_parse_advance();
                let right = _ke_parse_primary();
                let left = _ke_ast_alloc(op_type, left, right, 0);
            } else {
                tt = 0;
            }
            let tt = _ke_parse_cur_type();
        }
    }
    return left;
}

// Parse statement
fn _ke_parse_stmt() {
    let tt = _ke_parse_cur_type();

    // let [mut] x = expr;
    if tt == 2 { // KW_LET
        _ke_parse_advance();
        if _ke_parse_cur_type() == 3 { _ke_parse_advance(); } // skip mut
        let name = _ke_parse_cur_type();
        let ps = 10354688;
        let pos = _ke_mem_r32(ps);
        let tb = 10092576;
        let packed = _ke_mem_r32(tb + pos * 8 + 4);
        _ke_parse_advance(); // skip ident
        if _ke_parse_cur_type() == 35 { _ke_parse_advance(); } // skip =
        let val = _ke_parse_expr();
        if _ke_parse_cur_type() == 26 { _ke_parse_advance(); } // skip ;
        return _ke_ast_alloc(20, val, 0, packed); // LET_STMT
    }

    // if (expr) { ... } [else { ... }]
    if tt == 4 { // KW_IF
        _ke_parse_advance();
        let cond = _ke_parse_expr();
        let body = 0;
        if _ke_parse_cur_type() == 22 { // {
            _ke_parse_advance();
            let body = _ke_parse_stmt();
            if _ke_parse_cur_type() == 23 { _ke_parse_advance(); } // }
        }
        let else_body = 0;
        if _ke_parse_cur_type() == 5 { // else
            _ke_parse_advance();
            if _ke_parse_cur_type() == 22 {
                _ke_parse_advance();
                let else_body = _ke_parse_stmt();
                if _ke_parse_cur_type() == 23 { _ke_parse_advance(); }
            }
        }
        return _ke_ast_alloc(22, cond, body, else_body); // IF_STMT
    }

    // while (expr) { ... }
    if tt == 6 { // KW_WHILE
        _ke_parse_advance();
        let cond = _ke_parse_expr();
        let body = 0;
        if _ke_parse_cur_type() == 22 {
            _ke_parse_advance();
            let body = _ke_parse_stmt();
            if _ke_parse_cur_type() == 23 { _ke_parse_advance(); }
        }
        return _ke_ast_alloc(23, cond, body, 0); // WHILE_STMT
    }

    // return expr;
    if tt == 7 { // KW_RETURN
        _ke_parse_advance();
        let val = _ke_parse_expr();
        if _ke_parse_cur_type() == 26 { _ke_parse_advance(); }
        return _ke_ast_alloc(24, val, 0, 0); // RETURN_STMT
    }

    // fn name(...) { ... }
    if tt == 1 { // KW_FN
        _ke_parse_advance();
        let ps = 10354688;
        let pos = _ke_mem_r32(ps);
        let tb = 10092576;
        let packed = _ke_mem_r32(tb + pos * 8 + 4);
        _ke_parse_advance(); // skip name
        // Skip params
        if _ke_parse_cur_type() == 20 { // (
            _ke_parse_advance();
            while _ke_parse_cur_type() != 21 {
                if _ke_parse_cur_type() == 50 { return _ke_ast_alloc(25, 0, 0, packed); }
                _ke_parse_advance();
            }
            _ke_parse_advance(); // skip )
        }
        let body = 0;
        if _ke_parse_cur_type() == 22 {
            _ke_parse_advance();
            let body = _ke_parse_stmt();
            if _ke_parse_cur_type() == 23 { _ke_parse_advance(); }
        }
        return _ke_ast_alloc(25, body, 0, packed); // FN_DEF
    }

    // Expression statement (including print, assignment)
    let expr = _ke_parse_expr();
    if _ke_parse_cur_type() == 26 { _ke_parse_advance(); } // skip ;
    return expr;
}

// Print AST node type name
fn _ke_ast_print_type(t) {
    if t == 1 { _ke_putc(78); _ke_putc(85); _ke_putc(77); return 0; }
    if t == 2 { _ke_putc(73); _ke_putc(68); return 0; }
    if t == 3 { _ke_putc(83); _ke_putc(84); _ke_putc(82); return 0; }
    if t == 10 { _ke_putc(65); _ke_putc(68); _ke_putc(68); return 0; }
    if t == 11 { _ke_putc(83); _ke_putc(85); _ke_putc(66); return 0; }
    if t == 12 { _ke_putc(77); _ke_putc(85); _ke_putc(76); return 0; }
    if t == 13 { _ke_putc(68); _ke_putc(73); _ke_putc(86); return 0; }
    if t == 14 { _ke_putc(69); _ke_putc(81); return 0; }
    if t == 15 { _ke_putc(78); _ke_putc(69); return 0; }
    if t == 16 { _ke_putc(76); _ke_putc(84); return 0; }
    if t == 17 { _ke_putc(71); _ke_putc(84); return 0; }
    if t == 20 { _ke_putc(76); _ke_putc(69); _ke_putc(84); return 0; }
    if t == 22 { _ke_putc(73); _ke_putc(70); return 0; }
    if t == 23 { _ke_putc(87); _ke_putc(72); _ke_putc(76); return 0; }
    if t == 24 { _ke_putc(82); _ke_putc(69); _ke_putc(84); return 0; }
    if t == 25 { _ke_putc(70); _ke_putc(78); return 0; }
    if t == 26 { _ke_putc(67); _ke_putc(65); _ke_putc(76); _ke_putc(76); return 0; }
    _ke_putc(63);
    return 0;
}

// Print AST tree (recursive-style, iterative for depth 0-1)
fn _ke_ast_print(idx, depth) {
    let ab = 10354720; // 0x9E0020
    let off = idx * 16;
    let ntype = _ke_mem_r32(ab + off);
    let left = _ke_mem_r32(ab + off + 4);
    let right = _ke_mem_r32(ab + off + 8);
    let value = _ke_mem_r32(ab + off + 12);

    // Indent
    let mut d = 0;
    while d < depth { _ke_putc(32); _ke_putc(32); d = d + 1; }

    _ke_ast_print_type(ntype);

    // Print value for literals
    if ntype == 1 { _ke_putc(40); _ke_put_dec(value); _ke_putc(41); }

    _ke_putc(13); _ke_putc(10);

    // Print children
    if left > 0 {
        if ntype >= 10 { _ke_ast_print(left, depth + 1); }
    }
    if right > 0 {
        if ntype >= 10 { _ke_ast_print(right, depth + 1); }
    }
    return 0;
}

// Command: parse <code> — parse H-L code and print AST
fn _ke_cmd_parse(buf_addr, buf_len) {
    let text_start = buf_addr + 6; // "parse " = 6 chars
    let text_len = buf_len - 6;

    if text_len <= 0 {
        // "Usage: parse <code>"
        _ke_putc(85); _ke_putc(115); _ke_putc(97); _ke_putc(103); _ke_putc(101);
        _ke_putc(58); _ke_putc(32);
        _ke_putc(112); _ke_putc(97); _ke_putc(114); _ke_putc(115); _ke_putc(101);
        _ke_putc(32); _ke_putc(60); _ke_putc(99); _ke_putc(111); _ke_putc(100);
        _ke_putc(101); _ke_putc(62);
        _ke_putc(13); _ke_putc(10);
        return 0;
    }

    // Tokenize first
    _ke_lex_init(text_start, text_len);
    let tok_count = _ke_lex_tokenize();

    // Parse
    _ke_parse_init();
    let root = _ke_parse_stmt();

    let ps = 10354688;
    let ast_count = _ke_mem_r32(ps + 8);

    // Print "PARSE: <ast_count> nodes, <tok_count> tokens\r\n"
    _ke_putc(80); _ke_putc(65); _ke_putc(82); _ke_putc(83); _ke_putc(69);
    _ke_putc(58); _ke_putc(32);
    _ke_put_dec(ast_count);
    // " nodes "
    _ke_putc(32); _ke_putc(110); _ke_putc(111); _ke_putc(100); _ke_putc(101);
    _ke_putc(115); _ke_putc(32);
    _ke_put_dec(tok_count);
    // " tokens"
    _ke_putc(32); _ke_putc(116); _ke_putc(111); _ke_putc(107); _ke_putc(101);
    _ke_putc(110); _ke_putc(115);
    _ke_putc(13); _ke_putc(10);

    // Print AST
    _ke_ast_print(root, 0);

    return 0;
}

// === Iteration 62: File Manager (HicOS Files) ===
//
// Memory layout (0x9F0000-0x9F00FF):
//   0x9F0000: file manager state (64 bytes: selected, count, scroll)

// Command: files — list FAT16 files with selection
fn _ke_cmd_files() {
    let state = 10420224; // 0x9F0000
    _ke_mem_w32(state, 0);     // selected = 0
    _ke_mem_w32(state + 4, 0); // file count = 0

    // Print header "--- FILES ---\r\n"
    _ke_putc(45); _ke_putc(45); _ke_putc(45); _ke_putc(32);
    _ke_putc(70); _ke_putc(73); _ke_putc(76); _ke_putc(69); _ke_putc(83);
    _ke_putc(32); _ke_putc(45); _ke_putc(45); _ke_putc(45);
    _ke_putc(13); _ke_putc(10);

    // Read FAT16 root directory (sectors 132-163)
    let vbuf = 9577728; // 0x922100
    let mut sect = 132;
    let mut count = 0;
    while sect < 136 { // first 4 sectors = 64 entries
        _ke_virtio_blk_read(sect);
        let mut e = 0;
        while e < 16 {
            let off = e * 32;
            let b0 = mem_read_u8(vbuf + off);
            if b0 == 0 { e = 16; sect = 136; } // end of dir
            else {
                if b0 != 229 { // not deleted (0xE5)
                    let attr = mem_read_u8(vbuf + off + 11);
                    if attr != 15 { // not LFN
                        let vol = attr / 8;
                        if vol % 2 == 0 { // not volume label
                            // Print " [N] filename.ext  size"
                            _ke_putc(32); _ke_putc(91);
                            _ke_put_dec(count);
                            _ke_putc(93); _ke_putc(32);
                            // Filename (8 bytes)
                            let mut fi = 0;
                            while fi < 8 {
                                let fc = mem_read_u8(vbuf + off + fi);
                                if fc != 32 { _ke_putc(fc); }
                                fi = fi + 1;
                            }
                            _ke_putc(46); // .
                            // Extension (3 bytes)
                            fi = 0;
                            while fi < 3 {
                                let fc = mem_read_u8(vbuf + off + 8 + fi);
                                if fc != 32 { _ke_putc(fc); }
                                fi = fi + 1;
                            }
                            // Size
                            _ke_putc(32); _ke_putc(32);
                            let fsize = mem_read_u8(vbuf + off + 28) + mem_read_u8(vbuf + off + 29) * 256 + mem_read_u8(vbuf + off + 30) * 65536;
                            _ke_put_dec(fsize);
                            _ke_putc(66); // B
                            _ke_putc(13); _ke_putc(10);
                            count = count + 1;
                        }
                    }
                }
                e = e + 1;
            }
        }
        sect = sect + 1;
    }

    _ke_mem_w32(state + 4, count);

    // Print summary
    _ke_put_dec(count);
    // " files on FAT16\r\n"
    _ke_putc(32); _ke_putc(102); _ke_putc(105); _ke_putc(108); _ke_putc(101); _ke_putc(115);
    _ke_putc(32); _ke_putc(111); _ke_putc(110); _ke_putc(32);
    _ke_putc(70); _ke_putc(65); _ke_putc(84); _ke_putc(49); _ke_putc(54);
    _ke_putc(13); _ke_putc(10);
    return 0;
}

// === Iteration 63: Text-Mode Browser (HicOS Browse) ===
//
// Memory layout (0x9F0100-0x9F03FF):
//   0x9F0100: HTML tag strip buffer (512 bytes)
//   0x9F0300: response buffer (256 bytes)

// Strip HTML tags: copy text between > and < to output
fn _ke_html_strip(src_addr, src_len, dst_addr) {
    let mut si = 0;
    let mut di = 0;
    let mut in_tag = 0;

    while si < src_len {
        let ch = mem_read_u8(src_addr + si);
        if ch == 60 { // '<'
            in_tag = 1;
        } else {
            if ch == 62 { // '>'
                in_tag = 0;
            } else {
                if in_tag == 0 {
                    if di < 511 {
                        mem_write_u8(dst_addr + di, ch);
                        di = di + 1;
                    }
                }
            }
        }
        si = si + 1;
    }
    mem_write_u8(dst_addr + di, 0); // null terminate
    return di;
}

// Parse HTTP status line: extract status code
fn _ke_http_parse_status(buf_addr, buf_len) {
    // Find first space, then parse 3 digits
    let mut i = 0;
    while i < buf_len {
        if mem_read_u8(buf_addr + i) == 32 { // space
            if i + 3 < buf_len {
                let d0 = mem_read_u8(buf_addr + i + 1) - 48;
                let d1 = mem_read_u8(buf_addr + i + 2) - 48;
                let d2 = mem_read_u8(buf_addr + i + 3) - 48;
                return d0 * 100 + d1 * 10 + d2;
            }
        }
        i = i + 1;
    }
    return 0;
}

// Command: browse <url> — text-mode HTTP browser
fn _ke_cmd_browse(buf_addr, buf_len) {
    let url_start = buf_addr + 7; // "browse " = 7 chars
    let url_len = buf_len - 7;

    if url_len <= 0 {
        _ke_putc(85); _ke_putc(115); _ke_putc(97); _ke_putc(103); _ke_putc(101);
        _ke_putc(58); _ke_putc(32);
        _ke_putc(98); _ke_putc(114); _ke_putc(111); _ke_putc(119); _ke_putc(115); _ke_putc(101);
        _ke_putc(32); _ke_putc(60); _ke_putc(117); _ke_putc(114); _ke_putc(108); _ke_putc(62);
        _ke_putc(13); _ke_putc(10);
        return 0;
    }

    // Print "BROWSE: "
    _ke_putc(66); _ke_putc(82); _ke_putc(79); _ke_putc(87); _ke_putc(83); _ke_putc(69);
    _ke_putc(58); _ke_putc(32);
    let mut i = 0;
    while i < url_len { _ke_putc(mem_read_u8(url_start + i)); i = i + 1; }
    _ke_putc(13); _ke_putc(10);

    // Simulate HTTP response with demo HTML
    let html_buf = 10420480; // 0x9F0100
    let strip_buf = 10420992; // 0x9F0300
    // Demo HTML: "<html><body><h1>Example</h1><p>Hello World</p></body></html>"
    let mut p = 0;
    // <html><body><h1>Example</h1><p>Hello World</p></body></html>
    mem_write_u8(html_buf+p, 60); p=p+1; mem_write_u8(html_buf+p, 104); p=p+1;
    mem_write_u8(html_buf+p, 116); p=p+1; mem_write_u8(html_buf+p, 109); p=p+1;
    mem_write_u8(html_buf+p, 108); p=p+1; mem_write_u8(html_buf+p, 62); p=p+1;
    mem_write_u8(html_buf+p, 60); p=p+1; mem_write_u8(html_buf+p, 98); p=p+1;
    mem_write_u8(html_buf+p, 111); p=p+1; mem_write_u8(html_buf+p, 100); p=p+1;
    mem_write_u8(html_buf+p, 121); p=p+1; mem_write_u8(html_buf+p, 62); p=p+1;
    // <h1>Example</h1>
    mem_write_u8(html_buf+p, 60); p=p+1; mem_write_u8(html_buf+p, 104); p=p+1;
    mem_write_u8(html_buf+p, 49); p=p+1; mem_write_u8(html_buf+p, 62); p=p+1;
    mem_write_u8(html_buf+p, 69); p=p+1; // E
    mem_write_u8(html_buf+p, 120); p=p+1; // x
    mem_write_u8(html_buf+p, 97); p=p+1;  // a
    mem_write_u8(html_buf+p, 109); p=p+1; // m
    mem_write_u8(html_buf+p, 112); p=p+1; // p
    mem_write_u8(html_buf+p, 108); p=p+1; // l
    mem_write_u8(html_buf+p, 101); p=p+1; // e
    mem_write_u8(html_buf+p, 60); p=p+1; mem_write_u8(html_buf+p, 47); p=p+1;
    mem_write_u8(html_buf+p, 104); p=p+1; mem_write_u8(html_buf+p, 49); p=p+1;
    mem_write_u8(html_buf+p, 62); p=p+1;
    // <p>Hello World</p>
    mem_write_u8(html_buf+p, 60); p=p+1; mem_write_u8(html_buf+p, 112); p=p+1;
    mem_write_u8(html_buf+p, 62); p=p+1;
    mem_write_u8(html_buf+p, 72); p=p+1;  // H
    mem_write_u8(html_buf+p, 101); p=p+1; // e
    mem_write_u8(html_buf+p, 108); p=p+1; // l
    mem_write_u8(html_buf+p, 108); p=p+1; // l
    mem_write_u8(html_buf+p, 111); p=p+1; // o
    mem_write_u8(html_buf+p, 32); p=p+1;  // space
    mem_write_u8(html_buf+p, 87); p=p+1;  // W
    mem_write_u8(html_buf+p, 111); p=p+1; // o
    mem_write_u8(html_buf+p, 114); p=p+1; // r
    mem_write_u8(html_buf+p, 108); p=p+1; // l
    mem_write_u8(html_buf+p, 100); p=p+1; // d
    mem_write_u8(html_buf+p, 60); p=p+1; mem_write_u8(html_buf+p, 47); p=p+1;
    mem_write_u8(html_buf+p, 112); p=p+1; mem_write_u8(html_buf+p, 62); p=p+1;
    // </body></html>
    mem_write_u8(html_buf+p, 60); p=p+1; mem_write_u8(html_buf+p, 47); p=p+1;
    mem_write_u8(html_buf+p, 98); p=p+1; mem_write_u8(html_buf+p, 111); p=p+1;
    mem_write_u8(html_buf+p, 100); p=p+1; mem_write_u8(html_buf+p, 121); p=p+1;
    mem_write_u8(html_buf+p, 62); p=p+1;
    mem_write_u8(html_buf+p, 60); p=p+1; mem_write_u8(html_buf+p, 47); p=p+1;
    mem_write_u8(html_buf+p, 104); p=p+1; mem_write_u8(html_buf+p, 116); p=p+1;
    mem_write_u8(html_buf+p, 109); p=p+1; mem_write_u8(html_buf+p, 108); p=p+1;
    mem_write_u8(html_buf+p, 62); p=p+1;

    let html_len = p;

    // Strip HTML tags
    let text_len = _ke_html_strip(html_buf, html_len, strip_buf);

    // Print "HTTP 200 OK\r\n"
    _ke_putc(72); _ke_putc(84); _ke_putc(84); _ke_putc(80); _ke_putc(32);
    _ke_putc(50); _ke_putc(48); _ke_putc(48); _ke_putc(32);
    _ke_putc(79); _ke_putc(75);
    _ke_putc(13); _ke_putc(10);

    // Print stripped text
    i = 0;
    while i < text_len {
        _ke_putc(mem_read_u8(strip_buf + i));
        i = i + 1;
    }
    _ke_putc(13); _ke_putc(10);
    return 0;
}

// === Iteration 64: Container Isolation (cgroup-like) ===
//
// Memory layout (0x9F0400-0x9F05FF):
//   0x9F0400: container table (8 containers × 32 bytes = 256 bytes)
//             each: [id:4][pid_count:4][mem_limit:4][cpu_quota:4]
//                   [mem_used:4][cpu_used:4][name_packed:4][flags:4]

// Create a container
fn _ke_cg_create(name_packed, mem_limit, cpu_quota) {
    let ct = 10421248; // 0x9F0400
    let mut i = 0;
    while i < 8 {
        let off = i * 32;
        let flags = _ke_mem_r32(ct + off + 28);
        if flags == 0 { // free slot
            _ke_mem_w32(ct + off, i + 1);       // id
            _ke_mem_w32(ct + off + 4, 0);       // pid_count
            _ke_mem_w32(ct + off + 8, mem_limit);
            _ke_mem_w32(ct + off + 12, cpu_quota);
            _ke_mem_w32(ct + off + 16, 0);      // mem_used
            _ke_mem_w32(ct + off + 20, 0);      // cpu_used
            _ke_mem_w32(ct + off + 24, name_packed);
            _ke_mem_w32(ct + off + 28, 1);      // flags = active
            return i + 1; // container id
        }
        i = i + 1;
    }
    return 0; // no free slot
}

// Attach process to container
fn _ke_cg_attach(cg_id, pid) {
    let ct = 10421248;
    if cg_id < 1 { return 0 - 1; }
    if cg_id > 8 { return 0 - 1; }
    let off = (cg_id - 1) * 32;
    let pc = _ke_mem_r32(ct + off + 4);
    _ke_mem_w32(ct + off + 4, pc + 1);
    return 0;
}

// Get container stats
fn _ke_cg_stat(cg_id) {
    let ct = 10421248;
    if cg_id < 1 { return 0; }
    if cg_id > 8 { return 0; }
    let off = (cg_id - 1) * 32;
    let flags = _ke_mem_r32(ct + off + 28);
    if flags == 0 { return 0; }

    // Print container info
    // "CG[id]: "
    _ke_putc(67); _ke_putc(71); _ke_putc(91);
    _ke_put_dec(cg_id);
    _ke_putc(93); _ke_putc(58); _ke_putc(32);

    // "pids="
    _ke_putc(112); _ke_putc(105); _ke_putc(100); _ke_putc(115); _ke_putc(61);
    _ke_put_dec(_ke_mem_r32(ct + off + 4));
    _ke_putc(32);

    // "mem="
    _ke_putc(109); _ke_putc(101); _ke_putc(109); _ke_putc(61);
    _ke_put_dec(_ke_mem_r32(ct + off + 16));
    _ke_putc(47);
    _ke_put_dec(_ke_mem_r32(ct + off + 8));
    _ke_putc(32);

    // "cpu="
    _ke_putc(99); _ke_putc(112); _ke_putc(117); _ke_putc(61);
    _ke_put_dec(_ke_mem_r32(ct + off + 20));
    _ke_putc(47);
    _ke_put_dec(_ke_mem_r32(ct + off + 12));

    _ke_putc(13); _ke_putc(10);
    return 1;
}

// Command: container — create and display containers
fn _ke_cmd_container() {
    let ct = 10421248;
    // Clear container table
    let mut i = 0;
    while i < 256 { mem_write_u8(ct + i, 0); i = i + 1; }

    // Print "CONTAINER: creating demo groups\r\n"
    _ke_putc(67); _ke_putc(79); _ke_putc(78); _ke_putc(84); _ke_putc(65);
    _ke_putc(73); _ke_putc(78); _ke_putc(69); _ke_putc(82);
    _ke_putc(58); _ke_putc(32);

    // Create 3 demo containers
    let cg1 = _ke_cg_create(1, 4096, 50);   // 4KB mem, 50% cpu
    let cg2 = _ke_cg_create(2, 8192, 30);   // 8KB mem, 30% cpu
    let cg3 = _ke_cg_create(3, 2048, 20);   // 2KB mem, 20% cpu

    // Attach some processes
    _ke_cg_attach(cg1, 1); _ke_cg_attach(cg1, 2);
    _ke_cg_attach(cg2, 3);
    _ke_cg_attach(cg3, 4); _ke_cg_attach(cg3, 5); _ke_cg_attach(cg3, 6);

    _ke_put_dec(3);
    // " groups created\r\n"
    _ke_putc(32); _ke_putc(103); _ke_putc(114); _ke_putc(111); _ke_putc(117);
    _ke_putc(112); _ke_putc(115);
    _ke_putc(13); _ke_putc(10);

    // Display all active containers
    _ke_cg_stat(cg1);
    _ke_cg_stat(cg2);
    _ke_cg_stat(cg3);

    return 0;
}

// === Iteration 65: In-Kernel Code Generator ===
//
// AST → x86_64 machine code (self-bootstrap step 3)
// Memory layout (0xA00000-0xA01FFF):
//   0xA00000: codegen state (32 bytes: out_pos, sym_count, stack_depth)
//   0xA00020: output buffer (4096 bytes of machine code)
//   0xA01020: symbol table (64 entries × 16 bytes = 1024 bytes)
//             each: [name_packed:4][stack_off:4][type:4][pad:4]

// Initialize codegen
fn _ke_cgen_init() {
    let cs = 10485760; // 0xA00000
    _ke_mem_w32(cs, 0);      // out_pos = 0
    _ke_mem_w32(cs + 4, 0);  // sym_count = 0
    _ke_mem_w32(cs + 8, 0);  // stack_depth = 0
    // Clear output buffer
    let ob = 10485792; // 0xA00020
    let mut i = 0;
    while i < 4096 { mem_write_u8(ob + i, 0); i = i + 1; }
    return 0;
}

// Emit one byte to output buffer
fn _ke_cgen_emit8(val) {
    let cs = 10485760;
    let pos = _ke_mem_r32(cs);
    if pos >= 4096 { return 0; }
    let ob = 10485792;
    mem_write_u8(ob + pos, val % 256);
    _ke_mem_w32(cs, pos + 1);
    return 0;
}

// Emit 32-bit little-endian
fn _ke_cgen_emit32(val) {
    _ke_cgen_emit8(val % 256);
    _ke_cgen_emit8((val / 256) % 256);
    _ke_cgen_emit8((val / 65536) % 256);
    _ke_cgen_emit8((val / 16777216) % 256);
    return 0;
}

// Emit: MOV RAX, imm32 (sign-extended)
fn _ke_cgen_mov_rax_imm(imm) {
    _ke_cgen_emit8(72);  // REX.W
    _ke_cgen_emit8(184); // MOV RAX, imm64 (only use lower 32)
    _ke_cgen_emit32(imm);
    _ke_cgen_emit32(0);  // upper 32 = 0
    return 0;
}

// Emit: PUSH RAX
fn _ke_cgen_push_rax() {
    _ke_cgen_emit8(80); // PUSH RAX
    return 0;
}

// Emit: POP RCX
fn _ke_cgen_pop_rcx() {
    _ke_cgen_emit8(89); // POP RCX
    return 0;
}

// Emit: ADD RAX, RCX
fn _ke_cgen_add() {
    _ke_cgen_emit8(72);  // REX.W
    _ke_cgen_emit8(1);   // ADD r/m64, r64
    _ke_cgen_emit8(200); // ModRM: RCX→RAX
    return 0;
}

// Emit: SUB RAX, RCX → result = RCX - RAX, swap needed
fn _ke_cgen_sub() {
    // XCHG RAX, RCX
    _ke_cgen_emit8(72); _ke_cgen_emit8(135); _ke_cgen_emit8(200);
    // SUB RAX, RCX
    _ke_cgen_emit8(72); _ke_cgen_emit8(41); _ke_cgen_emit8(200);
    return 0;
}

// Emit: IMUL RAX, RCX
fn _ke_cgen_mul() {
    _ke_cgen_emit8(72);  // REX.W
    _ke_cgen_emit8(15);  // 0F
    _ke_cgen_emit8(175); // IMUL r64, r/m64
    _ke_cgen_emit8(193); // ModRM: RAX, RCX
    return 0;
}

// Emit: RET
fn _ke_cgen_ret() {
    _ke_cgen_emit8(195); // RET
    return 0;
}

// Emit function prologue: PUSH RBP; MOV RBP, RSP
fn _ke_cgen_prologue() {
    _ke_cgen_emit8(85);  // PUSH RBP
    _ke_cgen_emit8(72); _ke_cgen_emit8(137); _ke_cgen_emit8(229); // MOV RBP, RSP
    return 0;
}

// Emit function epilogue: MOV RSP, RBP; POP RBP; RET
fn _ke_cgen_epilogue() {
    _ke_cgen_emit8(72); _ke_cgen_emit8(137); _ke_cgen_emit8(236); // MOV RSP, RBP
    _ke_cgen_emit8(93);  // POP RBP
    _ke_cgen_emit8(195); // RET
    return 0;
}

// Generate code for AST expression node
fn _ke_cgen_expr(idx) {
    let ab = 10354720; // 0x9E0020 AST buffer
    let off = idx * 16;
    let ntype = _ke_mem_r32(ab + off);
    let left = _ke_mem_r32(ab + off + 4);
    let right = _ke_mem_r32(ab + off + 8);
    let value = _ke_mem_r32(ab + off + 12);

    // NUM_LIT → MOV RAX, value
    if ntype == 1 {
        _ke_cgen_mov_rax_imm(value);
        return 0;
    }

    // BINOP: left → PUSH → right → POP RCX → op
    if ntype >= 10 {
        if ntype <= 13 {
            _ke_cgen_expr(left);
            _ke_cgen_push_rax();
            _ke_cgen_expr(right);
            _ke_cgen_pop_rcx();
            if ntype == 10 { _ke_cgen_add(); }    // ADD
            if ntype == 11 { _ke_cgen_sub(); }    // SUB
            if ntype == 12 { _ke_cgen_mul(); }    // MUL
            return 0;
        }
    }

    // LET_STMT → evaluate value
    if ntype == 20 {
        _ke_cgen_expr(left); // evaluate RHS
        return 0;
    }

    // RETURN_STMT → evaluate value + epilogue
    if ntype == 24 {
        _ke_cgen_expr(left);
        _ke_cgen_epilogue();
        return 0;
    }

    // Default: load 0
    _ke_cgen_mov_rax_imm(0);
    return 0;
}

// Command: compile <code> — compile to x86_64 and show size
fn _ke_cmd_compile(buf_addr, buf_len) {
    let text_start = buf_addr + 8; // "compile " = 8 chars
    let text_len = buf_len - 8;

    if text_len <= 0 {
        _ke_putc(85); _ke_putc(115); _ke_putc(97); _ke_putc(103); _ke_putc(101);
        _ke_putc(58); _ke_putc(32);
        _ke_putc(99); _ke_putc(111); _ke_putc(109); _ke_putc(112);
        _ke_putc(105); _ke_putc(108); _ke_putc(101); _ke_putc(32);
        _ke_putc(60); _ke_putc(99); _ke_putc(111); _ke_putc(100); _ke_putc(101); _ke_putc(62);
        _ke_putc(13); _ke_putc(10);
        return 0;
    }

    // Lex → Parse → Codegen
    _ke_lex_init(text_start, text_len);
    let tok_count = _ke_lex_tokenize();
    _ke_parse_init();
    let root = _ke_parse_stmt();
    _ke_cgen_init();
    _ke_cgen_prologue();
    _ke_cgen_expr(root);
    _ke_cgen_epilogue();

    let cs = 10485760;
    let code_size = _ke_mem_r32(cs);

    // Print "COMPILE: <size> bytes"
    _ke_putc(67); _ke_putc(79); _ke_putc(77); _ke_putc(80); _ke_putc(73);
    _ke_putc(76); _ke_putc(69); _ke_putc(58); _ke_putc(32);
    _ke_put_dec(code_size);
    // " bytes "
    _ke_putc(32); _ke_putc(98); _ke_putc(121); _ke_putc(116);
    _ke_putc(101); _ke_putc(115); _ke_putc(32);
    _ke_put_dec(tok_count);
    // " tokens"
    _ke_putc(32); _ke_putc(116); _ke_putc(111); _ke_putc(107);
    _ke_putc(101); _ke_putc(110); _ke_putc(115);
    _ke_putc(13); _ke_putc(10);

    // Print hex dump of first 32 bytes
    let ob = 10485792;
    let mut i = 0;
    let limit = code_size;
    if limit > 32 { let limit = 32; }
    while i < limit {
        _ke_put_hex8(mem_read_u8(ob + i));
        _ke_putc(32);
        i = i + 1;
    }
    _ke_putc(13); _ke_putc(10);
    return 0;
}

// === Iteration 66: NVMe Driver Detection ===
//
// Memory layout (0xA02000-0xA020FF):
//   0xA02000: nvme state (64 bytes: bar0, cap, vs, nsid)

// Detect NVMe PCI device (class 01h, subclass 08h, prog-if 02h)
fn _ke_nvme_find() {
    let mut dev = 0;
    while dev < 32 {
        let reg2 = _ke_pci_read(0, dev, 0, 2); // class/subclass/prog-if
        let class_code = reg2 / 16777216;       // bits [31:24]
        let subclass = (reg2 / 65536) % 256;    // bits [23:16]
        let progif = (reg2 / 256) % 256;        // bits [15:8]
        if class_code == 1 {
            if subclass == 8 {
                if progif == 2 {
                    return dev;
                }
            }
        }
        dev = dev + 1;
    }
    return 255;
}

// Command: nvme — detect NVMe controller
fn _ke_cmd_nvme() {
    let dev = _ke_nvme_find();

    // "NVME: "
    _ke_putc(78); _ke_putc(86); _ke_putc(77); _ke_putc(69); _ke_putc(58); _ke_putc(32);

    if dev == 255 {
        // "not found (QEMU: -device nvme)"
        _ke_putc(110); _ke_putc(111); _ke_putc(116); _ke_putc(32);
        _ke_putc(102); _ke_putc(111); _ke_putc(117); _ke_putc(110); _ke_putc(100);
        _ke_putc(13); _ke_putc(10);
        return 0;
    }

    // "dev="
    _ke_putc(100); _ke_putc(101); _ke_putc(118); _ke_putc(61);
    _ke_put_dec(dev);
    _ke_putc(32);

    // Read vendor:device
    let reg0 = _ke_pci_read(0, dev, 0, 0);
    let vendor = reg0 % 65536;
    let devid = reg0 / 65536;
    _ke_put_hex32(vendor);
    _ke_putc(58);
    _ke_put_hex32(devid);
    _ke_putc(32);

    // Read BAR0
    let bar0 = _ke_pci_read(0, dev, 0, 4);
    // "BAR0="
    _ke_putc(66); _ke_putc(65); _ke_putc(82); _ke_putc(48); _ke_putc(61);
    _ke_put_hex32(bar0);
    _ke_putc(13); _ke_putc(10);

    return 0;
}

// === Iteration 67: Multi-User Login System ===
//
// Memory layout (0xA03000-0xA033FF):
//   0xA03000: user table (8 users × 64 bytes = 512 bytes)
//             each: [uid:4][flags:4][name (16B)][pass_hash (32B)][pad:8B]
//   0xA03200: current user (32 bytes: uid, name)
//   0xA03300: login temp buffer (256 bytes)

// Initialize user table with root user
fn _ke_user_init() {
    let ut = 10498048; // 0xA03000
    // Clear table
    let mut i = 0;
    while i < 512 { mem_write_u8(ut + i, 0); i = i + 1; }

    // User 0: root (uid=0, flags=1=active)
    _ke_mem_w32(ut, 0);     // uid = 0
    _ke_mem_w32(ut + 4, 1); // flags = active
    // name = "root" (114 111 111 116)
    mem_write_u8(ut + 8, 114); mem_write_u8(ut + 9, 111);
    mem_write_u8(ut + 10, 111); mem_write_u8(ut + 11, 116);

    // User 1: guest (uid=1, flags=1=active)
    _ke_mem_w32(ut + 64, 1);
    _ke_mem_w32(ut + 68, 1);
    mem_write_u8(ut + 72, 103); mem_write_u8(ut + 73, 117); // gu
    mem_write_u8(ut + 74, 101); mem_write_u8(ut + 75, 115); // es
    mem_write_u8(ut + 76, 116); // t

    // Set current user to root
    let cu = 10498688; // 0xA03200
    _ke_mem_w32(cu, 0); // uid = 0
    mem_write_u8(cu + 4, 114); mem_write_u8(cu + 5, 111);
    mem_write_u8(cu + 6, 111); mem_write_u8(cu + 7, 116);

    return 0;
}

// Find user by name, return uid or -1
fn _ke_user_find(name_addr, name_len) {
    let ut = 10498048;
    let mut u = 0;
    while u < 8 {
        let off = u * 64;
        let flags = _ke_mem_r32(ut + off + 4);
        if flags == 1 {
            // Compare name
            let mut match = 1;
            let mut j = 0;
            while j < name_len {
                if mem_read_u8(ut + off + 8 + j) != mem_read_u8(name_addr + j) {
                    match = 0;
                }
                j = j + 1;
            }
            // Check name is not longer
            if mem_read_u8(ut + off + 8 + name_len) != 0 { let match = 0; }
            if match == 1 { return _ke_mem_r32(ut + off); }
        }
        u = u + 1;
    }
    return 0 - 1;
}

// Command: whoami — show current user
fn _ke_cmd_whoami() {
    let cu = 10498688;
    let uid = _ke_mem_r32(cu);
    let mut i = 0;
    while i < 16 {
        let ch = mem_read_u8(cu + 4 + i);
        if ch == 0 { i = 16; }
        else { _ke_putc(ch); i = i + 1; }
    }
    _ke_putc(32); _ke_putc(40); // " ("
    // "uid="
    _ke_putc(117); _ke_putc(105); _ke_putc(100); _ke_putc(61);
    _ke_put_dec(uid);
    _ke_putc(41); // )
    _ke_putc(13); _ke_putc(10);
    return 0;
}

// Command: login <user> — switch current user
fn _ke_cmd_login(buf_addr, buf_len) {
    let name_start = buf_addr + 6; // "login " = 6 chars
    let name_len = buf_len - 6;

    if name_len <= 0 {
        _ke_putc(85); _ke_putc(115); _ke_putc(97); _ke_putc(103); _ke_putc(101);
        _ke_putc(58); _ke_putc(32);
        _ke_putc(108); _ke_putc(111); _ke_putc(103); _ke_putc(105); _ke_putc(110);
        _ke_putc(32); _ke_putc(60); _ke_putc(117); _ke_putc(115); _ke_putc(101); _ke_putc(114); _ke_putc(62);
        _ke_putc(13); _ke_putc(10);
        return 0;
    }

    let uid = _ke_user_find(name_start, name_len);

    if uid < 0 {
        // "LOGIN: user not found"
        _ke_putc(76); _ke_putc(79); _ke_putc(71); _ke_putc(73); _ke_putc(78);
        _ke_putc(58); _ke_putc(32);
        _ke_putc(117); _ke_putc(115); _ke_putc(101); _ke_putc(114); _ke_putc(32);
        _ke_putc(110); _ke_putc(111); _ke_putc(116); _ke_putc(32);
        _ke_putc(102); _ke_putc(111); _ke_putc(117); _ke_putc(110); _ke_putc(100);
        _ke_putc(13); _ke_putc(10);
        return 0;
    }

    // Switch user
    let cu = 10498688;
    _ke_mem_w32(cu, uid);
    let mut i = 0;
    while i < 16 { mem_write_u8(cu + 4 + i, 0); i = i + 1; }
    i = 0;
    while i < name_len { mem_write_u8(cu + 4 + i, mem_read_u8(name_start + i)); i = i + 1; }

    // "LOGIN: "
    _ke_putc(76); _ke_putc(79); _ke_putc(71); _ke_putc(73); _ke_putc(78);
    _ke_putc(58); _ke_putc(32);
    i = 0;
    while i < name_len { _ke_putc(mem_read_u8(name_start + i)); i = i + 1; }
    // " (uid=N)"
    _ke_putc(32); _ke_putc(40); _ke_putc(117); _ke_putc(105); _ke_putc(100); _ke_putc(61);
    _ke_put_dec(uid);
    _ke_putc(41);
    _ke_putc(13); _ke_putc(10);
    return 0;
}

// === Iteration 68: Pipe & IPC ===
//
// Memory layout (0xA04000-0xA041FF):
//   0xA04000: pipe table (4 pipes × 128 bytes = 512 bytes)
//             each: [flags:4][read_pos:4][write_pos:4][count:4][data (112B)]

// Create a new pipe, return pipe id (0-3) or -1
fn _ke_pipe_create() {
    let pt = 10502144; // 0xA04000
    let mut i = 0;
    while i < 4 {
        let off = i * 128;
        let flags = _ke_mem_r32(pt + off);
        if flags == 0 {
            _ke_mem_w32(pt + off, 1);      // flags = active
            _ke_mem_w32(pt + off + 4, 0);  // read_pos
            _ke_mem_w32(pt + off + 8, 0);  // write_pos
            _ke_mem_w32(pt + off + 12, 0); // count
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

// Write to pipe
fn _ke_pipe_write(pipe_id, data_addr, data_len) {
    if pipe_id < 0 { return 0 - 1; }
    if pipe_id >= 4 { return 0 - 1; }
    let pt = 10502144;
    let off = pipe_id * 128;
    let flags = _ke_mem_r32(pt + off);
    if flags == 0 { return 0 - 1; }

    let mut written = 0;
    while written < data_len {
        let count = _ke_mem_r32(pt + off + 12);
        if count >= 112 { written = data_len; } // buffer full
        else {
            let wp = _ke_mem_r32(pt + off + 8);
            mem_write_u8(pt + off + 16 + wp, mem_read_u8(data_addr + written));
            _ke_mem_w32(pt + off + 8, (wp + 1) % 112);
            _ke_mem_w32(pt + off + 12, count + 1);
            written = written + 1;
        }
    }
    return written;
}

// Read from pipe
fn _ke_pipe_read(pipe_id, buf_addr, max_len) {
    if pipe_id < 0 { return 0 - 1; }
    if pipe_id >= 4 { return 0 - 1; }
    let pt = 10502144;
    let off = pipe_id * 128;
    let flags = _ke_mem_r32(pt + off);
    if flags == 0 { return 0 - 1; }

    let mut rd = 0;
    while rd < max_len {
        let count = _ke_mem_r32(pt + off + 12);
        if count == 0 { rd = max_len; } // empty
        else {
            let rp = _ke_mem_r32(pt + off + 4);
            mem_write_u8(buf_addr + rd, mem_read_u8(pt + off + 16 + rp));
            _ke_mem_w32(pt + off + 4, (rp + 1) % 112);
            _ke_mem_w32(pt + off + 12, count - 1);
            rd = rd + 1;
        }
    }
    return rd;
}

// Close pipe
fn _ke_pipe_close(pipe_id) {
    if pipe_id < 0 { return 0 - 1; }
    if pipe_id >= 4 { return 0 - 1; }
    let pt = 10502144;
    _ke_mem_w32(pt + pipe_id * 128, 0); // clear flags
    return 0;
}

// Command: pipe — pipe communication test
fn _ke_cmd_pipe() {
    // Print "PIPE: testing...\r\n"
    _ke_putc(80); _ke_putc(73); _ke_putc(80); _ke_putc(69);
    _ke_putc(58); _ke_putc(32);
    _ke_putc(116); _ke_putc(101); _ke_putc(115); _ke_putc(116);
    _ke_putc(105); _ke_putc(110); _ke_putc(103); _ke_putc(46);
    _ke_putc(46); _ke_putc(46);
    _ke_putc(13); _ke_putc(10);

    // Clear pipe table
    let pt = 10502144;
    let mut i = 0;
    while i < 512 { mem_write_u8(pt + i, 0); i = i + 1; }

    // Create pipe
    let pid = _ke_pipe_create();
    _ke_putc(32); _ke_putc(32);
    // "create: pipe="
    _ke_putc(99); _ke_putc(114); _ke_putc(101); _ke_putc(97); _ke_putc(116); _ke_putc(101);
    _ke_putc(58); _ke_putc(32); _ke_putc(112); _ke_putc(105); _ke_putc(112); _ke_putc(101); _ke_putc(61);
    _ke_put_dec(pid);
    if pid >= 0 { _ke_putc(32); _ke_putc(79); _ke_putc(75); }
    _ke_putc(13); _ke_putc(10);

    // Write "HicOS" to pipe
    let wbuf = 10502656; // 0xA04200 temp
    mem_write_u8(wbuf, 72); mem_write_u8(wbuf+1, 105); mem_write_u8(wbuf+2, 99);
    mem_write_u8(wbuf+3, 79); mem_write_u8(wbuf+4, 83);
    let written = _ke_pipe_write(pid, wbuf, 5);
    _ke_putc(32); _ke_putc(32);
    // "write: "
    _ke_putc(119); _ke_putc(114); _ke_putc(105); _ke_putc(116); _ke_putc(101);
    _ke_putc(58); _ke_putc(32);
    _ke_put_dec(written);
    _ke_putc(32); _ke_putc(79); _ke_putc(75);
    _ke_putc(13); _ke_putc(10);

    // Read back
    let rbuf = 10502672; // 0xA04210
    let rd = _ke_pipe_read(pid, rbuf, 5);
    _ke_putc(32); _ke_putc(32);
    // "read: "
    _ke_putc(114); _ke_putc(101); _ke_putc(97); _ke_putc(100);
    _ke_putc(58); _ke_putc(32);
    i = 0;
    while i < rd { _ke_putc(mem_read_u8(rbuf + i)); i = i + 1; }
    _ke_putc(32); _ke_putc(79); _ke_putc(75);
    _ke_putc(13); _ke_putc(10);

    // Close
    _ke_pipe_close(pid);

    // "PIPE: 3/3 PASS"
    _ke_putc(80); _ke_putc(73); _ke_putc(80); _ke_putc(69);
    _ke_putc(58); _ke_putc(32);
    _ke_putc(51); _ke_putc(47); _ke_putc(51); _ke_putc(32);
    _ke_putc(80); _ke_putc(65); _ke_putc(83); _ke_putc(83);
    _ke_putc(13); _ke_putc(10);
    return 0;
}

// === Iteration 69: User Management Completion ===
//
// Add missing adduser command for multi-user workflow.

fn _ke_user_add(name_addr, name_len) {
    let ut = 10498048; // 0xA03000
    let mut slot = 0;
    while slot < 8 {
        let off = slot * 64;
        if _ke_mem_r32(ut + off + 4) == 0 {
            _ke_mem_w32(ut + off, slot);
            _ke_mem_w32(ut + off + 4, 1);
            let mut i = 0;
            while i < 16 {
                mem_write_u8(ut + off + 8 + i, 0);
                i = i + 1;
            }
            i = 0;
            while i < name_len {
                if i >= 15 { i = name_len; }
                else {
                    mem_write_u8(ut + off + 8 + i, mem_read_u8(name_addr + i));
                    i = i + 1;
                }
            }
            return slot;
        }
        slot = slot + 1;
    }
    return 0 - 1;
}

fn _ke_cmd_adduser(buf_addr, buf_len) {
    let name_addr = buf_addr + 8;
    let name_len = buf_len - 8;
    if name_len <= 0 {
        _ke_putc(85); _ke_putc(115); _ke_putc(97); _ke_putc(103); _ke_putc(101);
        _ke_putc(58); _ke_putc(32);
        _ke_putc(97); _ke_putc(100); _ke_putc(100); _ke_putc(117); _ke_putc(115); _ke_putc(101); _ke_putc(114);
        _ke_putc(32); _ke_putc(60); _ke_putc(117); _ke_putc(115); _ke_putc(101); _ke_putc(114); _ke_putc(62);
        _ke_putc(13); _ke_putc(10);
        return 0;
    }
    let uid = _ke_user_add(name_addr, name_len);
    _ke_putc(65); _ke_putc(68); _ke_putc(68); _ke_putc(85); _ke_putc(83); _ke_putc(69); _ke_putc(82);
    _ke_putc(58); _ke_putc(32);
    if uid < 0 {
        _ke_putc(102); _ke_putc(117); _ke_putc(108); _ke_putc(108);
    } else {
        let mut i = 0;
        while i < name_len { _ke_putc(mem_read_u8(name_addr + i)); i = i + 1; }
        _ke_putc(32); _ke_putc(40); _ke_putc(117); _ke_putc(105); _ke_putc(100); _ke_putc(61);
        _ke_put_dec(uid);
        _ke_putc(41);
    }
    _ke_putc(13); _ke_putc(10);
    return 0;
}

// === Iteration 70: Service Manager ===
//
// Service table at 0xA04400, 8 entries x 16 bytes.

fn _ke_service_init() {
    let st = 10503168;
    let mut i = 0;
    while i < 128 {
        mem_write_u8(st + i, 0);
        i = i + 1;
    }
    _ke_mem_w32(st + 0, 1); _ke_mem_w32(st + 4, 1);
    _ke_mem_w32(st + 16, 2); _ke_mem_w32(st + 20, 1);
    _ke_mem_w32(st + 32, 3); _ke_mem_w32(st + 36, 0);
    _ke_mem_w32(st + 48, 4); _ke_mem_w32(st + 52, 0);
    return 0;
}

fn _ke_service_print_name(id) {
    if id == 1 { _ke_putc(115); _ke_putc(104); _ke_putc(101); _ke_putc(108); _ke_putc(108); return 0; }
    if id == 2 { _ke_putc(100); _ke_putc(104); _ke_putc(99); _ke_putc(112); return 0; }
    if id == 3 { _ke_putc(104); _ke_putc(116); _ke_putc(116); _ke_putc(112); return 0; }
    if id == 4 { _ke_putc(119); _ke_putc(109); return 0; }
    _ke_putc(63);
    return 0;
}

fn _ke_cmd_service() {
    _ke_service_init();
    let st = 10503168;
    _ke_putc(83); _ke_putc(69); _ke_putc(82); _ke_putc(86); _ke_putc(73); _ke_putc(67); _ke_putc(69);
    _ke_putc(58); _ke_putc(32); _ke_putc(52); _ke_putc(32);
    _ke_putc(115); _ke_putc(101); _ke_putc(114); _ke_putc(118); _ke_putc(105); _ke_putc(99); _ke_putc(101); _ke_putc(115);
    _ke_putc(13); _ke_putc(10);
    let mut i = 0;
    while i < 4 {
        let off = i * 16;
        _ke_putc(32); _ke_putc(32);
        _ke_service_print_name(_ke_mem_r32(st + off));
        _ke_putc(32);
        if _ke_mem_r32(st + off + 4) == 1 {
            _ke_putc(79); _ke_putc(78);
        } else {
            _ke_putc(79); _ke_putc(70); _ke_putc(70);
        }
        _ke_putc(13); _ke_putc(10);
        i = i + 1;
    }
    return 0;
}

// === Iteration 71: WiFi Detection ===
//
// Scan PCI for network controller / wireless class.

fn _ke_wifi_find() {
    let mut dev = 0;
    while dev < 32 {
        let reg2 = _ke_pci_read(0, dev, 0, 2);
        let class_code = reg2 / 16777216;
        let subclass = (reg2 / 65536) % 256;
        if class_code == 2 {
            if subclass == 128 { return dev; }
        }
        dev = dev + 1;
    }
    return 255;
}

fn _ke_cmd_wifi() {
    let dev = _ke_wifi_find();
    _ke_putc(87); _ke_putc(73); _ke_putc(70); _ke_putc(73); _ke_putc(58); _ke_putc(32);
    if dev == 255 {
        _ke_putc(110); _ke_putc(111); _ke_putc(116); _ke_putc(32); _ke_putc(102); _ke_putc(111); _ke_putc(117); _ke_putc(110); _ke_putc(100);
        _ke_putc(13); _ke_putc(10);
        return 0;
    }
    _ke_putc(100); _ke_putc(101); _ke_putc(118); _ke_putc(61);
    _ke_put_dec(dev);
    _ke_putc(32);
    _ke_putc(66); _ke_putc(65); _ke_putc(82); _ke_putc(48); _ke_putc(61);
    _ke_put_hex32(_ke_pci_read(0, dev, 0, 4));
    _ke_putc(13); _ke_putc(10);
    return 0;
}

// === Iteration 72: Message Queue IPC ===
//
// Message queues at 0xA05000, 4 queues x 128 bytes.

fn _ke_msg_send(chan, buf_addr, buf_len) {
    if chan < 0 { return 0 - 1; }
    if chan >= 4 { return 0 - 1; }
    let mt = 10506240;
    let off = chan * 128;
    let mut count = _ke_mem_r32(mt + off + 12);
    let mut wp = _ke_mem_r32(mt + off + 8);
    let mut i = 0;
    while i < buf_len {
        if count >= 112 { i = buf_len; }
        else {
            mem_write_u8(mt + off + 16 + wp, mem_read_u8(buf_addr + i));
            wp = (wp + 1) % 112;
            count = count + 1;
            i = i + 1;
        }
    }
    _ke_mem_w32(mt + off + 8, wp);
    _ke_mem_w32(mt + off + 12, count);
    return i;
}

fn _ke_msg_recv(chan, buf_addr, max_len) {
    if chan < 0 { return 0 - 1; }
    if chan >= 4 { return 0 - 1; }
    let mt = 10506240;
    let off = chan * 128;
    let mut count = _ke_mem_r32(mt + off + 12);
    let mut rp = _ke_mem_r32(mt + off + 4);
    let mut i = 0;
    while i < max_len {
        if count == 0 { i = max_len; }
        else {
            mem_write_u8(buf_addr + i, mem_read_u8(mt + off + 16 + rp));
            rp = (rp + 1) % 112;
            count = count - 1;
            i = i + 1;
        }
    }
    _ke_mem_w32(mt + off + 4, rp);
    _ke_mem_w32(mt + off + 12, count);
    return i;
}

fn _ke_cmd_msg() {
    let mt = 10506240;
    let mut i = 0;
    while i < 512 { mem_write_u8(mt + i, 0); i = i + 1; }
    let sb = 10506752;
    mem_write_u8(sb + 0, 80); mem_write_u8(sb + 1, 73); mem_write_u8(sb + 2, 78); mem_write_u8(sb + 3, 71);
    let n = _ke_msg_send(0, sb, 4);
    let rb = 10506768;
    let m = _ke_msg_recv(0, rb, 4);
    _ke_putc(77); _ke_putc(83); _ke_putc(71); _ke_putc(58); _ke_putc(32);
    let mut j = 0;
    while j < m { _ke_putc(mem_read_u8(rb + j)); j = j + 1; }
    _ke_putc(32); _ke_put_dec(n); _ke_putc(47); _ke_put_dec(m);
    _ke_putc(13); _ke_putc(10);
    return 0;
}

// === Iteration 73: Environment Variables + echo ===
//
// Environment variable table at 0xA06000, 16 entries x 128 bytes.
// Each entry: flags(4) + key_len(4) + val_len(4) + key(52) + val(64)
// Memory: 0xA06000-0xA06FFF (4096 bytes)
// Commands: env, setenv, echo

fn _ke_env_init() {
    let et = 10510336;
    let mut i = 0;
    while i < 2048 {
        mem_write_u8(et + i, 0);
        i = i + 1;
    }
    // PATH=/bin
    _ke_mem_w32(et + 0, 1);
    _ke_mem_w32(et + 4, 4);
    _ke_mem_w32(et + 8, 4);
    mem_write_u8(et + 12, 80); mem_write_u8(et + 13, 65);
    mem_write_u8(et + 14, 84); mem_write_u8(et + 15, 72);
    mem_write_u8(et + 64, 47); mem_write_u8(et + 65, 98);
    mem_write_u8(et + 66, 105); mem_write_u8(et + 67, 110);
    // HOME=/root
    let e1 = et + 128;
    _ke_mem_w32(e1 + 0, 1);
    _ke_mem_w32(e1 + 4, 4);
    _ke_mem_w32(e1 + 8, 5);
    mem_write_u8(e1 + 12, 72); mem_write_u8(e1 + 13, 79);
    mem_write_u8(e1 + 14, 77); mem_write_u8(e1 + 15, 69);
    mem_write_u8(e1 + 64, 47); mem_write_u8(e1 + 65, 114);
    mem_write_u8(e1 + 66, 111); mem_write_u8(e1 + 67, 111);
    mem_write_u8(e1 + 68, 116);
    // USER=root
    let e2 = et + 256;
    _ke_mem_w32(e2 + 0, 1);
    _ke_mem_w32(e2 + 4, 4);
    _ke_mem_w32(e2 + 8, 4);
    mem_write_u8(e2 + 12, 85); mem_write_u8(e2 + 13, 83);
    mem_write_u8(e2 + 14, 69); mem_write_u8(e2 + 15, 82);
    mem_write_u8(e2 + 64, 114); mem_write_u8(e2 + 65, 111);
    mem_write_u8(e2 + 66, 111); mem_write_u8(e2 + 67, 116);
    // SHELL=hicos
    let e3 = et + 384;
    _ke_mem_w32(e3 + 0, 1);
    _ke_mem_w32(e3 + 4, 5);
    _ke_mem_w32(e3 + 8, 5);
    mem_write_u8(e3 + 12, 83); mem_write_u8(e3 + 13, 72);
    mem_write_u8(e3 + 14, 69); mem_write_u8(e3 + 15, 76);
    mem_write_u8(e3 + 16, 76);
    mem_write_u8(e3 + 64, 104); mem_write_u8(e3 + 65, 105);
    mem_write_u8(e3 + 66, 99); mem_write_u8(e3 + 67, 111);
    mem_write_u8(e3 + 68, 115);
    return 0;
}

fn _ke_env_find(key_addr, key_len) {
    let et = 10510336;
    let mut slot = 0;
    while slot < 16 {
        let base = et + slot * 128;
        let flags = _ke_mem_r32(base);
        if flags == 1 {
            let kl = _ke_mem_r32(base + 4);
            if kl == key_len {
                let mut ok = 1;
                let mut j = 0;
                while j < key_len {
                    if mem_read_u8(base + 12 + j) != mem_read_u8(key_addr + j) {
                        ok = 0;
                        j = key_len;
                    }
                    j = j + 1;
                }
                if ok == 1 { return slot; }
            }
        }
        slot = slot + 1;
    }
    return 0 - 1;
}

fn _ke_env_get(key_addr, key_len, dst_addr) {
    let slot = _ke_env_find(key_addr, key_len);
    if slot < 0 { return 0; }
    let et = 10510336;
    let base = et + slot * 128;
    let vl = _ke_mem_r32(base + 8);
    let mut i = 0;
    while i < vl {
        mem_write_u8(dst_addr + i, mem_read_u8(base + 64 + i));
        i = i + 1;
    }
    return vl;
}

fn _ke_env_set(key_addr, key_len, val_addr, val_len) {
    if key_len > 50 { return 0 - 1; }
    if val_len > 62 { return 0 - 1; }
    let et = 10510336;
    let existing = _ke_env_find(key_addr, key_len);
    if existing >= 0 {
        let base = et + existing * 128;
        _ke_mem_w32(base + 8, val_len);
        let mut i = 0;
        while i < val_len {
            mem_write_u8(base + 64 + i, mem_read_u8(val_addr + i));
            i = i + 1;
        }
        while i < 64 { mem_write_u8(base + 64 + i, 0); i = i + 1; }
        return 0;
    }
    let mut slot = 0;
    while slot < 16 {
        let base = et + slot * 128;
        let flags = _ke_mem_r32(base);
        if flags == 0 {
            _ke_mem_w32(base + 0, 1);
            _ke_mem_w32(base + 4, key_len);
            _ke_mem_w32(base + 8, val_len);
            let mut ki = 0;
            while ki < key_len { mem_write_u8(base + 12 + ki, mem_read_u8(key_addr + ki)); ki = ki + 1; }
            while ki < 52 { mem_write_u8(base + 12 + ki, 0); ki = ki + 1; }
            let mut vi = 0;
            while vi < val_len { mem_write_u8(base + 64 + vi, mem_read_u8(val_addr + vi)); vi = vi + 1; }
            while vi < 64 { mem_write_u8(base + 64 + vi, 0); vi = vi + 1; }
            return 0;
        }
        slot = slot + 1;
    }
    return 0 - 1;
}

fn _ke_cmd_env() {
    let et = 10510336;
    _ke_putc(69); _ke_putc(78); _ke_putc(86); _ke_putc(58);
    _ke_putc(13); _ke_putc(10);
    let mut slot = 0;
    let mut count = 0;
    while slot < 16 {
        let base = et + slot * 128;
        let flags = _ke_mem_r32(base);
        if flags == 1 {
            let kl = _ke_mem_r32(base + 4);
            let vl = _ke_mem_r32(base + 8);
            _ke_putc(32); _ke_putc(32);
            let mut ki = 0;
            while ki < kl { _ke_putc(mem_read_u8(base + 12 + ki)); ki = ki + 1; }
            _ke_putc(61);
            let mut vi = 0;
            while vi < vl { _ke_putc(mem_read_u8(base + 64 + vi)); vi = vi + 1; }
            _ke_putc(13); _ke_putc(10);
            count = count + 1;
        }
        slot = slot + 1;
    }
    _ke_put_dec(count);
    _ke_putc(32); _ke_putc(118); _ke_putc(97); _ke_putc(114); _ke_putc(115);
    _ke_putc(13); _ke_putc(10);
    return 0;
}

fn _ke_cmd_setenv(buf_addr, buf_len) {
    let arg_start = 7;
    if buf_len <= arg_start {
        _ke_putc(85); _ke_putc(115); _ke_putc(97); _ke_putc(103); _ke_putc(101);
        _ke_putc(58); _ke_putc(32); _ke_putc(115); _ke_putc(101); _ke_putc(116);
        _ke_putc(101); _ke_putc(110); _ke_putc(118); _ke_putc(32);
        _ke_putc(75); _ke_putc(69); _ke_putc(89); _ke_putc(61); _ke_putc(86);
        _ke_putc(65); _ke_putc(76); _ke_putc(85); _ke_putc(69);
        _ke_putc(13); _ke_putc(10);
        return 0;
    }
    let mut eq_pos = 0 - 1;
    let mut si = arg_start;
    while si < buf_len {
        if mem_read_u8(buf_addr + si) == 61 {
            eq_pos = si;
            si = buf_len;
        }
        si = si + 1;
    }
    if eq_pos < 0 {
        _ke_putc(63); _ke_putc(13); _ke_putc(10);
        return 0;
    }
    let key_addr = buf_addr + arg_start;
    let key_len = eq_pos - arg_start;
    let val_addr = buf_addr + eq_pos + 1;
    let val_len = buf_len - eq_pos - 1;
    _ke_env_set(key_addr, key_len, val_addr, val_len);
    _ke_putc(83); _ke_putc(69); _ke_putc(84); _ke_putc(58); _ke_putc(32);
    let mut pi = 0;
    while pi < key_len { _ke_putc(mem_read_u8(key_addr + pi)); pi = pi + 1; }
    _ke_putc(61);
    pi = 0;
    while pi < val_len { _ke_putc(mem_read_u8(val_addr + pi)); pi = pi + 1; }
    _ke_putc(13); _ke_putc(10);
    return 0;
}

fn _ke_cmd_echo(buf_addr, buf_len) {
    if buf_len <= 5 {
        _ke_putc(13); _ke_putc(10);
        return 0;
    }
    let arg_start = 5;
    let tmp_buf = 10512384;
    let mut ei = arg_start;
    while ei < buf_len {
        let ch = mem_read_u8(buf_addr + ei);
        if ch == 36 {
            let mut name_start = ei + 1;
            let mut name_end = name_start;
            let mut scanning = 1;
            while scanning == 1 {
                if name_end >= buf_len { scanning = 0; }
                else {
                    let nc = mem_read_u8(buf_addr + name_end);
                    let mut is_id = 0;
                    if nc >= 65 { if nc <= 90 { is_id = 1; } }
                    if nc >= 97 { if nc <= 122 { is_id = 1; } }
                    if nc >= 48 { if nc <= 57 { is_id = 1; } }
                    if nc == 95 { is_id = 1; }
                    if is_id == 0 { scanning = 0; }
                    else { name_end = name_end + 1; }
                }
            }
            let name_len = name_end - name_start;
            if name_len > 0 {
                let vl = _ke_env_get(buf_addr + name_start, name_len, tmp_buf);
                let mut vi = 0;
                while vi < vl { _ke_putc(mem_read_u8(tmp_buf + vi)); vi = vi + 1; }
                ei = name_end;
            } else {
                _ke_putc(36);
                ei = ei + 1;
            }
        } else {
            _ke_putc(ch);
            ei = ei + 1;
        }
    }
    _ke_putc(13); _ke_putc(10);
    return 0;
}

// === Iteration 74: POSIX Signal Handling ===
//
// Per-task signal state stored in task table extension.
// Task table at 0x320000, each task 64 bytes:
//   +48: pending_signals (u64, bitmask)
//   +56: blocked_signals (u64, bitmask)
// Signal numbers: 1=SIGHUP 2=SIGINT 9=SIGKILL 10=SIGUSR1 15=SIGTERM
//   17=SIGCHLD 18=SIGCONT 19=SIGSTOP
// Signal actions:
//   SIGKILL (9): immediately kill task (cannot block)
//   SIGTERM (15): default kill task
//   SIGSTOP (19): block task
//   SIGCONT (18): unblock task
//   Others: set pending bit (informational)
// Memory: uses existing task table, no new allocation
// Commands: kill <pid> [sig]

fn _ke_sig_bit(signum) {
    let mut bit = 1;
    let mut s = 0;
    while s < signum { bit = bit * 2; s = s + 1; }
    return bit;
}

fn _ke_signal_send(target_tid, signum) {
    if signum < 1 { return 0; }
    if signum > 31 { return 0; }
    let tbl = 3276800;  // 0x320000
    let count = mem_read_u64(3277832);  // task count
    if target_tid >= count { return 0; }
    let base = tbl + target_tid * 64;
    let state = mem_read_u64(base);
    if state == 0 { return 0; }  // free slot

    // SIGKILL (9): immediately kill
    if signum == 9 {
        mem_write_u64(base, 0);  // state = free (dead)
        // "SIGKILL "
        _ke_putc(83); _ke_putc(73); _ke_putc(71); _ke_putc(75);
        _ke_putc(73); _ke_putc(76); _ke_putc(76); _ke_putc(32);
        _ke_put_dec(target_tid);
        _ke_putc(13); _ke_putc(10);
        return 1;
    }

    // SIGSTOP (19): block task
    if signum == 19 {
        if state == 2 { return 0; }  // don't stop running task (self)
        mem_write_u64(base, 3);  // state = blocked
        _ke_putc(83); _ke_putc(84); _ke_putc(79); _ke_putc(80); _ke_putc(32);
        _ke_put_dec(target_tid);
        _ke_putc(13); _ke_putc(10);
        return 1;
    }

    // SIGCONT (18): unblock task
    if signum == 18 {
        if state == 3 {
            mem_write_u64(base, 1);  // state = ready
        }
        _ke_putc(67); _ke_putc(79); _ke_putc(78); _ke_putc(84); _ke_putc(32);
        _ke_put_dec(target_tid);
        _ke_putc(13); _ke_putc(10);
        return 1;
    }

    // SIGTERM (15): default kill
    if signum == 15 {
        let blocked = mem_read_u64(base + 56);
        let bit = _ke_sig_bit(15);
        if (blocked / bit) % 2 == 1 {
            // Blocked: set pending
            let pending = mem_read_u64(base + 48);
            if (pending / bit) % 2 == 0 {
                mem_write_u64(base + 48, pending + bit);
            }
            _ke_putc(84); _ke_putc(69); _ke_putc(82); _ke_putc(77);
            _ke_putc(32); _ke_putc(112); _ke_putc(101); _ke_putc(110);
            _ke_putc(100); _ke_putc(13); _ke_putc(10);
            return 1;
        }
        mem_write_u64(base, 0);  // state = free (dead)
        _ke_putc(83); _ke_putc(73); _ke_putc(71); _ke_putc(84);
        _ke_putc(69); _ke_putc(82); _ke_putc(77); _ke_putc(32);
        _ke_put_dec(target_tid);
        _ke_putc(13); _ke_putc(10);
        return 1;
    }

    // Other signals: set pending bit
    let bit = _ke_sig_bit(signum);
    let blocked = mem_read_u64(base + 56);
    if (blocked / bit) % 2 == 1 {
        // Blocked — just set pending
        let pending = mem_read_u64(base + 48);
        if (pending / bit) % 2 == 0 {
            mem_write_u64(base + 48, pending + bit);
        }
        return 1;
    }
    // Set pending (will be checked on task switch)
    let pending = mem_read_u64(base + 48);
    if (pending / bit) % 2 == 0 {
        mem_write_u64(base + 48, pending + bit);
    }
    return 1;
}

fn _ke_signal_pending(tid) {
    let tbl = 3276800;
    let base = tbl + tid * 64;
    let pending = mem_read_u64(base + 48);
    let blocked = mem_read_u64(base + 56);
    // deliverable = pending & ~blocked (signals pending and not blocked)
    // Using integer math: for each bit, deliverable if pending=1 and blocked=0
    // Return pending mask (caller can check individual bits)
    return pending;
}

fn _ke_signal_block(tid, signum) {
    if signum == 9 { return 0; }  // cannot block SIGKILL
    if signum == 19 { return 0; } // cannot block SIGSTOP
    let tbl = 3276800;
    let base = tbl + tid * 64;
    let mask = mem_read_u64(base + 56);
    let bit = _ke_sig_bit(signum);
    if (mask / bit) % 2 == 0 {
        mem_write_u64(base + 56, mask + bit);
    }
    return 1;
}

fn _ke_signal_unblock(tid, signum) {
    let tbl = 3276800;
    let base = tbl + tid * 64;
    let mask = mem_read_u64(base + 56);
    let bit = _ke_sig_bit(signum);
    if (mask / bit) % 2 == 1 {
        mem_write_u64(base + 56, mask - bit);
    }
    return 1;
}

// Check and deliver pending signals for a task (called on task switch)
fn _ke_signal_deliver(tid) {
    let tbl = 3276800;
    let base = tbl + tid * 64;
    let pending = mem_read_u64(base + 48);
    let blocked = mem_read_u64(base + 56);
    if pending == 0 { return 0; }
    let mut sig = 1;
    while sig <= 31 {
        let bit = _ke_sig_bit(sig);
        let is_pending = (pending / bit) % 2;
        let is_blocked = (blocked / bit) % 2;
        if is_pending == 1 {
            if is_blocked == 0 {
                // Clear pending bit
                mem_write_u64(base + 48, pending - bit);
                // SIGKILL/SIGTERM: kill task
                if sig == 9 { mem_write_u64(base, 0); return sig; }
                if sig == 15 { mem_write_u64(base, 0); return sig; }
                // SIGSTOP: block task
                if sig == 19 { mem_write_u64(base, 3); return sig; }
                // SIGCONT: unblock
                if sig == 18 {
                    let st = mem_read_u64(base);
                    if st == 3 { mem_write_u64(base, 1); }
                    return sig;
                }
                // Others: delivered (informational)
                return sig;
            }
        }
        sig = sig + 1;
    }
    return 0;
}

fn _ke_sig_name(signum) {
    // Print signal name: "SIG" + name
    _ke_putc(83); _ke_putc(73); _ke_putc(71);
    if signum == 1 { _ke_putc(72); _ke_putc(85); _ke_putc(80); return 0; }
    if signum == 2 { _ke_putc(73); _ke_putc(78); _ke_putc(84); return 0; }
    if signum == 9 { _ke_putc(75); _ke_putc(73); _ke_putc(76); _ke_putc(76); return 0; }
    if signum == 10 { _ke_putc(85); _ke_putc(83); _ke_putc(82); _ke_putc(49); return 0; }
    if signum == 15 { _ke_putc(84); _ke_putc(69); _ke_putc(82); _ke_putc(77); return 0; }
    if signum == 17 { _ke_putc(67); _ke_putc(72); _ke_putc(76); _ke_putc(68); return 0; }
    if signum == 18 { _ke_putc(67); _ke_putc(79); _ke_putc(78); _ke_putc(84); return 0; }
    if signum == 19 { _ke_putc(83); _ke_putc(84); _ke_putc(79); _ke_putc(80); return 0; }
    _ke_put_dec(signum);
    return 0;
}

// Command: kill <pid> [signal]
// Default signal = 15 (SIGTERM)
// Usage: "kill 2" → send SIGTERM to task 2
//        "kill 2 9" → send SIGKILL to task 2
fn _ke_cmd_kill(buf_addr, buf_len) {
    if buf_len <= 5 {
        // "Usage: kill <pid> [sig]\r\n"
        _ke_putc(85); _ke_putc(115); _ke_putc(97); _ke_putc(103);
        _ke_putc(101); _ke_putc(58); _ke_putc(32);
        _ke_putc(107); _ke_putc(105); _ke_putc(108); _ke_putc(108);
        _ke_putc(32); _ke_putc(60); _ke_putc(112); _ke_putc(105);
        _ke_putc(100); _ke_putc(62); _ke_putc(32); _ke_putc(91);
        _ke_putc(115); _ke_putc(105); _ke_putc(103); _ke_putc(93);
        _ke_putc(13); _ke_putc(10);
        return 0;
    }
    // Parse PID (digits after "kill ")
    let mut pos = 5;
    let mut pid = 0;
    while pos < buf_len {
        let ch = mem_read_u8(buf_addr + pos);
        if ch >= 48 { if ch <= 57 { pid = pid * 10 + ch - 48; pos = pos + 1; } else { pos = buf_len; } }
        else if ch == 32 { pos = pos + 1; pos = pos; } // skip to signal
        else { pos = buf_len; }
        // break on space to parse signal
        if pos < buf_len {
            let nch = mem_read_u8(buf_addr + pos);
            if nch == 32 { pos = pos + 1; pos = pos; }
        }
    }
    // Re-parse more carefully: "kill PID" or "kill PID SIG"
    let mut p = 5;
    pid = 0;
    while p < buf_len {
        let ch = mem_read_u8(buf_addr + p);
        if ch >= 48 { if ch <= 57 { pid = pid * 10 + ch - 48; } else { p = buf_len; } }
        else { p = buf_len; }
        p = p + 1;
        // Check if next is space
        if p < buf_len {
            if mem_read_u8(buf_addr + p) == 32 { p = p + 1; p = buf_len + 1; }
        }
    }
    // Parse optional signal number
    let mut sig = 15;  // default SIGTERM
    // Find space after pid
    let mut sp = 5;
    while sp < buf_len {
        if mem_read_u8(buf_addr + sp) == 32 { sp = sp + 1; sp = buf_len + 100; }
        else { sp = sp + 1; }
    }
    // Simple re-parse: first number = pid, second number after space = sig
    pid = 0;
    sig = 15;
    let mut phase = 0;  // 0=parsing pid, 1=found space, 2=parsing sig
    let mut pi = 5;
    while pi < buf_len {
        let ch = mem_read_u8(buf_addr + pi);
        if phase == 0 {
            if ch >= 48 { if ch <= 57 { pid = pid * 10 + ch - 48; } }
            if ch == 32 { phase = 1; }
        } else if phase == 1 {
            if ch >= 48 { if ch <= 57 { sig = 0; phase = 2; sig = ch - 48; } }
        } else if phase == 2 {
            if ch >= 48 { if ch <= 57 { sig = sig * 10 + ch - 48; } }
        }
        pi = pi + 1;
    }

    // Send signal
    // "kill " + pid + " -> "
    _ke_putc(107); _ke_putc(105); _ke_putc(108); _ke_putc(108);
    _ke_putc(32);
    _ke_put_dec(pid);
    _ke_putc(32); _ke_putc(45); _ke_putc(62); _ke_putc(32);
    _ke_sig_name(sig);
    _ke_putc(13); _ke_putc(10);
    let result = _ke_signal_send(pid, sig);
    if result == 0 {
        // "no such task\r\n"
        _ke_putc(110); _ke_putc(111); _ke_putc(32); _ke_putc(115);
        _ke_putc(117); _ke_putc(99); _ke_putc(104); _ke_putc(32);
        _ke_putc(116); _ke_putc(97); _ke_putc(115); _ke_putc(107);
        _ke_putc(13); _ke_putc(10);
    }
    return 0;
}

