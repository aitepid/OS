    _ke_mem_w32(sb + 200, 527752680); _ke_mem_w32(sb + 204, 2324413771);
    _ke_mem_w32(sb + 208, 1723154032); _ke_mem_w32(sb + 212, 251003720);
    _ke_mem_w32(sb + 216, 3109500257); _ke_mem_w32(sb + 220, 2652750214);
    _ke_mem_w32(sb + 224, 295237857); _ke_mem_w32(sb + 228, 2492389737);
    _ke_mem_w32(sb + 232, 3917946523); _ke_mem_w32(sb + 236, 3743962574);
    _ke_mem_w32(sb + 240, 227123596); _ke_mem_w32(sb + 244, 1749214911);
    _ke_mem_w32(sb + 248, 254646593); _ke_mem_w32(sb + 252, 381375664);
    // Inverse S-Box at 0x950100
    let isb = 9765120; // 0x950100
    _ke_mem_w32(isb + 0, 3580496210); _ke_mem_w32(isb + 4, 950351408);
    _ke_mem_w32(isb + 8, 2661499071); _ke_mem_w32(isb + 12, 4225233793);
    _ke_mem_w32(isb + 16, 2184831868); _ke_mem_w32(isb + 20, 2270068507);
    _ke_mem_w32(isb + 24, 1155567337); _ke_mem_w32(isb + 28, 3421700364);
    _ke_mem_w32(isb + 32, 1212426457); _ke_mem_w32(isb + 36, 2189819191);
