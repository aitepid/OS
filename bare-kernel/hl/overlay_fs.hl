// overlay_fs.hl -- Overlay Filesystem (Union Mount)
//
// Provides a 2-layer union view like Linux overlayfs / Docker overlay2:
//   lower layer  -- read-only base (e.g. container image rootfs)
//   upper layer  -- read-write scratch (per-container writable layer)
//   merged view  -- upper takes precedence; fallback to lower on read
//
// Design:
//   Up to OVERLAY_MAX (8) mount instances.
//   Each instance: lower_path, upper_path, merged_path (VFS mount point).
//   File lookup: check upper first, then lower (Copy-on-Write on write).
//   Deletes: whiteout file ".wh.<name>" in upper hides lower entry.
//   Directory listing: merge upper + lower, removing whiteouts.
//
// VFS integration: fs_type = 5, device_id = overlay instance index.
//   vfs_mount_overlay(merged, lower, upper) registers with VFS.
//   vfs_readdir / vfs_stat / vfs_open then dispatch here.
//
// Public API:
//   overlay_init / overlay_create / overlay_destroy
//   overlay_mount / overlay_umount
//   overlay_readdir / overlay_stat
//   overlay_resolve (path → real_layer_path)
//   overlay_copy_up (copy lower file into upper before write)

let OVERLAY_MAX       = 8;
let OVERLAY_WH_PREFIX = ".wh.";    // whiteout prefix

// Overlay instance table
let mut ov_active   = [];
let mut ov_lower    = [];   // read-only base path
let mut ov_upper    = [];   // read-write scratch path
let mut ov_merged   = [];   // VFS mount point
let mut ov_count    = 0;

fn overlay_init() {
    ov_active = [];
    ov_lower  = [];
    ov_upper  = [];
    ov_merged = [];
    ov_count  = 0;
    let mut i = 0;
    while i < OVERLAY_MAX {
        push(ov_active, 0);
        push(ov_lower,  "");
        push(ov_upper,  "");
        push(ov_merged, "");
        i = i + 1;
    }
    print("overlay_fs: init — max " + to_string(OVERLAY_MAX) + " mount instances");
    return 0;
}

fn overlay_alloc_slot() {
    let mut i = 0;
    while i < OVERLAY_MAX {
        if ov_active[i] == 0 { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

// Create an overlay instance; returns instance_id or -1
fn overlay_create(lower_path, upper_path, merged_path) {
    let mut id = overlay_alloc_slot();
    if id < 0 {
        print("overlay_fs: table full");
        return 0 - 1;
    }
    // Ensure upper directory exists
    vfs_mkdir(upper_path);

    set_at(ov_active, id, 1);
    set_at(ov_lower,  id, lower_path);
    set_at(ov_upper,  id, upper_path);
    set_at(ov_merged, id, merged_path);
    ov_count = ov_count + 1;
    print("overlay_fs: created id=" + to_string(id)
        + " lower=" + lower_path
        + " upper=" + upper_path
        + " merged=" + merged_path);
    return id;
}

fn overlay_destroy(id) {
    if id < 0 { return 0 - 1; }
    if id >= OVERLAY_MAX { return 0 - 1; }
    if ov_active[id] == 0 { return 0 - 1; }
    set_at(ov_active, id, 0);
    ov_count = ov_count - 1;
    print("overlay_fs: destroyed id=" + to_string(id));
    return 0;
}

// Mount overlay into VFS as fs_type=5, device_id=instance_id
fn overlay_mount(lower_path, upper_path, merged_path) {
    let mut id = overlay_create(lower_path, upper_path, merged_path);
    if id < 0 { return 0 - 1; }
    vfs_mount(merged_path, 5, id);
    print("overlay_fs: mounted " + merged_path + " (id=" + to_string(id) + ")");
    return id;
}

fn overlay_umount(id) {
    if id < 0 { return 0 - 1; }
    if id >= OVERLAY_MAX { return 0 - 1; }
    let mut mpath = ov_merged[id];
    overlay_destroy(id);
    // VFS mount entry remains (no unmount API yet), but overlay now inactive
    print("overlay_fs: umounted " + mpath);
    return 0;
}

// Find which instance owns a given merged path prefix
fn overlay_find_by_merged(path) {
    let mut i = 0;
    while i < OVERLAY_MAX {
        if ov_active[i] == 1 {
            if str_starts_with(path, ov_merged[i]) { return i; }
        }
        i = i + 1;
    }
    return 0 - 1;
}

// Strip the merged prefix from path, giving a relative sub-path
fn overlay_rel_path(id, path) {
    let mut mlen = len(ov_merged[id]);
    if len(path) <= mlen { return "/"; }
    let mut rel = str_sub(path, mlen, len(path));
    if len(rel) == 0 { return "/"; }
    return rel;
}

// Build upper/lower absolute paths for a relative sub-path
fn overlay_upper_path(id, rel) {
    if rel == "/" { return ov_upper[id]; }
    return ov_upper[id] + rel;
}

fn overlay_lower_path(id, rel) {
    if rel == "/" { return ov_lower[id]; }
    return ov_lower[id] + rel;
}

// Check whether a whiteout entry exists in upper for rel path
fn overlay_is_whiteout(id, rel) {
    let mut parts = _vfs_split_path(rel);
    if len(parts) == 0 { return 0; }
    let mut fname = parts[len(parts) - 1];
    let mut wh_name = OVERLAY_WH_PREFIX + fname;
    // Build parent path in upper
    let mut parent = ov_upper[id];
    let mut j = 0;
    while j < len(parts) - 1 {
        parent = parent + "/" + parts[j];
        j = j + 1;
    }
    let mut wh_path = parent + "/" + wh_name;
    let mut st = vfs_stat(wh_path);
    if st[0] > 0 { return 1; }
    if st[1] > 0 { return 1; }
    return 0;
}

// Resolve a merged path to its real path: upper takes precedence
// Returns [real_path, layer] where layer: 0=upper 1=lower -1=not found
fn overlay_resolve(merged_path) {
    let mut id = overlay_find_by_merged(merged_path);
    if id < 0 { return [merged_path, 0 - 1]; }

    let mut rel = overlay_rel_path(id, merged_path);

    // Whiteout check: if upper has .wh.<name>, file is deleted
    if overlay_is_whiteout(id, rel) == 1 { return ["", 0 - 1]; }

    // Check upper layer first
    let mut upath = overlay_upper_path(id, rel);
    let mut ust = vfs_stat(upath);
    if ust[0] > 0 { return [upath, 0]; }
    if ust[1] > 0 { return [upath, 0]; }

    // Fall back to lower layer
    let mut lpath = overlay_lower_path(id, rel);
    let mut lst = vfs_stat(lpath);
    if lst[0] > 0 { return [lpath, 1]; }
    if lst[1] > 0 { return [lpath, 1]; }

    return ["", 0 - 1];
}

// Copy-on-Write: copy a file from lower to upper before writing
fn overlay_copy_up(id, rel) {
    let mut lpath = overlay_lower_path(id, rel);
    let mut upath = overlay_upper_path(id, rel);
    // Ensure parent directory exists in upper
    let mut parts = _vfs_split_path(rel);
    let mut parent = ov_upper[id];
    let mut i = 0;
    while i < len(parts) - 1 {
        parent = parent + "/" + parts[i];
        vfs_mkdir(parent);
        i = i + 1;
    }
    let mut bytes = vfs_copy(lpath, upath);
    print("overlay_fs: copy-up " + lpath + " -> " + upath + " (" + to_string(bytes) + " bytes)");
    return bytes;
}

// Merged directory listing: upper + lower, minus whiteouts
fn overlay_readdir(id, rel) {
    let mut upath = overlay_upper_path(id, rel);
    let mut lpath = overlay_lower_path(id, rel);

    let mut names = [];
    let mut seen  = [];   // deduplicate

    // Upper entries (may include whiteout files)
    let mut u_entries = vfs_readdir(upath);
    let mut i = 0;
    while i < len(u_entries) {
        let mut name = u_entries[i];
        // Skip whiteout files from listing
        if str_starts_with(name, OVERLAY_WH_PREFIX) == 0 {
            push(names, name);
            push(seen, name);
        }
        i = i + 1;
    }

    // Lower entries, filtered by whiteouts in upper
    let mut l_entries = vfs_readdir(lpath);
    let mut j = 0;
    while j < len(l_entries) {
        let mut name = l_entries[j];
        // Check not already in seen
        let mut dup = 0;
        let mut k = 0;
        while k < len(seen) {
            if seen[k] == name { dup = 1; }
            k = k + 1;
        }
        if dup == 0 {
            // Check no whiteout
            let mut wh_path = upath + "/" + OVERLAY_WH_PREFIX + name;
            let mut wst = vfs_stat(wh_path);
            let mut is_wh = 0;
            if wst[0] > 0 { is_wh = 1; }
            if wst[1] > 0 { is_wh = 1; }
            if is_wh == 0 {
                push(names, name);
                push(seen, name);
            }
        }
        j = j + 1;
    }
    return names;
}

// Create a whiteout entry in upper to hide a lower file (delete)
fn overlay_whiteout(id, rel) {
    let mut parts = _vfs_split_path(rel);
    if len(parts) == 0 { return 0 - 1; }
    let mut fname = parts[len(parts) - 1];
    let mut parent = ov_upper[id];
    let mut i = 0;
    while i < len(parts) - 1 {
        parent = parent + "/" + parts[i];
        vfs_mkdir(parent);
        i = i + 1;
    }
    let mut wh_path = parent + "/" + OVERLAY_WH_PREFIX + fname;
    // Create empty whiteout file
    let mut fd = vfs_open(wh_path, O_CREAT + O_WRONLY + O_TRUNC);
    if fd >= 0 { vfs_close(fd); }
    return 0;
}

// Status string
fn overlay_status(id) {
    if id < 0 { return "invalid"; }
    if id >= OVERLAY_MAX { return "invalid"; }
    if ov_active[id] == 0 { return "overlay[" + to_string(id) + "] inactive"; }
    return "overlay[" + to_string(id) + "]"
        + " merged=" + ov_merged[id]
        + " lower=" + ov_lower[id]
        + " upper=" + ov_upper[id];
}

fn overlay_list() {
    let mut out = "Overlay mounts (" + to_string(ov_count) + "/" + to_string(OVERLAY_MAX) + "):\n";
    let mut i = 0;
    while i < OVERLAY_MAX {
        if ov_active[i] == 1 {
            out = out + "  " + overlay_status(i) + "\n";
        }
        i = i + 1;
    }
    return out;
}

print("overlay_fs.hl loaded");
print("Overlay FS: " + to_string(OVERLAY_MAX) + " instances, lower/upper/merged, CoW copy-up, whiteout delete");
