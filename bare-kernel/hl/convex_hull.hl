// convex_hull.hl -- Convex Hull (Andrew's Monotone Chain, 1979)
// O(n log n) via insertion sort + single-pass lower/upper hull build.
// CH_MAX_N=64 input points; hull stack up to 2n entries.
//
// Runtime buffer: 0x1540000 (4 KB)

let CH_MAX_N = 64;

// Input points (sorted in-place during ch_build)
let ch_px = array(64, 0);
let ch_py = array(64, 0);
let ch_n  = 0;

// Hull construction stack and final output
// Needs up to 2*CH_MAX_N slots during build
let ch_hull_x = array(128, 0);
let ch_hull_y = array(128, 0);
let ch_hull_n = 0;

fn convex_hull_init() {
    let i = 0;
    while i < CH_MAX_N {
        set_at(ch_px, i, 0);
        set_at(ch_py, i, 0);
        i += 1;
    }
    i = 0;
    while i < 128 {
        set_at(ch_hull_x, i, 0);
        set_at(ch_hull_y, i, 0);
        i += 1;
    }
    ch_n      = 0;
    ch_hull_n = 0;
    return 0;
}

fn ch_add_point(x, y) {
    if ch_n >= CH_MAX_N { return 0 - 1; }
    set_at(ch_px, ch_n, x);
    set_at(ch_py, ch_n, y);
    ch_n += 1;
    return ch_n - 1;
}

// Insertion sort ch_px/ch_py by (x asc, then y asc)
fn _ch_sort() {
    let i = 1;
    while i < ch_n {
        let kx = ch_px[i];
        let ky = ch_py[i];
        let j  = i;
        let done = 0;
        while done == 0 {
            if j <= 0 {
                done = 1;
            } else {
                let do_swap = 0;
                if ch_px[j - 1] > kx {
                    do_swap = 1;
                } else {
                    if ch_px[j - 1] == kx {
                        if ch_py[j - 1] > ky { do_swap = 1; }
                    }
                }
                if do_swap == 1 {
                    set_at(ch_px, j, ch_px[j - 1]);
                    set_at(ch_py, j, ch_py[j - 1]);
                    j -= 1;
                } else {
                    done = 1;
                }
            }
        }
        set_at(ch_px, j, kx);
        set_at(ch_py, j, ky);
        i += 1;
    }
    return 0;
}

// Signed cross product of vectors O->A and O->B
// Positive = CCW (left turn), negative = CW (right turn), 0 = collinear
fn _ch_cross3(ox, oy, ax, ay, bx, by) {
    return (ax - ox) * (by - oy) - (ay - oy) * (bx - ox);
}

// Build convex hull; returns number of hull vertices
fn ch_build() {
    if ch_n < 2 {
        ch_hull_n = ch_n;
        let ii = 0;
        while ii < ch_n {
            set_at(ch_hull_x, ii, ch_px[ii]);
            set_at(ch_hull_y, ii, ch_py[ii]);
            ii += 1;
        }
        return ch_hull_n;
    }
    _ch_sort();
    let k = 0;
    // Lower hull (left to right, keep only CCW turns)
    let i = 0;
    while i < ch_n {
        let done = 0;
        while done == 0 {
            if k < 2 {
                done = 1;
            } else {
                let cr = _ch_cross3(ch_hull_x[k - 2], ch_hull_y[k - 2],
                                    ch_hull_x[k - 1], ch_hull_y[k - 1],
                                    ch_px[i], ch_py[i]);
                if cr <= 0 { k -= 1; } else { done = 1; }
            }
        }
        set_at(ch_hull_x, k, ch_px[i]);
        set_at(ch_hull_y, k, ch_py[i]);
        k += 1;
        i += 1;
    }
    // Upper hull (right to left, keep only CCW turns)
    let t = k + 1;
    i = ch_n - 2;
    let done_out = 0;
    while done_out == 0 {
        let done_in = 0;
        while done_in == 0 {
            if k < t {
                done_in = 1;
            } else {
                let cr = _ch_cross3(ch_hull_x[k - 2], ch_hull_y[k - 2],
                                    ch_hull_x[k - 1], ch_hull_y[k - 1],
                                    ch_px[i], ch_py[i]);
                if cr <= 0 { k -= 1; } else { done_in = 1; }
            }
        }
        set_at(ch_hull_x, k, ch_px[i]);
        set_at(ch_hull_y, k, ch_py[i]);
        k += 1;
        if i == 0 { done_out = 1; } else { i -= 1; }
    }
    // Last hull point equals first; remove it
    ch_hull_n = k - 1;
    return ch_hull_n;
}

fn ch_test() {
    convex_hull_init();
    // (0,0),(2,0),(2,2),(0,2),(1,1) — (1,1) is interior
    ch_add_point(0, 0);
    ch_add_point(2, 0);
    ch_add_point(2, 2);
    ch_add_point(0, 2);
    ch_add_point(1, 1);
    let hn = ch_build();
    // Expected: 4 hull vertices: (0,0),(2,0),(2,2),(0,2)
    print("ch_test hull_n=" + to_string(hn) + " hull[0]=(" + to_string(ch_hull_x[0]) + "," + to_string(ch_hull_y[0]) + ")");
    return hn;
}

print("convex_hull.hl loaded");
