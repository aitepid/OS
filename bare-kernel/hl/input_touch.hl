// input_touch.hl -- Touch adapter (HID multi-touch + mouse fallback)
//
// Sprint G3 of HicOS GUI injection (per GUI_DESIGN.md §2A.5).
//
// QEMU on x86 has no real touch device, so on this platform we synthesize
// touch events from the PS/2 mouse: left-button = single-finger touch.
// Real hardware (USB HID multi-touch class) plugs into the same push API
// — `input_touch_push_contact()` — so applications cannot tell the two
// apart, matching the design promise of a uniform pointer surface.

let TOUCH_MAX_CONTACTS = 10;
let mut touch_initialized = 0;
let mut touch_contact_active = [0];
let mut touch_contact_x      = [0];
let mut touch_contact_y      = [0];
let mut touch_present = 0;        // 1 if real touch hardware enumerated

fn input_touch_init() {
    if touch_initialized == 1 { return 0; }
    touch_contact_active = array_new(TOUCH_MAX_CONTACTS, 0);
    touch_contact_x      = array_new(TOUCH_MAX_CONTACTS, 0);
    touch_contact_y      = array_new(TOUCH_MAX_CONTACTS, 0);
    touch_initialized = 1;
    print("input_touch: " + to_string(TOUCH_MAX_CONTACTS) +
          " contacts (hardware=" + to_string(touch_present) + ")");
    return 0;
}

// Push a touch contact update. typ uses the PEV_TYPE_* codes.
fn input_touch_push_contact(pid, typ, x, y, pressure) {
    if touch_initialized == 0 { input_touch_init(); }
    if pid < 0 { return 0; }
    if pid >= TOUCH_MAX_CONTACTS { return 0; }
    if typ == PEV_TYPE_DOWN {
        touch_contact_active[pid] = 1;
        touch_contact_x[pid]      = x;
        touch_contact_y[pid]      = y;
    } else if typ == PEV_TYPE_UP {
        touch_contact_active[pid] = 0;
    } else if typ == PEV_TYPE_MOVE {
        touch_contact_x[pid] = x;
        touch_contact_y[pid] = y;
    }
    let mut press = pressure;
    if press == 0 { press = 256; }    // default 25% pressure for touch
    pev_push(typ, pid, PEV_SRC_TOUCH, x, y, press, 0, 0, PEV_BTN_LEFT, 0);
    return 0;
}

// QEMU fallback: bridge mouse left-click to touch contact id 0. Called by
// the mouse driver after computing a screen-space position.
fn input_touch_mouse_bridge(x, y, left_down, prev_left_down) {
    if touch_present == 1 { return 0; }
    if left_down == 1 {
        if prev_left_down == 0 {
            input_touch_push_contact(0, PEV_TYPE_DOWN, x, y, 256);
        } else {
            input_touch_push_contact(0, PEV_TYPE_MOVE, x, y, 256);
        }
    } else {
        if prev_left_down == 1 {
            input_touch_push_contact(0, PEV_TYPE_UP, x, y, 0);
        }
    }
    return 0;
}

fn input_touch_active_contacts() {
    if touch_initialized == 0 { return 0; }
    let mut n = 0;
    let mut i = 0;
    while i < TOUCH_MAX_CONTACTS {
        if touch_contact_active[i] == 1 { n = n + 1; }
        i = i + 1;
    }
    return n;
}

print("input_touch.hl loaded");
