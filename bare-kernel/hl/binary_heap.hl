// binary_heap.hl -- Binary Min-Heap + Heapsort
// Classic binary heap: O(log n) insert/extract-min, O(n) heapify, O(n log n) sort.
// BH_MAX_SIZE=128; 0-indexed; parent(i)=(i-1)/2, children=2i+1, 2i+2.
//
// Runtime buffer: 0x1500000 (4 KB)

let BH_MAX_SIZE = 128;

let bh_data = array(128, 0);  // min-heap storage
let bh_n    = 0;               // current heap size

fn binary_heap_init() {
    let i = 0;
    while i < BH_MAX_SIZE {
        set_at(bh_data, i, 0);
        i += 1;
    }
    bh_n = 0;
    return 0;
}

// Sift element at index i upward to restore heap property
fn _bh_sift_up(i) {
    let done = 0;
    while done == 0 {
        if i == 0 {
            done = 1;
        } else {
            let p = (i - 1) / 2;
            if bh_data[p] > bh_data[i] {
                let tmp = bh_data[p];
                set_at(bh_data, p, bh_data[i]);
                set_at(bh_data, i, tmp);
                i = p;
            } else {
                done = 1;
            }
        }
    }
    return 0;
}

// Sift element at index i downward (heap size = bh_n)
fn _bh_sift_down(i) {
    let done = 0;
    while done == 0 {
        let l = 2 * i + 1;
        let r = 2 * i + 2;
        let s = i;
        if l < bh_n {
            if bh_data[l] < bh_data[s] { s = l; }
        }
        if r < bh_n {
            if bh_data[r] < bh_data[s] { s = r; }
        }
        if s == i {
            done = 1;
        } else {
            let tmp = bh_data[i];
            set_at(bh_data, i, bh_data[s]);
            set_at(bh_data, s, tmp);
            i = s;
        }
    }
    return 0;
}

fn bh_insert(val) {
    if bh_n >= BH_MAX_SIZE { return 0 - 1; }
    set_at(bh_data, bh_n, val);
    bh_n += 1;
    _bh_sift_up(bh_n - 1);
    return 0;
}

fn bh_peek() {
    if bh_n == 0 { return 0 - 1; }
    return bh_data[0];
}

fn bh_extract_min() {
    if bh_n == 0 { return 0 - 1; }
    let mn = bh_data[0];
    bh_n -= 1;
    if bh_n > 0 {
        set_at(bh_data, 0, bh_data[bh_n]);
        _bh_sift_down(0);
    }
    return mn;
}

// Build heap in-place from arr[0..n-1] (copies into bh_data)
fn bh_heapify(arr, n) {
    bh_n = n;
    let i = 0;
    while i < n {
        set_at(bh_data, i, arr[i]);
        i += 1;
    }
    // Sift down from last internal node up to root
    i = n / 2 - 1;
    let done_outer = 0;
    while done_outer == 0 {
        _bh_sift_down(i);
        if i == 0 {
            done_outer = 1;
        } else {
            i -= 1;
        }
    }
    return 0;
}

// Max-heap sift-down for heapsort (size limit = sz parameter)
fn _hs_sift_down(arr, i, sz) {
    let done = 0;
    while done == 0 {
        let l = 2 * i + 1;
        let r = 2 * i + 2;
        let s = i;
        if l < sz {
            if arr[l] > arr[s] { s = l; }
        }
        if r < sz {
            if arr[r] > arr[s] { s = r; }
        }
        if s == i {
            done = 1;
        } else {
            let tmp = arr[i];
            set_at(arr, i, arr[s]);
            set_at(arr, s, tmp);
            i = s;
        }
    }
    return 0;
}

// Heapsort: sort arr[0..n-1] ascending in-place
fn bh_heapsort(arr, n) {
    // Build max-heap
    let i = n / 2 - 1;
    let done = 0;
    while done == 0 {
        _hs_sift_down(arr, i, n);
        if i == 0 {
            done = 1;
        } else {
            i -= 1;
        }
    }
    // Extract max repeatedly
    i = n - 1;
    while i > 0 {
        let tmp = arr[0];
        set_at(arr, 0, arr[i]);
        set_at(arr, i, tmp);
        _hs_sift_down(arr, 0, i);
        i -= 1;
    }
    return 0;
}

fn bh_test() {
    binary_heap_init();
    // Insert [5,3,8,1,4,7,2,6]
    bh_insert(5); bh_insert(3); bh_insert(8); bh_insert(1);
    bh_insert(4); bh_insert(7); bh_insert(2); bh_insert(6);
    // Extract all: should produce 1,2,3,4,5,6,7,8
    let ok = 1;
    let prev = 0 - 1;
    let i = 0;
    while i < 8 {
        let v = bh_extract_min();
        if v < prev { ok = 0; }
        prev = v;
        i += 1;
    }
    // Heapsort test
    let arr = array(6, 0);
    set_at(arr, 0, 9); set_at(arr, 1, 2); set_at(arr, 2, 7);
    set_at(arr, 3, 4); set_at(arr, 4, 1); set_at(arr, 5, 5);
    bh_heapsort(arr, 6);
    // arr should be [1,2,4,5,7,9]
    if arr[0] != 1 { ok = 0; }
    if arr[5] != 9 { ok = 0; }
    print("bh_test ok=" + to_string(ok) + " heapsort[0]=" + to_string(arr[0]) + " heapsort[5]=" + to_string(arr[5]));
    return ok;
}

print("binary_heap.hl loaded");
