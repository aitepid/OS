// shell_form.hl -- Shell 形态切换器（Sprint G5）
//
// 根据 adaptive_layout 的 FormFactor 选择渲染哪种 Shell：
//   Desktop / Laptop  -> DesktopShell：壁纸 + 顶栏（窄）+ Dock
//   Tablet            -> TabletShell ：壁纸 + 顶栏（高）+ Dock（大）
//   Mobile            -> MobileShell ：壁纸 + 顶栏 + TabBar（无 Dock）
//   Kiosk / Embedded  -> KioskShell  ：仅壁纸 + 单一全屏窗口
//
// 此模块为复合编排器，不引入新窗口/控件，只调用其它 shell_* 的 paint /
// handle_pointer 入口。

let SHELL_DESKTOP = 0;
let SHELL_TABLET  = 1;
let SHELL_MOBILE  = 2;
let SHELL_KIOSK   = 3;

let mut shell_form_current = 0;
let mut shell_form_initialized = 0;

fn shell_form_init() {
    if shell_form_initialized == 1 { return 0; }
    shell_form_resolve();
    shell_form_initialized = 1;
    print("shell_form: form-factor shell switcher ready");
    return 0;
}

fn shell_form_resolve() {
    let mut ff = al_form_factor_get();
    if ff == AL_FF_DESKTOP { shell_form_current = SHELL_DESKTOP; return SHELL_DESKTOP; }
    if ff == AL_FF_LAPTOP  { shell_form_current = SHELL_DESKTOP; return SHELL_DESKTOP; }
    if ff == AL_FF_TABLET  { shell_form_current = SHELL_TABLET;  return SHELL_TABLET; }
    if ff == AL_FF_MOBILE  { shell_form_current = SHELL_MOBILE;  return SHELL_MOBILE; }
    shell_form_current = SHELL_KIOSK;
    return SHELL_KIOSK;
}

fn shell_form_set(form) { shell_form_current = form; return 0; }
fn shell_form_get()     { return shell_form_current; }

fn shell_form_paint(screen_w, screen_h) {
    if shell_form_initialized == 0 { shell_form_init(); }
    // Layer 0：壁纸（所有形态共享）
    shell_wallpaper_paint(screen_w, screen_h);
    // Layer 1：顶栏（Kiosk 之外都画）
    if shell_form_current != SHELL_KIOSK {
        shell_topbar_paint(screen_w);
    }
    // Layer 2：底部条
    if shell_form_current == SHELL_DESKTOP { shell_dock_paint(screen_w, screen_h); }
    if shell_form_current == SHELL_TABLET  { shell_dock_paint(screen_w, screen_h); }
    // Mobile 用 TabBar 替代 Dock —— 由应用自己摆，shell 形态不强制
    // Layer 3：浮层
    shell_startmenu_paint(screen_w, screen_h);
    shell_spotlight_paint(screen_w, screen_h);
    shell_controlcenter_paint(screen_w, screen_h);
    shell_notification_paint_toasts(screen_w);
    shell_notification_center_paint(screen_w, screen_h);
    // Layer 4：锁屏（最顶）
    shell_lockscreen_paint(screen_w, screen_h);
    return 0;
}

fn shell_form_handle_pointer(ev_type, x, y, screen_w, screen_h) {
    if shell_form_initialized == 0 { shell_form_init(); }
    // 锁屏吃掉一切
    if shell_lockscreen_active() == 1 { return 1; }
    // 浮层优先（自上而下）
    if shell_controlcenter_visible() == 1 {
        if shell_controlcenter_handle_pointer(ev_type, x, y, screen_w, screen_h) == 1 { return 1; }
    }
    if shell_startmenu_visible() == 1 {
        if shell_startmenu_handle_pointer(ev_type, x, y, screen_w, screen_h) == 1 { return 1; }
    }
    if shell_topbar_handle_pointer(ev_type, x, y) == 1 { return 1; }
    if shell_form_current == SHELL_DESKTOP {
        if shell_dock_handle_pointer(ev_type, x, y, screen_w, screen_h) == 1 { return 1; }
    }
    if shell_form_current == SHELL_TABLET {
        if shell_dock_handle_pointer(ev_type, x, y, screen_w, screen_h) == 1 { return 1; }
    }
    return 0;
}

print("shell_form.hl loaded");
