// kernel_init.hl -- Kernel Initialization Sequence
//
// Master init function called from kernel_entry after entering long mode.
// Initializes all subsystems in correct dependency order.
//
// This file is the "main()" of the kernel: it calls init functions
// from every module and enters the shell/scheduler loop.

fn kernel_main() {
    // === Phase 0: Early hardware ===
    serial_init();         // serial.hl  -- COM1 for debug output
    syslog_init();         // syslog.hl  -- kernel ring-buffer logger
    serial_print("HicOS 6.0 -- Hilbert-Lang Kernel (295 modules)");
    serial_print("Initializing subsystems...");

    // === Phase 0b: Boot mode detection ===
    let is_uefi = uefi_is_boot();
    if is_uefi == 1 {
        serial_print("  [ok] Boot: UEFI");
    } else {
        serial_print("  [ok] Boot: Legacy BIOS");
    }

    // === Phase 1: Interrupts ===
    // PIC remap + PIT + IDT (inline in kernel_entry native code)
    serial_print("  [ok] IDT + PIC + PIT (100 Hz)");

    // === Phase 2: Memory management ===
    kmalloc_init();        // kmalloc.hl -- kernel heap (1 MB)
    if is_uefi == 1 {
        uefi_parse_memory_map();
        uefi_init_page_alloc();
    } else {
        page_alloc_init();     // page_alloc.hl -- bitmap frame allocator
    }
    hilbert_alloc_init();  // hilbert_alloc.hl
    mmap_init();           // mmap.hl -- demand paging + COW mmap regions
    swap_init();           // swap.hl -- 64 MB swap partition
    serial_print("  [ok] Memory: kmalloc + page_alloc + virt_mem + hilbert + mmap + swap");

    // === Phase 3: Timer ===
    serial_print("  [ok] Timer: PIT 100 Hz + RTC");

    // === Phase 4: Task management ===
    task_init();           // task.hl -- task table (64 slots)
    mlfq_init();           // sched.hl -- MLFQ scheduler (4 queues)
    signal_init_subsystem(); // signal.hl -- per-task signal state
    ns_init();             // namespace.hl -- PID/UTS/IPC/MNT namespace isolation
    serial_print("  [ok] Tasks: 64 slots, CFS+MLFQ scheduler, signals, namespaces");

    // === Phase 5: Filesystem ===
    fs_init();             // ramfs.hl -- RAM filesystem
    vfs_init();            // vfs.hl -- VFS layer
    devfs_init();          // devfs.hl -- /dev device nodes
    procfs_init();         // procfs.hl -- /proc virtual filesystem
    inotify_init_subsystem(); // inotify.hl -- filesystem event notifications
    overlay_init();           // overlay_fs.hl -- union mount (lower/upper/merged CoW)
    serial_print("  [ok] Filesystem: ramfs + FAT16 + ext4 + VFS + devfs + procfs + inotify + overlayfs");

    // === Phase 6: Display ===
    if is_uefi == 1 {
        uefi_init_framebuffer();
    } else {
        mouse_init();          // mouse.hl -- PS/2 mouse via IRQ12
        vesa_auto_init();      // vesa.hl -- VESA framebuffer
    }
    font_sync_fb();            // font.hl -- sync glyph renderer to current framebuffer
    wm_init();                 // wm.hl -- window manager, desktop chrome
    clipboard_init();          // clipboard.hl -- cross-window copy/paste
    serial_print("  [ok] Devices: keyboard + mouse + VESA/GOP + WM + clipboard");

    // === Phase 7: PCI + Storage + Network + Audio ===
    pci_scan();            // pci.hl -- enumerate PCI bus
    ahci_init();           // ahci.hl -- SATA controller
    ata_pio_init();        // ata_pio.hl -- ATA PIO (legacy IDE/SATA)
    usb_init();            // usb.hl -- xHCI controller
    usb_kbd_init();        // usb_kbd.hl -- USB HID keyboard
    ac97_init();           // audio.hl -- AC97 audio codec
    aus_init();            // HicOS_AudioServer.hl -- audio IPC service
    net_init();            // net.hl -- VirtIO-net + ARP
    dhcp_discover();       // dhcp.hl -- IP address
    netfilter_init();      // netfilter.hl -- packet filter (INPUT/OUTPUT/FORWARD)
    // VirtIO-GPU: detect, init, and bridge to VESA framebuffer
    let gpu_pci = gpu_detect();
    if len(gpu_pci) == 3 {
        let gok = gpu_init(gpu_pci[0], gpu_pci[1], gpu_pci[2]);
        if gok == 1 {
            vesa_gpu_mode(gpu_fb_base(), gpu_display_w, gpu_display_h);
            font_sync_fb();    // font: re-sync to new GPU-backed framebuffer
            serial_print("  [ok] VirtIO-GPU: " + to_string(gpu_display_w) + "x" + to_string(gpu_display_h));
        }
    }
    // ext4: mount first AHCI SATA drive as root filesystem via VFS
    let e4ok = vfs_mount_ext4("/", 0);
    if e4ok == 1 {
        serial_print("  [ok] ext4 root filesystem mounted via VFS");
    }
    httpd_init();           // http_server.hl -- HTTP/1.1 server on port 8080
    ws_init();             // websocket.hl -- WebSocket RFC 6455
    telnet_init();         // telnet.hl -- Telnet RFC 854 client/server
    smtp_init();           // smtp.hl -- SMTP email client RFC 5321
    cron_init();           // cron.hl -- periodic task scheduler
    cron_setup_system_jobs(); // register built-in cron jobs
    ntp_init();            // ntp.hl -- SNTP time client RFC 4330
    pop3_init();           // pop3.hl -- POP3 email retrieval RFC 1939
    irc_init();            // irc.hl -- IRC client RFC 1459
    uical_init();          // ui_calendar.hl -- calendar application
    db_init();             // sqlite.hl -- embedded in-memory relational DB
    diff_init();           // diff.hl -- LCS unified diff for VFS files
    uiclock_init();        // ui_clock.hl -- digital clock widget HH:MM:SS
    b64_init();            // base64.hl -- RFC 4648 Base64 encoder/decoder
    ini_init();            // ini.hl -- INI config file parser/writer
    prof_init();           // profiler.hl -- named counters + span timer
    csv_init();            // csv.hl -- RFC 4180 CSV parser/writer
    ping_init();           // ping.hl -- ICMP echo diagnostic
    traceroute_init();     // traceroute.hl -- hop-by-hop path tracer
    sem_init_subsystem();  // semaphore.hl -- POSIX named semaphores
    imap_init();           // imap.hl -- IMAP4rev1 email reader RFC 3501
    mqtt_init();           // mqtt.hl -- MQTT 3.1.1 publish/subscribe client
    lz4_init();            // lz4.hl -- LZ4 block compression codec
    ftp_init();            // ftp.hl -- FTP client RFC 959 PASV mode
    cbor_init();           // cbor.hl -- CBOR compact binary encoding RFC 7049
    syslog_srv_init();     // syslog_srv.hl -- UDP syslog server RFC 3164/5424
    cpio_init();           // cpio.hl -- CPIO archive format parser/extractor
    qp_init();             // quoted_printable.hl -- Quoted-Printable MIME encoding
    uu_init();             // uuencode.hl -- UUencode/UUdecode binary-to-text
    asn1_init();           // asn1.hl -- ASN.1 DER encoding/decoding
    pem_init();            // pem.hl -- PEM format parser (Base64 with headers)
    jwt_init();            // jwt.hl -- JSON Web Token parser/validator
    bmp_init();            // bmp.hl -- BMP bitmap image decoder
    gif_init();            // gif.hl -- GIF image decoder (LZW)
    wav_init();            // wav.hl -- WAV audio format parser
    base32_init();         // base32.hl -- Base32 encoding/decoding
    hex_init();            // hex.hl -- Hexadecimal encoding/decoding utilities
    url_init();            // url.hl -- URL encoding/decoding (percent encoding)
    crc_init();            // crc.hl -- CRC checksums (CRC8/CRC16/CRC32)
    md5_init();            // md5.hl -- MD5 hash algorithm
    sha1_init();           // sha1.hl -- SHA-1 hash algorithm
    hmac_init();           // hmac.hl -- HMAC message authentication
    pbkdf2_init();         // pbkdf2.hl -- PBKDF2 key derivation
    uuid_init();           // uuid.hl -- UUID generation (v4 random)
    rle_init();            // rle.hl -- Run-Length Encoding compression
    rss_init();            // rss.hl -- RSS 2.0/Atom feed parser
    ldap_init();           // ldap.hl -- LDAP v3 directory protocol client
    aes_init();            // aes.hl -- AES-128 encryption (simplified)
    huffman_init();        // huffman.hl -- Huffman coding compression
    radius_init();         // radius.hl -- RADIUS authentication protocol client
    sha256_init();         // sha256.hl -- SHA-256 hash algorithm
    dhcp_server_init();    // dhcp_server.hl -- DHCP server (IP address assignment)
    sip_init();            // sip.hl -- SIP VoIP signaling protocol client
    bcrypt_init();         // bcrypt.hl -- bcrypt adaptive password hashing
    rtsp_init();           // rtsp.hl -- RTSP streaming media protocol client
    stun_init();           // stun.hl -- STUN NAT traversal protocol client
    rtp_init();            // rtp.hl -- Real-time Transport Protocol for streaming
    socks_init();          // socks.hl -- SOCKS5 proxy protocol client
    zlib_init();           // zlib.hl -- DEFLATE compression with zlib wrapper
    lzma_init();           // lzma.hl -- LZMA compression algorithm
    protobuf_init();       // protobuf.hl -- Protocol Buffers wire format
    chacha20_init();       // chacha20.hl -- ChaCha20 stream cipher
    rsa_init();            // rsa.hl -- RSA asymmetric encryption
    ed25519_init();        // ed25519.hl -- Ed25519 digital signatures
    avro_init();           // avro.hl -- Apache Avro binary encoding
    bzip2_init();          // bzip2.hl -- bzip2 compression (Burrows-Wheeler)
    scrypt_init();         // scrypt.hl -- scrypt password KDF
    blake2_init();         // blake2.hl -- BLAKE2 cryptographic hash
    snappy_init();         // snappy.hl -- Snappy fast compression
    argon2_init();         // argon2.hl -- Argon2 password hashing
    poly1305_init();       // poly1305.hl -- Poly1305 MAC
    xxhash_init();         // xxhash.hl -- xxHash fast non-cryptographic hash
    siphash_init();        // siphash.hl -- SipHash DoS-resistant hash
    zstd_init();           // zstd.hl -- Zstandard compression
    brotli_init();         // brotli.hl -- Brotli compression (Google)
    sm3_init();            // sm3.hl -- SM3 cryptographic hash (Chinese national standard)
    sm4_init();            // sm4.hl -- SM4 block cipher (Chinese national standard)
    curve25519_init();     // curve25519.hl -- X25519 ECDH key exchange (RFC 7748)
    aes_gcm_init();        // aes_gcm.hl -- AES-128-GCM AEAD (NIST SP 800-38D)
    chacha20_poly1305_init(); // chacha20_poly1305.hl -- ChaCha20-Poly1305 AEAD (RFC 8439)
    x509_init();             // x509.hl -- X.509 v3 certificate parser (RFC 5280)
    grpc_init();             // grpc.hl -- gRPC unary RPC (HTTP/2 LPM framing + protobuf)
    png_init();              // png.hl -- PNG image decoder (RFC 2083, filters 0-4)
    http2_init();            // http2.hl -- HTTP/2 (RFC 7540) + HPACK (RFC 7541)
    jpeg_init();             // jpeg.hl -- JPEG baseline decoder (ISO 10918-1)
    raft_init(0, 1);         // raft.hl -- Raft consensus (leader election + log replication)
    gossip_init(0, "127.0.0.1:7946"); // gossip.hl -- SWIM membership protocol (Das+Gupta+Karp 2002)
    matrix_init();           // matrix.hl -- BLAS-like matrix ops (fixed-point, Gauss-Jordan)
    neural_init();           // neural.hl -- MLP inference engine (ReLU/Sigmoid/Tanh/Softmax, backprop)
    attention_init();        // attention.hl -- Transformer self-attention (multi-head, pos-enc, FFN)
    bloom_init(3, 1000);     // bloom_filter.hl -- Bloom filter (k-hash, counting, FPR estimation)
    crdt_init_all();         // crdt.hl -- CRDTs: G-Counter, PN-Counter, G-Set, 2P-Set, LWW, OR-Set
    skiplist_init();         // skiplist.hl -- skip list ordered map (O(log n) insert/search/delete)
    hyperloglog_init();      // hyperloglog.hl -- HyperLogLog cardinality estimator (m=64)
    consistent_hash_init();  // consistent_hash.hl -- consistent hashing ring (vnodes, replication)
    count_min_sketch_init(); // count_min_sketch.hl -- Count-Min Sketch (w=64 d=4, frequency estimation)
    lru_cache_init(32, 1);   // lru_cache.hl -- LRU cache O(1) get/put (doubly-linked list + hash map)
    merkle_tree_init();      // merkle_tree.hl -- Merkle hash tree (inclusion proofs, partial update)
    tdigest_init();          // tdigest.hl -- t-Digest online quantile estimator (p50/p90/p99)
    wavelet_init();          // wavelet.hl -- Haar DWT (1D/2D, multi-level, threshold compression)
    reservoir_sampling_init(32); // reservoir_sampling.hl -- reservoir sampling (Algorithm R, weighted)
    fenwick_init(64);        // fenwick_tree.hl -- Fenwick Tree (BIT) prefix sum + range update + k-th
    segment_tree_init(64);   // segment_tree.hl -- Segment Tree range sum/min/max + lazy range add
    cuckoo_filter_init();    // cuckoo_filter.hl -- Cuckoo Filter (deletion-capable probabilistic set)
    dsu_init(64);            // disjoint_set.hl -- Union-Find (path compression + union by rank, Kruskal)
    treap_init();            // treap.hl -- Treap (split/merge, rank/k-th, O(log n) expected)
    suffix_array_init();     // suffix_array.hl -- Suffix Array + LCP (Manber+Myers + Kasai)
    aho_corasick_init();     // aho_corasick.hl -- Aho-Corasick automaton (Aho & Corasick 1975)
    kmp_init();              // kmp.hl -- KMP + Z-function + Rabin-Karp string matching
    interval_tree_init();    // interval_tree.hl -- sorted augmented intervals + suffix-max
    sparse_table_init();     // sparse_table.hl -- Sparse Table O(1) RMQ (Bender & Farach-Colton 2000)
    binary_heap_init();      // binary_heap.hl -- binary min-heap + heapsort
    kd_tree_init();          // kd_tree.hl -- 2D KD-tree nearest neighbor + range count
    leftist_heap_init();     // leftist_heap.hl -- leftist heap O(log n) merge (Crane 1972)
    lcs_init();              // lcs.hl -- LCS + Levenshtein edit distance + LIS O(nm)/O(n²)
    convex_hull_init();      // convex_hull.hl -- convex hull Andrew's monotone chain O(n log n)
    dijkstra_init();         // dijkstra.hl -- Dijkstra SSSP O(V²) adjacency matrix
    topological_sort_init(); // topological_sort.hl -- Kahn BFS topo sort + cycle detection O(V+E)
    bellman_ford_init();     // bellman_ford.hl -- Bellman-Ford SSSP + negative cycle O(VE)
    prim_init();             // prim.hl -- Prim's MST O(V²) linear-scan adjacency matrix
    kruskal_init();          // kruskal.hl -- Kruskal's MST O(E log E) DSU + insertion sort
    floyd_warshall_init();   // floyd_warshall.hl -- Floyd-Warshall APSP O(V³) negative edge support
    a_star_init();           // a_star.hl -- A* heuristic search O(V²) Manhattan distance
    max_flow_init();         // max_flow.hl -- Edmonds-Karp max flow O(VE²) BFS augmenting paths
    bipartite_match_init();  // bipartite_match.hl -- bipartite matching O(VE) augmenting DFS
    tarjan_init();           // tarjan.hl -- Tarjan SCC O(V+E) low-link DFS
    articulation_init();     // articulation.hl -- articulation points + bridges O(V+E)
    euler_path_init();       // euler_path.hl -- Hierholzer Eulerian path/circuit O(E)
    two_sat_init();          // two_sat.hl -- 2-SAT implication graph + Tarjan SCC O(V+E)
    hungarian_init();        // hungarian.hl -- Hungarian min-cost assignment O(n³)
    hopcroft_karp_init();    // hopcroft_karp.hl -- Hopcroft-Karp bipartite matching O(E√V)
    min_cost_flow_init();    // min_cost_flow.hl -- min-cost max-flow SPFA augmenting paths O(VEf)
    centroid_init();         // centroid.hl -- centroid decomposition O(n log n)
    heavy_light_init();      // heavy_light.hl -- heavy-light decomposition O(n) build, O(log n) hops
    lca_init();              // lca.hl -- lowest common ancestor binary lifting O(n log n) + O(log n)
    vt_init();               // virtual_tree.hl -- virtual tree over key vertices O(k^2)
    dom_init();              // dominator.hl -- dominator tree Cooper et al. O(n^2) iterative RPO
    sam_init();              // suffix_automaton.hl -- suffix automaton O(n) construct, O(n) substr count
    man_init();              // manacher.hl -- Manacher palindrome O(n), longest palindromic substring
    et_init();               // eertree.hl -- palindromic tree O(n), distinct palindromic substrings
    serial_print("  [ok] PCI + AHCI + ATA-PIO + USB + USB-KBD + AC97 + AudioServer + Net + DHCP + netfilter + httpd + WS + Telnet + SMTP + Cron + NTP + POP3 + IRC + Calendar + SQLite + Diff + Clock + Base64 + INI + Profiler + CSV + Ping + Traceroute + Semaphore + IMAP + MQTT + LZ4 + FTP + CBOR + SyslogSrv + CPIO + QP + UU + ASN1 + PEM + JWT + BMP + GIF + WAV + Base32 + Hex + URL + CRC + MD5 + SHA1 + HMAC + PBKDF2 + UUID + RLE + RSS + LDAP + AES + Huffman + RADIUS + SHA256 + DHCPSrv + SIP + Bcrypt + RTSP + STUN + RTP + SOCKS + ZLIB + LZMA + Protobuf + ChaCha20 + RSA + Ed25519 + Avro + Bzip2 + Scrypt + BLAKE2 + Snappy + Argon2 + Poly1305 + xxHash + SipHash + Zstd + Brotli + SM3 + SM4 + Curve25519 + AES-GCM + ChaCha20-Poly1305 + X.509 + gRPC + PNG + HTTP/2 + JPEG + Raft + Gossip + Matrix + Neural + Attention + Bloom + CRDT + SkipList + HyperLogLog + ConsistentHash + CMS + LRU + Merkle + tDigest + Wavelet + Reservoir + Fenwick + SegTree + CuckooFilter + DSU + Treap + SuffixArray + AhoCorasick + KMP + IntervalTree + SparseTable + BinaryHeap + KDTree + LeftistHeap + LCS + ConvexHull + Dijkstra + TopologicalSort + BellmanFord + Prim + Kruskal + FloydWarshall + AStar + MaxFlow + BipartiteMatch + TarjanSCC + Articulation + EulerPath + 2SAT + Hungarian + HopcroftKarp + MinCostFlow + Centroid + HLD + LCA + VirtualTree + Dominator + SAM + Manacher + Eertree");

    // === Phase 8: ACPI + SMP + RTC ===
    power_init();          // power.hl -- ACPI tables
    smp_init();            // smp.hl -- boot APs
    let boot_time = rtc_format_time();
    serial_print("  [ok] ACPI + SMP: " + to_string(smp_cpu_count()) + " core(s) | Boot Time: " + boot_time);

    // === Phase 9: Usermode + Security ===
    tss_init();            // usermode.hl -- TSS for ring 3
    syscall_msr_setup(0);  // usermode.hl -- STAR/LSTAR/FMASK for SYSCALL/SYSRET
    users_init();          // users.hl -- multi-user + permissions
    secboot_init();        // secure_boot.hl
    seccomp_init();        // seccomp.hl -- syscall filter sandbox
    serial_print("  [ok] Usermode + SYSCALL MSRs + Secure Boot + seccomp filter");

    // === Phase 10: Firmware + GPT ===
    firmware_init();       // firmware.hl
    let gpt_count = gpt_read();
    if gpt_count > 0 {
        serial_print("  [ok] GPT: " + to_string(gpt_count) + " partition(s)");
    } else {
        serial_print("  [ok] MBR partition layout");
    }

    // === Phase 11: Kernel Module Hot-Patching ===
    kmod_init();           // kmod.hl -- runtime module loading
    serial_print("  [ok] kmod: 64 module slots, 256 trampolines");

    // === Phase 12: VGA Text Console ===
    vga_console_init();    // vga_console.hl -- 80x25 text-mode display
    serial_print("  [ok] VGA console: 80x25 text mode (0xB8000)");

    // === Phase 13: Self-Image Awareness ===
    self_image_init();     // self_image.hl -- kernel self-install metadata
    serial_print("  [ok] Self-image: " + to_string(self_image_sectors()) + " sectors");

    // === Summary ===
    serial_print("");
    serial_print("=== HicOS kernel initialized (295 modules) ===");
    serial_print("");

    // === Login ===
    login_prompt();        // login.hl -- authenticate user before shell

    // === Open terminal window on desktop ===
    wm_open_terminal_window();  // wm.hl -- graphical terminal at startup

    // === Enter interactive shell ===
    serial_print("HicOS> ");
    shell_main();          // shell.hl -- interactive command loop

    // === Idle loop (if shell exits) ===
    return 0;
}

// Module dependency map (100 modules):
//
// kernel_entry -> kernel_init (this file)
//   |-> serial       (no deps)
//   |-> kmalloc      (no deps)
//   |-> page_alloc   (no deps)
//   |-> virt_mem     (page_alloc)
//   |-> hilbert_alloc(page_alloc)
//   |-> swap         (page_alloc, virt_mem, virtio_blk)
//   |-> mmap         (virt_mem, page_alloc)
//   |-> timer        (PIT ticks)
//   |-> rtc          (CMOS ports)
//   |-> task         (no deps)
//   |-> sched        (task)
//   |-> sync         (task)
//   |-> signal       (task)
//   |-> exception    (serial, signal)
//   |-> panic        (serial, framebuffer)
//   |-> pipe         (no deps)
//   |-> poll         (pipe, tcp, vfs)
//   |-> pty          (no deps)
//   |-> socket       (tcp, udp, net)
//   |-> shm          (mmap, page_alloc)
//   |-> eventfd      (poll)
//   |-> posix        (task, vfs, elf, signal, pipe)
//   |-> env          (no deps)
//   |-> ramfs        (no deps)
//   |-> fat16        (virtio_blk)
//   |-> ext2         (virtio_blk | usb_storage)
//   |-> ext4         (virtio_blk | usb_storage)
//   |-> ntfs         (virtio_blk | usb_storage)
//   |-> tmpfs        (no deps)
//   |-> block_cache  (virtio_blk | usb_storage)
//   |-> inotify      (vfs)
//   |-> sysfs        (no deps)
//   |-> vfs          (ramfs, fat16, ext2, ext4, ntfs, tmpfs)
//   |-> devfs        (serial, framebuffer)
//   |-> procfs       (task, timer, virt_mem)
//   |-> scancode     (no deps)
//   |-> mouse        (no deps)
//   |-> framebuffer  (no deps)
//   |-> vesa         (no deps)
//   |-> wm           (vesa, mouse, task)
//   |-> terminal     (wm, vesa)
//   |-> gpu          (pci, virtio)
//   |-> multimon     (gpu)
//   |-> pci          (no deps)
//   |-> acpi         (no deps)
//   |-> lapic        (acpi)
//   |-> smp          (lapic, acpi, task)
//   |-> virtio_net   (pci)
//   |-> virtio_blk   (pci)
//   |-> net          (virtio_net)
//   |-> arp          (net)
//   |-> udp          (net)
//   |-> tcp          (net)
//   |-> icmp         (net)
//   |-> dhcp         (net, virtio_net)
//   |-> dns          (net)
//   |-> ipv6         (net)
//   |-> ntp          (udp, rtc)
//   |-> netfilter    (net)
//   |-> http         (tcp, tls, dns)
//   |-> tls          (tcp, dns)
//   |-> random       (no deps, uses RDRAND + timer jitter)
//   |-> cgroup       (task, page_alloc)
//   |-> wifi         (net, firmware)
//   |-> bluetooth    (usb, firmware)
//   |-> ipc          (task, sync)
//   |-> syscall      (task, vfs, signal, net, posix)
//   |-> usermode     (task, syscall)
//   |-> users        (no deps)
//   |-> elf          (virt_mem, page_alloc)
//   |-> power        (acpi)
//   |-> audio        (pci)
//   |-> mixer        (audio)
//   |-> usb          (pci)
//   |-> usb_storage  (usb)
//   |-> usb_hid      (usb)
//   |-> usb_hub      (usb)
//   |-> firmware     (vfs)
//   |-> syslog       (serial, timer)
//   |-> watchdog     (timer, syslog, task)
//   |-> trace        (timer)
//   |-> hrtimer      (lapic, timer)
//   |-> ir           (no deps)
//   |-> regalloc     (no deps)
//   |-> abi          (x86enc)
//   |-> codegen      (ir, regalloc, abi, x86enc)
//   |-> kmod         (timer)
//   |-> login        (users, env, shell)
//   |-> shell        (serial, syscall, vfs, task, timer, rtc, env)

print("kernel_init.hl loaded");
print("Init sequence: 13 phases, 156 modules");
kernel_main();
