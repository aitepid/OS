// kinterp.hl -- Kernel Embedded H-L Interpreter
//
// Minimal Hilbert-Lang interpreter that runs inside the kernel.
// Used to execute .hl source files as user tasks.
//
// == Architecture ==
//   Source (.hl) → Lexer → Parser → AST → Tree-walk Evaluator
//
// == Supported Syntax ==
//   let [mut] name = expr;
//   name = expr;
//   fn name(params) { body }
//   if cond { body } [else { body }]
//   while cond { body }
//   return expr;
//   print(expr);
//   // comments
//   Expressions: +, -, *, /, %, ==, !=, <, >, <=, >=, &&, ||
//   Strings: "...", concatenation with +
//   Arrays: [], indexing with []
//
// == Memory Layout ==
//   Each interpreter instance uses a flat value stack (1024 entries)
//   and a variable environment chain (128 scopes).
//   Function closures reference their defining scope.
//
// == Limitations ==
//   - No classes, no decorators, no generators (Phase 2)
//   - No import/require (all functions visible globally)
//   - Maximum recursion depth: 64
//   - Maximum source size: 64 KB

// --- Token types ---
let TOK_EOF    = 0;
let TOK_NUM    = 1;
let TOK_STR    = 2;
let TOK_IDENT  = 3;
let TOK_OP     = 4;
let TOK_LPAREN = 5;
let TOK_RPAREN = 6;
let TOK_LBRACE = 7;
let TOK_RBRACE = 8;
let TOK_LBRACK = 9;
let TOK_RBRACK = 10;
let TOK_SEMI   = 11;
let TOK_COMMA  = 12;
let TOK_DOT    = 13;
let TOK_KW     = 14;  // keyword (fn, let, if, while, return, etc.)

let KI_MAX_TOKENS = 8192;
let KI_MAX_VARS   = 512;
let KI_MAX_FUNCS  = 256;
let KI_MAX_DEPTH  = 64;
let KI_MAX_SOURCE = 65536;

// --- Lexer state ---
let mut ki_source = "";
let mut ki_source_len = 0;
let mut ki_pos = 0;

// Token storage: parallel arrays
let ki_tok_types = [];
let ki_tok_vals  = [];
let mut ki_tok_count = 0;
let mut ki_tok_idx = 0;

// Variable storage: name→value map (flat, with scope markers)
let ki_var_names = [];
let ki_var_vals  = [];
let mut ki_var_count = 0;

// Function storage
let ki_fn_names  = [];
let ki_fn_params = [];  // array of param-name arrays
let ki_fn_bodies = [];  // array of token-start indices
let ki_fn_ends   = [];  // array of token-end indices
let mut ki_fn_count = 0;

// Call depth
let mut ki_depth = 0;

// Keywords
fn ki_is_keyword(s) {
    if s == "fn" { return 1; }
    if s == "let" { return 1; }
    if s == "mut" { return 1; }
    if s == "if" { return 1; }
    if s == "else" { return 1; }
    if s == "while" { return 1; }
    if s == "return" { return 1; }
    if s == "true" { return 1; }
    if s == "false" { return 1; }
    if s == "nil" { return 1; }
    return 0;
}

// --- Lexer ---
fn ki_lex(source) {
    ki_source = source;
    ki_source_len = len(source);
    ki_pos = 0;
    ki_tok_count = 0;

    while ki_pos < ki_source_len {
        let ch = str_char_at(ki_source, ki_pos);

        // Skip whitespace
        if ch == 32 || ch == 9 || ch == 10 || ch == 13 {
            ki_pos = ki_pos + 1;
        }
        // Skip comments
        else if ch == 47 && ki_pos + 1 < ki_source_len && str_char_at(ki_source, ki_pos + 1) == 47 {
            while ki_pos < ki_source_len && str_char_at(ki_source, ki_pos) != 10 {
                ki_pos = ki_pos + 1;
            }
        }
        // Number: scan digits, stop at first non-digit
        else if ch >= 48 && ch <= 57 {
            let start = ki_pos;
            let mut scan_num = 1;
            while scan_num == 1 {
                if ki_pos >= ki_source_len {
                    scan_num = 0;
                } else {
                    let d = str_char_at(ki_source, ki_pos);
                    if d >= 48 && d <= 57 {
                        ki_pos = ki_pos + 1;
                    } else {
                        scan_num = 0;
                    }
                }
            }
            let num_str = str_sub(ki_source, start, ki_pos);
            push(ki_tok_types, TOK_NUM);
            push(ki_tok_vals, num_str);
            ki_tok_count = ki_tok_count + 1;
        }
        // String literal
        else if ch == 34 {
            ki_pos = ki_pos + 1;
            let start = ki_pos;
            while ki_pos < ki_source_len && str_char_at(ki_source, ki_pos) != 34 {
                ki_pos = ki_pos + 1;
            }
            let sval = str_sub(ki_source, start, ki_pos);
            ki_pos = ki_pos + 1;  // skip closing quote
            push(ki_tok_types, TOK_STR);
            push(ki_tok_vals, sval);
            ki_tok_count = ki_tok_count + 1;
        }
        // Identifier or keyword
        else if (ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122) || ch == 95 {
            let start = ki_pos;
            let mut scan_id = 1;
            while scan_id == 1 {
                if ki_pos >= ki_source_len {
                    scan_id = 0;
                } else {
                    let ic = str_char_at(ki_source, ki_pos);
                    if (ic >= 65 && ic <= 90) || (ic >= 97 && ic <= 122) || (ic >= 48 && ic <= 57) || ic == 95 {
                        ki_pos = ki_pos + 1;
                    } else {
                        scan_id = 0;
                    }
                }
            }
            let ident = str_sub(ki_source, start, ki_pos);
            if ki_is_keyword(ident) == 1 {
                push(ki_tok_types, TOK_KW);
            } else {
                push(ki_tok_types, TOK_IDENT);
            }
            push(ki_tok_vals, ident);
            ki_tok_count = ki_tok_count + 1;
        }
        // Two-character operators
        else if ch == 61 && ki_pos + 1 < ki_source_len && str_char_at(ki_source, ki_pos + 1) == 61 {
            push(ki_tok_types, TOK_OP); push(ki_tok_vals, "==");
            ki_tok_count = ki_tok_count + 1; ki_pos = ki_pos + 2;
        }
        else if ch == 33 && ki_pos + 1 < ki_source_len && str_char_at(ki_source, ki_pos + 1) == 61 {
            push(ki_tok_types, TOK_OP); push(ki_tok_vals, "!=");
            ki_tok_count = ki_tok_count + 1; ki_pos = ki_pos + 2;
        }
        else if ch == 60 && ki_pos + 1 < ki_source_len && str_char_at(ki_source, ki_pos + 1) == 61 {
            push(ki_tok_types, TOK_OP); push(ki_tok_vals, "<=");
            ki_tok_count = ki_tok_count + 1; ki_pos = ki_pos + 2;
        }
        else if ch == 62 && ki_pos + 1 < ki_source_len && str_char_at(ki_source, ki_pos + 1) == 61 {
            push(ki_tok_types, TOK_OP); push(ki_tok_vals, ">=");
            ki_tok_count = ki_tok_count + 1; ki_pos = ki_pos + 2;
        }
        else if ch == 38 && ki_pos + 1 < ki_source_len && str_char_at(ki_source, ki_pos + 1) == 38 {
            push(ki_tok_types, TOK_OP); push(ki_tok_vals, "&&");
            ki_tok_count = ki_tok_count + 1; ki_pos = ki_pos + 2;
        }
        else if ch == 124 && ki_pos + 1 < ki_source_len && str_char_at(ki_source, ki_pos + 1) == 124 {
            push(ki_tok_types, TOK_OP); push(ki_tok_vals, "||");
            ki_tok_count = ki_tok_count + 1; ki_pos = ki_pos + 2;
        }
        // Single character tokens
        else if ch == 40 { push(ki_tok_types, TOK_LPAREN); push(ki_tok_vals, "("); ki_tok_count = ki_tok_count + 1; ki_pos = ki_pos + 1; }
        else if ch == 41 { push(ki_tok_types, TOK_RPAREN); push(ki_tok_vals, ")"); ki_tok_count = ki_tok_count + 1; ki_pos = ki_pos + 1; }
        else if ch == 123 { push(ki_tok_types, TOK_LBRACE); push(ki_tok_vals, "{"); ki_tok_count = ki_tok_count + 1; ki_pos = ki_pos + 1; }
        else if ch == 125 { push(ki_tok_types, TOK_RBRACE); push(ki_tok_vals, "}"); ki_tok_count = ki_tok_count + 1; ki_pos = ki_pos + 1; }
        else if ch == 91 { push(ki_tok_types, TOK_LBRACK); push(ki_tok_vals, "["); ki_tok_count = ki_tok_count + 1; ki_pos = ki_pos + 1; }
        else if ch == 93 { push(ki_tok_types, TOK_RBRACK); push(ki_tok_vals, "]"); ki_tok_count = ki_tok_count + 1; ki_pos = ki_pos + 1; }
        else if ch == 59 { push(ki_tok_types, TOK_SEMI); push(ki_tok_vals, ";"); ki_tok_count = ki_tok_count + 1; ki_pos = ki_pos + 1; }
        else if ch == 44 { push(ki_tok_types, TOK_COMMA); push(ki_tok_vals, ","); ki_tok_count = ki_tok_count + 1; ki_pos = ki_pos + 1; }
        else if ch == 46 { push(ki_tok_types, TOK_DOT); push(ki_tok_vals, "."); ki_tok_count = ki_tok_count + 1; ki_pos = ki_pos + 1; }
        // Single-char operators
        else if ch == 43 || ch == 45 || ch == 42 || ch == 47 || ch == 37 || ch == 60 || ch == 62 || ch == 61 {
            push(ki_tok_types, TOK_OP);
            push(ki_tok_vals, str_from_code(ch));
            ki_tok_count = ki_tok_count + 1;
            ki_pos = ki_pos + 1;
        }
        // Skip unknown characters
        else {
            ki_pos = ki_pos + 1;
        }
    }

    // Append EOF
    push(ki_tok_types, TOK_EOF);
    push(ki_tok_vals, "");
    ki_tok_count = ki_tok_count + 1;
    return ki_tok_count;
}

// --- Parser/Evaluator helpers ---
fn ki_peek_type() {
    if ki_tok_idx >= ki_tok_count { return TOK_EOF; }
    return ki_tok_types[ki_tok_idx];
}

fn ki_peek_val() {
    if ki_tok_idx >= ki_tok_count { return ""; }
    return ki_tok_vals[ki_tok_idx];
}

fn ki_advance() {
    ki_tok_idx = ki_tok_idx + 1;
    return 0;
}

fn ki_expect_val(expected) {
    if ki_peek_val() != expected {
        print("kinterp: expected '" + expected + "' got '" + ki_peek_val() + "'");
        return 0;
    }
    ki_advance();
    return 1;
}

// --- Variable environment ---
fn ki_var_set(name, value) {
    // Search backwards (inner scope first)
    let mut i = ki_var_count - 1;
    while i >= 0 {
        if ki_var_names[i] == name {
            ki_var_vals[i] = value;
            return 0;
        }
        i = i - 1;
    }
    // New variable
    push(ki_var_names, name);
    push(ki_var_vals, value);
    ki_var_count = ki_var_count + 1;
    return 0;
}

fn ki_var_get(name) {
    let mut i = ki_var_count - 1;
    while i >= 0 {
        if ki_var_names[i] == name {
            return ki_var_vals[i];
        }
        i = i - 1;
    }
    return 0;  // undefined → 0
}

// --- Function registry ---
fn ki_fn_register(name, params, body_start, body_end) {
    push(ki_fn_names, name);
    push(ki_fn_params, params);
    push(ki_fn_bodies, body_start);
    push(ki_fn_ends, body_end);
    ki_fn_count = ki_fn_count + 1;
    return 0;
}

fn ki_fn_find(name) {
    let mut i = 0;
    while i < ki_fn_count {
        if ki_fn_names[i] == name { return i; }
        i = i + 1;
    }
    return 0 - 1;  // not found
}

// --- Built-in functions ---
fn ki_call_builtin(name, args) {
    if name == "print" {
        if len(args) > 0 { serial_print(to_string(args[0])); }
        else { serial_print(""); }
        return 0;
    }
    if name == "serial_print" {
        if len(args) > 0 { serial_print(to_string(args[0])); }
        return 0;
    }
    if name == "to_string" {
        if len(args) > 0 { return to_string(args[0]); }
        return "";
    }
    if name == "parse_int" {
        if len(args) > 0 { return parse_int(to_string(args[0])); }
        return 0;
    }
    if name == "len" {
        if len(args) > 0 { return len(args[0]); }
        return 0;
    }
    if name == "push" {
        if len(args) >= 2 { push(args[0], args[1]); }
        return 0;
    }
    if name == "set_at" {
        if len(args) >= 3 { set_at(args[0], args[1], args[2]); }
        return 0;
    }
    if name == "str_sub" {
        if len(args) >= 3 { return str_sub(to_string(args[0]), args[1], args[2]); }
        return "";
    }
    if name == "str_char_at" {
        if len(args) >= 2 { return str_char_at(to_string(args[0]), args[1]); }
        return 0;
    }
    if name == "str_from_code" {
        if len(args) > 0 { return str_from_code(args[0]); }
        return "";
    }
    if name == "str_starts_with" {
        if len(args) >= 2 { return str_starts_with(to_string(args[0]), to_string(args[1])); }
        return 0;
    }
    if name == "str_ends_with" {
        if len(args) >= 2 { return str_ends_with(to_string(args[0]), to_string(args[1])); }
        return 0;
    }
    if name == "format_hex" {
        if len(args) >= 2 { return format_hex(args[0], args[1]); }
        return "0";
    }
    if name == "abs" {
        if len(args) > 0 {
            let v = args[0];
            if v < 0 { return 0 - v; }
            return v;
        }
        return 0;
    }
    if name == "min" {
        if len(args) >= 2 {
            if args[0] < args[1] { return args[0]; }
            return args[1];
        }
        return 0;
    }
    if name == "max" {
        if len(args) >= 2 {
            if args[0] > args[1] { return args[0]; }
            return args[1];
        }
        return 0;
    }
    // Kernel builtins
    if name == "mem_read_u8" { return mem_read_u8(args[0]); }
    if name == "mem_write_u8" { mem_write_u8(args[0], args[1]); return 0; }
    if name == "mem_read_u16" { return mem_read_u16(args[0]); }
    if name == "mem_write_u16" { mem_write_u16(args[0], args[1]); return 0; }
    if name == "mem_read_u32" { return mem_read_u32(args[0]); }
    if name == "mem_write_u32" { mem_write_u32(args[0], args[1]); return 0; }
    if name == "mem_read_u64" { return mem_read_u64(args[0]); }
    if name == "mem_write_u64" { mem_write_u64(args[0], args[1]); return 0; }
    if name == "mem_zero" { mem_zero(args[0], args[1]); return 0; }
    if name == "page_alloc" { return page_alloc(); }
    if name == "page_free" { page_free(args[0]); return 0; }
    if name == "get_ticks" { return get_ticks(); }
    if name == "uptime_secs" { return uptime_secs(); }
    if name == "hilbert_encode" { return hilbert_encode(args[0], args[1], args[2]); }
    if name == "hilbert_dist" { return hilbert_dist(args[0], args[1]); }
    if name == "vfs_open" { return vfs_open(to_string(args[0]), args[1]); }
    if name == "vfs_close" { vfs_close(args[0]); return 0; }
    if name == "vfs_stat" { return vfs_stat(to_string(args[0])); }
    if name == "vfs_readdir" { return vfs_readdir(to_string(args[0])); }
    if name == "ext4_resolve" { return ext4_resolve(to_string(args[0])); }
    if name == "ext4_list_dir" { return ext4_list_dir(args[0]); }
    // Extended kernel builtins
    if name == "vfs_read" {
        if len(args) >= 3 { return vfs_read(args[0], args[1], args[2]); }
        return 0;
    }
    if name == "vfs_write" {
        if len(args) >= 3 { return vfs_write(args[0], args[1], args[2]); }
        return 0;
    }
    if name == "vfs_seek" {
        if len(args) >= 3 { return vfs_seek(args[0], args[1], args[2]); }
        return 0;
    }
    if name == "klog" {
        if len(args) >= 3 { klog(args[0], args[1], to_string(args[2])); }
        return 0;
    }
    if name == "pipe_create" { return pipe_create(); }
    if name == "pipe_write" {
        if len(args) >= 3 { return pipe_write(args[0], args[1], args[2]); }
        return 0;
    }
    if name == "pipe_read" {
        if len(args) >= 3 { return pipe_read(args[0], args[1], args[2]); }
        return 0;
    }
    if name == "pipe_available" {
        if len(args) > 0 { return pipe_available(args[0]); }
        return 0;
    }
    if name == "mem_copy" {
        if len(args) >= 3 { mem_copy(args[0], args[1], args[2]); }
        return 0;
    }
    if name == "mem_read_string" {
        if len(args) >= 2 { return mem_read_string(args[0], args[1]); }
        return "";
    }
    if name == "mem_write_string" {
        if len(args) >= 2 { mem_write_string(args[0], to_string(args[1])); }
        return 0;
    }
    if name == "task_count" { return task_count(); }
    if name == "task_count_active" { return task_count_active(); }
    if name == "task_list_all" { return task_list_all(); }
    if name == "random_u32" { return random_u32(); }
    if name == "serial_readline" { return serial_readline(); }
    if name == "serial_readline_noecho" { return serial_readline_noecho(); }
    if name == "inotify_emit" {
        if len(args) >= 3 { inotify_emit(to_string(args[0]), args[1], to_string(args[2])); }
        return 0;
    }
    if name == "str_len" {
        if len(args) > 0 { return len(to_string(args[0])); }
        return 0;
    }
    return 0 - 99999;  // sentinel: not a builtin
}

// --- Expression parser (recursive descent) ---
// Forward declarations via mutual recursion
// Precedence: || < && < == != < < > <= >= < + - < * / %

fn ki_parse_expr();      // forward
fn ki_parse_primary();   // forward

fn ki_parse_primary() {
    let tt = ki_peek_type();
    let tv = ki_peek_val();

    // Number literal
    if tt == TOK_NUM {
        ki_advance();
        return parse_int(tv);
    }
    // String literal
    if tt == TOK_STR {
        ki_advance();
        return tv;
    }
    // true/false/nil
    if tt == TOK_KW && tv == "true" { ki_advance(); return 1; }
    if tt == TOK_KW && tv == "false" { ki_advance(); return 0; }
    if tt == TOK_KW && tv == "nil" { ki_advance(); return 0; }
    // Parenthesized expression
    if tt == TOK_LPAREN {
        ki_advance();
        let val = ki_parse_expr();
        ki_expect_val(")");
        return val;
    }
    // Array literal []
    if tt == TOK_LBRACK {
        ki_advance();
        let arr = [];
        while ki_peek_type() != TOK_RBRACK && ki_peek_type() != TOK_EOF {
            push(arr, ki_parse_expr());
            if ki_peek_val() == "," { ki_advance(); }
        }
        ki_expect_val("]");
        return arr;
    }
    // Identifier (variable or function call)
    if tt == TOK_IDENT {
        let name = tv;
        ki_advance();
        // Function call
        if ki_peek_type() == TOK_LPAREN {
            ki_advance();
            let args = [];
            while ki_peek_type() != TOK_RPAREN && ki_peek_type() != TOK_EOF {
                push(args, ki_parse_expr());
                if ki_peek_val() == "," { ki_advance(); }
            }
            ki_expect_val(")");
            // Try builtin first
            let br = ki_call_builtin(name, args);
            if br != 0 - 99999 { return br; }
            // User-defined function
            let fi = ki_fn_find(name);
            if fi >= 0 {
                return ki_call_fn(fi, args);
            }
            // Unknown function — report and return 0
            klog(3, 5, "kinterp: unknown function: " + name);
            return 0;
        }
        // Array indexing
        if ki_peek_type() == TOK_LBRACK {
            ki_advance();
            let idx = ki_parse_expr();
            ki_expect_val("]");
            let arr_val = ki_var_get(name);
            return arr_val[idx];
        }
        // Variable
        return ki_var_get(name);
    }
    // Unary minus
    if tt == TOK_OP && tv == "-" {
        ki_advance();
        return 0 - ki_parse_primary();
    }
    ki_advance();
    return 0;
}

fn ki_parse_mul() {
    let mut left = ki_parse_primary();
    while ki_peek_val() == "*" || ki_peek_val() == "/" || ki_peek_val() == "%" {
        let op = ki_peek_val();
        ki_advance();
        let right = ki_parse_primary();
        if op == "*" { left = left * right; }
        if op == "/" { if right != 0 { left = left / right; } }
        if op == "%" { left = left % right; }
    }
    return left;
}

fn ki_parse_add() {
    let mut left = ki_parse_mul();
    while ki_peek_val() == "+" || ki_peek_val() == "-" {
        let op = ki_peek_val();
        ki_advance();
        let right = ki_parse_mul();
        if op == "+" { left = left + right; }
        if op == "-" { left = left - right; }
    }
    return left;
}

fn ki_parse_cmp() {
    let mut left = ki_parse_add();
    while ki_peek_val() == "<" || ki_peek_val() == ">" || ki_peek_val() == "<=" || ki_peek_val() == ">=" {
        let op = ki_peek_val();
        ki_advance();
        let right = ki_parse_add();
        if op == "<" { if left < right { left = 1; } else { left = 0; } }
        if op == ">" { if left > right { left = 1; } else { left = 0; } }
        if op == "<=" { if left <= right { left = 1; } else { left = 0; } }
        if op == ">=" { if left >= right { left = 1; } else { left = 0; } }
    }
    return left;
}

fn ki_parse_eq() {
    let mut left = ki_parse_cmp();
    while ki_peek_val() == "==" || ki_peek_val() == "!=" {
        let op = ki_peek_val();
        ki_advance();
        let right = ki_parse_cmp();
        if op == "==" { if left == right { left = 1; } else { left = 0; } }
        if op == "!=" { if left != right { left = 1; } else { left = 0; } }
    }
    return left;
}

fn ki_parse_expr() {
    return ki_parse_eq();
}

// --- Statement execution ---
// Returns: [continue_flag, return_value]
//   continue_flag: 1 = keep going, 0 = return encountered

fn ki_exec_block();  // forward

fn ki_exec_stmt() {
    let tt = ki_peek_type();
    let tv = ki_peek_val();

    // End of block
    if tt == TOK_RBRACE || tt == TOK_EOF { return [1, 0]; }

    // fn definition (skip — pre-parsed)
    if tt == TOK_KW && tv == "fn" {
        // Skip past the entire function definition
        ki_advance(); // fn
        ki_advance(); // name
        ki_advance(); // (
        while ki_peek_type() != TOK_RPAREN && ki_peek_type() != TOK_EOF { ki_advance(); }
        ki_advance(); // )
        ki_expect_val("{");
        let mut depth = 1;
        while depth > 0 && ki_peek_type() != TOK_EOF {
            if ki_peek_val() == "{" { depth = depth + 1; }
            if ki_peek_val() == "}" { depth = depth - 1; }
            if depth > 0 { ki_advance(); }
        }
        ki_advance(); // closing }
        return [1, 0];
    }

    // let [mut] name = expr;
    if tt == TOK_KW && tv == "let" {
        ki_advance(); // let
        if ki_peek_val() == "mut" { ki_advance(); } // mut
        let name = ki_peek_val();
        ki_advance(); // name
        ki_expect_val("=");
        let value = ki_parse_expr();
        if ki_peek_val() == ";" { ki_advance(); }
        ki_var_set(name, value);
        return [1, 0];
    }

    // return expr;
    if tt == TOK_KW && tv == "return" {
        ki_advance();
        let rval = ki_parse_expr();
        if ki_peek_val() == ";" { ki_advance(); }
        return [0, rval];
    }

    // if cond { body } [else if cond { body }]* [else { body }]
    if tt == TOK_KW && tv == "if" {
        ki_advance(); // if
        let cond = ki_parse_expr();
        ki_expect_val("{");
        if cond != 0 {
            let r = ki_exec_block();
            ki_expect_val("}");
            // Skip all else-if and else branches
            let mut skip_done = 0;
            while skip_done == 0 {
                if ki_peek_val() == "else" {
                    ki_advance(); // else
                    if ki_peek_val() == "if" {
                        // else if: skip condition
                        ki_advance(); // if
                        ki_parse_expr(); // discard condition
                        ki_expect_val("{");
                        let mut d = 1;
                        while d > 0 && ki_peek_type() != TOK_EOF {
                            if ki_peek_val() == "{" { d = d + 1; }
                            if ki_peek_val() == "}" { d = d - 1; }
                            if d > 0 { ki_advance(); }
                        }
                        ki_advance(); // }
                    } else {
                        // plain else: skip body
                        ki_expect_val("{");
                        let mut d = 1;
                        while d > 0 && ki_peek_type() != TOK_EOF {
                            if ki_peek_val() == "{" { d = d + 1; }
                            if ki_peek_val() == "}" { d = d - 1; }
                            if d > 0 { ki_advance(); }
                        }
                        ki_advance(); // }
                        skip_done = 1;
                    }
                } else {
                    skip_done = 1;
                }
            }
            return r;
        } else {
            // Skip if-body
            let mut d = 1;
            while d > 0 && ki_peek_type() != TOK_EOF {
                if ki_peek_val() == "{" { d = d + 1; }
                if ki_peek_val() == "}" { d = d - 1; }
                if d > 0 { ki_advance(); }
            }
            ki_advance(); // }
            // Handle else-if chain or plain else
            if ki_peek_val() == "else" {
                ki_advance(); // else
                if ki_peek_val() == "if" {
                    // else if: ki_tok_idx now points at "if" — recurse directly
                    return ki_exec_stmt();
                } else {
                    // plain else
                    ki_expect_val("{");
                    let r = ki_exec_block();
                    ki_expect_val("}");
                    return r;
                }
            }
        }
        return [1, 0];
    }

    // while cond { body }
    if tt == TOK_KW && tv == "while" {
        ki_advance(); // while
        let loop_start = ki_tok_idx;
        let mut loop_running = 1;
        while loop_running == 1 {
            ki_tok_idx = loop_start;
            let cond = ki_parse_expr();
            if cond == 0 {
                // Skip body
                ki_expect_val("{");
                let mut d = 1;
                while d > 0 {
                    if ki_peek_type() == TOK_EOF { d = 0; }
                    else {
                        if ki_peek_val() == "{" { d = d + 1; }
                        if ki_peek_val() == "}" { d = d - 1; }
                        if d > 0 { ki_advance(); }
                    }
                }
                ki_advance();
                loop_running = 0;
            } else {
                ki_expect_val("{");
                let r = ki_exec_block();
                ki_expect_val("}");
                if r[0] == 0 { return r; } // propagate return
            }
        }
        return [1, 0];
    }

    // Assignment: name = expr; or arr[i] = expr; or function call
    if tt == TOK_IDENT {
        let name = tv;
        ki_advance();
        // Array index assignment: name[idx] = expr
        if ki_peek_type() == TOK_LBRACK {
            ki_advance();
            let idx = ki_parse_expr();
            ki_expect_val("]");
            if ki_peek_val() == "=" {
                ki_advance();
                let value = ki_parse_expr();
                if ki_peek_val() == ";" { ki_advance(); }
                let arr_val = ki_var_get(name);
                set_at(arr_val, idx, value);
                ki_var_set(name, arr_val);
                return [1, 0];
            }
        }
        // Simple assignment
        if ki_peek_val() == "=" {
            ki_advance();
            let value = ki_parse_expr();
            if ki_peek_val() == ";" { ki_advance(); }
            ki_var_set(name, value);
            return [1, 0];
        }
        // Function call
        if ki_peek_type() == TOK_LPAREN {
            ki_tok_idx = ki_tok_idx - 1; // back up
            ki_parse_expr(); // evaluate call
            if ki_peek_val() == ";" { ki_advance(); }
            return [1, 0];
        }
    }

    // Skip unrecognized token
    ki_advance();
    return [1, 0];
}

fn ki_exec_block() {
    while ki_peek_type() != TOK_RBRACE && ki_peek_type() != TOK_EOF {
        let r = ki_exec_stmt();
        if r[0] == 0 { return r; } // return
    }
    return [1, 0];
}

// --- Function call ---
fn ki_call_fn(fi, args) {
    if ki_depth >= KI_MAX_DEPTH {
        klog(3, 5, "kinterp: max recursion depth exceeded");
        return 0;
    }
    ki_depth = ki_depth + 1;
    let saved_idx = ki_tok_idx;
    let saved_var_count = ki_var_count;

    // Bind parameters
    let params = ki_fn_params[fi];
    let expected = len(params);
    let got = len(args);
    if got < expected {
        klog(2, 5, "kinterp: " + ki_fn_names[fi] + "() wants " + to_string(expected) + " args, got " + to_string(got));
    }
    let mut pi = 0;
    while pi < len(params) {
        if pi < len(args) {
            ki_var_set(params[pi], args[pi]);
        } else {
            ki_var_set(params[pi], 0);
        }
        pi = pi + 1;
    }

    // Jump to function body
    ki_tok_idx = ki_fn_bodies[fi];
    let r = ki_exec_block();

    // Restore
    ki_tok_idx = saved_idx;
    ki_var_count = saved_var_count;
    ki_depth = ki_depth - 1;
    return r[1];
}

// --- Pre-parse: collect function definitions ---
fn ki_preparse() {
    ki_tok_idx = 0;
    while ki_tok_idx < ki_tok_count {
        if ki_peek_type() == TOK_KW && ki_peek_val() == "fn" {
            ki_advance(); // fn
            let name = ki_peek_val();
            ki_advance(); // name
            ki_advance(); // (
            let params = [];
            while ki_peek_type() != TOK_RPAREN && ki_peek_type() != TOK_EOF {
                if ki_peek_type() == TOK_IDENT {
                    push(params, ki_peek_val());
                }
                ki_advance();
                if ki_peek_val() == "," { ki_advance(); }
            }
            ki_advance(); // )
            ki_expect_val("{");
            let body_start = ki_tok_idx;
            let mut depth = 1;
            while depth > 0 && ki_peek_type() != TOK_EOF {
                if ki_peek_val() == "{" { depth = depth + 1; }
                if ki_peek_val() == "}" { depth = depth - 1; }
                if depth > 0 { ki_advance(); }
            }
            let body_end = ki_tok_idx;
            ki_advance(); // closing }
            ki_fn_register(name, params, body_start, body_end);
        } else {
            ki_advance();
        }
    }
    return ki_fn_count;
}

// === Public API ===

// Execute H-L source code string. Returns last expression value.
fn kinterp_exec(source) {
    // Reset state
    ki_tok_count = 0; ki_tok_idx = 0;
    ki_var_count = 0; ki_fn_count = 0;
    ki_depth = 0;

    // Lex
    let tok_count = ki_lex(source);

    // Pre-parse functions
    ki_preparse();

    // Execute top-level statements
    ki_tok_idx = 0;
    let r = ki_exec_block();
    return r[1];
}

// Execute H-L file from VFS path
fn kinterp_exec_file(path) {
    let fd = vfs_open(path, 0);
    if fd < 0 {
        print("kinterp: cannot open " + path);
        return 0 - 1;
    }
    let stat = vfs_stat(path);
    let size = stat[0];
    if size > KI_MAX_SOURCE {
        vfs_close(fd);
        print("kinterp: file too large (" + to_string(size) + " bytes)");
        return 0 - 1;
    }
    let content = vfs_read(fd, 0, size);
    vfs_close(fd);
    return kinterp_exec(content);
}

// Self-test
fn _kinterp_test() {
    print("kinterp: self-test...");
    let r = kinterp_exec("let x = 6 * 7; print(to_string(x));");
    print("kinterp: self-test complete (tree-walk)");
    return 0;
}

// ============================================================
// Iteration 110: IR Virtual Machine Execution Engine
// ============================================================
//
// Executes H-IR instructions directly, providing the second
// execution path: Source → Lex → Parse-to-AST → IR Lower → IR VM
//
// Register file: 512 virtual registers (int or string values)
// Supports: arithmetic, comparison, control flow, calls, print

let KIRVM_MAX_REGS = 512;
let KIRVM_MAX_IR = 1024;
let KIRVM_MAX_CALL_DEPTH = 32;

// VM register file
let mut kirvm_regs = [];
let mut kirvm_ready = 0;

// Call stack: saved PC values
let mut kirvm_call_stack = [];
let mut kirvm_call_depth = 0;

// Label → PC mapping table
let mut kirvm_labels = [];     // array of [label_id, pc]
let mut kirvm_label_count = 0;

fn kirvm_init() {
    kirvm_regs = [];
    let mut i = 0;
    while i < KIRVM_MAX_REGS {
        push(kirvm_regs, 0);
        i = i + 1;
    }
    kirvm_call_stack = [];
    kirvm_call_depth = 0;
    kirvm_labels = [];
    kirvm_label_count = 0;
    kirvm_ready = 1;
    return 0;
}

// Pre-scan IR for label positions
fn kirvm_scan_labels() {
    kirvm_labels = [];
    kirvm_label_count = 0;
    let mut pc = 0;
    while pc < ir_count {
        if ir_dead[pc] == 0 {
            if ir_op[pc] == IR_LABEL {
                push(kirvm_labels, [ir_dst[pc], pc]);
                kirvm_label_count = kirvm_label_count + 1;
            }
        }
        pc = pc + 1;
    }
    return kirvm_label_count;
}

// Find PC for a label id
fn kirvm_find_label(label_id) {
    let mut i = 0;
    while i < kirvm_label_count {
        if kirvm_labels[i][0] == label_id {
            return kirvm_labels[i][1];
        }
        i = i + 1;
    }
    return 0 - 1;
}

// Safe register read (bounds check)
fn kirvm_reg_get(r) {
    if r < 0 { return 0; }
    if r >= KIRVM_MAX_REGS { return 0; }
    return kirvm_regs[r];
}

// Safe register write
fn kirvm_reg_set(r, val) {
    if r < 0 { return 0; }
    if r >= KIRVM_MAX_REGS { return 0; }
    set_at(kirvm_regs, r, val);
    return 0;
}

// Execute IR instructions starting from pc, return last value
fn kirvm_exec_from(start_pc) {
    let mut pc = start_pc;
    let mut step_count = 0;
    let max_steps = 100000;
    let mut result = 0;

    while pc < ir_count && step_count < max_steps {
        step_count = step_count + 1;

        // Skip dead instructions
        if ir_dead[pc] != 0 { pc = pc + 1; }
        else {
            let op = ir_op[pc];
            let dst = ir_dst[pc];
            let s1 = ir_src1[pc];
            let s2 = ir_src2[pc];

            if op == IR_CONST {
                kirvm_reg_set(dst, s1);
                pc = pc + 1;
            }
            else if op == IR_STR_CONST {
                kirvm_reg_set(dst, s1);
                pc = pc + 1;
            }
            else if op == IR_COPY {
                kirvm_reg_set(dst, kirvm_reg_get(s1));
                pc = pc + 1;
            }
            else if op == IR_ADD {
                let a = kirvm_reg_get(s1);
                let b = kirvm_reg_get(s2);
                kirvm_reg_set(dst, a + b);
                pc = pc + 1;
            }
            else if op == IR_SUB {
                kirvm_reg_set(dst, kirvm_reg_get(s1) - kirvm_reg_get(s2));
                pc = pc + 1;
            }
            else if op == IR_MUL {
                kirvm_reg_set(dst, kirvm_reg_get(s1) * kirvm_reg_get(s2));
                pc = pc + 1;
            }
            else if op == IR_DIV {
                let divisor = kirvm_reg_get(s2);
                if divisor != 0 { kirvm_reg_set(dst, kirvm_reg_get(s1) / divisor); }
                else { kirvm_reg_set(dst, 0); }
                pc = pc + 1;
            }
            else if op == IR_MOD {
                let divisor = kirvm_reg_get(s2);
                if divisor != 0 { kirvm_reg_set(dst, kirvm_reg_get(s1) % divisor); }
                else { kirvm_reg_set(dst, 0); }
                pc = pc + 1;
            }
            else if op == IR_NEG {
                kirvm_reg_set(dst, 0 - kirvm_reg_get(s1));
                pc = pc + 1;
            }
            else if op == IR_AND {
                kirvm_reg_set(dst, kirvm_reg_get(s1) & kirvm_reg_get(s2));
                pc = pc + 1;
            }
            else if op == IR_OR {
                kirvm_reg_set(dst, kirvm_reg_get(s1) | kirvm_reg_get(s2));
                pc = pc + 1;
            }
            else if op == IR_XOR {
                kirvm_reg_set(dst, kirvm_reg_get(s1) ^ kirvm_reg_get(s2));
                pc = pc + 1;
            }
            else if op == IR_SHL {
                kirvm_reg_set(dst, kirvm_reg_get(s1) << kirvm_reg_get(s2));
                pc = pc + 1;
            }
            else if op == IR_SHR {
                kirvm_reg_set(dst, kirvm_reg_get(s1) >> kirvm_reg_get(s2));
                pc = pc + 1;
            }
            else if op == IR_NOT {
                let v = kirvm_reg_get(s1);
                if v == 0 { kirvm_reg_set(dst, 1); }
                else { kirvm_reg_set(dst, 0); }
                pc = pc + 1;
            }
            else if op == IR_CMP_EQ {
                if kirvm_reg_get(s1) == kirvm_reg_get(s2) { kirvm_reg_set(dst, 1); }
                else { kirvm_reg_set(dst, 0); }
                pc = pc + 1;
            }
            else if op == IR_CMP_NE {
                if kirvm_reg_get(s1) != kirvm_reg_get(s2) { kirvm_reg_set(dst, 1); }
                else { kirvm_reg_set(dst, 0); }
                pc = pc + 1;
            }
            else if op == IR_CMP_LT {
                if kirvm_reg_get(s1) < kirvm_reg_get(s2) { kirvm_reg_set(dst, 1); }
                else { kirvm_reg_set(dst, 0); }
                pc = pc + 1;
            }
            else if op == IR_CMP_LE {
                if kirvm_reg_get(s1) <= kirvm_reg_get(s2) { kirvm_reg_set(dst, 1); }
                else { kirvm_reg_set(dst, 0); }
                pc = pc + 1;
            }
            else if op == IR_CMP_GT {
                if kirvm_reg_get(s1) > kirvm_reg_get(s2) { kirvm_reg_set(dst, 1); }
                else { kirvm_reg_set(dst, 0); }
                pc = pc + 1;
            }
            else if op == IR_CMP_GE {
                if kirvm_reg_get(s1) >= kirvm_reg_get(s2) { kirvm_reg_set(dst, 1); }
                else { kirvm_reg_set(dst, 0); }
                pc = pc + 1;
            }
            else if op == IR_JMP {
                let target = kirvm_find_label(dst);
                if target >= 0 { pc = target; }
                else { pc = pc + 1; }
            }
            else if op == IR_JZ {
                let cond_val = kirvm_reg_get(dst);
                if cond_val == 0 {
                    let target = kirvm_find_label(s1);
                    if target >= 0 { pc = target; }
                    else { pc = pc + 1; }
                } else { pc = pc + 1; }
            }
            else if op == IR_JNZ {
                let cond_val = kirvm_reg_get(dst);
                if cond_val != 0 {
                    let target = kirvm_find_label(s1);
                    if target >= 0 { pc = target; }
                    else { pc = pc + 1; }
                } else { pc = pc + 1; }
            }
            else if op == IR_LABEL {
                pc = pc + 1;
            }
            else if op == IR_ARG {
                // ARG n, src: store argument for upcoming CALL
                // In our simple VM, arguments are just register copies
                pc = pc + 1;
            }
            else if op == IR_CALL {
                // CALL dst, label, argc
                let fn_pc = kirvm_find_label(s1);
                if fn_pc >= 0 {
                    if kirvm_call_depth < KIRVM_MAX_CALL_DEPTH {
                        push(kirvm_call_stack, pc + 1);
                        kirvm_call_depth = kirvm_call_depth + 1;
                        pc = fn_pc;
                    } else {
                        kirvm_reg_set(dst, 0);
                        pc = pc + 1;
                    }
                } else {
                    // External/builtin call — return 0
                    kirvm_reg_set(dst, 0);
                    pc = pc + 1;
                }
            }
            else if op == IR_RET {
                result = kirvm_reg_get(dst);
                if kirvm_call_depth > 0 {
                    kirvm_call_depth = kirvm_call_depth - 1;
                    pc = kirvm_call_stack[kirvm_call_depth];
                } else {
                    // Top-level return — exit
                    return result;
                }
            }
            else if op == IR_PRINT {
                let val = kirvm_reg_get(dst);
                print(to_string(val));
                pc = pc + 1;
            }
            else if op == IR_NOP {
                pc = pc + 1;
            }
            else if op == IR_LOAD {
                // Simplified: treat as array access
                pc = pc + 1;
            }
            else if op == IR_STORE {
                pc = pc + 1;
            }
            else {
                // Unknown opcode — skip
                pc = pc + 1;
            }
        }
    }
    return result;
}

// Full IR VM execution pipeline: lex → parse → IR lower → IR optimize → VM execute
fn kinterp_exec_ir(source) {
    // Reset IR state
    ir_init();
    ir_lower_reset();

    // Lex
    ki_tok_count = 0;
    ki_tok_idx = 0;
    ki_var_count = 0;
    ki_fn_count = 0;
    ki_depth = 0;
    let tok_count = ki_lex(source);

    // Parse to AST (reuse kinterp lexer, build minimal AST)
    // For the IR path, we use ir.hl's AST lowering which expects
    // AST node arrays in the format: ["NodeType", ...]
    // We build a simple AST from tokens for the IR path
    ki_tok_idx = 0;
    let ast = _kirvm_parse_program();

    // Lower AST → IR
    ir_lower_stmts(ast);

    // Optimize IR
    ir_optimize();

    // Initialize VM and execute
    kirvm_init();
    kirvm_scan_labels();
    let result = kirvm_exec_from(0);
    return result;
}

// Minimal parser for IR path: produces AST nodes compatible with ir_lower_*
fn _kirvm_parse_program() {
    let mut stmts = [];
    while ki_peek_type() != TOK_EOF {
        let s = _kirvm_parse_stmt();
        if s != nil { push(stmts, s); }
    }
    return stmts;
}

fn _kirvm_parse_stmt() {
    let tt = ki_peek_type();
    let tv = ki_peek_val();

    // let [mut] name = expr;
    if tt == TOK_KW && tv == "let" {
        ki_advance();
        let mut is_mut = 0;
        if ki_peek_val() == "mut" { is_mut = 1; ki_advance(); }
        let name = ki_peek_val();
        ki_advance();
        let init = nil;
        if ki_peek_val() == "=" {
            ki_advance();
            init = _kirvm_parse_expr();
        }
        if ki_peek_val() == ";" { ki_advance(); }
        return ["Let", name, is_mut, init];
    }

    // fn name(params) { body }
    if tt == TOK_KW && tv == "fn" {
        ki_advance();
        let name = ki_peek_val();
        ki_advance();
        ki_expect_val("(");
        let params = [];
        while ki_peek_type() != TOK_RPAREN && ki_peek_type() != TOK_EOF {
            if ki_peek_type() == TOK_IDENT { push(params, ki_peek_val()); }
            ki_advance();
            if ki_peek_val() == "," { ki_advance(); }
        }
        ki_expect_val(")");
        ki_expect_val("{");
        let body = [];
        while ki_peek_type() != TOK_RBRACE && ki_peek_type() != TOK_EOF {
            let s = _kirvm_parse_stmt();
            if s != nil { push(body, s); }
        }
        if ki_peek_val() == "}" { ki_advance(); }
        return ["FnDef", name, params, body];
    }

    // return expr;
    if tt == TOK_KW && tv == "return" {
        ki_advance();
        let val = nil;
        if ki_peek_type() != TOK_SEMI && ki_peek_type() != TOK_RBRACE && ki_peek_type() != TOK_EOF {
            val = _kirvm_parse_expr();
        }
        if ki_peek_val() == ";" { ki_advance(); }
        return ["Return", val];
    }

    // if cond { body } [else { body }]
    if tt == TOK_KW && tv == "if" {
        ki_advance();
        let cond = _kirvm_parse_expr();
        ki_expect_val("{");
        let then_body = [];
        while ki_peek_type() != TOK_RBRACE && ki_peek_type() != TOK_EOF {
            let s = _kirvm_parse_stmt();
            if s != nil { push(then_body, s); }
        }
        if ki_peek_val() == "}" { ki_advance(); }
        let else_body = nil;
        if ki_peek_val() == "else" {
            ki_advance();
            ki_expect_val("{");
            else_body = [];
            while ki_peek_type() != TOK_RBRACE && ki_peek_type() != TOK_EOF {
                let s = _kirvm_parse_stmt();
                if s != nil { push(else_body, s); }
            }
            if ki_peek_val() == "}" { ki_advance(); }
        }
        return ["If", cond, then_body, else_body];
    }

    // while cond { body }
    if tt == TOK_KW && tv == "while" {
        ki_advance();
        let cond = _kirvm_parse_expr();
        ki_expect_val("{");
        let body = [];
        while ki_peek_type() != TOK_RBRACE && ki_peek_type() != TOK_EOF {
            let s = _kirvm_parse_stmt();
            if s != nil { push(body, s); }
        }
        if ki_peek_val() == "}" { ki_advance(); }
        return ["While", cond, body];
    }

    // print(expr);
    if tt == TOK_KW && tv == "print" {
        // Treat as statement: print(expr)
        ki_advance();
        return nil;
    }
    if tt == TOK_IDENT && tv == "print" {
        ki_advance();
        if ki_peek_type() == TOK_LPAREN {
            ki_advance();
            let val = _kirvm_parse_expr();
            ki_expect_val(")");
            if ki_peek_val() == ";" { ki_advance(); }
            return ["Print", val];
        }
    }

    // Assignment or expression statement
    if tt == TOK_IDENT {
        let name = tv;
        ki_advance();
        if ki_peek_val() == "=" {
            ki_advance();
            let val = _kirvm_parse_expr();
            if ki_peek_val() == ";" { ki_advance(); }
            return ["Assign", name, val];
        }
        // Function call as statement
        if ki_peek_type() == TOK_LPAREN {
            ki_tok_idx = ki_tok_idx - 1;
            let expr = _kirvm_parse_expr();
            if ki_peek_val() == ";" { ki_advance(); }
            return ["ExprStmt", expr];
        }
        return nil;
    }

    // Skip unrecognized
    ki_advance();
    return nil;
}

// Expression parser for IR path: produces AST nodes
fn _kirvm_parse_expr() { return _kirvm_parse_or(); }

fn _kirvm_parse_or() {
    let mut left = _kirvm_parse_and();
    while ki_peek_val() == "||" {
        ki_advance();
        let right = _kirvm_parse_and();
        left = ["BinOp", "||", left, right];
    }
    return left;
}

fn _kirvm_parse_and() {
    let mut left = _kirvm_parse_eq();
    while ki_peek_val() == "&&" {
        ki_advance();
        let right = _kirvm_parse_eq();
        left = ["BinOp", "&&", left, right];
    }
    return left;
}

fn _kirvm_parse_eq() {
    let mut left = _kirvm_parse_cmp();
    while ki_peek_val() == "==" || ki_peek_val() == "!=" {
        let op = ki_peek_val();
        ki_advance();
        let right = _kirvm_parse_cmp();
        left = ["BinOp", op, left, right];
    }
    return left;
}

fn _kirvm_parse_cmp() {
    let mut left = _kirvm_parse_add();
    while ki_peek_val() == "<" || ki_peek_val() == ">" || ki_peek_val() == "<=" || ki_peek_val() == ">=" {
        let op = ki_peek_val();
        ki_advance();
        let right = _kirvm_parse_add();
        left = ["BinOp", op, left, right];
    }
    return left;
}

fn _kirvm_parse_add() {
    let mut left = _kirvm_parse_mul();
    while ki_peek_val() == "+" || ki_peek_val() == "-" {
        let op = ki_peek_val();
        ki_advance();
        let right = _kirvm_parse_mul();
        left = ["BinOp", op, left, right];
    }
    return left;
}

fn _kirvm_parse_mul() {
    let mut left = _kirvm_parse_unary();
    while ki_peek_val() == "*" || ki_peek_val() == "/" || ki_peek_val() == "%" {
        let op = ki_peek_val();
        ki_advance();
        let right = _kirvm_parse_unary();
        left = ["BinOp", op, left, right];
    }
    return left;
}

fn _kirvm_parse_unary() {
    if ki_peek_val() == "-" {
        ki_advance();
        let inner = _kirvm_parse_primary();
        return ["Unary", "-", inner];
    }
    return _kirvm_parse_primary();
}

fn _kirvm_parse_primary() {
    let tt = ki_peek_type();
    let tv = ki_peek_val();

    if tt == TOK_NUM {
        ki_advance();
        return ["Num", parse_int(tv)];
    }
    if tt == TOK_STR {
        ki_advance();
        return ["Str", tv];
    }
    if tt == TOK_KW && tv == "true" { ki_advance(); return ["Bool", true]; }
    if tt == TOK_KW && tv == "false" { ki_advance(); return ["Bool", false]; }
    if tt == TOK_KW && tv == "nil" { ki_advance(); return ["Nil"]; }
    if tt == TOK_LPAREN {
        ki_advance();
        let val = _kirvm_parse_expr();
        ki_expect_val(")");
        return val;
    }
    if tt == TOK_LBRACK {
        ki_advance();
        let elems = [];
        while ki_peek_type() != TOK_RBRACK && ki_peek_type() != TOK_EOF {
            push(elems, _kirvm_parse_expr());
            if ki_peek_val() == "," { ki_advance(); }
        }
        ki_expect_val("]");
        return ["Array", elems];
    }
    if tt == TOK_IDENT {
        let name = tv;
        ki_advance();
        // Function call
        if ki_peek_type() == TOK_LPAREN {
            ki_advance();
            let args = [];
            while ki_peek_type() != TOK_RPAREN && ki_peek_type() != TOK_EOF {
                push(args, _kirvm_parse_expr());
                if ki_peek_val() == "," { ki_advance(); }
            }
            ki_expect_val(")");
            return ["Call", ["Var", name], args];
        }
        return ["Var", name];
    }
    ki_advance();
    return ["Nil"];
}

// Self-test for IR VM path
fn _kirvm_test() {
    print("kirvm: IR VM self-test...");
    let r = kinterp_exec_ir("let x = 3 + 4 * 5; let y = x - 1;");
    print("kirvm: result = " + to_string(r));
    print("kirvm: IR VM self-test complete");
    return r;
}

print("kinterp.hl loaded: tree-walk + IR VM dual execution engine");
