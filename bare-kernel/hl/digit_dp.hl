// digit_dp.hl -- Digit DP: count integers in [0,N] with digit sum = target (iter 353)
// Buffer: 0x1980000
// State: dp[sum][tight] processed layer-by-layer through decimal digits of N
// ddm_solve(n, target): count in [0..n] with digit-sum = target
// Test: [0..20] with sum=2 -> {2,11,20} -> 3

let DDM_MAXD = 8;   // max decimal digits
let DDM_MAXS = 36;  // max tracked digit sum (clamp larger values to 0 contribution)

// dp index = sum*2 + tight; tight in {0,1}; size = (DDM_MAXS+1)*2 = 74
let ddm_cur  = array(74, 0);
let ddm_nxt  = array(74, 0);
let ddm_lim  = array(8, 0);    // digit limits of current n, MSB first
let mut ddm_nd   = 0;              // number of digits extracted

fn ddm_init() {
    let mut i = 0;
    while i < 74 { set_at(ddm_cur, i, 0); set_at(ddm_nxt, i, 0); i += 1; }
    return 0;
}

fn _ddm_extract(n) {
    let mut tmp = array(8, 0);
    let mut pos = 0;
    let mut v = n;
    if v == 0 { set_at(ddm_lim, 0, 0); ddm_nd = 1; return 0; }
    let mut go = 1;
    while go == 1 {
        if v == 0 { go = 0; }
        if go == 1 {
            set_at(tmp, pos, v - (v / 10) * 10);
            pos += 1;
            v = v / 10;
        }
    }
    ddm_nd = pos;
    let mut i = 0;
    while i < pos { set_at(ddm_lim, i, tmp[pos - 1 - i]); i += 1; }
    return 0;
}

fn ddm_solve(n, target) {
    ddm_init();
    _ddm_extract(n);
    // Initial: no digits consumed, sum=0, tight=1
    set_at(ddm_cur, 0 * 2 + 1, 1);
    let mut pos = 0;
    while pos < ddm_nd {
        let mut ci = 0;
        while ci < 74 { set_at(ddm_nxt, ci, 0); ci += 1; }
        let mut s = 0;
        while s <= DDM_MAXS {
            let mut t = 0;
            while t <= 1 {
                let mut cnt = ddm_cur[s * 2 + t];
                if cnt > 0 {
                    let mut d = 0;
                    while d <= 9 {
                        let mut dlim = 9;
                        if t == 1 { dlim = ddm_lim[pos]; }
                        if d <= dlim {
                            let mut ns = s + d;
                            if ns <= DDM_MAXS {
                                let mut nt = 0;
                                if t == 1 { if d == ddm_lim[pos] { nt = 1; } }
                                let mut idx = ns * 2 + nt;
                                set_at(ddm_nxt, idx, ddm_nxt[idx] + cnt);
                            }
                        }
                        d += 1;
                    }
                }
                t += 1;
            }
            s += 1;
        }
        let mut ci2 = 0;
        while ci2 < 74 { set_at(ddm_cur, ci2, ddm_nxt[ci2]); ci2 += 1; }
        pos += 1;
    }
    if target > DDM_MAXS { return 0; }
    return ddm_cur[target * 2 + 0] + ddm_cur[target * 2 + 1];
}

fn ddm_test() {
    // Integers in [0..20] with digit sum = 2: {2, 11, 20} -> 3
    let mut ans = ddm_solve(20, 2);
    print("ddm_test: [0..20] sum=2: " + to_string(ans));
    if ans == 3 {
        print("ddm_test: PASS");
        return 1;
    }
    print("ddm_test: FAIL");
    return 0;
}

print("digit_dp.hl loaded");
