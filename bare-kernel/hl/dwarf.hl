// dwarf.hl -- DWARF debug info generation: line number table + variable locations (iter 373)
// Buffer: 0x1AC0000
// DWARF_MAXLINES=64 line table entries, DWARF_MAXVARS=32 variable location entries
// Line number state machine: address/file/line/col/is_stmt
// Variable locations: DW_OP_fbreg(offset) for stack vars, DW_OP_reg(n) for reg vars
// Sections: .debug_line (header + line ops), .debug_info (DIEs), .debug_abbrev

let DWARF_MAXLINES = 64;
let DWARF_MAXVARS  = 32;
let DWARF_MAXFILES = 8;

// Line table entries
let dw_lt_addr  = array(64, 0);   // code address
let dw_lt_file  = array(64, 0);   // file index
let dw_lt_line  = array(64, 0);   // line number (1-based)
let dw_lt_col   = array(64, 0);   // column (0=unknown)
let dw_lt_stmt  = array(64, 0);   // is_stmt flag
let dw_lt_n     = 0;

// Variable location entries
let dw_vl_name  = array(32, 0);   // name id
let dw_vl_type  = array(32, 0);   // type: 0=int,1=bool,2=ptr
let dw_vl_loc   = array(32, 0);   // location kind: 0=fbreg,1=reg
let dw_vl_off   = array(32, 0);   // fbreg offset or reg number
let dw_vl_func  = array(32, 0);   // enclosing function id
let dw_vl_n     = 0;

// File table
let dw_file_name = array(8, 0);   // file name id
let dw_file_dir  = array(8, 0);   // directory id
let dw_file_n    = 0;

// DWARF opcodes (standard)
let DW_LNS_COPY          = 1;
let DW_LNS_ADVANCE_PC    = 2;
let DW_LNS_ADVANCE_LINE  = 3;
let DW_LNS_SET_FILE      = 4;
let DW_LNS_SET_COLUMN    = 5;
let DW_LNS_NEGATE_STMT   = 6;

// DW_OP location ops
let DW_OP_FBREG = 0x77;
let DW_OP_REG0  = 0x50;   // DW_OP_reg0..reg15

// Line number state machine registers
let dw_sm_addr  = 0;
let dw_sm_file  = 1;
let dw_sm_line  = 1;
let dw_sm_col   = 0;
let dw_sm_stmt  = 1;

// Output byte stream (simulated .debug_line section)
let dw_out     = array(512, 0);
let dw_out_n   = 0;

fn dw_init() {
    dw_lt_n    = 0;
    dw_vl_n    = 0;
    dw_file_n  = 0;
    dw_out_n   = 0;
    dw_sm_addr = 0;
    dw_sm_file = 1;
    dw_sm_line = 1;
    dw_sm_col  = 0;
    dw_sm_stmt = 1;
    return 0;
}

fn dw_add_file(name_id, dir_id) {
    let id = dw_file_n;
    set_at(dw_file_name, id, name_id);
    set_at(dw_file_dir,  id, dir_id);
    dw_file_n += 1;
    return id + 1;   // DWARF file indices are 1-based
}

fn dw_add_line(addr, file, line, col, is_stmt) {
    let id = dw_lt_n;
    set_at(dw_lt_addr, id, addr);
    set_at(dw_lt_file, id, file);
    set_at(dw_lt_line, id, line);
    set_at(dw_lt_col,  id, col);
    set_at(dw_lt_stmt, id, is_stmt);
    dw_lt_n += 1;
    return id;
}

fn dw_add_var(name_id, type_id, loc_kind, offset, func_id) {
    let id = dw_vl_n;
    set_at(dw_vl_name, id, name_id);
    set_at(dw_vl_type, id, type_id);
    set_at(dw_vl_loc,  id, loc_kind);
    set_at(dw_vl_off,  id, offset);
    set_at(dw_vl_func, id, func_id);
    dw_vl_n += 1;
    return id;
}

fn _dw_emit_byte(b) {
    set_at(dw_out, dw_out_n, b);
    dw_out_n += 1;
    return 0;
}

fn _dw_emit_uleb128(v) {
    // Encode unsigned LEB128 (7 bits per byte, MSB=1 if more)
    let mut go = 1;
    while go == 1 {
        let byte_val = v - (v / 128) * 128;   // v % 128
        v = v / 128;
        if v != 0 {
            _dw_emit_byte(byte_val + 128);     // more bytes follow
        } else {
            _dw_emit_byte(byte_val);
            go = 0;
        }
    }
    return 0;
}

fn _dw_emit_sleb128(v) {
    // Encode signed LEB128; handle negative via two's complement simulation
    let mut go = 1;
    let neg = 0;
    if v < 0 { neg = 1; }
    while go == 1 {
        let byte_val = v - (v / 128) * 128;
        if byte_val < 0 { byte_val = byte_val + 128; }
        v = v / 128;
        // Check if done: positive v==0 and sign bit clear, or neg v==-1 and sign set
        let sign_bit = (byte_val / 64) - (byte_val / 64 / 2) * 2;
        let more = 1;
        if v == 0 {
            if neg == 0 {
                if sign_bit == 0 { more = 0; }
            }
        }
        if v == 0 - 1 {
            if neg == 1 {
                if sign_bit == 1 { more = 0; }
            }
        }
        if more == 1 {
            _dw_emit_byte(byte_val + 128);
        } else {
            _dw_emit_byte(byte_val);
            go = 0;
        }
    }
    return 0;
}

fn dw_emit_line_table() {
    // Emit line number program for all recorded entries
    // Minimal line program header fields emitted as bytes
    // header_length, min_instr_len=1, default_is_stmt=1, line_base=1, line_range=2, opcode_base=13
    _dw_emit_byte(1);    // min_instruction_length
    _dw_emit_byte(1);    // default_is_stmt
    _dw_emit_byte(1);    // line_base
    _dw_emit_byte(2);    // line_range
    _dw_emit_byte(13);   // opcode_base (standard opcodes 1..12)

    // Reset state machine
    dw_sm_addr = 0;
    dw_sm_file = 1;
    dw_sm_line = 1;
    dw_sm_col  = 0;
    dw_sm_stmt = 1;

    let mut i = 0;
    while i < dw_lt_n {
        let tgt_addr = dw_lt_addr[i];
        let tgt_file = dw_lt_file[i];
        let tgt_line = dw_lt_line[i];
        let tgt_col  = dw_lt_col[i];

        // DW_LNS_SET_FILE if needed
        if tgt_file != dw_sm_file {
            _dw_emit_byte(DW_LNS_SET_FILE);
            _dw_emit_uleb128(tgt_file);
            dw_sm_file = tgt_file;
        }

        // DW_LNS_SET_COLUMN if needed
        if tgt_col != dw_sm_col {
            _dw_emit_byte(DW_LNS_SET_COLUMN);
            _dw_emit_uleb128(tgt_col);
            dw_sm_col = tgt_col;
        }

        // DW_LNS_ADVANCE_PC
        let pc_delta = tgt_addr - dw_sm_addr;
        if pc_delta != 0 {
            _dw_emit_byte(DW_LNS_ADVANCE_PC);
            _dw_emit_uleb128(pc_delta);
            dw_sm_addr = tgt_addr;
        }

        // DW_LNS_ADVANCE_LINE
        let line_delta = tgt_line - dw_sm_line;
        if line_delta != 0 {
            _dw_emit_byte(DW_LNS_ADVANCE_LINE);
            _dw_emit_sleb128(line_delta);
            dw_sm_line = tgt_line;
        }

        // DW_LNS_COPY: emit row
        _dw_emit_byte(DW_LNS_COPY);

        i += 1;
    }

    // DW_LNE_END_SEQUENCE (extended opcode)
    _dw_emit_byte(0);    // extended opcode escape
    _dw_emit_uleb128(1); // length=1
    _dw_emit_byte(1);    // DW_LNE_end_sequence

    return dw_out_n;
}

fn dw_var_count()  { return dw_vl_n; }
fn dw_line_count() { return dw_lt_n; }
fn dw_out_size()   { return dw_out_n; }

fn dw_test() {
    // Add file, record 3 line table entries, emit, check byte stream length
    // Add 2 vars: x at fbreg-8, y in reg rax=0
    dw_init();
    let f1 = dw_add_file(100, 10);   // file index 1
    dw_add_line(0x1000, f1, 10, 0, 1);
    dw_add_line(0x1008, f1, 11, 0, 1);
    dw_add_line(0x1020, f1, 15, 4, 1);
    dw_add_var(200, 0, 0, 0-8, 0);   // x: int, fbreg-8, func0
    dw_add_var(201, 0, 1, 0,   0);   // y: int, reg0 (rax), func0
    let mut sz = dw_emit_line_table();
    print("dw_test: lines=" + to_string(dw_lt_n) + " vars=" + to_string(dw_vl_n));
    print("dw_test: debug_line_bytes=" + to_string(sz));
    // Expect: header(5) + entries + END(3) > 20 bytes
    if sz > 20 {
        if dw_lt_n == 3 {
            if dw_vl_n == 2 {
                print("dw_test: PASS");
                return 1;
            }
        }
    }
    print("dw_test: FAIL");
    return 0;
}

print("dwarf.hl loaded");
