// a11y.hl -- 辅助功能（Sprint G8）
//
// 三大能力：
//   1. 高对比度主题（黑底白字 + 黄色焦点环）
//   2. 字体放大（120%/140%/160%）
//   3. 屏幕阅读器队列：把可读文本推入环形缓冲，可被语音合成或 hap 设备
//      消费。目前仅累积，不发音；为 G9+ 留接口。
//
// 全局开关由 ControlCenter 的 EyeCare 旁边新增按钮触发，亦可程序调用。

let A11Y_FONT_NORMAL = 100;
let A11Y_FONT_120    = 120;
let A11Y_FONT_140    = 140;
let A11Y_FONT_160    = 160;

let A11Y_READ_BUF_ADDR = 73728512;   // 0x04650000
let A11Y_READ_BUF_SIZE = 4096;

let mut a11y_initialized       = 0;
let mut a11y_high_contrast     = 0;
let mut a11y_font_scale        = 100;
let mut a11y_screen_reader_on  = 0;
let mut a11y_read_write_pos    = 0;
let mut a11y_read_read_pos     = 0;

fn a11y_init() {
    if a11y_initialized == 1 { return 0; }
    a11y_high_contrast = 0;
    a11y_font_scale = A11Y_FONT_NORMAL;
    a11y_screen_reader_on = 0;
    a11y_read_write_pos = 0;
    a11y_read_read_pos  = 0;
    mem_write_u8(A11Y_READ_BUF_ADDR, 0);
    a11y_initialized = 1;
    print("a11y: high-contrast / font scale / screen reader ready");
    return 0;
}

fn a11y_high_contrast_set(on) {
    a11y_high_contrast = on;
    if on == 1 {
        // 切换到高对比度主题：UI tokens 强制黑底白字
        ui_theme_set_accent(gfx_pack(255, 255, 220, 0));   // 黄色焦点
    }
    return 0;
}

fn a11y_high_contrast_get() { return a11y_high_contrast; }

fn a11y_font_scale_set(pct) {
    if pct < 100 { pct = 100; }
    if pct > 200 { pct = 200; }
    a11y_font_scale = pct;
    return 0;
}

fn a11y_font_scale_get() { return a11y_font_scale; }

// 缩放 logical font 大小
fn a11y_font_apply(logical) {
    return logical * a11y_font_scale / 100;
}

fn a11y_screen_reader_set(on) { a11y_screen_reader_on = on; return 0; }
fn a11y_screen_reader_get()   { return a11y_screen_reader_on; }

// 把 cstring 推入屏幕阅读器队列
fn a11y_speak(msg_addr) {
    if a11y_initialized == 0 { a11y_init(); }
    if a11y_screen_reader_on == 0 { return 0; }
    if msg_addr == 0 { return 0; }
    let mut i = 0;
    let mut c = mem_read_u8(msg_addr);
    while c != 0 {
        if i >= 511 { c = 0; }
        else {
            mem_write_u8(A11Y_READ_BUF_ADDR + a11y_read_write_pos, c);
            a11y_read_write_pos = a11y_read_write_pos + 1;
            if a11y_read_write_pos >= A11Y_READ_BUF_SIZE {
                a11y_read_write_pos = 0;
            }
            i = i + 1;
            c = mem_read_u8(msg_addr + i);
        }
    }
    // 分隔符
    mem_write_u8(A11Y_READ_BUF_ADDR + a11y_read_write_pos, 10);
    a11y_read_write_pos = a11y_read_write_pos + 1;
    if a11y_read_write_pos >= A11Y_READ_BUF_SIZE { a11y_read_write_pos = 0; }
    return 0;
}

// 消费一条；返回起始地址 (0 = 队列空)
fn a11y_drain_one() {
    if a11y_read_read_pos == a11y_read_write_pos { return 0; }
    let mut start = A11Y_READ_BUF_ADDR + a11y_read_read_pos;
    while a11y_read_read_pos != a11y_read_write_pos {
        let mut c = mem_read_u8(A11Y_READ_BUF_ADDR + a11y_read_read_pos);
        a11y_read_read_pos = a11y_read_read_pos + 1;
        if a11y_read_read_pos >= A11Y_READ_BUF_SIZE { a11y_read_read_pos = 0; }
        if c == 10 { return start; }
    }
    return start;
}

print("a11y.hl loaded");
