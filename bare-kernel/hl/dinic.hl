// dinic.hl -- Dinic Max-Flow O(V²E) (iter 346)
// Buffer: 0x1910000
// DI_V=8 vertices, DI_E=128 edge slots (forward+reverse pairs).
// di_add_edge(u,v,cap): directed edge. di_max_flow(s,t): return max flow.
// BFS layered graph; DFS blocking flow with current-arc optimization.

let mut DI_V    = 8;
let mut DI_E    = 128;
let di_head  = array(8,   255);
let di_to    = array(128, 0);
let di_cap   = array(128, 0);
let di_nxt   = array(128, 255);
let di_level = array(8,   255);
let di_iter  = array(8,   255);
let di_bq    = array(8,   0);
let mut di_ecnt  = 0;

fn di_init() {
    let mut i = 0;
    while i < DI_V {
        set_at(di_head,  i, 255);
        set_at(di_level, i, 255);
        set_at(di_iter,  i, 255);
        i += 1;
    }
    i = 0;
    while i < DI_E {
        set_at(di_to,  i, 0);
        set_at(di_cap, i, 0);
        set_at(di_nxt, i, 255);
        i += 1;
    }
    di_ecnt = 0;
    return 0;
}

fn _di_rev(e) {
    let mut em2 = e - (e / 2) * 2;
    if em2 == 0 { return e + 1; }
    return e - 1;
}

fn di_add_edge(u, v, cap) {
    set_at(di_to,  di_ecnt, v);
    set_at(di_cap, di_ecnt, cap);
    set_at(di_nxt, di_ecnt, di_head[u]);
    set_at(di_head, u, di_ecnt);
    di_ecnt += 1;
    set_at(di_to,  di_ecnt, u);
    set_at(di_cap, di_ecnt, 0);
    set_at(di_nxt, di_ecnt, di_head[v]);
    set_at(di_head, v, di_ecnt);
    di_ecnt += 1;
    return di_ecnt;
}

fn _di_bfs(s, t) {
    let mut i = 0;
    while i < DI_V { set_at(di_level, i, 255); i += 1; }
    set_at(di_level, s, 0);
    let mut bh = 0;
    let mut bt = 0;
    set_at(di_bq, bt, s); bt += 1;
    while bh < bt {
        let mut u = di_bq[bh]; bh += 1;
        let mut e = di_head[u];
        while e != 255 {
            let mut v = di_to[e];
            if di_level[v] == 255 {
                if di_cap[e] > 0 {
                    set_at(di_level, v, di_level[u] + 1);
                    set_at(di_bq, bt, v); bt += 1;
                }
            }
            e = di_nxt[e];
        }
    }
    if di_level[t] == 255 { return 0; }
    return 1;
}

fn _di_dfs(u, t, pushed) {
    if u == t { return pushed; }
    let mut res = 0;
    let mut go = 1;
    while go == 1 {
        let mut e = di_iter[u];
        if e == 255 { go = 0; }
        if go == 1 {
            let mut v = di_to[e];
            if di_level[v] == di_level[u] + 1 {
                if di_cap[e] > 0 {
                    let mut mn = pushed;
                    if di_cap[e] < mn { mn = di_cap[e]; }
                    let mut d = _di_dfs(v, t, mn);
                    if d > 0 {
                        let mut re = _di_rev(e);
                        set_at(di_cap, e,  di_cap[e]  - d);
                        set_at(di_cap, re, di_cap[re] + d);
                        res = d;
                        go = 0;
                    }
                }
            }
            if go == 1 { set_at(di_iter, u, di_nxt[e]); }
        }
    }
    return res;
}

fn di_max_flow(s, t) {
    let mut flow = 0;
    let mut go = 1;
    while go == 1 {
        if _di_bfs(s, t) == 0 { go = 0; }
        if go == 1 {
            let mut i = 0;
            while i < DI_V { set_at(di_iter, i, di_head[i]); i += 1; }
            let mut go2 = 1;
            while go2 == 1 {
                let mut d = _di_dfs(s, t, 1000000);
                if d == 0 { go2 = 0; }
                if go2 == 1 { flow += d; }
            }
        }
    }
    return flow;
}

fn di_test() {
    di_init();
    // S=0 T=3; 0->1(10) 0->2(10) 1->3(10) 2->3(10); expected max flow = 20
    di_add_edge(0, 1, 10);
    di_add_edge(0, 2, 10);
    di_add_edge(1, 3, 10);
    di_add_edge(2, 3, 10);
    let mut f = di_max_flow(0, 3);
    print("di_test: flow=" + to_string(f));
    if f == 20 {
        print("di_test: PASS");
        return 1;
    }
    print("di_test: FAIL");
    return 0;
}

print("dinic.hl loaded");
