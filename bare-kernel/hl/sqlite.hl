// sqlite.hl -- Embedded In-Memory Database
//
// Iteration 169: Lightweight relational table store with SQL-like API.
//
// Storage model:
//   Up to DB_MAX_TABLES (8) tables.
//   Each table: name string, schema string (tab-separated column names),
//               data string (newline-separated tab-separated rows).
//   All strings; numeric comparisons done via parse_int.
//
// Row format:  col0 \t col1 \t col2 \n
// Schema fmt:  col0 \t col1 \t col2
//
// Supports:
//   CREATE TABLE, INSERT, SELECT * / WHERE col=val,
//   DELETE WHERE, UPDATE WHERE (single column), DROP TABLE.
//
// Public API:
//   db_init()
//   db_create(name, schema)              → table_id  (schema = "col1\tcol2...")
//   db_drop(id)
//   db_insert(id, row)                   → row_index (row = "v1\tv2...")
//   db_select_all(id)                    → formatted table string
//   db_select_where(id, col, val)        → matching rows string
//   db_delete_where(id, col, val)        → deleted count
//   db_update_where(id, wcol, wval, scol, sval)  → updated count
//   db_count(id)                         → row count
//   db_schema(id)                        → column list string
//   db_list()                            → all table names

let DB_MAX_TABLES = 8;
let DB_TAB        = 9;    // ASCII TAB
let DB_TAB_STR    = "\t";
let DB_NL_STR     = "\n";

// Parallel table-state arrays
let mut db_active  = [];
let mut db_names   = [];
let mut db_schemas = [];   // tab-separated column name string
let mut db_data    = [];   // newline-separated rows (each row tab-separated)
let mut db_counts  = [];   // row count
let mut db_total   = 0;

fn db_init() {
    db_active  = [];
    db_names   = [];
    db_schemas = [];
    db_data    = [];
    db_counts  = [];
    db_total   = 0;
    let mut i = 0;
    while i < DB_MAX_TABLES {
        push(db_active,  0);
        push(db_names,   "");
        push(db_schemas, "");
        push(db_data,    "");
        push(db_counts,  0);
        i = i + 1;
    }
    print("sqlite: init — " + to_string(DB_MAX_TABLES) + " table slots");
    return 0;
}

fn _db_alloc() {
    let mut i = 0;
    while i < DB_MAX_TABLES {
        if db_active[i] == 0 { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

fn _db_find(name) {
    let mut i = 0;
    while i < DB_MAX_TABLES {
        if db_active[i] == 1 {
            if db_names[i] == name { return i; }
        }
        i = i + 1;
    }
    return 0 - 1;
}

// ============================================================
// String split helpers
// ============================================================

// Split string s on delimiter delim; returns HL array of substrings
fn _db_split(s, delim) {
    let mut parts = [];
    let n = len(s);
    let dl = len(delim);
    let mut start = 0;
    let mut go = 1;
    while go == 1 {
        let pos = str_find_from(s, delim, start);
        if pos < 0 {
            push(parts, str_sub(s, start, n));
            go = 0;
        } else {
            push(parts, str_sub(s, start, pos));
            start = pos + dl;
        }
    }
    return parts;
}

// Find index of col_name in tab-separated schema string
fn _db_col_idx(schema, col_name) {
    let cols = _db_split(schema, DB_TAB_STR);
    let mut i = 0;
    while i < len(cols) {
        if cols[i] == col_name { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

// Get value at column index from a tab-separated row string
fn _db_row_val(row, col_idx) {
    let cols = _db_split(row, DB_TAB_STR);
    if col_idx < 0 { return ""; }
    if col_idx >= len(cols) { return ""; }
    return cols[col_idx];
}

// ============================================================
// Table management
// ============================================================

fn db_create(name, schema) {
    if _db_find(name) >= 0 { return 0 - 1; }   // already exists
    let id = _db_alloc();
    if id < 0 { print("sqlite: table limit reached"); return 0 - 1; }
    set_at(db_active,  id, 1);
    set_at(db_names,   id, name);
    set_at(db_schemas, id, schema);
    set_at(db_data,    id, "");
    set_at(db_counts,  id, 0);
    db_total = db_total + 1;
    print("sqlite: CREATE TABLE " + name + " (" + schema + ")");
    return id;
}

fn db_drop(id) {
    if id < 0 { return 0; }
    if id >= DB_MAX_TABLES { return 0; }
    if db_active[id] == 0 { return 0; }
    print("sqlite: DROP TABLE " + db_names[id]);
    set_at(db_active, id, 0);
    set_at(db_data,   id, "");
    set_at(db_counts, id, 0);
    db_total = db_total - 1;
    return 0;
}

// ============================================================
// DML
// ============================================================

fn db_insert(id, row) {
    if id < 0 { return 0 - 1; }
    if db_active[id] == 0 { return 0 - 1; }
    let prev = db_data[id];
    if len(prev) == 0 {
        set_at(db_data, id, row);
    } else {
        set_at(db_data, id, prev + DB_NL_STR + row);
    }
    set_at(db_counts, id, db_counts[id] + 1);
    return db_counts[id] - 1;
}

fn db_count(id) {
    if id < 0 { return 0; }
    if db_active[id] == 0 { return 0; }
    return db_counts[id];
}

fn db_delete_where(id, col_name, val) {
    if id < 0 { return 0; }
    if db_active[id] == 0 { return 0; }
    let col_idx = _db_col_idx(db_schemas[id], col_name);
    if col_idx < 0 { return 0; }
    let rows = _db_split(db_data[id], DB_NL_STR);
    let mut new_data = "";
    let mut del_cnt  = 0;
    let mut i = 0;
    while i < len(rows) {
        let r = rows[i];
        if len(r) > 0 {
            if _db_row_val(r, col_idx) == val {
                del_cnt = del_cnt + 1;
            } else {
                if len(new_data) == 0 { new_data = r; }
                else { new_data = new_data + DB_NL_STR + r; }
            }
        }
        i = i + 1;
    }
    set_at(db_data,   id, new_data);
    set_at(db_counts, id, db_counts[id] - del_cnt);
    return del_cnt;
}

fn db_update_where(id, wcol, wval, scol, sval) {
    if id < 0 { return 0; }
    if db_active[id] == 0 { return 0; }
    let widx = _db_col_idx(db_schemas[id], wcol);
    let sidx = _db_col_idx(db_schemas[id], scol);
    if widx < 0 { return 0; }
    if sidx < 0 { return 0; }
    let rows = _db_split(db_data[id], DB_NL_STR);
    let mut new_data = "";
    let mut upd_cnt  = 0;
    let mut i = 0;
    while i < len(rows) {
        let r = rows[i];
        if len(r) > 0 {
            if _db_row_val(r, widx) == wval {
                // Rebuild row with updated column
                let cols = _db_split(r, DB_TAB_STR);
                let mut new_row = "";
                let mut j = 0;
                while j < len(cols) {
                    if j > 0 { new_row = new_row + DB_TAB_STR; }
                    if j == sidx { new_row = new_row + sval; }
                    else { new_row = new_row + cols[j]; }
                    j = j + 1;
                }
                if len(new_data) == 0 { new_data = new_row; }
                else { new_data = new_data + DB_NL_STR + new_row; }
                upd_cnt = upd_cnt + 1;
            } else {
                if len(new_data) == 0 { new_data = r; }
                else { new_data = new_data + DB_NL_STR + r; }
            }
        }
        i = i + 1;
    }
    set_at(db_data, id, new_data);
    return upd_cnt;
}

// ============================================================
// Query
// ============================================================

fn db_select_where(id, col_name, val) {
    if id < 0 { return "sqlite: invalid id"; }
    if db_active[id] == 0 { return "sqlite: table not found"; }
    let col_idx = _db_col_idx(db_schemas[id], col_name);
    if col_idx < 0 { return "sqlite: column '" + col_name + "' not found"; }
    let rows = _db_split(db_data[id], DB_NL_STR);
    let mut out = db_schemas[id] + DB_NL_STR;
    let mut found = 0;
    let mut i = 0;
    while i < len(rows) {
        let r = rows[i];
        if len(r) > 0 {
            if _db_row_val(r, col_idx) == val {
                out = out + r + DB_NL_STR;
                found = found + 1;
            }
        }
        i = i + 1;
    }
    return out + "(" + to_string(found) + " row(s))";
}

fn db_select_all(id) {
    if id < 0 { return "sqlite: invalid id"; }
    if db_active[id] == 0 { return "sqlite: table not found"; }
    let hdr = "=== " + db_names[id] + " ===\n" + db_schemas[id] + DB_NL_STR;
    if db_counts[id] == 0 { return hdr + "(empty)"; }
    return hdr + db_data[id] + DB_NL_STR + "(" + to_string(db_counts[id]) + " row(s))";
}

fn db_schema(id) {
    if id < 0 { return "sqlite: invalid id"; }
    if db_active[id] == 0 { return "sqlite: table not found"; }
    return db_names[id] + ": " + db_schemas[id];
}

fn db_list() {
    let mut out = "Tables (" + to_string(db_total) + "/" + to_string(DB_MAX_TABLES) + "):\n";
    let mut i = 0;
    while i < DB_MAX_TABLES {
        if db_active[i] == 1 {
            out = out + "  [" + to_string(i) + "] " + db_names[i]
                + "  rows=" + to_string(db_counts[i])
                + "  cols=" + db_schemas[i] + "\n";
        }
        i = i + 1;
    }
    return out;
}

print("sqlite.hl loaded");
print("SQLite: in-memory tables, CREATE/INSERT/SELECT/DELETE/UPDATE, " + to_string(DB_MAX_TABLES) + " tables");
