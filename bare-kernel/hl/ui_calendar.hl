// ui_calendar.hl -- Calendar Application
//
// Iteration 167: Monthly calendar view with event management.
//
// Window: 440×380
//   Title bar: 20px
//   Toolbar (month nav): 32px
//   Calendar grid: 7 cols × 7 rows (header + 6 week rows) = 258px
//   Event panel: remainder ~50px
//
// Calendar grid:
//   Column width: 56px | Row height: 36px
//   Row 0: day-of-week headers (Sun Mon Tue Wed Thu Fri Sat)
//   Rows 1-6: date cells
//   Today is highlighted; days with events shown with accent dot.
//
// Events: up to UICAL_MAX_EVENTS (32) global events.
//   Each event: [day, month, year, text]
//
// Time source: ntp_get_time() if synced, else rtc_read_unix().
//
// Public API:
//   uical_open()
//   uical_close()
//   uical_is_open()        → 1/0
//   uical_draw()
//   uical_key(k)
//   uical_click(mx, my)
//   uical_add_event(day, month, year, text)
//   uical_goto(month, year)

let UICAL_WIN_X    = 80;
let UICAL_WIN_Y    = 40;
let UICAL_WIN_W    = 440;
let UICAL_WIN_H    = 380;
let UICAL_TB_H     = 32;
let UICAL_CELL_W   = 56;
let UICAL_CELL_H   = 36;
let UICAL_GRID_X   = 88;   // centered: (440 - 7*56) / 2 + WIN_X = 88
let UICAL_GRID_Y   = 72;   // WIN_Y + 20 (title) + TB_H
let UICAL_MAX_EVENTS = 32;

// Day-of-week header labels
fn _uical_dow_label(d) {
    if d == 0 { return "Su"; }
    if d == 1 { return "Mo"; }
    if d == 2 { return "Tu"; }
    if d == 3 { return "We"; }
    if d == 4 { return "Th"; }
    if d == 5 { return "Fr"; }
    return "Sa";
}

fn _uical_month_name(m) {
    if m == 1  { return "January"; }   if m == 2  { return "February"; }
    if m == 3  { return "March"; }     if m == 4  { return "April"; }
    if m == 5  { return "May"; }       if m == 6  { return "June"; }
    if m == 7  { return "July"; }      if m == 8  { return "August"; }
    if m == 9  { return "September"; } if m == 10 { return "October"; }
    if m == 11 { return "November"; }  return "December";
}

// State
let mut uical_open_flag = 0;
let mut uical_month     = 1;   // 1-12
let mut uical_year      = 2025;
let mut uical_today_d   = 0;   // today's day (0=unknown)
let mut uical_today_m   = 0;
let mut uical_today_y   = 0;
let mut uical_sel_day   = 0;   // selected day (0=none)

// Events
let mut uical_ev_day    = [];
let mut uical_ev_month  = [];
let mut uical_ev_year   = [];
let mut uical_ev_text   = [];
let mut uical_ev_count  = 0;

// ============================================================
// Date math
// ============================================================

fn _uical_is_leap(y) {
    if y % 4 == 0 {
        if y % 100 != 0 { return 1; }
        if y % 400 == 0 { return 1; }
    }
    return 0;
}

fn _uical_days_in_month(m, y) {
    if m == 2 {
        if _uical_is_leap(y) == 1 { return 29; }
        return 28;
    }
    if m == 4  { return 30; } if m == 6  { return 30; }
    if m == 9  { return 30; } if m == 11 { return 30; }
    return 31;
}

// Zeller-based day-of-week for 1st of month (0=Sun)
fn _uical_dow_first(m, y) {
    let mut mm = m;
    let mut yy = y;
    if mm < 3 { mm = mm + 12; yy = yy - 1; }
    let k = yy % 100;
    let j = yy / 100;
    let h = (1 + (13 * (mm + 1)) / 5 + k + k / 4 + j / 4 + 5 * j) % 7;
    // Zeller: h=0→Sat, 1→Sun, 2→Mon ... convert to Sun=0
    return (h + 6) % 7;
}

// Get today from ntp or return fixed default
fn _uical_get_today() {
    let t = ntp_get_time();
    if t == 0 { return 0; }   // unknown
    // Quick decode: same logic as ntp_format_time
    let mut rem = t / 86400;
    let mut y = 1970;
    let mut go = 1;
    while go == 1 {
        let mut yd = 365;
        if _uical_is_leap(y) == 1 { yd = 366; }
        if rem < yd { go = 0; }
        else { rem = rem - yd; y = y + 1; }
    }
    let mut mo = 1;
    let mut go2 = 1;
    while go2 == 1 {
        let dm = _uical_days_in_month(mo, y);
        if rem < dm { go2 = 0; }
        else { rem = rem - dm; mo = mo + 1; }
    }
    uical_today_d = rem + 1;
    uical_today_m = mo;
    uical_today_y = y;
    return 1;
}

// ============================================================
// Event helpers
// ============================================================

fn uical_add_event(day, month, year, text) {
    if uical_ev_count >= UICAL_MAX_EVENTS { return 0 - 1; }
    push(uical_ev_day,   day);
    push(uical_ev_month, month);
    push(uical_ev_year,  year);
    push(uical_ev_text,  text);
    uical_ev_count = uical_ev_count + 1;
    return uical_ev_count - 1;
}

fn _uical_has_event(day, month, year) {
    let mut i = 0;
    while i < uical_ev_count {
        if uical_ev_day[i] == day {
            if uical_ev_month[i] == month {
                if uical_ev_year[i] == year { return 1; }
            }
        }
        i = i + 1;
    }
    return 0;
}

fn _uical_events_for_day(day, month, year) {
    let mut out = "";
    let mut i = 0;
    while i < uical_ev_count {
        if uical_ev_day[i] == day {
            if uical_ev_month[i] == month {
                if uical_ev_year[i] == year {
                    if len(out) > 0 { out = out + "; "; }
                    out = out + uical_ev_text[i];
                }
            }
        }
        i = i + 1;
    }
    return out;
}

// ============================================================
// Drawing
// ============================================================

fn _uical_draw_toolbar() {
    let wx = UICAL_WIN_X;
    let wy = UICAL_WIN_Y + 20;
    let bg  = ui_theme_panel_color();
    let bdr = ui_theme_border_color();
    vesa_fill_rect(wx, wy, UICAL_WIN_W, UICAL_TB_H, bg);
    vesa_rect(wx, wy, UICAL_WIN_W, UICAL_TB_H, bdr);

    ui_button(wx + 4, wy + 4, 32, 24, "<");
    ui_button(wx + UICAL_WIN_W - 36, wy + 4, 32, 24, ">");

    // Month/Year centered label
    let label = _uical_month_name(uical_month) + " " + to_string(uical_year);
    let lx = wx + UICAL_WIN_W / 2 - len(label) * 4;
    ui_draw_text(lx, wy + 8, label, ui_theme_text_color(), 0);
    return 0;
}

fn _uical_draw_grid() {
    let gx = UICAL_GRID_X;
    let gy = UICAL_GRID_Y;
    let tc  = ui_theme_text_color();
    let dim = ui_theme_dim_color();
    let acc = ui_theme_accent_color();
    let hl  = ui_theme_highlight_color();

    // Clear grid area
    vesa_fill_rect(UICAL_WIN_X, gy, UICAL_WIN_W, 7 * UICAL_CELL_H + 4, ui_theme_surface_color());

    // Day-of-week headers
    let mut d = 0;
    while d < 7 {
        let hx = gx + d * UICAL_CELL_W + UICAL_CELL_W / 2 - 6;
        ui_draw_text(hx, gy + 4, _uical_dow_label(d), dim, 0);
        d = d + 1;
    }

    let dim_month = _uical_days_in_month(uical_month, uical_year);
    let dow_first = _uical_dow_first(uical_month, uical_year);
    let mut day = 1;
    let mut row = 1;
    while row <= 6 {
        let mut col = 0;
        while col < 7 {
            let cell_day = (row - 1) * 7 + col - dow_first + 1;
            if cell_day >= 1 {
                if cell_day <= dim_month {
                    let cx = gx + col * UICAL_CELL_W;
                    let cy = gy + row * UICAL_CELL_H;
                    let is_today = 0;
                    if uical_today_d == cell_day {
                        if uical_today_m == uical_month {
                            if uical_today_y == uical_year { let is_today = 1; }
                        }
                    }
                    let is_sel = 0;
                    if uical_sel_day == cell_day { let is_sel = 1; }

                    if is_today == 1 {
                        vesa_fill_rect(cx + 2, cy + 2, UICAL_CELL_W - 4, UICAL_CELL_H - 4, acc);
                        ui_draw_text(cx + 6, cy + 8, to_string(cell_day), ui_theme_surface_color(), 0);
                    } else {
                        if is_sel == 1 {
                            vesa_fill_rect(cx + 2, cy + 2, UICAL_CELL_W - 4, UICAL_CELL_H - 4, hl);
                        }
                        ui_draw_text(cx + 6, cy + 8, to_string(cell_day), tc, 0);
                    }

                    // Event dot
                    if _uical_has_event(cell_day, uical_month, uical_year) == 1 {
                        vesa_fill_rect(cx + UICAL_CELL_W - 8, cy + UICAL_CELL_H - 8, 4, 4, acc);
                    }
                    day = day + 1;
                }
            }
            col = col + 1;
        }
        row = row + 1;
    }

    // Grid lines
    let mut c = 0;
    while c <= 7 {
        vesa_rect(gx + c * UICAL_CELL_W, gy + UICAL_CELL_H, 1, 6 * UICAL_CELL_H, ui_theme_border_color());
        c = c + 1;
    }
    let mut r = 1;
    while r <= 7 {
        vesa_rect(gx, gy + r * UICAL_CELL_H, 7 * UICAL_CELL_W, 1, ui_theme_border_color());
        r = r + 1;
    }
    return 0;
}

fn _uical_draw_event_panel() {
    let ey = UICAL_GRID_Y + 7 * UICAL_CELL_H + 8;
    let ex = UICAL_WIN_X + 8;
    vesa_fill_rect(UICAL_WIN_X, ey, UICAL_WIN_W, UICAL_WIN_H - (ey - UICAL_WIN_Y), ui_theme_panel_color());
    if uical_sel_day > 0 {
        let evts = _uical_events_for_day(uical_sel_day, uical_month, uical_year);
        if len(evts) > 0 {
            ui_draw_text(ex, ey + 4, to_string(uical_sel_day) + ": " + evts, ui_theme_text_color(), 0);
        } else {
            ui_draw_text(ex, ey + 4, to_string(uical_sel_day) + ": (no events)", ui_theme_dim_color(), 0);
        }
    } else {
        ui_draw_text(ex, ey + 4, "Click a day to see events", ui_theme_dim_color(), 0);
    }
    return 0;
}

fn uical_draw() {
    if uical_open_flag == 0 { return 0; }
    let wx = UICAL_WIN_X;
    let wy = UICAL_WIN_Y;
    let bdr = ui_theme_border_color();
    vesa_fill_rect(wx, wy, UICAL_WIN_W, 20, ui_theme_panel_color());
    ui_draw_text(wx + 8, wy + 2, "Calendar", ui_theme_text_color(), 0);
    vesa_rect(wx, wy, UICAL_WIN_W, UICAL_WIN_H, bdr);
    _uical_draw_toolbar();
    _uical_draw_grid();
    _uical_draw_event_panel();
    return 0;
}

// ============================================================
// Input
// ============================================================

fn _uical_prev_month() {
    uical_month = uical_month - 1;
    if uical_month < 1 { uical_month = 12; uical_year = uical_year - 1; }
    uical_sel_day = 0;
    uical_draw();
    return 0;
}

fn _uical_next_month() {
    uical_month = uical_month + 1;
    if uical_month > 12 { uical_month = 1; uical_year = uical_year + 1; }
    uical_sel_day = 0;
    uical_draw();
    return 0;
}

fn uical_key(k) {
    if uical_open_flag == 0 { return 0; }
    if k == 27 { uical_close(); return 1; }          // Esc
    if k == 75 { _uical_prev_month(); return 1; }     // Left arrow
    if k == 77 { _uical_next_month(); return 1; }     // Right arrow
    if k == 84 {                                       // 't' = today
        _uical_get_today();
        if uical_today_y > 0 { uical_month = uical_today_m; uical_year = uical_today_y; }
        uical_draw();
        return 1;
    }
    return 0;
}

fn uical_click(mx, my) {
    if uical_open_flag == 0 { return 0; }
    let wx = UICAL_WIN_X;
    let wy = UICAL_WIN_Y + 20;

    // Toolbar: prev / next
    if ui_button_hit(wx + 4, wy + 4, 32, 24, mx, my) == 1 { _uical_prev_month(); return 1; }
    if ui_button_hit(wx + UICAL_WIN_W - 36, wy + 4, 32, 24, mx, my) == 1 { _uical_next_month(); return 1; }

    // Grid click → select day
    let gx = UICAL_GRID_X;
    let gy = UICAL_GRID_Y;
    if mx >= gx { if mx < gx + 7 * UICAL_CELL_W {
        if my >= gy + UICAL_CELL_H { if my < gy + 7 * UICAL_CELL_H {
            let col = (mx - gx) / UICAL_CELL_W;
            let row = (my - gy) / UICAL_CELL_H;   // 0 = header, 1-6 = weeks
            let dow_first = _uical_dow_first(uical_month, uical_year);
            let cell_day  = (row - 1) * 7 + col - dow_first + 1;
            let dim_month = _uical_days_in_month(uical_month, uical_year);
            if cell_day >= 1 { if cell_day <= dim_month {
                uical_sel_day = cell_day;
                uical_draw();
                return 1;
            }}
        }}
    }}
    return 0;
}

// ============================================================
// Lifecycle
// ============================================================

fn uical_goto(month, year) {
    uical_month = month;
    uical_year  = year;
    uical_sel_day = 0;
    if uical_open_flag == 1 { uical_draw(); }
    return 0;
}

fn uical_open() {
    _uical_get_today();
    if uical_today_y > 0 { uical_month = uical_today_m; uical_year = uical_today_y; }
    uical_sel_day   = 0;
    uical_open_flag = 1;
    uical_draw();
    return 0;
}

fn uical_close() {
    uical_open_flag = 0;
    vesa_fill_rect(UICAL_WIN_X, UICAL_WIN_Y, UICAL_WIN_W, UICAL_WIN_H, ui_theme_bg_color());
    return 0;
}

fn uical_is_open() { return uical_open_flag; }

fn uical_init() {
    uical_ev_day   = [];
    uical_ev_month = [];
    uical_ev_year  = [];
    uical_ev_text  = [];
    uical_ev_count = 0;
    uical_open_flag = 0;
    print("uical: init — calendar with " + to_string(UICAL_MAX_EVENTS) + " event slots");
    return 0;
}

print("ui_calendar.hl loaded");
print("Calendar: monthly grid, Zeller DOW, event storage, NTP-aware today highlight, 440x380");
