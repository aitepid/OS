// segment_tree.hl -- Segment Tree (Range Queries + Lazy Propagation)
//
// Implements a Segment Tree with lazy propagation:
//   - seg_build(data, n): build from array, O(n)
//   - seg_update_point(idx, val): point set, O(log n)
//   - seg_query_sum(l, r): range sum, O(log n)
//   - seg_query_min(l, r): range minimum, O(log n)
//   - seg_query_max(l, r): range maximum, O(log n)
//   - seg_range_add(l, r, delta): range add with lazy propagation, O(log n)
// Three separate trees (sum/min/max) share one lazy array for range-add.
// Up to SEG_MAX_N=128 elements, tree array size = 4×SEG_MAX_N = 512 nodes.
// Applications: range minimum/maximum/sum queries, interval scheduling,
//               computational geometry, rank/frequency computations.
//
// Buffer: 0x1470000

let SEG_BUF      = 0x1470000;

let SEG_MAX_N    = 128;   // max array size
let SEG_MAX_NODE = 512;   // 4 × SEG_MAX_N (safe upper bound for nodes)
let SEG_INF      = 2147483647;

// Separate trees for sum, min, max; shared lazy array
let seg_sum  = [];   // range sum tree
let seg_min  = [];   // range min tree
let seg_max  = [];   // range max tree
let seg_lazy = [];   // pending range-add values (applied to children on push)

let seg_n    = 0;    // current array size

let seg_initialized = 0;

fn segment_tree_init(n) {
    if n > SEG_MAX_N { n = SEG_MAX_N; }
    seg_n = n;
    let i = 0;
    while i < SEG_MAX_NODE {
        set_at(seg_sum,  i, 0);
        set_at(seg_min,  i, SEG_INF);
        set_at(seg_max,  i, -SEG_INF);
        set_at(seg_lazy, i, 0);
        i = i + 1;
    }
    seg_initialized = 1;
    return 0;
}

// --- Build ---
fn _seg_build(node, start, end, data) {
    set_at(seg_lazy, node, 0);
    if start == end {
        set_at(seg_sum, node, data[start - 1]);
        set_at(seg_min, node, data[start - 1]);
        set_at(seg_max, node, data[start - 1]);
        return 0;
    }
    let mid = (start + end) / 2;
    _seg_build(node * 2,     start, mid, data);
    _seg_build(node * 2 + 1, mid + 1, end, data);
    set_at(seg_sum, node, seg_sum[node*2] + seg_sum[node*2+1]);
    let mn = seg_min[node*2]; if seg_min[node*2+1] < mn { mn = seg_min[node*2+1]; }
    let mx = seg_max[node*2]; if seg_max[node*2+1] > mx { mx = seg_max[node*2+1]; }
    set_at(seg_min, node, mn);
    set_at(seg_max, node, mx);
    return 0;
}

fn seg_build(data, n) {
    segment_tree_init(n);
    _seg_build(1, 1, seg_n, data);
    return 0;
}

// --- Push lazy down to children ---
fn _seg_push_down(node, start, end) {
    if seg_lazy[node] == 0 { return 0; }
    let mid = (start + end) / 2;
    let lc = node * 2;
    let rc = node * 2 + 1;
    let lz = seg_lazy[node];
    set_at(seg_sum,  lc, seg_sum[lc]  + lz * (mid - start + 1));
    set_at(seg_min,  lc, seg_min[lc]  + lz);
    set_at(seg_max,  lc, seg_max[lc]  + lz);
    set_at(seg_lazy, lc, seg_lazy[lc] + lz);
    set_at(seg_sum,  rc, seg_sum[rc]  + lz * (end - mid));
    set_at(seg_min,  rc, seg_min[rc]  + lz);
    set_at(seg_max,  rc, seg_max[rc]  + lz);
    set_at(seg_lazy, rc, seg_lazy[rc] + lz);
    set_at(seg_lazy, node, 0);
    return 0;
}

fn _seg_pull_up(node) {
    set_at(seg_sum, node, seg_sum[node*2] + seg_sum[node*2+1]);
    let mn = seg_min[node*2]; if seg_min[node*2+1] < mn { mn = seg_min[node*2+1]; }
    let mx = seg_max[node*2]; if seg_max[node*2+1] > mx { mx = seg_max[node*2+1]; }
    set_at(seg_min, node, mn);
    set_at(seg_max, node, mx);
    return 0;
}

// --- Point update: set position idx to val ---
fn _seg_update_pt(node, start, end, idx, val) {
    if start == end {
        set_at(seg_sum, node, val);
        set_at(seg_min, node, val);
        set_at(seg_max, node, val);
        return 0;
    }
    _seg_push_down(node, start, end);
    let mid = (start + end) / 2;
    if idx <= mid { _seg_update_pt(node*2,   start, mid, idx, val); }
    else          { _seg_update_pt(node*2+1, mid+1, end, idx, val); }
    _seg_pull_up(node);
    return 0;
}

fn seg_update_point(idx, val) {
    _seg_update_pt(1, 1, seg_n, idx, val);
    return 0;
}

// --- Range add [l..r] += delta with lazy propagation ---
fn _seg_range_add(node, start, end, l, r, delta) {
    if l > end   { return 0; }
    if r < start { return 0; }
    if l <= start {
        if end <= r {
            set_at(seg_sum,  node, seg_sum[node]  + delta * (end - start + 1));
            set_at(seg_min,  node, seg_min[node]  + delta);
            set_at(seg_max,  node, seg_max[node]  + delta);
            set_at(seg_lazy, node, seg_lazy[node] + delta);
            return 0;
        }
    }
    _seg_push_down(node, start, end);
    let mid = (start + end) / 2;
    _seg_range_add(node*2,   start, mid, l, r, delta);
    _seg_range_add(node*2+1, mid+1, end, l, r, delta);
    _seg_pull_up(node);
    return 0;
}

fn seg_range_add(l, r, delta) {
    _seg_range_add(1, 1, seg_n, l, r, delta);
    return 0;
}

// --- Range queries ---
fn _seg_qsum(node, start, end, l, r) {
    if l > end   { return 0; }
    if r < start { return 0; }
    if l <= start { if end <= r { return seg_sum[node]; } }
    _seg_push_down(node, start, end);
    let mid = (start + end) / 2;
    return _seg_qsum(node*2, start, mid, l, r)
         + _seg_qsum(node*2+1, mid+1, end, l, r);
}

fn _seg_qmin(node, start, end, l, r) {
    if l > end   { return SEG_INF; }
    if r < start { return SEG_INF; }
    if l <= start { if end <= r { return seg_min[node]; } }
    _seg_push_down(node, start, end);
    let mid = (start + end) / 2;
    let lv = _seg_qmin(node*2,   start, mid, l, r);
    let rv = _seg_qmin(node*2+1, mid+1, end, l, r);
    if lv < rv { return lv; }
    return rv;
}

fn _seg_qmax(node, start, end, l, r) {
    if l > end   { return -SEG_INF; }
    if r < start { return -SEG_INF; }
    if l <= start { if end <= r { return seg_max[node]; } }
    _seg_push_down(node, start, end);
    let mid = (start + end) / 2;
    let lv = _seg_qmax(node*2,   start, mid, l, r);
    let rv = _seg_qmax(node*2+1, mid+1, end, l, r);
    if lv > rv { return lv; }
    return rv;
}

fn seg_query_sum(l, r) { return _seg_qsum(1, 1, seg_n, l, r); }
fn seg_query_min(l, r) { return _seg_qmin(1, 1, seg_n, l, r); }
fn seg_query_max(l, r) { return _seg_qmax(1, 1, seg_n, l, r); }

fn seg_status() {
    return "segtree: n=" + to_string(seg_n)
        + " sum=" + to_string(seg_query_sum(1, seg_n))
        + " min=" + to_string(seg_query_min(1, seg_n))
        + " max=" + to_string(seg_query_max(1, seg_n));
}

fn segment_tree_test() {
    // Build from [3,1,4,1,5,9,2,6]
    let data = [3, 1, 4, 1, 5, 9, 2, 6];
    seg_build(data, 8);
    let s_all = seg_query_sum(1, 8);    // 31
    let s35   = seg_query_sum(3, 5);    // 4+1+5=10
    let mn    = seg_query_min(1, 8);    // 1
    let mx    = seg_query_max(1, 8);    // 9
    // Point update: position 4 = 10 → array [3,1,4,10,5,9,2,6]
    seg_update_point(4, 10);
    let s35b  = seg_query_sum(3, 5);    // 4+10+5=19
    let mn35b = seg_query_min(3, 5);    // 4
    // Range add: positions 2..6 += 2 → [3,3,6,12,7,11,2,6]
    seg_range_add(2, 6, 2);
    let sall2 = seg_query_sum(1, 8);    // 50
    let mn2   = seg_query_min(1, 8);    // 2
    let mx2   = seg_query_max(1, 8);    // 12
    serial_print("segtree test: " + seg_status());
    serial_print("segtree test: sum=" + to_string(s_all)
        + " sum(3,5)=" + to_string(s35)
        + " min=" + to_string(mn)
        + " max=" + to_string(mx)
        + " upd_sum(3,5)=" + to_string(s35b)
        + " range_add_sum=" + to_string(sall2)
        + " range_add_min=" + to_string(mn2)
        + " range_add_max=" + to_string(mx2));
    return "segtree: sum=" + to_string(s_all)
        + " range_sum(3,5)=" + to_string(s35)
        + " min=" + to_string(mn) + " max=" + to_string(mx)
        + " point_upd_sum(3,5)=" + to_string(s35b)
        + " range_add_min=" + to_string(mn2)
        + " [segment tree lazy propagation ok]";
}

print("segment_tree.hl loaded -- Segment Tree (range sum/min/max, point update, lazy range add)");
