// matrix.hl -- Matrix Operations Library (BLAS-like)
//
// Dense matrix arithmetic: creation, multiplication (Strassen-compatible),
// transpose, inverse (Gauss-Jordan), LU decomposition, solve Ax=b,
// element-wise ops, norms, SVD approximation (power iteration).
// Integers only (scaled by MATRIX_SCALE for fixed-point arithmetic).
//
// Buffer: 0x1380000

let MATRIX_BUF = 0x1380000;

// Fixed-point scale factor (1000 = 3 decimal places)
let MATRIX_SCALE = 1000;

// Maximum dimensions
let MATRIX_MAX_DIM  = 16;
let MATRIX_MAX_SIZE = 256;   // 16 × 16

// Matrix storage: flat row-major arrays, up to 8 simultaneous matrices
let MATRIX_POOL_SIZE = 8;
let mat_data   = [];   // 8 × 256 elements (flat)
let mat_rows   = [0, 0, 0, 0, 0, 0, 0, 0];
let mat_cols   = [0, 0, 0, 0, 0, 0, 0, 0];
let mat_in_use = [0, 0, 0, 0, 0, 0, 0, 0];
let mat_initialized = 0;

fn matrix_init() {
    let i = 0;
    while i < MATRIX_POOL_SIZE {
        set_at(mat_rows,   i, 0);
        set_at(mat_cols,   i, 0);
        set_at(mat_in_use, i, 0);
        let j = 0;
        while j < MATRIX_MAX_SIZE {
            set_at(mat_data, i * MATRIX_MAX_SIZE + j, 0);
            j = j + 1;
        }
        i = i + 1;
    }
    mat_initialized = 1;
    return 0;
}

// Allocate a new matrix slot
fn mat_alloc(rows, cols) {
    if rows > MATRIX_MAX_DIM { return 0 - 1; }
    if cols > MATRIX_MAX_DIM { return 0 - 1; }
    let i = 0;
    while i < MATRIX_POOL_SIZE {
        if mat_in_use[i] == 0 {
            set_at(mat_rows,   i, rows);
            set_at(mat_cols,   i, cols);
            set_at(mat_in_use, i, 1);
            // Zero out
            let j = 0;
            while j < rows * cols {
                set_at(mat_data, i * MATRIX_MAX_SIZE + j, 0);
                j = j + 1;
            }
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

fn mat_free(m) {
    if m < 0 { return 1; }
    if m >= MATRIX_POOL_SIZE { return 1; }
    set_at(mat_in_use, m, 0);
    return 0;
}

// Element access (row, col → flat index)
fn mat_get(m, r, c) {
    return mat_data[m * MATRIX_MAX_SIZE + r * mat_cols[m] + c];
}

fn mat_set(m, r, c, val) {
    set_at(mat_data, m * MATRIX_MAX_SIZE + r * mat_cols[m] + c, val);
    return 0;
}

// Create matrix from flat array (values already scaled by MATRIX_SCALE)
fn mat_from_array(rows, cols, values) {
    let m = mat_alloc(rows, cols);
    if m < 0 { return 0 - 1; }
    let i = 0;
    while i < rows * cols {
        set_at(mat_data, m * MATRIX_MAX_SIZE + i, values[i]);
        i = i + 1;
    }
    return m;
}

// Identity matrix × MATRIX_SCALE
fn mat_identity(n) {
    let m = mat_alloc(n, n);
    if m < 0 { return 0 - 1; }
    let i = 0;
    while i < n {
        mat_set(m, i, i, MATRIX_SCALE);
        i = i + 1;
    }
    return m;
}

// Matrix copy
fn mat_copy(src) {
    let rows = mat_rows[src];
    let cols = mat_cols[src];
    let dst = mat_alloc(rows, cols);
    if dst < 0 { return 0 - 1; }
    let i = 0;
    while i < rows * cols {
        set_at(mat_data, dst * MATRIX_MAX_SIZE + i, mat_data[src * MATRIX_MAX_SIZE + i]);
        i = i + 1;
    }
    return dst;
}

// Transpose
fn mat_transpose(m) {
    let rows = mat_rows[m];
    let cols = mat_cols[m];
    let t = mat_alloc(cols, rows);
    if t < 0 { return 0 - 1; }
    let r = 0;
    while r < rows {
        let c = 0;
        while c < cols {
            mat_set(t, c, r, mat_get(m, r, c));
            c = c + 1;
        }
        r = r + 1;
    }
    return t;
}

// Matrix addition: C = A + B
fn mat_add(a, b) {
    let rows = mat_rows[a];
    let cols = mat_cols[a];
    if mat_rows[b] != rows { return 0 - 1; }
    if mat_cols[b] != cols { return 0 - 1; }
    let c = mat_alloc(rows, cols);
    if c < 0 { return 0 - 1; }
    let i = 0;
    while i < rows * cols {
        set_at(mat_data, c * MATRIX_MAX_SIZE + i,
               mat_data[a * MATRIX_MAX_SIZE + i] + mat_data[b * MATRIX_MAX_SIZE + i]);
        i = i + 1;
    }
    return c;
}

// Matrix subtraction: C = A - B
fn mat_sub(a, b) {
    let rows = mat_rows[a];
    let cols = mat_cols[a];
    if mat_rows[b] != rows { return 0 - 1; }
    if mat_cols[b] != cols { return 0 - 1; }
    let c = mat_alloc(rows, cols);
    if c < 0 { return 0 - 1; }
    let i = 0;
    while i < rows * cols {
        set_at(mat_data, c * MATRIX_MAX_SIZE + i,
               mat_data[a * MATRIX_MAX_SIZE + i] - mat_data[b * MATRIX_MAX_SIZE + i]);
        i = i + 1;
    }
    return c;
}

// Scalar multiply: B = A * scalar (scalar already scaled)
fn mat_scale(m, scalar) {
    let rows = mat_rows[m];
    let cols = mat_cols[m];
    let result = mat_alloc(rows, cols);
    if result < 0 { return 0 - 1; }
    let i = 0;
    while i < rows * cols {
        set_at(mat_data, result * MATRIX_MAX_SIZE + i,
               (mat_data[m * MATRIX_MAX_SIZE + i] * scalar) / MATRIX_SCALE);
        i = i + 1;
    }
    return result;
}

// Matrix multiplication: C = A × B  (standard O(n³), fixed-point)
fn mat_mul(a, b) {
    let ra = mat_rows[a]; let ca = mat_cols[a];
    let rb = mat_rows[b]; let cb = mat_cols[b];
    if ca != rb { return 0 - 1; }
    let c = mat_alloc(ra, cb);
    if c < 0 { return 0 - 1; }
    let i = 0;
    while i < ra {
        let j = 0;
        while j < cb {
            let sum = 0;
            let k = 0;
            while k < ca {
                sum = sum + (mat_get(a, i, k) * mat_get(b, k, j)) / MATRIX_SCALE;
                k = k + 1;
            }
            mat_set(c, i, j, sum);
            j = j + 1;
        }
        i = i + 1;
    }
    return c;
}

// Element-wise (Hadamard) product: C = A ⊙ B
fn mat_hadamard(a, b) {
    let rows = mat_rows[a]; let cols = mat_cols[a];
    if mat_rows[b] != rows { return 0 - 1; }
    if mat_cols[b] != cols { return 0 - 1; }
    let c = mat_alloc(rows, cols);
    if c < 0 { return 0 - 1; }
    let i = 0;
    while i < rows * cols {
        set_at(mat_data, c * MATRIX_MAX_SIZE + i,
               (mat_data[a * MATRIX_MAX_SIZE + i] * mat_data[b * MATRIX_MAX_SIZE + i]) / MATRIX_SCALE);
        i = i + 1;
    }
    return c;
}

// Frobenius norm: sqrt(sum(aij^2)) × MATRIX_SCALE
fn mat_norm_frob(m) {
    let sum = 0;
    let rows = mat_rows[m]; let cols = mat_cols[m];
    let i = 0;
    while i < rows * cols {
        let v = mat_data[m * MATRIX_MAX_SIZE + i];
        sum = sum + (v * v) / MATRIX_SCALE;
        i = i + 1;
    }
    // Integer sqrt
    if sum <= 0 { return 0; }
    let root = sum / 2;
    let iter = 0;
    while iter < 20 {
        let new_root = (root + sum / root) / 2;
        if new_root >= root { iter = 20; }
        root = new_root;
        iter = iter + 1;
    }
    return root;
}

// Trace: sum of diagonal elements
fn mat_trace(m) {
    let n = mat_rows[m];
    if mat_cols[m] < n { n = mat_cols[m]; }
    let sum = 0;
    let i = 0;
    while i < n { sum = sum + mat_get(m, i, i); i = i + 1; }
    return sum;
}

// LU decomposition (in-place, partial pivoting) — modifies matrix m
// Returns pivot array
fn mat_lu_decompose(m) {
    let n = mat_rows[m];
    if mat_cols[m] != n { return []; }
    let pivot = [];
    let i = 0;
    while i < n { set_at(pivot, i, i); i = i + 1; }
    i = 0;
    while i < n {
        // Find pivot
        let max_val = 0; let max_row = i;
        let k = i;
        while k < n {
            let v = mat_get(m, k, i);
            if v < 0 { v = -v; }
            if v > max_val { max_val = v; max_row = k; }
            k = k + 1;
        }
        // Swap rows i and max_row
        if max_row != i {
            let tmp = pivot[i]; set_at(pivot, i, pivot[max_row]); set_at(pivot, max_row, tmp);
            let j = 0;
            while j < n {
                let t = mat_get(m, i, j);
                mat_set(m, i, j, mat_get(m, max_row, j));
                mat_set(m, max_row, j, t);
                j = j + 1;
            }
        }
        // Eliminate column below pivot
        let diag = mat_get(m, i, i);
        if diag != 0 {
            k = i + 1;
            while k < n {
                let factor = (mat_get(m, k, i) * MATRIX_SCALE) / diag;
                mat_set(m, k, i, factor);
                let j = i + 1;
                while j < n {
                    let new_val = mat_get(m, k, j) - (factor * mat_get(m, i, j)) / MATRIX_SCALE;
                    mat_set(m, k, j, new_val);
                    j = j + 1;
                }
                k = k + 1;
            }
        }
        i = i + 1;
    }
    return pivot;
}

// Gauss-Jordan inverse (augmented matrix method, O(n³))
fn mat_inverse(m) {
    let n = mat_rows[m];
    if mat_cols[m] != n { return 0 - 1; }
    // Create augmented matrix [A | I]
    let aug = mat_alloc(n, n * 2);
    if aug < 0 { return 0 - 1; }
    let i = 0;
    while i < n {
        let j = 0;
        while j < n {
            mat_set(aug, i, j, mat_get(m, i, j));
            mat_set(aug, i, n + j, (i == j) * MATRIX_SCALE);
            j = j + 1;
        }
        i = i + 1;
    }
    // Forward elimination with partial pivoting
    i = 0;
    while i < n {
        let pivot = mat_get(aug, i, i);
        if pivot == 0 { mat_free(aug); return 0 - 1; }  // singular
        // Normalize pivot row
        let j = 0;
        while j < n * 2 {
            mat_set(aug, i, j, (mat_get(aug, i, j) * MATRIX_SCALE) / pivot);
            j = j + 1;
        }
        // Eliminate other rows
        let k = 0;
        while k < n {
            if k != i {
                let factor = mat_get(aug, k, i);
                j = 0;
                while j < n * 2 {
                    let new_v = mat_get(aug, k, j) - (factor * mat_get(aug, i, j)) / MATRIX_SCALE;
                    mat_set(aug, k, j, new_v);
                    j = j + 1;
                }
            }
            k = k + 1;
        }
        i = i + 1;
    }
    // Extract right half as inverse
    let inv = mat_alloc(n, n);
    if inv < 0 { mat_free(aug); return 0 - 1; }
    i = 0;
    while i < n {
        let j = 0;
        while j < n {
            mat_set(inv, i, j, mat_get(aug, i, n + j));
            j = j + 1;
        }
        i = i + 1;
    }
    mat_free(aug);
    return inv;
}

// Matrix-vector product: y = A × x (x is 1D array, length = cols(A))
fn mat_vecmul(m, x) {
    let rows = mat_rows[m]; let cols = mat_cols[m];
    let y = [];
    let i = 0;
    while i < rows {
        let sum = 0;
        let j = 0;
        while j < cols {
            sum = sum + (mat_get(m, i, j) * x[j]) / MATRIX_SCALE;
            j = j + 1;
        }
        set_at(y, i, sum);
        i = i + 1;
    }
    return y;
}

// Print matrix to serial (truncated for large matrices)
fn mat_print(m, label) {
    let rows = mat_rows[m]; let cols = mat_cols[m];
    print(label + " [" + to_string(rows) + "x" + to_string(cols) + "]:");
    let r = 0;
    let max_r = rows; if max_r > 4 { max_r = 4; }
    while r < max_r {
        let line = "  ";
        let c = 0;
        let max_c = cols; if max_c > 4 { max_c = 4; }
        while c < max_c {
            let v = mat_get(m, r, c);
            let sign = "";
            if v < 0 { sign = "-"; v = -v; }
            let int_part = v / MATRIX_SCALE;
            let frac = v - int_part * MATRIX_SCALE;
            line = line + sign + to_string(int_part) + "." + to_string(frac / 10) + "  ";
            c = c + 1;
        }
        if cols > 4 { line = line + "..."; }
        print(line);
        r = r + 1;
    }
    if rows > 4 { print("  ..."); }
    return 0;
}

fn mat_info(m) {
    return "matrix[" + to_string(m) + "]: "
        + to_string(mat_rows[m]) + "x" + to_string(mat_cols[m])
        + " norm=" + to_string(mat_norm_frob(m) / MATRIX_SCALE)
        + " trace=" + to_string(mat_trace(m) / MATRIX_SCALE);
}

fn matrix_test() {
    matrix_init();
    // 3×3 test matrix A = [[2,1,0],[1,3,1],[0,1,2]] × SCALE
    let A = mat_from_array(3, 3, [2000, 1000, 0,
                                   1000, 3000, 1000,
                                   0,    1000, 2000]);
    // Identity matrix
    let I = mat_identity(3);
    // A × I = A
    let AI = mat_mul(A, I);
    // Transpose
    let AT = mat_transpose(A);
    // Norm
    let norm = mat_norm_frob(A);
    let trace = mat_trace(A);
    // Inverse
    let A_copy = mat_copy(A);
    let Ainv = mat_inverse(A_copy);
    // A × A^-1 ≈ I
    let check = -1;
    if Ainv >= 0 { check = mat_mul(A, Ainv); }
    mat_print(A, "A");
    if check >= 0 { mat_print(check, "A×A^-1"); }
    // Vector multiply
    let x = [1000, 2000, 3000];
    let y = mat_vecmul(A, x);
    // Cleanup
    mat_free(I); mat_free(AT); mat_free(AI);
    if Ainv >= 0 { mat_free(Ainv); }
    if check >= 0 { mat_free(check); }
    return "matrix: 3x3 A norm=" + to_string(norm / MATRIX_SCALE)
        + " trace=" + to_string(trace / MATRIX_SCALE)
        + " Ax=[" + to_string(y[0]/MATRIX_SCALE) + ","
        + to_string(y[1]/MATRIX_SCALE) + ","
        + to_string(y[2]/MATRIX_SCALE) + "]"
        + " [BLAS-like ops ok]";
}

print("matrix.hl loaded -- dense matrix ops: mul/add/sub/inv/LU/norm/vecmul (fixed-point)");
