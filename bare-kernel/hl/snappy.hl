# snappy.hl - Snappy Compression (simplified)
# Implements simplified Snappy compression algorithm (Google)

# Memory layout
global SNAPPY_BUF = 0x1250000
global SNAPPY_MAX_BLOCK = 65536

# Snappy literal/copy opcodes
global SNAPPY_LITERAL = 0
global SNAPPY_COPY_1 = 1
global SNAPPY_COPY_2 = 2
global SNAPPY_COPY_4 = 3

# State
global snappy_output = 0
global snappy_output_len = 0
global snappy_hash_table = 0

fn snappy_init() {
    snappy_output = SNAPPY_BUF + 65536
    snappy_output_len = 0
    snappy_hash_table = SNAPPY_BUF
    serial_print("Snappy compression ready")
}

# Compress data with Snappy
fn snappy_compress(data, len) {
    var output = snappy_output
    var pos = 0

    # Write uncompressed length (varint)
    pos = _snappy_write_varint(output, pos, len)

    # Compress data
    var compressed = _snappy_compress_fragment(data, len)
    var comp_len = get_at(compressed, 0)
    var comp_data = get_at(compressed, 1)

    # Copy compressed data
    var i = 0
    while (i < comp_len) {
        set_at(output, pos, get_at(comp_data, i))
        pos = pos + 1
        i = i + 1
    }

    snappy_output_len = pos
    return pos
}

# Compress fragment (core algorithm)
fn _snappy_compress_fragment(data, len) {
    var result = SNAPPY_BUF + 131072
    var output = SNAPPY_BUF + 196608
    var out_pos = 0

    # Initialize hash table
    _snappy_init_hash_table()

    var pos = 0
    while (pos < len) {
        # Try to find match
        var match = _snappy_find_match(data, pos, len)
        var match_len = get_at(match, 0)
        var match_offset = get_at(match, 1)

        if (match_len >= 4) {
            # Emit copy
            out_pos = _snappy_emit_copy(output, out_pos, match_offset, match_len)

            # Update hash table for matched region
            var i = 0
            while (i < match_len) {
                if (pos + i < len) {
                    _snappy_insert_hash(data, pos + i)
                }
                i = i + 1
            }

            pos = pos + match_len
        } else {
            # Emit literal
            var literal_start = pos
            var literal_len = 1

            # Accumulate literals until we find a good match
            pos = pos + 1
            while (pos < len && literal_len < 60) {
                var next_match = _snappy_find_match(data, pos, len)
                if (get_at(next_match, 0) >= 4) {
                    break
                }
                _snappy_insert_hash(data, pos)
                literal_len = literal_len + 1
                pos = pos + 1
            }

            # Emit literal
            out_pos = _snappy_emit_literal(output, out_pos, data, literal_start, literal_len)
        }
    }

    set_at(result, 0, out_pos)
    set_at(result, 1, output)
    return result
}

# Find matching substring
fn _snappy_find_match(data, pos, len) {
    var result = SNAPPY_BUF + 262144
    var best_len = 0
    var best_offset = 0

    if (pos + 4 > len) {
        set_at(result, 0, 0)
        set_at(result, 1, 0)
        return result
    }

    # Hash current position
    var hash = _snappy_hash_bytes(data, pos)
    var candidate = get_at(snappy_hash_table, hash)

    # Check if candidate is valid
    if (candidate > 0 && candidate < pos) {
        var offset = pos - candidate
        if (offset <= 32768) {  # Max offset for Snappy
            # Count matching bytes
            var match_len = 0
            while (pos + match_len < len && candidate + match_len < pos) {
                if (get_at(data, pos + match_len) == get_at(data, candidate + match_len)) {
                    match_len = match_len + 1
                    if (match_len >= 64) {  # Max match length
                        break
                    }
                } else {
                    break
                }
            }

            if (match_len > best_len) {
                best_len = match_len
                best_offset = offset
            }
        }
    }

    set_at(result, 0, best_len)
    set_at(result, 1, best_offset)
    return result
}

# Hash 4 bytes at position
fn _snappy_hash_bytes(data, pos) {
    if (pos + 3 >= strlen(data)) {
        return 0
    }

    var b0 = get_at(data, pos)
    var b1 = get_at(data, pos + 1)
    var b2 = get_at(data, pos + 2)
    var b3 = get_at(data, pos + 3)

    var hash = (b0 + b1 * 256 + b2 * 65536 + b3 * 16777216) % 4096
    return hash
}

# Insert position into hash table
fn _snappy_insert_hash(data, pos) {
    var hash = _snappy_hash_bytes(data, pos)
    set_at(snappy_hash_table, hash, pos)
}

# Initialize hash table
fn _snappy_init_hash_table() {
    var i = 0
    while (i < 4096) {
        set_at(snappy_hash_table, i, 0)
        i = i + 1
    }
}

# Emit literal sequence
fn _snappy_emit_literal(output, pos, data, start, len) {
    # Literal tag: (len-1) in lower bits
    if (len < 60) {
        set_at(output, pos, len - 1)
        pos = pos + 1
    } else {
        # Long literal (not implemented in simplified version)
        set_at(output, pos, 60)
        pos = pos + 1
    }

    # Copy literal bytes
    var i = 0
    while (i < len) {
        set_at(output, pos, get_at(data, start + i))
        pos = pos + 1
        i = i + 1
    }

    return pos
}

# Emit copy sequence
fn _snappy_emit_copy(output, pos, offset, len) {
    # Copy tag: encodes offset and length
    # Simplified: use 2-byte copy encoding
    if (offset < 2048 && len >= 4 && len <= 11) {
        # 1-byte copy (not implemented - use 2-byte)
    }

    # 2-byte copy: tag (COPY_1) | length, offset_low, offset_high
    var tag = SNAPPY_COPY_1 + ((len - 4) * 4)
    set_at(output, pos, tag)
    pos = pos + 1
    set_at(output, pos, offset % 256)
    pos = pos + 1
    set_at(output, pos, offset / 256)
    pos = pos + 1

    return pos
}

# Decompress Snappy data
fn snappy_decompress(data, len) {
    var output = snappy_output
    var pos = 0
    var out_pos = 0

    # Read uncompressed length
    var varint_result = _snappy_read_varint(data, pos)
    var uncomp_len = get_at(varint_result, 0)
    var varint_len = get_at(varint_result, 1)
    pos = pos + varint_len

    # Decompress
    while (pos < len) {
        var tag = get_at(data, pos)
        pos = pos + 1

        var elem_type = tag % 4
        var length = tag / 4

        if (elem_type == SNAPPY_LITERAL) {
            # Literal
            var lit_len = length + 1
            var i = 0
            while (i < lit_len) {
                set_at(output, out_pos, get_at(data, pos))
                out_pos = out_pos + 1
                pos = pos + 1
                i = i + 1
            }
        } else if (elem_type == SNAPPY_COPY_1) {
            # 2-byte copy
            var copy_len = length + 4
            var offset_low = get_at(data, pos)
            pos = pos + 1
            var offset_high = get_at(data, pos)
            pos = pos + 1
            var offset = offset_low + offset_high * 256

            # Copy from earlier in output
            var i = 0
            while (i < copy_len) {
                var src_pos = out_pos - offset
                set_at(output, out_pos, get_at(output, src_pos))
                out_pos = out_pos + 1
                i = i + 1
            }
        }
    }

    snappy_output_len = out_pos
    return out_pos
}

# Write varint
fn _snappy_write_varint(buf, pos, value) {
    while (value >= 128) {
        set_at(buf, pos, (value % 128) + 128)
        pos = pos + 1
        value = value / 128
    }
    set_at(buf, pos, value)
    pos = pos + 1
    return pos
}

# Read varint
fn _snappy_read_varint(buf, start_pos) {
    var result = SNAPPY_BUF + 327680
    var value = 0
    var shift = 0
    var pos = start_pos

    while (1 == 1) {
        var byte = get_at(buf, pos)
        pos = pos + 1
        value = value + ((byte % 128) * _snappy_pow2(shift))
        shift = shift + 7
        if (byte < 128) {
            break
        }
    }

    set_at(result, 0, value)
    set_at(result, 1, pos - start_pos)
    return result
}

# Power of 2
fn _snappy_pow2(exp) {
    var result = 1
    var i = 0
    while (i < exp) {
        result = result * 2
        i = i + 1
    }
    return result
}

# Get output
fn snappy_get_output() {
    return snappy_output
}

# Get output length
fn snappy_get_output_len() {
    return snappy_output_len
}

# Test Snappy
fn snappy_test() {
    var test_data = "Snappy compression test with repeating data: aaaa bbbb cccc"
    var len = strlen(test_data)

    # Compress
    var comp_len = snappy_compress(test_data, len)
    if (comp_len < 0) {
        serial_print("Snappy test: compression failed")
        return -1
    }

    # Decompress
    var decomp_len = snappy_decompress(snappy_output, comp_len)
    if (decomp_len != len) {
        serial_print("Snappy test: decompression length mismatch")
        return -2
    }

    serial_print("Snappy test: passed")
    return 0
}
