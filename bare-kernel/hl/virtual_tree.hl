// virtual_tree.hl -- Virtual Tree Construction
// Given k key vertices, build compressed tree over key vertices + their pairwise LCAs.
// Requires lca_run() called first; uses lca_query() and lca_tin[].
// O(k^2) parent finding. VT_MAX_KEY=16.
// Runtime buffer: 0x1680000

let mut VT_MAX_KEY  = 16;
let VT_MAX_NODE = 32;

let vt_key    = array(16, 0);
let mut vt_nk     = 0;
let vt_nodes  = array(32, 0);
let mut vt_nn     = 0;
let vt_par    = array(32, -1);
let vt_tmp    = array(64, 0);

fn vt_init() {
    vt_nk = 0;
    vt_nn = 0;
    let mut i = 0;
    while i < 16 { set_at(vt_key, i, 0); i += 1; }
    while i < 32 {
        set_at(vt_nodes, i, 0);
        set_at(vt_par, i, -1);
        i += 1;
    }
    return 0;
}

fn vt_add_key(v) {
    if vt_nk < VT_MAX_KEY {
        set_at(vt_key, vt_nk, v);
        vt_nk += 1;
    }
    return 0;
}

fn _vt_in_nodes(v) {
    let mut i = 0;
    while i < vt_nn {
        if vt_nodes[i] == v { return 1; }
        i += 1;
    }
    return 0;
}

fn _vt_sort_tin() {
    let mut i = 1;
    while i < vt_nn {
        let mut key_v = vt_nodes[i];
        let mut key_t = lca_tin[key_v];
        let mut j = i - 1;
        let mut done = 0;
        let mut ins = i;
        while j >= 0 {
            if done == 0 {
                if lca_tin[vt_nodes[j]] > key_t {
                    ins = j;
                    j -= 1;
                } else {
                    done = 1;
                    j = -1;
                }
            }
        }
        if ins < i {
            let mut k = i;
            while k > ins {
                set_at(vt_nodes, k, vt_nodes[k - 1]);
                k -= 1;
            }
            set_at(vt_nodes, ins, key_v);
        }
        i += 1;
    }
    return 0;
}

fn vt_build() {
    let mut i = 0;
    while i < vt_nk {
        set_at(vt_nodes, i, vt_key[i]);
        i += 1;
    }
    vt_nn = vt_nk;
    i = 0;
    while i < vt_nk {
        let mut j = i + 1;
        while j < vt_nk {
            let mut l = lca_query(vt_key[i], vt_key[j]);
            if _vt_in_nodes(l) == 0 {
                if vt_nn < VT_MAX_NODE {
                    set_at(vt_nodes, vt_nn, l);
                    vt_nn += 1;
                }
            }
            j += 1;
        }
        i += 1;
    }
    _vt_sort_tin();
    i = 0;
    while i < vt_nn {
        let mut v = vt_nodes[i];
        let mut best_par = -1;
        let mut best_depth = -1;
        let mut j = 0;
        while j < vt_nn {
            if j != i {
                let mut w = vt_nodes[j];
                let mut l = lca_query(v, w);
                if l == w {
                    if lca_depth[w] > best_depth {
                        best_depth = lca_depth[w];
                        best_par = w;
                    }
                }
            }
            j += 1;
        }
        set_at(vt_par, i, best_par);
        i += 1;
    }
    return vt_nn;
}

fn vt_par_of(v) {
    let mut i = 0;
    while i < vt_nn {
        if vt_nodes[i] == v { return vt_par[i]; }
        i += 1;
    }
    return 0 - 1;
}

fn vt_test() {
    lca_n = 7;
    lca_add_edge(0, 1);
    lca_add_edge(0, 2);
    lca_add_edge(1, 3);
    lca_add_edge(1, 4);
    lca_add_edge(2, 5);
    lca_add_edge(2, 6);
    lca_run();
    vt_init();
    vt_add_key(3);
    vt_add_key(5);
    vt_add_key(6);
    let mut nn = vt_build();
    let mut p3 = vt_par_of(3);
    let mut p5 = vt_par_of(5);
    let mut p6 = vt_par_of(6);
    print("vt_test: nn=" + to_string(nn) + " par(3)=" + to_string(p3) + " par(5)=" + to_string(p5) + " par(6)=" + to_string(p6));
    if nn == 5 {
        if p3 == 1 {
            if p5 == 2 {
                if p6 == 2 {
                    print("vt_test: PASS");
                    return 1;
                }
            }
        }
    }
    print("vt_test: FAIL");
    return 0;
}

print("virtual_tree.hl loaded");
