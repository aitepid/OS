// stage1.hl -- MBR Boot Sector (compiled to raw 16-bit x86 by hl_image)
//
// This file is documentation of the boot sequence.
// The actual machine code is generated by hl_image::build_stage1().
//
// MEMORY MAP after stage1 executes:
//   0 - 4095 : IVT + BDA (BIOS)
//   4096 - 16383 : Page tables (set up by stage2)
//   31744 - 32255 : Stage 1 (this code, 512 bytes)
//   32768 - 49151 : Stage 2 (loaded from disk)
//   458752          : Stack top
//   1048576+        : Kernel (loaded by stage2 or stage1)
//
// BOOT SEQUENCE:
//   1. BIOS loads this 512-byte MBR at 31744
//   2. We set up stack and segments
//   3. Load stage2 from disk sectors 2..N via INT 13h
//   4. Enable A20 gate
//   5. Print "HL!" to screen
//   6. Far jump to stage2 at 32768

// == H-L Spatial Representation ==
// The boot sector occupies Hilbert address space quadrant (0,0,0)
// All addresses are contiguous on the space-filling curve

quadrant boot_sector {
    // Disable interrupts during setup
    // cli;

    // Zero segment registers
    // xor ax, ax; mov ds, ax; mov es, ax; mov ss, ax

    // Stack at 31744 (grows down)
    // mov sp, 31744; sti

    // Load stage2: INT 13h (AH=02, AL=sectors, CH=cyl, CL=start, DH=head, DL=drive)
    // mov ah, 2; mov al, 16; mov ch, 0; mov cl, 2; mov dh, 0; mov dl, 128
    // mov bx, 32768; int 19

    // Enable A20 via fast method
    // in al, 146; or al, 2; out 146, al

    // Print 'H', 'L', '!'
    // mov ah, 14; mov al, 'H'; int 16
    // mov ah, 14; mov al, 'L'; int 16
    // mov ah, 14; mov al, '!'; int 16

    // Far jump to stage2
    // jmp 0:32768

    // Pad to 510 bytes, then 85 170
}
