// brotli.hl - Brotli Compression (simplified)
// Implements simplified Brotli compression algorithm (Google)

// Window and distance constants
let BROTLI_WINDOW_SIZE = 4096;
let BROTLI_MAX_DISTANCE = 4096;
let BROTLI_WBITS = 10;
let BROTLI_MIN_MATCH = 4;
let BROTLI_MAX_MATCH = 64;

// Command type codes
let BROTLI_INSERT_COPY = 0;
let BROTLI_INSERT_ONLY = 1;
let BROTLI_COPY_ONLY = 2;

// Buffer arrays (replace BROTLI_BUF pointer arithmetic)
let brotli_dict_buf     = array(16384, 0);   // dictionary / history window
let brotli_hash_tbl     = array(2048, 0);    // hash table (2048 slots)
let brotli_out_buf      = array(131072, 0);  // final compressed output
let brotli_block_buf    = array(65536, 0);   // intermediate compressed block
let brotli_match_result = array(2, 0);       // [match_len, match_dist]
let brotli_test_buf     = array(128, 0);     // scratch buffer for _test()

// Mutable compression state
let mut brotli_output_len = 0;
let mut brotli_quality = 5;

fn brotli_init() {
    brotli_output_len = 0;
    brotli_quality = 5;
    print("Brotli compression ready");
    return 0;
}

// Compress data with Brotli
fn brotli_compress(data, data_len) {
    let mut pos = 0;

    // Brotli stream header (simplified): WBITS in upper 4 bits
    let header = BROTLI_WBITS * 16;
    set_at(brotli_out_buf, pos, header);
    pos = pos + 1;

    // Initialize hash table
    _brotli_init_hash();

    // Compress block (LZ77 + simplified Huffman)
    let comp_len = _brotli_compress_block(data, data_len);

    // Copy compressed block data into output buffer
    let mut i = 0;
    while i < comp_len {
        set_at(brotli_out_buf, pos, brotli_block_buf[i]);
        pos = pos + 1;
        i = i + 1;
    }

    // End marker
    set_at(brotli_out_buf, pos, 0);
    pos = pos + 1;

    brotli_output_len = pos;
    return pos;
}

// Compress a block using LZ77-style matching
fn _brotli_compress_block(data, data_len) {
    let mut out_pos = 0;
    let mut pos = 0;
    let mut i = 0;

    while pos < data_len {
        let match = _brotli_find_match(data, pos, data_len);
        let match_len = match[0];
        let match_dist = match[1];

        if match_len >= BROTLI_MIN_MATCH {
            // Emit INSERT_COPY command: cmd + dist_lo + dist_hi + length
            set_at(brotli_block_buf, out_pos, BROTLI_INSERT_COPY);
            out_pos = out_pos + 1;
            // Distance (16-bit little-endian)
            set_at(brotli_block_buf, out_pos, match_dist % 256);
            out_pos = out_pos + 1;
            set_at(brotli_block_buf, out_pos, match_dist / 256);
            out_pos = out_pos + 1;
            // Match length
            set_at(brotli_block_buf, out_pos, match_len);
            out_pos = out_pos + 1;

            // Insert matched positions into hash table
            i = 0;
            while i < match_len && pos + i < data_len {
                _brotli_insert_hash(data, pos + i, data_len);
                i = i + 1;
            }
            pos = pos + match_len;
        }

        if match_len < BROTLI_MIN_MATCH {
            // Accumulate literals until a match is found or limit hit
            let literal_start = pos;
            let mut literal_len = 1;
            pos = pos + 1;

            let mut lit_done = 0;
            while pos < data_len && literal_len < 16 && lit_done == 0 {
                let next_match = _brotli_find_match(data, pos, data_len);
                if next_match[0] >= BROTLI_MIN_MATCH {
                    lit_done = 1;
                }
                if lit_done == 0 {
                    _brotli_insert_hash(data, pos, data_len);
                    literal_len = literal_len + 1;
                    pos = pos + 1;
                }
            }

            // Emit INSERT_ONLY command: cmd + count + bytes
            set_at(brotli_block_buf, out_pos, BROTLI_INSERT_ONLY);
            out_pos = out_pos + 1;
            set_at(brotli_block_buf, out_pos, literal_len);
            out_pos = out_pos + 1;

            i = 0;
            while i < literal_len {
                set_at(brotli_block_buf, out_pos, data[literal_start + i]);
                out_pos = out_pos + 1;
                i = i + 1;
            }
        }
    }

    return out_pos;
}

// Find best LZ77 match using the hash table
fn _brotli_find_match(data, pos, data_len) {
    let mut best_len = 0;
    let mut best_dist = 0;

    if pos + BROTLI_MIN_MATCH > data_len {
        set_at(brotli_match_result, 0, 0);
        set_at(brotli_match_result, 1, 0);
        return brotli_match_result;
    }

    let mut hash = _brotli_hash(data, pos, data_len);
    let candidate = brotli_hash_tbl[hash];

    if candidate > 0 && candidate < pos {
        let distance = pos - candidate;
        if distance <= BROTLI_MAX_DISTANCE {
            let mut match_len = 0;
            let mut match_done = 0;
            while pos + match_len < data_len && candidate + match_len < pos && match_done == 0 {
                let cur_a = data[pos + match_len];
                let cur_b = data[candidate + match_len];
                if cur_a == cur_b {
                    match_len = match_len + 1;
                    if match_len >= BROTLI_MAX_MATCH {
                        match_done = 1;
                    }
                }
                if cur_a != cur_b {
                    match_done = 1;
                }
            }
            if match_len > best_len {
                best_len = match_len;
                best_dist = distance;
            }
        }
    }

    set_at(brotli_match_result, 0, best_len);
    set_at(brotli_match_result, 1, best_dist);
    return brotli_match_result;
}

// 3-byte rolling hash function
fn _brotli_hash(data, pos, data_len) {
    if pos + 2 >= data_len {
        return 0;
    }
    let b0 = data[pos];
    let b1 = data[pos + 1];
    let b2 = data[pos + 2];
    let mut hash = (b0 * 256 + b1 * 16 + b2) % 2048;
    return hash;
}

// Insert current position into the hash table
fn _brotli_insert_hash(data, pos, data_len) {
    let mut hash = _brotli_hash(data, pos, data_len);
    set_at(brotli_hash_tbl, hash, pos);
    return 0;
}

// Clear the hash table before a new compression
fn _brotli_init_hash() {
    let mut i = 0;
    while i < 2048 {
        set_at(brotli_hash_tbl, i, 0);
        i = i + 1;
    }
    return 0;
}

// Decompress Brotli-compressed data into brotli_out_buf
fn brotli_decompress(data, data_len) {
    let mut pos = 1;    // skip 1-byte stream header
    let mut out_pos = 0;

    if data_len < 2 {
        return 0 - 1;
    }

    let mut decomp_done = 0;
    while pos < data_len && decomp_done == 0 {
        let cmd = data[pos];
        pos = pos + 1;

        if cmd == 0 {
            // End marker
            decomp_done = 1;
        }

        if decomp_done == 0 {
            if cmd == BROTLI_INSERT_ONLY {
                // Literal run
                let lit_len = data[pos];
                pos = pos + 1;
                let mut i = 0;
                while i < lit_len && pos < data_len {
                    set_at(brotli_out_buf, out_pos, data[pos]);
                    out_pos = out_pos + 1;
                    pos = pos + 1;
                    i = i + 1;
                }
            }

            if cmd == BROTLI_INSERT_COPY {
                // Back-reference copy
                let distance_low = data[pos];
                pos = pos + 1;
                let distance_high = data[pos];
                pos = pos + 1;
                let distance = distance_low + distance_high * 256;
                let copy_len = data[pos];
                pos = pos + 1;

                let mut i = 0;
                while i < copy_len {
                    let src_pos = out_pos - distance;
                    if src_pos >= 0 && src_pos < out_pos {
                        set_at(brotli_out_buf, out_pos, brotli_out_buf[src_pos]);
                        out_pos = out_pos + 1;
                    }
                    i = i + 1;
                }
            }
        }
    }

    brotli_output_len = out_pos;
    return out_pos;
}

// Set compression quality level (0-9)
fn brotli_set_quality(quality) {
    if quality >= 0 && quality <= 9 {
        brotli_quality = quality;
        return 0;
    }
    return 0 - 1;
}

// Return the output buffer reference
fn brotli_get_output() {
    return brotli_out_buf;
}

// Return the number of bytes in the output buffer
fn brotli_get_output_len() {
    return brotli_output_len;
}

// Return compression ratio as integer percentage (compressed / original * 100)
fn brotli_get_ratio(original_len) {
    if original_len == 0 {
        return 0;
    }
    return (brotli_output_len * 100) / original_len;
}

// Self-test: compress a string and verify the decompressed length matches
fn brotli_test() {
    let test_str = "Brotli compression by Google, optimized for HTTP: repeat repeat repeat";
    let str_len = len(test_str);

    // Copy string bytes into a byte array for the compressor
    let mut i = 0;
    while i < str_len {
        set_at(brotli_test_buf, i, str_char_code(test_str, i));
        i = i + 1;
    }

    brotli_init();

    let comp_len = brotli_compress(brotli_test_buf, str_len);
    if comp_len < 0 {
        print("Brotli test: compression failed");
        return 0 - 1;
    }

    let decomp_len = brotli_decompress(brotli_out_buf, comp_len);
    if decomp_len != str_len {
        print("Brotli test: decompression length mismatch");
        return 0 - 2;
    }

    print("Brotli test: passed");
    return 0;
}

_test();
print("brotli.hl loaded");
