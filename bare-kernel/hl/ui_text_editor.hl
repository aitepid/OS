// ui_text_editor.hl -- HicOS Graphical Text Editor
//
// Simple graphical editor window:
//   - Up to 512 lines, each up to 256 characters
//   - Keyboard-driven cursor: arrows, Home, End, PgUp, PgDn, Enter, Backspace
//   - Line-based editing (insert / delete characters)
//   - VFS open/save integration (vfs_open / vfs_read / vfs_write / vfs_close)
//   - Status bar: filename, cursor position, dirty flag
//
// Key constants:
//   UITXED_WINDOW_W = 720  UITXED_WINDOW_H = 500
//   UITXED_MAX_LINES = 512  UITXED_LINE_W = 256
//   UITXED_CHAR_W = 8  UITXED_CHAR_H = 16

let UITXED_WINDOW_W  = 720;
let UITXED_WINDOW_H  = 500;
let UITXED_MAX_LINES = 512;
let UITXED_LINE_W    = 256;
let UITXED_CHAR_W    = 8;
let UITXED_CHAR_H    = 16;
let UITXED_MARGIN_X  = 8;
let UITXED_MARGIN_Y  = 30;   // below titlebar
let UITXED_STATUS_H  = 20;

// Scancode constants for keyboard handling
let TXED_KEY_LEFT   = 0x4B;
let TXED_KEY_RIGHT  = 0x4D;
let TXED_KEY_UP     = 0x48;
let TXED_KEY_DOWN   = 0x50;
let TXED_KEY_HOME   = 0x47;
let TXED_KEY_END    = 0x4F;
let TXED_KEY_PGUP   = 0x49;
let TXED_KEY_PGDN   = 0x51;
let TXED_KEY_DEL    = 0x53;
let TXED_KEY_ENTER  = 13;
let TXED_KEY_BS     = 8;
let TXED_KEY_ESC    = 27;

// --- Editor State ---
let mut uitxed_window_id  = 0 - 1;
let mut uitxed_lines      = [];   // array of strings (one per line)
let mut uitxed_line_count = 0;
let mut uitxed_cursor_row = 0;
let mut uitxed_cursor_col = 0;
let mut uitxed_scroll_top = 0;    // first visible line index
let mut uitxed_filename   = "";
let mut uitxed_dirty      = 0;    // 1 = unsaved changes

fn uitxed_init() {
    uitxed_lines      = [""];
    uitxed_line_count = 1;
    uitxed_cursor_row = 0;
    uitxed_cursor_col = 0;
    uitxed_scroll_top = 0;
    uitxed_filename   = "untitled";
    uitxed_dirty      = 0;
    return 0;
}

// --- Line helpers ---

fn uitxed_cur_line() {
    if uitxed_cursor_row >= uitxed_line_count { return ""; }
    return uitxed_lines[uitxed_cursor_row];
}

fn uitxed_set_line(row, s) {
    if row >= 0 {
        if row < uitxed_line_count {
            set_at(uitxed_lines, row, s);
        }
    }
    return 0;
}

fn uitxed_clamp_col() {
    let line = uitxed_cur_line();
    let max_col = len(line);
    if uitxed_cursor_col > max_col { uitxed_cursor_col = max_col; }
    if uitxed_cursor_col < 0 { uitxed_cursor_col = 0; }
    return 0;
}

// --- Cursor movement ---

fn uitxed_move_left() {
    if uitxed_cursor_col > 0 {
        uitxed_cursor_col = uitxed_cursor_col - 1;
        return 0;
    }
    if uitxed_cursor_row > 0 {
        uitxed_cursor_row = uitxed_cursor_row - 1;
        uitxed_cursor_col = len(uitxed_cur_line());
    }
    return 0;
}

fn uitxed_move_right() {
    let line = uitxed_cur_line();
    if uitxed_cursor_col < len(line) {
        uitxed_cursor_col = uitxed_cursor_col + 1;
        return 0;
    }
    if uitxed_cursor_row < uitxed_line_count - 1 {
        uitxed_cursor_row = uitxed_cursor_row + 1;
        uitxed_cursor_col = 0;
    }
    return 0;
}

fn uitxed_move_up() {
    if uitxed_cursor_row > 0 {
        uitxed_cursor_row = uitxed_cursor_row - 1;
        uitxed_clamp_col();
    }
    return 0;
}

fn uitxed_move_down() {
    if uitxed_cursor_row < uitxed_line_count - 1 {
        uitxed_cursor_row = uitxed_cursor_row + 1;
        uitxed_clamp_col();
    }
    return 0;
}

fn uitxed_scroll_adjust() {
    let content_h = UITXED_WINDOW_H - UITXED_MARGIN_Y - UITXED_STATUS_H;
    let visible_rows = content_h / UITXED_CHAR_H;
    if uitxed_cursor_row < uitxed_scroll_top {
        uitxed_scroll_top = uitxed_cursor_row;
    }
    if uitxed_cursor_row >= uitxed_scroll_top + visible_rows {
        uitxed_scroll_top = uitxed_cursor_row - visible_rows + 1;
    }
    return 0;
}

// --- Editing operations ---

// Insert character ch at current cursor position
fn uitxed_insert_char(ch) {
    let line = uitxed_cur_line();
    if len(line) >= UITXED_LINE_W { return 0; }
    let before = str_sub(line, 0, uitxed_cursor_col);
    let after  = str_sub(line, uitxed_cursor_col, len(line));
    uitxed_set_line(uitxed_cursor_row, before + str_from_code(ch) + after);
    uitxed_cursor_col = uitxed_cursor_col + 1;
    uitxed_dirty = 1;
    return 0;
}

// Delete character before cursor (backspace)
fn uitxed_backspace() {
    if uitxed_cursor_col > 0 {
        let line = uitxed_cur_line();
        let before = str_sub(line, 0, uitxed_cursor_col - 1);
        let after  = str_sub(line, uitxed_cursor_col, len(line));
        uitxed_set_line(uitxed_cursor_row, before + after);
        uitxed_cursor_col = uitxed_cursor_col - 1;
        uitxed_dirty = 1;
        return 0;
    }
    // Merge with previous line
    if uitxed_cursor_row > 0 {
        let mut cur = uitxed_cur_line();
        let mut prev = uitxed_lines[uitxed_cursor_row - 1];
        let new_col = len(prev);
        uitxed_set_line(uitxed_cursor_row - 1, prev + cur);
        // Remove current line
        let mut new_lines = [];
        let mut i = 0;
        while i < uitxed_line_count {
            if i != uitxed_cursor_row { push(new_lines, uitxed_lines[i]); }
            i = i + 1;
        }
        uitxed_lines = new_lines;
        uitxed_line_count = uitxed_line_count - 1;
        uitxed_cursor_row = uitxed_cursor_row - 1;
        uitxed_cursor_col = new_col;
        uitxed_dirty = 1;
    }
    return 0;
}

// Delete character at cursor (Del key)
fn uitxed_delete_char() {
    let line = uitxed_cur_line();
    if uitxed_cursor_col < len(line) {
        let before = str_sub(line, 0, uitxed_cursor_col);
        let after  = str_sub(line, uitxed_cursor_col + 1, len(line));
        uitxed_set_line(uitxed_cursor_row, before + after);
        uitxed_dirty = 1;
        return 0;
    }
    // Merge next line into current
    if uitxed_cursor_row < uitxed_line_count - 1 {
        let mut next = uitxed_lines[uitxed_cursor_row + 1];
        uitxed_set_line(uitxed_cursor_row, line + next);
        let mut new_lines = [];
        let mut i = 0;
        while i < uitxed_line_count {
            if i != uitxed_cursor_row + 1 { push(new_lines, uitxed_lines[i]); }
            i = i + 1;
        }
        uitxed_lines = new_lines;
        uitxed_line_count = uitxed_line_count - 1;
        uitxed_dirty = 1;
    }
    return 0;
}

// Insert newline (Enter key): split current line at cursor
fn uitxed_newline() {
    if uitxed_line_count >= UITXED_MAX_LINES { return 0; }
    let line = uitxed_cur_line();
    let before = str_sub(line, 0, uitxed_cursor_col);
    let after  = str_sub(line, uitxed_cursor_col, len(line));
    uitxed_set_line(uitxed_cursor_row, before);
    // Insert new line after current
    let mut new_lines = [];
    let mut i = 0;
    while i <= uitxed_cursor_row {
        push(new_lines, uitxed_lines[i]);
        i = i + 1;
    }
    push(new_lines, after);
    while i < uitxed_line_count {
        push(new_lines, uitxed_lines[i]);
        i = i + 1;
    }
    uitxed_lines = new_lines;
    uitxed_line_count = uitxed_line_count + 1;
    uitxed_cursor_row = uitxed_cursor_row + 1;
    uitxed_cursor_col = 0;
    uitxed_dirty = 1;
    return 0;
}

// --- VFS file I/O ---

fn uitxed_load(path) {
    let fd = vfs_open(path, O_RDONLY);
    if fd < 0 { return 0 - 1; }

    let buf_addr = 9699328;  // 0x940000 scratch buffer for editor
    let mut n = vfs_read(fd, buf_addr, 65536);
    vfs_close(fd);
    if n <= 0 { return 0; }

    // Parse buffer into lines (split on '\n')
    uitxed_lines = [];
    uitxed_line_count = 0;
    let mut cur = "";
    let mut i = 0;
    while i < n {
        let mut c = mem_read_u8(buf_addr + i);
        if c == 10 {   // '\n'
            push(uitxed_lines, cur);
            uitxed_line_count = uitxed_line_count + 1;
            cur = "";
        } else {
            if c != 13 {  // skip '\r'
                cur = cur + str_from_code(c);
            }
        }
        i = i + 1;
    }
    if len(cur) > 0 {
        push(uitxed_lines, cur);
        uitxed_line_count = uitxed_line_count + 1;
    }
    if uitxed_line_count == 0 {
        push(uitxed_lines, "");
        uitxed_line_count = 1;
    }

    uitxed_filename   = path;
    uitxed_cursor_row = 0;
    uitxed_cursor_col = 0;
    uitxed_scroll_top = 0;
    uitxed_dirty      = 0;
    return uitxed_line_count;
}

fn uitxed_save() {
    let fd = vfs_open(uitxed_filename, O_CREAT + O_WRONLY + O_TRUNC);
    if fd < 0 { return 0 - 1; }

    let buf_addr = 9699328;  // 0x940000
    let mut off = 0;
    let mut i = 0;
    while i < uitxed_line_count {
        let line = uitxed_lines[i];
        let mut j = 0;
        while j < len(line) {
            mem_write_u8(buf_addr + off, str_char_at(line, j));
            off = off + 1;
            j = j + 1;
        }
        mem_write_u8(buf_addr + off, 10);  // '\n'
        off = off + 1;
        i = i + 1;
    }
    vfs_write(fd, buf_addr, off);
    vfs_close(fd);
    uitxed_dirty = 0;
    return off;
}

fn uitxed_save_as(path) {
    uitxed_filename = path;
    return uitxed_save();
}

// --- Rendering ---

fn uitxed_render(window_id) {
    let mut addr = WM_TABLE_ADDR + window_id * 128;
    let wx = mem_read_u64(addr + 8);
    let wy = mem_read_u64(addr + 16);
    let ww = mem_read_u64(addr + 24);
    let wh = mem_read_u64(addr + 32);

    // Background
    vesa_fill_rect(wx, wy, ww, wh, ui_theme_surface_color());
    // Titlebar
    vesa_fill_rect(wx, wy, ww, 24, ui_theme_titlebar_color());
    let title = "Editor — " + uitxed_filename;
    if uitxed_dirty == 1 { title = title + " *"; }
    ui_draw_text(wx + 8, wy + 4, title, ui_theme_text_color(), 0);

    // Line number gutter (40px wide)
    let gutter_w = 40;
    vesa_fill_rect(wx, wy + UITXED_MARGIN_Y, gutter_w, wh - UITXED_MARGIN_Y - UITXED_STATUS_H, ui_theme_panel_color());
    vesa_vline(wx + gutter_w, wy + UITXED_MARGIN_Y, wh - UITXED_MARGIN_Y - UITXED_STATUS_H, ui_theme_border_color());

    // Text area
    let content_h = wh - UITXED_MARGIN_Y - UITXED_STATUS_H;
    let visible_rows = content_h / UITXED_CHAR_H;
    let text_x = wx + gutter_w + UITXED_MARGIN_X;

    uitxed_scroll_adjust();

    let mut row = 0;
    while row < visible_rows {
        let line_idx = uitxed_scroll_top + row;
        if line_idx >= uitxed_line_count { row = visible_rows; }
        if row < visible_rows {
            let line_y = wy + UITXED_MARGIN_Y + row * UITXED_CHAR_H;
            let lnum   = line_idx + 1;
            let lnum_s = to_string(lnum);

            ui_label_colored(wx + 4, line_y + 1, lnum_s, ui_theme_text_muted_color());

            if line_idx == uitxed_cursor_row {
                vesa_fill_rect(wx + gutter_w + 1, line_y, ww - gutter_w - 1, UITXED_CHAR_H, ui_theme_accent_color());
            }

            let line = uitxed_lines[line_idx];
            ui_draw_text(text_x, line_y + 1, line, ui_theme_text_color(), 0);

            if line_idx == uitxed_cursor_row {
                let cx = text_x + uitxed_cursor_col * UITXED_CHAR_W;
                vesa_vline(cx, line_y, UITXED_CHAR_H, ui_theme_text_color());
            }

            row = row + 1;
        }
    }

    // Status bar
    let status_y = wy + wh - UITXED_STATUS_H;
    vesa_fill_rect(wx, status_y, ww, UITXED_STATUS_H, ui_theme_titlebar_color());
    vesa_hline(wx, status_y, ww, ui_theme_border_color());
    let pos_s = "Ln " + to_string(uitxed_cursor_row + 1) + ", Col " + to_string(uitxed_cursor_col + 1);
    let dirty_s = " [modified]";
    let clean_s = " [saved]";
    let flag_s = clean_s;
    if uitxed_dirty == 1 { flag_s = dirty_s; }
    ui_draw_text(wx + 8, status_y + 2, pos_s + flag_s, ui_theme_text_color(), 0);
    let total_s = to_string(uitxed_line_count) + " lines";
    ui_draw_text(wx + ww - 80, status_y + 2, total_s, ui_theme_text_muted_color(), 0);

    return 0;
}

// --- Keyboard input ---

fn uitxed_handle_key(key) {
    if key == TXED_KEY_LEFT  { uitxed_move_left();  return 1; }
    if key == TXED_KEY_RIGHT { uitxed_move_right(); return 1; }
    if key == TXED_KEY_UP    { uitxed_move_up();    return 1; }
    if key == TXED_KEY_DOWN  { uitxed_move_down();  return 1; }

    if key == TXED_KEY_HOME {
        uitxed_cursor_col = 0;
        return 1;
    }
    if key == TXED_KEY_END {
        uitxed_cursor_col = len(uitxed_cur_line());
        return 1;
    }
    if key == TXED_KEY_PGUP {
        let content_h = UITXED_WINDOW_H - UITXED_MARGIN_Y - UITXED_STATUS_H;
        let visible_rows = content_h / UITXED_CHAR_H;
        uitxed_cursor_row = uitxed_cursor_row - visible_rows;
        if uitxed_cursor_row < 0 { uitxed_cursor_row = 0; }
        uitxed_clamp_col();
        return 1;
    }
    if key == TXED_KEY_PGDN {
        let content_h = UITXED_WINDOW_H - UITXED_MARGIN_Y - UITXED_STATUS_H;
        let visible_rows = content_h / UITXED_CHAR_H;
        uitxed_cursor_row = uitxed_cursor_row + visible_rows;
        if uitxed_cursor_row >= uitxed_line_count { uitxed_cursor_row = uitxed_line_count - 1; }
        uitxed_clamp_col();
        return 1;
    }
    if key == TXED_KEY_DEL {
        uitxed_delete_char();
        return 1;
    }
    if key == TXED_KEY_BS {
        uitxed_backspace();
        return 1;
    }
    if key == TXED_KEY_ENTER {
        uitxed_newline();
        return 1;
    }
    // Ctrl+C (3): copy current line to clipboard
    if key == 3 {
        clipboard_copy_text(uitxed_cur_line());
        return 1;
    }
    // Ctrl+V (22): paste clipboard text at cursor (single line only)
    if key == 22 {
        let ptext = clipboard_paste();
        let mut ci = 0;
        while ci < len(ptext) {
            let ch = str_char_at(ptext, ci);
            if ch >= 32 {
                if ch <= 126 {
                    uitxed_insert_char(ch);
                }
            }
            ci = ci + 1;
        }
        return 1;
    }
    // Ctrl+S (19): save file
    if key == 19 {
        uitxed_save();
        return 1;
    }
    // Printable ASCII (32-126)
    if key >= 32 {
        if key <= 126 {
            uitxed_insert_char(key);
            return 1;
        }
    }
    return 0;
}

// --- Window lifecycle ---

fn uitxed_open(path) {
    uitxed_init();
    if len(path) > 0 {
        let ok = uitxed_load(path);
        if ok < 0 { uitxed_filename = path; }
    }
    uitxed_window_id = wm_create_window(30, 30, UITXED_WINDOW_W, UITXED_WINDOW_H, "Editor");
    if uitxed_window_id < 0 {
        klog(3, "UI", "Failed to create editor window");
        return 0 - 1;
    }
    return uitxed_window_id;
}

fn uitxed_close() {
    if uitxed_window_id >= 0 {
        wm_close_window(uitxed_window_id);
        uitxed_window_id = 0 - 1;
    }
    uitxed_lines = [];
    uitxed_line_count = 0;
    uitxed_dirty = 0;
    return 0;
}

fn uitxed_update() {
    if uitxed_window_id < 0 { return 0; }
    uitxed_render(uitxed_window_id);
    return 0;
}

fn uitxed_is_open() {
    if uitxed_window_id < 0 { return 0; }
    return 1;
}

print("ui_text_editor.hl loaded");
print("Editor: " + to_string(UITXED_MAX_LINES) + " lines x " + to_string(UITXED_LINE_W) + " cols, VFS open/save, keyboard nav");
