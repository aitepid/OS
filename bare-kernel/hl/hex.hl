// hex.hl -- Hexadecimal Encoding/Decoding Utilities
//
// Hexadecimal encoding converts binary data to readable hex strings.
// Each byte -> 2 hex characters (0-9, A-F).
//
// Features:
//   - Encode binary data to hex string
//   - Decode hex string to binary data
//   - Support both uppercase and lowercase hex
//   - Pretty-print hex dumps with offsets and ASCII
//   - Parse hex strings with optional spacing/delimiters
//
// Memory:
//   - HEX_BUF: 0x1050000 (17104896), 64 KB encode/decode buffer

let HEX_BUF = 17104896;          // 0x1050000
let HEX_BUF_SZ = 65536;          // 64 KB
let mut hex_len = 0;

fn hex_init() {
    hex_len = 0;
    return 0;
}

fn hex_clear() {
    hex_len = 0;
    return 0;
}

fn _hex_to_char(n) {
    if n < 10 { return 48 + n; }                    // 0-9
    return 65 + (n - 10);                           // A-F
}

fn _hex_from_char(c) {
    if c >= 48 { if c <= 57 { return c - 48; } }    // 0-9
    if c >= 65 { if c <= 70 { return c - 65 + 10; } } // A-F
    if c >= 97 { if c <= 102 { return c - 97 + 10; } } // a-f
    return 0 - 1;
}

fn hex_encode(data) {
    hex_clear();

    let mut i = 0;
    while i < len(data) {
        let mut b = str_char_code(data, i);
        let mut hi = b / 16;
        let mut lo = b % 16;

        if hex_len >= HEX_BUF_SZ { return 0 - 1; }
        mem_write_byte(HEX_BUF + hex_len, _hex_to_char(hi));
        hex_len = hex_len + 1;

        if hex_len >= HEX_BUF_SZ { return 0 - 1; }
        mem_write_byte(HEX_BUF + hex_len, _hex_to_char(lo));
        hex_len = hex_len + 1;

        i = i + 1;
    }

    return hex_len;
}

fn hex_decode(data) {
    hex_clear();

    let mut i = 0;
    while i < len(data) {
        let mut c = str_char_code(data, i);

        if c == 32 { i = i + 1; }
        if c == 58 { i = i + 1; }
        if c == 45 { i = i + 1; }

        if c != 32 { if c != 58 { if c != 45 {
            if i + 1 < len(data) {
                let mut hi = _hex_from_char(c);
                let mut lo = _hex_from_char(str_char_code(data, i + 1));

                if hi >= 0 { if lo >= 0 {
                    let mut b = hi * 16 + lo;
                    if hex_len >= HEX_BUF_SZ { return 0 - 1; }
                    mem_write_byte(HEX_BUF + hex_len, b);
                    hex_len = hex_len + 1;
                    i = i + 2;
                } else {
                    i = i + 1;
                }} else {
                    i = i + 1;
                }
            } else {
                i = i + 1;
            }
        }}}

        if i <= 0 { i = 1; }
    }

    return hex_len;
}

fn hex_get_result() {
    let mut result = "";
    let mut i = 0;
    while i < hex_len {
        result = result + str_from_code(mem_read_byte(HEX_BUF + i));
        i = i + 1;
    }
    return result;
}

fn hex_dump(data, offset, length) {
    let mut out = "";
    let mut i = 0;

    while i < length {
        if i + offset >= len(data) { i = length; }

        if i % 16 == 0 {
            let mut addr = offset + i;
            let mut addr_str = "";
            let mut a = addr;
            let mut j = 0;
            while j < 8 {
                let digit = a % 16;
                a = a / 16;
                let mut c = _hex_to_char(digit);
                addr_str = str_from_code(c) + addr_str;
                j = j + 1;
            }
            out = out + addr_str + ":  ";
        }

        if i + offset < len(data) {
            let mut b = str_char_code(data, i + offset);
            let mut hi = b / 16;
            let mut lo = b % 16;
            out = out + str_from_code(_hex_to_char(hi)) + str_from_code(_hex_to_char(lo)) + " ";
        } else {
            out = out + "   ";
        }

        if i % 16 == 15 {
            out = out + " ";
            let mut j = i - 15;
            while j <= i {
                if j + offset < len(data) {
                    let mut b = str_char_code(data, j + offset);
                    if b >= 32 { if b <= 126 {
                        out = out + str_from_code(b);
                    } else {
                        out = out + ".";
                    }} else {
                        out = out + ".";
                    }
                } else {
                    out = out + " ";
                }
                j = j + 1;
            }
            out = out + "\n";
        }

        i = i + 1;
    }

    if length % 16 != 0 {
        let remaining = length % 16;
        let padding = 16 - remaining;
        let mut p = 0;
        while p < padding {
            out = out + "   ";
            p = p + 1;
        }
        out = out + " ";

        let mut j = length - remaining;
        while j < length {
            if j + offset < len(data) {
                let mut b = str_char_code(data, j + offset);
                if b >= 32 { if b <= 126 {
                    out = out + str_from_code(b);
                } else {
                    out = out + ".";
                }} else {
                    out = out + ".";
                }
            }
            j = j + 1;
        }
        out = out + "\n";
    }

    return out;
}

fn hex_selftest() {
    let test_data = "abc";
    let mut n = hex_encode(test_data);
    if n < 0 { return "hex selftest: encode failed"; }

    let encoded = hex_get_result();
    let expected = "616263";

    if encoded != expected {
        return "hex selftest: encode mismatch (expected=" + expected + ", got=" + encoded + ")";
    }

    let mut m = hex_decode(encoded);
    if m < 0 { return "hex selftest: decode failed"; }

    let decoded = hex_get_result();
    if decoded != test_data {
        return "hex selftest: roundtrip failed";
    }

    return "hex selftest: pass";
}

print("hex.hl loaded");
