// interval_tree.hl -- Augmented interval tree (sorted array + suffix-max)
// Intervals sorted by lo endpoint; suffix-max[i] = max hi from i to n-1.
// Overlap and stabbing queries with O(k) worst-case via early termination.
// IT_MAX_N=64 intervals.
//
// Runtime buffer: 0x14E0000 (4 KB)

let IT_MAX_N = 64;

let it_lo     = array(64, 0);   // interval low endpoints (sorted ascending)
let it_hi     = array(64, 0);   // interval high endpoints
let it_id     = array(64, 0);   // insertion-order ID (1-based)
let it_max_suf = array(65, 0);  // suffix-max: it_max_suf[i] = max(it_hi[i..n-1])
let it_n      = 0;              // current count

// Query result
let it_res     = array(64, 0);  // matching interval IDs
let it_res_cnt = 0;

fn interval_tree_init() {
    let i = 0;
    while i < IT_MAX_N {
        set_at(it_lo, i, 0);
        set_at(it_hi, i, 0);
        set_at(it_id, i, 0);
        i += 1;
    }
    i = 0;
    while i <= IT_MAX_N {
        set_at(it_max_suf, i, 0);
        i += 1;
    }
    it_n = 0;
    it_res_cnt = 0;
    return 0;
}

// Rebuild suffix-max in one reverse pass
fn _it_rebuild_max() {
    set_at(it_max_suf, it_n, 0);
    let i = 0;
    while i < it_n {
        let j = it_n - 1 - i;
        let m = it_hi[j];
        if it_max_suf[j + 1] > m { m = it_max_suf[j + 1]; }
        set_at(it_max_suf, j, m);
        i += 1;
    }
    return 0;
}

// Insert interval [lo, hi]; maintains sorted order by lo
fn it_insert(lo, hi) {
    if it_n >= IT_MAX_N { return -1; }
    let new_id = it_n + 1;
    // Insertion sort: find position
    let pos  = it_n;
    let done = 0;
    while done == 0 {
        if pos == 0 {
            done = 1;
        } else {
            if it_lo[pos - 1] <= lo {
                done = 1;
            } else {
                set_at(it_lo, pos, it_lo[pos - 1]);
                set_at(it_hi, pos, it_hi[pos - 1]);
                set_at(it_id, pos, it_id[pos - 1]);
                pos -= 1;
            }
        }
    }
    set_at(it_lo, pos, lo);
    set_at(it_hi, pos, hi);
    set_at(it_id, pos, new_id);
    it_n += 1;
    _it_rebuild_max();
    return new_id;
}

// Stabbing query: find all intervals containing point q
fn it_stab(q) {
    it_res_cnt = 0;
    let i = 0;
    while i < it_n {
        // If max hi in remaining suffix < q, no interval can contain q
        if it_max_suf[i] < q {
            i = it_n;
        } else {
            // Since sorted by lo: if lo > q, all remaining lo >= current lo > q
            if it_lo[i] > q {
                i = it_n;
            } else {
                if it_hi[i] >= q {
                    if it_res_cnt < IT_MAX_N {
                        set_at(it_res, it_res_cnt, it_id[i]);
                        it_res_cnt += 1;
                    }
                }
                i += 1;
            }
        }
    }
    return it_res_cnt;
}

// Overlap query: find all intervals overlapping [qlo, qhi]
// Overlap condition: it_lo[i] <= qhi AND it_hi[i] >= qlo
fn it_overlap(qlo, qhi) {
    it_res_cnt = 0;
    let i = 0;
    while i < it_n {
        // Suffix-max early termination: if max hi < qlo, nothing overlaps
        if it_max_suf[i] < qlo {
            i = it_n;
        } else {
            // Sorted lo early termination: if lo > qhi, remaining can't overlap
            if it_lo[i] > qhi {
                i = it_n;
            } else {
                if it_hi[i] >= qlo {
                    if it_res_cnt < IT_MAX_N {
                        set_at(it_res, it_res_cnt, it_id[i]);
                        it_res_cnt += 1;
                    }
                }
                i += 1;
            }
        }
    }
    return it_res_cnt;
}

fn it_test() {
    interval_tree_init();
    // Insert [1,5] [3,7] [2,6] [8,10] [4,9]
    // Sorted by lo: [1,5] [2,6] [3,7] [4,9] [8,10]
    it_insert(1, 5);
    it_insert(3, 7);
    it_insert(2, 6);
    it_insert(8, 10);
    it_insert(4, 9);
    // Stab(4): [1,5],[2,6],[3,7],[4,9] => 4
    let c1 = it_stab(4);
    // Overlap([5,8]): all 5 intervals => 5
    let c2 = it_overlap(5, 8);
    // Overlap([11,20]): none => 0
    let c3 = it_overlap(11, 20);
    print("it_test stab(4)=" + to_string(c1) + " overlap(5,8)=" + to_string(c2) + " overlap(11,20)=" + to_string(c3));
    return c1;
}

print("interval_tree.hl loaded");
