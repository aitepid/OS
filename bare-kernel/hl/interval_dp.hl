// interval_dp.hl -- interval DP: matrix chain multiplication O(n^3) (iter 326)
// Buffer: 0x17D0000
// idp_dp[i][j] = min cost to multiply matrices i..j
// idp_dims[0..n]: matrix dimensions (matrix i is dims[i] x dims[i+1])

let IDP_MAX  = 16;
let IDP_INF  = 999999;

let idp_dims = array(17, 0);
let idp_dp   = array(256, 0);
let idp_n    = 0;

fn idp_init() {
    idp_n = 0;
    let i = 0;
    while i < 17 {
        set_at(idp_dims, i, 0);
        i += 1;
    }
    i = 0;
    while i < 256 {
        set_at(idp_dp, i, 0);
        i += 1;
    }
    return 0;
}

fn idp_matchain(n) {
    idp_n = n;
    let i    = 0;
    let j    = 0;
    let k    = 0;
    let len  = 0;
    let cost = 0;
    i = 0;
    while i < n {
        j = 0;
        while j < n {
            if i == j {
                set_at(idp_dp, i * IDP_MAX + j, 0);
            } else {
                set_at(idp_dp, i * IDP_MAX + j, IDP_INF);
            }
            j += 1;
        }
        i += 1;
    }
    len = 2;
    while len <= n {
        i = 0;
        while i <= n - len {
            j = i + len - 1;
            k = i;
            while k < j {
                cost = idp_dp[i * IDP_MAX + k] +
                       idp_dp[(k + 1) * IDP_MAX + j] +
                       idp_dims[i] * idp_dims[k + 1] * idp_dims[j + 1];
                if cost < idp_dp[i * IDP_MAX + j] {
                    set_at(idp_dp, i * IDP_MAX + j, cost);
                }
                k += 1;
            }
            i += 1;
        }
        len += 1;
    }
    return idp_dp[0 * IDP_MAX + (n - 1)];
}

fn idp_test() {
    idp_init();
    // 3 matrices: (1x2)(2x3)(3x4) — classic example
    set_at(idp_dims, 0, 1);
    set_at(idp_dims, 1, 2);
    set_at(idp_dims, 2, 3);
    set_at(idp_dims, 3, 4);
    let opt = idp_matchain(3);
    // dp[0][1]=1*2*3=6, dp[1][2]=2*3*4=24
    // dp[0][2]=min(dp[0][0]+dp[1][2]+1*2*4, dp[0][1]+dp[2][2]+1*3*4)
    //         =min(0+24+8, 6+0+12) = min(32,18) = 18
    let dp01 = idp_dp[0 * IDP_MAX + 1];
    let dp12 = idp_dp[1 * IDP_MAX + 2];
    print("idp_test: dp[0][1]=" + to_string(dp01) +
          " dp[1][2]=" + to_string(dp12) +
          " opt=" + to_string(opt));
    if dp01 == 6 {
        if dp12 == 24 {
            if opt == 18 {
                print("idp_test: PASS");
                return 1;
            }
        }
    }
    print("idp_test: FAIL");
    return 0;
}

print("interval_dp.hl loaded");
