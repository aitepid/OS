// pci.hl -- PCI Bus Enumeration
//
// Scans PCI configuration space via I/O ports 0xCF8/0xCFC.
// Discovers devices on bus 0 (single-bus scan for simplicity).
//
// PCI config address format (port 0xCF8):
//   bit 31    = enable
//   bits 23:16 = bus number
//   bits 15:11 = device number (0-31)
//   bits 10:8  = function number (0-7)
//   bits 7:2   = register offset (dword-aligned)
//
// Key registers per device:
//   0x00: vendor_id (16) | device_id (16)
//   0x08: revision (8) | prog_if (8) | subclass (8) | class (8)
//   0x0C: cache_line (8) | latency (8) | header_type (8) | bist (8)
//   0x10-0x24: BAR0-BAR5 (Base Address Registers)
//   0x3C: interrupt_line (8) | interrupt_pin (8)

let PCI_CONFIG_ADDR = 3320;
let PCI_CONFIG_DATA = 3324;

// Read 32 bits from PCI config space
fn pci_config_read32(bus, device, func, offset) {
    let mut addr = 2147483648
             + bus * 65536
             + device * 2048
             + func * 256
             + (offset / 4) * 4;
    port_out_u32(PCI_CONFIG_ADDR, addr);
    return port_in_u32(PCI_CONFIG_DATA);
}

// Read 16-bit value from PCI config
fn pci_config_read16(bus, device, func, offset) {
    let dword = pci_config_read32(bus, device, func, offset);
    if offset % 4 == 0 { return dword % 65536; }
    return (dword / 65536) % 65536;
}

// Write 32 bits to PCI config space
fn pci_config_write32(bus, device, func, offset, val) {
    let mut addr = 2147483648
             + bus * 65536
             + device * 2048
             + func * 256
             + (offset / 4) * 4;
    port_out_u32(PCI_CONFIG_ADDR, addr);
    port_out_u32(PCI_CONFIG_DATA, val);
    return 1;
}

// Write 16 bits to PCI config space
fn pci_config_write16(bus, device, func, offset, val) {
    let old = pci_config_read32(bus, device, func, offset);
    let mut new_val = 0;
    if offset % 4 == 0 {
        new_val = (old / 65536) * 65536 + (val % 65536);
    } else {
        new_val = (val % 65536) * 65536 + (old % 65536);
    }
    pci_config_write32(bus, device, func, offset, new_val);
    return 1;
}

// Get vendor ID
fn pci_vendor_id(bus, dev, func) {
    return pci_config_read16(bus, dev, func, 0);
}

// Get device ID
fn pci_device_id(bus, dev, func) {
    return pci_config_read16(bus, dev, func, 2);
}

// Get class code
fn pci_class(bus, dev, func) {
    let reg = pci_config_read32(bus, dev, func, 8);
    return (reg / 16777216) % 256;
}

// Get subclass
fn pci_subclass(bus, dev, func) {
    let reg = pci_config_read32(bus, dev, func, 8);
    return (reg / 65536) % 256;
}

// Get header type
fn pci_header_type(bus, dev, func) {
    let reg = pci_config_read32(bus, dev, func, 12);
    return (reg / 65536) % 256;
}

// Get BAR value
fn pci_bar(bus, dev, func, bar_idx) {
    return pci_config_read32(bus, dev, func, 16 + bar_idx * 4);
}

// Alias for compatibility
fn pci_read_bar(bus, dev, func, bar_idx) {
    return pci_bar(bus, dev, func, bar_idx);
}

// Get interrupt line
fn pci_interrupt_line(bus, dev, func) {
    let reg = pci_config_read32(bus, dev, func, 60);
    return reg % 256;
}

// Class code names (common ones)
fn pci_class_name(class, subclass) {
    if class == 0 { return "Unclassified"; }
    if class == 1 {
        if subclass == 0 { return "SCSI"; }
        if subclass == 1 { return "IDE"; }
        if subclass == 6 { return "SATA"; }
        if subclass == 8 { return "NVMe"; }
        return "Storage";
    }
    if class == 2 {
        if subclass == 0 { return "Ethernet"; }
        if subclass == 128 { return "Network-other"; }
        return "Network";
    }
    if class == 3 {
        if subclass == 0 { return "VGA"; }
        return "Display";
    }
    if class == 4 { return "Multimedia"; }
    if class == 6 {
        if subclass == 0 { return "Host Bridge"; }
        if subclass == 1 { return "ISA Bridge"; }
        return "Bridge";
    }
    if class == 12 {
        if subclass == 3 { return "USB"; }
        return "Serial Bus";
    }
    return "Unknown";
}

// Scan PCI bus 0, all 32 devices, function 0 only
// Returns array of [bus, dev, func, vendor, device, class, subclass]
fn pci_scan() {
    let mut devices = [];
    let mut dev = 0;
    while dev < 32 {
        let vendor = pci_vendor_id(0, dev, 0);
        if vendor != 65535 {
            let did = pci_device_id(0, dev, 0);
            let cls = pci_class(0, dev, 0);
            let sub = pci_subclass(0, dev, 0);
            push(devices, [0, dev, 0, vendor, did, cls, sub]);

            // Check multi-function
            let htype = pci_header_type(0, dev, 0);
            if (htype / 128) % 2 == 1 {
                let mut func = 1;
                while func < 8 {
                    let fv = pci_vendor_id(0, dev, func);
                    if fv != 65535 {
                        let fd = pci_device_id(0, dev, func);
                        let fc = pci_class(0, dev, func);
                        let fs = pci_subclass(0, dev, func);
                        push(devices, [0, dev, func, fv, fd, fc, fs]);
                    }
                    func = func + 1;
                }
            }
        }
        dev = dev + 1;
    }
    return devices;
}

// Self-test
print("pci.hl loaded");
print("PCI config ports: 0xCF8 / 0xCFC");
print("Scanning bus 0, 32 device slots");

let devs = pci_scan();
let mut i = 0;
let mut n = len(devs);
print("Found " + to_string(n) + " devices on bus 0.");

while i < n {
    let mut d = devs[i];
    let bus = d[0];
    let dev = d[1];
    let func = d[2];
    let vid = d[3];
    let did = d[4];
    let cls = d[5];
    let sub = d[6];

    let name = pci_class_name(cls, sub);
    let line = "PCI " + to_string(bus) + ":" + to_string(dev) + "." + to_string(func);
    let detail = " - " + name + " (Vid: " + to_string(vid) + ", Did: " + to_string(did) + ")";
    print(line + detail);
    i = i + 1;
}
