// wm_snap.hl -- Win11-style window snap layouts
//
// Sprint G3 of HicOS GUI injection (per GUI_DESIGN.md §3.4).
//
// Drag a window near a screen edge and release to dock it:
//   left edge   -> left half
//   right edge  -> right half
//   top edge    -> maximize
//   top-left    -> top-left quarter
//   top-right   -> top-right quarter
//   bottom-left -> bottom-left quarter
//   bottom-right-> bottom-right quarter
//
// Snap Layouts (Win11): hovering the maximize button for 800 ms surfaces
// a 4-zone picker (2-up vertical, 2-up horizontal, 1+2, 3-up). We expose
// the geometry helpers here; the actual picker UI ships in G5 (Shell).
//
// Keyboard shortcuts: Win+Left / Win+Right snap focused window to halves;
// Win+Up maximize; Win+Down restore. The shell hooks those in G5.

let SNAP_EDGE_THRESH  = 16;        // px from edge to trigger snap preview
let SNAP_PREVIEW_ALPHA = 96;       // ghost rectangle alpha

let SNAP_NONE   = 0;
let SNAP_LEFT   = 1;
let SNAP_RIGHT  = 2;
let SNAP_MAX    = 3;
let SNAP_TL     = 4;
let SNAP_TR     = 5;
let SNAP_BL     = 6;
let SNAP_BR     = 7;

// Geometry for each snap zone. Pass through screen dims since vesa_*
// state may be stale during drag.
fn wm_snap_zone_rect(zone, screen_w, screen_h) {
    let mut half_w = screen_w / 2;
    let mut half_h = screen_h / 2;
    if zone == SNAP_LEFT  { return half_w * 65536 + screen_h; }
    if zone == SNAP_RIGHT { return half_w * 65536 + screen_h; }
    if zone == SNAP_MAX   { return screen_w * 65536 + screen_h; }
    if zone == SNAP_TL    { return half_w * 65536 + half_h; }
    if zone == SNAP_TR    { return half_w * 65536 + half_h; }
    if zone == SNAP_BL    { return half_w * 65536 + half_h; }
    if zone == SNAP_BR    { return half_w * 65536 + half_h; }
    return 0;
}

// Compute target zone from drag-release position. (x, y) is the pointer
// release coordinate, not the window position.
fn wm_snap_zone_for(x, y, screen_w, screen_h) {
    let mut near_left   = 0;
    let mut near_right  = 0;
    let mut near_top    = 0;
    let mut near_bottom = 0;
    if x < SNAP_EDGE_THRESH                 { near_left   = 1; }
    if x >= screen_w - SNAP_EDGE_THRESH     { near_right  = 1; }
    if y < SNAP_EDGE_THRESH                 { near_top    = 1; }
    if y >= screen_h - SNAP_EDGE_THRESH     { near_bottom = 1; }
    if near_top == 1 {
        if near_left  == 1 { return SNAP_TL; }
        if near_right == 1 { return SNAP_TR; }
        return SNAP_MAX;
    }
    if near_bottom == 1 {
        if near_left  == 1 { return SNAP_BL; }
        if near_right == 1 { return SNAP_BR; }
    }
    if near_left  == 1 { return SNAP_LEFT; }
    if near_right == 1 { return SNAP_RIGHT; }
    return SNAP_NONE;
}

// Apply snap to window: returns (x, y, w, h) packed as two i32s.
fn wm_snap_apply(zone, screen_w, screen_h) {
    let mut half_w = screen_w / 2;
    let mut half_h = screen_h / 2;
    if zone == SNAP_LEFT  { return wm_snap_pack(0,      0,      half_w,   screen_h); }
    if zone == SNAP_RIGHT { return wm_snap_pack(half_w, 0,      half_w,   screen_h); }
    if zone == SNAP_MAX   { return wm_snap_pack(0,      0,      screen_w, screen_h); }
    if zone == SNAP_TL    { return wm_snap_pack(0,      0,      half_w,   half_h); }
    if zone == SNAP_TR    { return wm_snap_pack(half_w, 0,      half_w,   half_h); }
    if zone == SNAP_BL    { return wm_snap_pack(0,      half_h, half_w,   half_h); }
    if zone == SNAP_BR    { return wm_snap_pack(half_w, half_h, half_w,   half_h); }
    return 0;
}

let mut wm_snap_last_x = 0;
let mut wm_snap_last_y = 0;
let mut wm_snap_last_w = 0;
let mut wm_snap_last_h = 0;

fn wm_snap_pack(x, y, w, h) {
    wm_snap_last_x = x;
    wm_snap_last_y = y;
    wm_snap_last_w = w;
    wm_snap_last_h = h;
    return 1;
}

fn wm_snap_last_x_get() { return wm_snap_last_x; }
fn wm_snap_last_y_get() { return wm_snap_last_y; }
fn wm_snap_last_w_get() { return wm_snap_last_w; }
fn wm_snap_last_h_get() { return wm_snap_last_h; }

// Draw the translucent preview rectangle for the current candidate zone.
fn wm_snap_draw_preview(zone, screen_w, screen_h) {
    if zone == SNAP_NONE { return 0; }
    wm_snap_apply(zone, screen_w, screen_h);
    let mut tint = gfx_pack(SNAP_PREVIEW_ALPHA, 0, 120, 215);  // Win11 blue at 38%
    gfx_fill_rect(wm_snap_last_x, wm_snap_last_y, wm_snap_last_w, wm_snap_last_h, tint);
    return 0;
}

print("wm_snap.hl loaded");
