// euler_path.hl -- Eulerian Path / Circuit (Hierholzer's Algorithm)
// Hierholzer 1873: O(E) iterative DFS with backtrack stack.
// EP_MAX_V=32; undirected graph. Detects Eulerian conditions.
//
// Runtime buffer: 0x1600000 (4 KB)

let EP_MAX_V = 32;

// Adjacency matrix stores edge count (supports multi-edges; simple graph = 0 or 1)
let ep_adj    = array(1024, 0);
let ep_deg    = array(32, 0);    // vertex degree
let ep_stack  = array(64, 0);    // Hierholzer DFS stack
let ep_path   = array(64, 0);    // resulting Eulerian path
let ep_n      = 0;
let ep_path_n = 0;               // path length (vertices) after ep_run()
let ep_has_euler  = 0;           // 1 if Eulerian path/circuit exists
let ep_is_circuit = 0;           // 1 if Eulerian circuit (all degrees even)

fn euler_path_init() {
    let mut i = 0;
    while i < 1024 {
        set_at(ep_adj, i, 0);
        i += 1;
    }
    i = 0;
    while i < EP_MAX_V {
        set_at(ep_deg, i, 0);
        i += 1;
    }
    i = 0;
    while i < 64 {
        set_at(ep_stack, i, 0);
        set_at(ep_path,  i, 0);
        i += 1;
    }
    ep_n          = 0;
    ep_path_n     = 0;
    ep_has_euler  = 0;
    ep_is_circuit = 0;
    return 0;
}

fn ep_set_n(n) {
    ep_n = n;
    return 0;
}

// Add undirected edge u-v
fn ep_add_edge(u, v) {
    if u >= EP_MAX_V { return 0 - 1; }
    if v >= EP_MAX_V { return 0 - 1; }
    set_at(ep_adj, u * EP_MAX_V + v, ep_adj[u * EP_MAX_V + v] + 1);
    set_at(ep_adj, v * EP_MAX_V + u, ep_adj[v * EP_MAX_V + u] + 1);
    set_at(ep_deg, u, ep_deg[u] + 1);
    set_at(ep_deg, v, ep_deg[v] + 1);
    if u + 1 > ep_n { ep_n = u + 1; }
    if v + 1 > ep_n { ep_n = v + 1; }
    return 0;
}

// Find next unused edge from v; returns neighbor or -1
fn _ep_next(v) {
    let mut u = 0;
    while u < ep_n {
        if ep_adj[v * EP_MAX_V + u] > 0 { return u; }
        u += 1;
    }
    return 0 - 1;
}

// Check Eulerian conditions and find start vertex
fn _ep_check_and_start() {
    let odd_count = 0;
    let odd_v     = 0;
    let has_edge  = 0;
    let mut i = 0;
    while i < ep_n {
        if ep_deg[i] > 0 { has_edge = 1; }
        let rem = ep_deg[i] - (ep_deg[i] / 2) * 2;  // deg % 2
        if rem == 1 {
            odd_count += 1;
            odd_v = i;
        }
        i += 1;
    }
    if has_edge == 0 { ep_has_euler = 0; ep_is_circuit = 0; return 0 - 1; }
    if odd_count == 0 {
        ep_has_euler  = 1;
        ep_is_circuit = 1;
        return 0;    // start from vertex 0
    }
    if odd_count == 2 {
        ep_has_euler  = 1;
        ep_is_circuit = 0;
        return odd_v;  // start from an odd-degree vertex
    }
    ep_has_euler  = 0;
    ep_is_circuit = 0;
    return 0 - 1;
}

// Run Hierholzer's algorithm from given start vertex
fn ep_run(start) {
    ep_path_n = 0;
    // Save a working copy of the adjacency and degree (ep_run modifies ep_adj/ep_deg)
    let ep_stack_top = 0;
    set_at(ep_stack, ep_stack_top, start);
    ep_stack_top += 1;
    while ep_stack_top > 0 {
        let mut v = ep_stack[ep_stack_top - 1];
        let mut u = _ep_next(v);
        if u >= 0 {
            // Use edge v-u
            set_at(ep_adj, v * EP_MAX_V + u, ep_adj[v * EP_MAX_V + u] - 1);
            set_at(ep_adj, u * EP_MAX_V + v, ep_adj[u * EP_MAX_V + v] - 1);
            set_at(ep_stack, ep_stack_top, u);
            ep_stack_top += 1;
        } else {
            // No more edges: pop and record
            ep_stack_top -= 1;
            set_at(ep_path, ep_path_n, v);
            ep_path_n += 1;
        }
    }
    // Reverse path (Hierholzer builds it backwards)
    let mut i = 0;
    while i < ep_path_n / 2 {
        let mut tmp = ep_path[i];
        set_at(ep_path, i, ep_path[ep_path_n - 1 - i]);
        set_at(ep_path, ep_path_n - 1 - i, tmp);
        i += 1;
    }
    return ep_path_n;
}

fn euler_path_test() {
    euler_path_init();
    ep_set_n(4);
    // 4-vertex Eulerian circuit: 0-1, 1-2, 2-3, 3-0
    // All degrees = 2 → Eulerian circuit, path_n = 5
    ep_add_edge(0, 1);
    ep_add_edge(1, 2);
    ep_add_edge(2, 3);
    ep_add_edge(3, 0);
    let start = _ep_check_and_start();
    let pn = ep_run(start);
    print("euler_test is_circuit=" + to_string(ep_is_circuit) + " path_n=" + to_string(pn));
    print("ep path[0]=" + to_string(ep_path[0]) + " path[4]=" + to_string(ep_path[4]));
    return pn;
}

print("euler_path.hl loaded");
