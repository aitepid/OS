// font.hl -- Bitmap Font Renderer (8x16 System Font)
//
// Renders ASCII text to VESA/GOP framebuffer.
// Each glyph is 8 pixels wide × 16 pixels tall, 1 bit per pixel.
// Font data stored as 16 bytes per glyph (128 glyphs = 2048 bytes).
//
// The font is baked into the kernel image by codegen.
// This module provides: font_putchar, font_putstr, font_clear_line.

let FONT_WIDTH = 8;
let FONT_HEIGHT = 16;
let FONT_BASE = 1572864;  // 0x180000 -- font data address in kernel memory
let FONT_GLYPHS = 128;

// Framebuffer parameters (set by vesa_init or uefi_init_framebuffer)
let mut fb_addr = 0;
let mut fb_pitch = 0;
let mut fb_width = 0;
let mut fb_height = 0;

fn font_set_fb(addr, pitch, w, h) {
    fb_addr = addr;
    fb_pitch = pitch;
    fb_width = w;
    fb_height = h;
    return 0;
}

// Draw single character at pixel position (px, py) with color
fn font_putchar(ch, px, py, fg_color, bg_color) {
    let code = ch;
    if code < 0 { code = 0; }
    if code >= FONT_GLYPHS { code = 63; } // '?' for out of range
    let glyph_addr = FONT_BASE + code * FONT_HEIGHT;

    let mut row = 0;
    while row < FONT_HEIGHT {
        let bits = mem_read_u8(glyph_addr + row);
        let mut col = 0;
        while col < FONT_WIDTH {
            let pixel_addr = fb_addr + (py + row) * fb_pitch + (px + col) * 4;
            // Bit 7 is leftmost pixel
            let mask = 128 / (1);  // 2^(7-col) -- need power of 2
            // Manual bit test: check if bit (7-col) is set
            let shift = 7 - col;
            let mut test_mask = 1;
            let mut si = 0;
            while si < shift { test_mask = test_mask * 2; si = si + 1; }
            if (bits / test_mask) % 2 == 1 {
                mem_write_u32(pixel_addr, fg_color);
            } else {
                mem_write_u32(pixel_addr, bg_color);
            }
            col = col + 1;
        }
        row = row + 1;
    }
    return 0;
}

// Draw string at character grid position (col, row)
fn font_putstr(s, col, row, fg, bg) {
    let mut i = 0;
    let mut cx = col;
    while i < len(s) {
        let ch = str_char_at(s, i);
        if ch == 10 {
            // newline
            cx = 0;
            row = row + 1;
        } else {
            font_putchar(ch, cx * FONT_WIDTH, row * FONT_HEIGHT, fg, bg);
            cx = cx + 1;
            if cx * FONT_WIDTH >= fb_width {
                cx = 0;
                row = row + 1;
            }
        }
        i = i + 1;
    }
    return row;
}

// Clear a line (fill with background color)
fn font_clear_line(row, bg_color) {
    let y = row * FONT_HEIGHT;
    let mut r = 0;
    while r < FONT_HEIGHT {
        let line_addr = fb_addr + (y + r) * fb_pitch;
        let mut x = 0;
        while x < fb_width {
            mem_write_u32(line_addr + x * 4, bg_color);
            x = x + 1;
        }
        r = r + 1;
    }
    return 0;
}

// Clear entire screen
fn font_clear_screen(bg_color) {
    let rows = fb_height / FONT_HEIGHT;
    let mut r = 0;
    while r < rows {
        font_clear_line(r, bg_color);
        r = r + 1;
    }
    return 0;
}

// Calculate text grid dimensions
fn font_cols() {
    return fb_width / FONT_WIDTH;
}

fn font_rows() {
    return fb_height / FONT_HEIGHT;
}

// Bake a minimal font: just generate printable ASCII from built-in patterns
// This creates a simple 8x16 font in memory at FONT_BASE
fn font_bake_default() {
    // Zero all glyph data first
    mem_zero(FONT_BASE, FONT_GLYPHS * FONT_HEIGHT);

    // Space (32) is already zeroed

    // Character '0' (48): simple rectangle
    let g0 = FONT_BASE + 48 * FONT_HEIGHT;
    mem_write_u8(g0 + 2, 60);   // 0x3C = ..####..
    mem_write_u8(g0 + 3, 102);  // 0x66 = .##..##.
    mem_write_u8(g0 + 4, 110);  // 0x6E = .##.###.
    mem_write_u8(g0 + 5, 118);  // 0x76 = .###.##.
    mem_write_u8(g0 + 6, 102);  // 0x66 = .##..##.
    mem_write_u8(g0 + 7, 102);  // 0x66
    mem_write_u8(g0 + 8, 60);   // 0x3C

    // Character 'A' (65)
    let gA = FONT_BASE + 65 * FONT_HEIGHT;
    mem_write_u8(gA + 2, 24);   // 0x18 = ...##...
    mem_write_u8(gA + 3, 60);   // 0x3C = ..####..
    mem_write_u8(gA + 4, 102);  // 0x66 = .##..##.
    mem_write_u8(gA + 5, 126);  // 0x7E = .######.
    mem_write_u8(gA + 6, 102);  // 0x66
    mem_write_u8(gA + 7, 102);  // 0x66
    mem_write_u8(gA + 8, 102);  // 0x66

    // Character 'H' (72)
    let gH = FONT_BASE + 72 * FONT_HEIGHT;
    mem_write_u8(gH + 2, 102);  // 0x66
    mem_write_u8(gH + 3, 102);
    mem_write_u8(gH + 4, 126);  // 0x7E
    mem_write_u8(gH + 5, 102);
    mem_write_u8(gH + 6, 102);
    mem_write_u8(gH + 7, 102);
    mem_write_u8(gH + 8, 102);

    // Fill indicator for 'a'-'z': simple blocks for now
    // A real OS would load a full VGA ROM font from BIOS at 0xC0000

    print("font: default 8x16 baked at 0x" + format_hex(FONT_BASE, 6));
    return 0;
}

print("font.hl loaded: 8x16 bitmap renderer");
