// hlc_loader.hl -- HicOS Executable Format (.hlc) Loader
//
// Defines the HicOS native executable format for user programs.
// .hlc (Hilbert-Lang Compiled) files are loaded by the kernel
// to create new user processes.
//
// == Why not ELF/PE? ==
//   HicOS is a pure Hilbert-Lang system. Using ELF would require
//   an external toolchain. .hlc is generated by hl-bootstrap codegen
//   and loaded by the kernel -- entire pipeline in H-L.
//
// == .hlc File Format ==
//   Header (64 bytes):
//     +0:  magic (4) = [72, 76, 67, 0] = "HLC\0"
//     +4:  version (4) = 1
//     +8:  entry_offset (8) -- offset from file start to entry point
//     +16: code_offset (8) -- offset to .code section
//     +24: code_size (8) -- size of .code section in bytes
//     +32: data_offset (8) -- offset to .data section
//     +40: data_size (8) -- size of .data section in bytes
//     +48: bss_size (8) -- size of uninitialized data (zeroed at load)
//     +56: stack_size (8) -- requested stack size (default 64KB)
//
//   Sections (following header):
//     .code -- executable machine code (x86_64)
//     .data -- initialized global data
//     (bss is not stored, just allocated and zeroed)
//
// == Load Process ==
//   1. Read header, verify magic
//   2. Allocate pages: code_pages + data_pages + bss_pages + stack_pages
//   3. Copy .code to allocated code region
//   4. Copy .data to allocated data region
//   5. Zero bss region
//   6. Setup stack (grows down)
//   7. Create task with entry_point = code_base + entry_offset
//   8. Return new task PID
//
// == Memory Layout (per process) ==
//   0x00400000: .code (RX)
//   0x00600000: .data + .bss (RW)
//   0x00800000: heap (grows up via brk/mmap)
//   0x7FFFFF00_00000000: stack top (grows down)

let HLC_MAGIC = [72, 76, 67, 0];  // "HLC\0"
let HLC_VERSION = 1;
let HLC_HEADER_SIZE = 64;
let HLC_CODE_BASE = 4194304;      // 0x00400000
let HLC_DATA_BASE = 6291456;      // 0x00600000
let HLC_DEFAULT_STACK = 65536;    // 64 KB

// Validate .hlc header from memory buffer
fn hlc_validate(buf_addr) {
    // Check magic
    let mut i = 0;
    while i < 4 {
        if mem_read_u8(buf_addr + i) != HLC_MAGIC[i] {
            return 0;
        }
        i = i + 1;
    }
    // Check version
    let ver = mem_read_u32(buf_addr + 4);
    if ver != HLC_VERSION {
        print("hlc: unsupported version " + to_string(ver));
        return 0;
    }
    return 1;
}

// Parse .hlc header fields
fn hlc_parse_header(buf_addr) {
    let entry = mem_read_u64(buf_addr + 8);
    let code_off = mem_read_u64(buf_addr + 16);
    let code_size = mem_read_u64(buf_addr + 24);
    let data_off = mem_read_u64(buf_addr + 32);
    let data_size = mem_read_u64(buf_addr + 40);
    let bss_size = mem_read_u64(buf_addr + 48);
    let stack_size = mem_read_u64(buf_addr + 56);
    if stack_size == 0 { stack_size = HLC_DEFAULT_STACK; }
    return [entry, code_off, code_size, data_off, data_size, bss_size, stack_size];
}

// Load .hlc from VFS path, create a new task, return PID or -1
fn hlc_exec(path) {
    // Open and read file
    let fd = vfs_open(path, 0);
    if fd < 0 {
        print("hlc: cannot open " + path);
        return 0 - 1;
    }
    let stat = vfs_stat(path);
    let file_size = stat[0];
    if file_size < HLC_HEADER_SIZE {
        vfs_close(fd);
        print("hlc: file too small");
        return 0 - 1;
    }

    // Read entire file into temp buffer
    let pages_needed = (file_size + 4095) / 4096;
    let buf = page_alloc_contiguous(pages_needed);
    if buf == 0 {
        vfs_close(fd);
        print("hlc: alloc failed");
        return 0 - 1;
    }
    vfs_read(fd, buf, file_size);
    vfs_close(fd);

    // Validate
    if hlc_validate(buf) == 0 {
        print("hlc: invalid format");
        // free pages
        let mut p = 0;
        while p < pages_needed { page_free(buf + p * 4096); p = p + 1; }
        return 0 - 1;
    }

    // Parse header
    let hdr = hlc_parse_header(buf);
    let entry_off = hdr[0];
    let code_off = hdr[1];
    let code_size = hdr[2];
    let data_off = hdr[3];
    let data_size = hdr[4];
    let bss_size = hdr[5];
    let stack_size = hdr[6];

    // Allocate code pages
    let code_pages = (code_size + 4095) / 4096;
    let code_base = page_alloc_contiguous(code_pages);
    if code_base == 0 {
        let mut p = 0;
        while p < pages_needed { page_free(buf + p * 4096); p = p + 1; }
        return 0 - 1;
    }

    // Allocate data + bss pages
    let data_total = data_size + bss_size;
    let data_pages = (data_total + 4095) / 4096;
    let data_base = page_alloc_contiguous(data_pages);
    if data_base == 0 {
        let mut p = 0;
        while p < code_pages { page_free(code_base + p * 4096); p = p + 1; }
        while p < pages_needed { page_free(buf + p * 4096); p = p + 1; }
        return 0 - 1;
    }

    // Allocate stack
    let stack_pages = (stack_size + 4095) / 4096;
    let stack_base = page_alloc_contiguous(stack_pages);
    if stack_base == 0 {
        let mut p = 0;
        while p < code_pages { page_free(code_base + p * 4096); p = p + 1; }
        p = 0;
        while p < data_pages { page_free(data_base + p * 4096); p = p + 1; }
        p = 0;
        while p < pages_needed { page_free(buf + p * 4096); p = p + 1; }
        return 0 - 1;
    }

    // Copy .code section
    mem_copy(code_base, buf + code_off, code_size);

    // Copy .data section
    if data_size > 0 {
        mem_copy(data_base, buf + data_off, data_size);
    }

    // Zero .bss
    if bss_size > 0 {
        mem_zero(data_base + data_size, bss_size);
    }

    // Zero stack
    mem_zero(stack_base, stack_size);

    // Free temp buffer
    let mut p = 0;
    while p < pages_needed { page_free(buf + p * 4096); p = p + 1; }

    // Create task
    let entry_point = code_base + entry_off;
    let stack_top = stack_base + stack_size;
    let pid = task_create(entry_point, stack_top);
    if pid < 0 {
        print("hlc: task_create failed");
        return 0 - 1;
    }

    print("hlc: loaded " + path + " pid=" + to_string(pid) + " entry=0x" + format_hex(entry_point, 8));
    return pid;
}

// Build a minimal .hlc file in memory (for testing)
fn hlc_build_test(code_bytes, code_len) {
    let mut total = HLC_HEADER_SIZE + code_len;
    let pages = (total + 4095) / 4096;
    let buf = page_alloc_contiguous(pages);
    if buf == 0 { return 0; }
    mem_zero(buf, total);

    // Write header
    let mut i = 0;
    while i < 4 { mem_write_u8(buf + i, HLC_MAGIC[i]); i = i + 1; }
    mem_write_u32(buf + 4, HLC_VERSION);
    mem_write_u64(buf + 8, 0);                  // entry = start of code
    mem_write_u64(buf + 16, HLC_HEADER_SIZE);   // code offset
    mem_write_u64(buf + 24, code_len);          // code size
    mem_write_u64(buf + 32, 0);                 // no data
    mem_write_u64(buf + 40, 0);
    mem_write_u64(buf + 48, 0);                 // no bss
    mem_write_u64(buf + 56, HLC_DEFAULT_STACK); // stack

    // Copy code
    i = 0;
    while i < code_len {
        mem_write_u8(buf + HLC_HEADER_SIZE + i, code_bytes[i]);
        i = i + 1;
    }

    return buf;
}

print("hlc_loader.hl loaded: .hlc executable format (HicOS native)");
