// shell_startmenu.hl -- 开始菜单（Sprint G5）
//
// Win11 风格：上方搜索框，中部固定应用网格 (Pinned)，下方推荐区，
// 底部用户头像 + 电源按钮。整体浮窗，按 Esc 或点击外部关闭。

let SM_W              = 540;
let SM_H              = 600;
let SM_COLS           = 6;
let SM_PINNED_MAX     = 24;
let SM_TILE           = 72;
let SM_PAD            = 16;

let mut sm_initialized   = 0;
let mut sm_visible       = 0;
let mut sm_pinned_label  = [0];
let mut sm_pinned_count  = 0;
let mut sm_hover_idx     = 0 - 1;

fn shell_startmenu_init() {
    if sm_initialized == 1 { return 0; }
    sm_pinned_label = array_new(SM_PINNED_MAX, 0);
    sm_pinned_count = 0;
    sm_visible = 0;
    sm_initialized = 1;
    print("shell_startmenu: ready");
    return 0;
}

fn shell_startmenu_pin(label_addr) {
    if sm_initialized == 0 { shell_startmenu_init(); }
    if sm_pinned_count >= SM_PINNED_MAX { return 0 - 1; }
    sm_pinned_label[sm_pinned_count] = label_addr;
    sm_pinned_count = sm_pinned_count + 1;
    return sm_pinned_count - 1;
}

fn shell_startmenu_show() { sm_visible = 1; return 0; }
fn shell_startmenu_hide() { sm_visible = 0; return 0; }
fn shell_startmenu_toggle() {
    if sm_visible == 1 { sm_visible = 0; } else { sm_visible = 1; }
    return sm_visible;
}
fn shell_startmenu_visible() { return sm_visible; }

fn shell_startmenu_paint(screen_w, screen_h) {
    if sm_visible == 0 { return 0; }
    let mut x = (screen_w - SM_W) / 2;
    let mut y = screen_h - SM_H - shell_dock_height() - 8;
    if y < 8 { y = 8; }
    gfx_shadow_draw_n(x, y, SM_W, SM_H, 24);
    gfx_rect_round(x, y, SM_W, SM_H, 12, ui_theme_bg_elevated());
    // 标题 "Pinned"
    let mut size = 17;
    font_atlas_draw_str(x + SM_PAD, y + SM_PAD, "Pinned", size,
                        ui_theme_text_primary());
    // 网格
    let mut gy = y + SM_PAD + 28;
    let mut i = 0;
    while i < sm_pinned_count {
        let mut col = i % SM_COLS;
        let mut row = i / SM_COLS;
        let mut tx = x + SM_PAD + col * (SM_TILE + 8);
        let mut ty = gy + row * (SM_TILE + 8);
        let mut bg = ui_theme_bg_overlay();
        if i == sm_hover_idx { bg = ui_theme_bg_surface(); }
        gfx_rect_round(tx, ty, SM_TILE, SM_TILE, 8, bg);
        if sm_pinned_label[i] != 0 {
            let mut s = cstr_from_addr(sm_pinned_label[i]);
            let mut tsize = 13;
            let mut tw = font_atlas_measure(s, tsize);
            font_atlas_draw_str(tx + (SM_TILE - tw) / 2, ty + SM_TILE - 18,
                                s, tsize, ui_theme_text_primary());
            // 图标占位：首字符大字
            let mut bsize = 22;
            font_atlas_draw_glyph(tx + (SM_TILE - font_atlas_w(bsize)) / 2,
                                  ty + 12, str_byte(s, 0), bsize,
                                  ui_theme_accent_get());
        }
        i = i + 1;
    }
    // 底部：电源 + 用户
    let mut footer_y = y + SM_H - 40;
    gfx_fill_rect(x + SM_PAD, footer_y - 6, SM_W - SM_PAD * 2, 1,
                  ui_theme_bg_overlay());
    font_atlas_draw_str(x + SM_PAD, footer_y, "User", size,
                        ui_theme_text_primary());
    gfx_circle_aa(x + SM_W - SM_PAD - 8, footer_y + 8, 8, ui_theme_accent_get());
    return 0;
}

fn shell_startmenu_handle_pointer(ev_type, x, y, screen_w, screen_h) {
    if sm_visible == 0 { return 0; }
    let mut sx = (screen_w - SM_W) / 2;
    let mut sy = screen_h - SM_H - shell_dock_height() - 8;
    if sy < 8 { sy = 8; }
    // 点击外部关闭
    if ev_type == PEV_TYPE_UP {
        if x < sx { sm_visible = 0; return 1; }
        if x > sx + SM_W { sm_visible = 0; return 1; }
        if y < sy { sm_visible = 0; return 1; }
        if y > sy + SM_H { sm_visible = 0; return 1; }
    }
    // 网格命中
    let mut gy = sy + SM_PAD + 28;
    if y >= gy {
        let mut col = (x - sx - SM_PAD) / (SM_TILE + 8);
        let mut row = (y - gy) / (SM_TILE + 8);
        let mut idx = row * SM_COLS + col;
        if idx >= 0 {
            if idx < sm_pinned_count {
                if ev_type == PEV_TYPE_MOVE { sm_hover_idx = idx; }
                if ev_type == PEV_TYPE_UP   { sm_visible = 0; }
                return 1;
            }
        }
    }
    return 0;
}

print("shell_startmenu.hl loaded");
