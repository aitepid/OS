// scancode.hl -- PS/2 Keyboard Scancode Set 1 -> ASCII Mapping
//
// Converts raw PS/2 scan codes (set 1, make codes only) to ASCII.
// Used by the keyboard ISR and shell.
//
// Scan codes >= 0x80 are key-release events (ignored).

// Scancode table: index = scancode, value = ASCII (0 = unmapped)
// Covers scancodes 0x00 - 0x39 (57 entries)
fn build_scancode_table() {
    let mut t = [];
    let mut i = 0;
    while i < 128 { push(t, 0); i = i + 1; }

    // Row 1: number keys
    // sc 0x02='1' .. 0x0B='0'
    t[2]  = 49;  // '1'
    t[3]  = 50;  // '2'
    t[4]  = 51;  // '3'
    t[5]  = 52;  // '4'
    t[6]  = 53;  // '5'
    t[7]  = 54;  // '6'
    t[8]  = 55;  // '7'
    t[9]  = 56;  // '8'
    t[10] = 57;  // '9'
    t[11] = 48;  // '0'
    t[12] = 45;  // '-'
    t[13] = 61;  // '='

    // Backspace, Tab, Enter
    t[14] = 8;   // Backspace
    t[15] = 9;   // Tab
    t[28] = 10;  // Enter (LF)

    // Row 2: qwertyuiop
    t[16] = 113; // 'q'
    t[17] = 119; // 'w'
    t[18] = 101; // 'e'
    t[19] = 114; // 'r'
    t[20] = 116; // 't'
    t[21] = 121; // 'y'
    t[22] = 117; // 'u'
    t[23] = 105; // 'i'
    t[24] = 111; // 'o'
    t[25] = 112; // 'p'
    t[26] = 91;  // '['
    t[27] = 93;  // ']'

    // Row 3: asdfghjkl
    t[30] = 97;  // 'a'
    t[31] = 115; // 's'
    t[32] = 100; // 'd'
    t[33] = 102; // 'f'
    t[34] = 103; // 'g'
    t[35] = 104; // 'h'
    t[36] = 106; // 'j'
    t[37] = 107; // 'k'
    t[38] = 108; // 'l'
    t[39] = 59;  // ';'
    t[40] = 39;  // '''
    t[41] = 96;  // '`'

    // Row 4: zxcvbnm
    t[43] = 92;  // '\'
    t[44] = 122; // 'z'
    t[45] = 120; // 'x'
    t[46] = 99;  // 'c'
    t[47] = 118; // 'v'
    t[48] = 98;  // 'b'
    t[49] = 110; // 'n'
    t[50] = 109; // 'm'
    t[51] = 44;  // ','
    t[52] = 46;  // '.'
    t[53] = 47;  // '/'

    // Space
    t[57] = 32;  // ' '

    return t;
}

// Shifted (uppercase) scancode table
fn build_shift_table() {
    let mut t = [];
    let mut i = 0;
    while i < 128 { push(t, 0); i = i + 1; }

    // Row 1: shifted number keys -> symbols
    t[2]  = 33;  // '!'
    t[3]  = 64;  // '@'
    t[4]  = 35;  // '#'
    t[5]  = 36;  // '$'
    t[6]  = 37;  // '%'
    t[7]  = 94;  // '^'
    t[8]  = 38;  // '&'
    t[9]  = 42;  // '*'
    t[10] = 40;  // '('
    t[11] = 41;  // ')'
    t[12] = 95;  // '_'
    t[13] = 43;  // '+'

    t[14] = 8;   // Backspace
    t[15] = 9;   // Tab
    t[28] = 10;  // Enter

    // Row 2: QWERTYUIOP
    t[16] = 81;  // 'Q'
    t[17] = 87;  // 'W'
    t[18] = 69;  // 'E'
    t[19] = 82;  // 'R'
    t[20] = 84;  // 'T'
    t[21] = 89;  // 'Y'
    t[22] = 85;  // 'U'
    t[23] = 73;  // 'I'
    t[24] = 79;  // 'O'
    t[25] = 80;  // 'P'
    t[26] = 123; // '{'
    t[27] = 125; // '}'

    // Row 3: ASDFGHJKL
    t[30] = 65;  // 'A'
    t[31] = 83;  // 'S'
    t[32] = 68;  // 'D'
    t[33] = 70;  // 'F'
    t[34] = 71;  // 'G'
    t[35] = 72;  // 'H'
    t[36] = 74;  // 'J'
    t[37] = 75;  // 'K'
    t[38] = 76;  // 'L'
    t[39] = 58;  // ':'
    t[40] = 34;  // '"'
    t[41] = 126; // '~'

    // Row 4: ZXCVBNM
    t[43] = 124; // '|'
    t[44] = 90;  // 'Z'
    t[45] = 88;  // 'X'
    t[46] = 67;  // 'C'
    t[47] = 86;  // 'V'
    t[48] = 66;  // 'B'
    t[49] = 78;  // 'N'
    t[50] = 77;  // 'M'
    t[51] = 60;  // '<'
    t[52] = 62;  // '>'
    t[53] = 63;  // '?'

    t[57] = 32;  // Space (same shifted)

    return t;
}

// Modifier key state tracking
// Scancodes: LShift=0x2A(42), RShift=0x36(54), LCtrl=0x1D(29), LAlt=0x38(56)
let SC_LSHIFT     = 42;
let SC_RSHIFT     = 54;
let SC_LCTRL      = 29;
let SC_LALT       = 56;
let SC_CAPSLOCK   = 58;
let SC_ESCAPE     = 1;
let SC_F1         = 59;
let SC_F2         = 60;
let SC_F3         = 61;
let SC_F4         = 62;
let SC_F5         = 63;
let SC_F6         = 64;
let SC_F7         = 65;
let SC_F8         = 66;
let SC_F9         = 67;
let SC_F10        = 68;
let SC_F11        = 87;
let SC_F12        = 88;

let mut _shift_held = 0;
let mut _ctrl_held = 0;
let mut _alt_held = 0;
let mut _capslock_on = 0;

// Process raw scancode: update modifier state, return ASCII
// Returns: [ascii, ctrl, alt] or [0,0,0] for non-printable/modifier keys
fn scancode_process(sc) {
    // Key release (bit 7 set)
    if sc >= 128 {
        let mut released = sc - 128;
        if released == SC_LSHIFT || released == SC_RSHIFT { _shift_held = 0; }
        if released == SC_LCTRL { _ctrl_held = 0; }
        if released == SC_LALT { _alt_held = 0; }
        return [0, 0, 0];
    }

    // Key press: update modifiers
    if sc == SC_LSHIFT || sc == SC_RSHIFT { _shift_held = 1; return [0, 0, 0]; }
    if sc == SC_LCTRL { _ctrl_held = 1; return [0, 0, 0]; }
    if sc == SC_LALT { _alt_held = 1; return [0, 0, 0]; }
    if sc == SC_CAPSLOCK { _capslock_on = 1 - _capslock_on; return [0, 0, 0]; }

    // Escape key
    if sc == SC_ESCAPE { return [27, _ctrl_held, _alt_held]; }

    // Function keys: return negative codes F1=-1, F2=-2, ...
    if sc >= SC_F1 && sc <= SC_F10 { return [0 - (sc - SC_F1 + 1), _ctrl_held, _alt_held]; }
    if sc == SC_F11 { return [0 - 11, _ctrl_held, _alt_held]; }
    if sc == SC_F12 { return [0 - 12, _ctrl_held, _alt_held]; }

    // Regular key: apply Shift / CapsLock
    let mut ascii = 0;
    let mut use_shift = _shift_held;
    // CapsLock inverts shift for letters only
    let mut base_table = build_scancode_table();
    let mut base_ascii = base_table[sc];
    if base_ascii >= 97 && base_ascii <= 122 {
        // Letter key: CapsLock XOR Shift
        if _capslock_on == 1 { use_shift = 1 - use_shift; }
    }

    if use_shift == 1 {
        let mut shift_table = build_shift_table();
        ascii = shift_table[sc];
    } else {
        ascii = base_ascii;
    }

    // Ctrl+letter: ASCII 1-26
    if _ctrl_held == 1 && ascii >= 65 && ascii <= 90 { ascii = ascii - 64; }
    if _ctrl_held == 1 && ascii >= 97 && ascii <= 122 { ascii = ascii - 96; }

    return [ascii, _ctrl_held, _alt_held];
}

// Simple scancode to ASCII (backward compatible, no modifiers)
fn scancode_to_ascii(sc) {
    if sc >= 128 { return 0; } // key release
    let mut table = build_scancode_table();
    if sc >= len(table) { return 0; }
    return table[sc];
}

// Self-test
let sc_a = scancode_to_ascii(30);
let sc_z = scancode_to_ascii(44);
let sc_space = scancode_to_ascii(57);
let sc_enter = scancode_to_ascii(28);
let sc_release = scancode_to_ascii(158);

print("scancode 30 -> " + to_string(sc_a));   // 97 = 'a'
print("scancode 44 -> " + to_string(sc_z));   // 122 = 'z'
print("scancode 57 -> " + to_string(sc_space)); // 32 = ' '
print("scancode 28 -> " + to_string(sc_enter)); // 10 = LF
print("scancode 158 -> " + to_string(sc_release)); // 0 (release)
print("scancode.hl loaded (Shift/Ctrl/Alt/CapsLock support)");
