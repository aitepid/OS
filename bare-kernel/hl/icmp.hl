// icmp.hl -- ICMP Echo (Ping)
//
// Implements ICMP echo request/reply for network diagnostics.
// ARP functions are in arp.hl -- this module uses arp_lookup/arp_update from there.

// === ICMP ===
let ICMP_ECHO_REQUEST = 8;
let ICMP_ECHO_REPLY   = 0;

fn icmp_checksum(data) {
    let mut sum = 0;
    let mut i = 0;
    while i < len(data) - 1 {
        sum = sum + data[i] * 256 + data[i + 1];
        i = i + 2;
    }
    if len(data) % 2 == 1 {
        sum = sum + data[len(data) - 1] * 256;
    }
    while sum > 65535 {
        sum = (sum % 65536) + (sum / 65536);
    }
    return 65535 - sum;
}

// Build ICMP echo request
fn icmp_build_echo(id, seq, payload) {
    let mut pkt = [];
    push(pkt, ICMP_ECHO_REQUEST); // type
    push(pkt, 0);                  // code
    push(pkt, 0); push(pkt, 0);   // checksum field
    push(pkt, (id / 256) % 256); push(pkt, id % 256);
    push(pkt, (seq / 256) % 256); push(pkt, seq % 256);
    let mut i = 0;
    while i < len(payload) { push(pkt, payload[i]); i = i + 1; }
    // Compute and patch checksum
    let mut ck = icmp_checksum(pkt);
    set_at(pkt, 2, (ck / 256) % 256);
    set_at(pkt, 3, ck % 256);
    return pkt;
}

// Send ping to IP
fn ping(target_ip) {
    let mut payload = [72, 105, 99, 79, 83, 33, 33, 33]; // "HicOS!!!"
    let mut icmp_pkt = icmp_build_echo(1, 1, payload);
    // Wrap in IP packet (proto=1=ICMP), send
    // Resolve MAC via ARP if needed
    return 0;
}

// Process received ICMP packet
fn icmp_input(data) {
    if len(data) < 8 { return 0; }
    let mut icmp_type = data[0];
    if icmp_type == ICMP_ECHO_REQUEST {
        // Send echo reply
        return 1;
    }
    if icmp_type == ICMP_ECHO_REPLY {
        // Record RTT
        return 2;
    }
    return 0;
}

