// mo_algorithm.hl -- Mo's offline range queries O((n+q)sqrt(n)) (iter 320)
// Buffer: 0x1770000
// Sort queries by (block(l), r) then sweep window [curl,curr] adding/removing.

let MO_MAX_N = 64;
let MO_MAX_Q = 32;
let MO_BLOCK = 8;

let mo_arr  = array(64, 0);
let mo_ql   = array(32, 0);
let mo_qr   = array(32, 0);
let mo_qidx = array(32, 0);
let mo_ans  = array(32, 0);
let mo_n    = 0;
let mo_q    = 0;
let mo_curl = 0;
let mo_curr = -1;
let mo_csum = 0;

fn mo_init(n) {
    mo_n    = n;
    mo_q    = 0;
    mo_curl = 0;
    mo_curr = -1;
    mo_csum = 0;
    let mut i = 0;
    while i < n {
        set_at(mo_arr, i, 0);
        i += 1;
    }
    i = 0;
    while i < MO_MAX_Q {
        set_at(mo_ans, i, 0);
        i += 1;
    }
    return 0;
}

fn mo_add_query(l, r) {
    let qi = mo_q;
    set_at(mo_ql,   qi, l);
    set_at(mo_qr,   qi, r);
    set_at(mo_qidx, qi, qi);
    mo_q += 1;
    return qi;
}

fn _mo_add(pos) {
    mo_csum += mo_arr[pos];
    return 0;
}

fn _mo_remove(pos) {
    mo_csum -= mo_arr[pos];
    return 0;
}

fn _mo_sort() {
    let mut i = 1;
    while i < mo_q {
        let mut j = i;
        let mut done = 0;
        while done == 0 {
            if j <= 0 {
                done = 1;
            } else {
                let blj  = mo_ql[j]   / MO_BLOCK;
                let blj1 = mo_ql[j-1] / MO_BLOCK;
                let sw = 0;
                if blj < blj1 {
                    sw = 1;
                } else {
                    if blj == blj1 {
                        if mo_qr[j] < mo_qr[j-1] { sw = 1; }
                    }
                }
                if sw == 1 {
                    let tl = mo_ql[j];
                    set_at(mo_ql, j, mo_ql[j-1]);
                    set_at(mo_ql, j-1, tl);
                    let tr = mo_qr[j];
                    set_at(mo_qr, j, mo_qr[j-1]);
                    set_at(mo_qr, j-1, tr);
                    let ti = mo_qidx[j];
                    set_at(mo_qidx, j, mo_qidx[j-1]);
                    set_at(mo_qidx, j-1, ti);
                    j -= 1;
                } else {
                    done = 1;
                }
            }
        }
        i += 1;
    }
    return 0;
}

fn mo_run() {
    _mo_sort();
    mo_csum = 0;
    mo_curl = 0;
    mo_curr = -1;
    let mut i = 0;
    while i < mo_q {
        let ql = mo_ql[i];
        let qr = mo_qr[i];
        let mut done = 0;
        while done == 0 {
            if mo_curr >= qr { done = 1; }
            else { mo_curr += 1; _mo_add(mo_curr); }
        }
        done = 0;
        while done == 0 {
            if mo_curl <= ql { done = 1; }
            else { mo_curl -= 1; _mo_add(mo_curl); }
        }
        done = 0;
        while done == 0 {
            if mo_curr <= qr { done = 1; }
            else { _mo_remove(mo_curr); mo_curr -= 1; }
        }
        done = 0;
        while done == 0 {
            if mo_curl >= ql { done = 1; }
            else { _mo_remove(mo_curl); mo_curl += 1; }
        }
        set_at(mo_ans, mo_qidx[i], mo_csum);
        i += 1;
    }
    return 0;
}

fn mo_test() {
    mo_init(8);
    let mut i = 0;
    while i < 8 {
        set_at(mo_arr, i, i + 1);
        i += 1;
    }
    mo_add_query(0, 2);
    mo_add_query(1, 4);
    mo_add_query(3, 7);
    mo_run();
    let a0 = mo_ans[0];
    let a1 = mo_ans[1];
    let a2 = mo_ans[2];
    print("mo_test: q0=" + to_string(a0) + " q1=" + to_string(a1) + " q2=" + to_string(a2));
    if a0 == 6 {
        if a1 == 14 {
            if a2 == 30 {
                print("mo_test: PASS");
                return 1;
            }
        }
    }
    print("mo_test: FAIL");
    return 0;
}

print("mo_algorithm.hl loaded");
