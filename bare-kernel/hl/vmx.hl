// vmx.hl -- VMX/VT-x Hardware Virtualization (Phase 6: 系统稳定化, iter 420)
// Buffer: 0x1DB0000
// Simulates VMCS per vCPU: VMLAUNCH/VMRESUME/VMREAD/VMWRITE operations
// VMEXIT reasons: VX_EXIT_HLT=0, VX_EXIT_IO=1, VX_EXIT_RDMSR=2, VX_EXIT_WRMSR=3, VX_EXIT_CPUID=4
// VMCS fields: VX_F_RIP=0, VX_F_RSP=1, VX_F_RFLAGS=2, VX_F_CR3=3
// Milestone M5: complete production-grade stability framework

let VX_MAX_VCPUS   = 8;
let mut VX_F_RIP       = 0;
let mut VX_F_RSP       = 1;
let mut VX_F_RFLAGS    = 2;
let mut VX_F_CR3       = 3;
let mut VX_EXIT_HLT    = 0;
let mut VX_EXIT_IO     = 1;
let mut VX_EXIT_RDMSR  = 2;
let mut VX_EXIT_WRMSR  = 3;
let mut VX_EXIT_CPUID  = 4;

let vx_vmcs_active  = array(8, 0);   // 1=VMCS initialized
let vx_vmcs_rip     = array(8, 0);   // guest RIP
let vx_vmcs_rsp     = array(8, 0);   // guest RSP
let vx_vmcs_rflags  = array(8, 0);   // guest RFLAGS
let vx_vmcs_cr3     = array(8, 0);   // guest CR3
let vx_exit_reason  = array(8, 0);   // last VMEXIT reason
let vx_exit_qual    = array(8, 0);   // exit qualification
let vx_n_exits      = array(8, 0);   // total exits per vCPU
let mut vx_total_exits  = 0;

fn vx_init() {
    let mut i = 0;
    while i < VX_MAX_VCPUS {
        set_at(vx_vmcs_active, i, 0);
        set_at(vx_vmcs_rip,    i, 0);
        set_at(vx_vmcs_rsp,    i, 0);
        set_at(vx_vmcs_rflags, i, 0);
        set_at(vx_vmcs_cr3,    i, 0);
        set_at(vx_exit_reason, i, 0);
        set_at(vx_exit_qual,   i, 0);
        set_at(vx_n_exits,     i, 0);
        i += 1;
    }
    vx_total_exits = 0;
    return 0;
}

fn vx_vmcs_setup(vcpu_id, rip, rsp) {
    set_at(vx_vmcs_active, vcpu_id, 1);
    set_at(vx_vmcs_rip,    vcpu_id, rip);
    set_at(vx_vmcs_rsp,    vcpu_id, rsp);
    set_at(vx_vmcs_rflags, vcpu_id, 0x202);   // IF=1, reserved bit 1
    return 0;
}

fn vx_vmwrite(vcpu_id, field, val) {
    if field == VX_F_RIP    { set_at(vx_vmcs_rip,    vcpu_id, val); }
    if field == VX_F_RSP    { set_at(vx_vmcs_rsp,    vcpu_id, val); }
    if field == VX_F_RFLAGS { set_at(vx_vmcs_rflags, vcpu_id, val); }
    if field == VX_F_CR3    { set_at(vx_vmcs_cr3,    vcpu_id, val); }
    return 0;
}

fn vx_vmread(vcpu_id, field) {
    if field == VX_F_RIP    { return vx_vmcs_rip[vcpu_id]; }
    if field == VX_F_RSP    { return vx_vmcs_rsp[vcpu_id]; }
    if field == VX_F_RFLAGS { return vx_vmcs_rflags[vcpu_id]; }
    if field == VX_F_CR3    { return vx_vmcs_cr3[vcpu_id]; }
    return 0;
}

fn _vx_record_exit(vcpu_id, reason, qual) {
    set_at(vx_exit_reason, vcpu_id, reason);
    set_at(vx_exit_qual,   vcpu_id, qual);
    set_at(vx_n_exits, vcpu_id, vx_n_exits[vcpu_id] + 1);
    vx_total_exits += 1;
}

fn vx_vmlaunch(vcpu_id) {
    // Simulate first entry → immediate HLT exit
    _vx_record_exit(vcpu_id, VX_EXIT_HLT, 0);
    return vx_n_exits[vcpu_id];
}

fn vx_vmresume(vcpu_id, exit_reason) {
    // Inject a new VMEXIT with given reason; advance RIP by 1
    _vx_record_exit(vcpu_id, exit_reason, 0);
    set_at(vx_vmcs_rip, vcpu_id, vx_vmcs_rip[vcpu_id] + 1);
    return vx_n_exits[vcpu_id];
}

fn vx_get_exits(vcpu_id)       { return vx_n_exits[vcpu_id]; }
fn vx_get_exit_reason(vcpu_id) { return vx_exit_reason[vcpu_id]; }
fn vx_get_total_exits()        { return vx_total_exits; }

fn vx_test() {
    vx_init();

    // Setup vCPU 0: RIP=4096, RSP=28672
    vx_vmcs_setup(0, 4096, 28672);

    // Override RFLAGS via vmwrite
    vx_vmwrite(0, VX_F_RFLAGS, 514);

    // Read back RIP
    let rip0 = vx_vmread(0, VX_F_RIP);    // 4096

    // Launch → records HLT exit, n_exits=1
    vx_vmlaunch(0);

    // Resume with IO exit → n_exits=2, exit_reason=IO=1, rip advances to 4097
    vx_vmresume(0, VX_EXIT_IO);

    let exits  = vx_get_exits(0);           // 2
    let reason = vx_get_exit_reason(0);     // 1 (VX_EXIT_IO)
    let rflags = vx_vmread(0, VX_F_RFLAGS); // 514

    print("vx_test: rip0=" + to_string(rip0)
          + " exits=" + to_string(exits)
          + " reason=" + to_string(reason)
          + " rflags=" + to_string(rflags));

    if rip0 == 4096 {
        if exits == 2 {
            if reason == VX_EXIT_IO {
                if rflags == 514 {
                    print("vx_test: PASS");
                    return 1;
                }
            }
        }
    }
    print("vx_test: FAIL");
    return 0;
}

print("vmx.hl loaded");
