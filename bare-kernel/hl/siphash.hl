// siphash.hl -- SipHash DoS-Resistant Hash (simplified SipHash-2-4)
//
// Provides simplified SipHash-2-4 (2 compression rounds, 4 finalization rounds).
// DoS-resistant because output depends on a secret 128-bit key.
// All arithmetic is 32-bit (simplified from the 64-bit spec).

// --- 128-bit key storage (16 bytes) ---
let siphash_key = array(16, 0);

// --- Internal SipHash state words ---
let mut siphash_v0 = 0;
let mut siphash_v1 = 0;
let mut siphash_v2 = 0;
let mut siphash_v3 = 0;

// --- Result and output buffers ---
let mut siphash_result = 0;
let siphash_hex_buf   = array(9, 0);   // 8 hex digits + null
let siphash_state_buf = array(8, 0);   // 8 raw bytes of v0/v1

// ---------------------------------------------------------------------------
// siphash_init -- zero the key, reset result
// ---------------------------------------------------------------------------
fn siphash_init() {
    siphash_result = 0;
    let mut i = 0;
    while i < 16 {
        set_at(siphash_key, i, 0);
        i = i + 1;
    }
    print("siphash: SipHash DoS-resistant hash ready");
    return 0;
}

// ---------------------------------------------------------------------------
// siphash_set_key -- load 16-byte key from a string
// ---------------------------------------------------------------------------
fn siphash_set_key(key) {
    let mut key_len = len(key);
    if key_len < 16 {
        print("siphash: key too short (need 16 bytes)");
        return 0 - 1;
    }
    let mut i = 0;
    while i < 16 {
        set_at(siphash_key, i, str_char_code(key, i));
        i = i + 1;
    }
    return 0;
}

// ---------------------------------------------------------------------------
// _siphash_pow2 -- compute 2^exp (32-bit safe)
// ---------------------------------------------------------------------------
fn _siphash_pow2(exp) {
    if exp <= 0 { return 1; }
    if exp >= 32 { return 0; }
    let mut result = 1;
    let mut i = 0;
    while i < exp {
        result = result * 2;
        i = i + 1;
    }
    return result;
}

// ---------------------------------------------------------------------------
// _siphash_pow256 -- 256^exp for exp in 0..3
// ---------------------------------------------------------------------------
fn _siphash_pow256(exp) {
    if exp == 0 { return 1; }
    if exp == 1 { return 256; }
    if exp == 2 { return 65536; }
    if exp == 3 { return 16777216; }
    return 1;
}

// ---------------------------------------------------------------------------
// _siphash_rotl -- rotate-left (32-bit simulation)
// ---------------------------------------------------------------------------
fn _siphash_rotl(value, bits) {
    if bits == 0 { return value; }
    if bits >= 32 { return value; }
    let mut left = (value * _siphash_pow2(bits)) % 4294967296;
    let mut right = value / _siphash_pow2(32 - bits);
    return (left + right) % 4294967296;
}

// ---------------------------------------------------------------------------
// _siphash_read32_str -- read 4-byte little-endian word from string data
// ---------------------------------------------------------------------------
fn _siphash_read32_str(data, pos, dlen) {
    let mut b0 = 0;
    let mut b1 = 0;
    let mut b2 = 0;
    let mut b3 = 0;
    if pos < dlen         { b0 = str_char_code(data, pos); }
    if pos + 1 < dlen     { b1 = str_char_code(data, pos + 1); }
    if pos + 2 < dlen     { b2 = str_char_code(data, pos + 2); }
    if pos + 3 < dlen     { b3 = str_char_code(data, pos + 3); }
    return (b0 + b1 * 256 + b2 * 65536 + b3 * 16777216) % 4294967296;
}

// ---------------------------------------------------------------------------
// _siphash_sipround -- one SipRound (operates on globals v0-v3)
// ---------------------------------------------------------------------------
fn _siphash_sipround() {
    siphash_v0 = (siphash_v0 + siphash_v1) % 4294967296;
    siphash_v1 = _siphash_rotl(siphash_v1, 13);
    siphash_v1 = (siphash_v1 + siphash_v0) % 4294967296;
    siphash_v0 = _siphash_rotl(siphash_v0, 16);

    siphash_v2 = (siphash_v2 + siphash_v3) % 4294967296;
    siphash_v3 = _siphash_rotl(siphash_v3, 16);
    siphash_v3 = (siphash_v3 + siphash_v2) % 4294967296;

    siphash_v0 = (siphash_v0 + siphash_v3) % 4294967296;
    siphash_v3 = _siphash_rotl(siphash_v3, 21);
    siphash_v3 = (siphash_v3 + siphash_v0) % 4294967296;

    siphash_v2 = (siphash_v2 + siphash_v1) % 4294967296;
    siphash_v1 = _siphash_rotl(siphash_v1, 17);
    siphash_v1 = (siphash_v1 + siphash_v2) % 4294967296;
    siphash_v2 = _siphash_rotl(siphash_v2, 16);
    return 0;
}

// ---------------------------------------------------------------------------
// _siphash_compress -- absorb message word m (2 SipRounds)
// ---------------------------------------------------------------------------
fn _siphash_compress(m) {
    siphash_v3 = (siphash_v3 + m) % 4294967296;
    _siphash_sipround();
    _siphash_sipround();
    siphash_v0 = (siphash_v0 + m) % 4294967296;
    return 0;
}

// ---------------------------------------------------------------------------
// siphash -- hash string data with SipHash-2-4; returns 32-bit digest
// ---------------------------------------------------------------------------
fn siphash(data, dlen) {
    // Extract key as two 32-bit words from the key array
    let mut k0 = (siphash_key[0] + siphash_key[1] * 256 + siphash_key[2] * 65536 + siphash_key[3] * 16777216) % 4294967296;
    let mut k1 = (siphash_key[8] + siphash_key[9] * 256 + siphash_key[10] * 65536 + siphash_key[11] * 16777216) % 4294967296;

    // Initialise state
    siphash_v0 = (k0 + 1952801890) % 4294967296;
    siphash_v1 = (k1 + 1685025377) % 4294967296;
    siphash_v2 = (k0 + 1819895653) % 4294967296;
    siphash_v3 = (k1 + 1852142177) % 4294967296;

    // Process 8-byte (simplified: 4-byte) blocks
    let mut pos    = 0;
    let mut blocks = dlen / 8;
    let mut i = 0;
    while i < blocks {
        let mut m = _siphash_read32_str(data, pos, dlen);
        _siphash_compress(m);
        pos = pos + 8;
        i = i + 1;
    }

    // Absorb remaining bytes + length tag
    let mut remaining = dlen % 8;
    let mut last_block = (dlen % 256) * 16777216;
    let mut j = 0;
    while j < remaining {
        let mut bval = str_char_code(data, pos + j);
        last_block = (last_block + bval * _siphash_pow256(j)) % 4294967296;
        j = j + 1;
    }
    _siphash_compress(last_block);

    // Finalization (4 SipRounds)
    siphash_v2 = (siphash_v2 + 255) % 4294967296;
    let mut fr = 0;
    while fr < 4 {
        _siphash_sipround();
        fr = fr + 1;
    }

    siphash_result = (siphash_v0 + siphash_v1 + siphash_v2 + siphash_v3) % 4294967296;
    return siphash_result;
}

// ---------------------------------------------------------------------------
// _siphash_to_hex -- render 32-bit value as 8 hex digits into siphash_hex_buf
// ---------------------------------------------------------------------------
fn _siphash_to_hex(value) {
    let mut hex_chars = "0123456789abcdef";
    let mut pos = 0;
    let mut i = 7;
    while i >= 0 {
        let mut shift = i * 4;
        let mut nibble = (value / _siphash_pow2(shift)) % 16;
        set_at(siphash_hex_buf, pos, str_char_code(hex_chars, nibble));
        pos = pos + 1;
        i = i - 1;
    }
    set_at(siphash_hex_buf, pos, 0);
    return siphash_hex_buf;
}

// ---------------------------------------------------------------------------
// siphash_get_hex -- return last hash as hex string
// ---------------------------------------------------------------------------
fn siphash_get_hex() {
    return _siphash_to_hex(siphash_result);
}

// ---------------------------------------------------------------------------
// siphash_get_result -- return last hash as integer
// ---------------------------------------------------------------------------
fn siphash_get_result() {
    return siphash_result;
}

// ---------------------------------------------------------------------------
// siphash_get_state -- return first 8 bytes of state in siphash_state_buf
// ---------------------------------------------------------------------------
fn siphash_get_state() {
    set_at(siphash_state_buf, 0, siphash_v0 % 256);
    set_at(siphash_state_buf, 1, (siphash_v0 / 256) % 256);
    set_at(siphash_state_buf, 2, (siphash_v0 / 65536) % 256);
    set_at(siphash_state_buf, 3, (siphash_v0 / 16777216) % 256);
    set_at(siphash_state_buf, 4, siphash_v1 % 256);
    set_at(siphash_state_buf, 5, (siphash_v1 / 256) % 256);
    set_at(siphash_state_buf, 6, (siphash_v1 / 65536) % 256);
    set_at(siphash_state_buf, 7, (siphash_v1 / 16777216) % 256);
    return siphash_state_buf;
}

// ---------------------------------------------------------------------------
// siphash_test -- basic self-test
// ---------------------------------------------------------------------------
fn siphash_test() {
    let mut test_key = "0123456789abcdef";
    let mut test_data = "SipHash test message";

    // Load key
    let mut r = siphash_set_key(test_key);
    if r < 0 {
        print("siphash_test: key setup failed");
        return 0 - 1;
    }

    // Determinism check
    let mut hash1 = siphash(test_data, len(test_data));
    let mut hash2 = siphash(test_data, len(test_data));
    if hash1 != hash2 {
        print("siphash_test: determinism failed");
        return 0 - 2;
    }

    // Key variation check
    let mut diff_key = "fedcba9876543210";
    siphash_set_key(diff_key);
    let mut hash3 = siphash(test_data, len(test_data));
    if hash1 == hash3 {
        print("siphash_test: key variation failed");
        return 0 - 3;
    }

    print("siphash_test: passed");
    return 0;
}

siphash_test();
print("siphash.hl loaded");
