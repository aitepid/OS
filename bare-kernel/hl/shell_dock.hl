// shell_dock.hl -- 底部任务栏 / Dock（Sprint G5）
//
// Win11 桌面形态：中心对齐的固定/运行图标条。每项是 48×48 圆角槽位，
// 运行中的应用在底部显示 3 px 强调色指示器。点击启动或激活窗口。

let DOCK_ITEM_W       = 48;
let DOCK_ITEM_GAP     = 6;
let DOCK_HEIGHT       = 56;
let DOCK_MAX_ITEMS    = 16;

let mut dock_initialized = 0;
let mut dock_item_label  = [0];
let mut dock_item_running= [0];
let mut dock_item_app_id = [0];
let mut dock_count       = 0;
let mut dock_visible     = 1;
let mut dock_hovered     = 0 - 1;

fn shell_dock_init() {
    if dock_initialized == 1 { return 0; }
    dock_item_label   = array_new(DOCK_MAX_ITEMS, 0);
    dock_item_running = array_new(DOCK_MAX_ITEMS, 0);
    dock_item_app_id  = array_new(DOCK_MAX_ITEMS, 0);
    dock_count = 0;
    dock_initialized = 1;
    print("shell_dock: ready");
    return 0;
}

fn shell_dock_add(label_addr, app_id) {
    if dock_initialized == 0 { shell_dock_init(); }
    if dock_count >= DOCK_MAX_ITEMS { return 0 - 1; }
    let mut i = dock_count;
    dock_item_label[i]   = label_addr;
    dock_item_app_id[i]  = app_id;
    dock_item_running[i] = 0;
    dock_count = dock_count + 1;
    return i;
}

fn shell_dock_set_running(idx, on) {
    if idx < 0 { return 0; }
    if idx >= dock_count { return 0; }
    dock_item_running[idx] = on;
    return 0;
}

fn shell_dock_height() { return DOCK_HEIGHT; }

fn shell_dock_paint(screen_w, screen_h) {
    if dock_initialized == 0 { return 0; }
    if dock_visible == 0 { return 0; }
    if dock_count == 0 { return 0; }
    let mut total_w = dock_count * DOCK_ITEM_W + (dock_count - 1) * DOCK_ITEM_GAP + 16;
    let mut bar_x = (screen_w - total_w) / 2;
    let mut bar_y = screen_h - DOCK_HEIGHT;
    gfx_shadow_draw_n(bar_x, bar_y + 4, total_w, DOCK_ITEM_W + 8, 12);
    gfx_rect_round(bar_x, bar_y + 4, total_w, DOCK_ITEM_W + 8, 12,
                   ui_theme_bg_elevated());
    let mut i = 0;
    let mut ix = bar_x + 8;
    let mut iy = bar_y + 8;
    while i < dock_count {
        let mut bg = ui_theme_bg_overlay();
        if i == dock_hovered { bg = ui_theme_bg_surface(); }
        gfx_rect_round(ix, iy, DOCK_ITEM_W, DOCK_ITEM_W, 8, bg);
        // 图标占位：取标签首字符
        if dock_item_label[i] != 0 {
            let mut s = cstr_from_addr(dock_item_label[i]);
            let mut size = 22;
            font_atlas_draw_glyph(ix + (DOCK_ITEM_W - font_atlas_w(size)) / 2,
                                  iy + (DOCK_ITEM_W - font_atlas_h(size)) / 2,
                                  str_byte(s, 0), size, ui_theme_text_primary());
        }
        if dock_item_running[i] == 1 {
            gfx_rect_round(ix + DOCK_ITEM_W / 2 - 6, iy + DOCK_ITEM_W + 2,
                           12, 3, 2, ui_theme_accent_get());
        }
        ix = ix + DOCK_ITEM_W + DOCK_ITEM_GAP;
        i = i + 1;
    }
    return 0;
}

fn shell_dock_handle_pointer(ev_type, x, y, screen_w, screen_h) {
    if dock_initialized == 0 { return 0; }
    if dock_count == 0 { return 0; }
    let mut total_w = dock_count * DOCK_ITEM_W + (dock_count - 1) * DOCK_ITEM_GAP + 16;
    let mut bar_x = (screen_w - total_w) / 2;
    let mut bar_y = screen_h - DOCK_HEIGHT + 8;
    if y < bar_y { dock_hovered = 0 - 1; return 0; }
    if y > bar_y + DOCK_ITEM_W { dock_hovered = 0 - 1; return 0; }
    if x < bar_x + 8 { return 0; }
    let mut rel = x - bar_x - 8;
    let mut idx = rel / (DOCK_ITEM_W + DOCK_ITEM_GAP);
    if idx < 0           { return 0; }
    if idx >= dock_count { return 0; }
    if ev_type == PEV_TYPE_MOVE { dock_hovered = idx; return 1; }
    if ev_type == PEV_TYPE_UP {
        dock_item_running[idx] = 1;
        return 1;
    }
    return 0;
}

print("shell_dock.hl loaded");
