// memory_profiler.hl -- Memory Usage Profiler (Phase 6: 系统稳定化, iter 410)
// Buffer: 0x1D10000
// Tracks allocation events by site; records live bytes, peak usage
// MP_MAX_SITES=16; mp_record_alloc(site_id, size) / mp_record_free(size)
// mp_get_live() → current live bytes; mp_get_peak() → peak live bytes

let mut MP_MAX_SITES = 16;

let mp_site_bytes = array(16, 0);  // total bytes ever allocated at each site
let mp_site_count = array(16, 0);  // alloc event count at each site
let mut mp_n_sites    = 0;
let mut mp_total_alloc = 0;
let mut mp_total_free  = 0;
let mut mp_live        = 0;
let mut mp_peak        = 0;

fn mp_init() {
    let mut i = 0;
    while i < MP_MAX_SITES {
        set_at(mp_site_bytes, i, 0);
        set_at(mp_site_count, i, 0);
        i += 1;
    }
    mp_n_sites     = 0;
    mp_total_alloc = 0;
    mp_total_free  = 0;
    mp_live        = 0;
    mp_peak        = 0;
    return 0;
}

fn mp_record_alloc(site_id, size) {
    if site_id >= mp_n_sites { mp_n_sites = site_id + 1; }
    set_at(mp_site_bytes, site_id, mp_site_bytes[site_id] + size);
    set_at(mp_site_count, site_id, mp_site_count[site_id] + 1);
    mp_total_alloc += size;
    mp_live        += size;
    if mp_live > mp_peak { mp_peak = mp_live; }
    return 0;
}

fn mp_record_free(size) {
    mp_total_free += size;
    mp_live       -= size;
    return 0;
}

fn mp_get_live()           { return mp_live; }
fn mp_get_peak()           { return mp_peak; }
fn mp_get_total_alloc()    { return mp_total_alloc; }
fn mp_get_total_free()     { return mp_total_free; }
fn mp_get_site_bytes(site) { return mp_site_bytes[site]; }
fn mp_get_site_count(site) { return mp_site_count[site]; }
fn mp_get_n_sites()        { return mp_n_sites; }

fn mp_test() {
    mp_init();

    // Alloc 64 bytes at site 0 → live=64, peak=64
    mp_record_alloc(0, 64);
    // Alloc 128 bytes at site 0 → live=192, peak=192
    mp_record_alloc(0, 128);
    // Alloc 256 bytes at site 1 → live=448, peak=448
    mp_record_alloc(1, 256);
    // Free 192 bytes → live=256, peak unchanged at 448
    mp_record_free(192);

    let mut live = mp_get_live();           // 256
    let mut peak = mp_get_peak();           // 448
    let mut sb0 = mp_get_site_bytes(0);    // 192
    let mut sb1 = mp_get_site_bytes(1);    // 256

    print("mp_test: live=" + to_string(live)
          + " peak=" + to_string(peak)
          + " sb0=" + to_string(sb0)
          + " sb1=" + to_string(sb1));

    if live == 256 {
        if peak == 448 {
            if sb0 == 192 {
                if sb1 == 256 {
                    print("mp_test: PASS");
                    return 1;
                }
            }
        }
    }
    print("mp_test: FAIL");
    return 0;
}

print("memory_profiler.hl loaded");
