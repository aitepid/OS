// test.hl -- H-L Self-Test Suite (replaces test-runner.js for kernel tests)
// Runs inside the H-L micro-runtime at boot.

let mut passed = 0;
let mut failed = 0;

// --- Arithmetic ---
if 2 + 3 * 4 == 14 { passed = passed + 1; } else { failed = failed + 1; print("FAIL: arithmetic"); }
if 100 / 4 == 25 { passed = passed + 1; } else { failed = failed + 1; print("FAIL: division"); }
if 17 % 5 == 2 { passed = passed + 1; } else { failed = failed + 1; print("FAIL: modulo"); }
if 0 - 5 == -5 { passed = passed + 1; } else { failed = failed + 1; print("FAIL: negation"); }

// --- Comparison ---
if 5 > 3 { passed = passed + 1; } else { failed = failed + 1; print("FAIL: gt"); }
if 3 < 5 { passed = passed + 1; } else { failed = failed + 1; print("FAIL: lt"); }
if 5 >= 5 { passed = passed + 1; } else { failed = failed + 1; print("FAIL: gte"); }
if 5 <= 5 { passed = passed + 1; } else { failed = failed + 1; print("FAIL: lte"); }
if 5 == 5 { passed = passed + 1; } else { failed = failed + 1; print("FAIL: eq"); }
if 5 != 4 { passed = passed + 1; } else { failed = failed + 1; print("FAIL: neq"); }

// --- Logic ---
if true && true { passed = passed + 1; } else { failed = failed + 1; print("FAIL: and"); }
if true || false { passed = passed + 1; } else { failed = failed + 1; print("FAIL: or"); }
if !false { passed = passed + 1; } else { failed = failed + 1; print("FAIL: not"); }

// --- Variables & mutation ---
let mut x = 10;
x = x + 5;
if x == 15 { passed = passed + 1; } else { failed = failed + 1; print("FAIL: mut"); }

// --- While loop ---
let mut sum = 0;
let mut i = 1;
while i <= 100 {
    sum = sum + i;
    i = i + 1;
}
if sum == 5050 { passed = passed + 1; } else { failed = failed + 1; print("FAIL: sum 1..100"); }

// --- Functions ---
fn square(n) { return n * n; }
if square(7) == 49 { passed = passed + 1; } else { failed = failed + 1; print("FAIL: fn square"); }

fn factorial(n) {
    if n <= 1 { return 1; }
    return n * factorial(n - 1);
}
if factorial(6) == 720 { passed = passed + 1; } else { failed = failed + 1; print("FAIL: factorial"); }

// --- Hilbert intrinsics ---
let key = hilbert_encode(10, 20, 30);
if key > 0 { passed = passed + 1; } else { failed = failed + 1; print("FAIL: hilbert_encode"); }

let mut dist = hilbert_dist(0, key);
if dist > 0 { passed = passed + 1; } else { failed = failed + 1; print("FAIL: hilbert_dist"); }

// --- Nested functions ---
fn add(a, b) { return a + b; }
fn double(n) { return n * 2; }
if add(double(3), double(4)) == 14 { passed = passed + 1; } else { failed = failed + 1; print("FAIL: nested call"); }

// --- GCD (Euclidean algorithm) ---
fn gcd(a, b) {
    while b != 0 {
        let mut t = b;
        b = a % b;
        a = t;
    }
    return a;
}
if gcd(48, 18) == 6 { passed = passed + 1; } else { failed = failed + 1; print("FAIL: gcd"); }

// --- Results ---
print(passed);
print(failed);
if failed == 0 {
    print("ALL TESTS PASSED");
} else {
    print("SOME TESTS FAILED");
}
