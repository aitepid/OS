// ntp.hl -- SNTP Client (RFC 4330)
//
// Iteration 163: Synchronize kernel clock from NTP server via UDP port 123.
//
// Packet format (48 bytes, big-endian):
//   Byte  0:  LI(2b)|VN(3b)|Mode(3b)  Client sends: LI=0, VN=4, Mode=3 → 0x23
//   Bytes 1-3:  Stratum / Poll / Precision (zero in request)
//   Bytes 4-11: Root Delay + Root Dispersion (zero)
//   Bytes 12-15: Reference ID (zero)
//   Bytes 16-39: Reference / Originate / Receive Timestamps (zero)
//   Bytes 40-47: Transmit Timestamp — server writes seconds since 1900-01-01
//
//   Seconds[40-43] big-endian u32.  Subtract NTP_EPOCH_DELTA to get Unix time.
//
// Receive: registers callback via ntp_udp_register(); udp_handle() calls
//   ntp_on_recv(data) when a packet arrives on NTP_LOCAL_PORT.
//
// Public API:
//   ntp_init()
//   ntp_sync(host)        → unix_time (0 on failure)
//   ntp_get_time()        → estimated current unix time (0 if never synced)
//   ntp_format_time(t)    → "YYYY-MM-DD HH:MM:SS"
//   ntp_status()          → status string
//   ntp_on_recv(data)     → called by UDP stack on incoming response

let NTP_PORT        = 123;
let NTP_LOCAL_PORT  = 12300;
let NTP_PKT_LEN     = 48;
let NTP_EPOCH_DELTA = 2208988800;
let NTP_TIMEOUT     = 500;   // ticks (5 s at 100 Hz)

let mut ntp_synced     = 0;
let mut ntp_last_unix  = 0;
let mut ntp_last_tick  = 0;
let mut ntp_server     = "";
let mut ntp_sync_count = 0;
let mut ntp_resp_ready = 0;
let mut ntp_resp_data  = [];

// ============================================================
// Packet helpers
// ============================================================

fn _ntp_build_request() {
    let mut pkt = [];
    // Byte 0: LI=0, VN=4, Mode=3 → 0x23 = 35
    push(pkt, 35);
    push(pkt, 0);   // stratum 0 = unspecified
    push(pkt, 6);   // poll = 2^6 = 64 s
    push(pkt, 236); // precision -20 (0xEC)
    let mut i = 0;
    while i < 44 { push(pkt, 0); i = i + 1; }
    return pkt;
}

// Read big-endian u32 from HL byte array at offset
fn _ntp_u32_be(arr, off) {
    return arr[off] * 16777216 + arr[off + 1] * 65536
        + arr[off + 2] * 256 + arr[off + 3];
}

// ============================================================
// UDP receive callback (called by udp_handle on arrival)
// ============================================================

fn ntp_on_recv(data) {
    if len(data) < NTP_PKT_LEN { return 0; }
    ntp_resp_data  = data;
    ntp_resp_ready = 1;
    return 0;
}

// ============================================================
// Date/time formatting
// ============================================================

fn _ntp_pad2(n) {
    if n < 10 { return "0" + to_string(n); }
    return to_string(n);
}

fn _ntp_dim(m, y) {
    if m == 2 {
        let mut leap = 0;
        if y % 4 == 0 {
            if y % 100 != 0 { leap = 1; }
            else { if y % 400 == 0 { leap = 1; } }
        }
        if leap == 1 { return 29; }
        return 28;
    }
    if m == 4  { return 30; } if m == 6 { return 30; }
    if m == 9  { return 30; } if m == 11 { return 30; }
    return 31;
}

fn ntp_format_time(unix) {
    if unix <= 0 { return "1970-01-01 00:00:00"; }
    let sec  = unix % 60;
    let min  = (unix / 60) % 60;
    let hr   = (unix / 3600) % 24;
    let mut rem = unix / 86400;
    let mut y = 1970;
    let mut cont = 1;
    while cont == 1 {
        let mut yd = 365;
        if y % 4 == 0 {
            if y % 100 != 0 { yd = 366; }
            else { if y % 400 == 0 { yd = 366; } }
        }
        if rem < yd { cont = 0; }
        else { rem = rem - yd; y = y + 1; }
    }
    let mut m = 1;
    let mut cont2 = 1;
    while cont2 == 1 {
        let dm = _ntp_dim(m, y);
        if rem < dm { cont2 = 0; }
        else { rem = rem - dm; m = m + 1; }
    }
    let mut d = rem + 1;
    return to_string(y) + "-" + _ntp_pad2(m) + "-" + _ntp_pad2(d)
         + " " + _ntp_pad2(hr) + ":" + _ntp_pad2(min) + ":" + _ntp_pad2(sec);
}

// ============================================================
// Core sync
// ============================================================

fn ntp_sync(host) {
    ntp_server     = host;
    ntp_resp_ready = 0;
    ntp_resp_data  = [];

    let ip = dns_resolve(host);
    if ip == 0 {
        print("ntp: dns_resolve failed for " + host);
        return 0;
    }

    let sock = udp_bind(NTP_LOCAL_PORT);
    if sock < 0 { print("ntp: udp_bind failed"); return 0; }

    let req = _ntp_build_request();
    udp_send(ip, NTP_PORT, NTP_LOCAL_PORT, req);

    // Poll for response callback
    let deadline = get_ticks() + NTP_TIMEOUT;
    while ntp_resp_ready == 0 {
        if get_ticks() >= deadline { udp_close(sock); print("ntp: timeout"); return 0; }
    }
    udp_close(sock);

    // Validate mode == 4 (server reply)
    let mut mode = ntp_resp_data[0] % 8;
    if mode != 4 {
        print("ntp: unexpected mode " + to_string(mode));
        return 0;
    }

    let ntp_secs = _ntp_u32_be(ntp_resp_data, 40);
    if ntp_secs < NTP_EPOCH_DELTA {
        print("ntp: implausible timestamp " + to_string(ntp_secs));
        return 0;
    }

    let unix_secs = ntp_secs - NTP_EPOCH_DELTA;
    ntp_last_unix  = unix_secs;
    ntp_last_tick  = get_ticks();
    ntp_synced     = 1;
    ntp_sync_count = ntp_sync_count + 1;

    let ts = ntp_format_time(unix_secs);
    klog(1, "ntp", "synced to " + host + ": " + ts);
    print("ntp: synchronized — " + ts + " (unix=" + to_string(unix_secs) + ")");
    return unix_secs;
}

fn ntp_get_time() {
    if ntp_synced == 0 { return 0; }
    let elapsed = get_ticks() - ntp_last_tick;
    return ntp_last_unix + elapsed / 100;
}

fn ntp_status() {
    if ntp_synced == 0 { return "ntp: never synced — use: ntp sync <host>"; }
    return "ntp: server=" + ntp_server
        + "  last=" + ntp_format_time(ntp_last_unix)
        + "  now~" + ntp_format_time(ntp_get_time())
        + "  syncs=" + to_string(ntp_sync_count);
}

fn ntp_init() {
    ntp_synced     = 0;
    ntp_last_unix  = 0;
    ntp_last_tick  = 0;
    ntp_server     = "";
    ntp_sync_count = 0;
    ntp_resp_ready = 0;
    ntp_resp_data  = [];
    print("ntp: init — SNTP client, UDP port 123, NTP epoch delta=" + to_string(NTP_EPOCH_DELTA));
    return 0;
}

print("ntp.hl loaded");
print("NTP: SNTP v4 client, RFC 4330, UDP port 123, callback-based recv, Unix time formatter");
