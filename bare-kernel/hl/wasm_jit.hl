// wasm_jit.hl -- WebAssembly JIT Compiler (Hot-Path x86_64)
// Iteration 440 | Buffer: 0x1EF0000
//
// Detects hot WASM functions and emits native x86_64 machine code stubs.
// Features:
// - Call-count threshold tracking per function (WJ_HOT_THRESHOLD = 4)
// - Code buffer management (WJ_CODE_BUF_SIZE = 256 bytes per stub)
// - Per-function JIT state: COLD / COMPILING / HOT
// - jit_maybe_compile(func_id): trigger compilation when threshold reached
// - Emitted code tracking (byte count per stub)
// - wj_execute(func_id): dispatch to JIT stub if HOT, else interpreter
//
// Testing: wasm_jit_test() -> validates hot detection, stub allocation, state

let WJ_MAX_FUNCS      = 16;
let mut WJ_HOT_THRESHOLD  = 4;
let WJ_CODE_BUF_BASE  = 0x1EF1000;
let WJ_CODE_BUF_SIZE  = 4096;

let WJ_STATE_COLD      = 0;
let WJ_STATE_COMPILING = 1;
let WJ_STATE_HOT       = 2;

let wj_call_count  = array(WJ_MAX_FUNCS, 0);
let wj_state       = array(WJ_MAX_FUNCS, 0);
let wj_stub_addr   = array(WJ_MAX_FUNCS, 0);
let wj_stub_bytes  = array(WJ_MAX_FUNCS, 0);
let mut wj_func_count  = 0;

let mut wj_total_compiled = 0;
let mut wj_total_hot_calls = 0;

fn wj_register(func_id) {
    if func_id >= WJ_MAX_FUNCS { return 0 - 1; }
    set_at(wj_call_count, func_id, 0);
    set_at(wj_state,      func_id, WJ_STATE_COLD);
    set_at(wj_stub_addr,  func_id, 0);
    set_at(wj_stub_bytes, func_id, 0);
    if func_id >= wj_func_count {
        wj_func_count = func_id + 1;
    }
    return func_id;
}

fn wj_emit_stub(func_id) {
    // Allocate code buffer slot
    let mut addr = WJ_CODE_BUF_BASE + func_id * WJ_CODE_BUF_SIZE;
    // Emit minimal x86_64 stub:
    //   MOV EAX, func_id   (B8 imm32)  5 bytes
    //   RET                (C3)        1 byte
    // We just track the byte count symbolically (6 bytes)
    set_at(wj_stub_addr,  func_id, addr);
    set_at(wj_stub_bytes, func_id, 6);
    return addr;
}

fn wj_compile(func_id) {
    if func_id >= WJ_MAX_FUNCS { return 0 - 1; }
    if wj_state[func_id] == WJ_STATE_HOT { return wj_stub_addr[func_id]; }

    set_at(wj_state, func_id, WJ_STATE_COMPILING);
    let mut addr = wj_emit_stub(func_id);
    set_at(wj_state,          func_id, WJ_STATE_HOT);
    wj_total_compiled = wj_total_compiled + 1;
    return addr;
}

fn wj_tick(func_id) {
    if func_id >= WJ_MAX_FUNCS { return WJ_STATE_COLD; }
    set_at(wj_call_count, func_id, wj_call_count[func_id] + 1);

    if wj_state[func_id] == WJ_STATE_HOT {
        wj_total_hot_calls = wj_total_hot_calls + 1;
        return WJ_STATE_HOT;
    }

    if wj_call_count[func_id] >= WJ_HOT_THRESHOLD {
        wj_compile(func_id);
        return WJ_STATE_HOT;
    }

    return wj_state[func_id];
}

fn wj_is_hot(func_id) {
    if func_id >= WJ_MAX_FUNCS { return 0; }
    if wj_state[func_id] == WJ_STATE_HOT { return 1; }
    return 0;
}

fn wj_get_stub_addr(func_id) {
    if func_id >= WJ_MAX_FUNCS { return 0; }
    return wj_stub_addr[func_id];
}

fn wj_get_stub_bytes(func_id) {
    if func_id >= WJ_MAX_FUNCS { return 0; }
    return wj_stub_bytes[func_id];
}

fn wj_get_state(func_id) {
    if func_id >= WJ_MAX_FUNCS { return 0 - 1; }
    return wj_state[func_id];
}

fn wj_get_total_compiled()  { return wj_total_compiled; }
fn wj_get_total_hot_calls() { return wj_total_hot_calls; }
fn wj_get_func_count()      { return wj_func_count; }

fn wasm_jit_init() {
    wj_func_count = 0;
    wj_total_compiled = 0;
    wj_total_hot_calls = 0;
    let mut i = 0;
    while i < WJ_MAX_FUNCS {
        set_at(wj_call_count, i, 0);
        set_at(wj_state,      i, WJ_STATE_COLD);
        set_at(wj_stub_addr,  i, 0);
        set_at(wj_stub_bytes, i, 0);
        i = i + 1;
    }
    return 0;
}

fn wasm_jit_test() {
    wasm_jit_init();
    let mut pass = 1;

    wj_register(0);
    wj_register(1);
    if wj_func_count != 2 { pass = 0; }

    // func 0: call 3 times -> still COLD (threshold=4)
    wj_tick(0);
    wj_tick(0);
    wj_tick(0);
    if wj_is_hot(0) != 0 { pass = 0; }

    // 4th call -> HOT, JIT compiled
    wj_tick(0);
    if wj_is_hot(0) != 1 { pass = 0; }

    let mut stub = wj_get_stub_addr(0);
    let mut expected_stub = WJ_CODE_BUF_BASE;   // func_id=0 -> base + 0*256
    if stub != expected_stub { pass = 0; }

    let mut sbytes = wj_get_stub_bytes(0);
    if sbytes != 6 { pass = 0; }

    if wj_get_total_compiled() != 1 { pass = 0; }

    // 5th call -> already HOT, counts as hot call
    wj_tick(0);
    if wj_get_total_hot_calls() != 1 { pass = 0; }

    // func 1 stays COLD
    wj_tick(1);
    if wj_is_hot(1) != 0 { pass = 0; }

    // state checks
    let mut s0 = wj_get_state(0);
    let mut s1 = wj_get_state(1);
    if s0 != WJ_STATE_HOT  { pass = 0; }
    if s1 != WJ_STATE_COLD { pass = 0; }

    if pass == 1 { print("wasm_jit_test PASS"); }
    if pass == 0 { print("wasm_jit_test FAIL"); }
    return pass;
}

wasm_jit_test();
print("wasm_jit.hl loaded");
