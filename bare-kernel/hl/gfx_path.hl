// gfx_path.hl -- 2D path: MoveTo / LineTo / scanline fill
//
// Sprint G1 of HicOS GUI injection (per GUI_DESIGN.md §3.2).
//
// A minimal path renderer needed by widgets (chevrons, checkmarks,
// triangle indicators, polygon legends). Quadratic/cubic Beziers can be
// added later; for G1 polylines suffice.
//
// Storage: a single global path with at most GFX_PATH_MAX vertices.
//   path_x[i], path_y[i] are arrays of 16.0 integer pixel coords.
//   path_cmd[i] = 0 (move), 1 (line), 2 (close).
//
// Fill: even-odd rule via active-edge-table scanline traversal.

let GFX_PATH_MAX = 256;

let mut path_x   = [0];
let mut path_y   = [0];
let mut path_cmd = [0];
let mut path_len = 0;
let mut path_initialized = 0;

fn gfx_path_init() {
    if path_initialized == 1 { return 0; }
    path_x   = array_new(GFX_PATH_MAX, 0);
    path_y   = array_new(GFX_PATH_MAX, 0);
    path_cmd = array_new(GFX_PATH_MAX, 0);
    path_initialized = 1;
    return 0;
}

fn gfx_path_reset() {
    gfx_path_init();
    path_len = 0;
    return 0;
}

fn gfx_path_move(x, y) {
    gfx_path_init();
    if path_len >= GFX_PATH_MAX { return 0; }
    path_x[path_len]   = x;
    path_y[path_len]   = y;
    path_cmd[path_len] = 0;
    path_len = path_len + 1;
    return 0;
}

fn gfx_path_line(x, y) {
    gfx_path_init();
    if path_len >= GFX_PATH_MAX { return 0; }
    path_x[path_len]   = x;
    path_y[path_len]   = y;
    path_cmd[path_len] = 1;
    path_len = path_len + 1;
    return 0;
}

fn gfx_path_close() {
    gfx_path_init();
    if path_len >= GFX_PATH_MAX { return 0; }
    path_cmd[path_len] = 2;
    path_x[path_len]   = 0;
    path_y[path_len]   = 0;
    path_len = path_len + 1;
    return 0;
}

// Stroke: draw AA lines between consecutive segments.
fn gfx_path_stroke(color) {
    if path_len < 2 { return 0; }
    let mut i = 0;
    let mut px = 0;
    let mut py = 0;
    let mut sx = 0;  // subpath start
    let mut sy = 0;
    while i < path_len {
        let mut cmd = path_cmd[i];
        if cmd == 0 {
            sx = path_x[i]; sy = path_y[i];
            px = sx;        py = sy;
        } else if cmd == 1 {
            gfx_line_aa(px, py, path_x[i], path_y[i], color);
            px = path_x[i]; py = path_y[i];
        } else if cmd == 2 {
            gfx_line_aa(px, py, sx, sy, color);
            px = sx; py = sy;
        }
        i = i + 1;
    }
    return 0;
}

// Even-odd scanline fill.
// For each row y, walk the path and collect x where any edge crosses y;
// sort the list, then fill between pairs.
fn gfx_path_fill(color) {
    if path_len < 3 { return 0; }
    // Bounding box
    let mut min_y = path_y[0];
    let mut max_y = path_y[0];
    let mut i = 1;
    while i < path_len {
        if path_cmd[i] != 2 {
            if path_y[i] < min_y { min_y = path_y[i]; }
            if path_y[i] > max_y { max_y = path_y[i]; }
        }
        i = i + 1;
    }
    if min_y < 0 { min_y = 0; }
    if max_y >= gfx_back_height { max_y = gfx_back_height - 1; }
    if max_y < min_y { return 0; }

    let mut xs = array_new(GFX_PATH_MAX, 0);
    let mut y = min_y;
    while y <= max_y {
        let mut nx = 0;
        // Walk edges
        let mut j = 0;
        let mut px = 0;
        let mut py = 0;
        let mut sx = 0;
        let mut sy = 0;
        while j < path_len {
            let mut cmd = path_cmd[j];
            let mut ex = 0;
            let mut ey = 0;
            let mut have_edge = 0;
            if cmd == 0 {
                sx = path_x[j]; sy = path_y[j];
                px = sx;        py = sy;
            } else if cmd == 1 {
                ex = path_x[j]; ey = path_y[j];
                have_edge = 1;
            } else if cmd == 2 {
                ex = sx; ey = sy;
                have_edge = 1;
            }
            if have_edge == 1 {
                // Edge from (px,py) to (ex,ey); test if it crosses scanline y.
                let mut y0 = py;
                let mut y1 = ey;
                let mut x0 = px;
                let mut x1 = ex;
                // Use half-open [min_y, max_y) per standard AET rule.
                let mut ymin = y0;
                let mut ymax = y1;
                if ymin > ymax { ymin = y1; ymax = y0; }
                if y >= ymin {
                    if y < ymax {
                        // Linear x at scanline y
                        let mut dy = y1 - y0;
                        if dy != 0 {
                            let mut xi = x0 + (x1 - x0) * (y - y0) / dy;
                            if nx < GFX_PATH_MAX {
                                xs[nx] = xi;
                                nx = nx + 1;
                            }
                        }
                    }
                }
                px = ex; py = ey;
            }
            j = j + 1;
        }
        // Insertion sort the xs list
        let mut a = 1;
        while a < nx {
            let mut v = xs[a];
            let mut b = a - 1;
            while b >= 0 {
                if xs[b] > v {
                    xs[b + 1] = xs[b];
                    b = b - 1;
                } else {
                    b = 0 - 1;
                }
            }
            xs[b + 1] = v;
            a = a + 1;
        }
        // Fill between pairs
        let mut p = 0;
        while p + 1 < nx {
            let mut xa = xs[p];
            let mut xb = xs[p + 1];
            if xa < 0                  { xa = 0; }
            if xb > gfx_back_width - 1 { xb = gfx_back_width - 1; }
            if xb >= xa {
                gfx_fill_rect(xa, y, xb - xa + 1, 1, color);
            }
            p = p + 2;
        }
        y = y + 1;
    }
    return 0;
}

print("gfx_path.hl loaded");
