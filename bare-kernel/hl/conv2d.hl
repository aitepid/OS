// conv2d.hl -- 2D Convolutional layer (Phase 5: ML深化, iter 396)
// Buffer: 0x1C30000
// Fixed-point arithmetic: values scaled by CV_SCALE=256
// Input: CV_MAX_H=8, CV_MAX_W=8, CV_MAX_CH=4 channels
// Kernels: CV_MAX_KSIZE=3 (3×3), CV_MAX_OUT_CH=4 output channels
// Operations: conv2d_forward(in_ch, out_ch, k_size, stride, padding)
// Activation: ReLU (max(0, x)) applied after conv
// Output stored in cv_output[out_ch][h][w] (flat array)

let mut CV_MAX_H    = 8;
let mut CV_MAX_W    = 8;
let mut CV_MAX_CH   = 4;
let mut CV_MAX_KSIZE= 3;
let mut CV_MAX_OUT_CH = 4;
let mut CV_SCALE    = 256;   // fixed-point scale factor

// Input feature map: cv_input[ch * 64 + r * 8 + c]
let CV_IN_STRIDE  = 64;   // CH * H * W = 1 * 8 * 8
let cv_input      = array(256, 0);  // CV_MAX_CH * CV_MAX_H * CV_MAX_W

// Kernel weights: cv_kernel[out_ch * 4 * 9 + in_ch * 9 + kr * 3 + kc]
// (out_ch, in_ch, kr, kc) → flat index
let CV_K_STRIDE_OC = 36;   // CV_MAX_CH * CV_MAX_KSIZE^2
let CV_K_STRIDE_IC = 9;    // CV_MAX_KSIZE^2
let cv_kernel     = array(144, 0);  // CV_MAX_OUT_CH * 4 * 9

// Bias: one per output channel
let cv_bias       = array(4, 0);

// Output feature map: cv_output[out_ch * 64 + r * 8 + c]
let cv_output     = array(256, 0);

// Dimensions of last forward pass
let mut cv_out_h      = 0;
let mut cv_out_w      = 0;
let mut cv_out_ch     = 0;
let mut cv_in_ch_last = 0;

fn cv_init() {
    let mut i = 0;
    while i < 256 {
        set_at(cv_input,  i, 0);
        set_at(cv_output, i, 0);
        i += 1;
    }
    let mut j = 0;
    while j < 144 {
        set_at(cv_kernel, j, 0);
        j += 1;
    }
    let mut k = 0;
    while k < CV_MAX_OUT_CH {
        set_at(cv_bias, k, 0);
        k += 1;
    }
    cv_out_h = 0; cv_out_w = 0; cv_out_ch = 0; cv_in_ch_last = 0;
    return 0;
}

fn cv_set_input(r, c, ch, val) {
    set_at(cv_input, ch * CV_IN_STRIDE + r * CV_MAX_W + c, val);
    return 0;
}

fn cv_get_input(r, c, ch) {
    return cv_input[ch * CV_IN_STRIDE + r * CV_MAX_W + c];
}

fn cv_set_kernel(out_ch, in_ch, kr, kc, val) {
    let mut idx = out_ch * CV_K_STRIDE_OC + in_ch * CV_K_STRIDE_IC + kr * CV_MAX_KSIZE + kc;
    set_at(cv_kernel, idx, val);
    return 0;
}

fn cv_get_kernel(out_ch, in_ch, kr, kc) {
    return cv_kernel[out_ch * CV_K_STRIDE_OC + in_ch * CV_K_STRIDE_IC + kr * CV_MAX_KSIZE + kc];
}

fn cv_set_bias(out_ch, val) {
    set_at(cv_bias, out_ch, val);
    return 0;
}

fn cv_get_output(r, c, out_ch) {
    return cv_output[out_ch * CV_IN_STRIDE + r * CV_MAX_W + c];
}

fn _cv_relu(x) {
    if x < 0 { return 0; }
    return x;
}

fn _cv_pad_input(r, c, ch, h_in, w_in) {
    // Returns input value with zero-padding
    if r < 0 { return 0; }
    if c < 0 { return 0; }
    if r >= h_in { return 0; }
    if c >= w_in { return 0; }
    return cv_get_input(r, c, ch);
}

fn conv2d_forward(in_ch, out_ch, k_size, stride, padding) {
    // Compute output dimensions
    let h_in   = CV_MAX_H;
    let w_in   = CV_MAX_W;
    let h_out  = (h_in + 2 * padding - k_size) / stride + 1;
    let w_out  = (w_in + 2 * padding - k_size) / stride + 1;
    if h_out > CV_MAX_H { h_out = CV_MAX_H; }
    if w_out > CV_MAX_W { w_out = CV_MAX_W; }

    cv_out_h      = h_out;
    cv_out_w      = w_out;
    cv_out_ch     = out_ch;
    cv_in_ch_last = in_ch;

    // Clear output
    let oc = 0;
    while oc < out_ch {
        let or = 0;
        while or < h_out {
            let ow = 0;
            while ow < w_out {
                set_at(cv_output, oc * CV_IN_STRIDE + or * CV_MAX_W + ow, 0);
                ow += 1;
            }
            or += 1;
        }
        oc += 1;
    }

    // Convolution: for each output position and channel
    oc = 0;
    while oc < out_ch {
        let or = 0;
        while or < h_out {
            let ow = 0;
            while ow < w_out {
                // Compute input region start
                let ir_start = or * stride - padding;
                let ic_start = ow * stride - padding;
                let accum    = cv_bias[oc] * CV_SCALE;

                // Convolve over in_ch × k_size × k_size
                let ic = 0;
                while ic < in_ch {
                    let kr = 0;
                    while kr < k_size {
                        let kc = 0;
                        while kc < k_size {
                            let ir = ir_start + kr;
                            let icc= ic_start + kc;
                            let xv = _cv_pad_input(ir, icc, ic, h_in, w_in);
                            let wv = cv_get_kernel(oc, ic, kr, kc);
                            accum  = accum + xv * wv;
                            kc += 1;
                        }
                        kr += 1;
                    }
                    ic += 1;
                }

                // Divide by scale, apply ReLU
                let out_val = accum / CV_SCALE;
                out_val = _cv_relu(out_val);
                set_at(cv_output, oc * CV_IN_STRIDE + or * CV_MAX_W + ow, out_val);
                ow += 1;
            }
            or += 1;
        }
        oc += 1;
    }
    return h_out * w_out * out_ch;
}

fn cv_output_h()   { return cv_out_h; }
fn cv_output_w()   { return cv_out_w; }
fn cv_output_ch()  { return cv_out_ch; }

fn cv_test() {
    cv_init();

    // 4×4 input, 1 channel, values = row*4 + col + 1
    let mut r = 0;
    while r < 4 {
        let mut c = 0;
        while c < 4 {
            cv_set_input(r, c, 0, r * 4 + c + 1);
            c += 1;
        }
        r += 1;
    }

    // 3×3 kernel for out_ch=0, in_ch=0: identity-like (center=256, rest=0)
    cv_set_kernel(0, 0, 1, 1, CV_SCALE);  // center weight = 1.0 (scaled)
    cv_set_bias(0, 0);

    // Identity conv (3×3, stride=1, padding=1) → same spatial size
    // Output at (r,c) should equal input at (r,c)
    let mut n = conv2d_forward(1, 1, 3, 1, 1);

    // Check output[0,0,0] = relu(input[0,0]) = 1
    let v00 = cv_get_output(0, 0, 0);
    // Check output[1,2,0] = relu(input[1,2]) = 7
    let v12 = cv_get_output(1, 2, 0);
    // Check output[3,3,0] = relu(input[3,3]) = 16
    let v33 = cv_get_output(3, 3, 0);

    let oh = cv_output_h();
    let ow = cv_output_w();

    print("cv_test: n=" + to_string(n)
          + " v00=" + to_string(v00)
          + " v12=" + to_string(v12)
          + " v33=" + to_string(v33)
          + " oh=" + to_string(oh)
          + " ow=" + to_string(ow));

    if v00 == 1 {
        if v12 == 7 {
            if v33 == 16 {
                if oh == 8 {
                    print("cv_test: PASS");
                    return 1;
                }
            }
        }
    }
    print("cv_test: FAIL");
    return 0;
}

print("conv2d.hl loaded");
