// shell_spotlight.hl -- 全局搜索（Sprint G5）
//
// 屏幕上方居中的搜索浮窗：输入框 + 结果列表。结果来自简单的字符串前缀
// 匹配（应用名/命令/文件）。Esc 关闭，Enter 触发首条。

let SPOT_W            = 560;
let SPOT_H            = 380;
let SPOT_INPUT_H      = 44;
let SPOT_ROW_H        = 36;
let SPOT_MAX_RESULTS  = 8;

let mut spot_initialized = 0;
let mut spot_visible     = 0;
let mut spot_query_addr  = 0;
let mut spot_query_len   = 0;
let mut spot_results     = [0];
let mut spot_result_count= 0;
let mut spot_sel         = 0;

let SPOT_QUERY_BUF = 72367104;   // 0x04503000  (在 input pool 之后)

fn shell_spotlight_init() {
    if spot_initialized == 1 { return 0; }
    spot_results = array_new(SPOT_MAX_RESULTS, 0);
    spot_query_addr = SPOT_QUERY_BUF;
    spot_query_len  = 0;
    spot_result_count = 0;
    spot_visible = 0;
    spot_initialized = 1;
    print("shell_spotlight: ready");
    return 0;
}

fn shell_spotlight_show() {
    if spot_initialized == 0 { shell_spotlight_init(); }
    spot_visible = 1;
    spot_query_len = 0;
    mem_write_u8(spot_query_addr, 0);
    spot_result_count = 0;
    spot_sel = 0;
    return 0;
}

fn shell_spotlight_hide()    { spot_visible = 0; return 0; }
fn shell_spotlight_visible() { return spot_visible; }

fn shell_spotlight_set_result(idx, addr) {
    if idx < 0 { return 0; }
    if idx >= SPOT_MAX_RESULTS { return 0; }
    spot_results[idx] = addr;
    if idx >= spot_result_count { spot_result_count = idx + 1; }
    return 0;
}

fn shell_spotlight_input_char(ch) {
    if spot_visible == 0 { return 0; }
    if ch == 8 {
        if spot_query_len > 0 {
            spot_query_len = spot_query_len - 1;
            mem_write_u8(spot_query_addr + spot_query_len, 0);
        }
        return 0;
    }
    if ch == 27 { spot_visible = 0; return 0; }
    if spot_query_len >= 127 { return 0; }
    mem_write_u8(spot_query_addr + spot_query_len, ch);
    spot_query_len = spot_query_len + 1;
    mem_write_u8(spot_query_addr + spot_query_len, 0);
    return 0;
}

fn shell_spotlight_paint(screen_w, screen_h) {
    if spot_visible == 0 { return 0; }
    let mut x = (screen_w - SPOT_W) / 2;
    let mut y = screen_h / 4;
    gfx_shadow_draw_n(x, y, SPOT_W, SPOT_H, 24);
    gfx_rect_round(x, y, SPOT_W, SPOT_H, 12, ui_theme_bg_elevated());
    // 输入框
    let mut size = 17;
    gfx_fill_rect(x + 8, y + SPOT_INPUT_H, SPOT_W - 16, 1, ui_theme_bg_overlay());
    // 放大镜
    gfx_circle_aa(x + 20, y + SPOT_INPUT_H / 2, 5, ui_theme_text_secondary());
    gfx_line_aa(x + 24, y + SPOT_INPUT_H / 2 + 4, x + 30, y + SPOT_INPUT_H / 2 + 10,
                ui_theme_text_secondary());
    if spot_query_len == 0 {
        font_atlas_draw_str(x + 40, y + (SPOT_INPUT_H - font_atlas_h(size)) / 2,
                            "Search apps, files, settings...", size,
                            ui_theme_text_secondary());
    } else {
        font_atlas_draw_str(x + 40, y + (SPOT_INPUT_H - font_atlas_h(size)) / 2,
                            cstr_from_addr(spot_query_addr), size,
                            ui_theme_text_primary());
    }
    // 结果
    let mut i = 0;
    while i < spot_result_count {
        let mut ry = y + SPOT_INPUT_H + 8 + i * SPOT_ROW_H;
        if i == spot_sel {
            gfx_rect_round(x + 8, ry, SPOT_W - 16, SPOT_ROW_H - 4, 6,
                           ui_theme_accent_get());
        }
        if spot_results[i] != 0 {
            let mut fg = ui_theme_text_primary();
            if i == spot_sel { fg = gfx_pack(255, 255, 255, 255); }
            font_atlas_draw_str(x + 24, ry + (SPOT_ROW_H - font_atlas_h(13)) / 2,
                                cstr_from_addr(spot_results[i]), 13, fg);
        }
        i = i + 1;
    }
    return 0;
}

print("shell_spotlight.hl loaded");
