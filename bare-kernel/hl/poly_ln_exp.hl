// poly_ln_exp.hl -- Polynomial ln + exp via O(n^2) recurrences (iter 350)
// Buffer: 0x1950000
// ple_exp(n): g = exp(f) where f[0]=0. ple_ln(n): g = ln(f) where f[0]=1.
// g'=f'*g (exp) and f'=f*g' (ln) recurrences. All mod p=998244353. Max PLE_N=8.

let mut PLE_N = 8;
let PLE_P = 998244353;

let ple_f = array(8, 0);
let ple_g = array(8, 0);
let ple_t = array(8, 0);

fn ple_init() {
    let mut i = 0;
    while i < PLE_N {
        set_at(ple_f, i, 0); set_at(ple_g, i, 0); set_at(ple_t, i, 0);
        i += 1;
    }
    return 0;
}

fn _ple_mod(x) { return x - (x / PLE_P) * PLE_P; }
fn _ple_add(a, b) { let mut s = a + b; if s >= PLE_P { s = s - PLE_P; } return s; }
fn _ple_sub(a, b) { if a >= b { return a - b; } return a - b + PLE_P; }
fn _ple_mul(a, b) { return _ple_mod(a * b); }

fn _ple_powmod(base, exp) {
    let mut r = 1; let mut b = base; let mut e = exp;
    while e > 0 {
        if e - (e / 2) * 2 == 1 { r = _ple_mul(r, b); }
        b = _ple_mul(b, b);
        e = e / 2;
    }
    return r;
}

fn _ple_inv(a) { return _ple_powmod(a, PLE_P - 2); }

// g = exp(ple_f) mod x^n, f[0] must be 0
// g[0] = 1; g[k] = (1/k) * sum_{i=1}^{k} i * f[i] * g[k-i]
fn ple_exp(n) {
    let mut i = 0;
    while i < PLE_N { set_at(ple_g, i, 0); i += 1; }
    set_at(ple_g, 0, 1);
    let mut k = 1;
    while k < n {
        let mut s = 0;
        let i2 = 1;
        while i2 <= k {
            s = _ple_add(s, _ple_mul(i2, _ple_mul(ple_f[i2], ple_g[k - i2])));
            i2 += 1;
        }
        set_at(ple_g, k, _ple_mul(s, _ple_inv(k)));
        k += 1;
    }
    return 0;
}

// g = ln(ple_f) mod x^n, f[0] must be 1
// g[0] = 0; g[k] = f[k] - (1/k) * sum_{i=1}^{k-1} i * g[i] * f[k-i]
fn ple_ln(n) {
    let mut i = 0;
    while i < PLE_N { set_at(ple_g, i, 0); i += 1; }
    let mut k = 1;
    while k < n {
        let mut s = 0;
        let i2 = 1;
        while i2 <= k - 1 {
            s = _ple_add(s, _ple_mul(i2, _ple_mul(ple_g[i2], ple_f[k - i2])));
            i2 += 1;
        }
        set_at(ple_g, k, _ple_sub(ple_f[k], _ple_mul(s, _ple_inv(k))));
        k += 1;
    }
    return 0;
}

fn ple_test() {
    ple_init();
    // Compute exp(x) -> ple_g, then ln(exp(x)) -> ple_g; expect [0,1,0,0,0]
    set_at(ple_f, 1, 1);
    ple_exp(5);
    // Copy ple_g -> ple_t for reference, then ple_g -> ple_f for ln input
    let mut i = 0;
    while i < PLE_N { set_at(ple_t, i, ple_g[i]); set_at(ple_f, i, ple_g[i]); i += 1; }
    ple_ln(5);
    // ln(exp(x)) should equal x = [0, 1, 0, 0, 0]
    let ok = 1;
    if ple_g[0] != 0 { ok = 0; }
    if ple_g[1] != 1 { ok = 0; }
    if ple_g[2] != 0 { ok = 0; }
    if ple_g[3] != 0 { ok = 0; }
    if ple_g[4] != 0 { ok = 0; }
    print("ple_test: ln(exp(x))=[" + to_string(ple_g[0]) + "," + to_string(ple_g[1]) + "," + to_string(ple_g[2]) + "]");
    if ok == 1 { print("ple_test: PASS"); return 1; }
    print("ple_test: FAIL");
    return 0;
}

print("poly_ln_exp.hl loaded");
