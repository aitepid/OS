// geometry_2d.hl -- 2D Computational Geometry Primitives (iter 343)
// Buffer: 0x18E0000
// Integer coordinates; all arithmetic in int64.
// g2_cross/g2_dot: vector operations. g2_area2(): 2*signed_area (CCW>0, shoelace).
// g2_pip(qx,qy): point-in-polygon ray casting. g2_seg_inter: proper intersection test.

let G2_MAX = 64;
let g2_px  = array(64, 0);
let g2_py  = array(64, 0);
let g2_n   = 0;

fn g2_init() {
    let i = 0;
    while i < G2_MAX { set_at(g2_px, i, 0); set_at(g2_py, i, 0); i += 1; }
    g2_n = 0;
    return 0;
}

fn g2_add(x, y) {
    if g2_n < G2_MAX {
        set_at(g2_px, g2_n, x);
        set_at(g2_py, g2_n, y);
        g2_n += 1;
    }
    return g2_n;
}

fn g2_cross(ax, ay, bx, by) {
    return ax * by - ay * bx;
}

fn g2_dot(ax, ay, bx, by) {
    return ax * bx + ay * by;
}

fn g2_dist2(ax, ay, bx, by) {
    let dx = bx - ax;
    let dy = by - ay;
    return dx * dx + dy * dy;
}

fn _g2_sign(x) {
    if x > 0 { return 1; }
    if x < 0 { return 0 - 1; }
    return 0;
}

fn g2_area2() {
    let s = 0;
    let i = 0;
    while i < g2_n {
        let j = i + 1;
        if j >= g2_n { j = 0; }
        s = s + g2_px[i] * g2_py[j] - g2_px[j] * g2_py[i];
        i += 1;
    }
    return s;
}

fn g2_pip(qx, qy) {
    let inside = 0;
    let i = 0;
    while i < g2_n {
        let j = i + 1;
        if j >= g2_n { j = 0; }
        let x1 = g2_px[i]; let y1 = g2_py[i];
        let x2 = g2_px[j]; let y2 = g2_py[j];
        let cross_y = 0;
        if y1 <= qy { if y2 > qy { cross_y = 1; } }
        if y2 <= qy { if y1 > qy { cross_y = 1; } }
        if cross_y == 1 {
            let num = (qy - y1) * (x2 - x1);
            let den = y2 - y1;
            let lhs = num;
            let rhs = (qx - x1) * den;
            let hits = 0;
            if den > 0 { if lhs > rhs { hits = 1; } }
            if den < 0 { if lhs < rhs { hits = 1; } }
            if hits == 1 {
                if inside == 0 { inside = 1; } else { inside = 0; }
            }
        }
        i += 1;
    }
    return inside;
}

fn g2_seg_inter(ax, ay, bx, by, cx, cy, dx, dy) {
    let d1 = g2_cross(dx - cx, dy - cy, ax - cx, ay - cy);
    let d2 = g2_cross(dx - cx, dy - cy, bx - cx, by - cy);
    let d3 = g2_cross(bx - ax, by - ay, cx - ax, cy - ay);
    let d4 = g2_cross(bx - ax, by - ay, dx - ax, dy - ay);
    if _g2_sign(d1) != _g2_sign(d2) {
        if _g2_sign(d3) != _g2_sign(d4) {
            return 1;
        }
    }
    return 0;
}

fn g2_test() {
    g2_init();
    g2_add(0, 0); g2_add(10, 0); g2_add(5, 10);
    let a2 = g2_area2();   // triangle area=50, area2=100
    let p1 = g2_pip(5, 3); // 1: inside
    let p2 = g2_pip(11, 3); // 0: outside
    let si = g2_seg_inter(0, 5, 10, 5, 3, 0, 3, 10); // 1: proper crossing
    print("g2_test: area2=" + to_string(a2) +
          " pip(5,3)=" + to_string(p1) +
          " pip(11,3)=" + to_string(p2) +
          " seg_inter=" + to_string(si));
    if a2 == 100 {
        if p1 == 1 {
            if p2 == 0 {
                if si == 1 {
                    print("g2_test: PASS");
                    return 1;
                }
            }
        }
    }
    print("g2_test: FAIL");
    return 0;
}

print("geometry_2d.hl loaded");
