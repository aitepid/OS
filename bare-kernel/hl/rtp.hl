// rtp.hl -- Real-time Transport Protocol (RTP / RFC 3550)

let RTP_HEADER_SIZE = 12;
let RTP_VERSION     = 2;
let RTP_MAX_PACKET  = 1500;

// Payload types (RFC 3551)
let RTP_PT_PCMU = 0;
let RTP_PT_GSM  = 3;
let RTP_PT_G723 = 4;
let RTP_PT_PCMA = 8;
let RTP_PT_G722 = 9;
let RTP_PT_L16_2 = 10;
let RTP_PT_L16_1 = 11;
let RTP_PT_QCELP = 12;
let RTP_PT_MPA  = 14;
let RTP_PT_G728 = 15;
let RTP_PT_G729 = 18;
let RTP_PT_H261 = 31;
let RTP_PT_MPV  = 32;
let RTP_PT_H263 = 34;

// Session state
let mut rtp_ssrc         = 0;
let mut rtp_sequence     = 0;
let mut rtp_timestamp    = 0;
let mut rtp_payload_type = 0;
let mut rtp_initialized  = 0;

// Buffers
let rtp_pkt_buf    = array(1500, 0);
let rtp_parse_info = array(32, 0);
let rtp_payload_buf = array(1500, 0);

fn _rtp_generate_ssrc() {
    let mut t1 = get_uptime();
    let mut t2 = get_ticks();
    return (t1 * 31337 + t2 * 7919) % 4294967296;
}

fn _rtp_random_u16() {
    let mut t = get_ticks();
    return (t * 1103) % 65536;
}

fn _rtp_random_u32() {
    let mut t1 = get_uptime();
    let mut t2 = get_ticks();
    return (t1 * 48271 + t2 * 69621) % 4294967296;
}

fn _rtp_write_u32(buf, offset, value) {
    set_at(buf, offset + 0, (value / 16777216) % 256);
    set_at(buf, offset + 1, (value / 65536) % 256);
    set_at(buf, offset + 2, (value / 256) % 256);
    set_at(buf, offset + 3, value % 256);
}

fn _rtp_read_u32(buf, offset) {
    let mut b0 = buf[offset + 0];
    let mut b1 = buf[offset + 1];
    let mut b2 = buf[offset + 2];
    let mut b3 = buf[offset + 3];
    return b0 * 16777216 + b1 * 65536 + b2 * 256 + b3;
}

fn rtp_init() {
    rtp_ssrc         = _rtp_generate_ssrc();
    rtp_sequence     = _rtp_random_u16();
    rtp_timestamp    = _rtp_random_u32();
    rtp_payload_type = RTP_PT_PCMU;
    rtp_initialized  = 1;
    print("RTP ready");
}

fn rtp_create_packet(payload_data, payload_len, marker) {
    let mut pos = 0;
    // Byte 0: V=2, P=0, X=0, CC=0 => 10000000
    set_at(rtp_pkt_buf, pos, 128);
    pos = pos + 1;
    // Byte 1: M + PT
    let mut m_pt = rtp_payload_type;
    if marker == 1 { m_pt = m_pt + 128; }
    set_at(rtp_pkt_buf, pos, m_pt);
    pos = pos + 1;
    // Bytes 2-3: sequence (big-endian)
    set_at(rtp_pkt_buf, pos,     rtp_sequence / 256);
    set_at(rtp_pkt_buf, pos + 1, rtp_sequence % 256);
    pos = pos + 2;
    // Bytes 4-7: timestamp
    _rtp_write_u32(rtp_pkt_buf, pos, rtp_timestamp);
    pos = pos + 4;
    // Bytes 8-11: SSRC
    _rtp_write_u32(rtp_pkt_buf, pos, rtp_ssrc);
    pos = pos + 4;
    // Payload
    let mut i = 0;
    while i < payload_len {
        if pos < RTP_MAX_PACKET {
            set_at(rtp_pkt_buf, pos, payload_data[i]);
            pos = pos + 1;
        }
        i = i + 1;
    }
    rtp_sequence  = (rtp_sequence + 1) % 65536;
    rtp_timestamp = rtp_timestamp + 160;
    return pos;
}

fn rtp_parse_packet(data, data_len) {
    if data_len < RTP_HEADER_SIZE {
        print("RTP: packet too short");
        return 0;
    }
    let mut v_p_x_cc  = data[0];
    let mut version   = v_p_x_cc / 64;
    let mut padding   = (v_p_x_cc / 32) % 2;
    let mut extension = (v_p_x_cc / 16) % 2;
    let mut csrc_count = v_p_x_cc % 16;
    if version != RTP_VERSION {
        print("RTP: wrong version");
        return 0;
    }
    let mut m_pt        = data[1];
    let mut marker      = m_pt / 128;
    let mut payload_type = m_pt % 128;
    let mut sequence   = data[2] * 256 + data[3];
    let mut timestamp  = _rtp_read_u32(data, 4);
    let mut ssrc       = _rtp_read_u32(data, 8);
    set_at(rtp_parse_info, 0, version);
    set_at(rtp_parse_info, 1, padding);
    set_at(rtp_parse_info, 2, extension);
    set_at(rtp_parse_info, 3, csrc_count);
    set_at(rtp_parse_info, 4, marker);
    set_at(rtp_parse_info, 5, payload_type);
    set_at(rtp_parse_info, 6, sequence / 256);
    set_at(rtp_parse_info, 7, sequence % 256);
    _rtp_write_u32(rtp_parse_info, 8, timestamp);
    _rtp_write_u32(rtp_parse_info, 12, ssrc);
    let mut header_len = RTP_HEADER_SIZE + csrc_count * 4;
    if extension == 1 { header_len = header_len + 4; }
    set_at(rtp_parse_info, 16, header_len);
    return 1;
}

fn rtp_get_payload(data, data_len) {
    let mut header_len  = rtp_parse_info[16];
    if header_len >= data_len { return 0; }
    let mut payload_len = data_len - header_len;
    let mut i = 0;
    while i < payload_len {
        set_at(rtp_payload_buf, i, data[header_len + i]);
        i = i + 1;
    }
    return payload_len;
}

fn rtp_set_payload_type(pt) {
    if pt >= 0 {
        if pt < 128 {
            rtp_payload_type = pt;
            return 0;
        }
    }
    return 0 - 1;
}

fn rtp_get_sequence() { return rtp_sequence; }
fn rtp_get_timestamp() { return rtp_timestamp; }
fn rtp_get_ssrc() { return rtp_ssrc; }

fn rtp_set_ssrc(ssrc) {
    rtp_ssrc = ssrc;
}

fn rtp_advance_timestamp(samples) {
    rtp_timestamp = rtp_timestamp + samples;
}

fn rtp_get_payload_name(pt) {
    if pt == RTP_PT_PCMU { return "PCMU"; }
    if pt == RTP_PT_GSM  { return "GSM"; }
    if pt == RTP_PT_G723 { return "G723"; }
    if pt == RTP_PT_PCMA { return "PCMA"; }
    if pt == RTP_PT_G722 { return "G722"; }
    if pt == RTP_PT_L16_2 { return "L16-2ch"; }
    if pt == RTP_PT_L16_1 { return "L16-1ch"; }
    if pt == RTP_PT_QCELP { return "QCELP"; }
    if pt == RTP_PT_MPA  { return "MPA"; }
    if pt == RTP_PT_G728 { return "G728"; }
    if pt == RTP_PT_G729 { return "G729"; }
    if pt == RTP_PT_H261 { return "H261"; }
    if pt == RTP_PT_MPV  { return "MPV"; }
    if pt == RTP_PT_H263 { return "H263"; }
    return "Unknown";
}

fn rtp_format_info() {
    let mut pt     = rtp_parse_info[5];
    let mut seq    = rtp_parse_info[6] * 256 + rtp_parse_info[7];
    let mut ts     = _rtp_read_u32(rtp_parse_info, 8);
    let mut ssrc   = _rtp_read_u32(rtp_parse_info, 12);
    let mut marker = rtp_parse_info[4];
    print("RTP PT=" + to_string(pt) + " seq=" + to_string(seq) +
          " ts=" + to_string(ts) + " ssrc=" + to_string(ssrc) +
          " M=" + to_string(marker));
    return 0;
}

fn rtp_test() {
    rtp_ssrc      = 12345678;
    rtp_sequence  = 100;
    rtp_timestamp = 1000;
    rtp_payload_type = RTP_PT_PCMU;
    let payload = array(4, 0);
    set_at(payload, 0, 10); set_at(payload, 1, 20);
    set_at(payload, 2, 30); set_at(payload, 3, 40);
    let mut pkt_len = rtp_create_packet(payload, 4, 0);
    if pkt_len != RTP_HEADER_SIZE + 4 {
        print("rtp_test: FAIL create");
        return 0;
    }
    let mut ok = rtp_parse_packet(rtp_pkt_buf, pkt_len);
    if ok != 1 {
        print("rtp_test: FAIL parse");
        return 0;
    }
    if rtp_parse_info[5] != RTP_PT_PCMU {
        print("rtp_test: FAIL pt");
        return 0;
    }
    print("rtp_test: PASS");
    return 1;
}

print("rtp.hl loaded");
