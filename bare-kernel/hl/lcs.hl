// lcs.hl -- Dynamic Programming: LCS + Edit Distance + LIS
// LCS: longest common subsequence O(nm) / Levenshtein edit distance O(nm) /
// LIS: longest increasing subsequence O(n²).
// LCS_MAX=32 characters per string; LIS_MAX=128.
//
// Runtime buffer: 0x1530000 (4 KB)

let LCS_MAX = 32;
let LIS_MAX = 128;

// Shared DP table for LCS and edit distance: dp[i*(blen+1)+j]
// Sized for (LCS_MAX+1)^2 = 33*33 = 1089
let lcs_dp  = array(1089, 0);
let lis_dp  = array(128, 0);

fn lcs_init() {
    let mut i = 0;
    while i < 1089 {
        set_at(lcs_dp, i, 0);
        i += 1;
    }
    i = 0;
    while i < LIS_MAX {
        set_at(lis_dp, i, 0);
        i += 1;
    }
    return 0;
}

// Longest Common Subsequence length of a[0..alen-1] and b[0..blen-1]
fn lcs_compute(a, alen, b, blen) {
    let mut row = blen + 1;
    // Initialize first row and column to 0
    let mut i = 0;
    while i <= alen {
        set_at(lcs_dp, i * row, 0);
        i += 1;
    }
    let mut j = 0;
    while j <= blen {
        set_at(lcs_dp, j, 0);
        j += 1;
    }
    // Fill DP table
    i = 1;
    while i <= alen {
        j = 1;
        while j <= blen {
            let mut idx = i * row + j;
            if a[i - 1] == b[j - 1] {
                set_at(lcs_dp, idx, lcs_dp[(i - 1) * row + (j - 1)] + 1);
            } else {
                let up   = lcs_dp[(i - 1) * row + j];
                let left = lcs_dp[i * row + (j - 1)];
                if up > left {
                    set_at(lcs_dp, idx, up);
                } else {
                    set_at(lcs_dp, idx, left);
                }
            }
            j += 1;
        }
        i += 1;
    }
    return lcs_dp[alen * row + blen];
}

// Levenshtein edit distance between a[0..alen-1] and b[0..blen-1]
fn lcs_edit_dist(a, alen, b, blen) {
    let mut row = blen + 1;
    // Initialize: dp[i][0]=i (delete i chars), dp[0][j]=j (insert j chars)
    let mut i = 0;
    while i <= alen {
        set_at(lcs_dp, i * row, i);
        i += 1;
    }
    let mut j = 0;
    while j <= blen {
        set_at(lcs_dp, j, j);
        j += 1;
    }
    // Fill DP table
    i = 1;
    while i <= alen {
        j = 1;
        while j <= blen {
            let mut idx = i * row + j;
            if a[i - 1] == b[j - 1] {
                set_at(lcs_dp, idx, lcs_dp[(i - 1) * row + (j - 1)]);
            } else {
                let sub = lcs_dp[(i - 1) * row + (j - 1)] + 1;
                let del = lcs_dp[(i - 1) * row + j] + 1;
                let ins = lcs_dp[i * row + (j - 1)] + 1;
                let mn  = sub;
                if del < mn { mn = del; }
                if ins < mn { mn = ins; }
                set_at(lcs_dp, idx, mn);
            }
            j += 1;
        }
        i += 1;
    }
    return lcs_dp[alen * row + blen];
}

// Longest Increasing Subsequence length (strictly increasing), O(n²)
fn lis_compute(arr, n) {
    let mut i = 0;
    while i < n {
        set_at(lis_dp, i, 1);
        i += 1;
    }
    let best = 1;
    i = 1;
    while i < n {
        let mut j = 0;
        while j < i {
            if arr[j] < arr[i] {
                if lis_dp[j] + 1 > lis_dp[i] {
                    set_at(lis_dp, i, lis_dp[j] + 1);
                }
            }
            j += 1;
        }
        if lis_dp[i] > best { best = lis_dp[i]; }
        i += 1;
    }
    return best;
}

fn lcs_test() {
    lcs_init();
    // LCS("ABCBDAB", "BDCAB") = 4
    // A=65, B=66, C=67, D=68
    let sa = array(7, 0);
    set_at(sa, 0, 65); set_at(sa, 1, 66); set_at(sa, 2, 67); set_at(sa, 3, 66);
    set_at(sa, 4, 68); set_at(sa, 5, 65); set_at(sa, 6, 66);
    let sb = array(5, 0);
    set_at(sb, 0, 66); set_at(sb, 1, 68); set_at(sb, 2, 67);
    set_at(sb, 3, 65); set_at(sb, 4, 66);
    let llen = lcs_compute(sa, 7, sb, 5);   // expected 4

    // Edit distance "kitten" -> "sitting" = 3
    // k=107 i=105 t=116 t=116 e=101 n=110 / s=115 i=105 t=116 t=116 i=105 n=110 g=103
    let sk = array(6, 0);
    set_at(sk, 0, 107); set_at(sk, 1, 105); set_at(sk, 2, 116);
    set_at(sk, 3, 116); set_at(sk, 4, 101); set_at(sk, 5, 110);
    let ss = array(7, 0);
    set_at(ss, 0, 115); set_at(ss, 1, 105); set_at(ss, 2, 116);
    set_at(ss, 3, 116); set_at(ss, 4, 105); set_at(ss, 5, 110); set_at(ss, 6, 103);
    let edist = lcs_edit_dist(sk, 6, ss, 7);   // expected 3

    // LIS([10,9,2,5,3,7,101,18]) = 4
    let arr = array(8, 0);
    set_at(arr, 0, 10); set_at(arr, 1, 9); set_at(arr, 2, 2);  set_at(arr, 3, 5);
    set_at(arr, 4, 3);  set_at(arr, 5, 7); set_at(arr, 6, 101); set_at(arr, 7, 18);
    let lislen = lis_compute(arr, 8);   // expected 4

    print("lcs_test lcs=" + to_string(llen) + " edit=" + to_string(edist) + " lis=" + to_string(lislen));
    return llen;
}

print("lcs.hl loaded");
