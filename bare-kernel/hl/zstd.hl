// zstd.hl -- Zstandard Compression (simplified)

let ZSTD_WINDOW_SIZE = 8192;
let ZSTD_MAX_BLOCK   = 8192;

// Block types
let ZSTD_BLOCK_RAW        = 0;
let ZSTD_BLOCK_RLE        = 1;
let ZSTD_BLOCK_COMPRESSED = 2;

// Buffers
let zstd_output_buf  = array(8192, 0);
let zstd_lz77_buf    = array(8192, 0);
let zstd_match_res   = array(4, 0);

let mut zstd_output_len       = 0;
let mut zstd_compression_level = 3;

fn zstd_init() {
    zstd_output_len        = 0;
    zstd_compression_level = 3;
    print("Zstandard compression ready");
    return 0;
}

fn _zstd_find_match(data, base_offset, pos, data_len) {
    set_at(zstd_match_res, 0, 0);
    set_at(zstd_match_res, 1, 0);
    if pos < 3 { return 0; }
    let mut window_start = 0;
    if pos > ZSTD_WINDOW_SIZE { window_start = pos - ZSTD_WINDOW_SIZE; }
    let mut best_len    = 0;
    let mut best_offset = 0;
    let mut search_pos  = window_start;
    while search_pos < pos {
        let mut match_len = 0;
        let mut go2 = 1;
        while go2 == 1 {
            if pos + match_len >= data_len  { go2 = 0; }
            if go2 == 1 {
                if search_pos + match_len >= pos { go2 = 0; }
            }
            if go2 == 1 {
                if data[base_offset + pos + match_len] == data[base_offset + search_pos + match_len] {
                    match_len = match_len + 1;
                    if match_len >= 64 { go2 = 0; }
                } else {
                    go2 = 0;
                }
            }
        }
        if match_len > best_len {
            best_len    = match_len;
            best_offset = pos - search_pos;
        }
        search_pos = search_pos + 1;
    }
    set_at(zstd_match_res, 0, best_len);
    set_at(zstd_match_res, 1, best_offset);
    return 0;
}

fn _zstd_lz77_compress(data, offset, data_len) {
    let mut out_pos = 0;
    let mut pos = 0;
    while pos < data_len {
        _zstd_find_match(data, offset, pos, data_len);
        let mut match_len    = zstd_match_res[0];
        let mut match_offset = zstd_match_res[1];
        if match_len >= 3 {
            set_at(zstd_lz77_buf, out_pos, (match_len - 3) + 128);
            out_pos = out_pos + 1;
            set_at(zstd_lz77_buf, out_pos, match_offset % 256);
            out_pos = out_pos + 1;
            set_at(zstd_lz77_buf, out_pos, match_offset / 256);
            out_pos = out_pos + 1;
            pos = pos + match_len;
        } else {
            set_at(zstd_lz77_buf, out_pos, data[offset + pos]);
            out_pos = out_pos + 1;
            pos = pos + 1;
        }
    }
    return out_pos;
}

fn _zstd_compress_block(out_pos, data, data_offset, block_size, is_last) {
    // Check for RLE (all bytes same)
    let mut first_byte = data[data_offset];
    let mut is_rle = 1;
    let mut i = 1;
    let mut go = 1;
    while go == 1 {
        if i >= block_size { go = 0; }
        if go == 1 {
            if data[data_offset + i] != first_byte {
                is_rle = 0;
                go = 0;
            }
            if go == 1 { i = i + 1; }
        }
    }
    if is_rle == 1 {
        if block_size > 4 {
            let mut bh = ZSTD_BLOCK_RLE * 2097152 + block_size;
            if is_last == 1 { bh = bh + 16777216; }
            set_at(zstd_output_buf, out_pos,     bh % 256);
            set_at(zstd_output_buf, out_pos + 1, (bh / 256) % 256);
            set_at(zstd_output_buf, out_pos + 2, (bh / 65536) % 256);
            out_pos = out_pos + 3;
            set_at(zstd_output_buf, out_pos, first_byte);
            out_pos = out_pos + 1;
            return out_pos;
        }
    }
    // Try LZ77
    let mut comp_len = _zstd_lz77_compress(data, data_offset, block_size);
    if comp_len < block_size - 3 {
        let mut bh = ZSTD_BLOCK_COMPRESSED * 2097152 + comp_len;
        if is_last == 1 { bh = bh + 16777216; }
        set_at(zstd_output_buf, out_pos,     bh % 256);
        set_at(zstd_output_buf, out_pos + 1, (bh / 256) % 256);
        set_at(zstd_output_buf, out_pos + 2, (bh / 65536) % 256);
        out_pos = out_pos + 3;
        i = 0;
        while i < comp_len {
            set_at(zstd_output_buf, out_pos, zstd_lz77_buf[i]);
            out_pos = out_pos + 1;
            i = i + 1;
        }
    } else {
        // Raw block
        let mut bh = ZSTD_BLOCK_RAW * 2097152 + block_size;
        if is_last == 1 { bh = bh + 16777216; }
        set_at(zstd_output_buf, out_pos,     bh % 256);
        set_at(zstd_output_buf, out_pos + 1, (bh / 256) % 256);
        set_at(zstd_output_buf, out_pos + 2, (bh / 65536) % 256);
        out_pos = out_pos + 3;
        i = 0;
        while i < block_size {
            set_at(zstd_output_buf, out_pos, data[data_offset + i]);
            out_pos = out_pos + 1;
            i = i + 1;
        }
    }
    return out_pos;
}

fn zstd_compress(data, data_len) {
    let mut pos = 0;
    // Frame magic (little-endian)
    set_at(zstd_output_buf, pos, 40);   pos = pos + 1;
    set_at(zstd_output_buf, pos, 181);  pos = pos + 1;
    set_at(zstd_output_buf, pos, 47);   pos = pos + 1;
    set_at(zstd_output_buf, pos, 253);  pos = pos + 1;
    // Frame descriptor
    set_at(zstd_output_buf, pos, 0);    pos = pos + 1;
    // Compress blocks
    let mut data_pos = 0;
    while data_pos < data_len {
        let mut block_size = data_len - data_pos;
        if block_size > ZSTD_MAX_BLOCK { block_size = ZSTD_MAX_BLOCK; }
        let mut is_last = 0;
        if data_pos + block_size >= data_len { is_last = 1; }
        pos      = _zstd_compress_block(pos, data, data_pos, block_size, is_last);
        data_pos = data_pos + block_size;
    }
    zstd_output_len = pos;
    return pos;
}

fn zstd_decompress(data, data_len) {
    if data_len < 5 { return 0 - 1; }
    if data[0] != 40  { return 0 - 2; }
    if data[1] != 181 { return 0 - 2; }
    if data[2] != 47  { return 0 - 2; }
    if data[3] != 253 { return 0 - 2; }
    let mut pos     = 5;
    let mut out_pos = 0;
    let mut go = 1;
    while go == 1 {
        if pos >= data_len { go = 0; }
        if go == 1 {
            let mut bh        = data[pos] + data[pos + 1] * 256 + data[pos + 2] * 65536;
            pos = pos + 3;
            let mut is_last   = (bh / 16777216) % 2;
            let mut block_type = (bh / 2097152) % 2;
            let mut block_size = bh % 2097152;
            if block_type == ZSTD_BLOCK_RAW {
                let mut i = 0;
                while i < block_size {
                    set_at(zstd_output_buf, out_pos, data[pos]);
                    out_pos = out_pos + 1;
                    pos     = pos + 1;
                    i = i + 1;
                }
            } else {
                if block_type == ZSTD_BLOCK_RLE {
                    let mut rle_byte = data[pos];
                    pos = pos + 1;
                    let mut i = 0;
                    while i < block_size {
                        set_at(zstd_output_buf, out_pos, rle_byte);
                        out_pos = out_pos + 1;
                        i = i + 1;
                    }
                }
            }
            if is_last == 1 { go = 0; }
        }
    }
    zstd_output_len = out_pos;
    return out_pos;
}

fn zstd_set_level(level) {
    if level >= 1 {
        if level <= 9 {
            zstd_compression_level = level;
            return 0;
        }
    }
    return 0 - 1;
}

fn zstd_get_output_len() { return zstd_output_len; }

fn zstd_get_ratio(original_len) {
    if original_len == 0 { return 0; }
    return (zstd_output_len * 100) / original_len;
}

fn zstd_test() {
    zstd_init();
    let td = array(20, 0);
    set_at(td, 0, 97);  set_at(td, 1, 97);  set_at(td, 2, 97);  set_at(td, 3, 97);
    set_at(td, 4, 32);  set_at(td, 5, 98);  set_at(td, 6, 98);  set_at(td, 7, 98);
    set_at(td, 8, 32);  set_at(td, 9, 99);  set_at(td, 10, 99); set_at(td, 11, 99);
    set_at(td, 12, 32); set_at(td, 13, 100); set_at(td, 14, 100); set_at(td, 15, 100);
    set_at(td, 16, 32); set_at(td, 17, 101); set_at(td, 18, 101); set_at(td, 19, 101);
    let mut comp_len = zstd_compress(td, 20);
    if comp_len <= 0 {
        print("zstd_test: FAIL compress");
        return 0;
    }
    let mut decomp_len = zstd_decompress(zstd_output_buf, comp_len);
    if decomp_len != 20 {
        print("zstd_test: FAIL decomp len=" + to_string(decomp_len));
        return 0;
    }
    print("zstd_test: PASS comp=" + to_string(comp_len) + " decomp=" + to_string(decomp_len));
    return 1;
}

print("zstd.hl loaded");
