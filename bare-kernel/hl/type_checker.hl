// type_checker.hl -- Type checker with error diagnostics (iter 368)
// Buffer: 0x1A70000
// TC_MAXNODES=32 statements, TC_MAXVARS=32 typed variables
// Checks: assignment compatibility, binary op operand types, return type match
// Type tags: 0=Int, 1=Bool, 2=Str, 3=Float, 4=Unknown, 5=Error
// Statements: 0=assign(var,expr), 1=binop(op,lhs,rhs,dst), 2=ret(expr), 3=if(cond,body)
// Errors: TC_MAXERRS=8; each error has node, expected, actual type

let mut TC_MAXNODES = 32;
let mut TC_MAXVARS  = 32;
let mut TC_MAXERRS  = 8;

let TC_INT     = 0;
let TC_BOOL    = 1;
let TC_STR     = 2;
let TC_FLOAT   = 3;
let TC_UNKNOWN = 4;
let TC_ERROR   = 5;

// Variable type environment
let tc_var_name = array(32, 0);
let tc_var_type = array(32, 0);
let mut tc_var_n    = 0;

// Statements
let tc_st_kind  = array(32, 0);  // 0=assign,1=binop,2=ret,3=if
let tc_st_op    = array(32, 0);  // for binop: 0=add,1=sub,2=mul,3=lt,4=eq,5=and,6=or
let tc_st_a     = array(32, 0);  // field a (var name or lhs var)
let tc_st_b     = array(32, 0);  // field b (expr type or rhs var)
let tc_st_c     = array(32, 0);  // field c (dst var for binop)
let mut tc_st_n     = 0;

// Errors
let tc_err_node = array(8, 0);
let tc_err_exp  = array(8, 0);
let tc_err_got  = array(8, 0);
let mut tc_err_n    = 0;

// Expected return type for current function
let mut tc_ret_type = TC_INT;

fn tc_init() {
    tc_var_n = 0;
    tc_st_n  = 0;
    tc_err_n = 0;
    tc_ret_type = TC_INT;
    return 0;
}

fn tc_set_ret_type(t) { tc_ret_type = t; return 0; }

fn tc_declare(name, typ) {
    let mut id = tc_var_n;
    set_at(tc_var_name, id, name);
    set_at(tc_var_type, id, typ);
    tc_var_n += 1;
    return id;
}

fn _tc_lookup(name) {
    let mut i = 0;
    while i < tc_var_n {
        if tc_var_name[i] == name { return tc_var_type[i]; }
        i += 1;
    }
    return TC_UNKNOWN;
}

fn _tc_set_type(name, typ) {
    let mut i = 0;
    while i < tc_var_n {
        if tc_var_name[i] == name { set_at(tc_var_type, i, typ); return 0; }
        i += 1;
    }
    // New var
    tc_declare(name, typ);
    return 0;
}

fn _tc_error(node, expected, got) {
    if tc_err_n < TC_MAXERRS {
        set_at(tc_err_node, tc_err_n, node);
        set_at(tc_err_exp,  tc_err_n, expected);
        set_at(tc_err_got,  tc_err_n, got);
        tc_err_n += 1;
    }
    return TC_ERROR;
}

fn tc_add_assign(var_name, expr_type) {
    let mut id = tc_st_n;
    set_at(tc_st_kind, id, 0);
    set_at(tc_st_a,    id, var_name);
    set_at(tc_st_b,    id, expr_type);
    tc_st_n += 1;
    return id;
}

fn tc_add_binop(op, lhs_var, rhs_var, dst_var) {
    let mut id = tc_st_n;
    set_at(tc_st_kind, id, 1);
    set_at(tc_st_op,   id, op);
    set_at(tc_st_a,    id, lhs_var);
    set_at(tc_st_b,    id, rhs_var);
    set_at(tc_st_c,    id, dst_var);
    tc_st_n += 1;
    return id;
}

fn tc_add_ret(var_name) {
    let mut id = tc_st_n;
    set_at(tc_st_kind, id, 2);
    set_at(tc_st_a,    id, var_name);
    tc_st_n += 1;
    return id;
}

fn tc_add_if(cond_var, body_stmt) {
    let mut id = tc_st_n;
    set_at(tc_st_kind, id, 3);
    set_at(tc_st_a,    id, cond_var);
    set_at(tc_st_b,    id, body_stmt);
    tc_st_n += 1;
    return id;
}

fn _tc_check_stmt(i) {
    let mut k = tc_st_kind[i];
    let mut op = tc_st_op[i];
    let mut a = tc_st_a[i];
    let mut b = tc_st_b[i];
    let mut c = tc_st_c[i];

    if k == 0 {
        // assign: check if var already declared with different type
        let mut existing = _tc_lookup(a);
        if existing == TC_UNKNOWN {
            _tc_set_type(a, b);
        } else {
            if existing != b {
                if existing != TC_ERROR {
                    _tc_error(i, existing, b);
                }
            }
        }
        return 0;
    }

    if k == 1 {
        // binop: arithmetic ops (0-2) require Int; comparison (3-4) require Int, produce Bool
        //         logical ops (5-6) require Bool
        let mut tl = _tc_lookup(a);
        let mut tr = _tc_lookup(b);
        let mut res_type = TC_ERROR;

        if op <= 2 {
            // arithmetic: both must be Int -> Int
            if tl != TC_INT { _tc_error(i, TC_INT, tl); }
            else {
                if tr != TC_INT { _tc_error(i, TC_INT, tr); }
                else { res_type = TC_INT; }
            }
        }
        if op == 3 {
            // lt: both Int -> Bool
            if tl != TC_INT { _tc_error(i, TC_INT, tl); }
            else {
                if tr != TC_INT { _tc_error(i, TC_INT, tr); }
                else { res_type = TC_BOOL; }
            }
        }
        if op == 4 {
            // eq: same type -> Bool
            if tl != tr { _tc_error(i, tl, tr); }
            else { res_type = TC_BOOL; }
        }
        if op >= 5 {
            // and/or: both Bool -> Bool
            if tl != TC_BOOL { _tc_error(i, TC_BOOL, tl); }
            else {
                if tr != TC_BOOL { _tc_error(i, TC_BOOL, tr); }
                else { res_type = TC_BOOL; }
            }
        }
        _tc_set_type(c, res_type);
        return 0;
    }

    if k == 2 {
        // ret: must match declared return type
        let mut rt = _tc_lookup(a);
        if rt != tc_ret_type {
            if rt != TC_UNKNOWN {
                _tc_error(i, tc_ret_type, rt);
            }
        }
        return 0;
    }

    if k == 3 {
        // if: condition must be Bool
        let mut ct = _tc_lookup(a);
        if ct != TC_BOOL {
            _tc_error(i, TC_BOOL, ct);
        }
        return 0;
    }
    return 0;
}

fn tc_run() {
    tc_err_n = 0;
    let mut i = 0;
    while i < tc_st_n {
        _tc_check_stmt(i);
        i += 1;
    }
    return tc_err_n;
}

fn tc_test() {
    // x:Int=5; y:Bool=true; z=x+x (ok); ret z (error: Int vs Bool if ret_type=Bool)
    // Then: w = y && z  (error: z is Int, not Bool)
    tc_init();
    tc_declare(10, TC_INT);   // x=10(name) : Int
    tc_declare(11, TC_BOOL);  // y=11(name) : Bool
    tc_set_ret_type(TC_BOOL);
    tc_add_binop(0, 10, 10, 12);   // z = x+x  -> Int
    tc_add_binop(5, 11, 12, 13);   // w = y&&z  -> error(z is Int, not Bool)
    tc_add_ret(12);                 // ret z(Int) -> error(expected Bool)
    let mut errs = tc_run();
    print("tc_test: errors=" + to_string(errs));
    if errs == 2 {
        print("tc_test: PASS");
        return 1;
    }
    print("tc_test: FAIL");
    return 0;
}

fn tc_error_count() { return tc_err_n; }
fn tc_get_err_node(i) { return tc_err_node[i]; }
fn tc_get_err_exp(i)  { return tc_err_exp[i]; }
fn tc_get_err_got(i)  { return tc_err_got[i]; }

print("type_checker.hl loaded");
