// posix.hl -- POSIX Process Model: fork / exec / wait / pipe / dup2
//
// Provides UNIX-compatible process creation and I/O redirection.
// Integrates with task.hl (task table), vfs.hl (file descriptors),
// elf.hl (program loading), and signal.hl (SIGCHLD).
//
// fork():  Clone current task. Child gets PID = new task_id, returns 0.
//          Parent returns child PID.
// exec():  Replace current task's address space with new ELF binary.
// wait():  Parent blocks until child exits, collects exit status.
// pipe():  Create unidirectional byte stream between two FDs.
// dup2():  Duplicate a file descriptor (for I/O redirection).
//
// File descriptor table: each task has 16 FD slots.
//   FD 0 = stdin, FD 1 = stdout, FD 2 = stderr

let MAX_FDS = 16;
let FD_TABLE_ADDR = 9175040;  // 0x8C0000 -- 64 tasks * 16 FDs * 16 bytes

// FD entry (16 bytes):
//   +0: type (8) -- 0=closed, 1=serial, 2=pipe_read, 3=pipe_write, 4=file, 5=devfs
//   +8: data (8) -- inode/pipe_id/device_id depending on type

let FD_CLOSED     = 0;
let FD_SERIAL     = 1;
let FD_PIPE_READ  = 2;
let FD_PIPE_WRITE = 3;
let FD_FILE       = 4;
let FD_DEVFS      = 5;

fn fd_addr(task_id, fd) {
    return FD_TABLE_ADDR + (task_id * MAX_FDS + fd) * 16;
}

fn fd_init_task(task_id) {
    // Close all FDs
    let mut i = 0;
    while i < MAX_FDS {
        let addr = fd_addr(task_id, i);
        mem_write_u64(addr, FD_CLOSED);
        mem_write_u64(addr + 8, 0);
        i = i + 1;
    }
    // Setup stdin/stdout/stderr -> serial
    mem_write_u64(fd_addr(task_id, 0), FD_SERIAL);  // stdin
    mem_write_u64(fd_addr(task_id, 1), FD_SERIAL);  // stdout
    mem_write_u64(fd_addr(task_id, 2), FD_SERIAL);  // stderr
    return 0;
}

// === fork() ===
fn sys_fork() {
    // 1. Allocate new task — reuse task_create with parent's RIP/RSP
    let parent_addr = task_addr(current_task);
    let parent_rip = mem_read_u64(parent_addr + 24);
    let child_stack = page_alloc() + 4096;  // top of new 4K stack page
    let child_pid = task_create(parent_rip, child_stack);
    if child_pid == 0 { return 0 - 1; }  // no free slot

    // 2. Find child's task index and copy parent registers
    let mut child_idx = 0;
    let mut ci = 0;
    while ci < 64 {
        if mem_read_u64(task_addr(ci) + 8) == child_pid {
            child_idx = ci;
            ci = 64;
        }
        ci = ci + 1;
    }
    let child_addr = task_addr(child_idx);

    // Copy GPRs from parent (offsets 32..152)
    let mut off = 32;
    while off <= 152 {
        mem_write_u64(child_addr + off, mem_read_u64(parent_addr + off));
        off = off + 8;
    }

    // 3. Copy FD table from parent to child
    let mut i = 0;
    while i < MAX_FDS {
        let src = fd_addr(current_task, i);
        let dst = fd_addr(child_idx, i);
        mem_write_u64(dst, mem_read_u64(src));
        mem_write_u64(dst + 8, mem_read_u64(src + 8));
        i = i + 1;
    }

    // 4. Copy page table root (share address space for now; COW later)
    mem_write_u64(child_addr + 160, mem_read_u64(parent_addr + 160));

    // 5. Child's RAX = 0 (fork returns 0 in child)
    mem_write_u64(child_addr + 32, 0);

    // 6. Parent gets child PID
    return child_pid;
}

// === exec(path) ===
fn sys_exec(path) {
    // 1. Open and read ELF binary from VFS
    let fd = vfs_open(path, O_RDONLY);
    if fd < 0 { return 0 - 1; }
    // Read file into buffer (allocate pages for data)
    let stat = vfs_stat(path);
    let file_size = stat[0];
    if file_size == 0 { vfs_close(fd); return 0 - 1; }

    let buf_addr = page_alloc();
    if buf_addr == 0 { vfs_close(fd); return 0 - 1; }
    let bytes_read = vfs_read(fd, buf_addr, file_size);
    vfs_close(fd);

    // Convert memory buffer to array for elf functions
    let mut elf_data = [];
    let mut ri = 0;
    while ri < bytes_read {
        push(elf_data, mem_read_u8(buf_addr + ri));
        ri = ri + 1;
    }
    page_free(buf_addr);

    // 2. Parse ELF header (entry point at offset 24 for ELF64)
    let entry_point = elf_entry(elf_data);
    if entry_point == 0 { return 0 - 1; }

    // 3. Load PT_LOAD segments into task's address space
    elf_load_segments(elf_data, current_task);

    // 4. Set RIP to ELF entry point
    let addr = task_addr(current_task);
    mem_write_u64(addr + 24, entry_point);

    // 5. Set RSP to user stack top (allocate one page)
    let user_stack = page_alloc() + 4096;
    mem_write_u64(addr + 16, user_stack);

    // 6. Reset FDs 3+ (keep stdin/stdout/stderr)
    let mut i = 3;
    while i < MAX_FDS {
        mem_write_u64(fd_addr(current_task, i), FD_CLOSED);
        mem_write_u64(fd_addr(current_task, i) + 8, 0);
        i = i + 1;
    }

    // Does not return in real kernel (context switches to new code)
    return 0;
}

// === wait(child_pid) ===
// Blocks parent until child exits. Returns child exit code.
fn sys_wait(child_pid) {
    // Find child task index by PID
    let mut child_idx = 0 - 1;
    let mut ci = 0;
    while ci < MAX_TASKS {
        if mem_read_u64(task_addr(ci) + 8) == child_pid {
            child_idx = ci;
            ci = MAX_TASKS;
        }
        ci = ci + 1;
    }
    if child_idx < 0 { return 0 - 1; } // no such child

    // Block until child is DEAD (state == 4)
    let mut child_state = mem_read_u64(task_addr(child_idx));
    while child_state != STATE_DEAD {
        // Block parent, will be woken by SIGCHLD from child exit
        task_block(2);  // reason=2 (wait)
        child_state = mem_read_u64(task_addr(child_idx));
    }

    // Collect exit code (stored at +232 by task_exit)
    let exit_code = mem_read_u64(task_addr(child_idx) + 232);

    // Reclaim child's task slot
    mem_write_u64(task_addr(child_idx), STATE_FREE);
    return exit_code;
}

// === exit(code) ===
fn sys_exit(code) {
    // Close all FDs
    let mut i = 0;
    while i < MAX_FDS {
        let addr = fd_addr(current_task, i);
        mem_write_u64(addr, FD_CLOSED);
        i = i + 1;
    }
    // Terminate the task
    task_exit(code);
    return 0; // never reached
}

// === pipe(fds) ===
// Creates a pipe: fds[0] = read end, fds[1] = write end
let PIPE_BUF_SIZE = 4096;
let MAX_PIPES = 32;
let PIPE_DATA_ADDR = 9240576;  // 0x8D0000 -- 32 pipes * 4096 bytes

let mut pipe_count = 0;

fn sys_pipe() {
    if pipe_count >= MAX_PIPES { return [0 - 1, 0 - 1]; }
    let pipe_id = pipe_count;
    pipe_count = pipe_count + 1;

    // Find two free FDs in current task
    let read_fd = fd_alloc(current_task);
    let write_fd = fd_alloc(current_task);
    if read_fd < 0 { return [0 - 1, 0 - 1]; }
    if write_fd < 0 { return [0 - 1, 0 - 1]; }

    // Setup FD entries
    mem_write_u64(fd_addr(current_task, read_fd), FD_PIPE_READ);
    mem_write_u64(fd_addr(current_task, read_fd) + 8, pipe_id);
    mem_write_u64(fd_addr(current_task, write_fd), FD_PIPE_WRITE);
    mem_write_u64(fd_addr(current_task, write_fd) + 8, pipe_id);

    return [read_fd, write_fd];
}

// === dup2(old_fd, new_fd) ===
fn sys_dup2(old_fd, new_fd) {
    if old_fd < 0 { return 0 - 1; } if old_fd >= MAX_FDS { return 0 - 1; }
    if new_fd < 0 { return 0 - 1; } if new_fd >= MAX_FDS { return 0 - 1; }
    // Close new_fd if open, then copy FD entry from old to new
    let src = fd_addr(current_task, old_fd);
    let dst = fd_addr(current_task, new_fd);
    mem_write_u64(dst, mem_read_u64(src));
    mem_write_u64(dst + 8, mem_read_u64(src + 8));
    return new_fd;
}

fn fd_alloc(task_id) {
    let mut i = 0;
    while i < MAX_FDS {
        let addr = fd_addr(task_id, i);
        if mem_read_u64(addr) == FD_CLOSED { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

print("posix.hl loaded");
print("fork/exec/exit/wait/pipe/dup2 + 16 FDs per task");
