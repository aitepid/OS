// toml.hl -- TOML v1 Configuration File Parser/Writer
//
// Iteration 188: Tom's Obvious Minimal Language config format.
//
// Supported syntax:
//   # comment lines (full-line only)
//   [section]             — table header
//   key = "string"        — quoted string value
//   key = 'string'        — literal string (same handling)
//   key = 42              — integer
//   key = 3.14            — float (stored as string)
//   key = true / false    — boolean
//   key = [1, 2, 3]       — inline array (stored as raw string)
//
// Storage: TOML_MAX (64) entries in parallel flat arrays.
//   Each entry: section + key + value_string + type_tag
//   Type tags: "s"=string, "i"=integer, "f"=float, "b"=boolean, "a"=array
//
// Public API:
//   toml_init()
//   toml_load(path)                    → entry count / -1 on error
//   toml_save(path)                    → 0 ok / -1 error
//   toml_get(section, key)             → value string or ""
//   toml_get_int(section, key)         → integer or 0
//   toml_get_bool(section, key)        → 1/0
//   toml_set(section, key, val)        → entry index
//   toml_delete(section, key)          → 0 ok
//   toml_list()                        → formatted dump string
//   toml_clear()
//   toml_count()
//
// Shell:
//   toml load <path>
//   toml list
//   toml get <section> <key>
//   toml set <section> <key> <val>
//   toml save <path>
//   toml del <section> <key>
//   toml clear

let TOML_MAX     = 64;
let TOML_BUF     = 15859712;   // 0xF20000  64 KB file load scratch
let TOML_BUF_SZ  = 65536;

let mut toml_secs  = [];   // section name per entry
let mut toml_keys  = [];   // key name per entry
let mut toml_vals  = [];   // value string per entry
let mut toml_types = [];   // type tag: s/i/f/b/a
let mut toml_count_n = 0;

fn toml_init() {
    toml_secs    = [];
    toml_keys    = [];
    toml_vals    = [];
    toml_types   = [];
    toml_count_n = 0;
    let mut i = 0;
    while i < TOML_MAX {
        push(toml_secs,  "");
        push(toml_keys,  "");
        push(toml_vals,  "");
        push(toml_types, "s");
        i = i + 1;
    }
    print("toml: init — max " + to_string(TOML_MAX) + " entries, sections + typed values");
    return 0;
}

fn toml_count() { return toml_count_n; }

fn toml_clear() {
    toml_count_n = 0;
    let mut i = 0;
    while i < TOML_MAX {
        set_at(toml_secs,  i, "");
        set_at(toml_keys,  i, "");
        set_at(toml_vals,  i, "");
        set_at(toml_types, i, "s");
        i = i + 1;
    }
    return 0;
}

// ============================================================
// Parse helpers
// ============================================================

fn _toml_trim(s) {
    let mut start = 0;
    let mut end = len(s);
    while start < end {
        let mut c = str_char_code(s, start);
        if c == 32 { start = start + 1; }
        else { if c == 9 { start = start + 1; } else { start = len(s) + 1; } }
    }
    if start > len(s) { let start = start - len(s) - 1; }
    while end > start {
        let mut c = str_char_code(s, end - 1);
        if c == 32 { end = end - 1; }
        else { if c == 9 { end = end - 1; } else { end = 0 - 1; } }
    }
    if end < 0 { let end = end + len(s) + 1; }
    if start >= len(s) { return ""; }
    if end <= 0 { return ""; }
    return str_sub(s, start, end);
}

fn _toml_detect_type(val) {
    if val == "true"  { return "b"; }
    if val == "false" { return "b"; }
    if len(val) == 0 { return "s"; }
    if str_char_code(val, 0) == 91  { return "a"; }  // '['
    // Check if integer or float
    let mut all_num = 1;
    let mut has_dot = 0;
    let mut i = 0;
    if str_char_code(val, 0) == 45 { i = 1; }   // leading '-'
    while i < len(val) {
        let mut c = str_char_code(val, i);
        if c == 46 { has_dot = 1; }
        else { if c < 48 { all_num = 0; } else { if c > 57 { all_num = 0; } } }
        i = i + 1;
    }
    if all_num == 1 {
        if has_dot == 1 { return "f"; }
        return "i";
    }
    return "s";
}

// Parse raw value: strip quotes, unescape
fn _toml_parse_val(raw) {
    let mut n = len(raw);
    if n == 0 { return ""; }
    let mut c0 = str_char_code(raw, 0);
    // Quoted string: strip outer quotes
    if c0 == 34 {   // '"'
        if n >= 2 { return str_sub(raw, 1, n - 1); }
        return "";
    }
    if c0 == 39 {   // "'"
        if n >= 2 { return str_sub(raw, 1, n - 1); }
        return "";
    }
    return raw;
}

// ============================================================
// Entry management
// ============================================================

fn _toml_find(section, key) {
    let mut i = 0;
    while i < toml_count_n {
        if toml_secs[i] == section {
            if toml_keys[i] == key { return i; }
        }
        i = i + 1;
    }
    return 0 - 1;
}

fn toml_get(section, key) {
    let mut idx = _toml_find(section, key);
    if idx < 0 { return ""; }
    return toml_vals[idx];
}

fn toml_get_int(section, key) {
    let mut v = toml_get(section, key);
    if len(v) == 0 { return 0; }
    return parse_int(v);
}

fn toml_get_bool(section, key) {
    let mut v = toml_get(section, key);
    if v == "true" { return 1; }
    return 0;
}

fn toml_set(section, key, val) {
    let mut idx = _toml_find(section, key);
    if idx >= 0 {
        set_at(toml_vals,  idx, val);
        set_at(toml_types, idx, _toml_detect_type(val));
        return idx;
    }
    if toml_count_n >= TOML_MAX { print("toml: table full"); return 0 - 1; }
    let mut slot = toml_count_n;
    set_at(toml_secs,  slot, section);
    set_at(toml_keys,  slot, key);
    set_at(toml_vals,  slot, val);
    set_at(toml_types, slot, _toml_detect_type(val));
    toml_count_n = toml_count_n + 1;
    return slot;
}

fn toml_delete(section, key) {
    let mut idx = _toml_find(section, key);
    if idx < 0 { return 0 - 1; }
    // Shift entries down
    let mut i = idx;
    while i < toml_count_n - 1 {
        set_at(toml_secs,  i, toml_secs[i + 1]);
        set_at(toml_keys,  i, toml_keys[i + 1]);
        set_at(toml_vals,  i, toml_vals[i + 1]);
        set_at(toml_types, i, toml_types[i + 1]);
        i = i + 1;
    }
    toml_count_n = toml_count_n - 1;
    return 0;
}

// ============================================================
// Load from VFS
// ============================================================

fn toml_load(path) {
    let mut fd = vfs_open(path, 0);
    if fd < 0 { print("toml: cannot open " + path); return 0 - 1; }
    let mut n = vfs_read(fd, TOML_BUF, TOML_BUF_SZ);
    vfs_close(fd);
    if n <= 0 { return 0; }

    // Build text string from buffer
    let mut text = "";
    let mut i = 0;
    while i < n {
        let mut b = mem_read_u8(TOML_BUF + i);
        if b == 13 { i = i + 1; }   // skip \r
        else { text = text + str_from_code(b); i = i + 1; }
    }

    toml_clear();
    let mut cur_section = "";

    // Split on newlines, process each line
    let mut line_start = 0;
    let mut tlen = len(text);
    let mut li = 0;
    while li <= tlen {
        let mut at_end = 0;
        if li == tlen { let at_end = 1; }
        let mut is_nl = 0;
        if li < tlen { if str_char_code(text, li) == 10 { let is_nl = 1; } }
        if is_nl == 1 {
            let mut line = _toml_trim(str_sub(text, line_start, li));
            line_start = li + 1;
            let mut llen = len(line);
            if llen == 0 { li = li + 1; }
            else {
                let mut c0 = str_char_code(line, 0);
                if c0 == 35 { li = li + 1; }   // '#' comment
                else {
                    if c0 == 91 {   // '[' section header
                        let mut rb = str_find(line, "]");
                        if rb > 0 { cur_section = str_sub(line, 1, rb); }
                        li = li + 1;
                    } else {
                        // key = value
                        let mut eq = str_find(line, "=");
                        if eq > 0 {
                            let mut key = _toml_trim(str_sub(line, 0, eq));
                            let mut raw = _toml_trim(str_sub(line, eq + 1, llen));
                            // Strip inline comment after unquoted value
                            let mut val = _toml_parse_val(raw);
                            toml_set(cur_section, key, val);
                        }
                        li = li + 1;
                    }
                }
            }
        } else { li = li + 1; }
    }

    print("toml: loaded " + path + " — " + to_string(toml_count_n) + " entries");
    return toml_count_n;
}

// ============================================================
// Save to VFS
// ============================================================

fn toml_save(path) {
    let mut text = "";
    let mut cur_sec = "__no_section__";
    let mut i = 0;
    while i < toml_count_n {
        if toml_secs[i] != cur_sec {
            cur_sec = toml_secs[i];
            if len(cur_sec) > 0 {
                text = text + "\n[" + cur_sec + "]\n";
            }
        }
        let mut typ = toml_types[i];
        let mut val = toml_vals[i];
        let mut val_out = val;
        if typ == "s" { val_out = "\"" + val + "\""; }
        text = text + toml_keys[i] + " = " + val_out + "\n";
        i = i + 1;
    }

    // Write to VFS
    let mut n = len(text);
    let mut j = 0;
    while j < n {
        mem_write_u8(TOML_BUF + j, str_char_code(text, j));
        j = j + 1;
    }
    let mut fd = vfs_open(path, 1);
    if fd < 0 { print("toml: cannot create " + path); return 0 - 1; }
    vfs_write(fd, TOML_BUF, n);
    vfs_close(fd);
    print("toml: saved " + to_string(toml_count_n) + " entries → " + path);
    return 0;
}

// ============================================================
// List / dump
// ============================================================

fn toml_list() {
    if toml_count_n == 0 { return "(no TOML entries loaded)\n"; }
    let mut out = "TOML entries (" + to_string(toml_count_n) + "):\n";
    let mut prev_sec = "__none__";
    let mut i = 0;
    while i < toml_count_n {
        if toml_secs[i] != prev_sec {
            prev_sec = toml_secs[i];
            if len(prev_sec) > 0 { out = out + "  [" + prev_sec + "]\n"; }
        }
        out = out + "    " + toml_keys[i] + " = " + toml_vals[i]
            + "  (" + toml_types[i] + ")\n";
        i = i + 1;
    }
    return out;
}

print("toml.hl loaded");
print("TOML: v1 parser/writer — sections, string/int/float/bool/array values, VFS load+save");
