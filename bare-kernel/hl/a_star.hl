// a_star.hl -- A* Heuristic Search (Hart, Nilsson, Raphael 1968)
// O(V²) linear-scan open set; Manhattan distance heuristic on 2D positions.
// AS_MAX_V=32; directed weighted graph, weights > 0.
//
// Runtime buffer: 0x15B0000 (4 KB)

let AS_MAX_V = 32;
let AS_INF   = 1000000;

// Adjacency matrix: as_adj[u*32+v] = weight (0 = no edge)
let as_adj    = array(1024, 0);
let as_hx     = array(32, 0);    // x coordinate for heuristic
let as_hy     = array(32, 0);    // y coordinate for heuristic
let as_g      = array(32, 0);    // g(v) = cost from source
let as_f      = array(32, 0);    // f(v) = g(v) + h(v, dst)
let as_open   = array(32, 0);    // 1 = in open set
let as_closed = array(32, 0);    // 1 = expanded
let as_prev   = array(32, 0);    // predecessor on best path
let as_n      = 0;
let as_result = 0;               // path cost after as_run() (-1 = unreachable)

fn a_star_init() {
    let i = 0;
    while i < 1024 {
        set_at(as_adj, i, 0);
        i += 1;
    }
    i = 0;
    while i < AS_MAX_V {
        set_at(as_hx,     i, 0);
        set_at(as_hy,     i, 0);
        set_at(as_g,      i, AS_INF);
        set_at(as_f,      i, AS_INF);
        set_at(as_open,   i, 0);
        set_at(as_closed, i, 0);
        set_at(as_prev,   i, -1);
        i += 1;
    }
    as_n      = 0;
    as_result = 0;
    return 0;
}

fn as_set_n(n) {
    as_n = n;
    return 0;
}

fn as_set_pos(v, x, y) {
    set_at(as_hx, v, x);
    set_at(as_hy, v, y);
    return 0;
}

// Add directed weighted edge u→v with weight w (w > 0)
fn as_add_edge(u, v, w) {
    if u >= AS_MAX_V { return -1; }
    if v >= AS_MAX_V { return -1; }
    set_at(as_adj, u * AS_MAX_V + v, w);
    if u + 1 > as_n { as_n = u + 1; }
    if v + 1 > as_n { as_n = v + 1; }
    return 0;
}

// Manhattan distance heuristic h(v, dst)
fn _as_h(v, dst) {
    let dx = as_hx[v] - as_hx[dst];
    let dy = as_hy[v] - as_hy[dst];
    if dx < 0 { dx = 0 - dx; }
    if dy < 0 { dy = 0 - dy; }
    return dx + dy;
}

// Run A* from src to dst; returns path cost or -1 if unreachable
fn as_run(src, dst) {
    let i = 0;
    while i < as_n {
        set_at(as_g,      i, AS_INF);
        set_at(as_f,      i, AS_INF);
        set_at(as_open,   i, 0);
        set_at(as_closed, i, 0);
        set_at(as_prev,   i, -1);
        i += 1;
    }
    set_at(as_g,    src, 0);
    set_at(as_f,    src, _as_h(src, dst));
    set_at(as_open, src, 1);
    as_result = -1;
    let done = 0;
    while done == 0 {
        // Pick open vertex with minimum f value
        let u = -1;
        i = 0;
        while i < as_n {
            if as_open[i] == 1 {
                if u < 0 {
                    u = i;
                } else {
                    if as_f[i] < as_f[u] { u = i; }
                }
            }
            i += 1;
        }
        if u < 0 {
            done = 1;
        } else {
            if u == dst {
                as_result = as_g[dst];
                done = 1;
            } else {
                set_at(as_open,   u, 0);
                set_at(as_closed, u, 1);
                // Expand neighbors of u
                i = 0;
                while i < as_n {
                    let w = as_adj[u * AS_MAX_V + i];
                    if w > 0 {
                        if as_closed[i] == 0 {
                            let ng = as_g[u] + w;
                            if ng < as_g[i] {
                                set_at(as_g,    i, ng);
                                set_at(as_f,    i, ng + _as_h(i, dst));
                                set_at(as_prev, i, u);
                                set_at(as_open, i, 1);
                            }
                        }
                    }
                    i += 1;
                }
            }
        }
    }
    return as_result;
}

fn a_star_test() {
    a_star_init();
    as_set_n(5);
    // Grid-like layout (x,y): 0=(0,0) 1=(2,0) 2=(4,0) 3=(2,2) 4=(4,2)
    as_set_pos(0, 0, 0);
    as_set_pos(1, 2, 0);
    as_set_pos(2, 4, 0);
    as_set_pos(3, 2, 2);
    as_set_pos(4, 4, 2);
    // Edges: 0→1:2, 0→3:3, 1→2:2, 1→3:1, 2→4:2, 3→4:3
    // All paths 0→4 cost 6 (0→1→2→4, 0→1→3→4, 0→3→4)
    as_add_edge(0, 1, 2);
    as_add_edge(0, 3, 3);
    as_add_edge(1, 2, 2);
    as_add_edge(1, 3, 1);
    as_add_edge(2, 4, 2);
    as_add_edge(3, 4, 3);
    let cost = as_run(0, 4);
    print("a_star_test src=0 dst=4 cost=" + to_string(cost));
    return cost;
}

print("a_star.hl loaded");
