// ui_calculator.hl -- Graphical Calculator
//
// 4-function calculator (+ - * /) rendered in a WM window.
// Layout: 240x320 px window, display row + 4x5 button grid.
//
// State machine:
//   uicalc_acc    -- accumulator (left operand)
//   uicalc_cur    -- current digit entry string
//   uicalc_op     -- pending operator ('+''-''*''/')
//   uicalc_fresh  -- 1 = next digit clears display
//
// WM integration:
//   uicalc_open()   -- open/show window
//   uicalc_draw()   -- render (called from wm_draw_all)
//   uicalc_key(k)   -- keyboard input
//   uicalc_click(x,y)-- mouse click (window-relative)
//
// Button grid (row-major, 4 columns x 5 rows):
//   Row 0: C   ±   %   ÷
//   Row 1: 7   8   9   ×
//   Row 2: 4   5   6   −
//   Row 3: 1   2   3   +
//   Row 4: 0  (wide)  .  =

let UICALC_WIN_W = 240;
let UICALC_WIN_H = 320;
let UICALC_WIN_X = 400;
let UICALC_WIN_Y = 140;

let UICALC_BTN_W = 56;
let UICALC_BTN_H = 48;
let UICALC_BTN_GAP = 4;
let UICALC_DISP_H = 64;

// State
let mut uicalc_open_flag = 0;
let mut uicalc_win_id    = 0 - 1;
let mut uicalc_acc       = 0;
let mut uicalc_cur       = "0";
let mut uicalc_op        = "";
let mut uicalc_fresh     = 0;
let mut uicalc_error     = 0;   // 1 = divide-by-zero

// Button labels: row 0..4, col 0..3
// Row 4 col 0 is "0" (double wide), col 2 is ".", col 3 is "="
fn _uicalc_btn_label(row, col) {
    if row == 0 {
        if col == 0 { return "C"; }
        if col == 1 { return "+/-"; }
        if col == 2 { return "%"; }
        if col == 3 { return "/"; }
    }
    if row == 1 {
        if col == 0 { return "7"; }
        if col == 1 { return "8"; }
        if col == 2 { return "9"; }
        if col == 3 { return "*"; }
    }
    if row == 2 {
        if col == 0 { return "4"; }
        if col == 1 { return "5"; }
        if col == 2 { return "6"; }
        if col == 3 { return "-"; }
    }
    if row == 3 {
        if col == 0 { return "1"; }
        if col == 1 { return "2"; }
        if col == 2 { return "3"; }
        if col == 3 { return "+"; }
    }
    if row == 4 {
        if col == 0 { return "0"; }
        if col == 2 { return "."; }
        if col == 3 { return "="; }
    }
    return "";
}

// Compute button pixel rect in window-relative coords
// Row 4 col 0 returns a double-wide button (cols 0+1)
fn _uicalc_btn_x(row, col) {
    let margin = 4;
    return margin + col * (UICALC_BTN_W + UICALC_BTN_GAP);
}

fn _uicalc_btn_y(row) {
    return UICALC_DISP_H + 4 + row * (UICALC_BTN_H + UICALC_BTN_GAP);
}

fn _uicalc_btn_w(row, col) {
    if row == 4 {
        if col == 0 { return UICALC_BTN_W * 2 + UICALC_BTN_GAP; }
    }
    return UICALC_BTN_W;
}

// Color helpers: operator/= keys get accent, digit keys get panel
fn _uicalc_btn_is_op(row, col) {
    if col == 3 { return 1; }      // rightmost column: /, *, -, +, =
    if row == 0 { return 1; }      // top row: C, +/-, %
    return 0;
}

// --- Arithmetic ---

fn _uicalc_apply_op() {
    if len(uicalc_op) == 0 { return uicalc_acc; }
    let b = parse_int(uicalc_cur);
    let a = uicalc_acc;
    if uicalc_op == "+" { return a + b; }
    if uicalc_op == "-" { return a - b; }
    if uicalc_op == "*" { return a * b; }
    if uicalc_op == "/" {
        if b == 0 { uicalc_error = 1; return 0; }
        return a / b;
    }
    return b;
}

fn _uicalc_push_digit(d) {
    if uicalc_fresh == 1 {
        uicalc_cur = d;
        uicalc_fresh = 0;
        return 0;
    }
    if uicalc_cur == "0" {
        uicalc_cur = d;
    } else {
        if len(uicalc_cur) < 12 { uicalc_cur = uicalc_cur + d; }
    }
    return 0;
}

fn _uicalc_push_op(op) {
    // Evaluate any pending op first
    let result = _uicalc_apply_op();
    uicalc_acc   = result;
    uicalc_op    = op;
    uicalc_fresh = 1;
    uicalc_cur   = to_string(result);
    return 0;
}

fn _uicalc_equals() {
    let result = _uicalc_apply_op();
    uicalc_acc   = result;
    uicalc_op    = "";
    uicalc_cur   = to_string(result);
    uicalc_fresh = 1;
    return 0;
}

fn _uicalc_clear() {
    uicalc_acc   = 0;
    uicalc_cur   = "0";
    uicalc_op    = "";
    uicalc_fresh = 0;
    uicalc_error = 0;
    return 0;
}

fn _uicalc_toggle_sign() {
    let v = parse_int(uicalc_cur);
    uicalc_cur = to_string(0 - v);
    return 0;
}

fn _uicalc_percent() {
    let v = parse_int(uicalc_cur);
    uicalc_cur = to_string(v / 100);
    return 0;
}

fn _uicalc_handle_btn(row, col) {
    if row == 0 {
        if col == 0 { _uicalc_clear(); return 0; }
        if col == 1 { _uicalc_toggle_sign(); return 0; }
        if col == 2 { _uicalc_percent(); return 0; }
        if col == 3 { _uicalc_push_op("/"); return 0; }
    }
    if row == 1 {
        if col == 0 { _uicalc_push_digit("7"); return 0; }
        if col == 1 { _uicalc_push_digit("8"); return 0; }
        if col == 2 { _uicalc_push_digit("9"); return 0; }
        if col == 3 { _uicalc_push_op("*"); return 0; }
    }
    if row == 2 {
        if col == 0 { _uicalc_push_digit("4"); return 0; }
        if col == 1 { _uicalc_push_digit("5"); return 0; }
        if col == 2 { _uicalc_push_digit("6"); return 0; }
        if col == 3 { _uicalc_push_op("-"); return 0; }
    }
    if row == 3 {
        if col == 0 { _uicalc_push_digit("1"); return 0; }
        if col == 1 { _uicalc_push_digit("2"); return 0; }
        if col == 2 { _uicalc_push_digit("3"); return 0; }
        if col == 3 { _uicalc_push_op("+"); return 0; }
    }
    if row == 4 {
        if col == 0 { _uicalc_push_digit("0"); return 0; }
        if col == 2 {
            // decimal point: append "." if not already present
            if str_find(uicalc_cur, ".") < 0 {
                uicalc_cur = uicalc_cur + ".";
            }
            return 0;
        }
        if col == 3 { _uicalc_equals(); return 0; }
    }
    return 0;
}

// --- Drawing ---

fn uicalc_draw() {
    if uicalc_open_flag == 0 { return 0; }

    let wx = UICALC_WIN_X;
    let wy = UICALC_WIN_Y;
    let bg = ui_theme_bg_color();
    let panel = ui_theme_panel_color();
    let border = ui_theme_border_color();
    let text_fg = ui_theme_text_color();
    let accent = ui_theme_accent_color();

    // Window background
    vesa_fill_rect(wx, wy, UICALC_WIN_W, UICALC_WIN_H, bg);
    vesa_rect(wx, wy, UICALC_WIN_W, UICALC_WIN_H, border);

    // Title bar
    vesa_fill_rect(wx, wy, UICALC_WIN_W, 20, panel);
    ui_draw_text(wx + 8, wy + 2, "Calculator", text_fg, 0);

    // Display area
    let disp_y = wy + 20;
    vesa_fill_rect(wx + 2, disp_y, UICALC_WIN_W - 4, UICALC_DISP_H - 20, panel);
    vesa_rect(wx + 2, disp_y, UICALC_WIN_W - 4, UICALC_DISP_H - 20, border);

    // Display text (right-aligned)
    let disp_str = uicalc_cur;
    if uicalc_error == 1 { disp_str = "Error"; }
    let tw = ui_text_width(disp_str);
    let dx = wx + UICALC_WIN_W - 4 - 8 - tw;
    let dy = disp_y + (UICALC_DISP_H - 20 - 16) / 2;
    ui_draw_text(dx, dy, disp_str, text_fg, 0);

    // Op indicator (small, top-right of display)
    if len(uicalc_op) > 0 {
        ui_draw_text(wx + UICALC_WIN_W - 20, disp_y + 4, uicalc_op, accent, 0);
    }

    // Button grid
    let mut row = 0;
    while row < 5 {
        let mut col = 0;
        while col < 4 {
            let lbl = _uicalc_btn_label(row, col);
            if len(lbl) > 0 {
                let bx = wx + _uicalc_btn_x(row, col);
                let by = wy + _uicalc_btn_y(row);
                let bw = _uicalc_btn_w(row, col);
                let bh = UICALC_BTN_H;
                if _uicalc_btn_is_op(row, col) == 1 {
                    ui_button_active(bx, by, bw, bh, lbl);
                } else {
                    ui_button(bx, by, bw, bh, lbl);
                }
            }
            col = col + 1;
        }
        row = row + 1;
    }
    return 0;
}

// --- Input handling ---

fn uicalc_key(k) {
    if uicalc_open_flag == 0 { return 0; }
    // Digits 0-9
    if k >= 48 {
        if k <= 57 {
            _uicalc_push_digit(str_from_code(k));
            uicalc_draw();
            return 1;
        }
    }
    if k == 43 { _uicalc_push_op("+"); uicalc_draw(); return 1; }  // '+'
    if k == 45 { _uicalc_push_op("-"); uicalc_draw(); return 1; }  // '-'
    if k == 42 { _uicalc_push_op("*"); uicalc_draw(); return 1; }  // '*'
    if k == 47 { _uicalc_push_op("/"); uicalc_draw(); return 1; }  // '/'
    if k == 61 { _uicalc_equals(); uicalc_draw(); return 1; }       // '='
    if k == 13 { _uicalc_equals(); uicalc_draw(); return 1; }       // Enter
    if k == 27 { uicalc_close(); return 1; }                        // Esc = close
    if k == 8  {                                                     // Backspace
        if len(uicalc_cur) > 1 {
            uicalc_cur = str_sub(uicalc_cur, 0, len(uicalc_cur) - 1);
        } else {
            uicalc_cur = "0";
        }
        uicalc_draw();
        return 1;
    }
    if k == 99 { _uicalc_clear(); uicalc_draw(); return 1; }  // 'c'
    return 0;
}

fn uicalc_click(mx, my) {
    if uicalc_open_flag == 0 { return 0; }
    // Convert to window-relative
    let rx = mx - UICALC_WIN_X;
    let ry = my - UICALC_WIN_Y;
    // Check each button
    let mut row = 0;
    while row < 5 {
        let mut col = 0;
        while col < 4 {
            let lbl = _uicalc_btn_label(row, col);
            if len(lbl) > 0 {
                let bx = _uicalc_btn_x(row, col);
                let by = _uicalc_btn_y(row);
                let bw = _uicalc_btn_w(row, col);
                let bh = UICALC_BTN_H;
                if ui_button_hit(bx, by, bw, bh, rx, ry) == 1 {
                    _uicalc_handle_btn(row, col);
                    uicalc_draw();
                    return 1;
                }
            }
            col = col + 1;
        }
        row = row + 1;
    }
    return 0;
}

// --- Lifecycle ---

fn uicalc_open() {
    _uicalc_clear();
    uicalc_open_flag = 1;
    uicalc_draw();
    return 0;
}

fn uicalc_close() {
    uicalc_open_flag = 0;
    // Redraw region as background
    vesa_fill_rect(UICALC_WIN_X, UICALC_WIN_Y, UICALC_WIN_W, UICALC_WIN_H, ui_theme_bg_color());
    return 0;
}

fn uicalc_is_open() {
    return uicalc_open_flag;
}

print("ui_calculator.hl loaded");
print("Calculator: 4-function, 4x5 button grid, 240x320 window");
