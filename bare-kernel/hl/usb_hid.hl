// usb_hid.hl -- USB HID (Human Interface Device) Class Driver
//
// Supports USB keyboards and mice via HID protocol.
// HID devices use interrupt endpoints for periodic input reports.
//
// HID Report Descriptor defines the format of input data.
// For standard keyboard: 8 bytes = [modifier, reserved, key1..key6]
// For standard mouse: 3-4 bytes = [buttons, dx, dy, (dwheel)]
//
// Boot protocol (simplified, no report descriptor parsing needed):
//   Keyboard boot protocol: SET_PROTOCOL(0) -> 8-byte reports
//   Mouse boot protocol: SET_PROTOCOL(0) -> 3-byte reports

let HID_SUBCLASS_BOOT = 1;
let HID_PROTOCOL_KEYBOARD = 1;
let HID_PROTOCOL_MOUSE = 2;

let mut hid_keyboard_slot = 0;
let mut hid_mouse_slot = 0;
let mut hid_keyboard_endpoint = 0;
let mut hid_mouse_endpoint = 0;

// Modifier key bits (byte 0 of keyboard report)
let MOD_LCTRL  = 1;
let MOD_LSHIFT = 2;
let MOD_LALT   = 4;
let MOD_LGUI   = 8;
let MOD_RCTRL  = 16;
let MOD_RSHIFT = 32;
let MOD_RALT   = 64;
let MOD_RGUI   = 128;

// USB HID usage -> ASCII (partial, US layout)
let HID_KEY_TABLE = [
    0, 0, 0, 0,                     // 0x00-0x03: reserved
    97, 98, 99, 100, 101, 102, 103,  // 0x04-0x0A: a-g
    104, 105, 106, 107, 108, 109,    // 0x0B-0x10: h-m
    110, 111, 112, 113, 114, 115,    // 0x11-0x16: n-s
    116, 117, 118, 119, 120, 121, 122, // 0x17-0x1D: t-z
    49, 50, 51, 52, 53, 54, 55, 56, 57, 48, // 0x1E-0x27: 1-0
    13, 27, 8, 9, 32                 // 0x28-0x2C: enter,esc,backspace,tab,space
];

fn usb_hid_init(slot_id, protocol) {
    // 1. Set configuration
    // 2. Set boot protocol: SET_PROTOCOL(0)
    // 3. Find interrupt IN endpoint
    if protocol == HID_PROTOCOL_KEYBOARD {
        hid_keyboard_slot = slot_id;
    }
    if protocol == HID_PROTOCOL_MOUSE {
        hid_mouse_slot = slot_id;
    }
    return 0;
}

// Poll keyboard for input (called from timer or dedicated task)
fn usb_hid_poll_keyboard() {
    if hid_keyboard_slot == 0 { return 0; }
    // Read 8 bytes from interrupt endpoint
    // let report = xhci_transfer_in(hid_keyboard_slot, hid_keyboard_endpoint, 8);
    // let modifier = report[0];
    // Keys are in report[2..7] (up to 6 simultaneous keys)
    // for i in 2..8: if report[i] != 0 { process_key(report[i], modifier); }
    return 0;
}

fn usb_hid_key_to_ascii(usage, modifier) {
    if usage >= len(HID_KEY_TABLE) { return 0; }
    let ch = HID_KEY_TABLE[usage];
    // Apply shift
    if (modifier % 4) / 2 == 1 { // LSHIFT
        if ch >= 97 { if ch <= 122 { ch = ch - 32; } } // a-z -> A-Z
    }
    if (modifier / 32) % 2 == 1 { // RSHIFT
        if ch >= 97 { if ch <= 122 { ch = ch - 32; } }
    }
    return ch;
}

fn usb_hid_poll_mouse() {
    if hid_mouse_slot == 0 { return 0; }
    // Read 3-4 bytes from interrupt endpoint
    // let report = xhci_transfer_in(hid_mouse_slot, hid_mouse_endpoint, 4);
    // let buttons = report[0];
    // let dx = report[1] (signed byte)
    // let dy = report[2] (signed byte)
    // Update mouse_x, mouse_y, mouse_buttons
    return 0;
}

