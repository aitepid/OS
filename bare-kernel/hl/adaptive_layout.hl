// adaptive_layout.hl -- Responsive layout engine + FormFactor detection
//
// Sprint G4 of HicOS GUI injection (per GUI_DESIGN.md §2A).
//
// Single source of truth for "what device am I on right now and how big
// should controls / fonts / spacing be?" Widgets call al_density_size(),
// al_density_font() etc. rather than hard-coding pixel values.
//
// Detection inputs:
//   - screen width (from vesa_width)
//   - touch hardware presence (input_touch's touch_present flag)
//   - user override stored in al_user_form_factor (0 = auto)

let AL_FF_DESKTOP  = 1;
let AL_FF_LAPTOP   = 2;
let AL_FF_TABLET   = 3;
let AL_FF_MOBILE   = 4;
let AL_FF_EMBEDDED = 5;

let AL_BP_XS  = 0;   // < 480
let AL_BP_SM  = 1;   // 480..767
let AL_BP_MD  = 2;   // 768..1023
let AL_BP_LG  = 3;   // 1024..1439
let AL_BP_XL  = 4;   // 1440..1919
let AL_BP_2XL = 5;   // >= 1920

let AL_DENSITY_COMPACT     = 0;   // 28 px controls, 13 px text
let AL_DENSITY_COMFORTABLE = 1;   // 36 px / 15 px (default desktop)
let AL_DENSITY_SPACIOUS    = 2;   // 44 px / 17 px
let AL_DENSITY_TOUCH       = 3;   // 48 px / 17 px

let mut al_form_factor       = 0;
let mut al_breakpoint        = 0;
let mut al_density           = 1;
let mut al_user_form_factor  = 0;       // 0 = auto-detect
let mut al_user_density      = 0 - 1;   // -1 = derive from form factor

fn al_detect_breakpoint(w) {
    if w < 480  { return AL_BP_XS; }
    if w < 768  { return AL_BP_SM; }
    if w < 1024 { return AL_BP_MD; }
    if w < 1440 { return AL_BP_LG; }
    if w < 1920 { return AL_BP_XL; }
    return AL_BP_2XL;
}

fn al_detect_form_factor(w, h, has_touch) {
    if al_user_form_factor != 0 { return al_user_form_factor; }
    if w < 768 { return AL_FF_MOBILE; }
    if has_touch == 1 {
        if w < 1280 { return AL_FF_TABLET; }
    }
    if w >= 1024 { return AL_FF_DESKTOP; }
    return AL_FF_LAPTOP;
}

fn al_density_for(form_factor, has_touch) {
    if al_user_density >= 0 { return al_user_density; }
    if has_touch == 1 { return AL_DENSITY_TOUCH; }
    if form_factor == AL_FF_TABLET   { return AL_DENSITY_SPACIOUS; }
    if form_factor == AL_FF_MOBILE   { return AL_DENSITY_TOUCH; }
    if form_factor == AL_FF_EMBEDDED { return AL_DENSITY_SPACIOUS; }
    return AL_DENSITY_COMFORTABLE;
}

fn al_init() {
    let mut w = vesa_width;
    let mut h = vesa_height;
    if w == 0 { w = 1024; }
    if h == 0 { h = 768;  }
    let mut has_touch = touch_present;
    al_breakpoint  = al_detect_breakpoint(w);
    al_form_factor = al_detect_form_factor(w, h, has_touch);
    al_density     = al_density_for(al_form_factor, has_touch);
    print("adaptive_layout: " + to_string(w) + "x" + to_string(h) +
          " bp=" + to_string(al_breakpoint) +
          " ff=" + to_string(al_form_factor) +
          " density=" + to_string(al_density));
    return 0;
}

fn al_set_form_factor(ff) { al_user_form_factor = ff; al_init(); return 0; }
fn al_set_density(d)      { al_user_density = d;     al_init(); return 0; }

fn al_form_factor_get() { return al_form_factor; }
fn al_breakpoint_get()  { return al_breakpoint;  }
fn al_density_get()     { return al_density;     }

// Density-aware sizing. control: minimum touch target / button height.
fn al_density_control() {
    if al_density == AL_DENSITY_COMPACT     { return 28; }
    if al_density == AL_DENSITY_COMFORTABLE { return 36; }
    if al_density == AL_DENSITY_SPACIOUS    { return 44; }
    return 48;
}

fn al_density_font_body() {
    if al_density == AL_DENSITY_COMPACT     { return 13; }
    if al_density == AL_DENSITY_COMFORTABLE { return 15; }
    return 17;
}

fn al_density_pad() {
    if al_density == AL_DENSITY_COMPACT { return 4; }
    if al_density == AL_DENSITY_TOUCH   { return 12; }
    return 8;
}

// Choose a responsive value from a list of breakpoint candidates.
// candidates is packed as 6 ints (xs, sm, md, lg, xl, 2xl).
fn al_responsive(xs, sm, md, lg, xl, x2l) {
    if al_breakpoint == AL_BP_XS  { return xs; }
    if al_breakpoint == AL_BP_SM  { return sm; }
    if al_breakpoint == AL_BP_MD  { return md; }
    if al_breakpoint == AL_BP_LG  { return lg; }
    if al_breakpoint == AL_BP_XL  { return xl; }
    return x2l;
}

// Column count for a responsive grid (1..6).
fn al_grid_cols() {
    return al_responsive(1, 1, 2, 3, 4, 4);
}

print("adaptive_layout.hl loaded");
