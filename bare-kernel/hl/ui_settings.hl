// ui_settings.hl -- Settings Center UI Module
//
// Tabbed settings window with four panels:
//   0 = Display  — theme + resolution
//   1 = Audio    — master volume
//   2 = Network  — IP / MAC / gateway
//   3 = About    — kernel version / uptime
//
// API (mirrors ui_sysmon.hl pattern):
//   uisettings_open()    uisettings_close()    uisettings_is_open()
//   uisettings_render()  uisettings_tick()     uisettings_handle_key(key)

// === Module state ===
let mut uisettings_win_id  = -1;
let mut uisettings_tab     = 0;       // 0-3 active tab
let mut uisettings_dirty   = 0;       // 1 = apply pending changes on close/apply

// Display settings state
let mut uisettings_theme   = 0;       // 0=Slate 1=Light 2=Dark
let UISETTINGS_THEME_NAMES = ["Slate", "Light", "Dark"];

// Audio settings state
let mut uisettings_volume  = 200;     // 0-255 master volume (default ~78%)

// Layout constants
let UST_WIN_X  = 160;
let UST_WIN_Y  = 80;
let UST_WIN_W  = 420;
let UST_WIN_H  = 320;
let UST_TAB_H  = 28;
let UST_TAB_W  = 104;
let UST_PAD    = 12;
let UST_ROW_H  = 22;

// Tab labels
let UST_TABS = ["Display", "Audio", "Network", "About"];

// === Internal helpers ===

fn uisettings_apply() {
    // Apply volume to mixer
    mixer_set_master_volume(uisettings_volume);
    uisettings_dirty = 0;
    return 0;
}

fn uisettings_draw_tabs(wx, wy) {
    let mut i = 0;
    while i < 4 {
        let tx = wx + UST_PAD + i * (UST_TAB_W + 2);
        let ty = wy;
        let mut bg = ui_theme_panel_color();
        let mut fg = ui_theme_text_color();
        if i == uisettings_tab {
            bg = ui_theme_accent_color();
            fg = ui_theme_surface_color();
        }
        vesa_fill_rect(tx, ty, UST_TAB_W, UST_TAB_H, bg);
        vesa_rect(tx, ty, UST_TAB_W, UST_TAB_H, ui_theme_border_color());
        ui_draw_text(tx + 8, ty + 6, UST_TABS[i], fg, 0);
        i = i + 1;
    }
    return 0;
}

fn uisettings_render_display(wx, wy) {
    let row0 = wy + UST_PAD;
    let col0 = wx + UST_PAD;

    ui_draw_text(col0, row0, "Theme:", ui_theme_text_color(), 0);
    // Draw three theme buttons
    let mut ti = 0;
    while ti < 3 {
        let bx = col0 + 60 + ti * 80;
        let by = row0 - 4;
        let mut bg = ui_theme_panel_color();
        if ti == uisettings_theme { bg = ui_theme_accent_color(); }
        vesa_fill_rect(bx, by, 72, 18, bg);
        vesa_rect(bx, by, 72, 18, ui_theme_border_color());
        ui_draw_text(bx + 4, by + 2, UISETTINGS_THEME_NAMES[ti], ui_theme_text_color(), 0);
        ti = ti + 1;
    }

    ui_separator_h(wx, row0 + UST_ROW_H, UST_WIN_W);

    ui_draw_text(col0, row0 + UST_ROW_H + 8, "Resolution:", ui_theme_text_color(), 0);
    let res_str = to_string(vesa_width) + " x " + to_string(vesa_height);
    ui_draw_text(col0 + 100, row0 + UST_ROW_H + 8, res_str, ui_theme_text_color(), 0);

    ui_draw_text(col0, row0 + UST_ROW_H * 2 + 8, "Color depth:", ui_theme_text_color(), 0);
    ui_draw_text(col0 + 100, row0 + UST_ROW_H * 2 + 8, "32-bit BGRA", ui_theme_text_color(), 0);

    return 0;
}

fn uisettings_render_audio(wx, wy) {
    let row0 = wy + UST_PAD;
    let col0 = wx + UST_PAD;

    ui_draw_text(col0, row0, "Master Volume:", ui_theme_text_color(), 0);

    // Draw volume progress bar
    let bar_x = col0 + 120;
    let bar_y = row0 - 2;
    let bar_w = 200;
    let bar_h = 16;
    let fill = bar_w * uisettings_volume / 255;
    vesa_fill_rect(bar_x, bar_y, bar_w, bar_h, ui_theme_panel_color());
    vesa_fill_rect(bar_x, bar_y, fill, bar_h, ui_theme_accent_color());
    vesa_rect(bar_x, bar_y, bar_w, bar_h, ui_theme_border_color());

    let pct = uisettings_volume * 100 / 255;
    ui_draw_text(bar_x + bar_w + 8, bar_y + 2, to_string(pct) + "%", ui_theme_text_color(), 0);

    ui_separator_h(wx, row0 + UST_ROW_H, UST_WIN_W);

    ui_draw_text(col0, row0 + UST_ROW_H + 8, "[ - ] decrease  [ + ] increase  volume",
                 ui_theme_text_color(), 0);

    ui_draw_text(col0, row0 + UST_ROW_H * 2 + 8, "Audio device:", ui_theme_text_color(), 0);
    ui_draw_text(col0 + 100, row0 + UST_ROW_H * 2 + 8, "AC97 (ICH)", ui_theme_text_color(), 0);

    return 0;
}

fn uisettings_render_network(wx, wy) {
    let row0 = wy + UST_PAD;
    let col0 = wx + UST_PAD;

    // Show IP from net module
    let my_ip_str = to_string(my_ip[0]) + "." + to_string(my_ip[1]) + "." +
                    to_string(my_ip[2]) + "." + to_string(my_ip[3]);
    let gw_str    = to_string(gateway[0]) + "." + to_string(gateway[1]) + "." +
                    to_string(gateway[2]) + "." + to_string(gateway[3]);

    ui_draw_text(col0, row0,               "IP Address:", ui_theme_text_color(), 0);
    ui_draw_text(col0 + 110, row0,         my_ip_str, ui_theme_text_color(), 0);

    ui_separator_h(wx, row0 + UST_ROW_H - 4, UST_WIN_W);

    ui_draw_text(col0, row0 + UST_ROW_H,           "Gateway:",   ui_theme_text_color(), 0);
    ui_draw_text(col0 + 110, row0 + UST_ROW_H,     gw_str,      ui_theme_text_color(), 0);

    ui_draw_text(col0, row0 + UST_ROW_H * 2,       "MAC:",       ui_theme_text_color(), 0);
    let mac_str = to_string(my_mac[0]) + ":" + to_string(my_mac[1]) + ":" +
                  to_string(my_mac[2]) + ":" + to_string(my_mac[3]) + ":" +
                  to_string(my_mac[4]) + ":" + to_string(my_mac[5]);
    ui_draw_text(col0 + 110, row0 + UST_ROW_H * 2, mac_str,     ui_theme_text_color(), 0);

    ui_draw_text(col0, row0 + UST_ROW_H * 3,       "Interface:", ui_theme_text_color(), 0);
    ui_draw_text(col0 + 110, row0 + UST_ROW_H * 3, "eth0 (VirtIO-net)", ui_theme_text_color(), 0);

    return 0;
}

fn uisettings_render_about(wx, wy) {
    let row0 = wy + UST_PAD;
    let col0 = wx + UST_PAD;

    ui_draw_text(col0, row0,                    "OS:",       ui_theme_text_color(), 0);
    ui_draw_text(col0 + 80, row0,               "HicOS v6.0 (Iteration 132)", ui_theme_text_color(), 0);

    ui_separator_h(wx, row0 + UST_ROW_H - 4, UST_WIN_W);

    ui_draw_text(col0, row0 + UST_ROW_H,        "Arch:",     ui_theme_text_color(), 0);
    ui_draw_text(col0 + 80, row0 + UST_ROW_H,   "x86_64", ui_theme_text_color(), 0);

    ui_draw_text(col0, row0 + UST_ROW_H * 2,    "Lang:",     ui_theme_text_color(), 0);
    ui_draw_text(col0 + 80, row0 + UST_ROW_H * 2, "Hilbert-Lang (all layers)", ui_theme_text_color(), 0);

    ui_draw_text(col0, row0 + UST_ROW_H * 3,    "Kernel:",   ui_theme_text_color(), 0);
    ui_draw_text(col0 + 80, row0 + UST_ROW_H * 3, "bare-kernel (130+ modules)", ui_theme_text_color(), 0);

    ui_draw_text(col0, row0 + UST_ROW_H * 4,    "Uptime:",   ui_theme_text_color(), 0);
    let up = uptime_secs();
    let hh = up / 3600;
    let mm = (up % 3600) / 60;
    let ss = up % 60;
    ui_draw_text(col0 + 80, row0 + UST_ROW_H * 4,
                 to_string(hh) + "h " + to_string(mm) + "m " + to_string(ss) + "s",
                 ui_theme_text_color(), 0);

    ui_draw_text(col0, row0 + UST_ROW_H * 5,    "Shell cmds:", ui_theme_text_color(), 0);
    ui_draw_text(col0 + 80, row0 + UST_ROW_H * 5, "73", ui_theme_text_color(), 0);

    return 0;
}

// === Public API ===

fn uisettings_is_open() {
    if uisettings_win_id >= 0 { return 1; }
    return 0;
}

fn uisettings_open() {
    if uisettings_win_id >= 0 { return 0; }
    uisettings_win_id = wm_create_window(UST_WIN_X, UST_WIN_Y,
                                         UST_WIN_W, UST_WIN_H,
                                         "Settings", 0);
    uisettings_tab  = 0;
    uisettings_dirty = 0;
    return 0;
}

fn uisettings_close() {
    if uisettings_win_id < 0 { return 0; }
    if uisettings_dirty == 1 { uisettings_apply(); }
    wm_destroy_window(uisettings_win_id);
    uisettings_win_id = -1;
    return 0;
}

fn uisettings_render() {
    if uisettings_win_id < 0 { return 0; }

    let wx = wm_win_x(uisettings_win_id);
    let wy = wm_win_y(uisettings_win_id);
    let title_h = ui_theme_title_height();
    let content_y = wy + title_h;

    // Tab bar
    uisettings_draw_tabs(wx, content_y);

    // Content area background
    let panel_y = content_y + UST_TAB_H + 2;
    let panel_h = UST_WIN_H - UST_TAB_H - 2;
    vesa_fill_rect(wx + 1, panel_y, UST_WIN_W - 2, panel_h, ui_theme_surface_color());
    ui_separator_h(wx, panel_y, UST_WIN_W);

    // Active tab content
    let inner_y = panel_y + UST_PAD;
    if uisettings_tab == 0 { uisettings_render_display(wx, inner_y); }
    if uisettings_tab == 1 { uisettings_render_audio(wx, inner_y); }
    if uisettings_tab == 2 { uisettings_render_network(wx, inner_y); }
    if uisettings_tab == 3 { uisettings_render_about(wx, inner_y); }

    // Apply button (bottom right)
    let btn_x = wx + UST_WIN_W - 90;
    let btn_y = wy + UST_WIN_H - 30;
    vesa_fill_rect(btn_x, btn_y, 80, 22, ui_theme_accent_color());
    vesa_rect(btn_x, btn_y, 80, 22, ui_theme_border_color());
    ui_draw_text(btn_x + 18, btn_y + 4, "Apply", ui_theme_surface_color(), 0);

    return 0;
}

fn uisettings_tick() {
    return 0;
}

fn uisettings_handle_key(key) {
    if uisettings_win_id < 0 { return 0; }

    // Tab switching: Left/Right arrow
    if key == 75 {
        if uisettings_tab > 0 { uisettings_tab = uisettings_tab - 1; }
        return 0;
    }
    if key == 77 {
        if uisettings_tab < 3 { uisettings_tab = uisettings_tab + 1; }
        return 0;
    }
    // Audio tab: +/- adjust volume
    if uisettings_tab == 1 {
        if key == 78 {  // '+' (numpad)
            if uisettings_volume < 245 { uisettings_volume = uisettings_volume + 10; }
            else { uisettings_volume = 255; }
            uisettings_dirty = 1;
            return 0;
        }
        if key == 74 {  // '-' (numpad)
            if uisettings_volume > 10 { uisettings_volume = uisettings_volume - 10; }
            else { uisettings_volume = 0; }
            uisettings_dirty = 1;
            return 0;
        }
    }
    // Display tab: cycle theme with T
    if uisettings_tab == 0 {
        if key == 20 {  // 'T'
            uisettings_theme = (uisettings_theme + 1) % 3;
            return 0;
        }
    }
    // Enter = Apply
    if key == 28 {
        uisettings_apply();
        return 0;
    }
    // Escape = close
    if key == 1 {
        uisettings_close();
        return 0;
    }
    return 0;
}

fn uisettings_handle_click(px, py) {
    if uisettings_win_id < 0 { return 0; }
    let wx = wm_win_x(uisettings_win_id);
    let wy = wm_win_y(uisettings_win_id);
    let title_h = ui_theme_title_height();
    let tab_y = wy + title_h;

    // Check tab clicks
    let mut i = 0;
    while i < 4 {
        let tx = wx + UST_PAD + i * (UST_TAB_W + 2);
        if px >= tx {
            if px < tx + UST_TAB_W {
                if py >= tab_y {
                    if py < tab_y + UST_TAB_H {
                        uisettings_tab = i;
                        return 1;
                    }
                }
            }
        }
        i = i + 1;
    }

    // Check Apply button
    let btn_x = wx + UST_WIN_W - 90;
    let btn_y = wy + UST_WIN_H - 30;
    if px >= btn_x {
        if px < btn_x + 80 {
            if py >= btn_y {
                if py < btn_y + 22 {
                    uisettings_apply();
                    return 1;
                }
            }
        }
    }
    return 0;
}

print("ui_settings.hl loaded");
print("Settings Center: Display / Audio / Network / About");
