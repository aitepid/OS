// chacha20.hl - ChaCha20 Stream Cipher
// Implements ChaCha20 encryption algorithm (simplified, no real bitwise ops)

// ChaCha20 constants
let CHACHA20_ROUNDS = 20;
let CHACHA20_BLOCK_SIZE = 64;
let CHACHA20_KEY_SIZE = 32;
let CHACHA20_NONCE_SIZE = 12;

// ChaCha20 state arrays (replace raw memory addresses)
let chacha20_state = array(64, 0);
let chacha20_key = array(32, 0);
let chacha20_nonce = array(12, 0);
let mut chacha20_counter = 0;
let chacha20_keystream = array(64, 0);
let chacha20_initial_state = array(64, 0);
let chacha20_output = array(4096, 0);
let chacha20_test_buf = array(64, 0);

fn chacha20_init() {
    let mut i = 0;
    while i < 64 {
        set_at(chacha20_state, i, 0);
        set_at(chacha20_keystream, i, 0);
        set_at(chacha20_initial_state, i, 0);
        i = i + 1;
    }
    i = 0;
    while i < 32 {
        set_at(chacha20_key, i, 0);
        i = i + 1;
    }
    i = 0;
    while i < 12 {
        set_at(chacha20_nonce, i, 0);
        i = i + 1;
    }
    chacha20_counter = 0;
    print("ChaCha20 cipher ready");
    return 0;
}

// Set encryption key (32 bytes)
fn chacha20_set_key(key) {
    let mut i = 0;
    while i < CHACHA20_KEY_SIZE {
        if i < len(key) {
            set_at(chacha20_key, i, key[i]);
        } else {
            set_at(chacha20_key, i, 0);
        }
        i = i + 1;
    }
    return 0;
}

// Set nonce (12 bytes)
fn chacha20_set_nonce(nonce) {
    let mut i = 0;
    while i < CHACHA20_NONCE_SIZE {
        if i < len(nonce) {
            set_at(chacha20_nonce, i, nonce[i]);
        } else {
            set_at(chacha20_nonce, i, 0);
        }
        i = i + 1;
    }
    chacha20_counter = 0;
    return 0;
}

// Encrypt/decrypt data (ChaCha20 is symmetric)
fn chacha20_crypt(data, dlen) {
    let mut data_pos = 0;
    while data_pos < dlen {
        // Generate keystream block
        _chacha20_block(chacha20_counter);

        // XOR data with keystream (simulated via addition mod 256)
        let mut block_len = CHACHA20_BLOCK_SIZE;
        if dlen - data_pos < block_len {
            block_len = dlen - data_pos;
        }

        let mut i = 0;
        while i < block_len {
            let plain_byte = data[data_pos + i];
            let key_byte = chacha20_keystream[i];
            let cipher_byte = (plain_byte + key_byte) % 256;
            set_at(chacha20_output, data_pos + i, cipher_byte);
            i = i + 1;
        }

        data_pos = data_pos + block_len;
        chacha20_counter = chacha20_counter + 1;
    }
    return chacha20_output;
}

// Generate one ChaCha20 block (64 bytes)
fn _chacha20_block(counter) {
    // Constants: "expand 32-byte k" (decimal equivalents of 0x61707865, 0x3320646e, 0x79622d32, 0x6b206574)
    _chacha20_set_word(chacha20_state, 0, 1634760805);
    _chacha20_set_word(chacha20_state, 1, 857760878);
    _chacha20_set_word(chacha20_state, 2, 2036477234);
    _chacha20_set_word(chacha20_state, 3, 1797285236);

    // Key (8 words)
    let mut i = 0;
    while i < 8 {
        let word = _chacha20_read_u32_le(chacha20_key, i * 4);
        _chacha20_set_word(chacha20_state, 4 + i, word);
        i = i + 1;
    }

    // Counter (1 word)
    _chacha20_set_word(chacha20_state, 12, counter);

    // Nonce (3 words)
    i = 0;
    while i < 3 {
        let word = _chacha20_read_u32_le(chacha20_nonce, i * 4);
        _chacha20_set_word(chacha20_state, 13 + i, word);
        i = i + 1;
    }

    // Save initial state
    i = 0;
    while i < 16 {
        let word = _chacha20_get_word(chacha20_state, i);
        _chacha20_set_word(chacha20_initial_state, i, word);
        i = i + 1;
    }

    // Perform 20 rounds (10 double rounds)
    let mut round = 0;
    while round < CHACHA20_ROUNDS {
        _chacha20_quarter_round(chacha20_state, 0, 4, 8, 12);
        _chacha20_quarter_round(chacha20_state, 1, 5, 9, 13);
        _chacha20_quarter_round(chacha20_state, 2, 6, 10, 14);
        _chacha20_quarter_round(chacha20_state, 3, 7, 11, 15);
        round = round + 1;

        _chacha20_quarter_round(chacha20_state, 0, 5, 10, 15);
        _chacha20_quarter_round(chacha20_state, 1, 6, 11, 12);
        _chacha20_quarter_round(chacha20_state, 2, 7, 8, 13);
        _chacha20_quarter_round(chacha20_state, 3, 4, 9, 14);
        round = round + 1;
    }

    // Add initial state back
    i = 0;
    while i < 16 {
        let current = _chacha20_get_word(chacha20_state, i);
        let initial = _chacha20_get_word(chacha20_initial_state, i);
        _chacha20_set_word(chacha20_state, i, (current + initial) % 4294967296);
        i = i + 1;
    }

    // Serialize state to keystream
    i = 0;
    while i < 16 {
        let word = _chacha20_get_word(chacha20_state, i);
        _chacha20_write_u32_le(chacha20_keystream, i * 4, word);
        i = i + 1;
    }
    return 0;
}

// ChaCha20 quarter round
fn _chacha20_quarter_round(state, a, b, c, d) {
    let mut va = _chacha20_get_word(state, a);
    let mut vb = _chacha20_get_word(state, b);
    let mut vc = _chacha20_get_word(state, c);
    let mut vd = _chacha20_get_word(state, d);

    // a += b; d ^= a; d <<<= 16
    va = (va + vb) % 4294967296;
    vd = _chacha20_xor(vd, va);
    vd = _chacha20_rotl(vd, 16);

    // c += d; b ^= c; b <<<= 12
    vc = (vc + vd) % 4294967296;
    vb = _chacha20_xor(vb, vc);
    vb = _chacha20_rotl(vb, 12);

    // a += b; d ^= a; d <<<= 8
    va = (va + vb) % 4294967296;
    vd = _chacha20_xor(vd, va);
    vd = _chacha20_rotl(vd, 8);

    // c += d; b ^= c; b <<<= 7
    vc = (vc + vd) % 4294967296;
    vb = _chacha20_xor(vb, vc);
    vb = _chacha20_rotl(vb, 7);

    _chacha20_set_word(state, a, va);
    _chacha20_set_word(state, b, vb);
    _chacha20_set_word(state, c, vc);
    _chacha20_set_word(state, d, vd);
    return 0;
}

// Simulated XOR using modular arithmetic (byte-wise approximation)
fn _chacha20_xor(a, b) {
    let mut result = 0;
    let mut i = 0;
    while i < 4 {
        let byte_a = (a / _chacha20_pow256(i)) % 256;
        let byte_b = (b / _chacha20_pow256(i)) % 256;
        let xor_byte = (byte_a + byte_b) % 256;
        result = result + xor_byte * _chacha20_pow256(i);
        i = i + 1;
    }
    return result;
}

// Rotate left using multiply/divide
fn _chacha20_rotl(value, bits) {
    let left = (value * _chacha20_pow2(bits)) % 4294967296;
    let right = value / _chacha20_pow2(32 - bits);
    return (left + right) % 4294967296;
}

// Power of 2
fn _chacha20_pow2(exp) {
    if exp == 0 { return 1; }
    let mut result = 1;
    let mut i = 0;
    while i < exp {
        result = result * 2;
        i = i + 1;
    }
    return result;
}

// Power of 256 (lookup table)
fn _chacha20_pow256(exp) {
    if exp == 0 { return 1; }
    if exp == 1 { return 256; }
    if exp == 2 { return 65536; }
    if exp == 3 { return 16777216; }
    return 1;
}

// Get 32-bit word from byte-array state
fn _chacha20_get_word(state, index) {
    return _chacha20_read_u32_le(state, index * 4);
}

// Set 32-bit word in byte-array state
fn _chacha20_set_word(state, index, value) {
    _chacha20_write_u32_le(state, index * 4, value);
    return 0;
}

// Read 32-bit little-endian value from byte array
fn _chacha20_read_u32_le(buf, offset) {
    let b0 = buf[offset + 0];
    let b1 = buf[offset + 1];
    let b2 = buf[offset + 2];
    let b3 = buf[offset + 3];
    return b0 + b1 * 256 + b2 * 65536 + b3 * 16777216;
}

// Write 32-bit little-endian value to byte array
fn _chacha20_write_u32_le(buf, offset, value) {
    set_at(buf, offset + 0, value % 256);
    set_at(buf, offset + 1, (value / 256) % 256);
    set_at(buf, offset + 2, (value / 65536) % 256);
    set_at(buf, offset + 3, (value / 16777216) % 256);
    return 0;
}

// Return the shared output buffer
fn chacha20_get_result() {
    return chacha20_output;
}

// Test ChaCha20 encrypt/decrypt roundtrip
fn _test() {
    chacha20_init();
    chacha20_set_key("test_key_256_bits_long_12345");
    chacha20_set_nonce("nonce_12byte");

    let plaintext = "Hello ChaCha20!";
    let plen = len(plaintext);

    // Encrypt plaintext into chacha20_output
    chacha20_crypt(plaintext, plen);

    // Save ciphertext to temp buffer before decrypting
    let mut si = 0;
    while si < plen {
        set_at(chacha20_test_buf, si, chacha20_output[si]);
        si = si + 1;
    }

    // Reset counter and decrypt saved ciphertext
    chacha20_counter = 0;
    chacha20_crypt(chacha20_test_buf, plen);

    // Verify decrypted output matches original plaintext
    let mut ok = 1;
    let mut vi = 0;
    while vi < plen {
        if chacha20_output[vi] != plaintext[vi] {
            ok = 0;
        }
        vi = vi + 1;
    }

    if ok == 1 {
        print("ChaCha20 test: passed");
    }
    if ok == 0 {
        print("ChaCha20 test: FAILED");
    }
    return 0;
}

_test();
print("chacha20.hl loaded");
