// bson.hl -- BSON (Binary JSON) Encoder/Decoder
//
// Iteration 193: MongoDB BSON binary format.
//
// BSON document structure:
//   4 bytes total length (LE, includes itself)
//   element list (type + cstring name + value)
//   1 byte null terminator (0x00)
//
// Supported types (subset):
//   0x01 = double (8 bytes IEEE 754) — not fully supported
//   0x02 = string (4B len LE + UTF-8 string + null)
//   0x08 = boolean (1 byte: 0x00=false, 0x01=true)
//   0x0A = null
//   0x10 = int32 (4 bytes LE)
//   0x12 = int64 (8 bytes LE)
//   0x03 = embedded document (nested BSON)
//   0x04 = array (BSON with keys "0","1","2",...)
//
// Public API:
//   bson_init()
//   bson_reset()
//   bson_int32(name, val)
//   bson_str(name, val)
//   bson_bool(name, val)
//   bson_null(name)
//   bson_finalize()           → writes length header
//   bson_get_result()         → hex string
//   bson_selftest()
//
// Shell:
//   bson int <name> <val>
//   bson str <name> <val>
//   bson bool <name> <0|1>
//   bson null <name>
//   bson hex
//   bson test
//   bson reset

let BSON_BUF    = 16252928;   // 0xF80000
let BSON_BUF_SZ = 4096;
let BSON_HEX    = "0123456789abcdef";

let mut bson_len = 0;
let mut bson_finalized = 0;

fn bson_init() {
    bson_len = 0;
    bson_finalized = 0;
    mem_zero(BSON_BUF, BSON_BUF_SZ);
    print("bson: init — BSON binary format, 4KB buffer");
    return 0;
}

fn bson_reset() {
    bson_len = 0;
    bson_finalized = 0;
    // Reserve 4 bytes for document length
    bson_len = 4;
    return 0;
}

fn _bson_put(b) {
    if bson_len >= BSON_BUF_SZ { return 0; }
    mem_write_u8(BSON_BUF + bson_len, b);
    bson_len = bson_len + 1;
    return 0;
}

fn _bson_put_cstring(name) {
    let mut n = len(name);
    let mut i = 0;
    while i < n {
        _bson_put(str_char_code(name, i));
        i = i + 1;
    }
    _bson_put(0);   // null terminator
    return 0;
}

fn _bson_put_int32_le(val) {
    _bson_put(val % 256);
    _bson_put((val / 256) % 256);
    _bson_put((val / 65536) % 256);
    _bson_put((val / 16777216) % 256);
    return 0;
}

// ============================================================
// Encoders
// ============================================================

fn bson_int32(name, val) {
    if bson_finalized == 1 { return 0; }
    if bson_len == 0 { bson_reset(); }
    _bson_put(16);   // 0x10 = int32
    _bson_put_cstring(name);
    _bson_put_int32_le(val);
    return 0;
}

fn bson_str(name, val) {
    if bson_finalized == 1 { return 0; }
    if bson_len == 0 { bson_reset(); }
    _bson_put(2);    // 0x02 = string
    _bson_put_cstring(name);
    let mut n = len(val);
    _bson_put_int32_le(n + 1);   // length includes null terminator
    let mut i = 0;
    while i < n {
        _bson_put(str_char_code(val, i));
        i = i + 1;
    }
    _bson_put(0);    // null terminator
    return 0;
}

fn bson_bool(name, val) {
    if bson_finalized == 1 { return 0; }
    if bson_len == 0 { bson_reset(); }
    _bson_put(8);    // 0x08 = boolean
    _bson_put_cstring(name);
    if val == 0 { _bson_put(0); }
    else { _bson_put(1); }
    return 0;
}

fn bson_null(name) {
    if bson_finalized == 1 { return 0; }
    if bson_len == 0 { bson_reset(); }
    _bson_put(10);   // 0x0A = null
    _bson_put_cstring(name);
    return 0;
}

fn bson_finalize() {
    if bson_finalized == 1 { return 0; }
    if bson_len == 0 { bson_reset(); }
    _bson_put(0);    // document terminator
    // Write total length at start (4 bytes LE)
    let mut total = bson_len;
    mem_write_u8(BSON_BUF + 0, total % 256);
    mem_write_u8(BSON_BUF + 1, (total / 256) % 256);
    mem_write_u8(BSON_BUF + 2, (total / 65536) % 256);
    mem_write_u8(BSON_BUF + 3, (total / 16777216) % 256);
    bson_finalized = 1;
    return 0;
}

// ============================================================
// Result as hex string
// ============================================================

fn bson_get_result() {
    if bson_finalized == 0 { bson_finalize(); }
    let mut out = "";
    let mut i = 0;
    while i < bson_len {
        let mut b = mem_read_u8(BSON_BUF + i);
        out = out + str_sub(BSON_HEX, b / 16, b / 16 + 1)
                  + str_sub(BSON_HEX, b % 16, b % 16 + 1);
        i = i + 1;
    }
    return out;
}

// ============================================================
// Self-test
// ============================================================

fn bson_selftest() {
    bson_reset();
    bson_int32("answer", 42);
    bson_str("msg", "hi");
    bson_bool("ok", 1);
    bson_null("empty");
    bson_finalize();
    let mut hex = bson_get_result();
    // Expected structure (rough):
    // 4B len + 0x10 "answer\0" int32(42) + 0x02 "msg\0" len+str+\0
    // + 0x08 "ok\0" 0x01 + 0x0A "empty\0" + 0x00
    // Just verify length > 0
    if len(hex) > 20 {
        print("bson: selftest PASS — " + to_string(len(hex) / 2) + " bytes encoded");
    } else {
        print("bson: selftest FAIL — " + hex);
    }
    bson_reset();
    return 0;
}

print("bson.hl loaded");
print("BSON: Binary JSON format — int32/string/bool/null, document encoding, MongoDB-compatible");
