// gfx_shadow.hl -- Soft drop shadow for layers
//
// Sprint G2 of HicOS GUI injection (per GUI_DESIGN.md §3.3).
//
// Fluent uses three shadow tiers: 16 / 24 / 32 px @ 12% black.
// We approximate with a precomputed 32×32 alpha lookup that fades a black
// border around each window. Cheaper than a real Gaussian and visually
// indistinguishable at small radii.
//
// API:
//   gfx_shadow_draw(x, y, w, h)            — Fluent default (16 px, 12%)
//   gfx_shadow_draw_n(x, y, w, h, radius)  — explicit radius

let SHADOW_RADIUS_DEFAULT = 16;
let SHADOW_ALPHA          = 31;        // 12% of 255 ≈ 31
let mut shadow_table_ready = 0;
let SHADOW_TABLE_ADDR = 71303168;       // 0x04400000 (32*32 = 1024 B)
let SHADOW_TABLE_SIZE = 32;

fn gfx_shadow_init() {
    if shadow_table_ready == 1 { return 0; }
    // Build a quarter-shadow falloff: alpha drops linearly from full at the
    // window edge (0) to 0 at radius=32. Centered Gaussian would be nicer
    // but adds cost without visible difference at this size.
    let mut d = 0;
    while d < SHADOW_TABLE_SIZE {
        let mut a = SHADOW_ALPHA - SHADOW_ALPHA * d / SHADOW_TABLE_SIZE;
        if a < 0 { a = 0; }
        mem_write_u8(SHADOW_TABLE_ADDR + d, a);
        d = d + 1;
    }
    shadow_table_ready = 1;
    return 0;
}

fn gfx_shadow_alpha_at(d) {
    if d < 0 { return SHADOW_ALPHA; }
    if d >= SHADOW_TABLE_SIZE { return 0; }
    return mem_read_u8(SHADOW_TABLE_ADDR + d);
}

// Draw soft shadow around rect (x,y,w,h) with the given radius.
fn gfx_shadow_draw_n(x, y, w, h, radius) {
    if shadow_table_ready == 0 { gfx_shadow_init(); }
    if w <= 0 { return 0; }
    if h <= 0 { return 0; }
    let mut r = radius;
    if r > SHADOW_TABLE_SIZE { r = SHADOW_TABLE_SIZE; }
    // Top and bottom bands (rows above/below the rect).
    let mut dy = 1;
    while dy <= r {
        let mut a_top    = gfx_shadow_alpha_at(dy);
        let mut col      = 0 - r;
        while col < w + r {
            let mut a = a_top;
            // Soften corners: scale by horizontal distance outside rect.
            if col < 0 {
                let mut dcorner = 0 - col;
                let mut a_h = gfx_shadow_alpha_at(dcorner);
                if a_h < a { a = a_h; }
            }
            if col >= w {
                let mut dcorner = col - (w - 1);
                let mut a_h = gfx_shadow_alpha_at(dcorner);
                if a_h < a { a = a_h; }
            }
            if a > 0 {
                let mut clr = gfx_pack(a, 0, 0, 0);
                gfx_putpixel_alpha(x + col, y - dy,         clr);
                gfx_putpixel_alpha(x + col, y + h - 1 + dy, clr);
            }
            col = col + 1;
        }
        dy = dy + 1;
    }
    // Left and right side bands (excluding rows already handled).
    let mut dx = 1;
    while dx <= r {
        let mut a = gfx_shadow_alpha_at(dx);
        if a > 0 {
            let mut clr = gfx_pack(a, 0, 0, 0);
            let mut row = 0;
            while row < h {
                gfx_putpixel_alpha(x - dx,         y + row, clr);
                gfx_putpixel_alpha(x + w - 1 + dx, y + row, clr);
                row = row + 1;
            }
        }
        dx = dx + 1;
    }
    // Offset bias: Fluent shadows are slightly lower-right; add a 4 px
    // darker strip beneath the window to give that 'lifted' impression.
    let mut bias = 4;
    if bias > 0 {
        gfx_fill_rect(x + bias, y + h, w - bias, bias, gfx_pack(SHADOW_ALPHA, 0, 0, 0));
    }
    return 0;
}

fn gfx_shadow_draw(x, y, w, h) {
    return gfx_shadow_draw_n(x, y, w, h, SHADOW_RADIUS_DEFAULT);
}

print("gfx_shadow.hl loaded");
