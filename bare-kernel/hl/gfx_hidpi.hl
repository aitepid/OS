// gfx_hidpi.hl -- HiDPI 全局缩放（Sprint G8）
//
// 单一全局 scale_factor (num/den)：1×=1/1, 1.25×=5/4, 1.5×=3/2, 2×=2/1。
// 与 G1 gfx_back 的 gfx_scale_set/gfx_scale_px 协同：所有控件用
// logical 像素声明几何，渲染时由 hidpi_px() 转换。
//
// 自动检测：根据 vesa_width 与 vesa_height 估计屏幕物理尺寸。
//   >= 2560 -> 2×
//   >= 1920 -> 1.5×
//   >= 1366 -> 1.25×
//   <  1366 -> 1×

let HIDPI_1X    = 0;
let HIDPI_125X  = 1;
let HIDPI_15X   = 2;
let HIDPI_2X    = 3;

let mut hidpi_initialized = 0;
let mut hidpi_level       = 0;
let mut hidpi_num         = 1;
let mut hidpi_den         = 1;

fn gfx_hidpi_init() {
    if hidpi_initialized == 1 { return 0; }
    let mut w = vesa_width;  if w == 0 { w = 1024; }
    if w >= 2560      { hidpi_level = HIDPI_2X;   hidpi_num = 2; hidpi_den = 1; }
    else { if w >= 1920 { hidpi_level = HIDPI_15X;  hidpi_num = 3; hidpi_den = 2; }
    else { if w >= 1366 { hidpi_level = HIDPI_125X; hidpi_num = 5; hidpi_den = 4; }
    else                { hidpi_level = HIDPI_1X;   hidpi_num = 1; hidpi_den = 1; } } }
    gfx_scale_set(hidpi_num, hidpi_den);
    hidpi_initialized = 1;
    print("gfx_hidpi: scale factor detected");
    return 0;
}

fn hidpi_level_get() { return hidpi_level; }
fn hidpi_num_get()   { return hidpi_num; }
fn hidpi_den_get()   { return hidpi_den; }

fn hidpi_set(level) {
    if level == HIDPI_1X   { hidpi_num = 1; hidpi_den = 1; }
    if level == HIDPI_125X { hidpi_num = 5; hidpi_den = 4; }
    if level == HIDPI_15X  { hidpi_num = 3; hidpi_den = 2; }
    if level == HIDPI_2X   { hidpi_num = 2; hidpi_den = 1; }
    hidpi_level = level;
    gfx_scale_set(hidpi_num, hidpi_den);
    return 0;
}

// logical px -> physical px
fn hidpi_px(logical) { return logical * hidpi_num / hidpi_den; }
fn hidpi_unpx(physical) { return physical * hidpi_den / hidpi_num; }

// 取相对密度推荐字体大小
fn hidpi_font_caption() { return 11 * hidpi_num / hidpi_den; }
fn hidpi_font_body()    { return 13 * hidpi_num / hidpi_den; }
fn hidpi_font_subhead() { return 17 * hidpi_num / hidpi_den; }
fn hidpi_font_title()   { return 22 * hidpi_num / hidpi_den; }

print("gfx_hidpi.hl loaded");
