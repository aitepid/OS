// poly_sqrt.hl -- Polynomial Square Root + Evaluation (iter 351)
// Buffer: 0x1960000
// psq_sqrt(n): g = sqrt(f) mod x^n where f[0]=1. Recurrence O(n^2):
//   g[0]=1; g[k] = inv(2)*(f[k] - sum_{i=1}^{k-1} g[i]*g[k-i])
// psq_eval(deg, val): Horner evaluation of psq_f at val. All mod p=998244353.

let PSQ_N    = 16;
let PSQ_P    = 998244353;
let PSQ_INV2 = 499122177;   // inv(2) mod 998244353: 2*499122177 = 998244354 ≡ 1

let psq_f = array(16, 0);
let psq_g = array(16, 0);

fn psq_init() {
    let mut i = 0;
    while i < PSQ_N { set_at(psq_f, i, 0); set_at(psq_g, i, 0); i += 1; }
    return 0;
}

fn _psq_mod(x) { return x - (x / PSQ_P) * PSQ_P; }
fn _psq_add(a, b) { let mut s = a + b; if s >= PSQ_P { s = s - PSQ_P; } return s; }
fn _psq_sub(a, b) { if a >= b { return a - b; } return a - b + PSQ_P; }
fn _psq_mul(a, b) { return _psq_mod(a * b); }

// g = sqrt(psq_f) mod x^n, f[0] = 1
fn psq_sqrt(n) {
    let mut i = 0;
    while i < PSQ_N { set_at(psq_g, i, 0); i += 1; }
    set_at(psq_g, 0, 1);
    let mut k = 1;
    while k < n {
        let mut s = 0;
        let mut i2 = 1;
        while i2 <= k - 1 {
            s = _psq_add(s, _psq_mul(psq_g[i2], psq_g[k - i2]));
            i2 += 1;
        }
        set_at(psq_g, k, _psq_mul(PSQ_INV2, _psq_sub(psq_f[k], s)));
        k += 1;
    }
    return 0;
}

// Horner evaluation of psq_f[0..deg] at val mod p
fn psq_eval(deg, val) {
    if deg >= PSQ_N { deg = PSQ_N - 1; }
    let mut result = psq_f[deg];
    let mut i = deg;
    let mut go = 1;
    while go == 1 {
        if i == 0 { go = 0; }
        if go == 1 {
            i -= 1;
            result = _psq_add(_psq_mul(result, val), psq_f[i]);
        }
    }
    return result;
}

fn psq_test() {
    psq_init();
    // f = (1+x)^2 = 1 + 2x + x^2; sqrt(f) mod x^4 = [1, 1, 0, 0]
    set_at(psq_f, 0, 1); set_at(psq_f, 1, 2); set_at(psq_f, 2, 1);
    psq_sqrt(4);
    let mut ok = 1;
    if psq_g[0] != 1 { ok = 0; }
    if psq_g[1] != 1 { ok = 0; }
    if psq_g[2] != 0 { ok = 0; }
    if psq_g[3] != 0 { ok = 0; }
    // Also test: f(3) = (1+3)^2 = 16
    let mut ev = psq_eval(2, 3);
    print("psq_test: g=[" + to_string(psq_g[0]) + "," + to_string(psq_g[1]) + "," + to_string(psq_g[2]) + "] eval(3)=" + to_string(ev));
    if ok == 1 {
        if ev == 16 {
            print("psq_test: PASS");
            return 1;
        }
    }
    print("psq_test: FAIL");
    return 0;
}

print("poly_sqrt.hl loaded");
