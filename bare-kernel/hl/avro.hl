// avro.hl -- Apache Avro Binary Encoding
// Iteration 433 | Buffer: array-based
//
// Simplified Avro binary serialization/deserialization.
// Features:
// - ZigZag variable-length integer encoding (int / long)
// - Boolean, int, long, bytes encoding
// - Varint encode/decode with done-flag loop (no break)
// - Sequential encode+decode buffer management
//
// Testing: avro_test() → validates boolean/int round-trips and ZigZag properties

let AVRO_BUF_SIZE = 4096;
let AVRO_DEC_SIZE = 1024;

let AVRO_NULL    = 0;
let AVRO_BOOLEAN = 1;
let AVRO_INT     = 2;
let AVRO_LONG    = 3;
let AVRO_STRING  = 7;

let avro_out     = array(4096, 0);   // encode output
let mut avro_out_len = 0;
let mut avro_dec_pos = 0;

fn avro_init() {
    avro_out_len = 0;
    avro_dec_pos = 0;
    return 0;
}

fn avro_start() {
    avro_out_len = 0;
    return 0;
}

// ZigZag encode: positive n → 2n; negative n → 2*|n| - 1
fn _avro_zigzag_enc(n) {
    if n >= 0 { return n * 2; }
    return (0 - n) * 2 - 1;
}

// ZigZag decode
fn _avro_zigzag_dec(n) {
    if n % 2 == 0 { return n / 2; }
    return 0 - ((n + 1) / 2);
}

// 128^n for shifts up to 4 (covers 28-bit values in Avro varints)
fn _avro_shift128(n) {
    if n == 0 { return 1; }
    if n == 1 { return 128; }
    if n == 2 { return 16384; }
    if n == 3 { return 2097152; }
    return 268435456;
}

// Encode unsigned varint into avro_out starting at pos; return new pos.
fn _avro_enc_varint(pos, value) {
    let mut done = 0;
    while done == 0 {
        if value < 128 {
            set_at(avro_out, pos, value);
            pos = pos + 1;
            done = 1;
        }
        if done == 0 {
            set_at(avro_out, pos, (value % 128) + 128);
            pos  = pos + 1;
            value = value / 128;
        }
    }
    return pos;
}

// Decode varint from buf starting at pos.
// Stores end position in avro_dec_pos; returns decoded value.
fn _avro_dec_varint(buf, pos) {
    let mut value = 0;
    let mut shift = 0;
    let done  = 0;
    while done == 0 {
        let mut byte = buf[pos];
        pos   = pos + 1;
        value = value + (byte % 128) * _avro_shift128(shift);
        shift = shift + 1;
        if byte < 128 { done = 1; }
    }
    avro_dec_pos = pos;
    return value;
}

fn avro_add_boolean(v) {
    let mut b = 0;
    if v != 0 { b = 1; }
    set_at(avro_out, avro_out_len, b);
    avro_out_len = avro_out_len + 1;
    return avro_out_len;
}

fn avro_add_int(v) {
    let zz = _avro_zigzag_enc(v);
    avro_out_len = _avro_enc_varint(avro_out_len, zz);
    return avro_out_len;
}

fn avro_add_long(v) {
    return avro_add_int(v);
}

fn avro_add_bytes(data, nbytes) {
    avro_out_len = _avro_enc_varint(avro_out_len, _avro_zigzag_enc(nbytes));
    let mut i = 0;
    while i < nbytes {
        set_at(avro_out, avro_out_len, data[i]);
        avro_out_len = avro_out_len + 1;
        i = i + 1;
    }
    return avro_out_len;
}

fn avro_decode_start(pos) {
    avro_dec_pos = pos;
    return 0;
}

fn avro_decode_boolean(buf) {
    let mut v = buf[avro_dec_pos];
    avro_dec_pos = avro_dec_pos + 1;
    return v;
}

fn avro_decode_int(buf) {
    let raw = _avro_dec_varint(buf, avro_dec_pos);
    return _avro_zigzag_dec(raw);
}

fn avro_decode_long(buf) {
    return avro_decode_int(buf);
}

fn avro_get_length() { return avro_out_len; }
fn avro_get_buf()    { return avro_out;     }

fn avro_test() {
    avro_init();
    let mut pass = 1;

    // Boolean round-trip
    avro_start();
    avro_add_boolean(1);
    avro_add_boolean(0);
    avro_decode_start(0);
    let b1 = avro_decode_boolean(avro_out);
    let b0 = avro_decode_boolean(avro_out);
    if b1 != 1 { pass = 0; }
    if b0 != 0 { pass = 0; }

    // Integer round-trip (positive, negative, zero, boundary)
    avro_start();
    avro_add_int(42);
    avro_add_int(0 - 17);
    avro_add_int(0);
    avro_add_int(127);
    avro_decode_start(0);
    let v1 = avro_decode_int(avro_out);
    let v2 = avro_decode_int(avro_out);
    let v3 = avro_decode_int(avro_out);
    let v4 = avro_decode_int(avro_out);
    if v1 != 42     { pass = 0; }
    if v2 != 0 - 17 { pass = 0; }
    if v3 != 0      { pass = 0; }
    if v4 != 127    { pass = 0; }

    // Multi-byte varint: value >= 128 needs 2 bytes
    avro_start();
    avro_add_int(300);
    let varint_len = avro_get_length();
    if varint_len < 2 { pass = 0; }   // 300 zigzag-encodes to 600, needs 2 varint bytes
    avro_decode_start(0);
    let v5 = avro_decode_int(avro_out);
    if v5 != 300 { pass = 0; }

    // ZigZag properties
    let zz_pos = _avro_zigzag_enc(10);
    let zz_neg = _avro_zigzag_enc(0 - 10);
    if zz_pos != 20               { pass = 0; }
    if zz_neg != 19               { pass = 0; }
    if _avro_zigzag_dec(20) != 10 { pass = 0; }
    if _avro_zigzag_dec(19) != 0 - 10 { pass = 0; }
    if _avro_zigzag_dec(0)  != 0  { pass = 0; }

    print("avro_test: b1=" + to_string(b1)
          + " v1=" + to_string(v1)
          + " v2=" + to_string(v2)
          + " v5=" + to_string(v5)
          + " zz_pos=" + to_string(zz_pos));

    if pass == 1 { print("avro_test PASS"); }
    if pass == 0 { print("avro_test FAIL"); }
    return pass;
}

avro_test();
print("avro.hl loaded");
