// widget_select.hl -- Toggle, checkbox, radio, segmented control, combobox
//
// Sprint G4 of HicOS GUI injection (per GUI_DESIGN.md §3.5).
//
// Win11 Fluent specs:
//   - Toggle: pill 40×20 with sliding thumb; on state = accent fill
//   - Checkbox: 20×20 rounded square; check glyph drawn via gfx_path
//   - Radio: 20×20 circle with inner accent dot when selected
//   - Segmented: row of pill buttons sharing a track; selected = accent fill
//   - ComboBox: textfield + chevron-down; dropdown is a separate menu

fn toggle_new(parent, x, y, initial_on) {
    let mut id = widget_new(WIDGET_KIND_TOGGLE, parent, x, y, 40, 20);
    if initial_on == 1 { widget_set_checked(id, 1); }
    return id;
}

fn toggle_paint(id) {
    if widget_get_flag(id, WIDGET_FLAG_VISIBLE) == 0 { return 0; }
    let mut on = widget_get_flag(id, WIDGET_FLAG_CHECKED);
    let mut bg = ui_theme_bg_overlay();
    if on == 1 { bg = ui_theme_accent_get(); }
    gfx_rect_round(widget_x[id], widget_y[id], widget_w[id], widget_h[id],
                   widget_h[id] / 2, bg);
    let mut tx = widget_x[id] + 4;
    if on == 1 { tx = widget_x[id] + widget_w[id] - 16; }
    gfx_circle_aa(tx + 6, widget_y[id] + widget_h[id] / 2, 6,
                  gfx_pack(255, 255, 255, 255));
    widget_set_flag(id, WIDGET_FLAG_DIRTY, 0);
    return 0;
}

fn toggle_handle_pointer(id, ev_type, x, y) {
    if widget_hit(id, x, y) == 0 { return 0; }
    if ev_type == PEV_TYPE_UP {
        let mut cur = widget_get_flag(id, WIDGET_FLAG_CHECKED);
        if cur == 1 { widget_set_checked(id, 0); }
        else        { widget_set_checked(id, 1); }
        // Sliding thumb animation
        let mut tx_from = widget_x[id] + 4;
        let mut tx_to   = widget_x[id] + widget_w[id] - 16;
        if cur == 1 { anim_start(ANIM_TARGET_SURFACE, id, ANIM_PROP_X, tx_to, tx_from, 167, ANIM_EASE_OUT); }
        else        { anim_start(ANIM_TARGET_SURFACE, id, ANIM_PROP_X, tx_from, tx_to, 167, ANIM_EASE_OUT); }
        return 1;
    }
    return 0;
}

// ─── Checkbox ───────────────────────────────────────────────────────────────

fn checkbox_new(parent, x, y, label_addr) {
    let mut id = widget_new(WIDGET_KIND_CHECKBOX, parent, x, y, 200, 20);
    widget_set_label(id, label_addr);
    return id;
}

fn checkbox_paint(id) {
    if widget_get_flag(id, WIDGET_FLAG_VISIBLE) == 0 { return 0; }
    let mut bx = widget_x[id];
    let mut by = widget_y[id];
    let mut on = widget_get_flag(id, WIDGET_FLAG_CHECKED);
    let mut bg = ui_theme_bg_elevated();
    if on == 1 { bg = ui_theme_accent_get(); }
    gfx_rect_round(bx, by, 20, 20, 4, bg);
    if on == 1 {
        // Checkmark path: short diagonal then long diagonal.
        gfx_path_reset();
        gfx_path_move(bx + 4,  by + 10);
        gfx_path_line(bx + 9,  by + 15);
        gfx_path_line(bx + 16, by + 6);
        gfx_path_stroke(gfx_pack(255, 255, 255, 255));
    }
    if widget_label[id] != 0 {
        let mut size = al_density_font_body();
        font_atlas_draw_str(bx + 28, by + (20 - font_atlas_h(size)) / 2,
                            cstr_from_addr(widget_label[id]), size,
                            ui_theme_text_primary());
    }
    widget_set_flag(id, WIDGET_FLAG_DIRTY, 0);
    return 0;
}

// ─── Radio ──────────────────────────────────────────────────────────────────

fn radio_new(parent, x, y, group, label_addr) {
    let mut id = widget_new(WIDGET_KIND_RADIO, parent, x, y, 200, 20);
    widget_set_label(id, label_addr);
    widget_set_extra(id, group);
    return id;
}

fn radio_paint(id) {
    if widget_get_flag(id, WIDGET_FLAG_VISIBLE) == 0 { return 0; }
    let mut bx = widget_x[id];
    let mut by = widget_y[id];
    let mut on = widget_get_flag(id, WIDGET_FLAG_CHECKED);
    gfx_circle_aa(bx + 10, by + 10, 9, ui_theme_bg_elevated());
    if on == 1 {
        gfx_circle_aa(bx + 10, by + 10, 9, ui_theme_accent_get());
        gfx_circle_aa(bx + 10, by + 10, 4, gfx_pack(255, 255, 255, 255));
    }
    if widget_label[id] != 0 {
        let mut size = al_density_font_body();
        font_atlas_draw_str(bx + 28, by + (20 - font_atlas_h(size)) / 2,
                            cstr_from_addr(widget_label[id]), size,
                            ui_theme_text_primary());
    }
    widget_set_flag(id, WIDGET_FLAG_DIRTY, 0);
    return 0;
}

// Select exclusive: pass the group id; selects this radio and deselects siblings.
fn radio_select(id) {
    let mut group = widget_extra[id];
    let mut i = 1;
    while i < WIDGET_MAX {
        if widget_used[i] == 1 {
            if widget_kind[i] == WIDGET_KIND_RADIO {
                if widget_extra[i] == group {
                    widget_set_checked(i, 0);
                }
            }
        }
        i = i + 1;
    }
    widget_set_checked(id, 1);
    return 0;
}

// ─── SegmentedControl ───────────────────────────────────────────────────────
// Items count packed into widget_value; selected index into widget_extra.

fn segmented_new(parent, x, y, w, h, num_items, initial_index) {
    let mut id = widget_new(WIDGET_KIND_SEGMENTED, parent, x, y, w, h);
    widget_set_value(id, num_items);
    widget_set_extra(id, initial_index);
    return id;
}

fn segmented_paint(id) {
    if widget_get_flag(id, WIDGET_FLAG_VISIBLE) == 0 { return 0; }
    let mut n = widget_value[id];
    if n <= 0 { return 0; }
    let mut seg_w = widget_w[id] / n;
    gfx_rect_round(widget_x[id], widget_y[id], widget_w[id], widget_h[id], 6,
                   ui_theme_bg_overlay());
    let mut sel = widget_extra[id];
    gfx_rect_round(widget_x[id] + sel * seg_w + 2, widget_y[id] + 2,
                   seg_w - 4, widget_h[id] - 4, 4, ui_theme_accent_get());
    widget_set_flag(id, WIDGET_FLAG_DIRTY, 0);
    return 0;
}

fn segmented_handle_pointer(id, ev_type, x, y) {
    if widget_hit(id, x, y) == 0 { return 0; }
    if ev_type == PEV_TYPE_UP {
        let mut n = widget_value[id];
        if n <= 0 { return 0; }
        let mut seg_w = widget_w[id] / n;
        let mut idx = (x - widget_x[id]) / seg_w;
        if idx < 0 { idx = 0; }
        if idx >= n { idx = n - 1; }
        widget_set_extra(id, idx);
        return 1;
    }
    return 0;
}

// ─── ComboBox ───────────────────────────────────────────────────────────────
// Just a textfield + chevron; dropdown menu is widget_nav's responsibility.

fn combobox_new(parent, x, y, w, h, placeholder_addr) {
    let mut id = widget_new(WIDGET_KIND_COMBOBOX, parent, x, y, w, h);
    widget_set_label(id, placeholder_addr);
    return id;
}

fn combobox_paint(id) {
    if widget_get_flag(id, WIDGET_FLAG_VISIBLE) == 0 { return 0; }
    widget_base_rect(id, 4);
    let mut size = al_density_font_body();
    let mut pad  = al_density_pad();
    let mut tx = widget_x[id] + pad;
    let mut ty = widget_y[id] + (widget_h[id] - font_atlas_h(size)) / 2;
    if widget_label[id] != 0 {
        font_atlas_draw_str(tx, ty, cstr_from_addr(widget_label[id]), size,
                            ui_theme_text_primary());
    }
    // Right-side chevron-down
    let mut cx = widget_x[id] + widget_w[id] - 16;
    let mut cy = widget_y[id] + widget_h[id] / 2;
    gfx_path_reset();
    gfx_path_move(cx - 4, cy - 2);
    gfx_path_line(cx,     cy + 2);
    gfx_path_line(cx + 4, cy - 2);
    gfx_path_stroke(ui_theme_text_secondary());
    widget_set_flag(id, WIDGET_FLAG_DIRTY, 0);
    return 0;
}

print("widget_select.hl loaded");
