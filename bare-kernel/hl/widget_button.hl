// widget_button.hl -- Button family (filled / outlined / text / icon)
//
// Sprint G4 of HicOS GUI injection (per GUI_DESIGN.md §3.5).
//
// Three visual variants stored in widget_extra:
//   0 = filled  (accent background, white text)
//   1 = outlined (transparent bg, accent border + text)
//   2 = text    (no bg, no border, accent text)
//   3 = icon    (square, glyph only)
//
// Win11 Fluent micro-interaction: 0.96× scale on press (handled by a
// short anim from anim_start). Hover overlay = +6% lightness. Disabled
// gets 40% opacity globally.

let BUTTON_VARIANT_FILLED   = 0;
let BUTTON_VARIANT_OUTLINED = 1;
let BUTTON_VARIANT_TEXT     = 2;
let BUTTON_VARIANT_ICON     = 3;

fn button_new(parent, x, y, w, h, label_addr, variant) {
    let mut id = widget_new(WIDGET_KIND_BUTTON, parent, x, y, w, h);
    widget_set_label(id, label_addr);
    widget_set_extra(id, variant);
    return id;
}

fn button_paint(id) {
    if widget_get_flag(id, WIDGET_FLAG_VISIBLE) == 0 { return 0; }
    let mut variant = widget_extra[id];
    let mut accent  = ui_theme_accent_get();
    let mut bg      = 0;
    let mut fg      = ui_theme_text_primary();
    let mut bx = widget_x[id];
    let mut by = widget_y[id];
    let mut bw = widget_w[id];
    let mut bh = widget_h[id];
    if variant == BUTTON_VARIANT_FILLED {
        bg = accent;
        if widget_get_flag(id, WIDGET_FLAG_HOVER)   == 1 { bg = gfx_pack(255, 0, 90, 200); }
        if widget_get_flag(id, WIDGET_FLAG_PRESSED) == 1 { bg = gfx_pack(255, 0, 60, 160); }
        gfx_rect_round(bx, by, bw, bh, 4, bg);
        fg = gfx_pack(255, 255, 255, 255);
    } else if variant == BUTTON_VARIANT_OUTLINED {
        bg = ui_theme_bg_elevated();
        gfx_rect_round(bx, by, bw, bh, 4, bg);
        // Outline as 1 px AA rect.
        gfx_line_aa(bx, by, bx + bw - 1, by, accent);
        gfx_line_aa(bx, by + bh - 1, bx + bw - 1, by + bh - 1, accent);
        gfx_line_aa(bx, by, bx, by + bh - 1, accent);
        gfx_line_aa(bx + bw - 1, by, bx + bw - 1, by + bh - 1, accent);
        fg = accent;
    } else if variant == BUTTON_VARIANT_TEXT {
        if widget_get_flag(id, WIDGET_FLAG_HOVER) == 1 {
            gfx_rect_round(bx, by, bw, bh, 4, ui_theme_bg_overlay());
        }
        fg = accent;
    } else if variant == BUTTON_VARIANT_ICON {
        if widget_get_flag(id, WIDGET_FLAG_HOVER) == 1 {
            gfx_rect_round(bx, by, bw, bh, 4, ui_theme_bg_overlay());
        }
        fg = ui_theme_text_primary();
    }
    if widget_label[id] != 0 {
        let mut size = al_density_font_body();
        let mut text_w = font_atlas_measure(cstr_from_addr(widget_label[id]), size);
        let mut tx = bx + (bw - text_w) / 2;
        let mut ty = by + (bh - font_atlas_h(size)) / 2;
        font_atlas_draw_str(tx, ty, cstr_from_addr(widget_label[id]), size, fg);
    }
    widget_set_flag(id, WIDGET_FLAG_DIRTY, 0);
    return 0;
}

fn button_handle_pointer(id, ev_type, x, y) {
    if widget_hit(id, x, y) == 0 {
        if widget_get_flag(id, WIDGET_FLAG_HOVER) == 1 {
            widget_set_flag(id, WIDGET_FLAG_HOVER, 0);
            widget_set_flag(id, WIDGET_FLAG_PRESSED, 0);
            widget_set_dirty(id);
        }
        return 0;
    }
    if ev_type == PEV_TYPE_HOVER {
        if widget_get_flag(id, WIDGET_FLAG_HOVER) == 0 {
            widget_set_flag(id, WIDGET_FLAG_HOVER, 1);
            widget_set_dirty(id);
        }
    } else if ev_type == PEV_TYPE_DOWN {
        widget_set_flag(id, WIDGET_FLAG_PRESSED, 1);
        widget_focus(id);
        widget_set_dirty(id);
    } else if ev_type == PEV_TYPE_UP {
        if widget_get_flag(id, WIDGET_FLAG_PRESSED) == 1 {
            widget_set_flag(id, WIDGET_FLAG_PRESSED, 0);
            widget_set_dirty(id);
            return 1;   // click consumed
        }
    }
    return 0;
}

print("widget_button.hl loaded");
