// base32.hl -- Base32 Encoding/Decoding
//
// Base32 is a binary-to-text encoding using 32 printable characters.
// RFC 4648: Uses A-Z (26) + 2-7 (6) = 32 characters, case-insensitive.
// Encoding: 5 bits per character, 8 bytes -> 13 characters (with padding).
//
// Features:
//   - Encode binary data to Base32 string
//   - Decode Base32 string to binary data
//   - Support RFC 4648 Base32 alphabet (A-Z, 2-7)
//   - Padding with '=' to align to 8-character blocks
//   - Case-insensitive decoding
//
// Memory:
//   - BASE32_BUF: 0x1040000 (17039360), 64 KB encode/decode buffer

let BASE32_BUF = 17039360;       // 0x1040000
let BASE32_BUF_SZ = 65536;       // 64 KB
let mut base32_len = 0;

fn base32_init() {
    base32_len = 0;
    return 0;
}

fn base32_clear() {
    base32_len = 0;
    return 0;
}

fn _base32_encode_char(n) {
    if n < 26 { return 65 + n; }                    // A-Z: 0-25
    return 50 + (n - 26);                           // 2-7: 26-31
}

fn _base32_decode_char(c) {
    if c >= 65 { if c <= 90 { return c - 65; } }    // A-Z: 0-25
    if c >= 97 { if c <= 122 { return c - 97; } }   // a-z: 0-25 (case-insensitive)
    if c >= 50 { if c <= 55 { return c - 50 + 26; } } // 2-7: 26-31
    return 0 - 1;
}

fn base32_encode(data) {
    base32_clear();

    let mut i = 0;
    while i < len(data) {
        let b0 = str_char_code(data, i);
        let b1 = 0;
        let b2 = 0;
        let b3 = 0;
        let b4 = 0;

        if i + 1 < len(data) { b1 = str_char_code(data, i + 1); }
        if i + 2 < len(data) { b2 = str_char_code(data, i + 2); }
        if i + 3 < len(data) { b3 = str_char_code(data, i + 3); }
        if i + 4 < len(data) { b4 = str_char_code(data, i + 4); }

        let c0 = b0 / 8;
        let c1 = (b0 % 8) * 4 + (b1 / 64);
        let c2 = (b1 / 2) % 32;
        let c3 = (b1 % 2) * 16 + (b2 / 16);
        let c4 = (b2 % 16) * 2 + (b3 / 128);
        let c5 = (b3 / 4) % 32;
        let c6 = (b3 % 4) * 8 + (b4 / 32);
        let c7 = b4 % 32;

        if base32_len >= BASE32_BUF_SZ { return 0 - 1; }
        mem_write_byte(BASE32_BUF + base32_len, _base32_encode_char(c0));
        base32_len = base32_len + 1;

        if base32_len >= BASE32_BUF_SZ { return 0 - 1; }
        mem_write_byte(BASE32_BUF + base32_len, _base32_encode_char(c1));
        base32_len = base32_len + 1;

        if i + 1 < len(data) {
            if base32_len >= BASE32_BUF_SZ { return 0 - 1; }
            mem_write_byte(BASE32_BUF + base32_len, _base32_encode_char(c2));
            base32_len = base32_len + 1;

            if base32_len >= BASE32_BUF_SZ { return 0 - 1; }
            mem_write_byte(BASE32_BUF + base32_len, _base32_encode_char(c3));
            base32_len = base32_len + 1;
        } else {
            if base32_len >= BASE32_BUF_SZ { return 0 - 1; }
            mem_write_byte(BASE32_BUF + base32_len, 61);
            base32_len = base32_len + 1;

            if base32_len >= BASE32_BUF_SZ { return 0 - 1; }
            mem_write_byte(BASE32_BUF + base32_len, 61);
            base32_len = base32_len + 1;
        }

        if i + 2 < len(data) {
            if base32_len >= BASE32_BUF_SZ { return 0 - 1; }
            mem_write_byte(BASE32_BUF + base32_len, _base32_encode_char(c4));
            base32_len = base32_len + 1;
        } else {
            if base32_len >= BASE32_BUF_SZ { return 0 - 1; }
            mem_write_byte(BASE32_BUF + base32_len, 61);
            base32_len = base32_len + 1;
        }

        if i + 3 < len(data) {
            if base32_len >= BASE32_BUF_SZ { return 0 - 1; }
            mem_write_byte(BASE32_BUF + base32_len, _base32_encode_char(c5));
            base32_len = base32_len + 1;

            if base32_len >= BASE32_BUF_SZ { return 0 - 1; }
            mem_write_byte(BASE32_BUF + base32_len, _base32_encode_char(c6));
            base32_len = base32_len + 1;
        } else {
            if base32_len >= BASE32_BUF_SZ { return 0 - 1; }
            mem_write_byte(BASE32_BUF + base32_len, 61);
            base32_len = base32_len + 1;

            if base32_len >= BASE32_BUF_SZ { return 0 - 1; }
            mem_write_byte(BASE32_BUF + base32_len, 61);
            base32_len = base32_len + 1;
        }

        if i + 4 < len(data) {
            if base32_len >= BASE32_BUF_SZ { return 0 - 1; }
            mem_write_byte(BASE32_BUF + base32_len, _base32_encode_char(c7));
            base32_len = base32_len + 1;
        } else {
            if base32_len >= BASE32_BUF_SZ { return 0 - 1; }
            mem_write_byte(BASE32_BUF + base32_len, 61);
            base32_len = base32_len + 1;
        }

        i = i + 5;
    }

    return base32_len;
}

fn base32_decode(data) {
    base32_clear();

    let mut i = 0;
    while i < len(data) {
        if i + 8 > len(data) { i = len(data); }

        let c0 = _base32_decode_char(str_char_code(data, i));
        let c1 = _base32_decode_char(str_char_code(data, i + 1));
        let c2 = _base32_decode_char(str_char_code(data, i + 2));
        let c3 = _base32_decode_char(str_char_code(data, i + 3));
        let c4 = _base32_decode_char(str_char_code(data, i + 4));
        let c5 = _base32_decode_char(str_char_code(data, i + 5));
        let c6 = _base32_decode_char(str_char_code(data, i + 6));
        let c7 = _base32_decode_char(str_char_code(data, i + 7));

        if c0 >= 0 { if c1 >= 0 {
            let b0 = c0 * 8 + (c1 / 4);
            if base32_len >= BASE32_BUF_SZ { return 0 - 1; }
            mem_write_byte(BASE32_BUF + base32_len, b0);
            base32_len = base32_len + 1;

            if c2 >= 0 { if c3 >= 0 {
                let b1 = (c1 % 4) * 64 + c2 * 2 + (c3 / 16);
                if base32_len >= BASE32_BUF_SZ { return 0 - 1; }
                mem_write_byte(BASE32_BUF + base32_len, b1);
                base32_len = base32_len + 1;

                if c4 >= 0 {
                    let b2 = (c3 % 16) * 16 + (c4 / 2);
                    if base32_len >= BASE32_BUF_SZ { return 0 - 1; }
                    mem_write_byte(BASE32_BUF + base32_len, b2);
                    base32_len = base32_len + 1;

                    if c5 >= 0 { if c6 >= 0 {
                        let b3 = (c4 % 2) * 128 + c5 * 4 + (c6 / 8);
                        if base32_len >= BASE32_BUF_SZ { return 0 - 1; }
                        mem_write_byte(BASE32_BUF + base32_len, b3);
                        base32_len = base32_len + 1;

                        if c7 >= 0 {
                            let b4 = (c6 % 8) * 32 + c7;
                            if base32_len >= BASE32_BUF_SZ { return 0 - 1; }
                            mem_write_byte(BASE32_BUF + base32_len, b4);
                            base32_len = base32_len + 1;
                        }
                    }}
                }
            }}
        }}

        i = i + 8;
    }

    return base32_len;
}

fn base32_get_result() {
    let mut result = "";
    let mut i = 0;
    while i < base32_len {
        result = result + str_from_code(mem_read_byte(BASE32_BUF + i));
        i = i + 1;
    }
    return result;
}

fn base32_selftest() {
    let test_data = "hello";
    let mut n = base32_encode(test_data);
    if n < 0 { return "base32 selftest: encode failed"; }

    let encoded = base32_get_result();
    let expected = "NBSWY3DP";

    if encoded != expected {
        return "base32 selftest: encode mismatch (expected=" + expected + ", got=" + encoded + ")";
    }

    let mut m = base32_decode(encoded);
    if m < 0 { return "base32 selftest: decode failed"; }

    let decoded = base32_get_result();
    if decoded != test_data {
        return "base32 selftest: roundtrip failed";
    }

    return "base32 selftest: pass";
}

print("base32.hl loaded");
