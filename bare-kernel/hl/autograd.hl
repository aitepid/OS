// autograd.hl -- Reverse-mode Automatic Differentiation (Phase 5: ML深化, iter 400)
// Buffer: 0x1C70000
// Computational graph with forward + backward (gradient) passes
// Node types: CONST=0 INPUT=1 ADD=2 MUL=3 RELU=4 TANH=5
// Fixed-point: values scaled by AG_SCALE=256
// Build graph with ag_const/ag_input/ag_add/ag_mul/ag_relu/ag_tanh_node
// ag_forward() → evaluate; ag_backward_from(loss_id) → propagate gradients

let AG_MAXNODES = 32;
let mut AG_SCALE    = 256;

let AG_CONST = 0;
let AG_INPUT = 1;
let AG_ADD   = 2;
let AG_MUL   = 3;
let AG_RELU  = 4;
let AG_TANH  = 5;

let ag_val    = array(32, 0);
let ag_grad   = array(32, 0);
let ag_type   = array(32, 0);
let ag_src0   = array(32, 0);
let ag_src1   = array(32, 0);
let mut ag_n_nodes = 0;

fn ag_init() {
    ag_n_nodes = 0;
    let mut i = 0;
    while i < AG_MAXNODES {
        set_at(ag_val,  i, 0);
        set_at(ag_grad, i, 0);
        set_at(ag_type, i, AG_CONST);
        set_at(ag_src0, i, 0 - 1);
        set_at(ag_src1, i, 0 - 1);
        i += 1;
    }
    return 0;
}

fn _ag_new_node(t, s0, s1) {
    let mut id = ag_n_nodes;
    set_at(ag_type, id, t);
    set_at(ag_src0, id, s0);
    set_at(ag_src1, id, s1);
    ag_n_nodes += 1;
    return id;
}

fn ag_const(val) {
    let mut id = _ag_new_node(AG_CONST, 0 - 1, 0 - 1);
    set_at(ag_val, id, val);
    return id;
}

fn ag_input(val) {
    let mut id = _ag_new_node(AG_INPUT, 0 - 1, 0 - 1);
    set_at(ag_val, id, val);
    return id;
}

fn ag_add(a, b)      { return _ag_new_node(AG_ADD,  a, b); }
fn ag_mul(a, b)      { return _ag_new_node(AG_MUL,  a, b); }
fn ag_relu(a)        { return _ag_new_node(AG_RELU, a, 0 - 1); }
fn ag_tanh_node(a)   { return _ag_new_node(AG_TANH, a, 0 - 1); }

fn _ag_tanh_fp(x) {
    if x > AG_SCALE      { return AG_SCALE; }
    if x < 0 - AG_SCALE  { return 0 - AG_SCALE; }
    return x;
}

fn ag_forward() {
    let mut id = 0;
    while id < ag_n_nodes {
        let mut t = ag_type[id];
        let mut s0 = ag_src0[id];
        let mut s1 = ag_src1[id];
        let mut v = ag_val[id];    // CONST/INPUT: keep pre-set value
        if t == AG_ADD {
            if s0 >= 0 {
                if s1 >= 0 { v = ag_val[s0] + ag_val[s1]; }
            }
        }
        if t == AG_MUL {
            if s0 >= 0 {
                if s1 >= 0 { v = ag_val[s0] * ag_val[s1] / AG_SCALE; }
            }
        }
        if t == AG_RELU {
            if s0 >= 0 {
                v = 0;
                if ag_val[s0] > 0 { v = ag_val[s0]; }
            }
        }
        if t == AG_TANH {
            if s0 >= 0 { v = _ag_tanh_fp(ag_val[s0]); }
        }
        set_at(ag_val, id, v);
        id += 1;
    }
    return ag_n_nodes;
}

fn _ag_backward_step(id) {
    let mut t = ag_type[id];
    let mut g = ag_grad[id];
    let mut s0 = ag_src0[id];
    let mut s1 = ag_src1[id];
    if t == AG_ADD {
        if s0 >= 0 { set_at(ag_grad, s0, ag_grad[s0] + g); }
        if s1 >= 0 { set_at(ag_grad, s1, ag_grad[s1] + g); }
    }
    if t == AG_MUL {
        if s0 >= 0 {
            if s1 >= 0 { set_at(ag_grad, s0, ag_grad[s0] + g * ag_val[s1] / AG_SCALE); }
        }
        if s1 >= 0 {
            if s0 >= 0 { set_at(ag_grad, s1, ag_grad[s1] + g * ag_val[s0] / AG_SCALE); }
        }
    }
    if t == AG_RELU {
        if s0 >= 0 {
            let mut dv = 0;
            if ag_val[id] > 0 { dv = g; }
            set_at(ag_grad, s0, ag_grad[s0] + dv);
        }
    }
    if t == AG_TANH {
        if s0 >= 0 {
            let mut tv = ag_val[id];
            let mut dt = AG_SCALE - tv * tv / AG_SCALE;
            set_at(ag_grad, s0, ag_grad[s0] + g * dt / AG_SCALE);
        }
    }
    return 0;
}

fn ag_backward_from(loss_id) {
    // Zero all gradients, set grad[loss_id]=1.0, backpropagate
    let mut i = 0;
    while i < ag_n_nodes {
        set_at(ag_grad, i, 0);
        i += 1;
    }
    set_at(ag_grad, loss_id, AG_SCALE);
    let mut id = ag_n_nodes;
    while id > 0 {
        id -= 1;
        _ag_backward_step(id);
    }
    return 0;
}

fn ag_get_val(id)   { return ag_val[id]; }
fn ag_get_grad(id)  { return ag_grad[id]; }
fn ag_node_count()  { return ag_n_nodes; }

fn ag_test() {
    ag_init();

    // Build: d = a*b + b  where a=128(=0.5), b=256(=1.0)
    // Forward: c = a*b = 128*256/256 = 128
    //          d = c+b = 128+256 = 384
    let mut na = ag_const(128);   // node 0: a
    let mut nb = ag_const(256);   // node 1: b
    let mut nc = ag_mul(na, nb);  // node 2: c = a*b
    let mut nd = ag_add(nc, nb);  // node 3: d = c+b

    ag_forward();
    let mut vc = ag_get_val(nc);  // 128
    let mut vd = ag_get_val(nd);  // 384

    // Backward from d (grad_d=256=1.0):
    //   ADD d=c+b:  grad_c += 256,  grad_b += 256
    //   MUL c=a*b:  grad_a += 256*256/256=256, grad_b += 256*128/256=128
    //   grad_a = 256, grad_b = 256+128 = 384
    ag_backward_from(nd);
    let mut ga = ag_get_grad(na);  // 256  (∂d/∂a = b/scale = 1.0)
    let mut gb = ag_get_grad(nb);  // 384  (∂d/∂b = a/scale + 1 = 1.5)

    print("ag_test: vc=" + to_string(vc)
          + " vd=" + to_string(vd)
          + " ga=" + to_string(ga)
          + " gb=" + to_string(gb));

    if vc == 128 {
        if vd == 384 {
            if ga == 256 {
                if gb == 384 {
                    print("ag_test: PASS");
                    return 1;
                }
            }
        }
    }
    print("ag_test: FAIL");
    return 0;
}

print("autograd.hl loaded");
