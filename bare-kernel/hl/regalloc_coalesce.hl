// regalloc_coalesce.hl -- Register coalescing (Briggs + George heuristics) (iter 365)
// Buffer: 0x1A40000
// Coalescing merges copy instructions (r_dst = r_src) by unifying their interference nodes
// RC_MAXVARS=32 virtual regs, RC_NREGS=8 physical regs (colors)
// Interference graph: rc_interfere[u*32+v] = 1 if u and v interfere
// Copy hints: rc_copy[u*32+v] = 1 if there is a copy u<->v (coalesce candidate)
// Briggs: merge if result node has < K high-degree neighbors
// George: merge u<-v if every neighbor of v that is high-degree also interferes with u

let RC_MAXVARS = 32;
let RC_NREGS   = 8;    // K colors

let rc_interfere = array(1024, 0);  // 32*32
let rc_copy      = array(1024, 0);  // 32*32 copy hints
let rc_n         = 0;

// Union-Find for coalescing (merge sets)
let rc_parent = array(32, 0);
let rc_rank   = array(32, 0);

// Degree array
let rc_degree = array(32, 0);

// Color assignment result
let rc_color      = array(32, 0);
let rc_coalesced  = array(32, 0);  // vreg -> 1 if coalesced into another
let rc_coalesce_into = array(32, 0);  // vreg -> representative after coalesce
let rc_coalesce_cnt  = 0;

fn regalloc_coal_init() {
    rc_n = 0;
    rc_coalesce_cnt = 0;
    let i = 0;
    while i < RC_MAXVARS {
        set_at(rc_parent,       i, i);
        set_at(rc_rank,         i, 0);
        set_at(rc_degree,       i, 0);
        set_at(rc_color,        i, 0 - 1);
        set_at(rc_coalesced,    i, 0);
        set_at(rc_coalesce_into, i, i);
        i += 1;
    }
    let j = 0;
    while j < 1024 {
        set_at(rc_interfere, j, 0);
        set_at(rc_copy, j, 0);
        j += 1;
    }
    return 0;
}

fn rc_set_n(n) { rc_n = n; return 0; }

fn rc_add_interfere(u, v) {
    if u == v { return 0; }
    set_at(rc_interfere, u * 32 + v, 1);
    set_at(rc_interfere, v * 32 + u, 1);
    return 0;
}

fn rc_add_copy(u, v) {
    set_at(rc_copy, u * 32 + v, 1);
    set_at(rc_copy, v * 32 + u, 1);
    return 0;
}

fn _rc_find(x) {
    let go = 1;
    while go == 1 {
        if rc_parent[x] == x { go = 0; }
        if go == 1 {
            set_at(rc_parent, x, rc_parent[rc_parent[x]]);
            x = rc_parent[x];
        }
    }
    return x;
}

fn _rc_union(x, y) {
    let rx = _rc_find(x);
    let ry = _rc_find(y);
    if rx == ry { return 0; }
    if rc_rank[rx] < rc_rank[ry] {
        let tmp = rx; rx = ry; ry = tmp;
    }
    set_at(rc_parent, ry, rx);
    if rc_rank[rx] == rc_rank[ry] {
        set_at(rc_rank, rx, rc_rank[rx] + 1);
    }
    return 1;
}

fn _rc_compute_degrees() {
    let i = 0;
    while i < rc_n {
        let deg = 0;
        let j = 0;
        while j < rc_n {
            if rc_interfere[i * 32 + j] == 1 { deg += 1; }
            j += 1;
        }
        set_at(rc_degree, i, deg);
        i += 1;
    }
    return 0;
}

fn _rc_briggs_ok(u, v) {
    // Briggs: number of high-degree neighbors (deg >= K) of merged node < K
    let count = 0;
    let i = 0;
    while i < rc_n {
        if i != u {
            if i != v {
                let adj_u = rc_interfere[u * 32 + i];
                let adj_v = rc_interfere[v * 32 + i];
                if adj_u == 1 {
                    if adj_v == 1 {
                        // i interferes with both: check degree
                        if rc_degree[i] >= RC_NREGS { count += 1; }
                    }
                } else {
                    if adj_u == 1 { if rc_degree[i] >= RC_NREGS { count += 1; } }
                    if adj_v == 1 { if rc_degree[i] >= RC_NREGS { count += 1; } }
                }
            }
        }
        i += 1;
    }
    if count < RC_NREGS { return 1; }
    return 0;
}

fn _rc_george_ok(u, v) {
    // George: every high-degree neighbor of v also interferes with u
    let i = 0;
    while i < rc_n {
        if i != u {
            if i != v {
                if rc_interfere[v * 32 + i] == 1 {
                    if rc_degree[i] >= RC_NREGS {
                        if rc_interfere[u * 32 + i] == 0 {
                            return 0;
                        }
                    }
                }
            }
        }
        i += 1;
    }
    return 1;
}

fn rc_run() {
    _rc_compute_degrees();
    rc_coalesce_cnt = 0;
    // Try to coalesce all copy pairs
    let u = 0;
    while u < rc_n {
        let v = u + 1;
        while v < rc_n {
            if rc_copy[u * 32 + v] == 1 {
                if rc_interfere[u * 32 + v] == 0 {
                    // Try Briggs then George
                    if _rc_briggs_ok(u, v) == 1 {
                        if _rc_union(u, v) == 1 {
                            set_at(rc_coalesced, v, 1);
                            set_at(rc_coalesce_into, v, u);
                            rc_coalesce_cnt += 1;
                        }
                    } else {
                        if _rc_george_ok(u, v) == 1 {
                            if _rc_union(u, v) == 1 {
                                set_at(rc_coalesced, v, 1);
                                set_at(rc_coalesce_into, v, u);
                                rc_coalesce_cnt += 1;
                            }
                        }
                    }
                }
            }
            v += 1;
        }
        u += 1;
    }
    // Greedy coloring on coalesced graph
    let i = 0;
    while i < rc_n {
        let rep = _rc_find(i);
        if rc_color[rep] == 0 - 1 {
            let used = array(8, 0);
            let j = 0;
            while j < rc_n {
                if rc_interfere[rep * 32 + j] == 1 {
                    let c = rc_color[_rc_find(j)];
                    if c != 0 - 1 {
                        if c < RC_NREGS { set_at(used, c, 1); }
                    }
                }
                j += 1;
            }
            let col = 0;
            let go = 1;
            while go == 1 {
                if col >= RC_NREGS { go = 0; }
                if go == 1 {
                    if used[col] == 0 { go = 0; }
                    else { col += 1; }
                }
            }
            set_at(rc_color, rep, col);
        }
        set_at(rc_color, i, rc_color[rep]);
        i += 1;
    }
    return rc_coalesce_cnt;
}

fn regalloc_coalesce_test() {
    // 4 vars: r0 interferes r2, r1 interferes r3; copies r0<-r1, r2<-r3
    // r0 and r1 don't interfere -> can coalesce; r2 and r3 don't -> coalesce
    regalloc_coal_init();
    rc_set_n(4);
    rc_add_interfere(0, 2);
    rc_add_interfere(1, 3);
    rc_add_copy(0, 1);
    rc_add_copy(2, 3);
    let cnt = rc_run();
    print("regalloc_coalesce_test: coalesced=" + to_string(cnt) + " color[0]=" + to_string(rc_color[0]) + " color[1]=" + to_string(rc_color[1]));
    if cnt >= 1 {
        print("regalloc_coalesce_test: PASS");
        return 1;
    }
    print("regalloc_coalesce_test: FAIL");
    return 0;
}

fn rc_get_color(vr)     { return rc_color[vr]; }
fn rc_is_coalesced(vr)  { return rc_coalesced[vr]; }
fn rc_coalesce_count()  { return rc_coalesce_cnt; }

print("regalloc_coalesce.hl loaded");
