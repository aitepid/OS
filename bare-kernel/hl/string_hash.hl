// string_hash.hl -- polynomial rolling hash + Rabin-Karp O(n) build O(1) query (iter 325)
// Buffer: 0x17C0000
// Single hash: base=31, mod=100003.

let SH_BASE = 31;
let SH_MOD  = 100003;
let SH_MAX  = 64;

let sh_text  = array(64, 0);
let sh_hash  = array(65, 0);
let sh_pow   = array(65, 0);
let sh_pat   = array(64, 0);
let sh_n     = 0;
let sh_pat_n = 0;
let sh_pat_h = 0;

fn str_hash_init() {
    sh_n     = 0;
    sh_pat_n = 0;
    sh_pat_h = 0;
    let i = 0;
    while i < SH_MAX {
        set_at(sh_text, i, 0);
        set_at(sh_pat,  i, 0);
        i += 1;
    }
    set_at(sh_hash, 0, 0);
    set_at(sh_pow,  0, 1);
    return 0;
}

fn sh_build(n) {
    sh_n = n;
    set_at(sh_hash, 0, 0);
    set_at(sh_pow,  0, 1);
    let i = 0;
    while i < n {
        let pw = sh_pow[i] * SH_BASE;
        set_at(sh_pow, i + 1, pw - (pw / SH_MOD) * SH_MOD);
        let hv = sh_hash[i] * SH_BASE + sh_text[i];
        set_at(sh_hash, i + 1, hv - (hv / SH_MOD) * SH_MOD);
        i += 1;
    }
    return 0;
}

fn sh_query(l, r) {
    let prod = sh_pow[r - l + 1] * sh_hash[l];
    let pmod = prod - (prod / SH_MOD) * SH_MOD;
    let h    = sh_hash[r + 1] - pmod;
    if h < 0 { h = h + SH_MOD; }
    return h;
}

fn sh_set_pat(n) {
    sh_pat_n = n;
    sh_pat_h = 0;
    let i = 0;
    while i < n {
        let hv = sh_pat_h * SH_BASE + sh_pat[i];
        sh_pat_h = hv - (hv / SH_MOD) * SH_MOD;
        i += 1;
    }
    return 0;
}

fn sh_find() {
    if sh_pat_n > sh_n { return 0 - 1; }
    let lim    = sh_n - sh_pat_n;
    let i      = 0;
    let result = -1;
    let done   = 0;
    while done == 0 {
        if i > lim {
            done = 1;
        } else {
            if sh_query(i, i + sh_pat_n - 1) == sh_pat_h {
                result = i;
                done   = 1;
            } else {
                i += 1;
            }
        }
    }
    return result;
}

fn string_hash_test() {
    str_hash_init();
    set_at(sh_text, 0, 1); set_at(sh_text, 1, 2); set_at(sh_text, 2, 3);
    set_at(sh_text, 3, 2); set_at(sh_text, 4, 3); set_at(sh_text, 5, 4);
    sh_build(6);
    set_at(sh_pat, 0, 2); set_at(sh_pat, 1, 3);
    sh_set_pat(2);
    let h12 = sh_query(1, 2);
    let h34 = sh_query(3, 4);
    let pos = sh_find();
    print("string_hash_test: hash(1,2)=" + to_string(h12) +
          " hash(3,4)=" + to_string(h34) +
          " find=" + to_string(pos));
    if h12 == h34 {
        if pos == 1 {
            print("string_hash_test: PASS");
            return 1;
        }
    }
    print("string_hash_test: FAIL");
    return 0;
}

print("string_hash.hl loaded");
