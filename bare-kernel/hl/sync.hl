// sync.hl -- Synchronization Primitives
//
// Provides spinlocks, mutexes, and futex-like wait/wake for SMP.
//
// Spinlock: busy-wait using atomic XCHG (for short critical sections)
// Mutex: sleeping lock using futex (for longer critical sections)
// Futex: fast userspace mutex (like Linux futex)
//
// All primitives use a 64-bit word at a known memory address.
// Value 0 = unlocked, 1 = locked, >1 = locked + waiters.

// === Spinlock ===
// Spin on XCHG until we get 0 (was unlocked)
// Native code: .retry: mov rax, 1; xchg [rdi], rax; test rax,rax; jnz .retry

fn spinlock_init(lock_addr) {
    mem_write_u64(lock_addr, 0);
    return 0;
}

fn spinlock_acquire(lock_addr) {
    // Spin until we read 0, then write 1
    // Native: XCHG [rdi], rax (atomic)
    // Interpreter: non-atomic approximation
    let mut acquired = 0;
    while acquired == 0 {
        let old = mem_read_u64(lock_addr);
        if old == 0 {
            mem_write_u64(lock_addr, 1);
            acquired = 1;
        }
        // PAUSE would go here in native code
    }
    return 0;
}

fn spinlock_release(lock_addr) {
    mem_write_u64(lock_addr, 0);
    return 0;
}

fn spinlock_try(lock_addr) {
    let old = mem_read_u64(lock_addr);
    if old == 0 {
        mem_write_u64(lock_addr, 1);
        return 1;  // acquired
    }
    return 0;  // failed
}

// === Mutex (sleeping lock) ===
// Uses futex-like wait/wake to avoid busy-waiting.
// State: 0=unlocked, 1=locked_no_waiters, 2=locked_with_waiters

fn mutex_init(mutex_addr) {
    mem_write_u64(mutex_addr, 0);
    return 0;
}

fn mutex_lock(mutex_addr) {
    // Fast path: try to acquire (0 -> 1)
    let old = mem_read_u64(mutex_addr);
    if old == 0 {
        mem_write_u64(mutex_addr, 1);
        return 0;
    }
    // Slow path: mark as contended (2) and wait
    mem_write_u64(mutex_addr, 2);
    let mut acquired = 0;
    while acquired == 0 {
        let val = mem_read_u64(mutex_addr);
        if val == 0 {
            mem_write_u64(mutex_addr, 2);
            acquired = 1;
        }
        // In native: futex_wait(mutex_addr, 2)
    }
    return 0;
}

fn mutex_unlock(mutex_addr) {
    let old = mem_read_u64(mutex_addr);
    mem_write_u64(mutex_addr, 0);
    if old == 2 {
        futex_wake(mutex_addr, 1);
    }
    return 0;
}

fn mutex_trylock(mutex_addr) {
    let old = mem_read_u64(mutex_addr);
    if old == 0 {
        mem_write_u64(mutex_addr, 1);
        return 1;
    }
    return 0;
}

// === Futex ===
// Wait: if *addr == expected_val, put current task to sleep
// Wake: wake up to `count` tasks sleeping on addr

let FUTEX_TABLE = 3342336;    // 0x330000
let FUTEX_ENTRY_SIZE = 24;    // addr(8) + pid(8) + next(8)
let MAX_FUTEX_WAITERS = 256;

fn futex_wait(addr, expected_val) {
    let current_val = mem_read_u64(addr);
    if current_val != expected_val {
        return 0;  // value changed, don't sleep
    }
    // In native: disable interrupts, add to wait queue, block, schedule
    // Interpreter: spin-wait approximation
    return 0;
}

fn futex_wake(addr, count) {
    let mut woken = 0;
    let mut i = 0;
    while i < MAX_FUTEX_WAITERS {
        if woken >= count { return woken; }
        let entry = FUTEX_TABLE + i * FUTEX_ENTRY_SIZE;
        let wait_addr = mem_read_u64(entry);
        if wait_addr == addr {
            let pid = mem_read_u64(entry + 8);
            // Set task state to READY (via task table)
            mem_write_u64(entry, 0);  // clear entry
            woken = woken + 1;
        }
        i = i + 1;
    }
    return woken;
}

// === Semaphore (counting) ===
fn sem_init(sem_addr, initial_count) {
    mem_write_u64(sem_addr, initial_count);
    return 0;
}

fn sem_wait(sem_addr) {
    let mut acquired = 0;
    while acquired == 0 {
        let val = mem_read_u64(sem_addr);
        if val > 0 {
            mem_write_u64(sem_addr, val - 1);
            acquired = 1;
        }
        // In native: futex_wait(sem_addr, 0) when val==0
    }
    return 0;
}

fn sem_post(sem_addr) {
    let val = mem_read_u64(sem_addr);
    mem_write_u64(sem_addr, val + 1);
    futex_wake(sem_addr, 1);
    return 0;
}

// === Read-Write Lock ===
// Value: 0=unlocked, positive=reader_count, -1=write-locked
fn rwlock_init(rw_addr) {
    mem_write_u64(rw_addr, 0);
    return 0;
}

fn rwlock_read_lock(rw_addr) {
    let mut acquired = 0;
    while acquired == 0 {
        let val = mem_read_u64(rw_addr);
        if val >= 0 {
            mem_write_u64(rw_addr, val + 1);
            acquired = 1;
        }
    }
    return 0;
}

fn rwlock_read_unlock(rw_addr) {
    let old = mem_read_u64(rw_addr);
    mem_write_u64(rw_addr, old - 1);
    if old == 1 { futex_wake(rw_addr, 1); }
    return 0;
}

fn rwlock_write_lock(rw_addr) {
    let mut acquired = 0;
    while acquired == 0 {
        let val = mem_read_u64(rw_addr);
        if val == 0 {
            mem_write_u64(rw_addr, 0 - 1);
            acquired = 1;
        }
    }
    return 0;
}

fn rwlock_write_unlock(rw_addr) {
    mem_write_u64(rw_addr, 0);
    futex_wake(rw_addr, MAX_FUTEX_WAITERS);
    return 0;
}

print("sync.hl loaded");
print("Primitives: spinlock, mutex, futex, semaphore, rwlock");
