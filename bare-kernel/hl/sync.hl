// sync.hl -- Synchronization Primitives + Futex Wait Queue
//
// Iteration 103: upgraded futex from stub to hash-bucketed wait queue
// with proper enqueue/dequeue, timeout support, and requeue.
//
// Design:
//   Futex wait queue: 16 hash buckets, each a linked list of waiters
//   futex_wait: atomically check value, enqueue current task, block
//   futex_wake: dequeue up to N waiters from bucket, mark READY
//   futex_wait_timeout: same as wait but with tick deadline
//   futex_requeue: move waiters from one address to another (for condvar)
//
// All higher-level primitives (mutex, semaphore, rwlock) use futex.
//
// Public API (preserved + new):
//   spinlock_init/acquire/release/try
//   mutex_init/lock/unlock/trylock
//   futex_wait/wake (upgraded)
//   futex_wait_timeout / futex_requeue (new)
//   sem_init/wait/post
//   rwlock_init/read_lock/read_unlock/write_lock/write_unlock
//   sync_status (new)

// === Spinlock ===

fn spinlock_init(lock_addr) {
    mem_write_u64(lock_addr, 0);
    return 0;
}

fn spinlock_acquire(lock_addr) {
    let mut acquired = 0;
    while acquired == 0 {
        let old = mem_read_u64(lock_addr);
        if old == 0 {
            mem_write_u64(lock_addr, 1);
            acquired = 1;
        }
    }
    return 0;
}

fn spinlock_release(lock_addr) {
    mem_write_u64(lock_addr, 0);
    return 0;
}

fn spinlock_try(lock_addr) {
    let old = mem_read_u64(lock_addr);
    if old == 0 {
        mem_write_u64(lock_addr, 1);
        return 1;
    }
    return 0;
}

// ============================================================
// Futex: hash-bucketed wait queue
// ============================================================

let _FQ_BUCKETS = 16;
let _FQ_MAX_WAITERS = 256;

// Waiter table: flat array [addr, task_id, next_idx, timeout_tick, state]
// state: 0=free, 1=waiting, 2=woken
let _FQ_ENTRY_SIZE = 5;
let mut _fq_entries = [];
let mut _fq_bucket_head = [];  // head index per bucket (-1 = empty)
let mut _fq_ready = 0;
let mut _fq_total_waits = 0;
let mut _fq_total_wakes = 0;

fn _fq_init() {
    _fq_entries = [];
    _fq_bucket_head = [];
    let mut b = 0;
    while b < _FQ_BUCKETS {
        push(_fq_bucket_head, 0 - 1);
        b = b + 1;
    }
    let mut i = 0;
    while i < _FQ_MAX_WAITERS {
        push(_fq_entries, 0);   // addr
        push(_fq_entries, 0);   // task_id
        push(_fq_entries, 0 - 1); // next_idx
        push(_fq_entries, 0);   // timeout_tick
        push(_fq_entries, 0);   // state (0=free)
        i = i + 1;
    }
    _fq_total_waits = 0;
    _fq_total_wakes = 0;
    _fq_ready = 1;
    return 0;
}

fn _fq_hash(addr) {
    return (addr / 8) % _FQ_BUCKETS;
}

fn _fq_alloc_entry() {
    let mut i = 0;
    while i < _FQ_MAX_WAITERS {
        let base = i * _FQ_ENTRY_SIZE;
        if _fq_entries[base + 4] == 0 { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

fn _fq_enqueue(addr, task_id, timeout_tick) {
    let slot = _fq_alloc_entry();
    if slot < 0 { return 0 - 1; }
    let base = slot * _FQ_ENTRY_SIZE;
    set_at(_fq_entries, base, addr);
    set_at(_fq_entries, base + 1, task_id);
    set_at(_fq_entries, base + 3, timeout_tick);
    set_at(_fq_entries, base + 4, 1);  // waiting

    // Prepend to bucket
    let bucket = _fq_hash(addr);
    set_at(_fq_entries, base + 2, _fq_bucket_head[bucket]);
    set_at(_fq_bucket_head, bucket, slot);
    _fq_total_waits = _fq_total_waits + 1;
    return slot;
}

fn _fq_dequeue_one(addr) {
    let bucket = _fq_hash(addr);
    let mut prev = 0 - 1;
    let mut cur = _fq_bucket_head[bucket];
    while cur >= 0 {
        let base = cur * _FQ_ENTRY_SIZE;
        let next = _fq_entries[base + 2];
        if _fq_entries[base] == addr {
            if _fq_entries[base + 4] == 1 {
                // Remove from list
                if prev < 0 {
                    set_at(_fq_bucket_head, bucket, next);
                } else {
                    set_at(_fq_entries, prev * _FQ_ENTRY_SIZE + 2, next);
                }
                let task_id = _fq_entries[base + 1];
                set_at(_fq_entries, base + 4, 0);  // free
                _fq_total_wakes = _fq_total_wakes + 1;
                return task_id;
            }
        }
        prev = cur;
        cur = next;
    }
    return 0 - 1;
}

// ============================================================
// Public futex API
// ============================================================

fn futex_wait(addr, expected_val) {
    if _fq_ready == 0 { _fq_init(); }
    let current_val = mem_read_u64(addr);
    if current_val != expected_val { return 0; }
    let task_id = current_task;
    _fq_enqueue(addr, task_id, 0);
    // In native: set task state to BLOCKED, call schedule()
    // Interpreter: spin until woken
    let slot = _fq_total_waits - 1;
    let mut spin = 0;
    while spin < 100000 {
        // Check if we've been woken (entry freed)
        let found = 0;
        let bucket = _fq_hash(addr);
        let mut c = _fq_bucket_head[bucket];
        let mut still_waiting = 0;
        while c >= 0 {
            let b = c * _FQ_ENTRY_SIZE;
            if _fq_entries[b + 1] == task_id {
                if _fq_entries[b + 4] == 1 { still_waiting = 1; }
            }
            c = _fq_entries[b + 2];
        }
        if still_waiting == 0 { return 0; }
        spin = spin + 1;
    }
    return 0;
}

fn futex_wake(addr, count) {
    if _fq_ready == 0 { _fq_init(); }
    let mut woken = 0;
    while woken < count {
        let task_id = _fq_dequeue_one(addr);
        if task_id < 0 { return woken; }
        // In native: set task state to READY
        woken = woken + 1;
    }
    return woken;
}

fn futex_wait_timeout(addr, expected_val, timeout_ticks) {
    if _fq_ready == 0 { _fq_init(); }
    let current_val = mem_read_u64(addr);
    if current_val != expected_val { return 0; }
    let task_id = current_task;
    let deadline = timeout_ticks;
    _fq_enqueue(addr, task_id, deadline);
    // Spin with timeout
    let mut spin = 0;
    while spin < timeout_ticks {
        let bucket = _fq_hash(addr);
        let mut c = _fq_bucket_head[bucket];
        let mut still_waiting = 0;
        while c >= 0 {
            let b = c * _FQ_ENTRY_SIZE;
            if _fq_entries[b + 1] == task_id {
                if _fq_entries[b + 4] == 1 { still_waiting = 1; }
            }
            c = _fq_entries[b + 2];
        }
        if still_waiting == 0 { return 0; }
        spin = spin + 1;
    }
    // Timeout: remove ourselves from queue
    let bucket = _fq_hash(addr);
    let mut prev = 0 - 1;
    let mut cur = _fq_bucket_head[bucket];
    while cur >= 0 {
        let base = cur * _FQ_ENTRY_SIZE;
        let next = _fq_entries[base + 2];
        if _fq_entries[base + 1] == task_id {
            if _fq_entries[base + 4] == 1 {
                if prev < 0 { set_at(_fq_bucket_head, bucket, next); }
                else { set_at(_fq_entries, prev * _FQ_ENTRY_SIZE + 2, next); }
                set_at(_fq_entries, base + 4, 0);
            }
        }
        prev = cur;
        cur = next;
    }
    return 0 - 1; // timeout
}

// Requeue: move up to `count` waiters from addr1 to addr2
fn futex_requeue(addr1, addr2, count) {
    if _fq_ready == 0 { _fq_init(); }
    let mut moved = 0;
    while moved < count {
        let task_id = _fq_dequeue_one(addr1);
        if task_id < 0 { return moved; }
        _fq_enqueue(addr2, task_id, 0);
        moved = moved + 1;
    }
    return moved;
}

// ============================================================
// Mutex (sleeping lock using futex)
// ============================================================

fn mutex_init(mutex_addr) {
    mem_write_u64(mutex_addr, 0);
    return 0;
}

fn mutex_lock(mutex_addr) {
    let old = mem_read_u64(mutex_addr);
    if old == 0 {
        mem_write_u64(mutex_addr, 1);
        return 0;
    }
    mem_write_u64(mutex_addr, 2);
    let mut acquired = 0;
    while acquired == 0 {
        futex_wait(mutex_addr, 2);
        let val = mem_read_u64(mutex_addr);
        if val == 0 {
            mem_write_u64(mutex_addr, 2);
            acquired = 1;
        }
    }
    return 0;
}

fn mutex_unlock(mutex_addr) {
    let old = mem_read_u64(mutex_addr);
    mem_write_u64(mutex_addr, 0);
    if old == 2 {
        futex_wake(mutex_addr, 1);
    }
    return 0;
}

fn mutex_trylock(mutex_addr) {
    let old = mem_read_u64(mutex_addr);
    if old == 0 {
        mem_write_u64(mutex_addr, 1);
        return 1;
    }
    return 0;
}

// ============================================================
// Semaphore (counting, using futex)
// ============================================================

fn sem_init(sem_addr, initial_count) {
    mem_write_u64(sem_addr, initial_count);
    return 0;
}

fn sem_wait(sem_addr) {
    let mut acquired = 0;
    while acquired == 0 {
        let val = mem_read_u64(sem_addr);
        if val > 0 {
            mem_write_u64(sem_addr, val - 1);
            acquired = 1;
        } else {
            futex_wait(sem_addr, 0);
        }
    }
    return 0;
}

fn sem_post(sem_addr) {
    let val = mem_read_u64(sem_addr);
    mem_write_u64(sem_addr, val + 1);
    futex_wake(sem_addr, 1);
    return 0;
}

// ============================================================
// Read-Write Lock (using futex)
// ============================================================

fn rwlock_init(rw_addr) {
    mem_write_u64(rw_addr, 0);
    return 0;
}

fn rwlock_read_lock(rw_addr) {
    let mut acquired = 0;
    while acquired == 0 {
        let val = mem_read_u64(rw_addr);
        if val >= 0 {
            mem_write_u64(rw_addr, val + 1);
            acquired = 1;
        } else {
            futex_wait(rw_addr, val);
        }
    }
    return 0;
}

fn rwlock_read_unlock(rw_addr) {
    let old = mem_read_u64(rw_addr);
    mem_write_u64(rw_addr, old - 1);
    if old == 1 { futex_wake(rw_addr, 1); }
    return 0;
}

fn rwlock_write_lock(rw_addr) {
    let mut acquired = 0;
    while acquired == 0 {
        let val = mem_read_u64(rw_addr);
        if val == 0 {
            mem_write_u64(rw_addr, 0 - 1);
            acquired = 1;
        } else {
            futex_wait(rw_addr, val);
        }
    }
    return 0;
}

fn rwlock_write_unlock(rw_addr) {
    mem_write_u64(rw_addr, 0);
    futex_wake(rw_addr, _FQ_MAX_WAITERS);
    return 0;
}

fn sync_status() {
    return "sync: " + to_string(_fq_total_waits) + " waits, " + to_string(_fq_total_wakes) + " wakes, " + to_string(_FQ_BUCKETS) + " buckets";
}

print("sync.hl loaded (futex wait queue)");
print("Futex: " + to_string(_FQ_BUCKETS) + " hash buckets, " + to_string(_FQ_MAX_WAITERS) + " max waiters");
print("Primitives: spinlock, mutex, futex, semaphore, rwlock");
