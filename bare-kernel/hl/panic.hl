// panic.hl -- Kernel Panic Handler
//
// Called on unrecoverable errors. Prints diagnostic info,
// dumps registers, and halts all CPUs.

let mut panic_happened = 0;

fn kernel_panic(message) {
    if panic_happened == 1 {
        // Double panic -- just halt
        // cli; hlt
        return 0;
    }
    panic_happened = 1;

    // Disable interrupts
    // cli

    // Print panic banner via serial (always available)
    print("");
    print("!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!");
    print("!!! KERNEL PANIC: " + message);
    print("!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!");

    // Dump registers
    // print("RAX=" + hex(rax) + " RBX=" + hex(rbx) + ...);
    // print("RIP=" + hex(rip) + " RSP=" + hex(rsp));
    // print("CR2=" + hex(cr2) + " CR3=" + hex(cr3));

    // Dump stack trace (walk RBP chain)
    // print("Stack trace:");
    // let mut rbp = current_rbp;
    // let mut depth = 0;
    // while rbp != 0 && depth < 16 {
    //     let ret_addr = mem_read_u64(rbp + 8);
    //     print("  #" + to_string(depth) + " " + hex(ret_addr));
    //     rbp = mem_read_u64(rbp);
    //     depth = depth + 1;
    // }

    // Print uptime
    print("Uptime: " + to_string(get_ticks() / 100) + " seconds");
    print("Current task: " + to_string(current_task));

    // Write to VGA in red
    vga_set_color(15, 4); // white on red
    vga_clear();
    vga_println("KERNEL PANIC: " + message);
    vga_println("System halted.");

    // Halt all APs via NMI broadcast
    lapic_send_ipi(255, 2); // NMI to all CPUs

    // BSP halt loop (in native: cli; .halt: hlt; jmp .halt)
    return 0;
}

// Assertion: panic if condition is false
fn kassert(condition, message) {
    if condition == 0 {
        kernel_panic("ASSERT FAILED: " + message);
    }
    return 0;
}

// Out of memory panic
fn oom_panic() {
    kernel_panic("OUT OF MEMORY");
}

print("panic.hl loaded");
print("Panic: serial dump + VGA + halt all CPUs");
