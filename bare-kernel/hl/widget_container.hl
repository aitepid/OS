// widget_container.hl -- Layout containers: groupbox, tabs, scroll, split, sidebar
//
// Sprint G4 of HicOS GUI injection (per GUI_DESIGN.md §3.5).
//
// Containers do not render their own content — they paint a frame /
// chrome / divider and rely on child widgets being positioned within
// their interior rectangle. The adaptive_layout module supplies grid
// column counts and spacing for responsive composition.

fn groupbox_new(parent, x, y, w, h, title_addr) {
    let mut id = widget_new(WIDGET_KIND_GROUPBOX, parent, x, y, w, h);
    widget_set_label(id, title_addr);
    return id;
}

fn groupbox_paint(id) {
    if widget_get_flag(id, WIDGET_FLAG_VISIBLE) == 0 { return 0; }
    gfx_rect_round(widget_x[id], widget_y[id], widget_w[id], widget_h[id], 8,
                   ui_theme_bg_surface());
    if widget_label[id] != 0 {
        let mut size = al_density_font_body();
        font_atlas_draw_str(widget_x[id] + 12, widget_y[id] + 8,
                            cstr_from_addr(widget_label[id]), size,
                            ui_theme_text_primary());
    }
    widget_set_flag(id, WIDGET_FLAG_DIRTY, 0);
    return 0;
}

// ─── Tabs ───────────────────────────────────────────────────────────────────
// tab_count stored in widget_value, selected index in widget_extra.
// Title strings are looked up via a callback widget_label[id] -> address
// of an array of cstrings; we keep it simple and limit to ~8 tabs.

fn tabs_new(parent, x, y, w, h, count, initial) {
    let mut id = widget_new(WIDGET_KIND_TABS, parent, x, y, w, h);
    widget_set_value(id, count);
    widget_set_extra(id, initial);
    return id;
}

fn tabs_paint(id) {
    if widget_get_flag(id, WIDGET_FLAG_VISIBLE) == 0 { return 0; }
    let mut n   = widget_value[id];
    let mut sel = widget_extra[id];
    if n <= 0 { return 0; }
    let mut tab_w = widget_w[id] / n;
    // Background bar
    gfx_fill_rect(widget_x[id], widget_y[id] + 32, widget_w[id], 1,
                  ui_theme_bg_overlay());
    let mut i = 0;
    while i < n {
        let mut tx = widget_x[id] + i * tab_w;
        let mut ty = widget_y[id];
        if i == sel {
            // Accent underline
            gfx_fill_rect(tx, ty + 31, tab_w, 2, ui_theme_accent_get());
        }
        i = i + 1;
    }
    widget_set_flag(id, WIDGET_FLAG_DIRTY, 0);
    return 0;
}

fn tabs_handle_pointer(id, ev_type, x, y) {
    if widget_hit(id, x, y) == 0 { return 0; }
    if ev_type == PEV_TYPE_UP {
        let mut n = widget_value[id];
        if n <= 0 { return 0; }
        let mut tab_w = widget_w[id] / n;
        let mut idx = (x - widget_x[id]) / tab_w;
        if idx < 0 { idx = 0; }
        if idx >= n { idx = n - 1; }
        widget_set_extra(id, idx);
        return 1;
    }
    return 0;
}

// ─── ScrollView ─────────────────────────────────────────────────────────────
// widget_value = scroll_y (px). widget_extra = content_height (px).

fn scrollview_new(parent, x, y, w, h, content_h) {
    let mut id = widget_new(WIDGET_KIND_SCROLLVIEW, parent, x, y, w, h);
    widget_set_value(id, 0);
    widget_set_extra(id, content_h);
    return id;
}

fn scrollview_paint(id) {
    if widget_get_flag(id, WIDGET_FLAG_VISIBLE) == 0 { return 0; }
    let mut content_h = widget_extra[id];
    if content_h <= widget_h[id] { return 0; }
    // Thumb on right edge
    let mut track_x = widget_x[id] + widget_w[id] - 6;
    gfx_fill_rect(track_x, widget_y[id], 4, widget_h[id], ui_theme_bg_overlay());
    let mut thumb_h = widget_h[id] * widget_h[id] / content_h;
    if thumb_h < 24 { thumb_h = 24; }
    let mut thumb_y = widget_y[id] + widget_value[id] * (widget_h[id] - thumb_h) / (content_h - widget_h[id]);
    gfx_rect_round(track_x, thumb_y, 4, thumb_h, 2, ui_theme_text_secondary());
    widget_set_flag(id, WIDGET_FLAG_DIRTY, 0);
    return 0;
}

fn scrollview_scroll_by(id, dy) {
    let mut content_h = widget_extra[id];
    let mut max_scroll = content_h - widget_h[id];
    if max_scroll < 0 { max_scroll = 0; }
    let mut v = widget_value[id] + dy;
    if v < 0          { v = 0; }
    if v > max_scroll { v = max_scroll; }
    widget_set_value(id, v);
    return 0;
}

// ─── SplitView ──────────────────────────────────────────────────────────────
// Two-pane horizontal split; widget_value = sidebar width.

fn splitview_new(parent, x, y, w, h, initial_sidebar_w) {
    let mut id = widget_new(WIDGET_KIND_SPLITVIEW, parent, x, y, w, h);
    widget_set_value(id, initial_sidebar_w);
    return id;
}

fn splitview_paint(id) {
    if widget_get_flag(id, WIDGET_FLAG_VISIBLE) == 0 { return 0; }
    let mut sw = widget_value[id];
    // Sidebar background
    gfx_fill_rect(widget_x[id], widget_y[id], sw, widget_h[id], ui_theme_bg_surface());
    // Divider
    gfx_fill_rect(widget_x[id] + sw, widget_y[id], 1, widget_h[id], ui_theme_bg_overlay());
    widget_set_flag(id, WIDGET_FLAG_DIRTY, 0);
    return 0;
}

// ─── Sidebar ────────────────────────────────────────────────────────────────
// Collapsible nav rail. widget_value = item count, widget_extra = selected index.

fn sidebar_new(parent, x, y, w, h, item_count) {
    let mut id = widget_new(WIDGET_KIND_SIDEBAR, parent, x, y, w, h);
    widget_set_value(id, item_count);
    widget_set_extra(id, 0);
    return id;
}

fn sidebar_paint(id) {
    if widget_get_flag(id, WIDGET_FLAG_VISIBLE) == 0 { return 0; }
    gfx_fill_rect(widget_x[id], widget_y[id], widget_w[id], widget_h[id],
                  ui_theme_bg_surface());
    let mut n   = widget_value[id];
    let mut sel = widget_extra[id];
    if sel >= 0 {
        if sel < n {
            let mut row_h = al_density_control();
            gfx_rect_round(widget_x[id] + 4, widget_y[id] + sel * row_h + 2,
                           widget_w[id] - 8, row_h - 4, 6,
                           ui_theme_bg_overlay());
            // Selection indicator: 3 px accent bar on left.
            gfx_fill_rect(widget_x[id] + 4, widget_y[id] + sel * row_h + 8,
                          3, row_h - 16, ui_theme_accent_get());
        }
    }
    widget_set_flag(id, WIDGET_FLAG_DIRTY, 0);
    return 0;
}

print("widget_container.hl loaded");
