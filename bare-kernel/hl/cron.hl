// cron.hl -- Kernel Periodic Task Scheduler
//
// Iteration 161: Cron-style periodic and one-shot job scheduler.
//
// Design:
//   Up to CRON_MAX (16) jobs.
//   Each job: command string + interval (in ticks) + repeat flag + last_fire tick.
//   cron_tick() is called from the main loop (each timer interrupt).
//   When a job is due, it fires by calling shell_handle(cmd).
//   One-shot jobs are automatically removed after firing.
//
// Time resolution: kernel ticks (100 Hz → 10ms per tick).
//   interval_ticks = seconds * 100.
//
// Public API:
//   cron_init()
//   cron_add(cmd, interval_ticks, repeat)  → job_id  (0=one-shot, 1=repeat)
//   cron_remove(job_id)
//   cron_enable(job_id) / cron_disable(job_id)
//   cron_tick()           — call from main loop
//   cron_list()           → status string
//   cron_status(job_id)   → single job status string
//   cron_reset(job_id)    — reset next-fire time to now+interval
//
// Shell integration:
//   cron                         → list all jobs
//   cron add <secs> <cmd>        → add repeating job every N seconds
//   cron once <secs> <cmd>       → one-shot job after N seconds
//   cron rm <id>                 → remove job
//   cron en <id> / cron dis <id> → enable / disable

let CRON_MAX = 16;

// Job state arrays
let mut cron_active   = [];   // 1 = slot occupied
let mut cron_enabled  = [];   // 1 = will fire when due
let mut cron_repeat   = [];   // 1 = repeat, 0 = one-shot
let mut cron_interval = [];   // ticks between firings
let mut cron_next     = [];   // tick count of next fire
let mut cron_cmd      = [];   // command string to execute
let mut cron_fire_cnt = [];   // number of times fired
let mut cron_count    = 0;    // active job count

fn cron_init() {
    cron_active   = [];
    cron_enabled  = [];
    cron_repeat   = [];
    cron_interval = [];
    cron_next     = [];
    cron_cmd      = [];
    cron_fire_cnt = [];
    cron_count    = 0;
    let mut i = 0;
    while i < CRON_MAX {
        push(cron_active,   0);
        push(cron_enabled,  0);
        push(cron_repeat,   0);
        push(cron_interval, 0);
        push(cron_next,     0);
        push(cron_cmd,      "");
        push(cron_fire_cnt, 0);
        i = i + 1;
    }
    print("cron: init — max " + to_string(CRON_MAX) + " jobs");
    return 0;
}

fn _cron_alloc() {
    let mut i = 0;
    while i < CRON_MAX {
        if cron_active[i] == 0 { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

// ============================================================
// Job management
// ============================================================

// Add a job. interval_ticks = interval in 10ms ticks.
// repeat: 1=periodic, 0=one-shot
fn cron_add(cmd, interval_ticks, repeat) {
    let mut id = _cron_alloc();
    if id < 0 { print("cron: job table full"); return 0 - 1; }
    let mut now = get_ticks();
    set_at(cron_active,   id, 1);
    set_at(cron_enabled,  id, 1);
    set_at(cron_repeat,   id, repeat);
    set_at(cron_interval, id, interval_ticks);
    set_at(cron_next,     id, now + interval_ticks);
    set_at(cron_cmd,      id, cmd);
    set_at(cron_fire_cnt, id, 0);
    cron_count = cron_count + 1;
    print("cron[" + to_string(id) + "]: added cmd=\"" + cmd + "\" interval=" + to_string(interval_ticks)
        + " ticks repeat=" + to_string(repeat));
    return id;
}

// Convenience: seconds-based wrappers
fn cron_add_secs(cmd, secs, repeat) {
    return cron_add(cmd, secs * 100, repeat);
}

fn cron_remove(id) {
    if id < 0 { return 0 - 1; }
    if id >= CRON_MAX { return 0 - 1; }
    if cron_active[id] == 0 { return 0 - 1; }
    set_at(cron_active, id, 0);
    cron_count = cron_count - 1;
    print("cron[" + to_string(id) + "]: removed");
    return 0;
}

fn cron_enable(id) {
    if id < 0 { return 0 - 1; }
    if id >= CRON_MAX { return 0 - 1; }
    set_at(cron_enabled, id, 1);
    return 0;
}

fn cron_disable(id) {
    if id < 0 { return 0 - 1; }
    if id >= CRON_MAX { return 0 - 1; }
    set_at(cron_enabled, id, 0);
    return 0;
}

fn cron_reset(id) {
    if id < 0 { return 0 - 1; }
    set_at(cron_next, id, get_ticks() + cron_interval[id]);
    return 0;
}

// ============================================================
// Tick dispatcher
// ============================================================

fn cron_tick() {
    if cron_count == 0 { return 0; }
    let mut now = get_ticks();
    let mut i = 0;
    while i < CRON_MAX {
        if cron_active[i] == 1 {
            if cron_enabled[i] == 1 {
                if now >= cron_next[i] {
                    // Fire the job
                    set_at(cron_fire_cnt, i, cron_fire_cnt[i] + 1);
                    klog(1, "cron", "firing job " + to_string(i) + ": " + cron_cmd[i]);
                    shell_handle(cron_cmd[i]);
                    if cron_repeat[i] == 1 {
                        // Schedule next firing
                        set_at(cron_next, i, now + cron_interval[i]);
                    } else {
                        // One-shot: auto-remove
                        set_at(cron_active, i, 0);
                        cron_count = cron_count - 1;
                    }
                }
            }
        }
        i = i + 1;
    }
    return 0;
}

// ============================================================
// Status
// ============================================================

fn cron_status(id) {
    if id < 0 { return "cron: invalid id"; }
    if id >= CRON_MAX { return "cron: invalid id"; }
    if cron_active[id] == 0 { return "cron[" + to_string(id) + "] free"; }
    let mut now = get_ticks();
    let mut due_in = cron_next[id] - now;
    let mut en_s = "dis";
    if cron_enabled[id] == 1 { en_s = "ena"; }
    let mut rep_s = "once";
    if cron_repeat[id] == 1 { rep_s = "rep"; }
    return "cron[" + to_string(id) + "] " + en_s + " " + rep_s
        + " cmd=\"" + cron_cmd[id] + "\""
        + " every=" + to_string(cron_interval[id] / 100) + "s"
        + " due_in=" + to_string(due_in / 100) + "s"
        + " fired=" + to_string(cron_fire_cnt[id]);
}

fn cron_list() {
    let mut out = "Cron jobs (" + to_string(cron_count) + "/" + to_string(CRON_MAX) + "):\n";
    let mut i = 0;
    while i < CRON_MAX {
        if cron_active[i] == 1 {
            out = out + "  " + cron_status(i) + "\n";
        }
        i = i + 1;
    }
    if cron_count == 0 { out = out + "  (no jobs)\n"; }
    return out;
}

// ============================================================
// Built-in system cron jobs (registered at kernel init)
// ============================================================

fn cron_setup_system_jobs() {
    // Update desktop clock every 30 seconds
    cron_add_secs("date", 30, 1);
    // Flush syslog every 60 seconds
    cron_add_secs("dmesg", 60, 1);
    // WebSocket heartbeat ping every 120 seconds (if any open connections)
    cron_add_secs("ws tick", 120, 1);
    // Telnet session maintenance every 60 seconds
    cron_add_secs("telnet tick", 60, 1);
    print("cron: system jobs registered (4 jobs)");
    return 0;
}

print("cron.hl loaded");
print("Cron: " + to_string(CRON_MAX) + " slots, 100Hz tick, repeat+one-shot, shell_handle dispatch");
