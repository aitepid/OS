// ext4.hl -- ext4 Filesystem Driver (Read-Only)
//
// ext4 is the default Linux filesystem. It extends ext2/ext3 with:
//   - Extents (replacing indirect block lists)
//   - 48-bit block addresses (up to 1 EB volumes)
//   - Journal (jbd2) for crash recovery
//   - Directory hash tree (htree) for fast lookup
//   - Inline data for small files
//
// Superblock at byte 1024 (same as ext2):
//   +0:  s_inodes_count (4)
//   +4:  s_blocks_count_lo (4)
//   +24: s_log_block_size (4) -- block_size = 1024 << value
//   +40: s_inodes_per_group (4)
//   +56: s_magic (2) = 0xEF53 (same as ext2)
//   +88: s_inode_size (2) -- typically 256 for ext4
//   +92: s_feature_compat (4)
//   +96: s_feature_incompat (4) -- bit 6 = extents, bit 9 = 64bit
//   +100: s_feature_ro_compat (4)
//   +352: s_blocks_count_hi (4) -- upper 32 bits
//
// ext4 Extent Tree (in inode i_block[0..3]):
//   Extent header (12 bytes):
//     +0: eh_magic (2) = 0xF30A
//     +2: eh_entries (2)
//     +4: eh_max (2)
//     +6: eh_depth (2) -- 0=leaf
//     +8: eh_generation (4)
//   Leaf extent (12 bytes):
//     +0: ee_block (4) -- first file block
//     +4: ee_len (2) -- number of blocks
//     +6: ee_start_hi (2)
//     +8: ee_start_lo (4)

let EXT4_MAGIC = 61267;            // 0xEF53
let EXT4_EXTENT_MAGIC = 62218;     // 0xF30A
let EXT4_FEAT_EXTENTS = 64;        // bit 6 of feature_incompat
let EXT4_ROOT_INODE = 2;

// Fixed scratch buffers (physically available at boot)
let EXT4_SB_BUF    = 9633792;  // 0x930000 superblock (2 sectors)
let EXT4_BGDT_BUF  = 9641984;  // 0x932000 BGDT (8 sectors = 4096 bytes)
let EXT4_INODE_BUF = 9650176;  // 0x934000 inode sector (1 sector)
let EXT4_BLOCK_BUF = 9666560;  // 0x938000 dir/file data (up to 16 sectors)

let mut ext4_block_size = 4096;
let mut ext4_inode_size = 256;
let mut ext4_inodes_per_group = 8192;
let mut ext4_has_extents = 0;
let mut ext4_is_64bit = 0;
let mut ext4_ahci_port = 0;
let mut ext4_ready = 0;

// Read a null-terminated or length-limited string from physical memory
fn ext4_read_str(addr, length) {
    let mut s = "";
    let mut i = 0;
    while i < length {
        let mut c = mem_read_u8(addr + i);
        if c != 0 {
            s = s + str_from_code(c);
        }
        i = i + 1;
    }
    return s;
}

fn ext4_init(ahci_port) {
    ext4_ahci_port = ahci_port;
    ext4_ready = 0;

    // Superblock is at byte offset 1024 on disk = LBA 2 (512-byte sectors)
    let ok = ahci_read(ahci_port, 2, 2, EXT4_SB_BUF);
    if ok == 0 {
        print("ext4: superblock read failed");
        return 0;
    }

    let magic = mem_read_u16(EXT4_SB_BUF + 56);
    if magic != EXT4_MAGIC {
        print("ext4: bad superblock magic 0x" + format_hex(magic, 4));
        return 0;
    }

    // block_size = 1024 << log_block_size
    let log_bs = mem_read_u32(EXT4_SB_BUF + 24);
    let mut bsz = 1024;
    let mut sh = log_bs;
    while sh > 0 {
        bsz = bsz * 2;
        sh = sh - 1;
    }
    ext4_block_size = bsz;

    ext4_inodes_per_group = mem_read_u32(EXT4_SB_BUF + 40);
    ext4_inode_size = mem_read_u16(EXT4_SB_BUF + 88);
    if ext4_inode_size < 128 { ext4_inode_size = 128; }

    let incompat = mem_read_u32(EXT4_SB_BUF + 96);
    ext4_has_extents = (incompat / 64) % 2;   // bit 6
    ext4_is_64bit    = (incompat / 512) % 2;  // bit 9

    ext4_ready = 1;
    print("ext4: block_size=" + to_string(ext4_block_size) +
          " inode_size=" + to_string(ext4_inode_size) +
          " ipg=" + to_string(ext4_inodes_per_group));
    print("ext4: extents=" + to_string(ext4_has_extents) +
          " 64bit=" + to_string(ext4_is_64bit));
    return 1;
}

// Read inode into EXT4_INODE_BUF.
// Returns address inside buffer on success, 0 on failure.
fn ext4_read_inode(inode_num) {
    if ext4_ready == 0 { return 0; }
    if inode_num < 1 { return 0; }

    let group = (inode_num - 1) / ext4_inodes_per_group;
    let idx   = (inode_num - 1) % ext4_inodes_per_group;

    // BGDT is at block 1 for block_size >= 2048, block 2 for 1024
    let mut bgdt_block = 1;
    if ext4_block_size == 1024 { bgdt_block = 2; }
    let bgdt_lba = bgdt_block * (ext4_block_size / 512);

    // Each BGDT entry: 32 bytes (non-64-bit) or 64 bytes (64-bit)
    let mut bgdt_entry_sz = 32;
    if ext4_is_64bit == 1 { bgdt_entry_sz = 64; }

    // Read enough of BGDT (8 sectors covers 4096 bytes = 128 groups)
    let ok_bgdt = ahci_read(ext4_ahci_port, bgdt_lba, 8, EXT4_BGDT_BUF);
    if ok_bgdt == 0 { return 0; }

    // inode_table_block from group descriptor at offset +8
    let bgdt_off = group * bgdt_entry_sz;
    let inode_table_block = mem_read_u32(EXT4_BGDT_BUF + bgdt_off + 8);

    // Byte position of this inode within the inode table
    let inode_byte = idx * ext4_inode_size;

    // Which LBA and intra-sector offset contains this inode
    let secs_per_block = ext4_block_size / 512;
    let inode_lba = inode_table_block * secs_per_block + inode_byte / 512;
    let inode_sec_off = inode_byte % 512;

    let ok_in = ahci_read(ext4_ahci_port, inode_lba, 1, EXT4_INODE_BUF);
    if ok_in == 0 { return 0; }

    return EXT4_INODE_BUF + inode_sec_off;
}

// Parse leaf extent tree from inode address.
// Returns array of [file_block, blk_count, disk_block] triples.
fn ext4_parse_extents(inode_addr) {
    let mut extents = [];
    if inode_addr == 0 { return extents; }

    // i_block (extent tree) starts at inode byte 40
    let eh_magic = mem_read_u16(inode_addr + 40);
    if eh_magic != EXT4_EXTENT_MAGIC { return extents; }

    let eh_entries = mem_read_u16(inode_addr + 42);
    let eh_depth   = mem_read_u16(inode_addr + 46);

    if eh_depth != 0 {
        // Index-node extents (depth > 0) — not yet supported
        print("ext4: depth=" + to_string(eh_depth) + " index extents unsupported");
        return extents;
    }

    // Leaf extents follow the 12-byte header at offset 40
    let mut i = 0;
    while i < eh_entries {
        let mut off = inode_addr + 52 + i * 12;  // 40+12 header + i*12
        let file_block = mem_read_u32(off);
        let blk_count  = mem_read_u16(off + 4);
        let start_hi   = mem_read_u16(off + 6);
        let start_lo   = mem_read_u32(off + 8);
        // Use start_lo only (covers < 2 TB; start_hi is 0 on typical VMs)
        let disk_block = start_lo;
        push(extents, [file_block, blk_count, disk_block]);
        i = i + 1;
    }
    return extents;
}

// Read file content into EXT4_BLOCK_BUF.
// max_size == 0 means use actual file size.
// Returns bytes read on success, 0 on failure.
fn ext4_read_file(inode_num, max_size) {
    let inode_addr = ext4_read_inode(inode_num);
    if inode_addr == 0 { return 0; }

    // i_size_lo at inode offset 4
    let file_size = mem_read_u32(inode_addr + 4);
    let mut read_limit = file_size;
    if max_size > 0 {
        if max_size < read_limit { read_limit = max_size; }
    }
    if read_limit == 0 { return 0; }

    if ext4_has_extents == 1 {
        let extents = ext4_parse_extents(inode_addr);
        let mut written = 0;
        let secs_per_block = ext4_block_size / 512;
        let mut ei = 0;
        let mut done = 0;
        while ei < len(extents) {
            if done == 0 {
                let ext = extents[ei];
                let blk_count  = ext[1];
                let disk_blk   = ext[2];
                let secs       = blk_count * secs_per_block;
                let dst_addr   = EXT4_BLOCK_BUF + written;
                let ok = ahci_read(ext4_ahci_port, disk_blk * secs_per_block, secs, dst_addr);
                if ok == 0 { done = 1; }
                else {
                    written = written + blk_count * ext4_block_size;
                    if written >= read_limit { done = 1; }
                }
            }
            ei = ei + 1;
        }
        return written;
    }

    // ext2-style block pointers (no extents) — not implemented
    return 0;
}

// List directory entries.
// Returns array of [name, inode_num, file_type] for each valid entry.
fn ext4_list_dir(inode_num) {
    let mut entries = [];
    let nbytes = ext4_read_file(inode_num, 65536);
    if nbytes == 0 { return entries; }

    let mut off = 0;
    let mut done = 0;
    while done == 0 {
        if off >= nbytes { done = 1; }
        else {
            let ino     = mem_read_u32(EXT4_BLOCK_BUF + off);
            let rec_len = mem_read_u16(EXT4_BLOCK_BUF + off + 4);
            let name_len = mem_read_u8(EXT4_BLOCK_BUF + off + 6);
            let ftype   = mem_read_u8(EXT4_BLOCK_BUF + off + 7);

            if rec_len == 0 { done = 1; }
            else {
                if ino != 0 {
                    if name_len > 0 {
                        let name = ext4_read_str(EXT4_BLOCK_BUF + off + 8, name_len);
                        push(entries, [name, ino, ftype]);
                    }
                }
                off = off + rec_len;
            }
        }
    }
    return entries;
}

// Resolve an absolute path to an inode number.
// Returns inode number >= 1 on success, 0 on failure.
fn ext4_resolve(path) {
    if ext4_ready == 0 { return 0; }
    if path == "/" { return EXT4_ROOT_INODE; }

    let mut cur_ino = EXT4_ROOT_INODE;
    let plen = len(path);
    let mut seg_start = 0;
    // Skip leading '/'
    if plen > 0 {
        if str_char_at(path, 0) == 47 { seg_start = 1; }
    }

    let mut i = seg_start;
    let mut done = 0;
    while done == 0 {
        let mut at_sep = 0;
        if i >= plen { at_sep = 1; done = 1; }
        else if str_char_at(path, i) == 47 { at_sep = 1; }

        if at_sep == 1 {
            if i > seg_start {
                let seg = str_sub(path, seg_start, i);
                // Walk current directory looking for seg
                let entries = ext4_list_dir(cur_ino);
                let mut found = 0;
                let mut j = 0;
                while j < len(entries) {
                    if found == 0 {
                        if entries[j][0] == seg {
                            cur_ino = entries[j][1];
                            found = 1;
                        }
                    }
                    j = j + 1;
                }
                if found == 0 { return 0; }
            }
            seg_start = i + 1;
        }
        if done == 0 { i = i + 1; }
    }
    return cur_ino;
}

// Convenience: read file at path into EXT4_BLOCK_BUF.
// Returns byte count on success, 0 on failure.
fn ext4_read_path(path, max_size) {
    let ino = ext4_resolve(path);
    if ino == 0 { return 0; }
    return ext4_read_file(ino, max_size);
}

print("ext4.hl loaded");
print("ext4: extents, 48-bit blocks, htree directories, read-only");

