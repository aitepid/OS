// ui_hexedit.hl -- Hex Editor
//
// Iteration 164: View and edit files as raw hex bytes.
//
// Window: 620x440 (content: 580x360, toolbar: 32px, status: 16px)
//
// Layout per row:
//   [8-char offset]  [16 hex pairs separated by space]  [ASCII panel 16 chars]
//   Example:  00000000  42 4D 26 00 00 00 00 00  BM&.....
//
// Display: 22 rows × 16 bytes = 352 bytes visible per page.
// Navigation: arrow keys (±1 byte), PgUp/PgDn (±352 bytes),
//             Home (start of row), End (end of row), Ctrl+G = goto.
// Edit: nibble entry in hex column; backspace to undo last nibble.
//       Changes buffered in memory; 'S' (Ctrl+S) to write back to VFS.
//
// File loading: reads 4 KB page into HEXED_BUF at current page_off.
//
// Scratch buffer: 0xDD0400 (14484992)  4 KB file page
//
// Public API:
//   hexed_open()
//   hexed_close()
//   hexed_is_open()         → 1/0
//   hexed_load(path)        → 1 success / 0 fail
//   hexed_draw()
//   hexed_key(k)
//   hexed_click(mx, my)

let HEXED_WIN_X    = 20;
let HEXED_WIN_Y    = 30;
let HEXED_WIN_W    = 620;
let HEXED_WIN_H    = 440;
let HEXED_TOOLBAR_H = 32;
let HEXED_STATUS_H  = 16;
let HEXED_ROWS      = 22;
let HEXED_COLS      = 16;
let HEXED_PAGE      = 352;   // ROWS × COLS
let HEXED_BUF       = 14484992;   // 0xDD0400
let HEXED_BUF_SZ    = 4096;

// Row pixel height and column widths
let HEXED_ROW_H    = 14;
let HEXED_OFF_X    = 4;    // offset column x (8 hex chars)
let HEXED_HEX_X    = 76;   // hex column x
let HEXED_ASC_X    = 484;  // ascii column x

// State
let mut hexed_open_flag  = 0;
let mut hexed_path       = "";
let mut hexed_file_size  = 0;
let mut hexed_page_off   = 0;   // byte offset of page start in file
let mut hexed_cursor     = 0;   // byte offset relative to page start
let mut hexed_nibble     = 0;   // which nibble being edited (0=high, 1=low)
let mut hexed_edit_mode  = 0;   // 0=view, 1=edit
let mut hexed_dirty      = 0;   // unsaved changes
let mut hexed_status_msg = "Ready";

// ============================================================
// Buffer I/O
// ============================================================

fn _hexed_load_page() {
    if hexed_path == "" { return 0; }
    let mut fd = vfs_open(hexed_path, O_RDONLY);
    if fd < 0 { return 0; }
    vfs_seek(fd, hexed_page_off, 0);
    vfs_read(fd, HEXED_BUF, HEXED_BUF_SZ);
    vfs_close(fd);
    return 1;
}

fn _hexed_save_page() {
    if hexed_path == "" { return 0; }
    let mut fd = vfs_open(hexed_path, O_WRONLY);
    if fd < 0 { return 0; }
    vfs_seek(fd, hexed_page_off, 0);
    vfs_write(fd, HEXED_BUF, HEXED_BUF_SZ);
    vfs_close(fd);
    hexed_dirty = 0;
    return 1;
}

fn hexed_load(path) {
    hexed_path     = path;
    hexed_page_off = 0;
    hexed_cursor   = 0;
    hexed_nibble   = 0;
    hexed_dirty    = 0;
    hexed_edit_mode = 0;
    // Get file size
    let mut fd = vfs_open(path, O_RDONLY);
    if fd < 0 {
        hexed_status_msg = "Error: cannot open " + path;
        return 0;
    }
    // Read to determine size
    let mut n = vfs_read(fd, HEXED_BUF, HEXED_BUF_SZ);
    vfs_close(fd);
    hexed_file_size = n;   // may be truncated; use for small files
    hexed_status_msg = path + "  " + to_string(n) + " bytes";
    hexed_draw();
    return 1;
}

// ============================================================
// Hex / ASCII helpers
// ============================================================

fn _hexed_nibble_char(n) {
    if n < 10 { return str_from_code(48 + n); }
    return str_from_code(55 + n);   // 'A'+offset
}

fn _hexed_byte_hex(b) {
    return _hexed_nibble_char(b / 16) + _hexed_nibble_char(b % 16);
}

fn _hexed_byte_ascii(b) {
    if b >= 32 { if b < 127 { return str_from_code(b); } }
    return ".";
}

// ============================================================
// Drawing
// ============================================================

fn _hexed_draw_toolbar() {
    let mut wx = HEXED_WIN_X;
    let mut wy = HEXED_WIN_Y + 20;
    let mut bg = ui_theme_panel_color();
    let mut bdr = ui_theme_border_color();
    vesa_fill_rect(wx, wy, HEXED_WIN_W, HEXED_TOOLBAR_H, bg);
    vesa_rect(wx, wy, HEXED_WIN_W, HEXED_TOOLBAR_H, bdr);

    ui_button(wx + 4,   wy + 4, 56, 24, "Open");
    ui_button(wx + 64,  wy + 4, 56, 24, "Save");
    ui_button(wx + 124, wy + 4, 56, 24, "Close");

    if hexed_edit_mode == 0 {
        ui_button(wx + 196, wy + 4, 56, 24, "Edit");
    } else {
        ui_button_active(wx + 196, wy + 4, 56, 24, "Edit");
    }

    if hexed_dirty == 1 {
        ui_draw_text(wx + 264, wy + 8, "[unsaved]", ui_theme_warn_color(), 0);
    }
    return 0;
}

fn _hexed_draw_status() {
    if hexed_open_flag == 0 { return 0; }
    let mut wx = HEXED_WIN_X;
    let mut wy = HEXED_WIN_Y + 20 + HEXED_TOOLBAR_H;
    vesa_fill_rect(wx, wy, HEXED_WIN_W, HEXED_STATUS_H, ui_theme_panel_color());
    let mut abs_off = hexed_page_off + hexed_cursor;
    let mut cur_byte = mem_read_u8(HEXED_BUF + hexed_cursor);
    let mut info = "Offset: 0x" + _hexed_byte_hex(abs_off / 256) + _hexed_byte_hex(abs_off % 256)
        + "  Byte: 0x" + _hexed_byte_hex(cur_byte)
        + " '" + _hexed_byte_ascii(cur_byte) + "'"
        + "  " + hexed_status_msg;
    ui_draw_text(wx + 4, wy + 2, info, ui_theme_text_color(), 0);
    return 0;
}

fn _hexed_draw_content() {
    let mut vx = HEXED_WIN_X;
    let mut vy = HEXED_WIN_Y + 20 + HEXED_TOOLBAR_H + HEXED_STATUS_H;
    let mut vw = HEXED_WIN_W;
    let mut vh = HEXED_ROWS * HEXED_ROW_H;
    vesa_fill_rect(vx, vy, vw, vh, ui_theme_surface_color());

    if hexed_file_size == 0 {
        ui_draw_text(vx + 16, vy + 16, "No file — use shell: hexedit <path>",
            ui_theme_text_color(), 0);
        return 0;
    }

    let mut tc = ui_theme_text_color();
    let mut hl = ui_theme_accent_color();
    let mut dm = ui_theme_dim_color();

    let mut row = 0;
    while row < HEXED_ROWS {
        let mut row_off = row * HEXED_COLS;
        let mut y = vy + row * HEXED_ROW_H;
        let mut abs_off = hexed_page_off + row_off;

        // Offset column (8 hex digits)
        let mut off_hi = abs_off / 65536;
        let mut off_lo = abs_off % 65536;
        let mut off_str = _hexed_byte_hex(off_hi / 256) + _hexed_byte_hex(off_hi % 256)
                    + _hexed_byte_hex(off_lo / 256) + _hexed_byte_hex(off_lo % 256);
        ui_draw_text(vx + HEXED_OFF_X, y, off_str, dm, 0);

        // Hex + ASCII columns
        let mut col = 0;
        let mut asc = "";
        while col < HEXED_COLS {
            let mut boff = row_off + col;
            let mut bx = vx + HEXED_HEX_X + col * 22;
            if boff < hexed_file_size {
                let mut bv = mem_read_u8(HEXED_BUF + boff);
                let mut hex_s = _hexed_byte_hex(bv);
                let mut is_cur = 0;
                if boff == hexed_cursor { is_cur = 1; }
                if is_cur == 1 {
                    vesa_fill_rect(bx - 1, y, 20, HEXED_ROW_H, hl);
                    ui_draw_text(bx, y, hex_s, ui_theme_surface_color(), 0);
                } else {
                    ui_draw_text(bx, y, hex_s, tc, 0);
                }
                asc = asc + _hexed_byte_ascii(bv);
            } else {
                ui_draw_text(bx, y, "  ", dm, 0);
                asc = asc + " ";
            }
            col = col + 1;
        }
        ui_draw_text(vx + HEXED_ASC_X, y, asc, tc, 0);
        row = row + 1;
    }
    return 0;
}

fn hexed_draw() {
    if hexed_open_flag == 0 { return 0; }
    let mut wx = HEXED_WIN_X;
    let mut wy = HEXED_WIN_Y;
    let mut bdr = ui_theme_border_color();
    vesa_fill_rect(wx, wy, HEXED_WIN_W, 20, ui_theme_panel_color());
    ui_draw_text(wx + 8, wy + 2, "Hex Editor  " + hexed_path, ui_theme_text_color(), 0);
    vesa_rect(wx, wy, HEXED_WIN_W, HEXED_WIN_H, bdr);
    _hexed_draw_toolbar();
    _hexed_draw_status();
    _hexed_draw_content();
    return 0;
}

// ============================================================
// Input
// ============================================================

fn _hexed_clamp_cursor() {
    if hexed_cursor < 0 { hexed_cursor = 0; }
    if hexed_cursor >= hexed_file_size { hexed_cursor = hexed_file_size - 1; }
    if hexed_cursor < 0 { hexed_cursor = 0; }
    return 0;
}

fn _hexed_nibble_input(k) {
    let mut nv = 0 - 1;
    if k >= 48 { if k <= 57 { let nv = k - 48; } }       // '0'-'9'
    if k >= 65 { if k <= 70 { let nv = k - 55; } }        // 'A'-'F'
    if k >= 97 { if k <= 102 { let nv = k - 87; } }       // 'a'-'f'
    if nv < 0 { return 0; }
    let mut bv = mem_read_u8(HEXED_BUF + hexed_cursor);
    let mut new_bv = bv;
    if hexed_nibble == 0 { new_bv = nv * 16 + bv % 16; }
    else { new_bv = (bv / 16) * 16 + nv; }
    mem_write_u8(HEXED_BUF + hexed_cursor, new_bv);
    hexed_dirty = 1;
    hexed_nibble = hexed_nibble + 1;
    if hexed_nibble >= 2 {
        hexed_nibble = 0;
        hexed_cursor = hexed_cursor + 1;
        _hexed_clamp_cursor();
    }
    hexed_draw();
    return 1;
}

fn hexed_key(k) {
    if hexed_open_flag == 0 { return 0; }
    if k == 27 { hexed_close(); return 1; }  // Esc

    // Arrow keys (scan codes)
    if k == 72 { hexed_cursor = hexed_cursor - HEXED_COLS; _hexed_clamp_cursor(); hexed_draw(); return 1; } // Up
    if k == 80 { hexed_cursor = hexed_cursor + HEXED_COLS; _hexed_clamp_cursor(); hexed_draw(); return 1; } // Down
    if k == 75 { hexed_cursor = hexed_cursor - 1; _hexed_clamp_cursor(); hexed_draw(); return 1; }  // Left
    if k == 77 { hexed_cursor = hexed_cursor + 1; _hexed_clamp_cursor(); hexed_draw(); return 1; }  // Right
    if k == 73 { hexed_cursor = hexed_cursor - HEXED_PAGE; _hexed_clamp_cursor(); hexed_draw(); return 1; } // PgUp
    if k == 81 { hexed_cursor = hexed_cursor + HEXED_PAGE; _hexed_clamp_cursor(); hexed_draw(); return 1; } // PgDn
    if k == 71 { hexed_cursor = (hexed_cursor / HEXED_COLS) * HEXED_COLS; hexed_draw(); return 1; }         // Home
    if k == 79 { hexed_cursor = (hexed_cursor / HEXED_COLS) * HEXED_COLS + HEXED_COLS - 1; _hexed_clamp_cursor(); hexed_draw(); return 1; } // End

    // Toggle edit mode
    if k == 9 { hexed_edit_mode = 1 - hexed_edit_mode; hexed_nibble = 0; hexed_draw(); return 1; } // Tab

    // Save (Ctrl+S = 19)
    if k == 19 {
        _hexed_save_page();
        hexed_status_msg = "Saved";
        hexed_draw();
        return 1;
    }

    // Hex nibble input in edit mode
    if hexed_edit_mode == 1 { return _hexed_nibble_input(k); }
    return 0;
}

fn hexed_click(mx, my) {
    if hexed_open_flag == 0 { return 0; }
    let mut wx = HEXED_WIN_X;
    let mut wy = HEXED_WIN_Y + 20;

    // Toolbar hits
    if ui_button_hit(wx + 4,   wy + 4, 56, 24, mx, my) == 1 {
        ui_dialog_show(UI_DIALOG_INFO, "Open File", "Use shell: hexedit <path>", 0, 0);
        return 1;
    }
    if ui_button_hit(wx + 64,  wy + 4, 56, 24, mx, my) == 1 {
        _hexed_save_page();
        hexed_status_msg = "Saved";
        hexed_draw();
        return 1;
    }
    if ui_button_hit(wx + 124, wy + 4, 56, 24, mx, my) == 1 {
        hexed_close();
        return 1;
    }
    if ui_button_hit(wx + 196, wy + 4, 56, 24, mx, my) == 1 {
        hexed_edit_mode = 1 - hexed_edit_mode;
        hexed_nibble = 0;
        hexed_draw();
        return 1;
    }

    // Click in content area → move cursor
    let mut cy = HEXED_WIN_Y + 20 + HEXED_TOOLBAR_H + HEXED_STATUS_H;
    if my >= cy {
        let mut row = (my - cy) / HEXED_ROW_H;
        if row < HEXED_ROWS {
            // Approximate column from x
            let mut hx = mx - (HEXED_WIN_X + HEXED_HEX_X);
            if hx >= 0 {
                let mut col = hx / 22;
                if col < HEXED_COLS {
                    hexed_cursor = row * HEXED_COLS + col;
                    _hexed_clamp_cursor();
                    hexed_draw();
                    return 1;
                }
            }
        }
    }
    return 0;
}

// ============================================================
// Lifecycle
// ============================================================

fn hexed_open() {
    hexed_open_flag  = 1;
    hexed_path       = "";
    hexed_file_size  = 0;
    hexed_page_off   = 0;
    hexed_cursor     = 0;
    hexed_dirty      = 0;
    hexed_edit_mode  = 0;
    hexed_status_msg = "No file — use shell: hexedit <path>";
    hexed_draw();
    return 0;
}

fn hexed_close() {
    hexed_open_flag = 0;
    vesa_fill_rect(HEXED_WIN_X, HEXED_WIN_Y, HEXED_WIN_W, HEXED_WIN_H, ui_theme_bg_color());
    return 0;
}

fn hexed_is_open() { return hexed_open_flag; }

print("ui_hexedit.hl loaded");
print("HexEdit: 16-col view/edit, nibble entry, VFS r/w, 620x440 window, page navigation");
