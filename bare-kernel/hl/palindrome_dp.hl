// palindrome_dp.hl -- Palindrome Partition DP: minimum cuts (iter 337)
// Buffer: 0x1880000
// pl_s[PL_MAX]: integer sequence. pl_is[i*32+j]=1 iff s[i..j] is palindrome.
// pl_build(n): O(n^2) table fill + pl_dp[i]=min cuts for prefix [0..i].
// pl_min_cuts(): pl_dp[pl_n-1].  pl_pal(i,j): palindrome predicate.

let PL_MAX = 32;

let pl_s  = array(32, 0);
let pl_is = array(1024, 0);   // pl_is[i*32+j]
let pl_dp = array(32, 0);
let mut pl_n  = 0;

fn palin_dp_init() {
    pl_n = 0;
    let mut i = 0;
    while i < 1024 { set_at(pl_is, i, 0); i += 1; }
    return 0;
}

fn pl_build(n) {
    pl_n = n;
    // clear table
    let mut i = 0;
    while i < n * 32 { set_at(pl_is, i, 0); i += 1; }
    // length 1
    i = 0;
    while i < n {
        set_at(pl_is, i * 32 + i, 1);
        i += 1;
    }
    // length 2
    i = 0;
    while i + 1 < n {
        if pl_s[i] == pl_s[i + 1] {
            set_at(pl_is, i * 32 + i + 1, 1);
        }
        i += 1;
    }
    // length >= 3
    let mut len = 3;
    while len <= n {
        i = 0;
        while i + len - 1 < n {
            let mut j = i + len - 1;
            if pl_s[i] == pl_s[j] {
                if pl_is[(i + 1) * 32 + j - 1] == 1 {
                    set_at(pl_is, i * 32 + j, 1);
                }
            }
            i += 1;
        }
        len += 1;
    }
    // DP: min cuts
    i = 0;
    while i < n {
        if pl_is[0 * 32 + i] == 1 {
            set_at(pl_dp, i, 0);
        } else {
            set_at(pl_dp, i, i);
            let mut j = 1;
            while j <= i {
                if pl_is[j * 32 + i] == 1 {
                    let cand = pl_dp[j - 1] + 1;
                    if cand < pl_dp[i] { set_at(pl_dp, i, cand); }
                }
                j += 1;
            }
        }
        i += 1;
    }
    return 0;
}

fn pl_min_cuts() { return pl_dp[pl_n - 1]; }

fn pl_pal(i, j) { return pl_is[i * 32 + j]; }

fn pl_test() {
    // "aab" = [0,0,1] -> min cuts = 1 ("aa"|"b")
    set_at(pl_s, 0, 0); set_at(pl_s, 1, 0); set_at(pl_s, 2, 1);
    pl_build(3);
    let c1 = pl_min_cuts();
    // "abcba" = [0,1,2,1,0] -> min cuts = 0 (whole palindrome)
    set_at(pl_s, 0, 0); set_at(pl_s, 1, 1); set_at(pl_s, 2, 2);
    set_at(pl_s, 3, 1); set_at(pl_s, 4, 0);
    pl_build(5);
    let c2 = pl_min_cuts();
    print("pl_test: aab=" + to_string(c1) + " abcba=" + to_string(c2));
    if c1 == 1 {
        if c2 == 0 {
            print("pl_test: PASS");
            return 1;
        }
    }
    print("pl_test: FAIL");
    return 0;
}

print("palindrome_dp.hl loaded");
