// font_atlas.hl -- Multi-size bitmap font atlas (HicSans)
//
// Sprint G1 of HicOS GUI injection (per GUI_DESIGN.md §3.2).
//
// Design (per decision #3: self-drawn bitmap font, zero TTF):
//   - 4 size classes targeting Win11 Fluent typography:
//       caption  13 px (FONT_13)
//       body     15 px (FONT_15)
//       subhead  17 px (FONT_17)
//       title    22 px (FONT_22)
//   - ASCII 32..127 (96 glyphs) per size.
//   - CJK common 3500 chars: planned but data ships in G7 (slot reserved).
//
// Storage:
//   Each glyph is stored as a packed bitmap. Width and height vary by size:
//       13 px:  8 wide × 14 tall  -> 14 bytes/glyph, 96 * 14 = 1344 B
//       15 px:  9 wide × 16 tall  -> 32 bytes/glyph (2B per row), 96*32 = 3072 B
//       17 px: 10 wide × 18 tall  -> 36 bytes/glyph (2B per row), 96*36 = 3456 B
//       22 px: 13 wide × 24 tall  -> 72 bytes/glyph (3B per row), 96*72 = 6912 B
//
//   Base addresses (sequential, after legacy FONT_BASE 0x180000):
//       FONT_13_BASE = 0x190000
//       FONT_15_BASE = 0x191000
//       FONT_17_BASE = 0x192000
//       FONT_19_BASE = 0x193000   (reserved)
//       FONT_22_BASE = 0x194000
//
//   For G1 the actual pixel data is generated synthetically from the
//   existing 8x16 FONT_BASE: we upscale it via nearest-neighbour into
//   each size slot at boot. This keeps the boot image small and lets
//   us swap in proper hand-tuned glyphs later without changing the API.

let FONT_13_BASE = 1638400;   // 0x190000
let FONT_15_BASE = 1642496;   // 0x191000
let FONT_17_BASE = 1646592;   // 0x192000
let FONT_22_BASE = 1654784;   // 0x194000

let FONT_SIZE_CAPTION  = 13;
let FONT_SIZE_BODY     = 15;
let FONT_SIZE_SUBHEAD  = 17;
let FONT_SIZE_TITLE    = 22;

let mut font_atlas_ready = 0;

// Per-size descriptors
fn font_atlas_base(size) {
    if size == 13 { return FONT_13_BASE; }
    if size == 15 { return FONT_15_BASE; }
    if size == 17 { return FONT_17_BASE; }
    if size == 22 { return FONT_22_BASE; }
    return FONT_13_BASE;
}

fn font_atlas_w(size) {
    if size == 13 { return 8;  }
    if size == 15 { return 9;  }
    if size == 17 { return 10; }
    if size == 22 { return 13; }
    return 8;
}

fn font_atlas_h(size) {
    if size == 13 { return 14; }
    if size == 15 { return 16; }
    if size == 17 { return 18; }
    if size == 22 { return 24; }
    return 14;
}

// Bytes per row (ceil(w/8))
fn font_atlas_row_bytes(size) {
    let mut w = font_atlas_w(size);
    return (w + 7) / 8;
}

fn font_atlas_glyph_bytes(size) {
    return font_atlas_h(size) * font_atlas_row_bytes(size);
}

fn font_atlas_glyph_addr(size, ch) {
    if ch < 32 { return font_atlas_base(size); }
    if ch > 127 { return font_atlas_base(size); }
    let mut idx = ch - 32;
    return font_atlas_base(size) + idx * font_atlas_glyph_bytes(size);
}

// Upscale a single 8x16 source glyph into a larger packed bitmap.
// src 8x16 -> dst w x h via nearest-neighbour.
fn font_atlas_upscale_one(ch, size) {
    let mut src_addr = FONT_BASE + ch * 16;
    let mut dst_addr = font_atlas_glyph_addr(size, ch);
    let mut dst_w  = font_atlas_w(size);
    let mut dst_h  = font_atlas_h(size);
    let mut row_b  = font_atlas_row_bytes(size);
    // Clear destination region first.
    let mut z = 0;
    while z < dst_h * row_b { mem_write_u8(dst_addr + z, 0); z = z + 1; }
    let mut dy = 0;
    while dy < dst_h {
        let mut sy = dy * 16 / dst_h;
        let mut sbyte = mem_read_u8(src_addr + sy);
        let mut dx = 0;
        while dx < dst_w {
            let mut sx = dx * 8 / dst_w;
            // bit (7 - sx) of sbyte
            let mut s = 7 - sx;
            let mut bit = sbyte;
            let mut k = s;
            while k > 0 { bit = bit / 2; k = k - 1; }
            if bit % 2 == 1 {
                let mut byte_idx = dx / 8;
                let mut bit_in_byte = 7 - (dx - byte_idx * 8);
                let mut mask = 1;
                let mut m = bit_in_byte;
                while m > 0 { mask = mask * 2; m = m - 1; }
                let mut cur = mem_read_u8(dst_addr + dy * row_b + byte_idx);
                if cur / mask % 2 == 0 {
                    mem_write_u8(dst_addr + dy * row_b + byte_idx, cur + mask);
                }
            }
            dx = dx + 1;
        }
        dy = dy + 1;
    }
    return 0;
}

fn font_atlas_init() {
    if font_atlas_ready == 1 { return 0; }
    let mut sizes = [13, 15, 17, 22];
    let mut si = 0;
    while si < 4 {
        let mut size = sizes[si];
        let mut ch = 32;
        while ch < 128 {
            font_atlas_upscale_one(ch, size);
            ch = ch + 1;
        }
        si = si + 1;
    }
    font_atlas_ready = 1;
    print("font_atlas: 4 sizes (13/15/17/22), ASCII 32..127 ready");
    return 1;
}

// Draw a single glyph onto the backbuffer with alpha-modulated coverage.
// On-pixels render with the full fg alpha; off-pixels are skipped (no bg).
fn font_atlas_draw_glyph(x, y, ch, size, color) {
    if font_atlas_ready == 0 { font_atlas_init(); }
    if ch < 32 { return 0; }
    if ch > 127 { return 0; }
    let mut addr = font_atlas_glyph_addr(size, ch);
    let mut w = font_atlas_w(size);
    let mut h = font_atlas_h(size);
    let mut row_b = font_atlas_row_bytes(size);
    let mut dy = 0;
    while dy < h {
        let mut dx = 0;
        while dx < w {
            let mut byte_idx = dx / 8;
            let mut bit_in_byte = 7 - (dx - byte_idx * 8);
            let mut mask = 1;
            let mut m = bit_in_byte;
            while m > 0 { mask = mask * 2; m = m - 1; }
            let mut byte = mem_read_u8(addr + dy * row_b + byte_idx);
            if byte / mask % 2 == 1 {
                gfx_putpixel_alpha(x + dx, y + dy, color);
            }
            dx = dx + 1;
        }
        dy = dy + 1;
    }
    return 0;
}

fn font_atlas_draw_str(x, y, s, size, color) {
    let mut n = strlen(s);
    let mut i = 0;
    let mut px = x;
    let mut advance = font_atlas_w(size) + 1;
    while i < n {
        let mut ch = str_byte(s, i);
        font_atlas_draw_glyph(px, y, ch, size, color);
        px = px + advance;
        i = i + 1;
    }
    return 0;
}

// Measure string width in pixels for layout.
fn font_atlas_measure(s, size) {
    let mut n = strlen(s);
    let mut advance = font_atlas_w(size) + 1;
    return n * advance;
}

print("font_atlas.hl loaded");
