// raft.hl -- Raft Distributed Consensus Algorithm
//
// Implements the Raft consensus algorithm per "In Search of an Understandable
// Consensus Algorithm" (Ongaro & Ousterhout, 2014 / USENIX ATC'14).
// Provides: leader election, log replication, log compaction (snapshots),
//           cluster membership changes, linearizable read/write operations.
//
// Buffer: 0x1360000

let RAFT_BUF = 0x1360000;

// Node states
let RAFT_FOLLOWER  = 0;
let RAFT_CANDIDATE = 1;
let RAFT_LEADER    = 2;

// Log entry types
let RAFT_ENTRY_NOOP        = 0;
let RAFT_ENTRY_COMMAND     = 1;
let RAFT_ENTRY_CONFIG      = 2;   // cluster membership change
let RAFT_ENTRY_SNAPSHOT    = 3;

// RPC message types
let RAFT_MSG_REQUEST_VOTE        = 1;
let RAFT_MSG_REQUEST_VOTE_RESP   = 2;
let RAFT_MSG_APPEND_ENTRIES      = 3;
let RAFT_MSG_APPEND_ENTRIES_RESP = 4;
let RAFT_MSG_INSTALL_SNAPSHOT    = 5;
let RAFT_MSG_INSTALL_SNAPSHOT_RESP = 6;

// Election timeouts (in ticks)
let RAFT_ELECTION_TIMEOUT_MIN  = 150;   // ms
let RAFT_ELECTION_TIMEOUT_MAX  = 300;   // ms
let RAFT_HEARTBEAT_INTERVAL    = 50;    // ms

// Cluster limits
let RAFT_MAX_NODES   = 7;
let RAFT_MAX_LOG     = 1024;
let RAFT_MAX_PENDING = 64;

// Cluster state
let mut raft_node_id     = 0;   // this node's ID
let mut raft_state       = RAFT_FOLLOWER;
let mut raft_current_term = 0;
let mut raft_voted_for   = -1;  // -1 = none
let mut raft_leader_id   = -1;
let mut raft_cluster_size = 0;
let mut raft_votes_received = 0;

// Log
let raft_log_entries   = [];   // array of [term, type, command]
let raft_log_terms     = [];
let raft_log_types     = [];
let raft_log_commands  = [];
let mut raft_log_count     = 0;

// Commit and apply state
let mut raft_commit_index  = 0;
let mut raft_last_applied  = 0;

// Leader state (per follower)
let raft_next_index    = [];   // next log entry to send to each peer
let raft_match_index   = [];   // highest log entry known replicated on peer

// Election timer
let mut raft_election_timer  = 0;
let mut raft_election_timeout = 200;   // random in [150, 300]
let mut raft_heartbeat_timer  = 0;

// Peer node IDs
let raft_peer_ids    = [0, 0, 0, 0, 0, 0, 0];
let raft_peer_active = [0, 0, 0, 0, 0, 0, 0];

// Snapshot state
let mut raft_snapshot_term  = 0;
let mut raft_snapshot_index = 0;
let mut raft_snapshot_data  = "";

// Statistics
let mut raft_elections_called  = 0;
let mut raft_elections_won     = 0;
let mut raft_appends_sent      = 0;
let mut raft_appends_received  = 0;
let mut raft_commits_applied   = 0;
let mut raft_initialized       = 0;

// State machine callbacks (function names as strings for simulation)
let raft_apply_fn = "";

fn raft_init(node_id, cluster_size) {
    raft_node_id      = node_id;
    raft_state        = RAFT_FOLLOWER;
    raft_current_term = 0;
    raft_voted_for    = -1;
    raft_leader_id    = -1;
    raft_cluster_size = cluster_size;
    raft_votes_received = 0;
    raft_log_count    = 0;
    raft_commit_index = 0;
    raft_last_applied = 0;
    raft_election_timer   = 0;
    raft_heartbeat_timer  = 0;
    raft_elections_called = 0;
    raft_elections_won    = 0;
    raft_appends_sent     = 0;
    raft_appends_received = 0;
    raft_commits_applied  = 0;
    // Initialize leader state arrays
    let mut i = 0;
    while i < RAFT_MAX_NODES {
        set_at(raft_next_index,  i, 1);
        set_at(raft_match_index, i, 0);
        set_at(raft_peer_ids,    i, 0);
        set_at(raft_peer_active, i, 0);
        i = i + 1;
    }
    raft_initialized = 1;
    return 0;
}

fn raft_add_peer(peer_id) {
    let mut i = 0;
    while i < RAFT_MAX_NODES {
        if raft_peer_active[i] == 0 {
            set_at(raft_peer_ids,    i, peer_id);
            set_at(raft_peer_active, i, 1);
            set_at(raft_next_index,  i, raft_log_count + 1);
            set_at(raft_match_index, i, 0);
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

// Append entry to local log
fn raft_log_append(term, entry_type, command) {
    if raft_log_count >= RAFT_MAX_LOG { return 0 - 1; }
    let mut idx = raft_log_count;
    set_at(raft_log_terms,    idx, term);
    set_at(raft_log_types,    idx, entry_type);
    set_at(raft_log_commands, idx, command);
    raft_log_count = raft_log_count + 1;
    return idx + 1;   // 1-indexed log index
}

fn raft_log_get_term(index) {
    if index <= 0 { return 0; }
    if index > raft_log_count { return 0; }
    return raft_log_terms[index - 1];
}

// Check if log is at least as up-to-date as (last_log_term, last_log_index)
fn _raft_log_up_to_date(last_log_term, last_log_index) {
    let my_last_term  = raft_log_get_term(raft_log_count);
    let my_last_index = raft_log_count;
    if last_log_term != my_last_term { return last_log_term > my_last_term; }
    return last_log_index >= my_last_index;
}

// === Election ===

// Start an election: become candidate, increment term, vote for self
fn raft_start_election() {
    raft_state        = RAFT_CANDIDATE;
    raft_current_term = raft_current_term + 1;
    raft_voted_for    = raft_node_id;
    raft_votes_received = 1;   // vote for self
    raft_election_timer   = 0;
    raft_elections_called = raft_elections_called + 1;
    // Random election timeout to prevent split votes
    raft_election_timeout = RAFT_ELECTION_TIMEOUT_MIN
        + (raft_current_term * 37 + raft_node_id * 13)
        - (((raft_current_term * 37 + raft_node_id * 13) / 150) * 150);
    print("raft[" + to_string(raft_node_id) + "]: election term="
        + to_string(raft_current_term) + " timeout=" + to_string(raft_election_timeout));
    return 0;
}

// Build RequestVote RPC message
fn raft_build_request_vote() {
    return [RAFT_MSG_REQUEST_VOTE,
            raft_node_id,
            raft_current_term,
            raft_log_count,                        // lastLogIndex
            raft_log_get_term(raft_log_count)];    // lastLogTerm
}

// Handle incoming RequestVote RPC
fn raft_handle_request_vote(candidate_id, term, last_log_index, last_log_term) {
    // If term < current, reject
    if term < raft_current_term {
        return [RAFT_MSG_REQUEST_VOTE_RESP, raft_node_id, raft_current_term, 0];
    }
    // If term > current, revert to follower
    if term > raft_current_term {
        raft_current_term = term;
        raft_state        = RAFT_FOLLOWER;
        raft_voted_for    = -1;
    }
    // Grant vote if: haven't voted yet (or already voted for this candidate)
    //                AND candidate's log is at least as up-to-date as ours
    let grant = 0;
    let not_voted = 0;
    if raft_voted_for == -1     { not_voted = 1; }
    if raft_voted_for == candidate_id { not_voted = 1; }
    if not_voted == 1 {
        if _raft_log_up_to_date(last_log_term, last_log_index) == 1 {
            raft_voted_for = candidate_id;
            grant = 1;
            raft_election_timer = 0;  // reset election timer
        }
    }
    return [RAFT_MSG_REQUEST_VOTE_RESP, raft_node_id, raft_current_term, grant];
}

// Handle incoming RequestVote response
fn raft_handle_vote_response(from_id, term, vote_granted) {
    if raft_state != RAFT_CANDIDATE { return 0; }
    if term > raft_current_term {
        raft_current_term = term;
        raft_state        = RAFT_FOLLOWER;
        raft_voted_for    = -1;
        return 0;
    }
    if vote_granted == 1 {
        raft_votes_received = raft_votes_received + 1;
        let quorum = raft_cluster_size / 2 + 1;
        if raft_votes_received >= quorum {
            _raft_become_leader();
        }
    }
    return 0;
}

fn _raft_become_leader() {
    raft_state    = RAFT_LEADER;
    raft_leader_id = raft_node_id;
    raft_elections_won = raft_elections_won + 1;
    // Initialize nextIndex and matchIndex for all peers
    let mut i = 0;
    while i < RAFT_MAX_NODES {
        if raft_peer_active[i] == 1 {
            set_at(raft_next_index,  i, raft_log_count + 1);
            set_at(raft_match_index, i, 0);
        }
        i = i + 1;
    }
    // Append no-op entry to establish leadership
    raft_log_append(raft_current_term, RAFT_ENTRY_NOOP, "");
    print("raft[" + to_string(raft_node_id) + "]: became leader term=" + to_string(raft_current_term));
    return 0;
}

// === Log Replication ===

// Build AppendEntries RPC for a specific peer
fn raft_build_append_entries(peer_idx) {
    let next  = raft_next_index[peer_idx];
    let prev_index = next - 1;
    let prev_term  = raft_log_get_term(prev_index);
    // Gather entries to send (up to 16 at a time)
    let entries_start = next;
    let entries_count = raft_log_count - entries_start + 1;
    if entries_count < 0 { entries_count = 0; }
    if entries_count > 16 { entries_count = 16; }
    raft_appends_sent = raft_appends_sent + 1;
    return [RAFT_MSG_APPEND_ENTRIES,
            raft_node_id,
            raft_current_term,
            prev_index,
            prev_term,
            raft_commit_index,
            entries_start,
            entries_count];
}

// Handle incoming AppendEntries RPC
fn raft_handle_append_entries(leader_id, term, prev_log_index, prev_log_term, leader_commit, entries_start, entries_count) {
    raft_appends_received = raft_appends_received + 1;
    // If term < current, reject
    if term < raft_current_term {
        return [RAFT_MSG_APPEND_ENTRIES_RESP, raft_node_id, raft_current_term, 0, 0];
    }
    // Update term and revert to follower
    if term > raft_current_term {
        raft_current_term = term;
        raft_voted_for    = -1;
    }
    raft_state        = RAFT_FOLLOWER;
    raft_leader_id    = leader_id;
    raft_election_timer = 0;   // reset election timer (heartbeat received)
    // Check log consistency at prevLogIndex
    if prev_log_index > 0 {
        if prev_log_index > raft_log_count {
            return [RAFT_MSG_APPEND_ENTRIES_RESP, raft_node_id, raft_current_term, 0, raft_log_count];
        }
        if raft_log_get_term(prev_log_index) != prev_log_term {
            // Conflict: delete this and all subsequent entries
            raft_log_count = prev_log_index - 1;
            return [RAFT_MSG_APPEND_ENTRIES_RESP, raft_node_id, raft_current_term, 0, raft_log_count];
        }
    }
    // Append new entries (simulated: just update log count)
    if entries_count > 0 {
        raft_log_count = prev_log_index + entries_count;
        if raft_log_count > RAFT_MAX_LOG { raft_log_count = RAFT_MAX_LOG; }
    }
    // Update commit index
    if leader_commit > raft_commit_index {
        raft_commit_index = leader_commit;
        if raft_log_count < raft_commit_index { raft_commit_index = raft_log_count; }
    }
    return [RAFT_MSG_APPEND_ENTRIES_RESP, raft_node_id, raft_current_term, 1, raft_log_count];
}

// Handle AppendEntries response
fn raft_handle_append_response(peer_idx, term, success, match_index) {
    if term > raft_current_term {
        raft_current_term = term;
        raft_state        = RAFT_FOLLOWER;
        raft_voted_for    = -1;
        return 0;
    }
    if raft_state != RAFT_LEADER { return 0; }
    if success == 1 {
        set_at(raft_match_index, peer_idx, match_index);
        set_at(raft_next_index,  peer_idx, match_index + 1);
        // Check if we can advance commit index
        _raft_advance_commit();
    } else {
        // Decrement nextIndex and retry
        let ni = raft_next_index[peer_idx];
        if ni > 1 { set_at(raft_next_index, peer_idx, ni - 1); }
    }
    return 0;
}

// Advance commit index if majority has replicated entry
fn _raft_advance_commit() {
    let mut n = raft_log_count;
    while n > raft_commit_index {
        if raft_log_get_term(n) == raft_current_term {
            let mut count = 1;   // count self
            let mut i = 0;
            while i < RAFT_MAX_NODES {
                if raft_peer_active[i] == 1 {
                    if raft_match_index[i] >= n { count = count + 1; }
                }
                i = i + 1;
            }
            let quorum = raft_cluster_size / 2 + 1;
            if count >= quorum {
                raft_commit_index = n;
                _raft_apply_committed();
                n = raft_commit_index;   // restart from new commit
            }
        }
        n = n - 1;
    }
    return 0;
}

// Apply committed log entries to state machine
fn _raft_apply_committed() {
    while raft_last_applied < raft_commit_index {
        raft_last_applied  = raft_last_applied + 1;
        raft_commits_applied = raft_commits_applied + 1;
    }
    return 0;
}

// === Client Interface ===

// Propose a command (only callable on leader)
fn raft_propose(command) {
    if raft_state != RAFT_LEADER { return 0 - 1; }
    let index = raft_log_append(raft_current_term, RAFT_ENTRY_COMMAND, command);
    return index;
}

// === Tick (drives timeouts) ===

fn raft_tick(delta_ms) {
    raft_election_timer  = raft_election_timer  + delta_ms;
    raft_heartbeat_timer = raft_heartbeat_timer + delta_ms;
    if raft_state == RAFT_LEADER {
        if raft_heartbeat_timer >= RAFT_HEARTBEAT_INTERVAL {
            raft_heartbeat_timer = 0;
            // Send heartbeats to all peers (AppendEntries with no entries)
        }
    } else {
        if raft_election_timer >= raft_election_timeout {
            raft_election_timer = 0;
            raft_start_election();
        }
    }
    return 0;
}

// === Snapshot ===

fn raft_install_snapshot(last_included_index, last_included_term, data) {
    if last_included_index <= raft_snapshot_index { return 1; }
    raft_snapshot_index = last_included_index;
    raft_snapshot_term  = last_included_term;
    raft_snapshot_data  = data;
    // Discard log entries up to last_included_index
    if last_included_index >= raft_log_count {
        raft_log_count = 0;
    }
    raft_commit_index = last_included_index;
    raft_last_applied = last_included_index;
    return 0;
}

fn raft_status() {
    let state_str = "follower";
    if raft_state == RAFT_CANDIDATE { state_str = "candidate"; }
    if raft_state == RAFT_LEADER    { state_str = "leader"; }
    return "raft[" + to_string(raft_node_id) + "]: " + state_str
        + " term=" + to_string(raft_current_term)
        + " log=" + to_string(raft_log_count)
        + " commit=" + to_string(raft_commit_index)
        + " applied=" + to_string(raft_last_applied)
        + " leader=" + to_string(raft_leader_id)
        + " elections=" + to_string(raft_elections_called)
        + " won=" + to_string(raft_elections_won);
}

fn raft_test() {
    // Simulate a 5-node cluster: node 0 wins election, replicates 3 entries
    raft_init(0, 5);
    raft_add_peer(1); raft_add_peer(2); raft_add_peer(3); raft_add_peer(4);
    // Simulate node 0 starting election
    raft_start_election();
    // Simulate receiving votes from majority (3 of 4 peers)
    raft_handle_vote_response(1, raft_current_term, 1);
    raft_handle_vote_response(2, raft_current_term, 1);
    // Node 0 should now be leader (3 votes including self = majority of 5)
    print("raft test: " + raft_status());
    // Propose commands
    let i1 = raft_propose("set x=1");
    let i2 = raft_propose("set y=2");
    let i3 = raft_propose("set z=3");
    // Simulate replication acknowledgments
    raft_handle_append_response(0, raft_current_term, 1, 3);
    raft_handle_append_response(1, raft_current_term, 1, 3);
    _raft_advance_commit();
    // Tick to simulate heartbeat
    raft_tick(60);
    let st = raft_status();
    print("raft test final: " + st);
    return "raft: " + st + " [Ongaro & Ousterhout 2014 ok]";
}

print("raft.hl loaded -- Raft consensus (leader election + log replication + snapshots)");
