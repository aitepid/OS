// hl_lint2.hl -- Enhanced Lint Checker
// Iteration 435 | Buffer: 0x1EA0000
//
// Advanced linting for H-L code.
// Features:
// - Unused variable detection (lint_check_unused_vars)
// - Cyclomatic complexity tracking (lint_inc_complexity / lint_check_complexity)
// - Issue accumulation with type codes
//
// Testing: hl_lint2_test() → validates linting rules and warnings

let LINT_MAX_VARS   = 32;
let LINT_MAX_ISSUES = 64;

let LINT_ISSUE_UNUSED      = 1;
let LINT_ISSUE_TYPEMISMATCH = 2;
let LINT_ISSUE_DEADCODE    = 3;
let LINT_ISSUE_COMPLEXITY  = 4;

let lint_vars_used    = array(LINT_MAX_VARS, 0);
let lint_vars_defined = array(LINT_MAX_VARS, 0);
let mut lint_var_count    = 0;

let lint_issues      = array(LINT_MAX_ISSUES, 0);
let lint_issue_types = array(LINT_MAX_ISSUES, 0);
let mut lint_issue_count = 0;

let mut lint_complexity     = 0;
let mut lint_warnings_total = 0;

fn lint_define_var(var_id) {
    if var_id >= LINT_MAX_VARS { return 0 - 1; }
    set_at(lint_vars_defined, var_id, 1);
    if var_id >= lint_var_count {
        lint_var_count = var_id + 1;
    }
    return var_id;
}

fn lint_use_var(var_id) {
    if var_id >= LINT_MAX_VARS { return 0 - 1; }
    set_at(lint_vars_used, var_id, 1);
    return var_id;
}

fn lint_add_issue(issue_type) {
    if lint_issue_count >= LINT_MAX_ISSUES { return 0 - 1; }
    set_at(lint_issue_types, lint_issue_count, issue_type);
    let mut old_count = lint_issue_count;
    lint_issue_count = lint_issue_count + 1;
    return old_count;
}

// Scan all defined variables; add LINT_ISSUE_UNUSED for each that was defined
// but never used.  Returns total warning count after the scan.
fn lint_check_unused_vars() {
    let mut i = 0;
    while i < lint_var_count {
        let defined = lint_vars_defined[i];
        let used    = lint_vars_used[i];
        if defined == 1 {
            if used == 0 {
                lint_add_issue(LINT_ISSUE_UNUSED);
                lint_warnings_total = lint_warnings_total + 1;
            }
        }
        i = i + 1;
    }
    return lint_warnings_total;
}

fn lint_inc_complexity() {
    lint_complexity = lint_complexity + 1;
}

fn lint_check_complexity() {
    if lint_complexity > 10 {
        lint_add_issue(LINT_ISSUE_COMPLEXITY);
        lint_warnings_total = lint_warnings_total + 1;
    }
    return lint_warnings_total;
}

fn lint_get_issue_count()   { return lint_issue_count; }
fn lint_get_warning_count() { return lint_warnings_total; }
fn lint_get_complexity()    { return lint_complexity; }

fn lint_reset() {
    let mut i = 0;
    while i < LINT_MAX_VARS {
        set_at(lint_vars_defined, i, 0);
        set_at(lint_vars_used,    i, 0);
        i = i + 1;
    }
    let mut j = 0;
    while j < LINT_MAX_ISSUES {
        set_at(lint_issue_types, j, 0);
        j = j + 1;
    }
    lint_var_count      = 0;
    lint_issue_count    = 0;
    lint_warnings_total = 0;
    lint_complexity     = 0;
}

fn lint_init() {
    lint_reset();
}

fn hl_lint2_test() {
    lint_init();
    let mut pass = 1;

    // Define var 10 (used) and var 20 (unused)
    lint_define_var(10);
    lint_define_var(20);
    lint_use_var(10);

    let def_cnt = lint_var_count;   // should be 21 (max(10,20)+1)
    if def_cnt < 2 { pass = 0; }

    // Unused-var scan: var 20 is defined but not used → 1 warning
    lint_check_unused_vars();
    let warn_cnt = lint_get_warning_count();
    if warn_cnt != 1 { pass = 0; }

    // Complexity tracking
    lint_inc_complexity();
    lint_inc_complexity();
    lint_inc_complexity();
    let cmplx = lint_get_complexity();
    if cmplx != 3 { pass = 0; }

    // Reset clears everything
    lint_reset();
    let issue_cnt = lint_get_issue_count();
    if issue_cnt != 0 { pass = 0; }

    // After reset: define var 5 (not used) → check finds it
    lint_define_var(5);
    lint_check_unused_vars();
    let issues = lint_get_issue_count();
    if issues < 1 { pass = 0; }

    // Complexity threshold check: set complexity to 11 → adds COMPLEXITY issue
    lint_reset();
    let mut k = 0;
    while k < 11 {
        lint_inc_complexity();
        k = k + 1;
    }
    lint_check_complexity();
    let cx_issues = lint_get_issue_count();
    if cx_issues < 1 { pass = 0; }
    let cx_warn = lint_get_warning_count();
    if cx_warn < 1 { pass = 0; }

    print("hl_lint2_test: def_cnt=" + to_string(def_cnt)
          + " warn=" + to_string(warn_cnt)
          + " cmplx=" + to_string(cmplx)
          + " cx_issues=" + to_string(cx_issues));

    if pass == 1 { print("hl_lint2_test PASS"); }
    if pass == 0 { print("hl_lint2_test FAIL"); }
    return pass;
}

hl_lint2_test();
print("hl_lint2.hl loaded");
