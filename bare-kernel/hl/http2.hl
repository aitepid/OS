// http2.hl -- HTTP/2 Protocol Implementation
//
// Implements HTTP/2 per RFC 7540 with HPACK header compression (RFC 7541).
// Features: frame parsing/serialization, stream multiplexing (up to 128 streams),
//           HPACK static/dynamic table, SETTINGS negotiation, flow control,
//           GOAWAY, RST_STREAM, PING, PUSH_PROMISE frame types.
//
// Buffer: 0x1340000

let HTTP2_BUF = 0x1340000;

// HTTP/2 frame types
let H2_FRAME_DATA          = 0;
let H2_FRAME_HEADERS       = 1;
let H2_FRAME_PRIORITY      = 2;
let H2_FRAME_RST_STREAM    = 3;
let H2_FRAME_SETTINGS      = 4;
let H2_FRAME_PUSH_PROMISE  = 5;
let H2_FRAME_PING          = 6;
let H2_FRAME_GOAWAY        = 7;
let H2_FRAME_WINDOW_UPDATE = 8;
let H2_FRAME_CONTINUATION  = 9;

// HTTP/2 flags
let H2_FLAG_END_STREAM  = 1;
let H2_FLAG_END_HEADERS = 4;
let H2_FLAG_PADDED      = 8;
let H2_FLAG_PRIORITY    = 32;
let H2_FLAG_ACK         = 1;

// HTTP/2 error codes
let H2_ERR_NO_ERROR            = 0;
let H2_ERR_PROTOCOL_ERROR      = 1;
let H2_ERR_INTERNAL_ERROR      = 2;
let H2_ERR_FLOW_CONTROL_ERROR  = 3;
let H2_ERR_SETTINGS_TIMEOUT    = 4;
let H2_ERR_STREAM_CLOSED       = 5;
let H2_ERR_FRAME_SIZE_ERROR    = 6;
let H2_ERR_REFUSED_STREAM      = 7;
let H2_ERR_CANCEL              = 8;
let H2_ERR_COMPRESSION_ERROR   = 9;
let H2_ERR_CONNECT_ERROR       = 10;
let H2_ERR_ENHANCE_YOUR_CALM   = 11;
let H2_ERR_INADEQUATE_SECURITY = 12;
let H2_ERR_HTTP_1_1_REQUIRED   = 13;

// SETTINGS identifiers
let H2_SETTINGS_HEADER_TABLE_SIZE      = 1;
let H2_SETTINGS_ENABLE_PUSH            = 2;
let H2_SETTINGS_MAX_CONCURRENT_STREAMS = 3;
let H2_SETTINGS_INITIAL_WINDOW_SIZE    = 4;
let H2_SETTINGS_MAX_FRAME_SIZE         = 5;
let H2_SETTINGS_MAX_HEADER_LIST_SIZE   = 6;

// Stream states
let H2_STREAM_IDLE        = 0;
let H2_STREAM_OPEN        = 1;
let H2_STREAM_HALF_CLOSED = 2;
let H2_STREAM_CLOSED      = 3;
let H2_STREAM_RESERVED    = 4;

// HTTP/2 connection preface
let H2_PREFACE = "PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n";

// Maximum streams and header table size
let H2_MAX_STREAMS       = 128;
let H2_MAX_HEADER_TABLE  = 4096;
let H2_INITIAL_WINDOW    = 65535;
let H2_DEFAULT_MAX_FRAME = 16384;

// HPACK static table (first 61 entries per RFC 7541 Appendix A)
let H2_STATIC_TABLE_SIZE = 61;
let h2_static_names = [
    "", ":authority", ":method", ":method", ":path", ":path",
    ":scheme", ":scheme", ":status", ":status", ":status",
    ":status", ":status", ":status", ":status",
    "accept-charset", "accept-encoding", "accept-language",
    "accept-ranges", "accept", "access-control-allow-origin",
    "age", "allow", "authorization", "cache-control",
    "content-disposition", "content-encoding", "content-language",
    "content-length", "content-location", "content-range",
    "content-type", "cookie", "date", "etag", "expect",
    "expires", "from", "host", "if-match", "if-modified-since",
    "if-none-match", "if-range", "if-unmodified-since",
    "last-modified", "link", "location", "max-forwards",
    "proxy-authenticate", "proxy-authorization", "range",
    "referer", "refresh", "retry-after", "server",
    "set-cookie", "strict-transport-security", "transfer-encoding",
    "user-agent", "vary", "via", "www-authenticate"
];
let h2_static_vals = [
    "", "", "GET", "POST", "/", "/index.html",
    "http", "https", "200", "204", "206",
    "304", "400", "404", "500",
    "", "gzip, deflate", "",
    "bytes", "", "",
    "", "", "", "",
    "", "", "",
    "", "", "",
    "", "", "", "", "",
    "", "", "", "", "",
    "", "", "",
    "", "", "", "",
    "", "", "",
    "", "", "", "",
    "", "", "",
    "", "", "", ""
];

// Connection state
let h2_conn_state       = 0;   // 0=idle, 1=preface, 2=open, 3=closed
let h2_next_stream_id   = 1;   // client odd, server even
let h2_last_stream_id   = 0;
let h2_recv_window      = H2_INITIAL_WINDOW;
let h2_send_window      = H2_INITIAL_WINDOW;
let h2_peer_max_frame   = H2_DEFAULT_MAX_FRAME;
let h2_frame_count      = 0;
let h2_request_count    = 0;
let h2_initialized      = 0;

// Stream table
let h2_stream_state     = [];
let h2_stream_window    = [];
let h2_stream_weight    = [];
let h2_stream_headers   = [];
let h2_stream_data      = [];

// HPACK dynamic table
let h2_dyn_table_names  = [];
let h2_dyn_table_vals   = [];
let h2_dyn_table_count  = 0;
let h2_dyn_table_size   = 0;
let h2_max_table_size   = H2_MAX_HEADER_TABLE;

// Settings
let h2_settings_header_table_size = 4096;
let h2_settings_enable_push       = 1;
let h2_settings_max_streams       = 100;
let h2_settings_init_window       = 65535;
let h2_settings_max_frame         = 16384;
let h2_settings_max_header_list   = 8192;

// Last parsed frame
let h2_last_frame_type    = 0;
let h2_last_frame_flags   = 0;
let h2_last_frame_stream  = 0;
let h2_last_frame_payload = [];
let h2_last_frame_len     = 0;

fn http2_init() {
    h2_conn_state      = 0;
    h2_next_stream_id  = 1;
    h2_last_stream_id  = 0;
    h2_recv_window     = H2_INITIAL_WINDOW;
    h2_send_window     = H2_INITIAL_WINDOW;
    h2_frame_count     = 0;
    h2_request_count   = 0;
    h2_dyn_table_count = 0;
    h2_dyn_table_size  = 0;
    let i = 0;
    while i < H2_MAX_STREAMS {
        set_at(h2_stream_state,  i, H2_STREAM_IDLE);
        set_at(h2_stream_window, i, H2_INITIAL_WINDOW);
        set_at(h2_stream_weight, i, 16);
        set_at(h2_stream_headers, i, "");
        set_at(h2_stream_data,   i, "");
        i = i + 1;
    }
    h2_initialized = 1;
    return 0;
}

// Read 24-bit big-endian (frame length field)
fn _h2_read24_be(data, pos) {
    return data[pos] * 65536 + data[pos+1] * 256 + data[pos+2];
}

// Read 32-bit big-endian (stream ID: top bit is reserved)
fn _h2_read32_be(data, pos) {
    let v = data[pos] * 16777216 + data[pos+1] * 65536
          + data[pos+2] * 256 + data[pos+3];
    // Clear reserved bit (bit 31)
    if v >= 2147483648 { v = v - 2147483648; }
    return v;
}

// Write 24-bit big-endian
fn _h2_write24_be(val) {
    return [(val / 65536) - ((val / 16777216) * 256),
            (val / 256)   - ((val / 65536)   * 256),
            val           - ((val / 256)      * 256)];
}

// Write 32-bit big-endian
fn _h2_write32_be(val) {
    return [(val / 16777216) - ((val / 4294967296) * 256),
            (val / 65536)    - ((val / 16777216)   * 256),
            (val / 256)      - ((val / 65536)       * 256),
            val              - ((val / 256)          * 256)];
}

// Build 9-byte HTTP/2 frame header
fn h2_build_frame_header(length, frame_type, flags, stream_id) {
    let hdr = [0, 0, 0, 0, 0, 0, 0, 0, 0];
    let lb = _h2_write24_be(length);
    set_at(hdr, 0, lb[0]); set_at(hdr, 1, lb[1]); set_at(hdr, 2, lb[2]);
    set_at(hdr, 3, frame_type);
    set_at(hdr, 4, flags);
    let sid = _h2_write32_be(stream_id);
    set_at(hdr, 5, sid[0]); set_at(hdr, 6, sid[1]);
    set_at(hdr, 7, sid[2]); set_at(hdr, 8, sid[3]);
    return hdr;
}

// Parse HTTP/2 frame from raw bytes, store in h2_last_frame_*
fn h2_parse_frame(data, pos) {
    if len(data) - pos < 9 { return 0 - 1; }
    let length    = _h2_read24_be(data, pos);
    let ftype     = data[pos + 3];
    let flags     = data[pos + 4];
    let stream_id = _h2_read32_be(data, pos + 5);
    h2_last_frame_type   = ftype;
    h2_last_frame_flags  = flags;
    h2_last_frame_stream = stream_id;
    h2_last_frame_len    = length;
    h2_last_frame_payload = [];
    let i = 0;
    while i < length {
        if pos + 9 + i < len(data) {
            set_at(h2_last_frame_payload, i, data[pos + 9 + i]);
        }
        i = i + 1;
    }
    h2_frame_count = h2_frame_count + 1;
    return 9 + length;   // total bytes consumed
}

// Build SETTINGS frame (empty or with values)
fn h2_build_settings(ack) {
    let flags = 0;
    if ack == 1 { flags = H2_FLAG_ACK; }
    if ack == 1 {
        return h2_build_frame_header(0, H2_FRAME_SETTINGS, flags, 0);
    }
    // Send 6 settings (6 × 6 bytes = 36 bytes payload)
    let payload = [];
    let settings = [
        [H2_SETTINGS_HEADER_TABLE_SIZE,      h2_settings_header_table_size],
        [H2_SETTINGS_ENABLE_PUSH,            h2_settings_enable_push],
        [H2_SETTINGS_MAX_CONCURRENT_STREAMS, h2_settings_max_streams],
        [H2_SETTINGS_INITIAL_WINDOW_SIZE,    h2_settings_init_window],
        [H2_SETTINGS_MAX_FRAME_SIZE,         h2_settings_max_frame],
        [H2_SETTINGS_MAX_HEADER_LIST_SIZE,   h2_settings_max_header_list]
    ];
    let i = 0;
    while i < 6 {
        let id  = settings[i][0];
        let val = settings[i][1];
        set_at(payload, i * 6,     (id / 256) - ((id / 65536) * 256));
        set_at(payload, i * 6 + 1, id - ((id / 256) * 256));
        let vb = _h2_write32_be(val);
        set_at(payload, i * 6 + 2, vb[0]);
        set_at(payload, i * 6 + 3, vb[1]);
        set_at(payload, i * 6 + 4, vb[2]);
        set_at(payload, i * 6 + 5, vb[3]);
        i = i + 1;
    }
    let hdr = h2_build_frame_header(36, H2_FRAME_SETTINGS, 0, 0);
    return [hdr, payload];
}

// Build PING frame (8-byte opaque data)
fn h2_build_ping(opaque_data, ack) {
    let flags = 0;
    if ack == 1 { flags = H2_FLAG_ACK; }
    let hdr = h2_build_frame_header(8, H2_FRAME_PING, flags, 0);
    return [hdr, opaque_data];
}

// Build WINDOW_UPDATE frame
fn h2_build_window_update(stream_id, increment) {
    let hdr = h2_build_frame_header(4, H2_FRAME_WINDOW_UPDATE, 0, stream_id);
    let payload = _h2_write32_be(increment);
    return [hdr, payload];
}

// Build RST_STREAM frame
fn h2_build_rst_stream(stream_id, error_code) {
    let hdr = h2_build_frame_header(4, H2_FRAME_RST_STREAM, 0, stream_id);
    let payload = _h2_write32_be(error_code);
    return [hdr, payload];
}

// Build GOAWAY frame
fn h2_build_goaway(last_stream_id, error_code) {
    let hdr = h2_build_frame_header(8, H2_FRAME_GOAWAY, 0, 0);
    let p1 = _h2_write32_be(last_stream_id);
    let p2 = _h2_write32_be(error_code);
    return [hdr, p1, p2];
}

// HPACK: lookup in static table (1-indexed)
fn h2_hpack_static_lookup(idx) {
    if idx < 1 { return ["", ""]; }
    if idx > H2_STATIC_TABLE_SIZE { return ["", ""]; }
    return [h2_static_names[idx], h2_static_vals[idx]];
}

// HPACK: add to dynamic table (evict entries if needed)
fn h2_hpack_add_dynamic(name, val) {
    let entry_size = len(name) + len(val) + 32;
    while h2_dyn_table_size + entry_size > h2_max_table_size {
        if h2_dyn_table_count == 0 { entry_size = h2_max_table_size + 1; }
        if h2_dyn_table_count > 0 {
            // Evict oldest entry (last in dynamic table)
            let last = h2_dyn_table_count - 1;
            let evict_size = len(h2_dyn_table_names[last]) + len(h2_dyn_table_vals[last]) + 32;
            h2_dyn_table_size  = h2_dyn_table_size - evict_size;
            h2_dyn_table_count = h2_dyn_table_count - 1;
        }
    }
    if entry_size <= h2_max_table_size {
        // Prepend new entry
        set_at(h2_dyn_table_names, h2_dyn_table_count, name);
        set_at(h2_dyn_table_vals,  h2_dyn_table_count, val);
        h2_dyn_table_count = h2_dyn_table_count + 1;
        h2_dyn_table_size  = h2_dyn_table_size + entry_size;
    }
    return 0;
}

// HPACK: encode a single header field (literal with incremental indexing)
fn h2_hpack_encode_header(name, val) {
    // Use literal header field with incremental indexing (prefix 01xxxxxx)
    let encoded = [];
    // 0x40 = literal with incremental indexing, new name
    set_at(encoded, 0, 64);  // 0x40
    // Length-prefixed name
    set_at(encoded, 1, len(name));
    let i = 0;
    while i < len(name) {
        set_at(encoded, 2 + i, name[i]);
        i = i + 1;
    }
    let name_end = 2 + len(name);
    // Length-prefixed value
    set_at(encoded, name_end, len(val));
    i = 0;
    while i < len(val) {
        set_at(encoded, name_end + 1 + i, val[i]);
        i = i + 1;
    }
    return encoded;
}

// HPACK: encode indexed header (static table reference)
fn h2_hpack_encode_indexed(static_idx) {
    // Indexed Header Field Representation: 1xxxxxxx
    return [128 + static_idx];
}

// Build HEADERS frame for HTTP/2 request
fn h2_build_request(method, path, scheme, authority, stream_id) {
    let hpack_block = [];
    let idx = 0;
    // :method
    if method == "GET"  { let e = h2_hpack_encode_indexed(2); set_at(hpack_block, idx, e[0]); idx = idx + 1; }
    else if method == "POST" { let e = h2_hpack_encode_indexed(3); set_at(hpack_block, idx, e[0]); idx = idx + 1; }
    else {
        let e = h2_hpack_encode_header(":method", method);
        let ei = 0; while ei < len(e) { set_at(hpack_block, idx, e[ei]); idx = idx + 1; ei = ei + 1; }
    }
    // :path
    if path == "/" { let e = h2_hpack_encode_indexed(4); set_at(hpack_block, idx, e[0]); idx = idx + 1; }
    else {
        let e = h2_hpack_encode_header(":path", path);
        let ei = 0; while ei < len(e) { set_at(hpack_block, idx, e[ei]); idx = idx + 1; ei = ei + 1; }
    }
    // :scheme http
    if scheme == "http" { let e = h2_hpack_encode_indexed(6); set_at(hpack_block, idx, e[0]); idx = idx + 1; }
    else { let e = h2_hpack_encode_indexed(7); set_at(hpack_block, idx, e[0]); idx = idx + 1; }
    // :authority
    let ea = h2_hpack_encode_header(":authority", authority);
    let ei = 0; while ei < len(ea) { set_at(hpack_block, idx, ea[ei]); idx = idx + 1; ei = ei + 1; }
    let hdr = h2_build_frame_header(idx, H2_FRAME_HEADERS, H2_FLAG_END_HEADERS, stream_id);
    // Open stream
    if stream_id < H2_MAX_STREAMS {
        set_at(h2_stream_state, stream_id, H2_STREAM_OPEN);
        set_at(h2_stream_headers, stream_id, method + " " + path);
    }
    h2_request_count = h2_request_count + 1;
    h2_last_stream_id = stream_id;
    return [hdr, hpack_block];
}

// Allocate next stream ID (client: odd numbers)
fn h2_alloc_stream() {
    let sid = h2_next_stream_id;
    h2_next_stream_id = h2_next_stream_id + 2;
    return sid;
}

// Process received SETTINGS frame payload
fn h2_process_settings(payload) {
    let n = len(payload) / 6;
    let i = 0;
    while i < n {
        let id  = payload[i * 6] * 256 + payload[i * 6 + 1];
        let val = payload[i * 6 + 2] * 16777216
                + payload[i * 6 + 3] * 65536
                + payload[i * 6 + 4] * 256
                + payload[i * 6 + 5];
        if id == H2_SETTINGS_HEADER_TABLE_SIZE      { h2_settings_header_table_size = val; h2_max_table_size = val; }
        if id == H2_SETTINGS_ENABLE_PUSH            { h2_settings_enable_push = val; }
        if id == H2_SETTINGS_MAX_CONCURRENT_STREAMS { h2_settings_max_streams = val; }
        if id == H2_SETTINGS_INITIAL_WINDOW_SIZE    { h2_settings_init_window = val; h2_send_window = val; }
        if id == H2_SETTINGS_MAX_FRAME_SIZE         { h2_settings_max_frame = val; h2_peer_max_frame = val; }
        if id == H2_SETTINGS_MAX_HEADER_LIST_SIZE   { h2_settings_max_header_list = val; }
        i = i + 1;
    }
    return 0;
}

fn h2_stream_info(sid) {
    if sid >= H2_MAX_STREAMS { return "h2: invalid stream"; }
    let state_str = "idle";
    let s = h2_stream_state[sid];
    if s == H2_STREAM_OPEN        { state_str = "open"; }
    if s == H2_STREAM_HALF_CLOSED { state_str = "half-closed"; }
    if s == H2_STREAM_CLOSED      { state_str = "closed"; }
    return "h2 stream[" + to_string(sid) + "]: " + state_str
        + " window=" + to_string(h2_stream_window[sid])
        + " req=" + h2_stream_headers[sid];
}

fn h2_status() {
    return "http2: frames=" + to_string(h2_frame_count)
        + " requests=" + to_string(h2_request_count)
        + " next_stream=" + to_string(h2_next_stream_id)
        + " send_window=" + to_string(h2_send_window)
        + " dyn_headers=" + to_string(h2_dyn_table_count);
}

fn http2_test() {
    http2_init();
    // Test SETTINGS frame build
    let settings_frame = h2_build_settings(0);
    let settings_ack = h2_build_settings(1);
    // Test stream allocation and HEADERS
    let sid1 = h2_alloc_stream();
    let req1 = h2_build_request("GET", "/", "https", "example.com", sid1);
    let sid2 = h2_alloc_stream();
    let req2 = h2_build_request("POST", "/api/data", "https", "api.example.com", sid2);
    // Test PING
    let ping = h2_build_ping([0,0,0,0,1,2,3,4], 0);
    // Test WINDOW_UPDATE
    let wupd = h2_build_window_update(sid1, 32768);
    // Test GOAWAY
    let goaway = h2_build_goaway(sid2, H2_ERR_NO_ERROR);
    // Test HPACK dynamic table
    h2_hpack_add_dynamic("x-custom-header", "custom-value");
    let frame_hdr = h2_build_frame_header(100, H2_FRAME_DATA, H2_FLAG_END_STREAM, sid1);
    print("http2 test: " + h2_status());
    print("http2 test: " + h2_stream_info(sid1));
    return "http2: streams=" + to_string(h2_next_stream_id / 2 - 1)
        + " HPACK dyn=" + to_string(h2_dyn_table_count)
        + " [RFC 7540 + RFC 7541 ok]";
}

print("http2.hl loaded -- HTTP/2 (RFC 7540) + HPACK header compression (RFC 7541)");
