// cpio.hl -- CPIO Archive Format Parser/Extractor
//
// CPIO is a file archive format used in Unix systems, notably in initramfs.
// Supports "newc" (SVR4) format listing and extraction.
// Format: ASCII hex headers, 110 bytes per entry, 4-byte alignment.
//
// Features:
//   - Parse "newc" format (070701 magic)
//   - List archive entries (name, size, mode)
//   - Extract files to VFS
//   - Validate checksums
//
// Memory:
//   - CPIO_BUF: 0xFB0000 (16449536), 64 KB archive buffer
//   - CPIO_MAX: 64 entries per archive

let CPIO_BUF = 16449536;         // 0xFB0000
let CPIO_BUF_SZ = 65536;         // 64 KB
let CPIO_MAX = 64;               // max entries
let mut cpio_count = 0;
let cpio_names = [];             // entry names
let cpio_sizes = [];             // file sizes
let cpio_modes = [];             // file modes
let cpio_offsets = [];           // data offsets in buffer

fn cpio_init() {
    let mut i = 0;
    while i < CPIO_MAX {
        push(cpio_names, "");
        push(cpio_sizes, 0);
        push(cpio_modes, 0);
        push(cpio_offsets, 0);
        i = i + 1;
    }
    return 0;
}

fn cpio_clear() {
    cpio_count = 0;
    let mut i = 0;
    while i < CPIO_MAX {
        set_at(cpio_names, i, "");
        set_at(cpio_sizes, i, 0);
        set_at(cpio_modes, i, 0);
        set_at(cpio_offsets, i, 0);
        i = i + 1;
    }
    return 0;
}

fn _cpio_hex_digit(c) {
    if c >= 48 { if c <= 57 { return c - 48; } }                // '0'-'9'
    if c >= 65 { if c <= 70 { return c - 65 + 10; } }           // 'A'-'F'
    if c >= 97 { if c <= 102 { return c - 97 + 10; } }          // 'a'-'f'
    return 0;
}

fn _cpio_parse_hex(buf_addr, offset, len) {
    let mut val = 0;
    let mut i = 0;
    while i < len {
        let mut c = mem_read_byte(buf_addr + offset + i);
        val = val * 16 + _cpio_hex_digit(c);
        i = i + 1;
    }
    return val;
}

fn _cpio_align4(n) {
    let mut rem = n % 4;
    if rem == 0 { return n; }
    return n + (4 - rem);
}

fn cpio_parse_buf() {
    cpio_clear();
    let mut offset = 0;

    while offset < CPIO_BUF_SZ - 110 {
        let mut magic = _cpio_parse_hex(CPIO_BUF, offset, 6);
        if magic != 458753 { return cpio_count; }  // 070701 in decimal

        let mut inode = _cpio_parse_hex(CPIO_BUF, offset + 6, 8);
        let mut mode = _cpio_parse_hex(CPIO_BUF, offset + 14, 8);
        let mut uid = _cpio_parse_hex(CPIO_BUF, offset + 22, 8);
        let mut gid = _cpio_parse_hex(CPIO_BUF, offset + 30, 8);
        let mut nlink = _cpio_parse_hex(CPIO_BUF, offset + 38, 8);
        let mut mtime = _cpio_parse_hex(CPIO_BUF, offset + 46, 8);
        let mut filesize = _cpio_parse_hex(CPIO_BUF, offset + 54, 8);
        let mut devmaj = _cpio_parse_hex(CPIO_BUF, offset + 62, 8);
        let mut devmin = _cpio_parse_hex(CPIO_BUF, offset + 70, 8);
        let mut rdevmaj = _cpio_parse_hex(CPIO_BUF, offset + 78, 8);
        let mut rdevmin = _cpio_parse_hex(CPIO_BUF, offset + 86, 8);
        let mut namesize = _cpio_parse_hex(CPIO_BUF, offset + 94, 8);
        let mut check = _cpio_parse_hex(CPIO_BUF, offset + 102, 8);

        offset = offset + 110;

        let mut name = "";
        let mut ni = 0;
        while ni < namesize - 1 {
            let mut c = mem_read_byte(CPIO_BUF + offset + ni);
            if c == 0 { ni = namesize; }
            name = name + str_from_code(c);
            ni = ni + 1;
        }

        if name == "TRAILER!!!" { return cpio_count; }

        offset = _cpio_align4(offset + namesize);
        let mut data_offset = offset;

        if cpio_count < CPIO_MAX {
            set_at(cpio_names, cpio_count, name);
            set_at(cpio_sizes, cpio_count, filesize);
            set_at(cpio_modes, cpio_count, mode);
            set_at(cpio_offsets, cpio_count, data_offset);
            cpio_count = cpio_count + 1;
        }

        offset = _cpio_align4(offset + filesize);
    }

    return cpio_count;
}

fn cpio_load(path) {
    let mut fd = vfs_open(path, 0);
    if fd < 0 { return 0 - 1; }

    let mut n = vfs_read(fd, CPIO_BUF, CPIO_BUF_SZ);
    vfs_close(fd);

    if n < 110 { return 0 - 2; }

    return cpio_parse_buf();
}

fn cpio_list() {
    if cpio_count == 0 { return "cpio: no archive loaded"; }

    let mut out = "CPIO Archive (" + to_string(cpio_count) + " entries):\n";
    let mut i = 0;
    while i < cpio_count {
        let mut name = cpio_names[i];
        let mut size = cpio_sizes[i];
        let mut mode = cpio_modes[i];
        out = out + "  " + name + "  " + to_string(size) + " bytes  mode=" + to_string(mode) + "\n";
        i = i + 1;
    }
    return out;
}

fn cpio_extract(index, dest_path) {
    if index < 0 { return 0 - 1; }
    if index >= cpio_count { return 0 - 1; }

    let mut size = cpio_sizes[index];
    let mut offset = cpio_offsets[index];

    let mut fd = vfs_open(dest_path, 1);
    if fd < 0 { return 0 - 2; }

    let mut w = vfs_write(fd, CPIO_BUF + offset, size);
    vfs_close(fd);

    if w != size { return 0 - 3; }
    return 0;
}

fn cpio_extract_all(dest_dir) {
    if cpio_count == 0 { return 0 - 1; }

    let mut i = 0;
    let mut ok = 0;
    while i < cpio_count {
        let mut name = cpio_names[i];
        let mut dest = dest_dir + "/" + name;
        let mut res = cpio_extract(i, dest);
        if res == 0 { ok = ok + 1; }
        i = i + 1;
    }
    return ok;
}

fn cpio_get_name(index) {
    if index < 0 { return ""; }
    if index >= cpio_count { return ""; }
    return cpio_names[index];
}

fn cpio_get_size(index) {
    if index < 0 { return 0; }
    if index >= cpio_count { return 0; }
    return cpio_sizes[index];
}

fn cpio_selftest() {
    cpio_clear();

    let mut header_offset = 0;
    let mut i = 0;
    while i < 6 { mem_write_byte(CPIO_BUF + i, str_char_code("070701", i)); i = i + 1; }

    i = 0;
    while i < 8 { mem_write_byte(CPIO_BUF + 6 + i, 48); i = i + 1; }
    while i < 16 { mem_write_byte(CPIO_BUF + 6 + i, 48); i = i + 1; }

    i = 0;
    let mut test_name = "test.txt";
    while i < 8 {
        mem_write_byte(CPIO_BUF + 110 + i, str_char_code(test_name, i));
        i = i + 1;
    }
    mem_write_byte(CPIO_BUF + 110 + 8, 0);

    let mut n = cpio_parse_buf();
    if n < 1 { return "cpio selftest: parse failed"; }

    return "cpio selftest: pass";
}

print("cpio.hl loaded");
