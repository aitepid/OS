// pipe.hl -- Kernel Pipe (Lock-Free SPSC Ring Buffer)
//
// Iteration 99: upgraded from per-byte metadata updates to batch
// memcpy + lock-free single-producer/single-consumer ring buffer.
//
// Design:
//   Each pipe: 4096-byte ring buffer in fixed memory
//   Writer owns write_pos, reader owns read_pos (no locks needed)
//   Available bytes = (write_pos - read_pos + BUF_LEN) % BUF_LEN
//   pipe_write_batch: copies min(available_space, length) bytes at once
//   pipe_read_batch: copies min(available_data, max_len) bytes at once
//   Falls back to single-byte for small transfers
//
// Public API (preserved + new):
//   pipe_create / pipe_write / pipe_read / pipe_close / pipe_available
//   pipe_write_batch / pipe_read_batch / pipe_status (new)

let PIPE_MAX = 32;
let PIPE_BUF_LEN = 4096;
let PIPE_META_ADDR = 9371648;   // 0x8F0000
let PIPE_DATA_BASE = 9437184;   // 0x900000

// Pipe metadata (48 bytes):
//   +0:  active (8)
//   +8:  read_pos (8)   -- owned by reader
//   +16: write_pos (8)  -- owned by writer
//   +24: ref_read (8)   -- reader end open count
//   +32: ref_write (8)  -- writer end open count
//   +40: total_bytes (8) -- lifetime bytes written (stats)

fn pipe_meta_addr(id) { return PIPE_META_ADDR + id * 48; }
fn pipe_data_addr(id) { return PIPE_DATA_BASE + id * PIPE_BUF_LEN; }

fn pipe_create() {
    let mut i = 0;
    while i < PIPE_MAX {
        let mut addr = pipe_meta_addr(i);
        if mem_read_u64(addr) == 0 {
            mem_write_u64(addr, 1);       // active
            mem_write_u64(addr + 8, 0);   // read_pos
            mem_write_u64(addr + 16, 0);  // write_pos
            mem_write_u64(addr + 24, 1);  // ref_read
            mem_write_u64(addr + 32, 1);  // ref_write
            mem_write_u64(addr + 40, 0);  // total_bytes
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

// ============================================================
// Lock-free available / space calculations
// ============================================================

fn pipe_available(id) {
    let mut meta = pipe_meta_addr(id);
    let mut rp = mem_read_u64(meta + 8);
    let mut wp = mem_read_u64(meta + 16);
    return (wp - rp + PIPE_BUF_LEN) % PIPE_BUF_LEN;
}

fn _pipe_space(id) {
    return PIPE_BUF_LEN - 1 - pipe_available(id);
}

// ============================================================
// Batch write: copy up to space-available bytes in one pass
// ============================================================

fn pipe_write_batch(id, data, length) {
    let mut meta = pipe_meta_addr(id);
    let mut buf = pipe_data_addr(id);
    let mut space = _pipe_space(id);
    let mut to_write = length;
    if to_write > space { to_write = space; }
    if to_write == 0 { return 0; }

    let mut wp = mem_read_u64(meta + 16);

    // Contiguous chunk from wp to end of buffer
    let mut chunk1 = PIPE_BUF_LEN - wp;
    let mut first = to_write;
    if first > chunk1 { first = chunk1; }

    // Copy first chunk
    let mut i = 0;
    while i < first {
        if i >= len(data) { break; }
        mem_write_u8(buf + wp + i, data[i]);
        i = i + 1;
    }

    // Wrap-around chunk
    if to_write > first {
        let mut second = to_write - first;
        let mut j = 0;
        while j < second {
            mem_write_u8(buf + j, data[first + j]);
            j = j + 1;
        }
    }

    // Update write_pos (single atomic store)
    mem_write_u64(meta + 16, (wp + to_write) % PIPE_BUF_LEN);
    // Stats
    mem_write_u64(meta + 40, mem_read_u64(meta + 40) + to_write);
    return to_write;
}

// ============================================================
// Batch read: copy up to available bytes in one pass
// ============================================================

fn pipe_read_batch(id, buf_out, max_len) {
    let mut meta = pipe_meta_addr(id);
    let mut buf = pipe_data_addr(id);
    let mut avail = pipe_available(id);
    let mut to_read = max_len;
    if to_read > avail { to_read = avail; }
    if to_read == 0 { return 0; }

    let mut rp = mem_read_u64(meta + 8);

    // Contiguous chunk
    let mut chunk1 = PIPE_BUF_LEN - rp;
    let mut first = to_read;
    if first > chunk1 { first = chunk1; }

    let mut i = 0;
    while i < first {
        if i >= len(buf_out) { break; }
        set_at(buf_out, i, mem_read_u8(buf + rp + i));
        i = i + 1;
    }

    // Wrap-around
    if to_read > first {
        let mut second = to_read - first;
        let mut j = 0;
        while j < second {
            set_at(buf_out, first + j, mem_read_u8(buf + j));
            j = j + 1;
        }
    }

    // Update read_pos
    mem_write_u64(meta + 8, (rp + to_read) % PIPE_BUF_LEN);
    return to_read;
}

// ============================================================
// Compat: single-byte wrappers (call batch internally)
// ============================================================

fn pipe_write(id, data, length) {
    return pipe_write_batch(id, data, length);
}

fn pipe_read(id, buf_out, max_len) {
    return pipe_read_batch(id, buf_out, max_len);
}

// ============================================================
// Close / status
// ============================================================

fn pipe_close(id) {
    let mut meta = pipe_meta_addr(id);
    mem_write_u64(meta, 0);
    return 0;
}

fn pipe_close_read(id) {
    let mut meta = pipe_meta_addr(id);
    let mut refs = mem_read_u64(meta + 24);
    if refs > 0 { mem_write_u64(meta + 24, refs - 1); }
    if mem_read_u64(meta + 24) == 0 {
        if mem_read_u64(meta + 32) == 0 { pipe_close(id); }
    }
    return 0;
}

fn pipe_close_write(id) {
    let mut meta = pipe_meta_addr(id);
    let mut refs = mem_read_u64(meta + 32);
    if refs > 0 { mem_write_u64(meta + 32, refs - 1); }
    if mem_read_u64(meta + 32) == 0 {
        if mem_read_u64(meta + 24) == 0 { pipe_close(id); }
    }
    return 0;
}

fn pipe_status() {
    let mut active = 0;
    let mut total = 0;
    let mut i = 0;
    while i < PIPE_MAX {
        let mut addr = pipe_meta_addr(i);
        if mem_read_u64(addr) == 1 {
            active = active + 1;
            total = total + mem_read_u64(addr + 40);
        }
        i = i + 1;
    }
    return "pipes: " + to_string(active) + "/" + to_string(PIPE_MAX) + " active, " + to_string(total) + " bytes lifetime";
}

print("pipe.hl loaded (SPSC ring buffer)");
print("Pipes: " + to_string(PIPE_MAX) + " x " + to_string(PIPE_BUF_LEN) + "B, batch read/write");
