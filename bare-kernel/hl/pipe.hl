// pipe.hl -- Kernel Pipe Implementation (Byte-Stream IPC)
//
// Ring-buffer based pipes for inter-process communication.
// Each pipe: 4096-byte buffer, read_pos, write_pos, read_count, write_count.
// Blocking semantics: reader blocks if empty, writer blocks if full.
//
// Used by: posix.hl (sys_pipe), shell.hl (command piping)

let PIPE_MAX = 32;
let PIPE_BUF_LEN = 4096;
let PIPE_META_ADDR = 9371648;   // 0x8F0000 -- 32 pipes * 32 bytes metadata
let PIPE_DATA_BASE = 9437184;   // 0x900000 -- 32 pipes * 4096 bytes data

// Pipe metadata (32 bytes):
//   +0:  active (8)  -- 0=free, 1=active
//   +8:  read_pos (8)
//   +16: write_pos (8)
//   +24: count (8)   -- bytes currently in buffer

fn pipe_meta_addr(id) { return PIPE_META_ADDR + id * 32; }
fn pipe_data_addr(id) { return PIPE_DATA_BASE + id * PIPE_BUF_LEN; }

fn pipe_create() {
    let mut i = 0;
    while i < PIPE_MAX {
        let addr = pipe_meta_addr(i);
        let active = mem_read_u64(addr);
        if active == 0 {
            mem_write_u64(addr, 1);      // active
            mem_write_u64(addr+8, 0);    // read_pos
            mem_write_u64(addr+16, 0);   // write_pos
            mem_write_u64(addr+24, 0);   // count
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

fn pipe_write(id, data, length) {
    let meta = pipe_meta_addr(id);
    let buf = pipe_data_addr(id);
    let mut written = 0;
    while written < length {
        let count = mem_read_u64(meta + 24);
        if count >= PIPE_BUF_LEN {
            return written; // buffer full
        }
        let wp = mem_read_u64(meta + 16);
        mem_write_byte(buf + wp, data[written]);
        mem_write_u64(meta + 16, (wp + 1) % PIPE_BUF_LEN);
        mem_write_u64(meta + 24, count + 1);
        written = written + 1;
    }
    return written;
}

fn pipe_read(id, buf_out, max_len) {
    let meta = pipe_meta_addr(id);
    let buf = pipe_data_addr(id);
    let mut rd = 0;
    while rd < max_len {
        let count = mem_read_u64(meta + 24);
        if count == 0 {
            return rd; // buffer empty
        }
        let rp = mem_read_u64(meta + 8);
        set_at(buf_out, rd, mem_read_byte(buf + rp));
        mem_write_u64(meta + 8, (rp + 1) % PIPE_BUF_LEN);
        mem_write_u64(meta + 24, count - 1);
        rd = rd + 1;
    }
    return rd;
}

fn pipe_close(id) {
    let meta = pipe_meta_addr(id);
    mem_write_u64(meta, 0); // inactive
    return 0;
}

fn pipe_available(id) {
    let meta = pipe_meta_addr(id);
    return mem_read_u64(meta + 24);
}

print("pipe.hl loaded");
print("Pipes: " + to_string(PIPE_MAX) + " x " + to_string(PIPE_BUF_LEN) + " bytes ring buffer");
