// shell_notification.hl -- 通知中心（Sprint G5）
//
// 右上角悬浮 toast 列表 + 完整侧栏视图。每条通知有标题、正文、时间戳，
// 自动 6s 后淡出。点击顶栏时钟打开完整通知中心。

let NOTIF_MAX           = 32;
let NOTIF_TOAST_W       = 360;
let NOTIF_TOAST_H       = 72;
let NOTIF_AUTO_MS       = 6000;
let NOTIF_FADE_MS       = 500;

let mut notif_initialized = 0;
let mut notif_title       = [0];
let mut notif_body        = [0];
let mut notif_ts          = [0];
let mut notif_active      = [0];
let mut notif_count       = 0;
let mut notif_center_visible = 0;

fn shell_notification_init() {
    if notif_initialized == 1 { return 0; }
    notif_title  = array_new(NOTIF_MAX, 0);
    notif_body   = array_new(NOTIF_MAX, 0);
    notif_ts     = array_new(NOTIF_MAX, 0);
    notif_active = array_new(NOTIF_MAX, 0);
    notif_count = 0;
    notif_initialized = 1;
    print("shell_notification: ready");
    return 0;
}

fn shell_notification_push(title_addr, body_addr) {
    if notif_initialized == 0 { shell_notification_init(); }
    let mut i = 0;
    while i < NOTIF_MAX {
        if notif_active[i] == 0 {
            notif_active[i] = 1;
            notif_title[i]  = title_addr;
            notif_body[i]   = body_addr;
            notif_ts[i]     = get_ticks() * 10;
            if i + 1 > notif_count { notif_count = i + 1; }
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

fn shell_notification_center_show()    { notif_center_visible = 1; return 0; }
fn shell_notification_center_hide()    { notif_center_visible = 0; return 0; }
fn shell_notification_center_toggle()  {
    if notif_center_visible == 1 { notif_center_visible = 0; }
    else                          { notif_center_visible = 1; }
    return notif_center_visible;
}

fn notif_paint_one(x, y, idx, alpha) {
    gfx_shadow_draw_n(x, y, NOTIF_TOAST_W, NOTIF_TOAST_H, 8);
    gfx_rect_round(x, y, NOTIF_TOAST_W, NOTIF_TOAST_H, 8,
                   gfx_pack(alpha,
                       gfx_color_r(ui_theme_bg_elevated()),
                       gfx_color_g(ui_theme_bg_elevated()),
                       gfx_color_b(ui_theme_bg_elevated())));
    if notif_title[idx] != 0 {
        font_atlas_draw_str(x + 12, y + 10, cstr_from_addr(notif_title[idx]),
                            15, ui_theme_text_primary());
    }
    if notif_body[idx] != 0 {
        font_atlas_draw_str(x + 12, y + 36, cstr_from_addr(notif_body[idx]),
                            13, ui_theme_text_secondary());
    }
    return 0;
}

fn shell_notification_paint_toasts(screen_w) {
    if notif_initialized == 0 { return 0; }
    let mut now = get_ticks() * 10;
    let mut visible = 0;
    let mut i = 0;
    while i < notif_count {
        if notif_active[i] == 1 {
            let mut elapsed = now - notif_ts[i];
            if elapsed >= NOTIF_AUTO_MS { notif_active[i] = 0; }
            else {
                let mut alpha = 255;
                if elapsed > NOTIF_AUTO_MS - NOTIF_FADE_MS {
                    alpha = (NOTIF_AUTO_MS - elapsed) * 255 / NOTIF_FADE_MS;
                }
                let mut tx = screen_w - NOTIF_TOAST_W - 12;
                let mut ty = shell_topbar_height() + 12 + visible * (NOTIF_TOAST_H + 8);
                notif_paint_one(tx, ty, i, alpha);
                visible = visible + 1;
            }
        }
        i = i + 1;
    }
    return 0;
}

fn shell_notification_center_paint(screen_w, screen_h) {
    if notif_center_visible == 0 { return 0; }
    let mut w = 380;
    let mut x = screen_w - w - 8;
    let mut y = shell_topbar_height() + 8;
    let mut h = screen_h - y - shell_dock_height() - 8;
    gfx_shadow_draw_n(x, y, w, h, 20);
    gfx_rect_round(x, y, w, h, 12, ui_theme_bg_elevated());
    font_atlas_draw_str(x + 16, y + 12, "Notifications", 17,
                        ui_theme_text_primary());
    let mut ry = y + 44;
    let mut i = 0;
    while i < notif_count {
        if notif_active[i] == 1 {
            notif_paint_one(x + 8, ry, i, 255);
            ry = ry + NOTIF_TOAST_H + 6;
            if ry > y + h - NOTIF_TOAST_H { i = notif_count; }
        }
        i = i + 1;
    }
    return 0;
}

print("shell_notification.hl loaded");
