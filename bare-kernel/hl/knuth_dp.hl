// knuth_dp.hl -- Knuth DP optimization: optimal stone merging O(n^2) (iter 338)
// Buffer: 0x1890000
// Merging adjacent stones; cost = sum of merged range. Quadrangle inequality
// guarantees opt[i][j-1] <= opt[i][j] <= opt[i+1][j], reducing O(n^3) to O(n^2).
// kn_w[i]: weight. kn_build(n): fill dp. kn_cost(): min total merge cost.

let KN_MAX = 16;

let kn_w   = array(16, 0);
let kn_s   = array(17, 0);    // prefix sums
let kn_dp  = array(256, 0);   // kn_dp[i*KN_MAX+j]
let kn_opt = array(256, 0);   // optimal split point
let mut kn_n   = 0;

fn kn_init() {
    kn_n = 0;
    let mut i = 0;
    while i < KN_MAX { set_at(kn_w, i, 0); i += 1; }
    return 0;
}

fn kn_build(n) {
    kn_n = n;
    set_at(kn_s, 0, 0);
    let mut i = 0;
    while i < n {
        set_at(kn_s, i + 1, kn_s[i] + kn_w[i]);
        i += 1;
    }
    i = 0;
    while i < n {
        set_at(kn_dp,  i * KN_MAX + i, 0);
        set_at(kn_opt, i * KN_MAX + i, i);
        i += 1;
    }
    let mut len = 2;
    while len <= n {
        i = 0;
        while i + len - 1 < n {
            let mut j = i + len - 1;
            set_at(kn_dp, i * KN_MAX + j, 999999);
            let mut lo = kn_opt[i * KN_MAX + (j - 1)];
            let mut hi = kn_opt[(i + 1) * KN_MAX + j];
            if hi > j - 1 { hi = j - 1; }
            let mut k = lo;
            while k <= hi {
                let mut cost = kn_dp[i * KN_MAX + k] + kn_dp[(k + 1) * KN_MAX + j]
                         + kn_s[j + 1] - kn_s[i];
                if cost < kn_dp[i * KN_MAX + j] {
                    set_at(kn_dp,  i * KN_MAX + j, cost);
                    set_at(kn_opt, i * KN_MAX + j, k);
                }
                k += 1;
            }
            i += 1;
        }
        len += 1;
    }
    return 0;
}

fn kn_cost() {
    if kn_n == 0 { return 0; }
    return kn_dp[0 * KN_MAX + kn_n - 1];
}

fn kn_dp_get(i, j) { return kn_dp[i * KN_MAX + j]; }

fn kn_test() {
    // stones [1,2,3,4]: optimal merge cost = 19
    // dp[0][1]=3, dp[1][2]=5, dp[2][3]=7
    // dp[0][2]=9, dp[1][3]=14
    // dp[0][3]=19  (split at k=2: dp[0][2]+dp[3][3]+10 = 9+0+10 = 19)
    kn_n = 4;
    set_at(kn_w, 0, 1); set_at(kn_w, 1, 2);
    set_at(kn_w, 2, 3); set_at(kn_w, 3, 4);
    kn_build(4);
    let mut c = kn_cost();
    print("kn_test: stones[1,2,3,4] cost=" + to_string(c));
    if c == 19 {
        print("kn_test: PASS");
        return 1;
    }
    print("kn_test: FAIL");
    return 0;
}

print("knuth_dp.hl loaded");
