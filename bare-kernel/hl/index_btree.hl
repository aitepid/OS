// index_btree.hl -- B-Tree Index: sorted key array + multi-RID support + range scan (iter 383)
// Buffer: 0x1B60000
// IBT_MAXKEYS=64 distinct keys; IBT_MAXRIDS=4 row IDs per key (non-unique index)
// Sorted insertion (binary-search locate, shift right) → O(n) insert, O(log n) lookup
// range_scan(lo, hi): binary search start, linear walk to hi → ibts_* output

let IBT_MAXKEYS = 64;
let IBT_MAXRIDS = 4;
let IBT_SCAN_MAX = 64;

// Sorted key array
let ibt_key    = array(64,  0);
let ibt_ridcnt = array(64,  0);   // number of rids for this key
let ibt_rid    = array(256, 0);   // ibt_rid[key_idx * 4 + rid_idx]
let ibt_n      = 0;

// Range scan output
let ibts_keys = array(64, 0);
let ibts_rids = array(64, 0);   // first rid per key
let ibts_n    = 0;

fn ibt_init() {
    ibt_n  = 0;
    ibts_n = 0;
    return 0;
}

fn _ibt_find(key) {
    // Binary search; returns index of key in ibt_key[], or -1 if absent
    let lo = 0;
    let hi = ibt_n;
    while lo < hi {
        let mid = (lo + hi) / 2;
        if ibt_key[mid] < key { lo = mid + 1; }
        else                  { hi = mid; }
    }
    if lo < ibt_n {
        if ibt_key[lo] == key { return lo; }
    }
    return 0 - 1;
}

fn _ibt_lower_bound(key) {
    // First index i such that ibt_key[i] >= key
    let lo = 0;
    let hi = ibt_n;
    while lo < hi {
        let mid = (lo + hi) / 2;
        if ibt_key[mid] < key { lo = mid + 1; }
        else                  { hi = mid; }
    }
    return lo;
}

fn ibt_insert(key, rid) {
    let pos = _ibt_find(key);
    if pos != (0 - 1) {
        // Existing key: append rid if room
        let rc = ibt_ridcnt[pos];
        if rc < IBT_MAXRIDS {
            set_at(ibt_rid, pos * IBT_MAXRIDS + rc, rid);
            set_at(ibt_ridcnt, pos, rc + 1);
        }
        return pos;
    }
    if ibt_n >= IBT_MAXKEYS { return 0 - 1; }
    // Find insert position
    let ins = _ibt_lower_bound(key);
    // Shift right
    let i = ibt_n;
    while i > ins {
        set_at(ibt_key,    i, ibt_key[i - 1]);
        set_at(ibt_ridcnt, i, ibt_ridcnt[i - 1]);
        let j = 0;
        while j < IBT_MAXRIDS {
            set_at(ibt_rid, i * IBT_MAXRIDS + j, ibt_rid[(i - 1) * IBT_MAXRIDS + j]);
            j += 1;
        }
        i -= 1;
    }
    set_at(ibt_key,    ins, key);
    set_at(ibt_ridcnt, ins, 1);
    set_at(ibt_rid, ins * IBT_MAXRIDS, rid);
    ibt_n += 1;
    return ins;
}

fn ibt_lookup(key) {
    let pos = _ibt_find(key);
    if pos == (0 - 1) { return 0 - 1; }
    return ibt_rid[pos * IBT_MAXRIDS];
}

fn ibt_rid_count(key) {
    let pos = _ibt_find(key);
    if pos == (0 - 1) { return 0; }
    return ibt_ridcnt[pos];
}

fn ibt_range_scan(lo, hi) {
    ibts_n = 0;
    let start = _ibt_lower_bound(lo);
    let i = start;
    let go = 1;
    while go == 1 {
        if i < ibt_n {
            if ibt_key[i] <= hi {
                if ibts_n < IBT_SCAN_MAX {
                    set_at(ibts_keys, ibts_n, ibt_key[i]);
                    set_at(ibts_rids, ibts_n, ibt_rid[i * IBT_MAXRIDS]);
                    ibts_n += 1;
                }
                i += 1;
            } else { go = 0; }
        } else { go = 0; }
    }
    return ibts_n;
}

fn ibt_size()   { return ibt_n; }
fn ibt_scan_n() { return ibts_n; }

fn ibt_test() {
    ibt_init();
    // Insert: keys 3,1,4,1,5,9,2,6 — key=1 has 2 rids
    ibt_insert(3, 30);
    ibt_insert(1, 10);
    ibt_insert(4, 40);
    ibt_insert(1, 11);
    ibt_insert(5, 50);
    ibt_insert(9, 90);
    ibt_insert(2, 20);
    ibt_insert(6, 60);

    let r1   = ibt_lookup(1);
    let r9   = ibt_lookup(9);
    let miss = ibt_lookup(7);
    let rc   = ibt_range_scan(2, 5);   // keys 2,3,4,5 → 4 entries
    let cnt1 = ibt_rid_count(1);

    print("ibt_test: r1=" + to_string(r1) + " r9=" + to_string(r9) + " miss=" + to_string(miss));
    print("ibt_test: range[2,5]=" + to_string(rc) + " key1_rids=" + to_string(cnt1));
    print("ibt_test: distinct_keys=" + to_string(ibt_size()));
    if r1 == 10 {
        if r9 == 90 {
            if miss == (0 - 1) {
                if rc == 4 {
                    if cnt1 == 2 {
                        print("ibt_test: PASS");
                        return 1;
                    }
                }
            }
        }
    }
    print("ibt_test: FAIL");
    return 0;
}

print("index_btree.hl loaded");
