// quoted_printable.hl -- Quoted-Printable Encoding/Decoding
//
// Quoted-Printable (QP) is a content-transfer-encoding for email (MIME).
// RFC 2045: encodes 8-bit data as 7-bit ASCII using =XX hex escaping.
//
// Features:
//   - Encode: convert bytes to =XX if non-printable or =3D
//   - Decode: convert =XX back to bytes
//   - Soft line breaks: =\n for long lines (max 76 chars)
//   - Preserves whitespace at line ends with encoding
//
// Memory:
//   - QP_BUF: 0xFC0000 (16515072), 64 KB encode/decode buffer

let QP_BUF = 16515072;           // 0xFC0000
let QP_BUF_SZ = 65536;           // 64 KB
let qp_len = 0;

fn qp_init() {
    qp_len = 0;
    return 0;
}

fn qp_clear() {
    qp_len = 0;
    return 0;
}

fn _qp_hex_digit(n) {
    if n < 10 { return 48 + n; }            // '0'-'9'
    return 65 + (n - 10);                   // 'A'-'F'
}

fn _qp_from_hex(c) {
    if c >= 48 { if c <= 57 { return c - 48; } }                // '0'-'9'
    if c >= 65 { if c <= 70 { return c - 65 + 10; } }           // 'A'-'F'
    if c >= 97 { if c <= 102 { return c - 97 + 10; } }          // 'a'-'f'
    return 0;
}

fn _qp_is_printable(c) {
    if c == 9 { return 1; }                  // tab
    if c == 32 { return 1; }                 // space
    if c >= 33 { if c <= 60 { return 1; } }  // !-<
    if c >= 62 { if c <= 126 { return 1; } } // >-~
    return 0;
}

fn qp_encode(data) {
    qp_clear();
    let mut i = 0;
    let mut line_len = 0;

    while i < len(data) {
        let mut c = str_char_code(data, i);

        if c == 61 {
            if qp_len + 3 > QP_BUF_SZ { return 0 - 1; }
            mem_write_byte(QP_BUF + qp_len, 61);
            mem_write_byte(QP_BUF + qp_len + 1, _qp_hex_digit(3));
            mem_write_byte(QP_BUF + qp_len + 2, _qp_hex_digit(13));
            qp_len = qp_len + 3;
            line_len = line_len + 3;
        } else {
            if _qp_is_printable(c) == 1 {
                if qp_len + 1 > QP_BUF_SZ { return 0 - 1; }
                mem_write_byte(QP_BUF + qp_len, c);
                qp_len = qp_len + 1;
                line_len = line_len + 1;
            } else {
                if qp_len + 3 > QP_BUF_SZ { return 0 - 1; }
                let mut hi = c / 16;
                let mut lo = c % 16;
                mem_write_byte(QP_BUF + qp_len, 61);
                mem_write_byte(QP_BUF + qp_len + 1, _qp_hex_digit(hi));
                mem_write_byte(QP_BUF + qp_len + 2, _qp_hex_digit(lo));
                qp_len = qp_len + 3;
                line_len = line_len + 3;
            }
        }

        if line_len >= 73 {
            if qp_len + 3 > QP_BUF_SZ { return 0 - 1; }
            mem_write_byte(QP_BUF + qp_len, 61);
            mem_write_byte(QP_BUF + qp_len + 1, 13);
            mem_write_byte(QP_BUF + qp_len + 2, 10);
            qp_len = qp_len + 3;
            line_len = 0;
        }

        i = i + 1;
    }

    return qp_len;
}

fn qp_decode(data) {
    qp_clear();
    let mut i = 0;

    while i < len(data) {
        let mut c = str_char_code(data, i);

        if c == 61 {
            if i + 2 < len(data) {
                let c1 = str_char_code(data, i + 1);
                let c2 = str_char_code(data, i + 2);

                if c1 == 13 {
                    if c2 == 10 {
                        i = i + 3;
                    } else {
                        i = i + 1;
                    }
                } else {
                    if c1 == 10 {
                        i = i + 2;
                    } else {
                        let mut hi = _qp_from_hex(c1);
                        let mut lo = _qp_from_hex(c2);
                        let mut val = hi * 16 + lo;
                        if qp_len >= QP_BUF_SZ { return 0 - 1; }
                        mem_write_byte(QP_BUF + qp_len, val);
                        qp_len = qp_len + 1;
                        i = i + 3;
                    }
                }
            } else {
                i = i + 1;
            }
        } else {
            if qp_len >= QP_BUF_SZ { return 0 - 1; }
            mem_write_byte(QP_BUF + qp_len, c);
            qp_len = qp_len + 1;
            i = i + 1;
        }
    }

    return qp_len;
}

fn qp_get_result() {
    let mut out = "";
    let mut i = 0;
    while i < qp_len {
        let mut c = mem_read_byte(QP_BUF + i);
        out = out + str_from_code(c);
        i = i + 1;
    }
    return out;
}

fn qp_load_encode(path) {
    let fd = vfs_open(path, 0);
    if fd < 0 { return 0 - 1; }

    let mut n = vfs_read(fd, QP_BUF, QP_BUF_SZ / 2);
    vfs_close(fd);

    if n < 0 { return 0 - 2; }

    let mut data = "";
    let mut i = 0;
    while i < n {
        let mut c = mem_read_byte(QP_BUF + i);
        data = data + str_from_code(c);
        i = i + 1;
    }

    return qp_encode(data);
}

fn qp_selftest() {
    let test_data = "Hello=World";
    let mut n = qp_encode(test_data);
    if n < 0 { return "qp selftest: encode failed"; }

    let mut result = qp_get_result();
    let expected = "Hello=3DWorld";
    if result != expected {
        return "qp selftest: mismatch (expected=" + expected + ", got=" + result + ")";
    }

    let mut m = qp_decode(result);
    if m < 0 { return "qp selftest: decode failed"; }

    let decoded = qp_get_result();
    if decoded != test_data {
        return "qp selftest: roundtrip failed";
    }

    return "qp selftest: pass";
}

print("quoted_printable.hl loaded");
