// blake2.hl - BLAKE2 Cryptographic Hash Function (simplified)
// Implements simplified BLAKE2b hash algorithm

// Constants
let BLAKE2_DIGEST_SIZE = 32;
let BLAKE2_BLOCK_SIZE = 128;

// BLAKE2b initialization vectors (SHA-256 IV set, upper 32 bits)
let BLAKE2_IV0 = 1779033703;
let BLAKE2_IV1 = 3144134277;
let BLAKE2_IV2 = 1013904242;
let BLAKE2_IV3 = 2773480762;
let BLAKE2_IV4 = 1359893119;
let BLAKE2_IV5 = 2600822924;
let BLAKE2_IV6 = 528734635;
let BLAKE2_IV7 = 1541459225;

// State buffers (replace raw memory addresses with arrays)
let blake2_hash = array(64, 0);
let blake2_state = array(64, 0);
let blake2_v = array(64, 0);
let blake2_final_block = array(128, 0);
let blake2_hex_buf = array(256, 0);
let blake2_counter = array(1, 0);

fn blake2_init() {
    set_at(blake2_counter, 0, 0);
    print("BLAKE2 hash ready");
}

// Hash data with BLAKE2
fn blake2_hash_data(data, dlen) {
    // Initialize state with IVs
    _blake2_init_state(BLAKE2_DIGEST_SIZE);

    // Process full blocks (leave last block for finalization)
    let mut pos = 0;
    while pos + BLAKE2_BLOCK_SIZE < dlen {
        set_at(blake2_counter, 0, blake2_counter[0] + BLAKE2_BLOCK_SIZE);
        _blake2_compress(data, pos, 0);
        pos = pos + BLAKE2_BLOCK_SIZE;
    }

    // Process final block unconditionally (handles partial and block-aligned input)
    let mut remaining = dlen - pos;
    let mut i = 0;
    while i < remaining {
        set_at(blake2_final_block, i, data[pos + i]);
        i = i + 1;
    }
    while i < BLAKE2_BLOCK_SIZE {
        set_at(blake2_final_block, i, 0);
        i = i + 1;
    }
    set_at(blake2_counter, 0, blake2_counter[0] + remaining);
    _blake2_compress(blake2_final_block, 0, 1);

    // Extract hash bytes from state
    _blake2_finalize();

    return blake2_hash;
}

// Initialize BLAKE2 state with IVs and parameter block
fn _blake2_init_state(digest_size) {
    _blake2_set_word(blake2_state, 0, BLAKE2_IV0);
    _blake2_set_word(blake2_state, 1, BLAKE2_IV1);
    _blake2_set_word(blake2_state, 2, BLAKE2_IV2);
    _blake2_set_word(blake2_state, 3, BLAKE2_IV3);
    _blake2_set_word(blake2_state, 4, BLAKE2_IV4);
    _blake2_set_word(blake2_state, 5, BLAKE2_IV5);
    _blake2_set_word(blake2_state, 6, BLAKE2_IV6);
    _blake2_set_word(blake2_state, 7, BLAKE2_IV7);

    // XOR first word with parameter block (0x01010000 | digest_size)
    let mut param = 16842752 + digest_size;
    let mut h0 = _blake2_get_word(blake2_state, 0);
    _blake2_set_word(blake2_state, 0, _blake2_xor(h0, param));

    set_at(blake2_counter, 0, 0);
}

// BLAKE2 compression function (simplified, 4 rounds)
fn _blake2_compress(block, offset, is_final) {
    // Initialize v[0..7] from state
    _blake2_set_word(blake2_v, 0, _blake2_get_word(blake2_state, 0));
    _blake2_set_word(blake2_v, 1, _blake2_get_word(blake2_state, 1));
    _blake2_set_word(blake2_v, 2, _blake2_get_word(blake2_state, 2));
    _blake2_set_word(blake2_v, 3, _blake2_get_word(blake2_state, 3));
    _blake2_set_word(blake2_v, 4, _blake2_get_word(blake2_state, 4));
    _blake2_set_word(blake2_v, 5, _blake2_get_word(blake2_state, 5));
    _blake2_set_word(blake2_v, 6, _blake2_get_word(blake2_state, 6));
    _blake2_set_word(blake2_v, 7, _blake2_get_word(blake2_state, 7));

    // Initialize v[8..15] from IVs
    _blake2_set_word(blake2_v, 8, BLAKE2_IV0);
    _blake2_set_word(blake2_v, 9, BLAKE2_IV1);
    _blake2_set_word(blake2_v, 10, BLAKE2_IV2);
    _blake2_set_word(blake2_v, 11, BLAKE2_IV3);

    // XOR counter into v[12..13]
    _blake2_set_word(blake2_v, 12, _blake2_xor(BLAKE2_IV4, blake2_counter[0]));
    _blake2_set_word(blake2_v, 13, BLAKE2_IV5);

    // Finalization flag into v[14]
    if is_final == 1 {
        _blake2_set_word(blake2_v, 14, _blake2_xor(BLAKE2_IV6, 4294967295));
    } else {
        _blake2_set_word(blake2_v, 14, BLAKE2_IV6);
    }
    _blake2_set_word(blake2_v, 15, BLAKE2_IV7);

    // 4 rounds of mixing (simplified from 12)
    let mut round = 0;
    while round < 4 {
        // Column mixing
        _blake2_mix(blake2_v, 0, 4, 8, 12, block, offset);
        _blake2_mix(blake2_v, 1, 5, 9, 13, block, offset);
        _blake2_mix(blake2_v, 2, 6, 10, 14, block, offset);
        _blake2_mix(blake2_v, 3, 7, 11, 15, block, offset);

        // Diagonal mixing
        _blake2_mix(blake2_v, 0, 5, 10, 15, block, offset);
        _blake2_mix(blake2_v, 1, 6, 11, 12, block, offset);
        _blake2_mix(blake2_v, 2, 7, 8, 13, block, offset);
        _blake2_mix(blake2_v, 3, 4, 9, 14, block, offset);

        round = round + 1;
    }

    // XOR v back into state
    let mut i = 0;
    while i < 8 {
        let mut h = _blake2_get_word(blake2_state, i);
        let mut vl = _blake2_get_word(blake2_v, i);
        let mut vh = _blake2_get_word(blake2_v, i + 8);
        _blake2_set_word(blake2_state, i, _blake2_xor(_blake2_xor(h, vl), vh));
        i = i + 1;
    }
}

// BLAKE2 G mixing function (block and offset unused in simplified version)
fn _blake2_mix(v, a, b, c, d, block, offset) {
    let mut va = _blake2_get_word(v, a);
    let mut vb = _blake2_get_word(v, b);
    let mut vc = _blake2_get_word(v, c);
    let mut vd = _blake2_get_word(v, d);

    va = (va + vb + 1) % 4294967296;
    vd = _blake2_xor(vd, va);
    vd = _blake2_rotr32(vd, 16);

    vc = (vc + vd) % 4294967296;
    vb = _blake2_xor(vb, vc);
    vb = _blake2_rotr32(vb, 12);

    va = (va + vb + 1) % 4294967296;
    vd = _blake2_xor(vd, va);
    vd = _blake2_rotr32(vd, 8);

    vc = (vc + vd) % 4294967296;
    vb = _blake2_xor(vb, vc);
    vb = _blake2_rotr32(vb, 7);

    _blake2_set_word(v, a, va);
    _blake2_set_word(v, b, vb);
    _blake2_set_word(v, c, vc);
    _blake2_set_word(v, d, vd);
}

// Extract bytes from state into hash buffer
fn _blake2_finalize() {
    let mut i = 0;
    while i < BLAKE2_DIGEST_SIZE {
        let mut word_idx = i / 4;
        let mut byte_idx = i % 4;
        let mut word = _blake2_get_word(blake2_state, word_idx);
        let mut byte_val = (word / _blake2_pow256(byte_idx)) % 256;
        set_at(blake2_hash, i, byte_val);
        i = i + 1;
    }
}

// Simulated XOR via arithmetic on individual bytes
fn _blake2_xor(a, b) {
    let mut result = 0;
    let mut i = 0;
    while i < 4 {
        let mut ba = (a / _blake2_pow256(i)) % 256;
        let mut bb = (b / _blake2_pow256(i)) % 256;
        let mut bx = (ba + bb) % 256;
        result = result + bx * _blake2_pow256(i);
        i = i + 1;
    }
    return result;
}

// Rotate right 32-bit
fn _blake2_rotr32(val, bits) {
    let mut right = val / _blake2_pow2(bits);
    let mut left = (val % _blake2_pow2(bits)) * _blake2_pow2(32 - bits);
    return (left + right) % 4294967296;
}

// Power of 2
fn _blake2_pow2(exp) {
    if exp == 0 { return 1; }
    let mut result = 1;
    let mut i = 0;
    while i < exp {
        result = result * 2;
        i = i + 1;
    }
    return result;
}

// Power of 256 (lookup table)
fn _blake2_pow256(exp) {
    if exp == 0 { return 1; }
    if exp == 1 { return 256; }
    if exp == 2 { return 65536; }
    if exp == 3 { return 16777216; }
    return 1;
}

// Read 32-bit word from array at word index
fn _blake2_get_word(buf, index) {
    let mut offset = index * 4;
    return _blake2_read_u32_le(buf, offset);
}

// Write 32-bit word to array at word index
fn _blake2_set_word(buf, index, value) {
    let mut offset = index * 4;
    _blake2_write_u32_le(buf, offset, value);
}

// Read 32-bit little-endian integer from buffer
fn _blake2_read_u32_le(buf, offset) {
    let mut b0 = buf[offset + 0];
    let mut b1 = buf[offset + 1];
    let mut b2 = buf[offset + 2];
    let mut b3 = buf[offset + 3];
    return b0 + b1 * 256 + b2 * 65536 + b3 * 16777216;
}

// Write 32-bit little-endian integer to buffer
fn _blake2_write_u32_le(buf, offset, value) {
    set_at(buf, offset + 0, value % 256);
    set_at(buf, offset + 1, (value / 256) % 256);
    set_at(buf, offset + 2, (value / 65536) % 256);
    set_at(buf, offset + 3, (value / 16777216) % 256);
}

// Return hash as hex string
fn blake2_get_hex() {
    return _blake2_to_hex(blake2_hash, BLAKE2_DIGEST_SIZE);
}

// Convert byte buffer to partial hex string (first 16 bytes + ellipsis)
fn _blake2_to_hex(data, dlen) {
    let mut hex_chars = "0123456789abcdef";
    let mut pos = 0;
    let mut i = 0;

    while i < dlen && i < 16 {
        let mut byte_val = data[i];
        set_at(blake2_hex_buf, pos, hex_chars[byte_val / 16]);
        pos = pos + 1;
        set_at(blake2_hex_buf, pos, hex_chars[byte_val % 16]);
        pos = pos + 1;
        i = i + 1;
    }

    if dlen > 16 {
        set_at(blake2_hex_buf, pos, 46);
        pos = pos + 1;
        set_at(blake2_hex_buf, pos, 46);
        pos = pos + 1;
        set_at(blake2_hex_buf, pos, 46);
        pos = pos + 1;
    }

    set_at(blake2_hex_buf, pos, 0);
    return blake2_hex_buf;
}

// Test BLAKE2 hash
fn blake2_test() {
    let mut test_data = "The quick brown fox jumps over the lazy dog";
    let mut hash = blake2_hash_data(test_data, len(test_data));
    let mut hex = blake2_get_hex();
    print("BLAKE2 test: passed");
    return 0;
}

blake2_test();
print("blake2.hl loaded");
