// ntt.hl -- Number Theoretic Transform mod 998244353 (iter 335)
// Buffer: 0x1860000
// MOD=998244353=119*2^23+1, primitive root g=3.
// ntt_multiply(na,nb): convolve ntt_a[0..na-1] * ntt_b[0..nb-1] -> ntt_c[0..na+nb-2].
// No % operator: use v - (v/MOD)*MOD. ntt_cur dispatch (0=a,1=b,2=c) for array access.

let NTT_MOD = 998244353;
let NTT_G   = 3;
let NTT_MAX = 32;

let ntt_a   = array(32, 0);
let ntt_b   = array(32, 0);
let ntt_c   = array(32, 0);
let ntt_rev = array(32, 0);
let ntt_cur = 0;   // 0=ntt_a, 1=ntt_b, 2=ntt_c
let ntt_rn  = 0;   // working array length

fn _ntt_mod(v) {
    let mut r = v - (v / NTT_MOD) * NTT_MOD;
    return r;
}

fn _ntt_mpow(base, exp) {
    let mut result = 1;
    let mut b = _ntt_mod(base);
    let mut e = exp;
    while e > 0 {
        let emod2 = e - (e / 2) * 2;
        if emod2 == 1 {
            result = _ntt_mod(result * b);
        }
        b = _ntt_mod(b * b);
        e = e / 2;
    }
    return result;
}

fn _ntt_get(i) {
    if ntt_cur == 0 { return ntt_a[i]; }
    if ntt_cur == 1 { return ntt_b[i]; }
    return ntt_c[i];
}

fn _ntt_set(i, v) {
    if ntt_cur == 0 { set_at(ntt_a, i, v); return 0; }
    if ntt_cur == 1 { set_at(ntt_b, i, v); return 0; }
    set_at(ntt_c, i, v);
    return 0;
}

fn _ntt_run(n, inv) {
    // bit-reversal permutation (no XOR/AND: extract bit via arithmetic)
    let mut i = 0;
    while i < n {
        let rev = ntt_rev[i];
        if i < rev {
            let mut t = _ntt_get(i);
            _ntt_set(i, _ntt_get(rev));
            _ntt_set(rev, t);
        }
        i += 1;
    }
    // butterfly
    let mut len = 2;
    while len <= n {
        let half = len / 2;
        let w    = _ntt_mpow(NTT_G, (NTT_MOD - 1) / len);
        if inv == 1 {
            w = _ntt_mpow(w, NTT_MOD - 2);
        }
        let mut j = 0;
        while j < n {
            let wn = 1;
            let k  = 0;
            while k < half {
                let u    = _ntt_get(j + k);
                let v    = _ntt_mod(_ntt_get(j + k + half) * wn);
                _ntt_set(j + k,        _ntt_mod(u + v));
                let diff = u - v;
                if diff < 0 {
                    _ntt_set(j + k + half, _ntt_mod(diff + NTT_MOD));
                } else {
                    _ntt_set(j + k + half, _ntt_mod(diff));
                }
                wn = _ntt_mod(wn * w);
                k  += 1;
            }
            j += len;
        }
        len = len * 2;
    }
    if inv == 1 {
        let inv_n = _ntt_mpow(n, NTT_MOD - 2);
        let ii = 0;
        while ii < n {
            _ntt_set(ii, _ntt_mod(_ntt_get(ii) * inv_n));
            ii += 1;
        }
    }
    return 0;
}

fn ntt_multiply(na, nb) {
    // compute n = next power of 2 >= na+nb
    let mut sz = 1;
    while sz < na + nb { sz = sz * 2; }
    // zero-pad and build bit-reversal table
    let mut i = 0;
    while i < sz {
        if i < na { set_at(ntt_a, i, ntt_a[i]); } else { set_at(ntt_a, i, 0); }
        if i < nb { set_at(ntt_b, i, ntt_b[i]); } else { set_at(ntt_b, i, 0); }
        i += 1;
    }
    // build rev[] for size sz (log2 bits)
    let bits = 0;
    let tmp  = sz;
    while tmp > 1 { bits += 1; tmp = tmp / 2; }
    i = 0;
    while i < sz {
        let x    = i;
        let revx = 0;
        let b    = 0;
        while b < bits {
            let lsb = x - (x / 2) * 2;
            revx = revx * 2 + lsb;
            x    = x / 2;
            b    += 1;
        }
        set_at(ntt_rev, i, revx);
        i += 1;
    }
    ntt_rn  = sz;
    ntt_cur = 0; _ntt_run(sz, 0);
    ntt_cur = 1; _ntt_run(sz, 0);
    // pointwise multiply -> ntt_c
    i = 0;
    while i < sz {
        set_at(ntt_c, i, _ntt_mod(ntt_a[i] * ntt_b[i]));
        i += 1;
    }
    ntt_cur = 2; _ntt_run(sz, 1);
    return na + nb - 1;
}

fn ntt_init() {
    let mut i = 0;
    while i < NTT_MAX {
        set_at(ntt_a, i, 0); set_at(ntt_b, i, 0); set_at(ntt_c, i, 0);
        i += 1;
    }
    ntt_rn = 0; ntt_cur = 0;
    return 0;
}

fn ntt_test() {
    set_at(ntt_a, 0, 1); set_at(ntt_a, 1, 2); set_at(ntt_a, 2, 3);
    set_at(ntt_b, 0, 4); set_at(ntt_b, 1, 5); set_at(ntt_b, 2, 6);
    let nc = ntt_multiply(3, 3);
    let c0 = ntt_c[0];
    let c1 = ntt_c[1];
    let c2 = ntt_c[2];
    let c3 = ntt_c[3];
    let c4 = ntt_c[4];
    print("ntt_test: c=" + to_string(c0) + "," + to_string(c1) + "," +
          to_string(c2) + "," + to_string(c3) + "," + to_string(c4));
    if c0 == 4 {
        if c1 == 13 {
            if c2 == 28 {
                if c3 == 27 {
                    if c4 == 18 {
                        print("ntt_test: PASS");
                        return 1;
                    }
                }
            }
        }
    }
    print("ntt_test: FAIL");
    return 0;
}

print("ntt.hl loaded");
