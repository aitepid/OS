// hyperloglog.hl -- HyperLogLog Cardinality Estimator
//
// Implements HyperLogLog (Flajolet, Fusy, Gandouet, Meunier 2007):
//   - Estimates distinct element count (cardinality) in O(m) memory
//   - m = 64 registers (b = 6 bits for register index)
//   - Each register M[j] stores max leading-zero count of hashed values
//   - Estimate: α_m × m² × (Σ 2^(-M[j]))^(-1)
//   - Small-range correction: linear counting (if E < 5m/2)
//   - Large-range correction: 2^32-based estimator
//   - Merge: pointwise max (union cardinality)
// Error rate ≈ 1.04 / sqrt(m) ≈ 13% for m=64.
//
// Buffer: 0x13E0000

let HLL_BUF = 0x13E0000;

// Register parameters
let HLL_M    = 64;     // number of registers (must be power of 2)
let HLL_B    = 6;      // log2(HLL_M) bits for register index
let HLL_MAX_VAL = 32;  // max leading-zero bits stored

// α_m constant × 1000 (correction factor)
// α_64 = 0.7213 / (1 + 1.079/64) ≈ 0.7096 → × 1000 = 709
let HLL_ALPHA_M = 709;

// Register storage
let hll_M = [];   // HLL_M registers (each 0..HLL_MAX_VAL)

// Merge target (for union estimation)
let hll_merge_M = [];

let hll_count   = 0;    // elements added (for exact mode tracking)
let hll_initialized = 0;

fn hyperloglog_init() {
    let i = 0;
    while i < HLL_M {
        set_at(hll_M,       i, 0);
        set_at(hll_merge_M, i, 0);
        i = i + 1;
    }
    hll_count = 0;
    hll_initialized = 1;
    return 0;
}

// FNV-1a inspired 32-bit hash of integer key (arithmetic-only)
fn _hll_hash_int(key) {
    let h = 2166136261;
    h = h - ((h / 1000000) * 1000000);
    let fnv = 16777619;
    // Mix key bytes (treat as 4 bytes)
    let b0 = key - ((key / 256) * 256);
    let b1 = (key / 256) - ((key / 65536) * 256);
    let b2 = (key / 65536) - ((key / 16777216) * 256);
    let b3 = key / 16777216;
    if b3 < 0 { b3 = -b3; }
    h = (h * fnv) + b0; h = h - ((h / 4294967296) * 4294967296); if h < 0 { h = -h; }
    h = (h * fnv) + b1; h = h - ((h / 4294967296) * 4294967296); if h < 0 { h = -h; }
    h = (h * fnv) + b2; h = h - ((h / 4294967296) * 4294967296); if h < 0 { h = -h; }
    h = (h * fnv) + b3; h = h - ((h / 4294967296) * 4294967296); if h < 0 { h = -h; }
    return h;
}

// FNV-1a inspired 32-bit hash of string
fn _hll_hash_str(s) {
    let h = 2166136261;
    h = h - ((h / 1000000) * 1000000);
    let fnv = 16777619;
    let i = 0;
    let n = len(s);
    while i < n {
        let c = char_code(s, i);
        h = (h * fnv) + c;
        h = h - ((h / 1000000000) * 1000000000);
        if h < 0 { h = -h; }
        i = i + 1;
    }
    return h;
}

// Count leading zeros of (hash >> b) portion (the remaining 32-b bits)
fn _hll_leading_zeros(w) {
    if w == 0 { return HLL_MAX_VAL; }
    let count = 0;
    // We work with at most 26 bits (32 - b = 32 - 6 = 26)
    let limit = 33554432;   // 2^25 (26-bit MSB)
    let bit = 25;
    while bit >= 0 {
        let power = 1;
        let p = 0;
        while p < bit { power = power * 2; p = p + 1; }
        let bval = w / power - ((w / power) / 2) * 2;
        if bval == 1 { return count; }
        count = count + 1;
        bit = bit - 1;
    }
    return count + 1;
}

// Add integer element
fn hll_add_int(key) {
    let h = _hll_hash_int(key);
    // Lower b bits → register index j
    let j = h - ((h / HLL_M) * HLL_M);
    // Upper (32-b) bits → leading zero count
    let w = h / HLL_M;
    let rho = _hll_leading_zeros(w) + 1;
    if rho > hll_M[j] { set_at(hll_M, j, rho); }
    hll_count = hll_count + 1;
    return 0;
}

// Add string element
fn hll_add_str(s) {
    let h = _hll_hash_str(s);
    let j = h - ((h / HLL_M) * HLL_M);
    let w = h / HLL_M;
    let rho = _hll_leading_zeros(w) + 1;
    if rho > hll_M[j] { set_at(hll_M, j, rho); }
    hll_count = hll_count + 1;
    return 0;
}

// Compute harmonic mean Z = 1 / Σ(2^(-M[j])) × 1000
// 2^(-M[j]) approximated as 1000 / 2^M[j]
fn _hll_harmonic_sum() {
    let sum = 0;
    let i = 0;
    while i < HLL_M {
        let mj = hll_M[i];
        // 2^mj for mj up to 20
        let power = 1;
        let p = 0;
        while p < mj { if power < 1000000 { power = power * 2; } p = p + 1; }
        // Contribution: 1000 / 2^mj (per-mille)
        let contrib = 1000;
        if power > 0 { contrib = 1000000 / power; }
        sum = sum + contrib;
        i = i + 1;
    }
    return sum;  // in per-mille units
}

// Estimate distinct count
fn hll_estimate() {
    let Z = _hll_harmonic_sum();  // Σ 2^(-M[j]) × 1000
    if Z == 0 { return 0; }
    // E = α_m × m² / Z  (Z is in per-mille, m² × 1000 / Z)
    let m2 = HLL_M * HLL_M;
    let raw = (HLL_ALPHA_M * m2) / Z;  // Z in per-mille

    // Small-range correction: if raw < 5/2 × m, use linear counting
    // Count zero registers
    let zeros = 0;
    let i = 0;
    while i < HLL_M { if hll_M[i] == 0 { zeros = zeros + 1; } i = i + 1; }
    if raw < HLL_M * 5 / 2 {
        if zeros > 0 {
            // Linear counting: m × ln(m/zeros) ≈ m × (m/zeros - 1) for small ratios
            let lc = HLL_M * (HLL_M - zeros) / zeros;
            return lc;
        }
    }
    return raw;
}

// Merge another register array into hll_M (union cardinality)
fn hll_merge(other_M) {
    let i = 0;
    while i < HLL_M {
        if other_M[i] > hll_M[i] { set_at(hll_M, i, other_M[i]); }
        i = i + 1;
    }
    return 0;
}

// Copy registers to merge buffer
fn hll_snapshot() {
    let i = 0;
    while i < HLL_M { set_at(hll_merge_M, i, hll_M[i]); i = i + 1; }
    return 0;
}

fn hll_status() {
    let zeros = 0;
    let max_reg = 0;
    let i = 0;
    while i < HLL_M {
        if hll_M[i] == 0 { zeros = zeros + 1; }
        if hll_M[i] > max_reg { max_reg = hll_M[i]; }
        i = i + 1;
    }
    return "hll: m=" + to_string(HLL_M)
        + " added=" + to_string(hll_count)
        + " estimate=" + to_string(hll_estimate())
        + " zeros=" + to_string(zeros)
        + " max_reg=" + to_string(max_reg);
}

fn hyperloglog_test() {
    hyperloglog_init();
    // Add 100 distinct integers 1..100
    let i = 1;
    while i <= 100 { hll_add_int(i); i = i + 1; }
    let est_100 = hll_estimate();  // should be near 100

    // Add duplicates — estimate should not change much
    i = 1;
    while i <= 50 { hll_add_int(i); i = i + 1; }
    let est_dup = hll_estimate();  // still ~100

    // Add string keys
    hll_add_str("alpha"); hll_add_str("beta"); hll_add_str("gamma");
    hll_add_str("delta"); hll_add_str("alpha");  // duplicate

    // Merge test: snapshot + new elements
    hll_snapshot();
    hyperloglog_init();
    i = 101;
    while i <= 150 { hll_add_int(i); i = i + 1; }
    hll_merge(hll_merge_M);
    let est_union = hll_estimate();  // ~150

    serial_print("hll test: est(1..100)=" + to_string(est_100)
        + " est(+dups)=" + to_string(est_dup)
        + " est(union_150)=" + to_string(est_union));
    return "hyperloglog: m=64 est(100_distinct)=" + to_string(est_100)
        + " est(with_dups)=" + to_string(est_dup)
        + " est(union_150)=" + to_string(est_union)
        + " [Flajolet et al. 2007 ok]";
}

print("hyperloglog.hl loaded -- HyperLogLog cardinality estimator (m=64 regs, ~13% error, merge)");
