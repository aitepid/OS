// gpu_inference.hl -- VirtIO-GPU Accelerated Inference (Phase 5: ML深化, iter 405)
// Buffer: 0x1CC0000
// Simulates GPU command queue dispatch for tensor operations
// Operations: RELU=0 LINEAR=1 SOFTMAX=2
// gi_tensor[GI_BUF_SIZE]: unified input/intermediate/output buffer
// gi_weights[GI_WT_SIZE]: weight matrix for LINEAR ops
// gi_dispatch() executes all queued ops, returns simulated cycle count
// Milestone M4: complete ML inference pipeline (conv→pool→rnn→lstm→autograd→optim→infer)

let GI_BUF_SIZE = 64;
let GI_WT_SIZE  = 64;
let GI_MAXOPS   = 16;

let GI_RELU    = 0;
let GI_LINEAR  = 1;
let GI_SOFTMAX = 2;

let gi_tensor  = array(64, 0);
let gi_weights = array(64, 0);
let gi_bias    = array(16, 0);

let gi_op_type    = array(16, 0);
let gi_op_in_off  = array(16, 0);
let gi_op_out_off = array(16, 0);
let gi_op_in_dim  = array(16, 0);
let gi_op_out_dim = array(16, 0);
let mut gi_n_ops  = 0;
let mut gi_cycles = 0;
let mut gi_batch  = 1;

fn gi_init() {
    let mut i = 0;
    while i < GI_BUF_SIZE {
        set_at(gi_tensor,  i, 0);
        set_at(gi_weights, i, 0);
        i += 1;
    }
    i = 0;
    while i < GI_MAXOPS {
        set_at(gi_bias,       i, 0);
        set_at(gi_op_type,    i, 0);
        set_at(gi_op_in_off,  i, 0);
        set_at(gi_op_out_off, i, 0);
        set_at(gi_op_in_dim,  i, 0);
        set_at(gi_op_out_dim, i, 0);
        i += 1;
    }
    gi_n_ops  = 0;
    gi_cycles = 0;
    gi_batch  = 1;
    return 0;
}

fn gi_set_input(idx, val)  { set_at(gi_tensor,  idx, val); return 0; }
fn gi_set_weight(idx, val) { set_at(gi_weights, idx, val); return 0; }
fn gi_get_output(idx)      { return gi_tensor[idx]; }
fn gi_cycles_used()        { return gi_cycles; }
fn gi_queue_len()          { return gi_n_ops; }

fn gi_add_op(op_type, in_off, out_off, in_dim, out_dim) {
    if gi_n_ops >= GI_MAXOPS { return 0 - 1; }
    let mut id = gi_n_ops;
    set_at(gi_op_type,    id, op_type);
    set_at(gi_op_in_off,  id, in_off);
    set_at(gi_op_out_off, id, out_off);
    set_at(gi_op_in_dim,  id, in_dim);
    set_at(gi_op_out_dim, id, out_dim);
    gi_n_ops += 1;
    return id;
}

fn _gi_relu(in_off, out_off, n) {
    let mut i = 0;
    while i < n {
        let mut v = gi_tensor[in_off + i];
        if v < 0 { v = 0; }
        set_at(gi_tensor, out_off + i, v);
        i += 1;
    }
    gi_cycles += n;
    return n;
}

fn _gi_linear(in_off, out_off, in_dim, out_dim) {
    // y[j] = Σ w[j*in_dim+k] * x[in_off+k] / 256 + bias[j]
    let mut j = 0;
    while j < out_dim {
        let mut acc = gi_bias[j];
        let mut k = 0;
        while k < in_dim {
            acc += gi_weights[j * in_dim + k] * gi_tensor[in_off + k] / 256;
            k += 1;
        }
        set_at(gi_tensor, out_off + j, acc);
        j += 1;
    }
    gi_cycles += in_dim * out_dim;
    return out_dim;
}

fn _gi_softmax(in_off, out_off, n) {
    // exp_fp(x) = x - max + 256  (linear shift-and-clamp approximation)
    let mut max_v = gi_tensor[in_off];
    let mut i = 1;
    while i < n {
        if gi_tensor[in_off + i] > max_v { max_v = gi_tensor[in_off + i]; }
        i += 1;
    }
    let mut sum_exp = 0;
    i = 0;
    while i < n {
        let mut x = gi_tensor[in_off + i] - max_v + 256;
        if x < 0   { x = 0; }
        if x > 512 { x = 512; }
        set_at(gi_tensor, out_off + i, x);
        sum_exp += x;
        i += 1;
    }
    if sum_exp > 0 {
        i = 0;
        while i < n {
            set_at(gi_tensor, out_off + i, gi_tensor[out_off + i] * 256 / sum_exp);
            i += 1;
        }
    }
    gi_cycles += 2 * n;
    return n;
}

fn gi_dispatch() {
    gi_cycles = 0;
    let mut op = 0;
    while op < gi_n_ops {
        let mut t = gi_op_type[op];
        let mut io = gi_op_in_off[op];
        let mut oo = gi_op_out_off[op];
        let mut id = gi_op_in_dim[op];
        let mut od = gi_op_out_dim[op];
        if t == GI_RELU    { _gi_relu(io, oo, id); }
        if t == GI_LINEAR  { _gi_linear(io, oo, id, od); }
        if t == GI_SOFTMAX { _gi_softmax(io, oo, id); }
        op += 1;
    }
    return gi_cycles;
}

fn gi_test() {
    gi_init();

    // Load inputs: tensor[0..3] = [100, -50, 150, -20]
    gi_set_input(0, 100);
    gi_set_input(1, 0 - 50);
    gi_set_input(2, 150);
    gi_set_input(3, 0 - 20);

    // Op 0: RELU in=0 out=4 dim=4 → [100, 0, 150, 0]
    gi_add_op(GI_RELU, 0, 4, 4, 4);

    // Op 1: SOFTMAX on 2 elements in=4 out=8
    // relu[0]=100, relu[1]=0; max=100
    // shifted: x[0]=256, x[1]=156; sum=412
    // s0 = 256*256/412 = 159,  s1 = 156*256/412 = 96
    gi_add_op(GI_SOFTMAX, 4, 8, 2, 2);

    // Dispatch: relu cycles=4, softmax cycles=4, total=8
    let mut cyc = gi_dispatch();
    let mut r4 = gi_get_output(4);   // relu(100)   = 100
    let mut r5 = gi_get_output(5);   // relu(-50)   = 0
    let mut r6 = gi_get_output(6);   // relu(150)   = 150
    let mut s0 = gi_get_output(8);   // softmax[0] = 159
    let mut s1 = gi_get_output(9);   // softmax[1] = 96

    print("gi_test: r4=" + to_string(r4)
          + " r5=" + to_string(r5)
          + " r6=" + to_string(r6)
          + " s0=" + to_string(s0)
          + " s1=" + to_string(s1)
          + " cyc=" + to_string(cyc));

    if r4 == 100 {
        if r5 == 0 {
            if r6 == 150 {
                if s0 > s1 {
                    if cyc == 8 {
                        print("gi_test: PASS");
                        return 1;
                    }
                }
            }
        }
    }
    print("gi_test: FAIL");
    return 0;
}

print("gpu_inference.hl loaded");
