// game_theory.hl -- Sprague-Grundy numbers + Nim (XOR via bit arithmetic) (iter 327)
// Buffer: 0x17E0000
// Take-away game moves {1,2,3}: Grundy values have period 4.
// Nim: first player wins iff XOR of pile sizes != 0.

let GT_MAX    = 64;
let GT_PMAX   = 16;

let sg_memo   = array(64, 0);
let gt_piles  = array(16, 0);
let gt_npiles = 0;

fn gt_init() {
    gt_npiles = 0;
    let i = 0;
    while i < GT_MAX {
        set_at(sg_memo,  i, 0);
        i += 1;
    }
    i = 0;
    while i < GT_PMAX {
        set_at(gt_piles, i, 0);
        i += 1;
    }
    return 0;
}

fn _gt_mex3(v1, v2, v3) {
    let m    = 0;
    let done = 0;
    while done == 0 {
        if m == v1 {
            m += 1;
        } else {
            if m == v2 {
                m += 1;
            } else {
                if m == v3 {
                    m += 1;
                } else {
                    done = 1;
                }
            }
        }
    }
    return m;
}

fn sg_compute(n) {
    set_at(sg_memo, 0, 0);
    let i  = 1;
    let v1 = 0;
    let v2 = 0;
    let v3 = 0;
    while i <= n {
        v1 = -1;
        v2 = -1;
        v3 = -1;
        if i >= 1 { v1 = sg_memo[i - 1]; }
        if i >= 2 { v2 = sg_memo[i - 2]; }
        if i >= 3 { v3 = sg_memo[i - 3]; }
        set_at(sg_memo, i, _gt_mex3(v1, v2, v3));
        i += 1;
    }
    return 0;
}

fn _gt_xor2(a, b) {
    let result = 0;
    let bit    = 1;
    let aa     = a;
    let bb     = b;
    let ra     = 0;
    let rb     = 0;
    let done   = 0;
    while done == 0 {
        if aa == 0 {
            if bb == 0 {
                done = 1;
            } else {
                rb = bb - (bb / 2) * 2;
                if rb == 1 { result += bit; }
                bb  = bb / 2;
                bit = bit * 2;
            }
        } else {
            ra = aa - (aa / 2) * 2;
            rb = bb - (bb / 2) * 2;
            if ra != rb { result += bit; }
            aa  = aa / 2;
            bb  = bb / 2;
            bit = bit * 2;
        }
    }
    return result;
}

fn gt_nim_xor() {
    let xr   = 0;
    let i    = 0;
    while i < gt_npiles {
        xr = _gt_xor2(xr, gt_piles[i]);
        i += 1;
    }
    return xr;
}

fn gt_nim_winner() {
    if gt_nim_xor() != 0 { return 1; }
    return 0;
}

fn gt_test() {
    gt_init();
    sg_compute(8);
    let sg4  = sg_memo[4];
    let sg7  = sg_memo[7];
    let xr35 = _gt_xor2(3, 5);
    set_at(gt_piles, 0, 3);
    set_at(gt_piles, 1, 5);
    set_at(gt_piles, 2, 7);
    gt_npiles = 3;
    let win = gt_nim_winner();
    print("gt_test: sg[4]=" + to_string(sg4) +
          " sg[7]=" + to_string(sg7) +
          " xor(3,5)=" + to_string(xr35) +
          " nim_winner=" + to_string(win));
    if sg4 == 0 {
        if sg7 == 3 {
            if xr35 == 6 {
                if win == 1 {
                    print("gt_test: PASS");
                    return 1;
                }
            }
        }
    }
    print("gt_test: FAIL");
    return 0;
}

print("game_theory.hl loaded");
