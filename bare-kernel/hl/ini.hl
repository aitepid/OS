// ini.hl -- INI Configuration File Parser / Writer
//
// Iteration 173: Read and write Windows-style INI files from VFS.
//
// Format supported:
//   ; comment lines (semicolon)
//   # comment lines (hash)
//   [section]
//   key = value
//   key=value
//
// Storage:
//   Flat parallel arrays: ini_secs[], ini_keys[], ini_vals[]
//   Up to INI_MAX_ENTRIES = 64 key-value pairs.
//   ini_secs[i] holds the section for entry i (inherited from last [section]).
//   ini_count = total active entries.
//
// Public API:
//   ini_init()
//   ini_load(path)              → count of loaded entries (-1 on error)
//   ini_get(section, key)       → value string ("" if not found)
//   ini_set(section, key, val)  → 0 (creates or updates entry)
//   ini_delete(section, key)    → 1 if deleted, 0 if not found
//   ini_save(path)              → bytes written (-1 on error)
//   ini_list()                  → formatted dump string
//   ini_clear()                 → 0

let mut INI_MAX_ENTRIES = 64;
let INI_BUF_ADDR    = 14925824;   // 0xE39000  64 KB read buffer
let INI_BUF_SZ      = 65536;

let mut ini_secs  = [];
let mut ini_keys  = [];
let mut ini_vals  = [];
let mut ini_count = 0;

fn ini_init() {
    ini_secs  = [];
    ini_keys  = [];
    ini_vals  = [];
    ini_count = 0;
    let mut i = 0;
    while i < INI_MAX_ENTRIES {
        push(ini_secs,  "");
        push(ini_keys,  "");
        push(ini_vals,  "");
        i = i + 1;
    }
    print("ini: init — " + to_string(INI_MAX_ENTRIES) + " entry slots");
    return 0;
}

fn ini_clear() {
    let mut i = 0;
    while i < INI_MAX_ENTRIES {
        set_at(ini_secs,  i, "");
        set_at(ini_keys,  i, "");
        set_at(ini_vals,  i, "");
        i = i + 1;
    }
    ini_count = 0;
    return 0;
}

// ============================================================
// String helpers
// ============================================================

fn _ini_trim(s) {
    let mut n = len(s);
    let mut start = 0;
    let mut go = 1;
    while go == 1 {
        if start >= n { go = 0; }
        else {
            let mut c = str_char_code(s, start);
            if c == 32 { start = start + 1; }
            else { if c == 9 { start = start + 1; }
            else { go = 0; } }
        }
    }
    let mut end = n;
    go = 1;
    while go == 1 {
        if end <= start { go = 0; }
        else {
            let mut c = str_char_code(s, end - 1);
            if c == 32 { end = end - 1; }
            else { if c == 9 { end = end - 1; }
            else { go = 0; } }
        }
    }
    if start >= end { return ""; }
    return str_sub(s, start, end);
}

fn _ini_starts_with(s, prefix) {
    if len(s) < len(prefix) { return 0; }
    if str_sub(s, 0, len(prefix)) == prefix { return 1; }
    return 0;
}

// Split line on first '='; returns ["key","val"] or ["",""] if not found
fn _ini_split_kv(line) {
    let mut pos = str_find(line, "=");
    if pos < 0 { return ["", ""]; }
    let mut k = _ini_trim(str_sub(line, 0, pos));
    let mut v = _ini_trim(str_sub(line, pos + 1, len(line)));
    return [k, v];
}

// ============================================================
// Load
// ============================================================

fn ini_load(path) {
    let fd = vfs_open(path, 0);
    if fd < 0 { return 0 - 1; }
    let mut n = vfs_read(fd, INI_BUF_ADDR, INI_BUF_SZ);
    vfs_close(fd);
    if n <= 0 { return 0; }

    // Build text string from memory
    let mut text = "";
    let mut bi = 0;
    while bi < n {
        text = text + str_from_byte(mem_read_u8(INI_BUF_ADDR + bi));
        bi = bi + 1;
    }

    // Split into lines
    let mut lines = [];
    let mut start = 0;
    let tlen = len(text);
    let mut ci = 0;
    while ci < tlen {
        let mut c = str_sub(text, ci, ci + 1);
        if c == "\n" {
            push(lines, str_sub(text, start, ci));
            start = ci + 1;
        }
        ci = ci + 1;
    }
    if start < tlen { push(lines, str_sub(text, start, tlen)); }

    ini_clear();
    let mut cur_sec = "";
    let mut li = 0;
    while li < len(lines) {
        let raw = _ini_trim(lines[li]);
        if len(raw) > 0 {
            let fc = str_char_code(raw, 0);
            if fc == 91 {
                // '[section]'
                let close = str_find(raw, "]");
                if close > 1 { cur_sec = str_sub(raw, 1, close); }
            } else {
                if fc == 59 {}   // ';' comment — skip
                else {
                    if fc == 35 {}  // '#' comment — skip
                    else {
                        let kv = _ini_split_kv(raw);
                        if len(kv[0]) > 0 {
                            if ini_count < INI_MAX_ENTRIES {
                                set_at(ini_secs,  ini_count, cur_sec);
                                set_at(ini_keys,  ini_count, kv[0]);
                                set_at(ini_vals,  ini_count, kv[1]);
                                ini_count = ini_count + 1;
                            }
                        }
                    }
                }
            }
        }
        li = li + 1;
    }
    print("ini: loaded " + to_string(ini_count) + " entries from " + path);
    return ini_count;
}

// ============================================================
// Get / Set / Delete
// ============================================================

fn ini_get(section, key) {
    let mut i = 0;
    while i < ini_count {
        if ini_secs[i] == section {
            if ini_keys[i] == key { return ini_vals[i]; }
        }
        i = i + 1;
    }
    return "";
}

fn ini_set(section, key, val) {
    // Update existing entry
    let mut i = 0;
    while i < ini_count {
        if ini_secs[i] == section {
            if ini_keys[i] == key {
                set_at(ini_vals, i, val);
                return 0;
            }
        }
        i = i + 1;
    }
    // Add new entry
    if ini_count < INI_MAX_ENTRIES {
        set_at(ini_secs,  ini_count, section);
        set_at(ini_keys,  ini_count, key);
        set_at(ini_vals,  ini_count, val);
        ini_count = ini_count + 1;
    }
    return 0;
}

fn ini_delete(section, key) {
    let mut i = 0;
    while i < ini_count {
        if ini_secs[i] == section {
            if ini_keys[i] == key {
                // Shift remaining entries down
                let mut j = i;
                while j < ini_count - 1 {
                    set_at(ini_secs,  j, ini_secs[j + 1]);
                    set_at(ini_keys,  j, ini_keys[j + 1]);
                    set_at(ini_vals,  j, ini_vals[j + 1]);
                    j = j + 1;
                }
                ini_count = ini_count - 1;
                return 1;
            }
        }
        i = i + 1;
    }
    return 0;
}

// ============================================================
// Save
// ============================================================

fn ini_save(path) {
    // Group entries by section and build output string
    let mut out = "";
    let mut done_secs = [];
    let mut i = 0;
    while i < ini_count {
        let sec = ini_secs[i];
        // Check if section already written
        let mut already = 0;
        let mut di = 0;
        while di < len(done_secs) {
            if done_secs[di] == sec { already = 1; }
            di = di + 1;
        }
        if already == 0 {
            push(done_secs, sec);
            if len(sec) > 0 { out = out + "[" + sec + "]\n"; }
            // Write all entries for this section
            let mut j = i;
            while j < ini_count {
                if ini_secs[j] == sec {
                    out = out + ini_keys[j] + " = " + ini_vals[j] + "\n";
                }
                j = j + 1;
            }
            out = out + "\n";
        }
        i = i + 1;
    }
    // Write string to VFS
    let fd = vfs_open(path, 1);
    if fd < 0 { return 0 - 1; }
    let mut n = len(out);
    let mut bi = 0;
    while bi < n {
        mem_write_u8(INI_BUF_ADDR + bi, str_char_code(out, bi));
        bi = bi + 1;
    }
    vfs_write(fd, INI_BUF_ADDR, n);
    vfs_close(fd);
    print("ini: saved " + to_string(ini_count) + " entries to " + path + " (" + to_string(n) + " bytes)");
    return n;
}

// ============================================================
// List
// ============================================================

fn ini_list() {
    if ini_count == 0 { return "(no ini entries loaded)"; }
    let mut out = "INI entries (" + to_string(ini_count) + "):\n";
    let mut i = 0;
    while i < ini_count {
        out = out + "  [" + ini_secs[i] + "] " + ini_keys[i] + " = " + ini_vals[i] + "\n";
        i = i + 1;
    }
    return out;
}

print("ini.hl loaded");
print("INI: section/key=value parser, 64 entries, load/get/set/delete/save/list");
