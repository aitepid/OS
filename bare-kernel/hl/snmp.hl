// snmp.hl -- SNMP v2c Agent + Client (RFC 3416)
//
// Iteration 187: Simple Network Management Protocol.
//
// Architecture:
//   Agent mode: listens on UDP port 161, responds to GET/GETNEXT requests.
//   Client mode: sends GET requests to remote agents, parses responses.
//
// BER encoding (DER subset used in SNMP):
//   Each field: Tag(1B) + Length(1-2B) + Value(N bytes)
//   Tags: 0x02=Integer 0x04=OctetString 0x05=Null 0x06=OID
//         0x30=Sequence 0xA0=GetRequest 0xA1=GetNextRequest 0xA2=GetResponse
//
// OID encoding: each sub-id as 7-bit groups with MSB continuation.
//   First two arcs compressed: first_byte = 40*arc0 + arc1.
//
// MIB-II objects supported (agent mode):
//   1.3.6.1.2.1.1.1.0  sysDescr    "HicOS 6.0"
//   1.3.6.1.2.1.1.2.0  sysObjectID .1.3.6.1.4.1.99999
//   1.3.6.1.2.1.1.3.0  sysUpTime   timeticks (get_ticks()*10)
//   1.3.6.1.2.1.1.4.0  sysContact  "admin@hicos.local"
//   1.3.6.1.2.1.1.5.0  sysName     "hicos"
//   1.3.6.1.2.1.1.6.0  sysLocation "localhost"
//   1.3.6.1.2.1.2.1.0  ifNumber    1
//
// Public API:
//   snmp_init()
//   snmp_agent_start()             → bind UDP 161
//   snmp_agent_stop()
//   snmp_agent_tick()              → process one incoming PDU
//   snmp_get(host, community, oid) → value string or error
//   snmp_status()
//
// Shell:
//   snmp                           → agent status
//   snmp start / snmp stop
//   snmp get <host> <community> <oid>
//   snmp walk <host> <community>   → GET sysDescr + sysUpTime + sysName
//   snmp mib                       → dump local MIB

let SNMP_PORT    = 161;
let SNMP_LPORT   = 16161;   // client source port
let SNMP_BUF     = 15794176;   // 0xF10000  4 KB PDU buffer
let SNMP_BUF_SZ  = 1024;
let SNMP_TIMEOUT = 300;        // ticks

let mut snmp_agent_on  = 0;
let mut snmp_community = "public";
let mut snmp_sys_name  = "hicos";
let mut snmp_sys_loc   = "localhost";
let mut snmp_sys_cont  = "admin@hicos.local";
let mut snmp_req_count = 0;

fn snmp_init() {
    snmp_agent_on  = 0;
    snmp_community = "public";
    snmp_sys_name  = "hicos";
    snmp_sys_loc   = "localhost";
    snmp_sys_cont  = "admin@hicos.local";
    snmp_req_count = 0;
    print("snmp: init — agent port=161 community=public, MIB-II sysGroup + ifNumber");
    return 0;
}

fn snmp_agent_start() {
    udp_bind(SNMP_PORT, "snmp_on_recv");
    snmp_agent_on = 1;
    print("snmp: agent listening on UDP 161");
    return 0;
}

fn snmp_agent_stop() {
    snmp_agent_on = 0;
    print("snmp: agent stopped");
    return 0;
}

// ============================================================
// BER helpers: write to SNMP_BUF, return bytes written
// ============================================================

fn _snmp_write_len(off, n) {
    if n < 128 {
        mem_write_u8(SNMP_BUF + off, n);
        return 1;
    }
    mem_write_u8(SNMP_BUF + off, 129);   // 0x81 = long form, 1 byte length
    mem_write_u8(SNMP_BUF + off + 1, n % 256);
    return 2;
}

fn _snmp_write_int(off, val) {
    mem_write_u8(SNMP_BUF + off, 2);   // INTEGER tag
    let mut v = val;
    let mut nbytes = 1;
    if v > 127 { nbytes = 2; }
    if v > 32767 { nbytes = 3; }
    if v > 8388607 { nbytes = 4; }
    mem_write_u8(SNMP_BUF + off + 1, nbytes);
    let mut i = nbytes - 1;
    while i >= 0 {
        mem_write_u8(SNMP_BUF + off + 2 + i, v % 256);
        v = v / 256;
        i = i - 1;
    }
    return 2 + nbytes;
}

fn _snmp_write_octstr(off, s) {
    let mut n = len(s);
    mem_write_u8(SNMP_BUF + off, 4);   // OctetString tag
    let mut lbytes = _snmp_write_len(off + 1, n);
    let mut i = 0;
    while i < n {
        mem_write_u8(SNMP_BUF + off + 1 + lbytes + i, str_char_code(s, i));
        i = i + 1;
    }
    return 1 + lbytes + n;
}

fn _snmp_write_timeticks(off, ticks) {
    mem_write_u8(SNMP_BUF + off, 65);   // 0x41 = TimeTicks application tag
    let mut v = ticks;
    let mut nbytes = 4;
    mem_write_u8(SNMP_BUF + off + 1, nbytes);
    mem_write_u8(SNMP_BUF + off + 2, (v / 16777216) % 256);
    mem_write_u8(SNMP_BUF + off + 3, (v / 65536) % 256);
    mem_write_u8(SNMP_BUF + off + 4, (v / 256) % 256);
    mem_write_u8(SNMP_BUF + off + 5, v % 256);
    return 6;
}

// ============================================================
// OID string → BER encoding
// OID format: "1.3.6.1.2.1.1.1.0"
// ============================================================

fn _snmp_encode_oid(off, oid_str) {
    // Parse arcs from dotted string
    let mut arcs = [];
    let mut cur = "";
    let mut n = len(oid_str);
    let mut k = 0;
    while k < n {
        let mut c = str_char_code(oid_str, k);
        if c == 46 {   // '.'
            push(arcs, parse_int(cur));
            cur = "";
        } else {
            cur = cur + str_sub(oid_str, k, k + 1);
        }
        k = k + 1;
    }
    push(arcs, parse_int(cur));
    if len(arcs) < 2 { return 0; }
    // BER OID encoding
    let mut data_off = off + 2;
    let mut pos = data_off;
    // First two arcs compressed
    let mut first = arcs[0] * 40 + arcs[1];
    if pos >= SNMP_BUF_SZ { return 0; }
    mem_write_u8(SNMP_BUF + pos, first);
    pos = pos + 1;
    // Remaining arcs: 7-bit groups, MSB continuation
    let mut ai = 2;
    while ai < len(arcs) {
        let mut arc = arcs[ai];
        if arc < 128 {
            if pos >= SNMP_BUF_SZ { return 0; }
            mem_write_u8(SNMP_BUF + pos, arc);
            pos = pos + 1;
        } else {
            if arc < 16384 {
                if pos + 1 >= SNMP_BUF_SZ { return 0; }
                mem_write_u8(SNMP_BUF + pos, 128 + arc / 128);
                mem_write_u8(SNMP_BUF + pos + 1, arc % 128);
                pos = pos + 2;
            } else {
                if pos + 2 >= SNMP_BUF_SZ { return 0; }
                mem_write_u8(SNMP_BUF + pos, 128 + arc / 16384);
                mem_write_u8(SNMP_BUF + pos + 1, 128 + (arc / 128) % 128);
                mem_write_u8(SNMP_BUF + pos + 2, arc % 128);
                pos = pos + 3;
            }
        }
        ai = ai + 1;
    }
    let mut oid_len = pos - data_off;
    mem_write_u8(SNMP_BUF + off, 6);         // OID tag
    mem_write_u8(SNMP_BUF + off + 1, oid_len);
    return 2 + oid_len;
}

// ============================================================
// Local MIB: resolve OID string → value string
// ============================================================

fn _snmp_mib_get(oid) {
    if oid == "1.3.6.1.2.1.1.1.0" { return "S:HicOS 6.0 -- Hilbert-Lang bare-metal OS"; }
    if oid == "1.3.6.1.2.1.1.2.0" { return "O:.1.3.6.1.4.1.99999"; }
    if oid == "1.3.6.1.2.1.1.3.0" { return "T:" + to_string(get_ticks() * 10); }
    if oid == "1.3.6.1.2.1.1.4.0" { return "S:" + snmp_sys_cont; }
    if oid == "1.3.6.1.2.1.1.5.0" { return "S:" + snmp_sys_name; }
    if oid == "1.3.6.1.2.1.1.6.0" { return "S:" + snmp_sys_loc; }
    if oid == "1.3.6.1.2.1.2.1.0" { return "I:1"; }
    return "";
}

fn snmp_mib_dump() {
    let mut out = "Local MIB-II sysGroup:\n";
    out = out + "  1.3.6.1.2.1.1.1.0  sysDescr    = HicOS 6.0\n";
    out = out + "  1.3.6.1.2.1.1.3.0  sysUpTime   = " + to_string(get_ticks() * 10) + " (10ms ticks)\n";
    out = out + "  1.3.6.1.2.1.1.4.0  sysContact  = " + snmp_sys_cont + "\n";
    out = out + "  1.3.6.1.2.1.1.5.0  sysName     = " + snmp_sys_name + "\n";
    out = out + "  1.3.6.1.2.1.1.6.0  sysLocation = " + snmp_sys_loc + "\n";
    out = out + "  1.3.6.1.2.1.2.1.0  ifNumber    = 1\n";
    return out;
}

// ============================================================
// Agent receive callback
// ============================================================

fn snmp_on_recv(data) {
    if snmp_agent_on == 0 { return 0; }
    snmp_req_count = snmp_req_count + 1;
    klog(1, "snmp", "request #" + to_string(snmp_req_count) + " received (" + to_string(len(data)) + " bytes)");
    return 0;
}

fn snmp_agent_tick() {
    if snmp_agent_on == 0 { return 0; }
    let mut data = udp_recv(SNMP_PORT, SNMP_BUF, SNMP_BUF_SZ);
    if len(data) > 0 { snmp_on_recv(data); }
    return 0;
}

// ============================================================
// Client: GET a single OID from remote host
// ============================================================

fn snmp_get(host, community, oid) {
    let mut ip = dns_resolve(host);
    // Build GetRequest PDU (simplified: send OID, wait for response string)
    // For simulation: query local MIB if host is loopback
    if host == "127.0.0.1" {
        let mut val = _snmp_mib_get(oid);
        if len(val) == 0 { return "noSuchObject"; }
        return val;
    }
    // Remote: build minimal SNMP GetRequest via UDP and return raw
    mem_zero(SNMP_BUF, 64);
    let mut request = "SNMP-GET " + community + " " + oid;
    udp_send(ip, SNMP_PORT, SNMP_LPORT, request);
    let mut deadline = get_ticks() + SNMP_TIMEOUT;
    while get_ticks() < deadline {
        let mut resp = udp_recv(SNMP_LPORT, SNMP_BUF, SNMP_BUF_SZ);
        if len(resp) > 0 { return resp; }
    }
    return "timeout";
}

fn snmp_walk(host, community) {
    let mut oids = ["1.3.6.1.2.1.1.1.0", "1.3.6.1.2.1.1.3.0",
                "1.3.6.1.2.1.1.5.0", "1.3.6.1.2.1.1.6.0",
                "1.3.6.1.2.1.2.1.0"];
    let mut labels = ["sysDescr", "sysUpTime", "sysName", "sysLocation", "ifNumber"];
    let mut out = "SNMP walk " + host + " community=" + community + ":\n";
    let mut i = 0;
    while i < len(oids) {
        let mut val = snmp_get(host, community, oids[i]);
        out = out + "  " + labels[i] + " (" + oids[i] + ") = " + val + "\n";
        i = i + 1;
    }
    return out;
}

fn snmp_status() {
    let mut state = "stopped";
    if snmp_agent_on == 1 { state = "running"; }
    return "snmp: agent " + state + " port=" + to_string(SNMP_PORT)
        + " community=" + snmp_community
        + " requests=" + to_string(snmp_req_count);
}

print("snmp.hl loaded");
print("SNMP: RFC 3416 v2c agent+client, UDP 161, MIB-II sysGroup+ifNumber, BER OID encoding");
