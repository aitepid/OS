// widget_list.hl -- List, Tree, Table
//
// Sprint G4 of HicOS GUI injection (per GUI_DESIGN.md §3.5).
//
// Row data is supplied by the owning application via callback addresses
// passed in widget_extra (interpreted as cstring-array base). Each widget
// type tracks row count in widget_max, selected index in widget_value.

let LIST_ROW_PAD = 6;

fn list_new(parent, x, y, w, h, row_count, rows_addr) {
    let mut id = widget_new(WIDGET_KIND_LIST, parent, x, y, w, h);
    widget_set_range(id, 0, row_count);
    widget_set_extra(id, rows_addr);     // base of array of cstring pointers
    widget_set_value(id, 0 - 1);          // selected row (-1 = none)
    return id;
}

fn list_row_height() { return al_density_control(); }

fn list_paint(id) {
    if widget_get_flag(id, WIDGET_FLAG_VISIBLE) == 0 { return 0; }
    widget_base_rect(id, 6);
    let mut n      = widget_max[id];
    let mut sel    = widget_value[id];
    let mut row_h  = list_row_height();
    let mut size   = al_density_font_body();
    let mut pad    = al_density_pad();
    let mut i = 0;
    while i < n {
        let mut ry = widget_y[id] + i * row_h;
        if ry + row_h > widget_y[id] + widget_h[id] { i = n; }
        else {
            if i == sel {
                gfx_rect_round(widget_x[id] + 2, ry + 2,
                               widget_w[id] - 4, row_h - 4, 4,
                               ui_theme_accent_get());
            }
            // Each row pointer is 8 bytes (u64) at extra + i*8.
            let mut row_ptr = mem_read_u32(widget_extra[id] + i * 8);
            if row_ptr != 0 {
                let mut fg = ui_theme_text_primary();
                if i == sel { fg = gfx_pack(255, 255, 255, 255); }
                font_atlas_draw_str(widget_x[id] + pad,
                                    ry + (row_h - font_atlas_h(size)) / 2,
                                    cstr_from_addr(row_ptr), size, fg);
            }
            i = i + 1;
        }
    }
    widget_set_flag(id, WIDGET_FLAG_DIRTY, 0);
    return 0;
}

fn list_handle_pointer(id, ev_type, x, y) {
    if widget_hit(id, x, y) == 0 { return 0; }
    if ev_type == PEV_TYPE_UP {
        let mut row_h = list_row_height();
        let mut row   = (y - widget_y[id]) / row_h;
        if row < 0           { row = 0; }
        if row >= widget_max[id] { row = widget_max[id] - 1; }
        widget_set_value(id, row);
        return 1;
    }
    return 0;
}

// ─── Tree ───────────────────────────────────────────────────────────────────
// Visible-row count stored same as list; depth-per-row encoded in a parallel
// array whose base is stored in widget_label[id].

fn tree_new(parent, x, y, w, h, row_count, rows_addr, depths_addr) {
    let mut id = widget_new(WIDGET_KIND_TREE, parent, x, y, w, h);
    widget_set_range(id, 0, row_count);
    widget_set_extra(id, rows_addr);
    widget_set_label(id, depths_addr);
    widget_set_value(id, 0 - 1);
    return id;
}

fn tree_paint(id) {
    if widget_get_flag(id, WIDGET_FLAG_VISIBLE) == 0 { return 0; }
    widget_base_rect(id, 6);
    let mut n     = widget_max[id];
    let mut size  = al_density_font_body();
    let mut row_h = list_row_height();
    let mut i = 0;
    while i < n {
        let mut ry = widget_y[id] + i * row_h;
        if ry + row_h > widget_y[id] + widget_h[id] { i = n; }
        else {
            let mut depth = mem_read_u8(widget_label[id] + i);
            let mut indent = 12 + depth * 16;
            let mut row_ptr = mem_read_u32(widget_extra[id] + i * 8);
            if row_ptr != 0 {
                font_atlas_draw_str(widget_x[id] + indent,
                                    ry + (row_h - font_atlas_h(size)) / 2,
                                    cstr_from_addr(row_ptr), size,
                                    ui_theme_text_primary());
            }
            // Disclosure chevron when has children (encoded as bit 7 of depth byte).
            if mem_read_u8(widget_label[id] + i) >= 128 {
                let mut cx = widget_x[id] + indent - 12;
                let mut cy = ry + row_h / 2;
                gfx_path_reset();
                gfx_path_move(cx,     cy - 3);
                gfx_path_line(cx + 4, cy);
                gfx_path_line(cx,     cy + 3);
                gfx_path_stroke(ui_theme_text_secondary());
            }
            i = i + 1;
        }
    }
    widget_set_flag(id, WIDGET_FLAG_DIRTY, 0);
    return 0;
}

// ─── Table ──────────────────────────────────────────────────────────────────
// Simplest viable: header row + body. Column count in widget_value, column
// widths array address in widget_label, cell-grid pointer array in widget_extra.

fn table_new(parent, x, y, w, h, cols, rows, col_widths_addr, cells_addr) {
    let mut id = widget_new(WIDGET_KIND_TABLE, parent, x, y, w, h);
    widget_set_value(id, cols);
    widget_set_range(id, 0, rows);
    widget_set_label(id, col_widths_addr);
    widget_set_extra(id, cells_addr);
    return id;
}

fn table_paint(id) {
    if widget_get_flag(id, WIDGET_FLAG_VISIBLE) == 0 { return 0; }
    widget_base_rect(id, 6);
    let mut cols  = widget_value[id];
    let mut rows  = widget_max[id];
    let mut size  = al_density_font_body();
    let mut row_h = list_row_height();
    // Header
    gfx_fill_rect(widget_x[id], widget_y[id], widget_w[id], row_h,
                  ui_theme_bg_overlay());
    let mut col_x = widget_x[id];
    let mut c = 0;
    while c < cols {
        let mut cw = mem_read_u16(widget_label[id] + c * 2);
        let mut r = 0;
        while r < rows {
            let mut ry = widget_y[id] + (r + 1) * row_h;
            if ry + row_h > widget_y[id] + widget_h[id] { r = rows; }
            else {
                let mut cell_ptr = mem_read_u32(widget_extra[id] + (r * cols + c) * 8);
                if cell_ptr != 0 {
                    font_atlas_draw_str(col_x + 8,
                                        ry + (row_h - font_atlas_h(size)) / 2,
                                        cstr_from_addr(cell_ptr), size,
                                        ui_theme_text_primary());
                }
                r = r + 1;
            }
        }
        col_x = col_x + cw;
        c = c + 1;
    }
    widget_set_flag(id, WIDGET_FLAG_DIRTY, 0);
    return 0;
}

print("widget_list.hl loaded");
