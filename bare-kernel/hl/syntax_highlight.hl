// syntax_highlight.hl -- H-L Syntax Highlighter (Phase 7: 生态与自举完善, iter 428)
// Buffer: 0x1E30000
//
// Character-level tokenizer + color lookup for H-L source rendering.
//
// Token types:
//   SH_TYPE_KEYWORD = 0  (fn/let/if/while/return/array/set_at)
//   SH_TYPE_STRING  = 1  (double-quote strings)
//   SH_TYPE_COMMENT = 2  (// line comments)
//   SH_TYPE_NUMBER  = 3  (digit sequences)
//   SH_TYPE_IDENT   = 4  (unrecognized identifiers)
//   SH_TYPE_SYMBOL  = 5  (operators, punctuation)
//   SH_TYPE_SPACE   = 6  (whitespace — no color)
//
// ANSI color codes (integer):
//   SH_COLOR_KEYWORD = 33 (yellow)
//   SH_COLOR_STRING  = 32 (green)
//   SH_COLOR_COMMENT = 36 (cyan)
//   SH_COLOR_NUMBER  = 35 (magenta)
//   SH_COLOR_IDENT   = 37 (white)
//   SH_COLOR_SYMBOL  = 34 (blue)
//   SH_COLOR_SPACE   =  0 (none)
//
// sh_scan_token(pos) scans sh_line_buf from pos; returns len*10+type.
// sh_highlight_current_line() fills sh_line_colors[0..sh_line_len-1].
// sh_get_color_at(col) returns color code for that column.
//
// Rule table (inherited interface): token_id → color/type mapping.
//
// Shell: sh init/test/add/color/type/find/count/setline/highlight/coloat (10 cmds)

let SH_MAX_RULES  = 32;
let SH_LINE_LEN   = 128;

let mut SH_TYPE_KEYWORD = 0;
let mut SH_TYPE_STRING  = 1;
let mut SH_TYPE_COMMENT = 2;
let mut SH_TYPE_NUMBER  = 3;
let mut SH_TYPE_IDENT   = 4;
let mut SH_TYPE_SYMBOL  = 5;
let mut SH_TYPE_SPACE   = 6;

let mut SH_COLOR_KEYWORD = 33;
let mut SH_COLOR_STRING  = 32;
let mut SH_COLOR_COMMENT = 36;
let mut SH_COLOR_NUMBER  = 35;
let mut SH_COLOR_IDENT   = 37;
let mut SH_COLOR_SYMBOL  = 34;
let mut SH_COLOR_SPACE   = 0;

// Rule table
let sh_rule_token = array(32, 0);
let sh_rule_color = array(32, 0);
let sh_rule_type  = array(32, 0);
let mut sh_n_rules    = 0;

// Line buffer and color output
let sh_line_buf    = array(128, 0);   // ASCII char codes of current line
let mut sh_line_len    = 0;
let sh_line_colors = array(128, 0);   // color code per column after highlighting

fn syn_hi_init() {
    let mut i = 0;
    while i < SH_MAX_RULES {
        set_at(sh_rule_token, i, 0);
        set_at(sh_rule_color, i, 0);
        set_at(sh_rule_type,  i, 0);
        i += 1;
    }
    let mut j = 0;
    while j < SH_LINE_LEN {
        set_at(sh_line_buf,    j, 0);
        set_at(sh_line_colors, j, 0);
        j += 1;
    }
    sh_n_rules = 0;
    sh_line_len = 0;
    return 0;
}

fn sh_find_rule(token_id) {
    let mut i = 0;
    while i < sh_n_rules {
        if sh_rule_token[i] == token_id { return i; }
        i += 1;
    }
    return 0 - 1;
}

fn sh_add_rule(token_id, color, rule_type) {
    let mut idx = sh_find_rule(token_id);
    if idx >= 0 {
        set_at(sh_rule_color, idx, color);
        set_at(sh_rule_type,  idx, rule_type);
        return idx;
    }
    if sh_n_rules >= SH_MAX_RULES { return 0 - 1; }
    let mut slot = sh_n_rules;
    set_at(sh_rule_token, slot, token_id);
    set_at(sh_rule_color, slot, color);
    set_at(sh_rule_type,  slot, rule_type);
    sh_n_rules += 1;
    return slot;
}

fn sh_get_color(token_id) {
    let mut idx = sh_find_rule(token_id);
    if idx < 0 { return 0 - 1; }
    return sh_rule_color[idx];
}

fn sh_get_type(token_id) {
    let mut idx = sh_find_rule(token_id);
    if idx < 0 { return 0 - 1; }
    return sh_rule_type[idx];
}

fn sh_count() { return sh_n_rules; }

// --- Character classification ---

fn sh_is_alpha(ch) {
    if ch >= 65 { if ch <= 90  { return 1; } }
    if ch >= 97 { if ch <= 122 { return 1; } }
    if ch == 95 { return 1; }   // underscore
    return 0;
}

fn sh_is_digit(ch) {
    if ch >= 48 { if ch <= 57 { return 1; } }
    return 0;
}

fn sh_is_alnum(ch) {
    if sh_is_alpha(ch) == 1 { return 1; }
    if sh_is_digit(ch) == 1 { return 1; }
    return 0;
}

fn sh_is_space(ch) {
    if ch == 32 { return 1; }   // space
    if ch == 9  { return 1; }   // tab
    return 0;
}

// Compute sum of char codes for token at sh_line_buf[pos..pos+len-1].
fn _sh_token_sum(pos, len) {
    let mut s = 0;
    let mut i = 0;
    while i < len {
        s = s + sh_line_buf[pos + i];
        i += 1;
    }
    return s;
}

// Classify an identifier token by char-sum + length → keyword or ident.
// H-L keywords and their (sum, len) pairs:
//   "fn"     → sum=212, len=2
//   "let"    → sum=325, len=3
//   "if"     → sum=207, len=2
//   "while"  → sum=537, len=5
//   "return" → sum=672, len=6
//   "array"  → sum=543, len=5
//   "set_at" → sum=640, len=6
fn _sh_is_keyword(pos, len) {
    let mut s = _sh_token_sum(pos, len);
    if len == 2 {
        if s == 212 { return 1; }   // "fn"
        if s == 207 { return 1; }   // "if"
    }
    if len == 3 {
        if s == 325 { return 1; }   // "let"
    }
    if len == 5 {
        if s == 537 { return 1; }   // "while"
        if s == 543 { return 1; }   // "array"
    }
    if len == 6 {
        if s == 672 { return 1; }   // "return"
        if s == 640 { return 1; }   // "set_at"
    }
    return 0;
}

// Map token type to color code.
fn _sh_type_to_color(t) {
    if t == SH_TYPE_KEYWORD { return SH_COLOR_KEYWORD; }
    if t == SH_TYPE_STRING  { return SH_COLOR_STRING;  }
    if t == SH_TYPE_COMMENT { return SH_COLOR_COMMENT; }
    if t == SH_TYPE_NUMBER  { return SH_COLOR_NUMBER;  }
    if t == SH_TYPE_IDENT   { return SH_COLOR_IDENT;   }
    if t == SH_TYPE_SYMBOL  { return SH_COLOR_SYMBOL;  }
    return SH_COLOR_SPACE;
}

// Set character in line buffer (caller fills the buffer before highlighting).
fn sh_set_line_char(pos, ch) {
    if pos < 0           { return 0 - 1; }
    if pos >= SH_LINE_LEN { return 0 - 1; }
    set_at(sh_line_buf, pos, ch);
    return pos;
}

fn sh_set_line_len(len) {
    sh_line_len = len;
    return len;
}

// Scan one token from sh_line_buf starting at `pos`.
// Returns: token_len * 10 + token_type   (0 if pos >= sh_line_len)
//
// Each variable-length scanner uses a `token_end` variable (defaults to
// sh_line_len) that is set to the actual terminating position when a
// boundary character is found, avoiding the off-by-one that arises from
// using the loop variable itself as a break flag.
fn sh_scan_token(pos) {
    if pos >= sh_line_len { return 0; }
    let mut ch = sh_line_buf[pos];

    // Whitespace
    if sh_is_space(ch) == 1 {
        let mut wend = sh_line_len;
        let mut ws = pos + 1;
        let mut wdone = 0;
        while ws < sh_line_len {
            if wdone == 0 {
                if sh_is_space(sh_line_buf[ws]) == 0 {
                    wend  = ws;
                    ws    = sh_line_len;
                    wdone = 1;
                }
            }
            if wdone == 0 { ws = ws + 1; }
        }
        return (wend - pos) * 10 + SH_TYPE_SPACE;
    }

    // Line comment: '//' (47 47)
    if ch == 47 {
        if pos + 1 < sh_line_len {
            if sh_line_buf[pos + 1] == 47 {
                return (sh_line_len - pos) * 10 + SH_TYPE_COMMENT;
            }
        }
        return 10 + SH_TYPE_SYMBOL;
    }

    // String: starts with '"' (34); scan to closing '"' (inclusive)
    if ch == 34 {
        let mut send = sh_line_len;
        let mut ss = pos + 1;
        let mut sdone = 0;
        while ss < sh_line_len {
            if sdone == 0 {
                if sh_line_buf[ss] == 34 {
                    send  = ss + 1;   // include the closing quote
                    ss    = sh_line_len;
                    sdone = 1;
                }
            }
            if sdone == 0 { ss = ss + 1; }
        }
        return (send - pos) * 10 + SH_TYPE_STRING;
    }

    // Number: starts with digit
    if sh_is_digit(ch) == 1 {
        let mut nend = sh_line_len;
        let mut ns = pos + 1;
        let mut ndone = 0;
        while ns < sh_line_len {
            if ndone == 0 {
                if sh_is_digit(sh_line_buf[ns]) == 0 {
                    nend  = ns;
                    ns    = sh_line_len;
                    ndone = 1;
                }
            }
            if ndone == 0 { ns = ns + 1; }
        }
        return (nend - pos) * 10 + SH_TYPE_NUMBER;
    }

    // Identifier or keyword: starts with alpha/underscore
    if sh_is_alpha(ch) == 1 {
        let mut iend = sh_line_len;
        let mut is_ = pos + 1;
        let mut idone = 0;
        while is_ < sh_line_len {
            if idone == 0 {
                if sh_is_alnum(sh_line_buf[is_]) == 0 {
                    iend  = is_;
                    is_   = sh_line_len;
                    idone = 1;
                }
            }
            if idone == 0 { is_ = is_ + 1; }
        }
        let mut ilen = iend - pos;
        let mut tok_type = SH_TYPE_IDENT;
        if _sh_is_keyword(pos, ilen) == 1 { tok_type = SH_TYPE_KEYWORD; }
        return ilen * 10 + tok_type;
    }

    // Multi-char operators: == != <= >= && || ->
    // Check before single-char fallthrough so they tokenize as one unit (len=2).
    if pos + 1 < sh_line_len {
        let mut ch2 = sh_line_buf[pos + 1];
        if ch == 61  { if ch2 == 61  { return 20 + SH_TYPE_SYMBOL; } }  // ==
        if ch == 33  { if ch2 == 61  { return 20 + SH_TYPE_SYMBOL; } }  // !=
        if ch == 60  { if ch2 == 61  { return 20 + SH_TYPE_SYMBOL; } }  // <=
        if ch == 62  { if ch2 == 61  { return 20 + SH_TYPE_SYMBOL; } }  // >=
        if ch == 38  { if ch2 == 38  { return 20 + SH_TYPE_SYMBOL; } }  // &&
        if ch == 124 { if ch2 == 124 { return 20 + SH_TYPE_SYMBOL; } }  // ||
        if ch == 45  { if ch2 == 62  { return 20 + SH_TYPE_SYMBOL; } }  // ->
    }

    // Single-char symbol (operators, braces, etc.)
    return 10 + SH_TYPE_SYMBOL;
}

// Tokenize sh_line_buf and fill sh_line_colors with per-column color codes.
fn sh_highlight_current_line() {
    let mut pos = 0;
    while pos < sh_line_len {
        let mut packed = sh_scan_token(pos);
        if packed == 0 { pos = sh_line_len; }
        if packed != 0 {
            let mut ttype = packed - (packed / 10) * 10;
            let mut tlen = packed / 10;
            let mut color = _sh_type_to_color(ttype);
            let mut ci = 0;
            while ci < tlen {
                if pos + ci < sh_line_len {
                    set_at(sh_line_colors, pos + ci, color);
                }
                ci = ci + 1;
            }
            pos = pos + tlen;
        }
    }
    return 0;
}

fn sh_get_color_at(col) {
    if col < 0           { return 0 - 1; }
    if col >= sh_line_len { return 0 - 1; }
    return sh_line_colors[col];
}

fn sh_test() {
    syn_hi_init();
    let mut pass = 1;

    // Rule table test (inherited interface)
    sh_add_rule(1, 1, SH_TYPE_KEYWORD);
    sh_add_rule(2, 2, SH_TYPE_STRING);
    sh_add_rule(3, 3, SH_TYPE_COMMENT);

    let mut cnt = sh_count();
    let mut c1 = sh_get_color(1);
    let mut c2 = sh_get_color(2);
    let mut t3 = sh_get_type(3);

    if cnt != 3              { pass = 0; }
    if c1  != 1              { pass = 0; }
    if c2  != 2              { pass = 0; }
    if t3  != SH_TYPE_COMMENT { pass = 0; }
    if sh_find_rule(2)  < 0  { pass = 0; }
    if sh_find_rule(99) >= 0  { pass = 0; }

    // Lexer test 1: "fn " → keyword(2) + space(1)
    // 'f'=102, 'n'=110, ' '=32
    sh_set_line_char(0, 102);
    sh_set_line_char(1, 110);
    sh_set_line_char(2, 32);
    sh_set_line_len(3);
    let mut tok0 = sh_scan_token(0);   // expect 2*10+0 = 20 (keyword, len=2)
    if tok0 != 20 { pass = 0; }
    let mut tok2 = sh_scan_token(2);   // expect 1*10+6 = 16 (space, len=1)
    if tok2 != 16 { pass = 0; }

    // Lexer test 2: "42" → number(2)
    // '4'=52, '2'=50
    sh_set_line_char(0, 52);
    sh_set_line_char(1, 50);
    sh_set_line_len(2);
    let mut tok_num = sh_scan_token(0);  // expect 2*10+3 = 23 (number, len=2)
    if tok_num != 23 { pass = 0; }

    // Lexer test 3: "//" → comment
    // '/'=47, '/'=47
    sh_set_line_char(0, 47);
    sh_set_line_char(1, 47);
    sh_set_line_len(2);
    let mut tok_cmt = sh_scan_token(0);  // expect 2*10+2 = 22 (comment, len=2)
    if tok_cmt != 22 { pass = 0; }

    // Highlight test: "let" → all 3 cols should get SH_COLOR_KEYWORD
    // 'l'=108, 'e'=101, 't'=116
    sh_set_line_char(0, 108);
    sh_set_line_char(1, 101);
    sh_set_line_char(2, 116);
    sh_set_line_len(3);
    sh_highlight_current_line();
    let mut col0 = sh_get_color_at(0);
    let mut col1 = sh_get_color_at(1);
    let mut col2 = sh_get_color_at(2);
    if col0 != SH_COLOR_KEYWORD { pass = 0; }
    if col1 != SH_COLOR_KEYWORD { pass = 0; }
    if col2 != SH_COLOR_KEYWORD { pass = 0; }

    // Lexer test 4: "==" → symbol, len=2 (2*10+5=25)
    // '='=61, '='=61
    sh_set_line_char(0, 61);
    sh_set_line_char(1, 61);
    sh_set_line_len(2);
    let mut tok_eq = sh_scan_token(0);   // expect 2*10+5 = 25 (symbol, len=2)
    if tok_eq != 25 { pass = 0; }

    // Lexer test 5: "->" → symbol, len=2 (2*10+5=25)
    // '-'=45, '>'=62
    sh_set_line_char(0, 45);
    sh_set_line_char(1, 62);
    sh_set_line_len(2);
    let mut tok_arrow = sh_scan_token(0);  // expect 25 (symbol, len=2)
    if tok_arrow != 25 { pass = 0; }

    print("sh_test: cnt=" + to_string(cnt)
          + " tok0=" + to_string(tok0)
          + " tok_num=" + to_string(tok_num)
          + " tok_cmt=" + to_string(tok_cmt)
          + " tok_eq=" + to_string(tok_eq)
          + " tok_arrow=" + to_string(tok_arrow)
          + " col0=" + to_string(col0));

    if pass == 1 { print("sh_test: PASS"); }
    if pass == 0 { print("sh_test: FAIL"); }
    return pass;
}

print("syntax_highlight.hl loaded");
