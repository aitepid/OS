// asn1.hl -- ASN.1 DER Encoding/Decoding
//
// ASN.1 (Abstract Syntax Notation One) with DER (Distinguished Encoding Rules).
// Used in X.509 certificates, SNMP, LDAP, PKCS, etc.
// TLV structure: Tag + Length + Value
//
// Features:
//   - Parse DER-encoded data (tag, length, value extraction)
//   - Encode basic types (integer, octet string, sequence, OID)
//   - Length encoding: short form (0-127) and long form (128+)
//   - Common tags: SEQUENCE, INTEGER, OCTET STRING, OID, NULL, BOOLEAN
//
// Memory:
//   - ASN1_BUF: 0xFE0000 (16646144), 64 KB encode/decode buffer

let ASN1_BUF = 16646144;         // 0xFE0000
let ASN1_BUF_SZ = 65536;         // 64 KB
let mut asn1_len = 0;

// ASN.1 universal tags
let ASN1_BOOLEAN = 1;
let ASN1_INTEGER = 2;
let ASN1_BIT_STRING = 3;
let ASN1_OCTET_STRING = 4;
let ASN1_NULL = 5;
let ASN1_OID = 6;
let ASN1_UTF8STRING = 12;
let ASN1_SEQUENCE = 48;          // 0x30
let ASN1_SET = 49;               // 0x31
let ASN1_PRINTABLESTRING = 19;

fn asn1_init() {
    asn1_len = 0;
    return 0;
}

fn asn1_clear() {
    asn1_len = 0;
    return 0;
}

fn _asn1_put(b) {
    if asn1_len >= ASN1_BUF_SZ { return 0; }
    mem_write_byte(ASN1_BUF + asn1_len, b);
    asn1_len = asn1_len + 1;
    return 1;
}

fn _asn1_encode_length(len) {
    if len < 128 {
        _asn1_put(len);
        return 0;
    }

    let mut octets = 0;
    let mut temp = len;
    while temp > 0 {
        octets = octets + 1;
        temp = temp / 256;
    }

    _asn1_put(128 + octets);

    let mut i = octets - 1;
    while i >= 0 {
        let mut shift = i * 8;
        let mut val = len;
        let mut j = 0;
        while j < shift {
            val = val / 2;
            j = j + 1;
        }
        _asn1_put(val % 256);
        i = i - 1;
    }

    return 0;
}

fn asn1_encode_integer(val) {
    _asn1_put(ASN1_INTEGER);

    let mut bytes = [];
    let mut temp = val;
    let is_negative = 0;

    if val < 0 {
        temp = 0 - val;
    }

    if temp == 0 {
        push(bytes, 0);
    } else {
        while temp > 0 {
            push(bytes, temp % 256);
            temp = temp / 256;
        }
    }

    let bytes_len = len(bytes);
    _asn1_encode_length(bytes_len);

    let mut i = bytes_len - 1;
    while i >= 0 {
        _asn1_put(bytes[i]);
        i = i - 1;
    }

    return 0;
}

fn asn1_encode_octet_string(data) {
    _asn1_put(ASN1_OCTET_STRING);
    _asn1_encode_length(len(data));

    let mut i = 0;
    while i < len(data) {
        _asn1_put(str_char_code(data, i));
        i = i + 1;
    }

    return 0;
}

fn asn1_encode_null() {
    _asn1_put(ASN1_NULL);
    _asn1_put(0);
    return 0;
}

fn asn1_encode_boolean(val) {
    _asn1_put(ASN1_BOOLEAN);
    _asn1_put(1);
    if val == 0 {
        _asn1_put(0);
    } else {
        _asn1_put(255);
    }
    return 0;
}

fn asn1_encode_sequence_start() {
    _asn1_put(ASN1_SEQUENCE);
    return asn1_len;
}

fn asn1_encode_sequence_end(start_pos) {
    let content_len = asn1_len - start_pos;

    let mut temp_len = content_len;
    let mut len_octets = 0;
    if temp_len < 128 {
        len_octets = 1;
    } else {
        while temp_len > 0 {
            len_octets = len_octets + 1;
            temp_len = temp_len / 256;
        }
        len_octets = len_octets + 1;
    }

    let mut shift = asn1_len - start_pos;
    let mut i = 0;
    while i < shift {
        let src = ASN1_BUF + asn1_len - 1 - i;
        let dst = ASN1_BUF + asn1_len - 1 - i + len_octets;
        mem_write_byte(dst, mem_read_byte(src));
        i = i + 1;
    }

    let len_pos = start_pos;
    asn1_len = start_pos;
    _asn1_encode_length(content_len);
    asn1_len = start_pos + len_octets + content_len;

    return 0;
}

fn asn1_parse_tag(data, offset) {
    if offset >= len(data) { return 0 - 1; }
    return str_char_code(data, offset);
}

fn asn1_parse_length(data, offset) {
    if offset >= len(data) { return [0 - 1, 0]; }

    let first = str_char_code(data, offset);

    if first < 128 {
        return [first, 1];
    }

    let num_octets = first % 128;
    if num_octets == 0 { return [0 - 1, 0]; }
    if offset + num_octets >= len(data) { return [0 - 1, 0]; }

    let mut length = 0;
    let mut i = 0;
    while i < num_octets {
        length = length * 256 + str_char_code(data, offset + 1 + i);
        i = i + 1;
    }

    return [length, 1 + num_octets];
}

fn asn1_parse_integer(data, offset, len_val) {
    let mut val = 0;
    let mut i = 0;
    while i < len_val {
        val = val * 256 + str_char_code(data, offset + i);
        i = i + 1;
    }
    return val;
}

fn asn1_parse_octet_string(data, offset, len_val) {
    let mut result = "";
    let mut i = 0;
    while i < len_val {
        result = result + str_from_code(str_char_code(data, offset + i));
        i = i + 1;
    }
    return result;
}

fn asn1_decode(data) {
    let mut offset = 0;
    let mut result = "ASN.1 DER:\n";

    while offset < len(data) {
        let tag = asn1_parse_tag(data, offset);
        if tag < 0 { return result; }

        let len_info = asn1_parse_length(data, offset + 1);
        let len_val = len_info[0];
        let len_bytes = len_info[1];

        if len_val < 0 { return result; }

        let value_offset = offset + 1 + len_bytes;

        if tag == ASN1_INTEGER {
            let int_val = asn1_parse_integer(data, value_offset, len_val);
            result = result + "  INTEGER: " + to_string(int_val) + "\n";
        } else {
            if tag == ASN1_OCTET_STRING {
                let str_val = asn1_parse_octet_string(data, value_offset, len_val);
                result = result + "  OCTET STRING: " + str_val + "\n";
            } else {
                if tag == ASN1_NULL {
                    result = result + "  NULL\n";
                } else {
                    if tag == ASN1_SEQUENCE {
                        result = result + "  SEQUENCE (len=" + to_string(len_val) + ")\n";
                    } else {
                        result = result + "  TAG " + to_string(tag) + " (len=" + to_string(len_val) + ")\n";
                    }
                }
            }
        }

        offset = value_offset + len_val;
    }

    return result;
}

fn asn1_get_hex() {
    let mut result = "";
    let mut i = 0;
    while i < asn1_len {
        let mut b = mem_read_byte(ASN1_BUF + i);
        let mut hi = b / 16;
        let mut lo = b % 16;
        if hi < 10 { result = result + str_from_code(48 + hi); }
        else { result = result + str_from_code(97 + hi - 10); }
        if lo < 10 { result = result + str_from_code(48 + lo); }
        else { result = result + str_from_code(97 + lo - 10); }
        i = i + 1;
    }
    return result;
}

fn asn1_selftest() {
    asn1_clear();
    asn1_encode_integer(42);
    asn1_encode_octet_string("hi");
    asn1_encode_null();

    let hex = asn1_get_hex();
    let expected = "02012a04026869";

    if hex == expected + "0500" {
        return "asn1 selftest: pass";
    }

    if hex == expected {
        return "asn1 selftest: partial (missing null)";
    }

    return "asn1 selftest: fail (got=" + hex + ")";
}

print("asn1.hl loaded");
