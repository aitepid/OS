// ui_terminal.hl -- HicOS Graphical Terminal
//
// A windowed terminal emulator that renders text into a wm window
// using the ui_controls text drawing primitives.
//
// Features:
//   - 80x25 character grid inside a wm window
//   - Scrollback buffer (64 lines beyond visible area)
//   - Cursor rendering with blink state
//   - Foreground/background color per cell (VGA 16-color palette)
//   - Shell output integration via ui_term_write / ui_term_putchar
//
// Memory layout:
//   Cell buffer at UITERM_BUF_ADDR: each cell = 4 bytes [char, fg, bg, flags]
//   Total: 80 * (25 + 64) * 4 = 28480 bytes

let UITERM_COLS = 80;
let UITERM_ROWS = 25;
let UITERM_SCROLLBACK = 64;
let UITERM_TOTAL_ROWS = 89;
let UITERM_CELL_W = 8;
let UITERM_CELL_H = 16;
let UITERM_BUF_ADDR = 9437184;  // 0x900000

let mut uiterm_cursor_x = 0;
let mut uiterm_cursor_y = 0;
let mut uiterm_scroll_offset = 0;
let mut uiterm_fg = 7;
let mut uiterm_bg = 0;
let mut uiterm_win_id = 0 - 1;
let mut uiterm_win_x = 60;
let mut uiterm_win_y = 40;
let mut uiterm_dirty = 1;
let mut uiterm_cursor_blink = 1;

// VGA 16-color ARGB palette
fn uiterm_vga_color(idx) {
    if idx == 0 { return 4278190080; }  // black
    if idx == 1 { return 4289200128; }  // red
    if idx == 2 { return 4278222848; }  // green
    if idx == 3 { return 4289232896; }  // yellow/brown
    if idx == 4 { return 4278190250; }  // blue
    if idx == 5 { return 4289200298; }  // magenta
    if idx == 6 { return 4278223018; }  // cyan
    if idx == 7 { return 4289243304; }  // light gray
    if idx == 8 { return 4286611584; }  // dark gray
    if idx == 9 { return 4294901760; }  // bright red
    if idx == 10 { return 4278255360; } // bright green
    if idx == 11 { return 4294967040; } // bright yellow
    if idx == 12 { return 4278190335; } // bright blue
    if idx == 13 { return 4294902015; } // bright magenta
    if idx == 14 { return 4278255615; } // bright cyan
    if idx == 15 { return 4294967295; } // white
    return 4289243304;
}

fn uiterm_cell_addr(col, row) {
    return UITERM_BUF_ADDR + (row * UITERM_COLS + col) * 4;
}

fn uiterm_set_cell(col, row, ch, fg, bg) {
    let addr = uiterm_cell_addr(col, row);
    mem_write_u8(addr, ch);
    mem_write_u8(addr + 1, fg);
    mem_write_u8(addr + 2, bg);
    mem_write_u8(addr + 3, 0);
    return 0;
}

fn uiterm_get_cell_char(col, row) {
    return mem_read_u8(uiterm_cell_addr(col, row));
}

fn uiterm_get_cell_fg(col, row) {
    return mem_read_u8(uiterm_cell_addr(col, row) + 1);
}

fn uiterm_get_cell_bg(col, row) {
    return mem_read_u8(uiterm_cell_addr(col, row) + 2);
}

fn uiterm_clear_row(row) {
    let mut col = 0;
    while col < UITERM_COLS {
        uiterm_set_cell(col, row, 32, uiterm_fg, uiterm_bg);
        col = col + 1;
    }
    return 0;
}

fn uiterm_clear() {
    let mut row = 0;
    while row < UITERM_TOTAL_ROWS {
        uiterm_clear_row(row);
        row = row + 1;
    }
    uiterm_cursor_x = 0;
    uiterm_cursor_y = 0;
    uiterm_scroll_offset = 0;
    uiterm_dirty = 1;
    return 0;
}

fn uiterm_scroll_up() {
    // Move all rows up by 1
    let mut row = 1;
    while row < UITERM_TOTAL_ROWS {
        let mut col = 0;
        while col < UITERM_COLS {
            let ch = uiterm_get_cell_char(col, row);
            let fg = uiterm_get_cell_fg(col, row);
            let bg = uiterm_get_cell_bg(col, row);
            uiterm_set_cell(col, row - 1, ch, fg, bg);
            col = col + 1;
        }
        row = row + 1;
    }
    uiterm_clear_row(UITERM_TOTAL_ROWS - 1);
    if uiterm_cursor_y > 0 {
        uiterm_cursor_y = uiterm_cursor_y - 1;
    }
    uiterm_dirty = 1;
    return 0;
}

fn uiterm_putchar(ch) {
    if ch == 10 {
        uiterm_cursor_x = 0;
        uiterm_cursor_y = uiterm_cursor_y + 1;
        if uiterm_cursor_y >= UITERM_ROWS {
            uiterm_scroll_up();
        }
        uiterm_dirty = 1;
        return 0;
    }
    if ch == 13 {
        uiterm_cursor_x = 0;
        return 0;
    }
    if ch == 8 {
        if uiterm_cursor_x > 0 {
            uiterm_cursor_x = uiterm_cursor_x - 1;
            uiterm_set_cell(uiterm_cursor_x, uiterm_cursor_y + uiterm_scroll_offset, 32, uiterm_fg, uiterm_bg);
            uiterm_dirty = 1;
        }
        return 0;
    }
    if ch == 9 {
        uiterm_cursor_x = ((uiterm_cursor_x / 8) + 1) * 8;
        if uiterm_cursor_x >= UITERM_COLS { uiterm_cursor_x = UITERM_COLS - 1; }
        return 0;
    }

    let buf_row = uiterm_cursor_y + uiterm_scroll_offset;
    uiterm_set_cell(uiterm_cursor_x, buf_row, ch, uiterm_fg, uiterm_bg);
    uiterm_cursor_x = uiterm_cursor_x + 1;
    if uiterm_cursor_x >= UITERM_COLS {
        uiterm_cursor_x = 0;
        uiterm_cursor_y = uiterm_cursor_y + 1;
        if uiterm_cursor_y >= UITERM_ROWS {
            uiterm_scroll_up();
        }
    }
    uiterm_dirty = 1;
    return 0;
}

fn uiterm_write(text) {
    let mut i = 0;
    while i < len(text) {
        uiterm_putchar(char_at(text, i));
        i = i + 1;
    }
    return 0;
}

fn uiterm_writeln(text) {
    uiterm_write(text);
    uiterm_putchar(10);
    return 0;
}

// Render visible portion of cell buffer to screen
fn uiterm_render() {
    if uiterm_dirty == 0 { return 0; }
    if uiterm_win_id < 0 { return 0; }

    let title_h = ui_theme_title_height();
    let base_x = uiterm_win_x + 1;
    let base_y = uiterm_win_y + title_h;

    let mut row = 0;
    while row < UITERM_ROWS {
        let buf_row = row + uiterm_scroll_offset;
        let py = base_y + row * UITERM_CELL_H;
        let mut col = 0;
        while col < UITERM_COLS {
            let ch = uiterm_get_cell_char(col, buf_row);
            let fg = uiterm_get_cell_fg(col, buf_row);
            let bg = uiterm_get_cell_bg(col, buf_row);
            let px = base_x + col * UITERM_CELL_W;
            let fg_argb = uiterm_vga_color(fg);
            let bg_argb = uiterm_vga_color(bg);
            vesa_fill_rect(px, py, UITERM_CELL_W, UITERM_CELL_H, bg_argb);
            if ch > 32 {
                if ch <= 126 {
                    ui_draw_char(px, py, ch, fg_argb, 0);
                }
            }
            col = col + 1;
        }
        row = row + 1;
    }

    // Draw cursor
    if uiterm_cursor_blink == 1 {
        let cx = base_x + uiterm_cursor_x * UITERM_CELL_W;
        let cy = base_y + uiterm_cursor_y * UITERM_CELL_H;
        vesa_fill_rect(cx, cy + UITERM_CELL_H - 2, UITERM_CELL_W, 2, uiterm_vga_color(uiterm_fg));
    }

    uiterm_dirty = 0;
    return 0;
}

fn uiterm_open() {
    let w = UITERM_COLS * UITERM_CELL_W + 2;
    let h = UITERM_ROWS * UITERM_CELL_H + 1;
    uiterm_win_x = 60;
    uiterm_win_y = 40;
    uiterm_win_id = wm_create_window(uiterm_win_x, uiterm_win_y, w, h, "Terminal", 0);
    uiterm_clear();
    uiterm_writeln("HicOS Terminal v1.0");
    uiterm_writeln("Type 'help' for commands.");
    uiterm_write("HicOS> ");
    return uiterm_win_id;
}

fn uiterm_close() {
    if uiterm_win_id >= 0 {
        wm_close_window(uiterm_win_id);
        uiterm_win_id = 0 - 1;
    }
    return 0;
}

fn uiterm_is_open() {
    if uiterm_win_id >= 0 { return 1; }
    return 0;
}

fn uiterm_set_color(fg, bg) {
    uiterm_fg = fg;
    uiterm_bg = bg;
    return 0;
}

fn uiterm_toggle_blink() {
    if uiterm_cursor_blink == 1 {
        uiterm_cursor_blink = 0;
    } else {
        uiterm_cursor_blink = 1;
    }
    uiterm_dirty = 1;
    return 0;
}

fn uiterm_info() {
    print("UI Terminal:");
    print("  Grid:     " + to_string(UITERM_COLS) + "x" + to_string(UITERM_ROWS));
    print("  Scroll:   " + to_string(UITERM_SCROLLBACK) + " lines");
    print("  Buffer:   0x" + format_hex(UITERM_BUF_ADDR, 8));
    print("  Window:   " + to_string(uiterm_win_id));
    print("  Cursor:   " + to_string(uiterm_cursor_x) + "," + to_string(uiterm_cursor_y));
    return 0;
}

print("ui_terminal.hl loaded");
print("UI terminal: 80x25 windowed, 64-line scrollback, VGA palette");