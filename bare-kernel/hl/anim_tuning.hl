// anim_tuning.hl -- 动画微调与减动模式（Sprint G8）
//
// 在 G2 anim_init 之上叠加全局调速器：
//   - reduce_motion: 把所有动画时长压到 1，等价瞬间完成
//   - speed_scale: 全局速率乘数（50% / 100% / 200%）
//   - quality_low: 关闭弹簧 overshoot 与多帧 spinner

let ANIM_SPEED_HALF   = 50;
let ANIM_SPEED_NORMAL = 100;
let ANIM_SPEED_DOUBLE = 200;

let mut atun_initialized = 0;
let mut atun_reduce_motion = 0;
let mut atun_speed_scale   = 100;
let mut atun_quality_low   = 0;

fn anim_tuning_init() {
    if atun_initialized == 1 { return 0; }
    atun_reduce_motion = 0;
    atun_speed_scale   = 100;
    atun_quality_low   = 0;
    atun_initialized = 1;
    print("anim_tuning: speed/reduce-motion/quality controls");
    return 0;
}

fn anim_reduce_motion_set(on) { atun_reduce_motion = on; return 0; }
fn anim_reduce_motion_get()   { return atun_reduce_motion; }

fn anim_speed_set(pct) {
    if pct < 10  { pct = 10; }
    if pct > 400 { pct = 400; }
    atun_speed_scale = pct;
    return 0;
}
fn anim_speed_get() { return atun_speed_scale; }

fn anim_quality_low_set(on) { atun_quality_low = on; return 0; }
fn anim_quality_low_get()   { return atun_quality_low; }

// 给 anim_start 的封装：自动调整 duration
fn anim_start_tuned(target_t, target_id, prop, from, to, dur_ms, ease) {
    if atun_initialized == 0 { anim_tuning_init(); }
    if atun_reduce_motion == 1 { dur_ms = 1; }
    else { dur_ms = dur_ms * 100 / atun_speed_scale; }
    if atun_quality_low == 1 { if ease == ANIM_EASE_SPRING { ease = ANIM_EASE_OUT; } }
    if dur_ms < 1 { dur_ms = 1; }
    return anim_start(target_t, target_id, prop, from, to, dur_ms, ease);
}

print("anim_tuning.hl loaded");
