// hilbert_alloc.hl -- Hilbert-Curve Spatial Page Allocator
//
// Maps physical pages to 3D Hilbert coordinates for cache-locality-aware
// allocation. Processes that are "spatially close" get physically close pages.
//
// This is the unique HicOS feature: memory allocation preserves spatial
// locality via Hilbert curve mapping. Adjacent allocations in Hilbert
// space map to nearby physical frames, improving cache utilization.

// Buddy allocator with Hilbert ordering
// Free lists indexed by order (0=4KB, 1=8KB, ..., 9=2MB)
let BUDDY_MAX_ORDER = 10;
let BUDDY_BASE_PAGE = 1025;   // first allocatable page
let BUDDY_TOTAL = 31743;      // 32768 - 1025

// Hilbert-ordered free list: each entry is a page index
// Pages are sorted by their Hilbert key for locality
let mut free_lists = [];

fn hilbert_alloc_init() {
    // Initialize free lists (one per order)
    free_lists = [];
    let mut i = 0;
    while i < BUDDY_MAX_ORDER {
        push(free_lists, []);
        i = i + 1;
    }

    // Add all pages to order-0 free list, sorted by Hilbert key
    // Convert page index to 3D coordinate: (x, y, z) = (page % 32, (page/32) % 32, (page/1024) % 32)
    i = BUDDY_BASE_PAGE;
    while i < BUDDY_BASE_PAGE + BUDDY_TOTAL {
        let x = i % 32;
        let y = (i / 32) % 32;
        let z = (i / 1024) % 32;
        let key = hilbert_encode(x, y, z);
        push(free_lists[0], [key, i]); // [hilbert_key, page_index]
        i = i + 1;
    }

    // Sort by Hilbert key (simple insertion sort for init)
    let list = free_lists[0];
    let mut j = 1;
    while j < len(list) {
        let temp = list[j];
        let mut k = j - 1;
        while k >= 0 {
            if list[k][0] > temp[0] {
                set_at(list, k + 1, list[k]);
                k = k - 1;
            } else {
                k = 0 - 1; // break
            }
        }
        set_at(list, k + 1, temp);
        j = j + 1;
    }

    return 0;
}

// Allocate pages near a target Hilbert key (for spatial locality)
fn hilbert_page_alloc(target_key) {
    let list = free_lists[0];
    if len(list) == 0 { return 0; }

    // Binary search for nearest key
    let mut lo = 0;
    let mut hi = len(list) - 1;
    while lo < hi {
        let mid = (lo + hi) / 2;
        if list[mid][0] < target_key {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }

    // lo is the closest entry
    let entry = list[lo];
    // Remove from free list (swap with last, pop)
    set_at(list, lo, list[len(list) - 1]);
    // pop last element
    let mut new_list = [];
    let mut i = 0;
    while i < len(list) - 1 {
        push(new_list, list[i]);
        i = i + 1;
    }
    set_at(free_lists, 0, new_list);

    return entry[1] * 4096; // physical address
}

// Allocate pages for a quadrant (spatial module)
fn hilbert_quadrant_alloc(qx, qy, qz, num_pages) {
    let base_key = hilbert_encode(qx, qy, qz);
    let mut addrs = [];
    let mut i = 0;
    while i < num_pages {
        let addr = hilbert_page_alloc(base_key + i);
        if addr == 0 { return addrs; } // out of memory
        push(addrs, addr);
        i = i + 1;
    }
    return addrs;
}

// Free a page back to the Hilbert-ordered list
fn hilbert_page_free(phys_addr) {
    let page = phys_addr / 4096;
    let x = page % 32;
    let y = (page / 32) % 32;
    let z = (page / 1024) % 32;
    let key = hilbert_encode(x, y, z);
    push(free_lists[0], [key, page]);
    return 0;
}

// Self-test
print("hilbert_alloc.hl loaded");
print("Buddy orders: 0-" + to_string(BUDDY_MAX_ORDER - 1));
print("Total allocatable: " + to_string(BUDDY_TOTAL) + " pages (" + to_string(BUDDY_TOTAL * 4) + " KB)");

// Test Hilbert key generation for page indices
let k0 = hilbert_encode(0, 0, 0);
let k1 = hilbert_encode(1, 0, 0);
let k2 = hilbert_encode(0, 1, 0);
print("Key(0,0,0)=" + to_string(k0) + " Key(1,0,0)=" + to_string(k1) + " Key(0,1,0)=" + to_string(k2));
