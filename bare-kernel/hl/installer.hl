// installer.hl -- HicOS Bare-Metal Installer
//
// Interactive installer that runs inside the HicOS kernel.
// Accessed via: shell > install
//
// Supports three disk backends (auto-detected in priority order):
//   1. ATA PIO  -- real IDE/SATA hardware (bare-metal)
//   2. AHCI DMA -- real SATA hardware via AHCI controller
//   3. VirtIO-blk -- QEMU virtual disk
//
// Installation flow:
//   1. Detect target disk (ATA PIO → AHCI → VirtIO)
//   2. Partition disk (MBR + single FAT16 partition)
//   3. Format partition (FAT16)
//   4. Write bootloader (stage1 MBR + stage2)
//   5. Write kernel image
//   6. Write H-L source files to FAT16
//   7. Verify installation
//   8. Prompt reboot
//
// Iteration 121: multi-backend disk support for bare-metal installation

// MBR Partition Table entry (16 bytes at offset 446..509 in sector 0):
//   +0:  status (1) -- 0x80 = active/bootable
//   +1:  CHS start (3)
//   +4:  type (1) -- 0x06 = FAT16 >32MB
//   +5:  CHS end (3)
//   +8:  LBA start (4)
//   +12: LBA sectors (4)

// Disk backend type: 0=none, 1=ata_pio, 2=ahci, 3=virtio
let mut installer_disk_backend = 0;
let mut installer_disk_sectors = 0;

// Unified sector read/write dispatchers
fn installer_disk_read(lba, count, buf_addr) {
    if installer_disk_backend == 1 {
        return ata_pio_read(lba, count, buf_addr);
    }
    if installer_disk_backend == 2 {
        return ahci_read(0, lba, count, buf_addr);
    }
    if installer_disk_backend == 3 {
        return virtio_blk_read(lba, count, buf_addr);
    }
    return 0;
}

fn installer_disk_write(lba, count, buf_addr) {
    if installer_disk_backend == 1 {
        return ata_pio_write(lba, count, buf_addr);
    }
    if installer_disk_backend == 2 {
        return ahci_write(0, lba, count, buf_addr);
    }
    if installer_disk_backend == 3 {
        return virtio_blk_write(lba, count, buf_addr);
    }
    return 0;
}

fn installer_detect_disk() {
    // Priority 1: ATA PIO (works on real IDE/SATA hardware)
    let ata_cap = ata_pio_capacity();
    if ata_cap > 0 {
        installer_disk_backend = 1;
        installer_disk_sectors = ata_cap;
        let mb = ata_cap * 512 / 1048576;
        print("  Backend: ATA PIO (real hardware)");
        print("  Disk: " + to_string(ata_cap) + " sectors (" + to_string(mb) + " MB)");
        return ata_cap;
    }

    // Priority 2: AHCI (real SATA via DMA)
    if ahci_port_count > 0 {
        // Use first AHCI port with a device
        let ahci_cap = ahci_identify(0);
        if ahci_cap > 0 {
            installer_disk_backend = 2;
            installer_disk_sectors = ahci_cap;
            let mb = ahci_cap * 512 / 1048576;
            print("  Backend: AHCI DMA (SATA)");
            print("  Disk: " + to_string(ahci_cap) + " sectors (" + to_string(mb) + " MB)");
            return ahci_cap;
        }
    }

    // Priority 3: VirtIO-blk (QEMU virtual disk)
    let vio_cap = virtio_blk_capacity();
    if vio_cap > 0 {
        installer_disk_backend = 3;
        installer_disk_sectors = vio_cap;
        let mb = vio_cap * 512 / 1048576;
        print("  Backend: VirtIO-blk (virtual)");
        print("  Disk: " + to_string(vio_cap) + " sectors (" + to_string(mb) + " MB)");
        return vio_cap;
    }

    print("  ERROR: No disk device found.");
    print("  Checked: ATA PIO, AHCI, VirtIO-blk -- none available.");
    return 0;
}

fn installer_create_mbr(total_sectors) {
    let mbr_buf = page_alloc();
    mem_zero(mbr_buf, 512);

    // Read existing MBR (preserve boot code if present)
    installer_disk_read(0, 1, mbr_buf);

    // Partition 1 entry at offset 446
    let p1 = mbr_buf + 446;
    mem_write_u8(p1, 128);        // 0x80 = bootable
    mem_write_u8(p1 + 1, 0);     // CHS start head
    mem_write_u8(p1 + 2, 2);     // CHS start sector (1-based)
    mem_write_u8(p1 + 3, 0);     // CHS start cylinder
    mem_write_u8(p1 + 4, 6);     // Type: 0x06 = FAT16 >32MB
    mem_write_u8(p1 + 5, 254);   // CHS end head
    mem_write_u8(p1 + 6, 255);   // CHS end sector
    mem_write_u8(p1 + 7, 255);   // CHS end cylinder
    mem_write_u32(p1 + 8, 1);    // LBA start = 1
    mem_write_u32(p1 + 12, total_sectors - 1);

    // Zero partitions 2-4
    mem_zero(p1 + 16, 48);

    // Boot signature
    mem_write_u8(mbr_buf + 510, 85);   // 0x55
    mem_write_u8(mbr_buf + 511, 170);  // 0xAA

    installer_disk_write(0, 1, mbr_buf);
    page_free(mbr_buf);
    print("  MBR partition table written.");
    return 1;
}

fn installer_format_partition(part_start, part_sectors) {
    print("  Formatting FAT16 partition (" + to_string(part_sectors) + " sectors)...");
    fat16_format(part_sectors);
    print("  FAT16 format complete.");
    return 1;
}

fn installer_write_bootloader(img_data, img_size) {
    if img_size < 512 {
        print("  Error: image too small for bootloader.");
        return 0;
    }
    let mbr_buf = page_alloc();
    installer_disk_read(0, 1, mbr_buf);
    // Overwrite boot code (first 446 bytes), preserve partition table
    let mut i = 0;
    while i < 446 {
        mem_write_u8(mbr_buf + i, img_data[i]);
        i = i + 1;
    }
    mem_write_u8(mbr_buf + 510, 85);
    mem_write_u8(mbr_buf + 511, 170);
    installer_disk_write(0, 1, mbr_buf);
    page_free(mbr_buf);

    // Write stage2 + kernel (sectors 1+)
    let remaining_sectors = (img_size - 512 + 511) / 512;
    let data_buf = page_alloc();
    let mut sec = 0;
    while sec < remaining_sectors {
        let mut bi = 0;
        while bi < 512 {
            let src_off = 512 + sec * 512 + bi;
            if src_off < img_size {
                mem_write_u8(data_buf + bi, img_data[src_off]);
            } else {
                mem_write_u8(data_buf + bi, 0);
            }
            bi = bi + 1;
        }
        installer_disk_write(sec + 1, 1, data_buf);
        sec = sec + 1;
    }
    page_free(data_buf);
    print("  Bootloader written: " + to_string(remaining_sectors + 1) + " sectors.");
    return 1;
}

fn installer_verify() {
    let verify_buf = page_alloc();
    installer_disk_read(0, 1, verify_buf);
    let sig_lo = mem_read_u8(verify_buf + 510);
    let sig_hi = mem_read_u8(verify_buf + 511);
    page_free(verify_buf);
    if sig_lo == 85 && sig_hi == 170 {
        print("  Verification: MBR boot signature OK (0x55AA)");
        return 1;
    }
    print("  Verification FAILED: bad boot signature");
    return 0;
}

fn installer_check_capacity() {
    let need = self_image_sectors();
    if need == 0 {
        print("  ERROR: current boot image metadata unavailable.");
        return 0;
    }
    if installer_disk_sectors < need {
        print("  ERROR: target disk too small.");
        print("  Need: " + to_string(need) + " sectors, have: " + to_string(installer_disk_sectors));
        return 0;
    }
    print("  Capacity OK: " + to_string(installer_disk_sectors) + " >= " + to_string(need) + " sectors");
    return 1;
}

fn installer_write_current_image() {
    let total = self_image_sectors();
    let written = self_install_to_disk();
    if written != total {
        print("  ERROR: image write incomplete (" + to_string(written) + "/" + to_string(total) + " sectors)");
        return 0;
    }
    print("  Raw boot image written: " + to_string(written) + " sectors");
    return 1;
}

fn installer_main() {
    print("========================================");
    print("  HicOS Bare-Metal Installer v7.0");
    print("========================================");
    print("");

    // Step 1: Detect disk (multi-backend)
    print("[1/7] Detecting target disk...");
    let cap = installer_detect_disk();
    if cap == 0 { return 1; }

    // Step 2: Detect boot mode
    print("[2/7] Detecting boot mode...");
    let is_uefi = uefi_is_boot();
    if is_uefi == 1 {
        print("  Boot mode: UEFI");
    } else {
        print("  Boot mode: Legacy BIOS");
    }

    // Step 3: Inspect current image
    print("[3/7] Inspecting running boot image...");
    self_image_info();
    if self_image_sectors() == 0 { return 1; }

    // Step 4: Capacity check
    print("[4/7] Checking target capacity...");
    if installer_check_capacity() == 0 { return 1; }

    // Step 5: Raw image write
    print("[5/7] Writing full boot image to target disk...");
    if installer_write_current_image() == 0 { return 1; }

    // Step 6: Boot metadata fixup
    print("[6/7] Finalizing boot metadata...");
    if is_uefi == 1 {
        print("  Current runtime is UEFI; raw image written as current boot snapshot.");
    } else {
        installer_create_mbr(cap);
    }

    // Step 7: Verify
    print("[7/7] Verifying installation...");
    installer_verify();

    print("");
    print("========================================");
    print("  Installation Complete!");
    let backend_name = "unknown";
    if installer_disk_backend == 1 { backend_name = "ATA PIO"; }
    if installer_disk_backend == 2 { backend_name = "AHCI"; }
    if installer_disk_backend == 3 { backend_name = "VirtIO"; }
    print("  Disk backend: " + backend_name);
    if is_uefi == 1 {
        print("  UEFI: Reboot and select HicOS from boot menu.");
    } else {
        print("  Legacy: Reboot to start HicOS from disk.");
    }
    print("========================================");
    return 0;
}
