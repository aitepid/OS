// floyd_warshall.hl -- Floyd-Warshall All-Pairs Shortest Path
// Roy-Floyd-Warshall 1962: O(V³) DP, supports negative edges.
// FW_MAX_V=16; detects negative cycles via fw_dist[i][i] < 0.
//
// Runtime buffer: 0x15A0000 (4 KB)

let FW_MAX_V = 16;
let FW_INF   = 1000000;

// Distance matrix fw_dist[u*16+v] = shortest path u→v (FW_INF = unreachable)
let fw_dist      = array(256, 0);
let fw_n         = 0;
let fw_neg_cycle = 0;    // 1 if any fw_dist[i][i] < 0 after fw_run()

fn floyd_warshall_init() {
    let i = 0;
    while i < 256 {
        set_at(fw_dist, i, FW_INF);
        i += 1;
    }
    // Self-distance = 0
    i = 0;
    while i < FW_MAX_V {
        set_at(fw_dist, i * FW_MAX_V + i, 0);
        i += 1;
    }
    fw_n         = 0;
    fw_neg_cycle = 0;
    return 0;
}

fn fw_set_n(n) {
    fw_n = n;
    return 0;
}

// Add directed weighted edge u→v with weight w (may be negative)
fn fw_add_edge(u, v, w) {
    if u >= FW_MAX_V { return 0 - 1; }
    if v >= FW_MAX_V { return 0 - 1; }
    let cur = fw_dist[u * FW_MAX_V + v];
    if cur == FW_INF {
        set_at(fw_dist, u * FW_MAX_V + v, w);
    } else {
        if w < cur {
            set_at(fw_dist, u * FW_MAX_V + v, w);
        }
    }
    if u + 1 > fw_n { fw_n = u + 1; }
    if v + 1 > fw_n { fw_n = v + 1; }
    return 0;
}

// Run Floyd-Warshall: O(V³) triple-loop DP
fn fw_run() {
    let k = 0;
    while k < fw_n {
        let i = 0;
        while i < fw_n {
            if fw_dist[i * FW_MAX_V + k] < FW_INF {
                let j = 0;
                while j < fw_n {
                    if fw_dist[k * FW_MAX_V + j] < FW_INF {
                        let via = fw_dist[i * FW_MAX_V + k] + fw_dist[k * FW_MAX_V + j];
                        if via < fw_dist[i * FW_MAX_V + j] {
                            set_at(fw_dist, i * FW_MAX_V + j, via);
                        }
                    }
                    j += 1;
                }
            }
            i += 1;
        }
        k += 1;
    }
    // Detect negative cycles: fw_dist[i][i] < 0
    fw_neg_cycle = 0;
    let i = 0;
    while i < fw_n {
        if fw_dist[i * FW_MAX_V + i] < 0 {
            fw_neg_cycle = 1;
        }
        i += 1;
    }
    return 0;
}

fn fw_dist_q(u, v) {
    if fw_dist[u * FW_MAX_V + v] >= FW_INF { return 0 - 1; }
    return fw_dist[u * FW_MAX_V + v];
}

fn fw_test() {
    floyd_warshall_init();
    fw_set_n(4);
    // Graph: 0→1:3, 0→3:7, 1→0:8, 1→2:2, 2→0:5, 2→3:1, 3→0:2
    // All-pairs after FW:
    //   d[0][1]=3, d[0][2]=5, d[0][3]=6
    //   d[1][0]=5(1→2→3→0), d[1][2]=2, d[1][3]=3(1→2→3)
    fw_add_edge(0, 1, 3);
    fw_add_edge(0, 3, 7);
    fw_add_edge(1, 0, 8);
    fw_add_edge(1, 2, 2);
    fw_add_edge(2, 0, 5);
    fw_add_edge(2, 3, 1);
    fw_add_edge(3, 0, 2);
    fw_run();
    let d01 = fw_dist_q(0, 1);
    let d02 = fw_dist_q(0, 2);
    let d03 = fw_dist_q(0, 3);
    let d10 = fw_dist_q(1, 0);
    print("fw_test d[0][1]=" + to_string(d01) + " d[0][2]=" + to_string(d02) + " d[0][3]=" + to_string(d03) + " d[1][0]=" + to_string(d10) + " neg_cycle=" + to_string(fw_neg_cycle));
    return d03;
}

print("floyd_warshall.hl loaded");
