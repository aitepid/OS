// ime.hl -- 输入法框架（Sprint G7）
//
// 拼音 stub：按下 Ctrl+Space 切换 IME，激活后键盘字符进入编辑缓冲，
// 按 Space 确认（直接把拼音串透传给目标 widget，真实词库版本留待 G8+）。
// 候选窗口：水平 5 候选，附在文本插入点附近。
//
// 公共 API：
//   ime_active() / ime_toggle()
//   ime_input_char(ch) -> 1 = consumed, 0 = passthrough
//   ime_attach(addr) -> 设置目标 widget 的输入回调地址（这里仅记录 id）
//   ime_paint(x, y) -> 在 (x, y) 绘制候选窗

let IME_BUF_ADDR     = 73662976;   // 0x04640000
let IME_BUF_SIZE     = 64;
let IME_CAND_MAX     = 5;
let IME_CAND_ADDR    = 73663040;   // 0x04640040 (5 槽 × 32 字节)
let IME_CAND_SLOT_SZ = 32;

let mut ime_initialized = 0;
let mut ime_on          = 0;
let mut ime_buf_len     = 0;
let mut ime_cand_count  = 0;
let mut ime_cand_sel    = 0;
let mut ime_target_id   = 0;

fn ime_init() {
    if ime_initialized == 1 { return 0; }
    ime_on = 0;
    ime_buf_len = 0;
    mem_write_u8(IME_BUF_ADDR, 0);
    ime_initialized = 1;
    print("ime: pinyin stub ready");
    return 0;
}

fn ime_active() { return ime_on; }

fn ime_toggle() {
    if ime_initialized == 0 { ime_init(); }
    if ime_on == 1 { ime_on = 0; ime_buf_len = 0;
        mem_write_u8(IME_BUF_ADDR, 0); }
    else { ime_on = 1; }
    return ime_on;
}

fn ime_attach(target_widget_id) { ime_target_id = target_widget_id; return 0; }

fn ime_buf_addr() { return IME_BUF_ADDR; }
fn ime_buf_len_get() { return ime_buf_len; }

fn ime_clear_buf() {
    ime_buf_len = 0;
    ime_cand_count = 0;
    ime_cand_sel = 0;
    mem_write_u8(IME_BUF_ADDR, 0);
    return 0;
}

// stub 候选生成：把当前 buffer 复制为 1-3 个候选
fn ime_rebuild_candidates() {
    ime_cand_count = 0;
    if ime_buf_len == 0 { return 0; }
    // 候选 1：原串
    let mut s0 = IME_CAND_ADDR + 0 * IME_CAND_SLOT_SZ;
    let mut i = 0;
    while i < ime_buf_len {
        mem_write_u8(s0 + i, mem_read_u8(IME_BUF_ADDR + i));
        i = i + 1;
    }
    mem_write_u8(s0 + ime_buf_len, 0);
    ime_cand_count = 1;
    // 候选 2：首字母大写
    if ime_buf_len > 0 {
        let mut s1 = IME_CAND_ADDR + 1 * IME_CAND_SLOT_SZ;
        let mut first = mem_read_u8(IME_BUF_ADDR);
        if first >= 97 { if first <= 122 { first = first - 32; } }
        mem_write_u8(s1, first);
        let mut j = 1;
        while j < ime_buf_len {
            mem_write_u8(s1 + j, mem_read_u8(IME_BUF_ADDR + j));
            j = j + 1;
        }
        mem_write_u8(s1 + ime_buf_len, 0);
        ime_cand_count = 2;
    }
    return 0;
}

// 返回 1 表示 IME 消费了该字符；0 表示透传给目标 widget
fn ime_input_char(ch) {
    if ime_initialized == 0 { ime_init(); }
    if ime_on == 0 { return 0; }
    if ch == 27 { ime_clear_buf(); return 1; }
    if ch == 8 {
        if ime_buf_len > 0 {
            ime_buf_len = ime_buf_len - 1;
            mem_write_u8(IME_BUF_ADDR + ime_buf_len, 0);
            ime_rebuild_candidates();
        }
        return 1;
    }
    if ch == 32 {
        // Space 提交当前候选
        if ime_cand_count == 0 { return 1; }
        let mut src = IME_CAND_ADDR + ime_cand_sel * IME_CAND_SLOT_SZ;
        let mut i = 0;
        let mut c = mem_read_u8(src);
        while c != 0 {
            // 直接调用目标的字符输入；这里仅留 hook
            i = i + 1;
            c = mem_read_u8(src + i);
        }
        ime_clear_buf();
        return 1;
    }
    if ch >= 97 { if ch <= 122 {
        if ime_buf_len < IME_BUF_SIZE - 1 {
            mem_write_u8(IME_BUF_ADDR + ime_buf_len, ch);
            ime_buf_len = ime_buf_len + 1;
            mem_write_u8(IME_BUF_ADDR + ime_buf_len, 0);
            ime_rebuild_candidates();
        }
        return 1;
    } }
    return 0;
}

fn ime_paint(x, y) {
    if ime_on == 0 { return 0; }
    if ime_buf_len == 0 { return 0; }
    let mut size = 13;
    let mut h = font_atlas_h(size) + 12;
    // 拼音输入条
    let mut input_str = cstr_from_addr(IME_BUF_ADDR);
    let mut iw = font_atlas_measure(input_str, size) + 16;
    gfx_shadow_draw_n(x, y, iw, h, 8);
    gfx_rect_round(x, y, iw, h, 6, ui_theme_bg_elevated());
    font_atlas_draw_str(x + 8, y + 6, input_str, size, ui_theme_accent_get());
    // 候选条
    if ime_cand_count > 0 {
        let mut cy = y + h + 4;
        let mut cx = x;
        let mut i = 0;
        while i < ime_cand_count {
            let mut s = cstr_from_addr(IME_CAND_ADDR + i * IME_CAND_SLOT_SZ);
            let mut sw = font_atlas_measure(s, size) + 14;
            let mut bg = ui_theme_bg_elevated();
            if i == ime_cand_sel { bg = ui_theme_accent_get(); }
            gfx_rect_round(cx, cy, sw, h, 6, bg);
            let mut fg = ui_theme_text_primary();
            if i == ime_cand_sel { fg = gfx_pack(255, 255, 255, 255); }
            font_atlas_draw_str(cx + 7, cy + 6, s, size, fg);
            cx = cx + sw + 4;
            i = i + 1;
        }
    }
    return 0;
}

print("ime.hl loaded");
