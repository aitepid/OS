// ext2.hl -- ext2 Filesystem Driver with Inode Hash Cache
//
// Iteration 92: added O(1) inode hash cache.
// ext2_read_inode now checks cache before disk I/O.
//
// Design:
//   64-entry cache, 16-bucket separate-chaining hash table
//   Key = inode number, Value = raw inode byte array
//   Cache hit avoids disk read (bcache + BGDT + inode table)
//
// Public API (all signatures preserved):
//   ext2_init / ext2_read_inode / ext2_read_file / ext2_list_dir
//   ext2_lookup / ext2_resolve / ext2_read_path
//   ext2_file_size / ext2_file_mode / ext2_is_dir / ext2_vfs_mount
//   ext2_icache_status (new)

let EXT2_MAGIC = 61267;       // 0xEF53
let EXT2_ROOT_INODE = 2;

let mut ext2_block_size = 1024;
let mut ext2_inodes_per_group = 0;
let mut ext2_blocks_per_group = 0;
let mut ext2_inode_size = 128;
let mut ext2_bgdt_block = 0;
let mut _ext2_part_lba = 0;

// ============================================================
// Inode hash cache
// ============================================================

let _IC_SIZE = 64;
let _IC_BUCKETS = 16;

let mut _ic_ino = [];       // inode number
let mut _ic_data = [];      // raw inode byte array
let mut _ic_valid = [];
let mut _ic_ht = [];        // bucket -> first slot (-1)
let mut _ic_next = [];      // slot -> next in chain (-1)
let mut _ic_count = 0;
let mut _ic_hits = 0;
let mut _ic_misses = 0;
let mut _ic_ready = 0;

fn _ic_hash(ino) {
    let mut h = ino % _IC_BUCKETS;
    if h < 0 { return h + _IC_BUCKETS; }
    return h;
}

fn _ic_init() {
    _ic_ino = [];
    _ic_data = [];
    _ic_valid = [];
    _ic_next = [];
    let mut i = 0;
    while i < _IC_SIZE {
        push(_ic_ino, 0);
        push(_ic_data, []);
        push(_ic_valid, 0);
        push(_ic_next, 0 - 1);
        i = i + 1;
    }
    _ic_ht = [];
    i = 0;
    while i < _IC_BUCKETS {
        push(_ic_ht, 0 - 1);
        i = i + 1;
    }
    _ic_count = 0;
    _ic_hits = 0;
    _ic_misses = 0;
    _ic_ready = 1;
    return 0;
}

fn _ic_lookup(ino) {
    if _ic_ready == 0 { _ic_init(); }
    let mut bucket = _ic_hash(ino);
    let mut cur = _ic_ht[bucket];
    while cur >= 0 {
        if _ic_valid[cur] == 1 {
            if _ic_ino[cur] == ino {
                _ic_hits = _ic_hits + 1;
                return _ic_data[cur];
            }
        }
        cur = _ic_next[cur];
    }
    _ic_misses = _ic_misses + 1;
    return [];
}

fn _ic_insert(ino, data) {
    if _ic_ready == 0 { _ic_init(); }
    let mut bucket = _ic_hash(ino);
    // Find free slot
    let mut slot = 0 - 1;
    let mut i = 0;
    while i < _IC_SIZE {
        if _ic_valid[i] == 0 {
            slot = i;
            i = _IC_SIZE;
        }
        i = i + 1;
    }
    // Evict slot 0 if full
    if slot < 0 {
        slot = 0;
        _ic_unchain(0);
        set_at(_ic_valid, 0, 0);
        _ic_count = _ic_count - 1;
    }
    set_at(_ic_ino, slot, ino);
    set_at(_ic_data, slot, data);
    set_at(_ic_valid, slot, 1);
    set_at(_ic_next, slot, _ic_ht[bucket]);
    set_at(_ic_ht, bucket, slot);
    _ic_count = _ic_count + 1;
    return 0;
}

fn _ic_unchain(slot) {
    let mut ino = _ic_ino[slot];
    let mut bucket = _ic_hash(ino);
    let mut prev = 0 - 1;
    let mut cur = _ic_ht[bucket];
    while cur >= 0 {
        if cur == slot {
            if prev < 0 {
                set_at(_ic_ht, bucket, _ic_next[cur]);
            } else {
                set_at(_ic_next, prev, _ic_next[cur]);
            }
            set_at(_ic_next, slot, 0 - 1);
            return 1;
        }
        prev = cur;
        cur = _ic_next[cur];
    }
    return 0;
}

fn ext2_icache_status() {
    return to_string(_ic_count) + "/" + to_string(_IC_SIZE) + " cached, " + to_string(_ic_hits) + " hits, " + to_string(_ic_misses) + " misses";
}

// ============================================================
// Superblock + init
// ============================================================

fn ext2_init(partition_start_lba) {
    let mut sb_sector = partition_start_lba + 2;
    let mut cache_blk = sb_sector / 8;
    let mut sb_addr = bcache_read(0, cache_blk);
    let mut sb_off_in_block = (sb_sector % 8) * 512;

    let mut magic = mem_read_u16(sb_addr + sb_off_in_block + 56);
    if magic != EXT2_MAGIC {
        print("ext2: bad magic 0x" + format_hex(magic, 4) + " (expected 0xEF53)");
        return 0;
    }

    let mut s_inodes_count = mem_read_u32(sb_addr + sb_off_in_block + 0);
    let mut s_blocks_count = mem_read_u32(sb_addr + sb_off_in_block + 4);
    let mut s_log_block_size = mem_read_u32(sb_addr + sb_off_in_block + 24);
    ext2_block_size = 1024;
    let mut shift = 0;
    while shift < s_log_block_size { ext2_block_size = ext2_block_size * 2; shift = shift + 1; }
    ext2_blocks_per_group = mem_read_u32(sb_addr + sb_off_in_block + 32);
    ext2_inodes_per_group = mem_read_u32(sb_addr + sb_off_in_block + 40);
    ext2_inode_size = mem_read_u16(sb_addr + sb_off_in_block + 88);
    if ext2_inode_size == 0 { ext2_inode_size = 128; }

    if ext2_block_size == 1024 {
        ext2_bgdt_block = 2;
    } else {
        ext2_bgdt_block = 1;
    }

    _ext2_part_lba = partition_start_lba;

    // Init inode cache on mount
    _ic_init();

    print("ext2: block_size=" + to_string(ext2_block_size) + " inodes=" + to_string(s_inodes_count) + " blocks=" + to_string(s_blocks_count));
    print("ext2: inodes/group=" + to_string(ext2_inodes_per_group) + " inode_size=" + to_string(ext2_inode_size));
    return 1;
}

// ============================================================
// Disk I/O helpers
// ============================================================

fn _ext2_disk_read(byte_offset, count) {
    let mut sector = _ext2_part_lba + byte_offset / 512;
    let mut cache_block = sector / 8;
    let mut addr = bcache_read(0, cache_block);
    let mut off_in_block = (sector % 8) * 512 + byte_offset % 512;
    let mut data = [];
    let mut i = 0;
    while i < count {
        push(data, mem_read_u8(addr + off_in_block + i));
        i = i + 1;
    }
    return data;
}

fn ext2_read_u32(arr, off) {
    return arr[off] + arr[off+1] * 256 + arr[off+2] * 65536 + arr[off+3] * 16777216;
}

fn ext2_read_u16(arr, off) {
    return arr[off] + arr[off+1] * 256;
}

fn ext2_read_block(blk_num) {
    let mut byte_off = blk_num * ext2_block_size;
    return _ext2_disk_read(byte_off, ext2_block_size);
}

// ============================================================
// Inode read (with hash cache)
// ============================================================

fn _ext2_read_inode_disk(inode_num) {
    if inode_num == 0 { return []; }
    let mut group = (inode_num - 1) / ext2_inodes_per_group;
    let mut index = (inode_num - 1) % ext2_inodes_per_group;

    let mut bgdt_byte_off = ext2_bgdt_block * ext2_block_size + group * 32;
    let mut bgdt_data = _ext2_disk_read(bgdt_byte_off, 32);
    let mut inode_table_blk = ext2_read_u32(bgdt_data, 8);

    let mut inode_byte_off = inode_table_blk * ext2_block_size + index * ext2_inode_size;
    return _ext2_disk_read(inode_byte_off, ext2_inode_size);
}

fn ext2_read_inode(inode_num) {
    if inode_num == 0 { return []; }
    // Check cache first O(1)
    let mut cached = _ic_lookup(inode_num);
    if len(cached) > 0 { return cached; }
    // Cache miss: read from disk
    let mut data = _ext2_read_inode_disk(inode_num);
    if len(data) > 0 {
        _ic_insert(inode_num, data);
    }
    return data;
}

// ============================================================
// File read
// ============================================================

fn ext2_read_file(inode_data, max_size) {
    let mut data = [];
    let mut file_size = ext2_read_u32(inode_data, 4);
    let mut limit = file_size;
    if max_size > 0 {
        if max_size < limit { limit = max_size; }
    }

    // Direct blocks (i_block[0..11])
    let mut i = 0;
    while i < 12 {
        if len(data) >= limit { i = 12; }
        else {
            let mut blk = ext2_read_u32(inode_data, 40 + i * 4);
            if blk == 0 { i = 12; }
            else {
                let mut block_data = ext2_read_block(blk);
                let mut j = 0;
                while j < len(block_data) {
                    if len(data) >= limit { j = len(block_data); }
                    else {
                        push(data, block_data[j]);
                        j = j + 1;
                    }
                }
            }
        }
        i = i + 1;
    }
    // Indirect block (i_block[12])
    if len(data) < limit {
        let mut ind_blk = ext2_read_u32(inode_data, 40 + 12 * 4);
        if ind_blk != 0 {
            let mut ind_data = ext2_read_block(ind_blk);
            let mut k = 0;
            while k < ext2_block_size / 4 {
                if len(data) >= limit { k = ext2_block_size; }
                else {
                    let mut blk = ext2_read_u32(ind_data, k * 4);
                    if blk == 0 { k = ext2_block_size; }
                    else {
                        let mut block_data = ext2_read_block(blk);
                        let mut j = 0;
                        while j < len(block_data) {
                            if len(data) >= limit { j = len(block_data); }
                            else {
                                push(data, block_data[j]);
                                j = j + 1;
                            }
                        }
                    }
                }
                k = k + 1;
            }
        }
    }
    return data;
}

// ============================================================
// Directory + path resolution
// ============================================================

fn ext2_list_dir(inode_num) {
    let mut inode = ext2_read_inode(inode_num);
    let mut dir_data = ext2_read_file(inode, 0);
    let mut entries = [];
    let mut off = 0;
    while off < len(dir_data) {
        let mut entry_inode = ext2_read_u32(dir_data, off);
        let mut rec_len = ext2_read_u16(dir_data, off + 4);
        let mut name_len = dir_data[off + 6];
        if rec_len == 0 { off = len(dir_data); }
        else {
            if entry_inode != 0 {
                let mut name = [];
                let mut ni = 0;
                while ni < name_len {
                    push(name, dir_data[off + 8 + ni]);
                    ni = ni + 1;
                }
                push(entries, [entry_inode, name]);
            }
            off = off + rec_len;
        }
    }
    return entries;
}

fn ext2_lookup(dir_inode, name) {
    let mut entries = ext2_list_dir(dir_inode);
    let mut i = 0;
    while i < len(entries) {
        if entries[i][1] == name { return entries[i][0]; }
        i = i + 1;
    }
    return 0;
}

fn ext2_resolve(path) {
    let mut current = EXT2_ROOT_INODE;
    let mut parts = str_split(path, "/");
    let mut i = 0;
    while i < len(parts) {
        if len(parts[i]) > 0 {
            let mut name_str = parts[i];
            let mut name_bytes = [];
            let mut j = 0;
            while j < len(name_str) {
                push(name_bytes, name_str[j]);
                j = j + 1;
            }
            let mut found = ext2_lookup(current, name_bytes);
            if found == 0 { return 0; }
            current = found;
        }
        i = i + 1;
    }
    return current;
}

fn ext2_read_path(path) {
    let mut inode_num = ext2_resolve(path);
    if inode_num == 0 { return []; }
    let mut inode = ext2_read_inode(inode_num);
    return ext2_read_file(inode, 0);
}

fn ext2_file_size(inode_data) {
    return ext2_read_u32(inode_data, 4);
}

fn ext2_file_mode(inode_data) {
    return ext2_read_u16(inode_data, 0);
}

fn ext2_is_dir(inode_data) {
    let mut mode = ext2_file_mode(inode_data);
    let mut ftype = (mode / 4096) % 16;
    return ftype == 4;
}

fn ext2_vfs_mount(mount_point, partition_lba) {
    let mut ok = ext2_init(partition_lba);
    if ok == 0 { return 0; }
    print("ext2: mounted at " + mount_point);
    return 1;
}

print("ext2.hl loaded (inode hash cache)");
print("ext2: " + to_string(_IC_SIZE) + "-entry inode cache, " + to_string(_IC_BUCKETS) + " hash buckets");
