// uefi_boot.hl -- UEFI Boot Protocol for HicOS
//
// Implements the UEFI boot path as an alternative to legacy BIOS.
// The UEFI firmware loads a PE32+ executable from the EFI System Partition
// (ESP) at \EFI\BOOT\BOOTX64.EFI. This module describes the data structures
// and handoff protocol that our UEFI stub uses to enter the kernel.
//
// == UEFI Boot Flow ==
//   1. Firmware loads BOOTX64.EFI from ESP (FAT32)
//   2. EFI stub calls ExitBootServices() to reclaim firmware memory
//   3. Stub passes boot info struct to kernel at a known address
//   4. Kernel reads framebuffer, memory map, ACPI RSDP from boot info
//   5. Kernel proceeds with normal init (skipping BIOS-specific steps)
//
// == EFI System Table ==
//   Passed to EFI application as second argument (RDX on x86-64)
//   +24: ConOut (SIMPLE_TEXT_OUTPUT_PROTOCOL*)
//   +56: BootServices (EFI_BOOT_SERVICES*)
//   +64: NumberOfTableEntries
//   +72: ConfigurationTable (EFI_CONFIGURATION_TABLE*)
//
// == EFI Boot Services (key functions) ==
//   +24:  AllocatePages
//   +40:  GetMemoryMap
//   +56:  AllocatePool
//   +64:  FreePool
//   +232: ExitBootServices
//   +296: LocateProtocol
//
// == EFI GOP (Graphics Output Protocol) ==
//   Used to get framebuffer address and mode info.
//   GUID: {9042a9de-23dc-4a38-96fb-7aded080516a}
//
// == Boot Info Structure (passed from UEFI stub to kernel) ==
//   Placed at 0x100000 (1 MB) before jumping to kernel entry.
//   This replaces E820 and VESA BIOS calls.

let UEFI_BOOT_INFO_ADDR = 1048576;  // 0x100000

// Boot info layout (256 bytes):
//   +0:   magic (8) = "HICUEFI\0" = [72,73,67,85,69,70,73,0]
//   +8:   memory_map_addr (8)
//   +16:  memory_map_entries (8)
//   +24:  memory_map_desc_size (8)
//   +32:  framebuffer_addr (8)
//   +40:  framebuffer_width (4)
//   +44:  framebuffer_height (4)
//   +48:  framebuffer_pitch (4)  -- bytes per scanline
//   +52:  framebuffer_bpp (4)    -- bits per pixel
//   +56:  acpi_rsdp_addr (8)
//   +64:  efi_runtime_services (8)  -- if needed post-ExitBootServices
//   +72:  boot_mode (8) -- 0=legacy BIOS, 1=UEFI
//   +80:  reserved (176 bytes)

let UEFI_MAGIC = [72, 73, 67, 85, 69, 70, 73, 0]; // "HICUEFI\0"

// EFI memory types (from UEFI spec)
let EFI_RESERVED          = 0;
let EFI_LOADER_CODE       = 1;
let EFI_LOADER_DATA       = 2;
let EFI_BOOT_SERVICES_CODE = 3;
let EFI_BOOT_SERVICES_DATA = 4;
let EFI_RUNTIME_SERVICES_CODE = 5;
let EFI_RUNTIME_SERVICES_DATA = 6;
let EFI_CONVENTIONAL       = 7;
let EFI_UNUSABLE           = 8;
let EFI_ACPI_RECLAIM       = 9;
let EFI_ACPI_NVS           = 10;
let EFI_MMIO               = 11;
let EFI_MMIO_PORT_SPACE    = 12;
let EFI_PAL_CODE           = 13;
let EFI_PERSISTENT         = 14;

// Check if we booted via UEFI by looking for magic at boot info address
fn uefi_is_boot() {
    let mut match_ok = 1;
    let mut i = 0;
    while i < 8 {
        if mem_read_u8(UEFI_BOOT_INFO_ADDR + i) != UEFI_MAGIC[i] {
            match_ok = 0;
            i = 8;
        }
        i = i + 1;
    }
    return match_ok;
}

// Read UEFI boot info fields
fn uefi_get_memory_map_addr() {
    return mem_read_u64(UEFI_BOOT_INFO_ADDR + 8);
}

fn uefi_get_memory_map_entries() {
    return mem_read_u64(UEFI_BOOT_INFO_ADDR + 16);
}

fn uefi_get_memory_map_desc_size() {
    return mem_read_u64(UEFI_BOOT_INFO_ADDR + 24);
}

fn uefi_get_framebuffer() {
    let addr = mem_read_u64(UEFI_BOOT_INFO_ADDR + 32);
    let width = mem_read_u32(UEFI_BOOT_INFO_ADDR + 40);
    let height = mem_read_u32(UEFI_BOOT_INFO_ADDR + 44);
    let pitch = mem_read_u32(UEFI_BOOT_INFO_ADDR + 48);
    let bpp = mem_read_u32(UEFI_BOOT_INFO_ADDR + 52);
    return [addr, width, height, pitch, bpp];
}

fn uefi_get_rsdp() {
    return mem_read_u64(UEFI_BOOT_INFO_ADDR + 56);
}

// Convert EFI memory map to kernel's usable-RAM list
// Each EFI descriptor (desc_size bytes):
//   +0:  Type (4)
//   +8:  PhysicalStart (8)
//   +16: VirtualStart (8)
//   +24: NumberOfPages (8)
//   +32: Attribute (8)
fn uefi_parse_memory_map() {
    let map_addr = uefi_get_memory_map_addr();
    let entries = uefi_get_memory_map_entries();
    let desc_size = uefi_get_memory_map_desc_size();
    let mut total_pages = 0;
    let mut usable_pages = 0;
    let mut i = 0;
    while i < entries {
        let desc = map_addr + i * desc_size;
        let mtype = mem_read_u32(desc);
        let phys_start = mem_read_u64(desc + 8);
        let num_pages = mem_read_u64(desc + 24);
        total_pages = total_pages + num_pages;
        // Usable types: LOADER_CODE, LOADER_DATA, BOOT_SERVICES_*, CONVENTIONAL
        if mtype == EFI_LOADER_CODE || mtype == EFI_LOADER_DATA {
            usable_pages = usable_pages + num_pages;
        }
        if mtype == EFI_BOOT_SERVICES_CODE || mtype == EFI_BOOT_SERVICES_DATA {
            usable_pages = usable_pages + num_pages;
        }
        if mtype == EFI_CONVENTIONAL {
            usable_pages = usable_pages + num_pages;
        }
        i = i + 1;
    }
    print("UEFI memory: " + to_string(total_pages) + " total pages, " + to_string(usable_pages) + " usable (" + to_string(usable_pages * 4 / 1024) + " MB)");
    return usable_pages;
}

// Feed EFI memory map into kernel page allocator
fn uefi_init_page_alloc() {
    let map_addr = uefi_get_memory_map_addr();
    let entries = uefi_get_memory_map_entries();
    let desc_size = uefi_get_memory_map_desc_size();
    let mut i = 0;
    while i < entries {
        let desc = map_addr + i * desc_size;
        let mtype = mem_read_u32(desc);
        let phys_start = mem_read_u64(desc + 8);
        let num_pages = mem_read_u64(desc + 24);
        // Mark usable regions as free
        if mtype == EFI_CONVENTIONAL || mtype == EFI_BOOT_SERVICES_CODE || mtype == EFI_BOOT_SERVICES_DATA {
            // Don't free pages below 2MB (kernel + page tables)
            let mut pg = 0;
            while pg < num_pages {
                let addr = phys_start + pg * 4096;
                if addr >= 2097152 {  // 0x200000
                    page_free(addr);
                }
                pg = pg + 1;
            }
        }
        i = i + 1;
    }
    return 0;
}

// Initialize framebuffer from UEFI GOP info
fn uefi_init_framebuffer() {
    let fb = uefi_get_framebuffer();
    let fb_addr = fb[0];
    let width = fb[1];
    let height = fb[2];
    let pitch = fb[3];
    let bpp = fb[4];
    if fb_addr != 0 && width > 0 {
        // Configure VESA module with UEFI-provided framebuffer
        vesa_set_mode_direct(fb_addr, width, height, pitch, bpp);
        print("UEFI GOP: " + to_string(width) + "x" + to_string(height) + " " + to_string(bpp) + "bpp");
    }
    return 0;
}

// Full UEFI boot initialization (replaces E820 + VESA BIOS calls)
fn uefi_boot_init() {
    if uefi_is_boot() == 0 {
        return 0;  // not UEFI boot, use legacy path
    }
    print("UEFI boot detected.");

    // Parse memory map -> page allocator
    uefi_parse_memory_map();
    uefi_init_page_alloc();

    // Setup framebuffer from GOP
    uefi_init_framebuffer();

    // Get ACPI RSDP from EFI config table (replaces BIOS memory search)
    let rsdp = uefi_get_rsdp();
    if rsdp != 0 {
        print("UEFI RSDP at: 0x" + format_hex(rsdp, 16));
    }

    return 1;
}

// === PE32+ Header Generation ===
// Describes the minimal PE32+ header needed for BOOTX64.EFI
// The image_builder would emit this when building a UEFI image.

let PE_SIGNATURE = [80, 69, 0, 0];  // "PE\0\0"

// Minimal COFF header (20 bytes)
//   Machine = 0x8664 (AMD64)
//   NumberOfSections = 1 (.text)
//   SizeOfOptionalHeader = 240 (PE32+)
//   Characteristics = 0x2022 (EXECUTABLE | LARGE_ADDRESS_AWARE | DLL)
let PE_MACHINE_AMD64 = 34404;     // 0x8664
let PE_SUBSYSTEM_EFI_APP = 10;    // EFI Application

fn pe_build_dos_stub() {
    // Minimal DOS stub: "MZ" header + PE offset at +0x3C
    let mut stub = [];
    // e_magic = "MZ"
    push(stub, 77); push(stub, 90);  // "MZ"
    // Pad to offset 0x3C
    let mut i = 2;
    while i < 60 { push(stub, 0); i = i + 1; }
    // e_lfanew at offset 0x3C = PE header offset (set to 64 = 0x40)
    push(stub, 64); push(stub, 0); push(stub, 0); push(stub, 0);
    return stub;
}

fn pe_build_header(code_size, entry_rva) {
    let mut hdr = [];
    // PE signature
    let mut i = 0;
    while i < 4 { push(hdr, PE_SIGNATURE[i]); i = i + 1; }

    // COFF header (20 bytes)
    push(hdr, PE_MACHINE_AMD64 % 256); push(hdr, (PE_MACHINE_AMD64 / 256) % 256);
    push(hdr, 1); push(hdr, 0);   // NumberOfSections = 1
    push(hdr, 0); push(hdr, 0); push(hdr, 0); push(hdr, 0);  // TimeDateStamp
    push(hdr, 0); push(hdr, 0); push(hdr, 0); push(hdr, 0);  // PointerToSymbolTable
    push(hdr, 0); push(hdr, 0); push(hdr, 0); push(hdr, 0);  // NumberOfSymbols
    push(hdr, 240); push(hdr, 0);  // SizeOfOptionalHeader = 240 (PE32+)
    // Characteristics: EXECUTABLE_IMAGE | LARGE_ADDRESS_AWARE
    push(hdr, 34); push(hdr, 32);  // 0x2022

    // Optional header (PE32+ = magic 0x020B)
    push(hdr, 11); push(hdr, 2);   // Magic = PE32+
    push(hdr, 1); push(hdr, 0);    // Linker version
    // SizeOfCode
    push(hdr, code_size % 256); push(hdr, (code_size / 256) % 256);
    push(hdr, (code_size / 65536) % 256); push(hdr, (code_size / 16777216) % 256);
    // SizeOfInitializedData
    push(hdr, 0); push(hdr, 0); push(hdr, 0); push(hdr, 0);
    // SizeOfUninitializedData
    push(hdr, 0); push(hdr, 0); push(hdr, 0); push(hdr, 0);
    // AddressOfEntryPoint
    push(hdr, entry_rva % 256); push(hdr, (entry_rva / 256) % 256);
    push(hdr, (entry_rva / 65536) % 256); push(hdr, (entry_rva / 16777216) % 256);
    // BaseOfCode
    push(hdr, 0); push(hdr, 16); push(hdr, 0); push(hdr, 0);  // 0x1000
    // ImageBase (8 bytes for PE32+)
    push(hdr, 0); push(hdr, 0); push(hdr, 16); push(hdr, 0);  // 0x00100000
    push(hdr, 0); push(hdr, 0); push(hdr, 0); push(hdr, 0);
    // SectionAlignment
    push(hdr, 0); push(hdr, 16); push(hdr, 0); push(hdr, 0);  // 0x1000
    // FileAlignment
    push(hdr, 0); push(hdr, 2); push(hdr, 0); push(hdr, 0);   // 0x200
    // OS version, Image version, Subsystem version (fill zeros + subsystem)
    i = 0;
    while i < 16 { push(hdr, 0); i = i + 1; }
    // SizeOfImage (aligned)
    let image_size = 8192 + code_size;
    push(hdr, image_size % 256); push(hdr, (image_size / 256) % 256);
    push(hdr, (image_size / 65536) % 256); push(hdr, (image_size / 16777216) % 256);
    // SizeOfHeaders
    push(hdr, 0); push(hdr, 2); push(hdr, 0); push(hdr, 0);   // 0x200
    // Checksum
    push(hdr, 0); push(hdr, 0); push(hdr, 0); push(hdr, 0);
    // Subsystem = EFI Application
    push(hdr, PE_SUBSYSTEM_EFI_APP); push(hdr, 0);
    // DllCharacteristics
    push(hdr, 0); push(hdr, 0);

    return hdr;
}

print("uefi_boot.hl loaded");
print("UEFI: boot info at 0x100000, PE32+ header gen, EFI memory map parser");
