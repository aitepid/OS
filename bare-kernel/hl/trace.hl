// trace.hl -- Kernel Tracing / Profiling (ftrace equivalent)
//
// Records kernel events in a ring buffer for debugging and performance analysis.
// Linux equivalents: ftrace, tracepoints, perf_events
//
// Event types:
//   TRACE_SCHED    = 1  (task switch, wake, sleep)
//   TRACE_SYSCALL  = 2  (syscall entry/exit)
//   TRACE_IRQ      = 3  (interrupt entry/exit)
//   TRACE_ALLOC    = 4  (page alloc/free, kmalloc/kfree)
//   TRACE_NET      = 5  (packet send/receive)
//   TRACE_DISK     = 6  (block read/write)
//   TRACE_FS       = 7  (VFS open/read/write/close)
//   TRACE_USER     = 8  (user-defined marker)
//
// Each event: [timestamp, type, arg0, arg1, arg2]
// Ring buffer: fixed size, overwrites oldest when full.

let TRACE_SCHED = 1;
let TRACE_SYSCALL = 2;
let TRACE_IRQ = 3;
let TRACE_ALLOC = 4;
let TRACE_NET = 5;
let TRACE_DISK = 6;
let TRACE_FS = 7;
let TRACE_USER = 8;

let TRACE_BUF_SIZE = 256;
let mut trace_enabled = 0;
let mut trace_mask = 255;  // all events enabled by default
let mut trace_write = 0;
let mut trace_count = 0;

let trace_ts = [];
let trace_type = [];
let trace_arg0 = [];
let trace_arg1 = [];
let trace_arg2 = [];

fn trace_init() {
    let mut i = 0;
    while i < TRACE_BUF_SIZE {
        push(trace_ts, 0);
        push(trace_type, 0);
        push(trace_arg0, 0);
        push(trace_arg1, 0);
        push(trace_arg2, 0);
        i = i + 1;
    }
    trace_enabled = 0;
    trace_write = 0;
    trace_count = 0;
    return 0;
}

fn trace_enable() {
    trace_enabled = 1;
    return 0;
}

fn trace_disable() {
    trace_enabled = 0;
    return 0;
}

fn trace_set_mask(mask) {
    trace_mask = mask;
    return 0;
}

fn trace_emit(etype, a0, a1, a2) {
    if trace_enabled == 0 { return 0; }
    if (trace_mask & (1 << (etype - 1))) == 0 { return 0; }

    let idx = trace_write;
    // trace_ts[idx] = get_ticks();  // hardware timestamp
    trace_ts[idx] = trace_count;
    trace_type[idx] = etype;
    trace_arg0[idx] = a0;
    trace_arg1[idx] = a1;
    trace_arg2[idx] = a2;

    trace_write = (trace_write + 1) % TRACE_BUF_SIZE;
    trace_count = trace_count + 1;
    return 0;
}

// Convenience wrappers
fn trace_sched_switch(from_task, to_task) {
    return trace_emit(TRACE_SCHED, from_task, to_task, 0);
}

fn trace_syscall_enter(nr, arg0) {
    return trace_emit(TRACE_SYSCALL, nr, arg0, 1);
}

fn trace_syscall_exit(nr, ret) {
    return trace_emit(TRACE_SYSCALL, nr, ret, 0);
}

fn trace_irq(vector) {
    return trace_emit(TRACE_IRQ, vector, 0, 0);
}

fn trace_alloc(addr, pages) {
    return trace_emit(TRACE_ALLOC, addr, pages, 1);
}

fn trace_free(addr, pages) {
    return trace_emit(TRACE_ALLOC, addr, pages, 0);
}

fn trace_net_tx(bytes) {
    return trace_emit(TRACE_NET, bytes, 0, 1);
}

fn trace_net_rx(bytes) {
    return trace_emit(TRACE_NET, bytes, 0, 0);
}

fn trace_marker(msg_id) {
    return trace_emit(TRACE_USER, msg_id, 0, 0);
}

// Dump recent events
fn trace_dump(max_events) {
    let start = 0;
    let count = trace_count;
    if count > TRACE_BUF_SIZE { count = TRACE_BUF_SIZE; }
    if count > max_events { count = max_events; }

    if trace_count > TRACE_BUF_SIZE {
        start = trace_write; // oldest unoverwritten
    }

    let mut dumped = 0;
    let mut i = 0;
    while i < count {
        let idx = (start + i) % TRACE_BUF_SIZE;
        let t = trace_type[idx];
        let tname = "??";
        if t == TRACE_SCHED { tname = "SCHED"; }
        if t == TRACE_SYSCALL { tname = "SYSCALL"; }
        if t == TRACE_IRQ { tname = "IRQ"; }
        if t == TRACE_ALLOC { tname = "ALLOC"; }
        if t == TRACE_NET { tname = "NET"; }
        if t == TRACE_DISK { tname = "DISK"; }
        if t == TRACE_FS { tname = "FS"; }
        if t == TRACE_USER { tname = "USER"; }
        // serial_print(to_string(trace_ts[idx]) + " " + tname + " " +
        //              to_string(trace_arg0[idx]) + " " + to_string(trace_arg1[idx]));
        dumped = dumped + 1;
        i = i + 1;
    }
    return dumped;
}

fn trace_clear() {
    trace_write = 0;
    trace_count = 0;
    return 0;
}

fn trace_status() {
    let status = "tracing: ";
    if trace_enabled == 1 { status = status + "ON"; }
    else { status = status + "OFF"; }
    status = status + ", " + to_string(trace_count) + " events";
    if trace_count > TRACE_BUF_SIZE {
        status = status + " (" + to_string(TRACE_BUF_SIZE) + " buffered)";
    }
    return status;
}

print("trace.hl loaded");
print("Kernel tracing: " + to_string(TRACE_BUF_SIZE) + " events, 8 categories, ring buffer");
