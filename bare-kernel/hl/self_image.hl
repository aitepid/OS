// self_image.hl -- Kernel Self-Image Awareness
//
// The running HicOS kernel knows its own binary image layout in memory.
// This enables self-installation: the kernel can write itself to a target disk.
//
// Memory layout (set by Stage2 loader):
//   0x100000 (1MB):  Start of kernel code (loaded by Stage2 from disk)
//   Kernel occupies contiguous sectors from LBA 0 of the boot device
//
// Boot image layout:
//   Sector 0:     Stage1 (MBR, 512 bytes)
//   Sector 1..N:  Stage2 (real→long mode transition)
//   Sector N+1..: Kernel payload (native x86_64 code)
//
// The total boot image (hicos-hl.img) is loaded starting at sector 0.
// To self-install, we copy the entire image from memory to a target disk.
//
// Image source addresses (populated during boot):
//   0x300930: image start in memory (set to 0x7C00 for MBR or 0x100000 for kernel)
//   0x300938: image total bytes (set during boot from manifest)
//   0x300940: image total sectors
//
// Iteration 122: self-install kernel image awareness

let SELF_IMG_ADDR = 3148080;    // 0x300930: image memory base
let SELF_IMG_BYTES = 3148088;   // 0x300938: image byte count
let SELF_IMG_SECTORS = 3148096; // 0x300940: image sector count
let SELF_STAGE1_ADDR = 31744;   // 0x7C00: stage1/MBR in low memory
let SELF_STAGE2_ADDR = 32768;   // 0x8000: stage2 in low memory
let SELF_KERNEL_ADDR = 1048576; // 0x100000: native kernel payload

// The boot image is loaded starting at physical address 0x7C00 (MBR).
// However, the MBR + Stage2 occupy low memory and the kernel starts at 0x100000.
// For self-install, we need to re-read the image from the boot disk
// (since low memory may have been overwritten), OR we use the kernel's
// knowledge of the image structure to reconstruct it.

// Initialize self-image metadata from known constants
fn self_image_init() {
    // Default values matching hicos-hl.img manifest
    // These are overwritten at boot time by the native kernel
    mem_write_u64(SELF_IMG_ADDR, 1048576);      // 0x100000 (kernel load address)
    mem_write_u64(SELF_IMG_BYTES, 162816);       // total image bytes
    mem_write_u64(SELF_IMG_SECTORS, 318);        // total image sectors
    return 0;
}

// Get total image sectors
fn self_image_sectors() {
    return mem_read_u64(SELF_IMG_SECTORS);
}

// Get total image bytes
fn self_image_bytes() {
    return mem_read_u64(SELF_IMG_BYTES);
}

// Get kernel load address
fn self_image_base() {
    return mem_read_u64(SELF_IMG_ADDR);
}

fn self_image_kernel_bytes() {
    let mut total = self_image_bytes();
    if total <= 1024 {
        return 0;
    }
    return total - 1024;
}

// Reconstruct one sector of the currently running boot image from memory.
// LBA 0: stage1/MBR @ 0x7C00
// LBA 1: stage2     @ 0x8000
// LBA 2+: kernel    @ 0x100000
fn self_image_read_sector(lba, buf_addr) {
    mem_zero(buf_addr, 512);

    if lba >= self_image_sectors() {
        return 0;
    }

    let mut i = 0;
    if lba == 0 {
        while i < 512 {
            mem_write_u8(buf_addr + i, mem_read_u8(SELF_STAGE1_ADDR + i));
            i = i + 1;
        }
        return 1;
    }

    if lba == 1 {
        while i < 512 {
            mem_write_u8(buf_addr + i, mem_read_u8(SELF_STAGE2_ADDR + i));
            i = i + 1;
        }
        return 1;
    }

    let kernel_bytes = self_image_kernel_bytes();
    let kernel_off = (lba - 2) * 512;
    if kernel_off >= kernel_bytes {
        return 1;
    }

    while i < 512 {
        let src_off = kernel_off + i;
        if src_off < kernel_bytes {
            mem_write_u8(buf_addr + i, mem_read_u8(SELF_KERNEL_ADDR + src_off));
        }
        i = i + 1;
    }
    return 1;
}

// Write the running kernel image to a target disk using the installer's disk backend.
// This reads the boot disk sector-by-sector and writes to the target.
// src_backend: source disk backend (where we booted from)
// Returns number of sectors written, or 0 on failure.
fn self_install_to_disk() {
    let total_sectors = self_image_sectors();
    if total_sectors == 0 {
        print("self_install: no image metadata available");
        return 0;
    }

    if installer_disk_backend == 0 {
        print("self_install: no target disk backend selected");
        return 0;
    }

    print("Self-install: writing " + to_string(total_sectors) + " sectors to target disk...");

    let buf = page_alloc();
    let mut written = 0;
    let mut sec = 0;

    while sec < total_sectors {
        let ok = self_image_read_sector(sec, buf);
        if ok == 0 {
            print("self_install: reconstruct failed at sector " + to_string(sec));
            page_free(buf);
            return written;
        }
        let wok = installer_disk_write(sec, 1, buf);
        if wok == 0 {
            print("self_install: write failed at sector " + to_string(sec));
            page_free(buf);
            return written;
        }
        written = written + 1;
        sec = sec + 1;
        // Progress every 50 sectors
        if sec % 50 == 0 {
            print("  ... " + to_string(sec) + "/" + to_string(total_sectors) + " sectors");
        }
    }

    page_free(buf);
    print("Self-install complete: " + to_string(written) + " sectors written.");
    return written;
}

// Print self-image info
fn self_image_info() {
    let mut base = self_image_base();
    let bytes = self_image_bytes();
    let sectors = self_image_sectors();
    print("Self-image:");
    print("  Kernel base: 0x" + format_hex(base, 8));
    print("  Image size:  " + to_string(bytes) + " bytes (" + to_string(sectors) + " sectors)");
    print("  Layout: stage1@0x7C00 stage2@0x8000 kernel@0x100000");
    return 0;
}

print("self_image.hl loaded -- kernel self-image awareness");
