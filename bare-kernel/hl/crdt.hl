// crdt.hl -- Conflict-free Replicated Data Types
//
// Implements CRDTs for distributed systems (Shapiro et al. 2011):
//   - G-Counter  : grow-only counter, merge = max per node
//   - PN-Counter : positive-negative counter (increment + decrement)
//   - G-Set      : grow-only set, merge = union
//   - 2P-Set     : two-phase set (add-set + remove-set, no re-add)
//   - LWW-Element-Set: last-write-wins with logical timestamps
//   - OR-Set     : observed-remove set (unique tag per add operation)
// All merges are commutative, associative, idempotent (join = ⊔).
//
// Buffer: 0x13C0000

let CRDT_BUF = 0x13C0000;

// Cluster limits
let CRDT_MAX_NODES   = 16;   // max nodes in cluster
let CRDT_MAX_ELEMS   = 64;   // max elements per set
let CRDT_MAX_TAGS    = 128;  // max unique tags (OR-Set)

// Node identity
let crdt_node_id = 0;

// ─── G-Counter ──────────────────────────────────────────────────────────────
// Each node has its own increment counter; value = sum of all
let gc_counters    = [];   // CRDT_MAX_NODES values
let gc_node_count  = 0;

fn gc_init(node_id, n_nodes) {
    crdt_node_id  = node_id;
    gc_node_count = n_nodes;
    let mut i = 0;
    while i < n_nodes { set_at(gc_counters, i, 0); i = i + 1; }
    return 0;
}

fn gc_increment() {
    let mut v = gc_counters[crdt_node_id];
    set_at(gc_counters, crdt_node_id, v + 1);
    return 0;
}

fn gc_value() {
    let mut sum = 0;
    let mut i = 0;
    while i < gc_node_count { sum = sum + gc_counters[i]; i = i + 1; }
    return sum;
}

// Merge: take max per node (join = ⊔)
fn gc_merge(remote_counters) {
    let mut i = 0;
    while i < gc_node_count {
        if remote_counters[i] > gc_counters[i] {
            set_at(gc_counters, i, remote_counters[i]);
        }
        i = i + 1;
    }
    return 0;
}

fn gc_status() {
    return "G-Counter: value=" + to_string(gc_value())
        + " node[" + to_string(crdt_node_id) + "]=" + to_string(gc_counters[crdt_node_id]);
}

// ─── PN-Counter ─────────────────────────────────────────────────────────────
// Two G-Counters: P (increments) and N (decrements); value = sum(P) - sum(N)
let pn_pos = [];   // CRDT_MAX_NODES positive increments
let pn_neg = [];   // CRDT_MAX_NODES negative increments
let pn_node_count = 0;

fn pn_init(node_id, n_nodes) {
    crdt_node_id  = node_id;
    pn_node_count = n_nodes;
    let mut i = 0;
    while i < n_nodes {
        set_at(pn_pos, i, 0);
        set_at(pn_neg, i, 0);
        i = i + 1;
    }
    return 0;
}

fn pn_increment() { set_at(pn_pos, crdt_node_id, pn_pos[crdt_node_id] + 1); return 0; }
fn pn_decrement() { set_at(pn_neg, crdt_node_id, pn_neg[crdt_node_id] + 1); return 0; }

fn pn_value() {
    let pos_sum = 0; let neg_sum = 0;
    let mut i = 0;
    while i < pn_node_count {
        pos_sum = pos_sum + pn_pos[i];
        neg_sum = neg_sum + pn_neg[i];
        i = i + 1;
    }
    return pos_sum - neg_sum;
}

fn pn_merge(remote_pos, remote_neg) {
    let mut i = 0;
    while i < pn_node_count {
        if remote_pos[i] > pn_pos[i] { set_at(pn_pos, i, remote_pos[i]); }
        if remote_neg[i] > pn_neg[i] { set_at(pn_neg, i, remote_neg[i]); }
        i = i + 1;
    }
    return 0;
}

fn pn_status() {
    return "PN-Counter: value=" + to_string(pn_value())
        + " pos=" + to_string(pn_pos[crdt_node_id])
        + " neg=" + to_string(pn_neg[crdt_node_id]);
}

// ─── G-Set (Grow-only Set) ──────────────────────────────────────────────────
let gset_elems = [];   // integer elements
let gset_count = 0;

fn gset_init() { gset_count = 0; return 0; }

fn gset_add(elem) {
    // Idempotent: ignore if already present
    let mut i = 0;
    while i < gset_count {
        if gset_elems[i] == elem { return 0; }
        i = i + 1;
    }
    if gset_count >= CRDT_MAX_ELEMS { return 1; }
    set_at(gset_elems, gset_count, elem);
    gset_count = gset_count + 1;
    return 0;
}

fn gset_contains(elem) {
    let mut i = 0;
    while i < gset_count { if gset_elems[i] == elem { return 1; } i = i + 1; }
    return 0;
}

fn gset_merge(remote_elems, remote_count) {
    let mut i = 0;
    while i < remote_count { gset_add(remote_elems[i]); i = i + 1; }
    return 0;
}

fn gset_status() {
    return "G-Set: count=" + to_string(gset_count);
}

// ─── 2P-Set (Two-Phase Set) ─────────────────────────────────────────────────
// add-set ∪ remove-set; once removed, cannot re-add
let tpset_add_elems = [];
let tpset_add_count = 0;
let tpset_rem_elems = [];
let tpset_rem_count = 0;

fn tpset_init() { tpset_add_count = 0; tpset_rem_count = 0; return 0; }

fn _tpset_in_set(arr, n, elem) {
    let mut i = 0;
    while i < n { if arr[i] == elem { return 1; } i = i + 1; }
    return 0;
}

fn tpset_add(elem) {
    if _tpset_in_set(tpset_rem_elems, tpset_rem_count, elem) { return 1; }
    if _tpset_in_set(tpset_add_elems, tpset_add_count, elem) { return 0; }
    if tpset_add_count >= CRDT_MAX_ELEMS { return 1; }
    set_at(tpset_add_elems, tpset_add_count, elem);
    tpset_add_count = tpset_add_count + 1;
    return 0;
}

fn tpset_remove(elem) {
    if _tpset_in_set(tpset_add_elems, tpset_add_count, elem) == 0 { return 1; }
    if _tpset_in_set(tpset_rem_elems, tpset_rem_count, elem) { return 0; }
    if tpset_rem_count >= CRDT_MAX_ELEMS { return 1; }
    set_at(tpset_rem_elems, tpset_rem_count, elem);
    tpset_rem_count = tpset_rem_count + 1;
    return 0;
}

fn tpset_contains(elem) {
    return _tpset_in_set(tpset_add_elems, tpset_add_count, elem)
         - _tpset_in_set(tpset_rem_elems, tpset_rem_count, elem);
}

fn tpset_merge(ra, ra_n, rr, rr_n) {
    let mut i = 0;
    while i < ra_n { tpset_add(ra[i]); i = i + 1; }
    i = 0;
    while i < rr_n { tpset_remove(rr[i]); i = i + 1; }
    return 0;
}

fn tpset_status() {
    return "2P-Set: add=" + to_string(tpset_add_count)
        + " rem=" + to_string(tpset_rem_count);
}

// ─── LWW-Element-Set (Last-Write-Wins) ──────────────────────────────────────
// Each element has an add-timestamp and a remove-timestamp; present if add_ts > rem_ts
let lww_elems    = [];    // element keys
let lww_add_ts   = [];    // add timestamps (logical clock)
let lww_rem_ts   = [];    // remove timestamps
let lww_count    = 0;
let lww_clock    = 0;     // local logical clock

fn lww_init() { lww_count = 0; lww_clock = 0; return 0; }

fn _lww_find(elem) {
    let mut i = 0;
    while i < lww_count { if lww_elems[i] == elem { return i; } i = i + 1; }
    return 0 - 1;
}

fn lww_add(elem) {
    lww_clock = lww_clock + 1;
    let mut idx = _lww_find(elem);
    if idx < 0 {
        if lww_count >= CRDT_MAX_ELEMS { return 1; }
        idx = lww_count;
        set_at(lww_elems, idx, elem);
        set_at(lww_rem_ts, idx, 0);
        lww_count = lww_count + 1;
    }
    set_at(lww_add_ts, idx, lww_clock);
    return 0;
}

fn lww_remove(elem) {
    lww_clock = lww_clock + 1;
    let mut idx = _lww_find(elem);
    if idx < 0 { return 1; }
    set_at(lww_rem_ts, idx, lww_clock);
    return 0;
}

fn lww_contains(elem) {
    let mut idx = _lww_find(elem);
    if idx < 0 { return 0; }
    return lww_add_ts[idx] > lww_rem_ts[idx];
}

fn lww_merge(remote_elems, remote_add_ts, remote_rem_ts, remote_count) {
    let mut i = 0;
    while i < remote_count {
        let elem = remote_elems[i];
        let mut idx = _lww_find(elem);
        if idx < 0 {
            if lww_count < CRDT_MAX_ELEMS {
                idx = lww_count;
                set_at(lww_elems,  idx, elem);
                set_at(lww_add_ts, idx, 0);
                set_at(lww_rem_ts, idx, 0);
                lww_count = lww_count + 1;
            }
        }
        if idx >= 0 {
            if remote_add_ts[i] > lww_add_ts[idx] { set_at(lww_add_ts, idx, remote_add_ts[i]); }
            if remote_rem_ts[i] > lww_rem_ts[idx] { set_at(lww_rem_ts, idx, remote_rem_ts[i]); }
        }
        i = i + 1;
    }
    return 0;
}

fn lww_status() {
    let present = 0;
    let mut i = 0;
    while i < lww_count {
        if lww_add_ts[i] > lww_rem_ts[i] { present = present + 1; }
        i = i + 1;
    }
    return "LWW-Set: total=" + to_string(lww_count)
        + " present=" + to_string(present)
        + " clock=" + to_string(lww_clock);
}

// ─── OR-Set (Observed-Remove Set) ──────────────────────────────────────────
// Each add generates a unique tag; remove tombstones that specific tag
let orset_elems     = [];   // element values
let orset_tags      = [];   // unique add-tag per element
let orset_removed   = [];   // tombstoned tags (1 = removed)
let orset_count     = 0;
let orset_tag_seq   = 0;    // global tag sequence

fn orset_init() { orset_count = 0; orset_tag_seq = 0; return 0; }

fn orset_add(elem) {
    orset_tag_seq = orset_tag_seq + 1;
    if orset_count >= CRDT_MAX_TAGS { return 1; }
    set_at(orset_elems,   orset_count, elem);
    set_at(orset_tags,    orset_count, crdt_node_id * 10000 + orset_tag_seq);
    set_at(orset_removed, orset_count, 0);
    orset_count = orset_count + 1;
    return 0;
}

fn orset_remove(elem) {
    // Tombstone all current (non-removed) entries for this element
    let mut i = 0;
    while i < orset_count {
        if orset_elems[i] == elem {
            if orset_removed[i] == 0 { set_at(orset_removed, i, 1); }
        }
        i = i + 1;
    }
    return 0;
}

fn orset_contains(elem) {
    let mut i = 0;
    while i < orset_count {
        if orset_elems[i] == elem {
            if orset_removed[i] == 0 { return 1; }
        }
        i = i + 1;
    }
    return 0;
}

fn orset_status() {
    let active = 0;
    let mut i = 0;
    while i < orset_count { if orset_removed[i] == 0 { active = active + 1; } i = i + 1; }
    return "OR-Set: entries=" + to_string(orset_count)
        + " active=" + to_string(active)
        + " tombstones=" + to_string(orset_count - active);
}

// ─── Unified CRDT info ──────────────────────────────────────────────────────
fn crdt_init_all() {
    crdt_node_id = 0;
    gc_init(0, CRDT_MAX_NODES);
    pn_init(0, CRDT_MAX_NODES);
    gset_init();
    tpset_init();
    lww_init();
    orset_init();
    return 0;
}

fn crdt_info() {
    return "crdt[node=" + to_string(crdt_node_id) + "]: "
        + gc_status() + " | " + pn_status() + " | " + gset_status()
        + " | " + tpset_status() + " | " + lww_status() + " | " + orset_status();
}

fn crdt_test() {
    crdt_node_id = 1;
    // G-Counter: 3-node cluster
    gc_init(1, 3);
    gc_increment(); gc_increment(); gc_increment();  // node 1 adds 3
    let remote_gc = [5, 0, 2];  // node 0: 5, node 2: 2
    gc_merge(remote_gc);
    let gc_val = gc_value();  // should be 3+5+2=10

    // PN-Counter
    pn_init(1, 3);
    pn_increment(); pn_increment(); pn_increment(); pn_increment();
    pn_decrement();
    let pn_val = pn_value();  // 4-1=3

    // G-Set
    gset_init();
    gset_add(10); gset_add(20); gset_add(30); gset_add(20);
    let gs_has20 = gset_contains(20);
    let gs_has99 = gset_contains(99);

    // 2P-Set
    tpset_init();
    tpset_add(100); tpset_add(200); tpset_add(300);
    tpset_remove(200);
    let tp_has200 = tpset_contains(200);
    let tp_has300 = tpset_contains(300);

    // LWW-Set
    lww_init();
    lww_add(42); lww_add(84); lww_add(126);
    lww_remove(84);
    let lww_has84  = lww_contains(84);
    let lww_has42  = lww_contains(42);

    // OR-Set: add, remove, re-add (unlike 2P-Set, re-add works)
    orset_init();
    orset_add(7); orset_add(8); orset_add(9);
    orset_remove(8);
    orset_add(8);  // re-add after remove -- should be present
    let or_has8 = orset_contains(8);

    print("crdt test: " + gc_status());
    print("crdt test: " + pn_status());
    print("crdt test: " + lww_status());
    print("crdt test: " + orset_status());
    return "crdt: G-Counter=" + to_string(gc_val)
        + " PN-Counter=" + to_string(pn_val)
        + " G-Set(20)=" + to_string(gs_has20)
        + " 2P-Set(200_removed)=" + to_string(tp_has200)
        + " LWW(84_removed)=" + to_string(lww_has84)
        + " OR-Set(8_readd)=" + to_string(or_has8)
        + " [Shapiro et al. 2011 ok]";
}

print("crdt.hl loaded -- CRDTs: G-Counter, PN-Counter, G-Set, 2P-Set, LWW-Set, OR-Set");
