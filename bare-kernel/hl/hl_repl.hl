// hl_repl.hl -- H-L REPL Interactive Environment
// Iteration 433 | Buffer: 0x1E80000
//
// Provides interactive Read-Eval-Print Loop for H-L expressions.
// Features:
// - Command-based expression evaluation (arithmetic + variable storage)
// - Command history (up to REPL_MAX_HISTORY entries)
// - Variable scoped storage (REPL_MAX_VARS variables)
//
// Evaluation model (integer-encoded commands):
//   Set repl_cmd + repl_arg0 + repl_arg1 + repl_var_id, then call repl_exec_line.
//   REPL_CMD_LITERAL = 0 : result = repl_arg0
//   REPL_CMD_ADD     = 1 : result = repl_arg0 + repl_arg1
//   REPL_CMD_SUB     = 2 : result = repl_arg0 - repl_arg1
//   REPL_CMD_MUL     = 3 : result = repl_arg0 * repl_arg1
//   REPL_CMD_DIV     = 4 : result = repl_arg0 / repl_arg1
//   REPL_CMD_NEG     = 5 : result = 0 - repl_arg0
//   REPL_CMD_LET     = 6 : store repl_arg0 in var repl_var_id; result = repl_arg0
//   REPL_CMD_GET     = 7 : result = get_var(repl_var_id)
//
// Testing: hl_repl_test() => validates eval dispatch, var storage, history

let REPL_MAX_HISTORY = 32;
let REPL_MAX_VARS    = 16;
let REPL_INPUT_SIZE  = 128;

let mut REPL_CMD_LITERAL = 0;
let mut REPL_CMD_ADD     = 1;
let mut REPL_CMD_SUB     = 2;
let mut REPL_CMD_MUL     = 3;
let mut REPL_CMD_DIV     = 4;
let mut REPL_CMD_NEG     = 5;
let mut REPL_CMD_LET     = 6;
let mut REPL_CMD_GET     = 7;

let repl_history       = array(REPL_MAX_HISTORY, 0);
let mut repl_history_count = 0;
let repl_vars          = array(REPL_MAX_VARS, 0);
let repl_var_names     = array(REPL_MAX_VARS, 0);
let mut repl_var_count     = 0;
let mut repl_session_lines = 0;

// Current evaluation context (caller sets before repl_exec_line)
let mut repl_cmd    = 0;
let mut repl_arg0   = 0;
let mut repl_arg1   = 0;
let mut repl_var_id = 0;

fn repl_find_var(name) {
    let mut i = 0;
    while i < repl_var_count {
        if repl_var_names[i] == name {
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

fn repl_set_var(name, value) {
    let mut idx = repl_find_var(name);
    if idx >= 0 {
        set_at(repl_vars, idx, value);
        return idx;
    }
    if repl_var_count >= REPL_MAX_VARS {
        return 0 - 1;
    }
    set_at(repl_var_names, repl_var_count, name);
    set_at(repl_vars, repl_var_count, value);
    let mut old_count = repl_var_count;
    repl_var_count = repl_var_count + 1;
    return old_count;
}

fn repl_get_var(name) {
    let mut idx = repl_find_var(name);
    if idx >= 0 {
        return repl_vars[idx];
    }
    return 0;
}

// Prepare evaluation context before calling repl_exec_line or repl_eval_simple.
fn repl_prepare(cmd, a0, a1) {
    repl_cmd  = cmd;
    repl_arg0 = a0;
    repl_arg1 = a1;
}

// Set the variable ID for LET / GET commands.
fn repl_set_varid(vid) {
    repl_var_id = vid;
}

// Evaluate the current command context.  `line_id` is recorded in history.
fn repl_eval_simple(line_id) {
    if repl_cmd == REPL_CMD_LITERAL {
        return repl_arg0;
    }
    if repl_cmd == REPL_CMD_ADD {
        return repl_arg0 + repl_arg1;
    }
    if repl_cmd == REPL_CMD_SUB {
        return repl_arg0 - repl_arg1;
    }
    if repl_cmd == REPL_CMD_MUL {
        return repl_arg0 * repl_arg1;
    }
    if repl_cmd == REPL_CMD_DIV {
        if repl_arg1 == 0 {
            return 0 - 1;
        }
        return repl_arg0 / repl_arg1;
    }
    if repl_cmd == REPL_CMD_NEG {
        return 0 - repl_arg0;
    }
    if repl_cmd == REPL_CMD_LET {
        repl_set_var(repl_var_id, repl_arg0);
        return repl_arg0;
    }
    if repl_cmd == REPL_CMD_GET {
        return repl_get_var(repl_var_id);
    }
    return 0 - 1;
}

fn repl_add_history(input, result) {
    if repl_history_count >= REPL_MAX_HISTORY {
        return 0 - 1;
    }
    set_at(repl_history, repl_history_count, input);
    let mut old_count = repl_history_count;
    repl_history_count = repl_history_count + 1;
    repl_session_lines = repl_session_lines + 1;
    return old_count;
}

fn repl_exec_line(line_id) {
    let mut result = repl_eval_simple(line_id);
    repl_add_history(line_id, result);
    return result;
}

fn repl_clear_history() {
    repl_history_count = 0;
    repl_session_lines = 0;
    return 1;
}

fn repl_get_history_count() {
    return repl_history_count;
}

fn repl_get_session_lines() {
    return repl_session_lines;
}

fn repl_init() {
    repl_var_count     = 0;
    repl_history_count = 0;
    repl_session_lines = 0;
    repl_cmd           = REPL_CMD_LITERAL;
    repl_arg0          = 0;
    repl_arg1          = 0;
    repl_var_id        = 0;
}

fn hl_repl_test() {
    repl_init();
    let mut pass = 1;

    // REPL_CMD_LITERAL: return arg0 unchanged
    repl_prepare(REPL_CMD_LITERAL, 42, 0);
    let mut lit_result = repl_exec_line(0);
    if lit_result != 42 {
        pass = 0;
    }

    // REPL_CMD_ADD: 15 + 25 = 40
    repl_prepare(REPL_CMD_ADD, 15, 25);
    let mut add_result = repl_exec_line(1);
    if add_result != 40 {
        pass = 0;
    }

    // REPL_CMD_SUB: 100 - 37 = 63
    repl_prepare(REPL_CMD_SUB, 100, 37);
    let mut sub_result = repl_exec_line(2);
    if sub_result != 63 {
        pass = 0;
    }

    // REPL_CMD_MUL: 6 * 7 = 42
    repl_prepare(REPL_CMD_MUL, 6, 7);
    let mut mul_result = repl_exec_line(3);
    if mul_result != 42 {
        pass = 0;
    }

    // REPL_CMD_DIV: 100 / 4 = 25
    repl_prepare(REPL_CMD_DIV, 100, 4);
    let mut div_result = repl_exec_line(4);
    if div_result != 25 {
        pass = 0;
    }

    // REPL_CMD_NEG: -(10) = -10
    repl_prepare(REPL_CMD_NEG, 10, 0);
    let mut neg_result = repl_exec_line(5);
    if neg_result != 0 - 10 {
        pass = 0;
    }

    // REPL_CMD_LET / REPL_CMD_GET: store 999 in var 42, then retrieve it
    repl_prepare(REPL_CMD_LET, 999, 0);
    repl_set_varid(42);
    repl_exec_line(6);
    repl_prepare(REPL_CMD_GET, 0, 0);
    repl_set_varid(42);
    let mut get_result = repl_exec_line(7);
    if get_result != 999 {
        pass = 0;
    }

    // Direct repl_set_var / repl_get_var still work
    repl_set_var(77, 1234);
    let mut direct_val = repl_get_var(77);
    if direct_val != 1234 {
        pass = 0;
    }

    // History should have 8 entries (one per repl_exec_line call above)
    let mut hist_cnt = repl_get_history_count();
    if hist_cnt != 8 {
        pass = 0;
    }

    // session_lines equals history count
    let mut sess_lines = repl_get_session_lines();
    if sess_lines != 8 {
        pass = 0;
    }

    // Clear history
    repl_clear_history();
    let mut cleared_cnt = repl_get_history_count();
    if cleared_cnt != 0 {
        pass = 0;
    }

    if pass == 1 {
        print("hl_repl_test PASS");
    }
    if pass == 0 {
        print("hl_repl_test FAIL");
    }
    return pass;
}

hl_repl_test();
print("hl_repl.hl loaded");
