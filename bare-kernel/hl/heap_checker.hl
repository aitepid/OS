// heap_checker.hl -- Heap Bounds Checker / AddressSanitizer-lite (Phase 6: 系统稳定化, iter 411)
// Buffer: 0x1D20000
// Tracks up to HC_MAX_ALLOCS=16 allocations with redzone sentinels
// HC_MAGIC=57005 (0xDEAD); stored in hc_pre_rz[]/hc_post_rz[] around each allocation
// hc_check(id): 0=clean, 1=violation  hc_check_all(): count all corrupted redzones

let HC_MAX_ALLOCS = 16;
let HC_MAGIC      = 57005;   // 0xDEAD

let hc_buf_base  = array(16, 0);   // simulated base address
let hc_buf_size  = array(16, 0);   // allocation size
let hc_pre_rz    = array(16, 0);   // pre-redzone sentinel
let hc_post_rz   = array(16, 0);   // post-redzone sentinel
let hc_active    = array(16, 0);   // 1=tracked
let hc_n_allocs  = 0;
let hc_violations = 0;

fn hc_init() {
    let mut i = 0;
    while i < HC_MAX_ALLOCS {
        set_at(hc_buf_base, i, 0);
        set_at(hc_buf_size, i, 0);
        set_at(hc_pre_rz,   i, 0);
        set_at(hc_post_rz,  i, 0);
        set_at(hc_active,   i, 0);
        i += 1;
    }
    hc_n_allocs   = 0;
    hc_violations = 0;
    return 0;
}

fn hc_track(base, size) {
    let id = hc_n_allocs;
    set_at(hc_buf_base, id, base);
    set_at(hc_buf_size, id, size);
    set_at(hc_pre_rz,   id, HC_MAGIC);
    set_at(hc_post_rz,  id, HC_MAGIC);
    set_at(hc_active,   id, 1);
    hc_n_allocs += 1;
    return id;
}

fn hc_untrack(alloc_id) {
    set_at(hc_active, alloc_id, 0);
    return 0;
}

fn hc_corrupt(alloc_id, side) {
    // side=0: corrupt pre-redzone; side=1: corrupt post-redzone (simulate overflow)
    if side == 0 { set_at(hc_pre_rz,  alloc_id, 0); }
    if side == 1 { set_at(hc_post_rz, alloc_id, 0); }
    return 0;
}

fn hc_check(alloc_id) {
    if hc_active[alloc_id] == 0 { return 0; }
    if hc_pre_rz[alloc_id]  != HC_MAGIC { return 1; }
    if hc_post_rz[alloc_id] != HC_MAGIC { return 1; }
    return 0;
}

fn hc_check_all() {
    let viol = 0;
    let mut i = 0;
    while i < hc_n_allocs {
        if hc_check(i) == 1 { viol += 1; }
        i += 1;
    }
    hc_violations = viol;
    return viol;
}

fn hc_get_violations() { return hc_violations; }
fn hc_get_n_allocs()   { return hc_n_allocs; }

fn hc_test() {
    hc_init();

    // Track two allocations
    hc_track(4096, 64);    // id=0
    hc_track(8192, 128);   // id=1

    // Both redzones intact → no violations
    let v0a = hc_check(0);   // 0
    let v1a = hc_check(1);   // 0

    // Corrupt post-redzone of alloc 0 (simulate buffer overflow)
    hc_corrupt(0, 1);

    let v0b = hc_check(0);    // 1 (violation detected)
    let v1b = hc_check(1);    // 0 (still clean)
    let cnt = hc_check_all(); // 1

    print("hc_test: v0a=" + to_string(v0a)
          + " v1a=" + to_string(v1a)
          + " v0b=" + to_string(v0b)
          + " v1b=" + to_string(v1b)
          + " cnt=" + to_string(cnt));

    if v0a == 0 {
        if v1a == 0 {
            if v0b == 1 {
                if v1b == 0 {
                    if cnt == 1 {
                        print("hc_test: PASS");
                        return 1;
                    }
                }
            }
        }
    }
    print("hc_test: FAIL");
    return 0;
}

print("heap_checker.hl loaded");
