// dns.hl -- DNS Resolver with TTL Hash Cache (RFC 1035)
//
// Iteration 87: added O(1) hash cache with TTL expiration.
//
// Design:
//   32-bucket hash table, separate chaining, 64 max entries
//   dns_resolve: check cache O(1) -> on miss send query -> cache result with TTL
//   Entries auto-expire after TTL ticks (based on DNS response TTL field)
//
// Public API (all signatures preserved + new):
//   dns_resolve / dns_build_query / dns_parse_response / dns_encode_name
//   dns_cache_status (new) / dns_cache_flush (new)

let DNS_PORT = 53;
let DNS_TYPE_A = 1;
let DNS_CLASS_IN = 1;
let DNS_CACHE_SIZE = 64;
let DNS_CACHE_BUCKETS = 32;
let DNS_DEFAULT_TTL = 30000;   // 300 seconds at 100Hz tick

let mut dns_id = 1;

// Cache parallel arrays
let mut _dns_c_valid = [];      // 1 = occupied
let mut _dns_c_hash = [];       // name hash (for fast compare)
let mut _dns_c_ip = [];         // [a, b, c, d]
let mut _dns_c_expire = [];     // tick at which entry expires
let mut _dns_c_ht = [];         // hash table buckets -> first slot (-1)
let mut _dns_c_next = [];       // chain next per slot (-1)
let mut _dns_c_count = 0;
let mut _dns_c_hits = 0;
let mut _dns_c_misses = 0;
let mut _dns_cache_ready = 0;

// ============================================================
// Hash + cache internals
// ============================================================

fn _dns_name_hash(parts) {
    let mut h = 5381;
    let mut i = 0;
    while i < len(parts) {
        let mut label = parts[i];
        let mut j = 0;
        while j < len(label) {
            h = h * 33 + label[j];
            j = j + 1;
        }
        i = i + 1;
    }
    if h < 0 { h = 0 - h; }
    return h;
}

fn _dns_cache_init() {
    _dns_c_valid = [];
    _dns_c_hash = [];
    _dns_c_ip = [];
    _dns_c_expire = [];
    _dns_c_next = [];
    let mut i = 0;
    while i < DNS_CACHE_SIZE {
        push(_dns_c_valid, 0);
        push(_dns_c_hash, 0);
        push(_dns_c_ip, [0, 0, 0, 0]);
        push(_dns_c_expire, 0);
        push(_dns_c_next, 0 - 1);
        i = i + 1;
    }
    _dns_c_ht = [];
    i = 0;
    while i < DNS_CACHE_BUCKETS {
        push(_dns_c_ht, 0 - 1);
        i = i + 1;
    }
    _dns_c_count = 0;
    _dns_c_hits = 0;
    _dns_c_misses = 0;
    _dns_cache_ready = 1;
    return 0;
}

fn _dns_now() {
    return mem_read_u64(3145728); // tick counter @ 0x300000
}

// Lookup in cache: returns [a,b,c,d] or [0,0,0,0] on miss/expired
fn _dns_cache_lookup(name_parts) {
    if _dns_cache_ready == 0 { _dns_cache_init(); }
    let mut h = _dns_name_hash(name_parts);
    let mut bucket = h % DNS_CACHE_BUCKETS;
    let mut now = _dns_now();
    let mut cur = _dns_c_ht[bucket];
    while cur >= 0 {
        if _dns_c_valid[cur] == 1 {
            if _dns_c_hash[cur] == h {
                if _dns_c_expire[cur] > now {
                    _dns_c_hits = _dns_c_hits + 1;
                    return _dns_c_ip[cur];
                } else {
                    // Expired: invalidate
                    set_at(_dns_c_valid, cur, 0);
                    _dns_c_count = _dns_c_count - 1;
                }
            }
        }
        cur = _dns_c_next[cur];
    }
    _dns_c_misses = _dns_c_misses + 1;
    return [0, 0, 0, 0];
}

// Insert into cache
fn _dns_cache_insert(name_parts, ip, ttl_ticks) {
    if _dns_cache_ready == 0 { _dns_cache_init(); }
    let mut h = _dns_name_hash(name_parts);
    let mut bucket = h % DNS_CACHE_BUCKETS;
    let mut expire = _dns_now() + ttl_ticks;

    // Find free slot
    let mut slot = 0 - 1;
    let mut i = 0;
    while i < DNS_CACHE_SIZE {
        if _dns_c_valid[i] == 0 {
            slot = i;
            i = DNS_CACHE_SIZE;
        }
        i = i + 1;
    }

    // If full, evict the first expired or oldest in this bucket
    if slot < 0 {
        let mut now = _dns_now();
        i = 0;
        while i < DNS_CACHE_SIZE {
            if _dns_c_expire[i] <= now {
                slot = i;
                // Unchain from its bucket
                _dns_cache_unchain(i);
                set_at(_dns_c_valid, i, 0);
                _dns_c_count = _dns_c_count - 1;
                i = DNS_CACHE_SIZE;
            }
            i = i + 1;
        }
    }
    if slot < 0 { slot = 0; _dns_cache_unchain(0); }

    set_at(_dns_c_valid, slot, 1);
    set_at(_dns_c_hash, slot, h);
    set_at(_dns_c_ip, slot, ip);
    set_at(_dns_c_expire, slot, expire);
    // Prepend to bucket chain
    set_at(_dns_c_next, slot, _dns_c_ht[bucket]);
    set_at(_dns_c_ht, bucket, slot);
    _dns_c_count = _dns_c_count + 1;
    return 0;
}

// Remove a slot from its hash chain
fn _dns_cache_unchain(slot) {
    let mut h = _dns_c_hash[slot];
    let mut bucket = h % DNS_CACHE_BUCKETS;
    let mut prev = 0 - 1;
    let mut cur = _dns_c_ht[bucket];
    while cur >= 0 {
        if cur == slot {
            if prev < 0 {
                set_at(_dns_c_ht, bucket, _dns_c_next[cur]);
            } else {
                set_at(_dns_c_next, prev, _dns_c_next[cur]);
            }
            set_at(_dns_c_next, slot, 0 - 1);
            return 1;
        }
        prev = cur;
        cur = _dns_c_next[cur];
    }
    return 0;
}

// ============================================================
// DNS wire format
// ============================================================

fn dns_encode_name(parts) {
    let mut encoded = [];
    let mut i = 0;
    while i < len(parts) {
        let mut label = parts[i];
        push(encoded, len(label));
        let mut j = 0;
        while j < len(label) {
            push(encoded, label[j]);
            j = j + 1;
        }
        i = i + 1;
    }
    push(encoded, 0);
    return encoded;
}

fn dns_build_query(name_parts) {
    let mut pkt = [];
    let mut id = dns_id;
    dns_id = dns_id + 1;

    push(pkt, (id / 256) % 256); push(pkt, id % 256);
    push(pkt, 1); push(pkt, 0);
    push(pkt, 0); push(pkt, 1);
    push(pkt, 0); push(pkt, 0);
    push(pkt, 0); push(pkt, 0);
    push(pkt, 0); push(pkt, 0);

    let mut name = dns_encode_name(name_parts);
    let mut i = 0;
    while i < len(name) { push(pkt, name[i]); i = i + 1; }
    push(pkt, 0); push(pkt, DNS_TYPE_A);
    push(pkt, 0); push(pkt, DNS_CLASS_IN);

    return pkt;
}

// Parse DNS response, extract first A record IP + TTL
fn dns_parse_response(data) {
    if len(data) < 12 { return [0, 0, 0, 0]; }
    let mut ancount = data[6] * 256 + data[7];
    if ancount == 0 { return [0, 0, 0, 0]; }

    let mut off = 12;
    // Skip QNAME
    let mut go1 = 1;
    while go1 == 1 {
        if off >= len(data) { go1 = 0; }
        if go1 == 1 {
            let mut lbl_len = data[off];
            if lbl_len == 0 { off = off + 1; go1 = 0; }
            if go1 == 1 { off = off + 1 + lbl_len; }
        }
    }
    off = off + 4; // QTYPE + QCLASS

    if off + 12 > len(data) { return [0, 0, 0, 0]; }
    if data[off] >= 192 { off = off + 2; }
    else {
        let mut go2 = 1;
        while go2 == 1 {
            if off >= len(data) { go2 = 0; }
            if go2 == 1 {
                let mut l = data[off];
                if l == 0 { off = off + 1; go2 = 0; }
                if go2 == 1 { off = off + 1 + l; }
            }
        }
    }
    let mut rtype = data[off] * 256 + data[off + 1];
    // TTL at off+4..off+7 (4 bytes big-endian)
    let mut ttl_sec = data[off+4]*16777216 + data[off+5]*65536 + data[off+6]*256 + data[off+7];
    let mut rdlength = data[off + 8] * 256 + data[off + 9];
    off = off + 10;

    if rtype == DNS_TYPE_A {
        if rdlength == 4 {
            let mut ip = [data[off], data[off+1], data[off+2], data[off+3]];
            // Cache the result with TTL (convert seconds -> ticks at 100Hz)
            let mut ttl_ticks = ttl_sec * 100;
            if ttl_ticks < 100 { ttl_ticks = DNS_DEFAULT_TTL; }
            return ip;
        }
    }
    return [0, 0, 0, 0];
}

// ============================================================
// Public API
// ============================================================

fn dns_resolve(name_parts) {
    if _dns_cache_ready == 0 { _dns_cache_init(); }

    // Check cache first (O(1))
    let mut cached = _dns_cache_lookup(name_parts);
    if cached[0] != 0 { return cached; }
    if cached[1] != 0 { return cached; }
    if cached[2] != 0 { return cached; }
    if cached[3] != 0 { return cached; }

    // Static entries (always cached)
    if len(name_parts) == 1 {
        if name_parts[0] == "localhost" {
            _dns_cache_insert(name_parts, [127, 0, 0, 1], DNS_DEFAULT_TTL);
            return [127, 0, 0, 1];
        }
        if name_parts[0] == "gateway" {
            _dns_cache_insert(name_parts, [10, 0, 2, 2], DNS_DEFAULT_TTL);
            return [10, 0, 2, 2];
        }
    }

    // Cache miss: build and send DNS query
    let mut query = dns_build_query(name_parts);
    // TODO: send via UDP to dns_server:53, receive response
    // let resp = udp_send_recv(dns_server, DNS_PORT, query);
    // let ip = dns_parse_response(resp);
    // if ip[0] != 0 { _dns_cache_insert(name_parts, ip, ttl_ticks); }
    // return ip;

    return [0, 0, 0, 0];
}

// Cache with explicit TTL (for use after parsing response externally)
fn dns_cache_result(name_parts, ip, ttl_sec) {
    let mut ttl_ticks = ttl_sec * 100;
    if ttl_ticks < 100 { ttl_ticks = DNS_DEFAULT_TTL; }
    _dns_cache_insert(name_parts, ip, ttl_ticks);
    return 0;
}

fn dns_cache_flush() {
    _dns_cache_init();
    return 0;
}

fn dns_cache_status() {
    return to_string(_dns_c_count) + " entries, " + to_string(_dns_c_hits) + " hits, " + to_string(_dns_c_misses) + " misses";
}

// ============================================================
// DNS loopback self-test (iteration 118)
// ============================================================
// Full round-trip: build query → mock response → parse → cache → verify hit → expire → verify miss

fn _dns_build_mock_response(query_id, name_parts, ip, ttl_sec) {
    let mut pkt = [];
    // Header: ID
    push(pkt, (query_id / 256) % 256);
    push(pkt, query_id % 256);
    // Flags: QR=1 RD=1 RA=1 = 0x8180
    push(pkt, 129); push(pkt, 128);
    // QDCOUNT=1
    push(pkt, 0); push(pkt, 1);
    // ANCOUNT=1
    push(pkt, 0); push(pkt, 1);
    // NSCOUNT=0 ARCOUNT=0
    push(pkt, 0); push(pkt, 0);
    push(pkt, 0); push(pkt, 0);

    // Question section: QNAME + QTYPE + QCLASS
    let mut encoded = dns_encode_name(name_parts);
    let mut i = 0;
    while i < len(encoded) { push(pkt, encoded[i]); i = i + 1; }
    // QTYPE = A (1)
    push(pkt, 0); push(pkt, 1);
    // QCLASS = IN (1)
    push(pkt, 0); push(pkt, 1);

    // Answer section: name pointer + TYPE + CLASS + TTL + RDLENGTH + RDATA
    // Name pointer: 0xC00C (points to offset 12 where QNAME starts)
    push(pkt, 192); push(pkt, 12);
    // TYPE = A (1)
    push(pkt, 0); push(pkt, 1);
    // CLASS = IN (1)
    push(pkt, 0); push(pkt, 1);
    // TTL (4 bytes big-endian)
    push(pkt, (ttl_sec / 16777216) % 256);
    push(pkt, (ttl_sec / 65536) % 256);
    push(pkt, (ttl_sec / 256) % 256);
    push(pkt, ttl_sec % 256);
    // RDLENGTH = 4
    push(pkt, 0); push(pkt, 4);
    // RDATA = IP
    push(pkt, ip[0]); push(pkt, ip[1]); push(pkt, ip[2]); push(pkt, ip[3]);

    return pkt;
}

fn dns_loopback_test() {
    // Ensure cache is initialized
    _dns_cache_init();
    let mut ok = 1;

    let mut name = ["example", "com"];
    let mut test_ip = [93, 184, 216, 34];
    let mut ttl_sec = 300;

    // Step 1: Build query
    let mut query = dns_build_query(name);
    if len(query) < 12 { ok = 0; }

    // Step 2: Extract query ID
    let mut qid = query[0] * 256 + query[1];

    // Step 3: Build mock DNS response
    let mut response = _dns_build_mock_response(qid, name, test_ip, ttl_sec);

    // Step 4: Parse response → extract IP
    let mut parsed_ip = dns_parse_response(response);
    if parsed_ip[0] != 93 { ok = 0; }
    if parsed_ip[1] != 184 { ok = 0; }
    if parsed_ip[2] != 216 { ok = 0; }
    if parsed_ip[3] != 34 { ok = 0; }

    // Step 5: Cache the result
    dns_cache_result(name, parsed_ip, ttl_sec);

    // Step 6: Resolve again → should hit cache
    let mut hits_before = _dns_c_hits;
    let mut resolved = dns_resolve(name);
    if resolved[0] != 93 { ok = 0; }
    if resolved[1] != 184 { ok = 0; }
    if resolved[2] != 216 { ok = 0; }
    if resolved[3] != 34 { ok = 0; }
    if _dns_c_hits <= hits_before { ok = 0; }

    // Step 7: Force-expire the entry, resolve → should miss
    let mut ei = 0;
    while ei < DNS_CACHE_SIZE {
        if _dns_c_valid[ei] == 1 {
            set_at(_dns_c_expire, ei, 0);  // expire immediately
        }
        ei = ei + 1;
    }
    let mut misses_before = _dns_c_misses;
    let mut expired_result = dns_resolve(name);
    // After expiration, should return either [0,0,0,0] or re-resolve
    // but miss counter should increment
    if _dns_c_misses <= misses_before { ok = 0; }

    // Step 8: Verify static entry (localhost)
    let mut lo = dns_resolve(["localhost"]);
    if lo[0] != 127 { ok = 0; }
    if lo[3] != 1 { ok = 0; }

    return ok;
}

fn dns_loopback_status() {
    let mut result = dns_loopback_test();
    if result == 1 {
        return "DNS loopback: query>response>parse>cache>hit>expire>miss>static OK";
    }
    return "DNS loopback: FAIL";
}

print("dns.hl loaded (TTL hash cache)");
print("DNS cache: " + to_string(DNS_CACHE_SIZE) + " entries, " + to_string(DNS_CACHE_BUCKETS) + " buckets");
