// vfs.hl -- Virtual Filesystem Layer (Trie Mount Resolution)
//
// Iteration 88: mount resolution upgraded from O(n) linear scan
// to O(depth) Trie prefix tree lookup.
//
// Trie design:
//   Nodes indexed by parallel arrays. Each node holds one path component.
//   Root (node 0) = "/". Children scanned by component match.
//   vfs_resolve: split path by '/', walk Trie, track deepest mount point.
//
// Public API (all signatures preserved):
//   vfs_init / vfs_mount / vfs_mount_fat16 / vfs_resolve
//   vfs_open / vfs_read / vfs_write / vfs_close / vfs_seek
//   vfs_stat / vfs_readdir / vfs_mkdir / vfs_unlink

let VFS_TABLE = 8650752;       // 0x840000
let VFS_ENTRY_SIZE = 128;
let MAX_OPEN_FILES = 256;
let MAX_MOUNTS = 8;
let TRIE_MAX_NODES = 32;

let O_RDONLY = 0;
let O_WRONLY = 1;
let O_RDWR   = 2;
let O_CREAT  = 64;
let O_TRUNC  = 512;
let O_APPEND = 1024;

let FT_REGULAR = 1;
let FT_DIR     = 2;
let FT_CHARDEV = 3;
let FT_BLKDEV  = 4;
let FT_PIPE    = 5;

let MOUNT_TABLE = 8716288;    // 0x850000
let mut mount_count = 0;

// ============================================================
// Trie for mount-point prefix matching
// ============================================================

let mut _trie_label = [];      // path component ("dev","mnt",...)
let mut _trie_children = [];   // array of child indices per node
let mut _trie_mount = [];      // mount table index (-1 = not a mount point)
let mut _trie_count = 0;

fn _trie_init() {
    _trie_label = [];
    _trie_children = [];
    _trie_mount = [];
    // Create root node (represents "/")
    push(_trie_label, "");
    push(_trie_children, []);
    push(_trie_mount, 0 - 1);
    _trie_count = 1;
    return 0;
}

fn _trie_add_child(parent, label) {
    if _trie_count >= TRIE_MAX_NODES { return 0 - 1; }
    let idx = _trie_count;
    push(_trie_label, label);
    push(_trie_children, []);
    push(_trie_mount, 0 - 1);
    _trie_count = _trie_count + 1;
    push(_trie_children[parent], idx);
    return idx;
}

fn _trie_find_child(parent, label) {
    let kids = _trie_children[parent];
    let mut i = 0;
    while i < len(kids) {
        if _trie_label[kids[i]] == label { return kids[i]; }
        i = i + 1;
    }
    return 0 - 1;
}

// Insert a mount path into the Trie, return the leaf node
fn _trie_insert_path(path, mount_idx) {
    let parts = _vfs_split_path(path);
    let mut node = 0; // root
    let mut i = 0;
    while i < len(parts) {
        let child = _trie_find_child(node, parts[i]);
        if child >= 0 {
            node = child;
        } else {
            node = _trie_add_child(node, parts[i]);
            if node < 0 { return 0 - 1; }
        }
        i = i + 1;
    }
    set_at(_trie_mount, node, mount_idx);
    return node;
}

// Split path "/dev/sda" -> ["dev","sda"], "/" -> []
fn _vfs_split_path(path) {
    let mut parts = [];
    let mut cur = "";
    let mut i = 0;
    while i < len(path) {
        let c = char_at(path, i);
        if c == "/" {
            if len(cur) > 0 {
                push(parts, cur);
                cur = "";
            }
        } else {
            cur = cur + c;
        }
        i = i + 1;
    }
    if len(cur) > 0 { push(parts, cur); }
    return parts;
}

// ============================================================
// Trie-based resolve: O(path_depth) instead of O(n_mounts)
// Returns [mount_idx, full_path]
// ============================================================

fn vfs_resolve(path) {
    let parts = _vfs_split_path(path);
    let mut node = 0; // root
    let mut best_mount = 0 - 1;
    // Check if root itself is a mount point
    if _trie_mount[0] >= 0 { best_mount = _trie_mount[0]; }

    let mut i = 0;
    while i < len(parts) {
        let child = _trie_find_child(node, parts[i]);
        if child >= 0 {
            node = child;
            if _trie_mount[node] >= 0 {
                best_mount = _trie_mount[node];
            }
            i = i + 1;
        } else {
            i = len(parts); // break: no deeper match
        }
    }

    if best_mount < 0 { best_mount = 0; }
    return [best_mount, path];
}

// ============================================================
// Mount management
// ============================================================

fn vfs_init() {
    _trie_init();
    mount_count = 0;
    vfs_mount("/", 0, 0);
    vfs_mount("/dev", 2, 0);
    return 0;
}

fn vfs_mount(path_prefix, fs_type, device_id) {
    if mount_count >= MAX_MOUNTS { return 0; }
    let addr = MOUNT_TABLE + mount_count * 64;
    mem_write_u64(addr, 1);
    mem_write_string(addr + 8, path_prefix);
    mem_write_u64(addr + 16, fs_type);
    mem_write_u64(addr + 24, device_id);
    // Insert into Trie
    _trie_insert_path(path_prefix, mount_count);
    mount_count = mount_count + 1;
    return 1;
}

fn vfs_mount_fat16(mount_path, device_id) {
    let boot_buf = page_alloc();
    virtio_blk_read(0, 1, boot_buf);
    let mut boot_sector = [];
    let mut i = 0;
    while i < 512 {
        push(boot_sector, mem_read_u8(boot_buf + i));
        i = i + 1;
    }
    page_free(boot_buf);
    let result = fat16_init(boot_sector);
    if result == 1 {
        vfs_mount(mount_path, 1, device_id);
        print("Mounted FAT16 at " + mount_path);
        return 1;
    }
    print("Failed to mount FAT16 at " + mount_path);
    return 0;
}

// ============================================================
// File operations (unchanged logic, uses Trie resolve)
// ============================================================

fn vfs_open(path, flags) {
    let mount_info = vfs_resolve(path);
    let mount_idx = mount_info[0];

    let mut fd = 0;
    while fd < MAX_OPEN_FILES {
        let addr = VFS_TABLE + fd * VFS_ENTRY_SIZE;
        let f = mem_read_u64(addr);
        if f == 0 {
            mem_write_u64(addr, 1);
            mem_write_u64(addr + 8, mem_read_u64(MOUNT_TABLE + mount_idx * 64 + 16));
            mem_write_u64(addr + 24, 0);
            mem_write_u64(addr + 40, 1);
            return fd;
        }
        fd = fd + 1;
    }
    return 0 - 1;
}

fn vfs_read(fd, buf, count) {
    if fd < 0 { return 0; }
    if fd >= MAX_OPEN_FILES { return 0; }
    let addr = VFS_TABLE + fd * VFS_ENTRY_SIZE;
    let fs_type = mem_read_u64(addr + 8);
    let inode = mem_read_u64(addr + 16);
    let pos = mem_read_u64(addr + 24);
    let size = mem_read_u64(addr + 32);
    let mut bytes_read = 0;
    if fs_type == 0 {
        bytes_read = ramfs_read(inode, buf, pos, count);
    }
    if fs_type == 1 {
        bytes_read = 0;
    }
    mem_write_u64(addr + 24, pos + bytes_read);
    return bytes_read;
}

fn vfs_write(fd, data, count) {
    if fd < 0 { return 0; }
    if fd >= MAX_OPEN_FILES { return 0; }
    let addr = VFS_TABLE + fd * VFS_ENTRY_SIZE;
    let fs_type = mem_read_u64(addr + 8);
    let inode = mem_read_u64(addr + 16);
    let pos = mem_read_u64(addr + 24);
    let mut bytes_written = 0;
    if fs_type == 0 {
        bytes_written = ramfs_write(inode, data, pos, count);
    }
    if fs_type == 1 {
        bytes_written = 0;
    }
    mem_write_u64(addr + 24, pos + bytes_written);
    let old_size = mem_read_u64(addr + 32);
    if pos + bytes_written > old_size {
        mem_write_u64(addr + 32, pos + bytes_written);
    }
    return bytes_written;
}

fn vfs_close(fd) {
    if fd < 0 { return 0; }
    let addr = VFS_TABLE + fd * VFS_ENTRY_SIZE;
    mem_write_u64(addr, 0);
    return 0;
}

fn vfs_seek(fd, offset, whence) {
    if fd < 0 { return 0; }
    let addr = VFS_TABLE + fd * VFS_ENTRY_SIZE;
    let cur = mem_read_u64(addr + 24);
    let size = mem_read_u64(addr + 32);
    let mut new_pos = cur;
    if whence == 0 { new_pos = offset; }
    if whence == 1 { new_pos = cur + offset; }
    if whence == 2 { new_pos = size + offset; }
    if new_pos < 0 { new_pos = 0; }
    mem_write_u64(addr + 24, new_pos);
    return new_pos;
}

fn vfs_stat(path) {
    let mount_info = vfs_resolve(path);
    let fs_type = mem_read_u64(MOUNT_TABLE + mount_info[0] * 64 + 16);
    if fs_type == 0 { return ramfs_stat(path); }
    if fs_type == 1 {
        let files = fat16_list_root();
        let mut i = 0;
        while i < len(files) {
            if files[i][0] == path {
                let mut ftype = 1;
                if files[i][3] == 1 { ftype = 2; }
                return [files[i][2], ftype, files[i][1], 0];
            }
            if files[i][0] == mount_info[1] {
                let mut ftype = 1;
                if files[i][3] == 1 { ftype = 2; }
                return [files[i][2], ftype, files[i][1], 0];
            }
            i = i + 1;
        }
    }
    return [0, 0, 0, 0];
}

fn vfs_readdir(path) {
    let mount_info = vfs_resolve(path);
    let fs_type = mem_read_u64(MOUNT_TABLE + mount_info[0] * 64 + 16);
    if fs_type == 0 { return ramfs_readdir(path); }
    if fs_type == 1 {
        let files = fat16_list_root();
        let mut names = [];
        let mut i = 0;
        while i < len(files) {
            push(names, files[i][0]);
            i = i + 1;
        }
        return names;
    }
    return [];
}

fn vfs_mkdir(path) {
    let mount_info = vfs_resolve(path);
    let fs_type = mem_read_u64(MOUNT_TABLE + mount_info[0] * 64 + 16);
    if fs_type == 0 { return ramfs_mkdir(path); }
    if fs_type == 1 { return fat16_create_file(path, 1); }
    return 0 - 1;
}

fn vfs_unlink(path) {
    let mount_info = vfs_resolve(path);
    let fs_type = mem_read_u64(MOUNT_TABLE + mount_info[0] * 64 + 16);
    if fs_type == 0 { return ramfs_unlink(path); }
    if fs_type == 1 {
        let files = fat16_list_root();
        let mut i = 0;
        while i < len(files) {
            if files[i][0] == path { return fat16_delete_file(i); }
            i = i + 1;
        }
    }
    return 0 - 1;
}

print("vfs.hl loaded (Trie mount resolve)");
print("Max open files: " + to_string(MAX_OPEN_FILES));
print("Max mounts: " + to_string(MAX_MOUNTS) + ", Trie nodes: " + to_string(TRIE_MAX_NODES));
