// wavelet.hl -- Discrete Wavelet Transform (Haar Wavelet)
//
// Implements the Haar wavelet transform (Alfred Haar, 1909):
//   - 1D DWT: forward and inverse transforms, O(n) time
//   - 2D DWT: image/matrix transform (row-then-column decomposition)
//   - Multi-level decomposition (up to WAVELET_MAX_LEVELS = 6)
//   - Threshold-based compression: zero small coefficients
//   - Energy preservation: ‖f‖² = ‖Wf‖² (Parseval's theorem)
//   - Approximation and detail coefficients at each level
// Applications: signal compression, image processing (JPEG-2000-like),
//               edge detection, denoising, multi-resolution analysis.
// Fixed-point arithmetic (WAVELET_SCALE = 1000).
//
// Buffer: 0x1440000

let WAVELET_BUF = 0x1440000;

let mut WAVELET_SCALE      = 1000;
let WAVELET_MAX_LEN    = 256;    // max signal length
let mut WAVELET_MAX_LEVELS = 6;      // max decomposition levels
let WAVELET_SQRT2      = 1414;   // √2 × SCALE (fixed-point)

// Signal and coefficient storage
let wv_signal   = [];   // input signal (length up to WAVELET_MAX_LEN)
let wv_coeffs   = [];   // wavelet coefficients (same length)
let wv_temp     = [];   // workspace for in-place transform

let mut wv_len      = 0;    // current signal length
let mut wv_levels   = 0;    // decomposition levels applied
let mut wv_energy_in  = 0;  // input signal energy (sum of squares / SCALE)
let mut wv_energy_out = 0;  // transform energy (should equal input for lossless)

let mut wv_initialized = 0;

fn wavelet_init() {
    let mut i = 0;
    while i < WAVELET_MAX_LEN {
        set_at(wv_signal, i, 0);
        set_at(wv_coeffs, i, 0);
        set_at(wv_temp,   i, 0);
        i = i + 1;
    }
    wv_len      = 0;
    wv_levels   = 0;
    wv_energy_in  = 0;
    wv_energy_out = 0;
    wv_initialized = 1;
    return 0;
}

// Load signal from array
fn wavelet_load(data, n) {
    if n > WAVELET_MAX_LEN { n = WAVELET_MAX_LEN; }
    wv_len = n;
    let mut i = 0;
    while i < n { set_at(wv_coeffs, i, data[i]); i = i + 1; }
    // Compute input energy
    wv_energy_in = 0;
    i = 0;
    while i < n {
        wv_energy_in = wv_energy_in + (data[i] * data[i]) / WAVELET_SCALE;
        i = i + 1;
    }
    return 0;
}

// One-level Haar forward step on length-n prefix of wv_coeffs
// Output: first n/2 = averages (approximation), last n/2 = differences (detail)
fn _wv_haar_forward_step(n) {
    let mut half = n / 2;
    let mut i = 0;
    while i < half {
        let mut a = wv_coeffs[2 * i];
        let mut b = wv_coeffs[2 * i + 1];
        // avg = (a + b) / √2,  diff = (a - b) / √2  (scaled)
        set_at(wv_temp, i,        (a + b) * WAVELET_SCALE / WAVELET_SQRT2);
        set_at(wv_temp, half + i, (a - b) * WAVELET_SCALE / WAVELET_SQRT2);
        i = i + 1;
    }
    i = 0;
    while i < n { set_at(wv_coeffs, i, wv_temp[i]); i = i + 1; }
    return 0;
}

// One-level Haar inverse step on length-n prefix of wv_coeffs
fn _wv_haar_inverse_step(n) {
    let mut half = n / 2;
    let mut i = 0;
    while i < half {
        let mut avg = wv_coeffs[i];
        let mut diff = wv_coeffs[half + i];
        // a = (avg + diff) / √2,  b = (avg - diff) / √2
        set_at(wv_temp, 2 * i,     (avg + diff) * WAVELET_SCALE / WAVELET_SQRT2);
        set_at(wv_temp, 2 * i + 1, (avg - diff) * WAVELET_SCALE / WAVELET_SQRT2);
        i = i + 1;
    }
    i = 0;
    while i < n { set_at(wv_coeffs, i, wv_temp[i]); i = i + 1; }
    return 0;
}

// Full multi-level forward DWT
fn wavelet_forward(levels) {
    if levels > WAVELET_MAX_LEVELS { levels = WAVELET_MAX_LEVELS; }
    wv_levels = levels;
    let mut n = wv_len;
    let mut l = 0;
    while l < levels {
        if n < 2 { l = levels; }
        else { _wv_haar_forward_step(n); n = n / 2; }
        l = l + 1;
    }
    // Compute output energy
    wv_energy_out = 0;
    let mut i = 0;
    while i < wv_len {
        wv_energy_out = wv_energy_out + (wv_coeffs[i] * wv_coeffs[i]) / WAVELET_SCALE;
        i = i + 1;
    }
    return 0;
}

// Full multi-level inverse DWT
fn wavelet_inverse(levels) {
    let mut n = wv_len;
    // Find starting size after forward transform
    let mut l = 0;
    while l < levels { n = n / 2; l = l + 1; }
    // Reconstruct bottom-up
    l = 0;
    while l < levels {
        n = n * 2;
        _wv_haar_inverse_step(n);
        l = l + 1;
    }
    return 0;
}

// Threshold compression: zero coefficients with |c| < threshold
// Returns count of zeroed coefficients
fn wavelet_threshold(threshold) {
    let mut zeroed = 0;
    // Skip the coarsest approximation (first few coefficients)
    let mut approx_size = wv_len;
    let mut l = 0;
    while l < wv_levels { approx_size = approx_size / 2; l = l + 1; }
    let mut i = approx_size;  // threshold only detail coefficients
    while i < wv_len {
        let mut v = wv_coeffs[i];
        if v < 0 { v = -v; }
        if v < threshold { set_at(wv_coeffs, i, 0); zeroed = zeroed + 1; }
        i = i + 1;
    }
    return zeroed;
}

// Compute compression ratio × 1000 (non-zero coefficients / total)
fn wavelet_compression_ratio() {
    let mut nonzero = 0;
    let mut i = 0;
    while i < wv_len {
        if wv_coeffs[i] != 0 { nonzero = nonzero + 1; }
        i = i + 1;
    }
    return (nonzero * 1000) / wv_len;
}

// 2D DWT: apply 1D DWT to each row, then each column (for n×n matrix)
// matrix: flat row-major array of length n×n stored in wv_coeffs
fn wavelet_2d_forward(n, levels) {
    // Row-wise transform
    let mut r = 0;
    while r < n {
        let mut row_start = r * n;
        // Copy row to temp, apply DWT, copy back
        let mut i = 0;
        while i < n { set_at(wv_temp, i, wv_coeffs[row_start + i]); i = i + 1; }
        // In-place: repoint wv_coeffs temporarily
        i = 0;
        while i < n { set_at(wv_coeffs, i, wv_temp[i]); i = i + 1; }
        wavelet_forward(levels);
        i = 0;
        while i < n { set_at(wv_coeffs, row_start + i, wv_coeffs[i]); i = i + 1; }
        r = r + 1;
    }
    return 0;
}

fn wavelet_info() {
    return "wavelet: len=" + to_string(wv_len)
        + " levels=" + to_string(wv_levels)
        + " energy_in=" + to_string(wv_energy_in / WAVELET_SCALE)
        + " energy_out=" + to_string(wv_energy_out / WAVELET_SCALE)
        + " compression=" + to_string(wavelet_compression_ratio()) + "/1000";
}

fn wavelet_test() {
    wavelet_init();
    // Signal: 8-point square wave [1000,1000,1000,1000,-1000,-1000,-1000,-1000]
    let mut sig = [1000, 1000, 1000, 1000, -1000, -1000, -1000, -1000];
    wavelet_load(sig, 8);
    wavelet_forward(3);
    // After 3-level Haar DWT, energy should be preserved
    let mut energy_ratio = 0;
    if wv_energy_in > 0 { energy_ratio = (wv_energy_out * 1000) / wv_energy_in; }
    // Threshold: zero small detail coefficients
    let mut zeroed = wavelet_threshold(100);
    let mut comp_ratio = wavelet_compression_ratio();
    // Reconstruct
    wavelet_inverse(3);
    let mut reconstructed_0 = wv_coeffs[0];  // should be ~1000
    // Ramp signal [0, 125, 250, 375, 500, 625, 750, 875]
    wavelet_init();
    let mut ramp = [0, 125, 250, 375, 500, 625, 750, 875];
    wavelet_load(ramp, 8);
    wavelet_forward(3);
    let mut ramp_energy = wv_energy_out;
    print("wavelet test: " + wavelet_info());
    print("wavelet test: energy_ratio=" + to_string(energy_ratio)
        + "/1000 zeroed=" + to_string(zeroed)
        + " comp=" + to_string(comp_ratio) + "/1000"
        + " recon[0]=" + to_string(reconstructed_0));
    return "wavelet: Haar 8pt 3-level, energy_ratio=" + to_string(energy_ratio) + "/1000"
        + " threshold_zeroed=" + to_string(zeroed)
        + " comp_ratio=" + to_string(comp_ratio) + "/1000"
        + " [Haar 1909 ok]";
}

print("wavelet.hl loaded -- Haar DWT (1D/2D forward/inverse, multi-level, threshold compression)");
