// wm.hl -- Window Manager (VESA Framebuffer)
//
// Provides a stacking window manager on top of VESA linear framebuffer.
// Each window has: position, size, title, z-order, content buffer.
// Mouse events drive window focus, move, and resize.
//
// Window table: 16 windows max

let WM_MAX_WINDOWS = 16;
let WM_TABLE_ADDR = 9306112;  // 0x8E0000

// Window entry (128 bytes):
//   +0:   id (8)
//   +8:   x (8)
//   +16:  y (8)
//   +24:  width (8)
//   +32:  height (8)
//   +40:  z_order (8)
//   +48:  flags (8) -- bit0=visible, bit1=focused, bit2=minimized
//   +56:  title_ptr (8) -- pointer to title string
//   +64:  content_buf (8) -- pointer to pixel buffer
//   +72:  owner_task (8)
//   +80:  dirty (8) -- 1 if needs repaint

let WM_FLAG_VISIBLE  = 1;
let WM_FLAG_FOCUSED  = 2;
let WM_FLAG_MINIMIZED = 4;

let mut wm_window_count = 0;
let mut wm_focused_id = 0;
let mut wm_mouse_x = 512;
let mut wm_mouse_y = 384;
let mut wm_dragging = 0;
let mut wm_drag_win = 0;
let mut wm_drag_off_x = 0;
let mut wm_drag_off_y = 0;

// Window title strings (parallel array, indexed by window id)
let wm_titles = ["", "", "", "", "", "", "", "",
                 "", "", "", "", "", "", "", ""];

fn wm_get_title(win_id) {
    if win_id < 0 { return ""; }
    if win_id >= WM_MAX_WINDOWS { return ""; }
    return wm_titles[win_id];
}

fn wm_set_title(win_id, title) {
    if win_id < 0 { return 0; }
    if win_id >= WM_MAX_WINDOWS { return 0; }
    wm_titles[win_id] = title;
    return 0;
}

fn wm_make_flags(visible, focused, minimized) {
    let mut flags = 0;
    if visible == 1 { flags = flags + WM_FLAG_VISIBLE; }
    if focused == 1 { flags = flags + WM_FLAG_FOCUSED; }
    if minimized == 1 { flags = flags + WM_FLAG_MINIMIZED; }
    return flags;
}

fn wm_is_visible(flags) {
    if flags % 2 == 1 { return 1; }
    return 0;
}

fn wm_is_focused(flags) {
    if (flags / 2) % 2 == 1 { return 1; }
    return 0;
}

fn wm_is_minimized(flags) {
    if (flags / 4) % 2 == 1 { return 1; }
    return 0;
}

fn wm_find_top_visible() {
    let mut best = 0 - 1;
    let mut best_z = 0 - 1;
    let mut i = 0;
    while i < wm_window_count {
        let addr = WM_TABLE_ADDR + i * 128;
        let flags = mem_read_u64(addr + 48);
        let z = mem_read_u64(addr + 40);
        if wm_is_visible(flags) == 1 {
            if wm_is_minimized(flags) == 0 {
                if z > best_z {
                    best = i;
                    best_z = z;
                }
            }
        }
        i = i + 1;
    }
    return best;
}

fn wm_raise_window(win_id) {
    if win_id < 0 { return 0; }
    if win_id >= wm_window_count { return 0; }
    let target = WM_TABLE_ADDR + win_id * 128;
    let old_z = mem_read_u64(target + 40);
    let top_z = wm_window_count - 1;
    if old_z >= top_z { return 0; }
    let mut i = 0;
    while i < wm_window_count {
        if i != win_id {
            let addr = WM_TABLE_ADDR + i * 128;
            let z = mem_read_u64(addr + 40);
            if z > old_z {
                mem_write_u64(addr + 40, z - 1);
            }
        }
        i = i + 1;
    }
    mem_write_u64(target + 40, top_z);
    return 0;
}

fn wm_focus_window(win_id) {
    if win_id < 0 { return 0; }
    if win_id >= wm_window_count { return 0; }
    let mut i = 0;
    while i < wm_window_count {
        let addr = WM_TABLE_ADDR + i * 128;
        let flags = mem_read_u64(addr + 48);
        if wm_is_visible(flags) == 1 {
            let minimized = wm_is_minimized(flags);
            let mut focused = 0;
            if i == win_id {
                if minimized == 0 {
                    focused = 1;
                    wm_focused_id = win_id;
                }
            }
            mem_write_u64(addr + 48, wm_make_flags(1, focused, minimized));
        }
        i = i + 1;
    }
    wm_raise_window(win_id);
    return 0;
}

fn wm_hit_test_window(win_id, px, py) {
    if win_id < 0 { return 0; }
    if win_id >= wm_window_count { return 0; }
    let title_h = ui_theme_title_height();
    let addr = WM_TABLE_ADDR + win_id * 128;
    let flags = mem_read_u64(addr + 48);
    if wm_is_visible(flags) == 0 { return 0; }
    if wm_is_minimized(flags) == 1 { return 0; }
    let wx = mem_read_u64(addr + 8);
    let wy = mem_read_u64(addr + 16);
    let ww = mem_read_u64(addr + 24);
    let wh = mem_read_u64(addr + 32) + title_h;
    if px >= wx {
        if px < wx + ww {
            if py >= wy {
                if py < wy + wh { return 1; }
            }
        }
    }
    return 0;
}

fn wm_hit_test_titlebar(win_id, px, py) {
    let title_h = ui_theme_title_height();
    let addr = WM_TABLE_ADDR + win_id * 128;
    let wx = mem_read_u64(addr + 8);
    let wy = mem_read_u64(addr + 16);
    let ww = mem_read_u64(addr + 24);
    if px >= wx {
        if px < wx + ww {
            if py >= wy {
                if py < wy + title_h { return 1; }
            }
        }
    }
    return 0;
}

fn wm_hit_test_close(win_id, px, py) {
    let addr = WM_TABLE_ADDR + win_id * 128;
    let wx = mem_read_u64(addr + 8);
    let wy = mem_read_u64(addr + 16);
    let ww = mem_read_u64(addr + 24);
    let bx = wx + ww - 18;
    let by = wy + 2;
    if px >= bx {
        if px < bx + 16 {
            if py >= by {
                if py < by + 16 { return 1; }
            }
        }
    }
    return 0;
}

fn wm_hit_test_minimize(win_id, px, py) {
    let addr = WM_TABLE_ADDR + win_id * 128;
    let wx = mem_read_u64(addr + 8);
    let wy = mem_read_u64(addr + 16);
    let ww = mem_read_u64(addr + 24);
    let bx = wx + ww - 38;
    let by = wy + 2;
    if px >= bx {
        if px < bx + 16 {
            if py >= by {
                if py < by + 16 { return 1; }
            }
        }
    }
    return 0;
}

fn wm_minimize_window(win_id) {
    if win_id < 0 { return 0; }
    if win_id >= wm_window_count { return 0; }
    let addr = WM_TABLE_ADDR + win_id * 128;
    let flags = mem_read_u64(addr + 48);
    if wm_is_visible(flags) == 0 { return 0; }
    mem_write_u64(addr + 48, wm_make_flags(1, 0, 1));
    if wm_focused_id == win_id {
        let next = wm_find_top_visible();
        if next >= 0 {
            wm_focus_window(next);
        }
    }
    return 0;
}

fn wm_restore_window(win_id) {
    if win_id < 0 { return 0; }
    if win_id >= wm_window_count { return 0; }
    let addr = WM_TABLE_ADDR + win_id * 128;
    let flags = mem_read_u64(addr + 48);
    if wm_is_visible(flags) == 0 { return 0; }
    mem_write_u64(addr + 48, wm_make_flags(1, 0, 0));
    wm_focus_window(win_id);
    return 0;
}

// --- Taskbar ---
let WM_DOCK_BTN_W = 60;
let WM_DOCK_BTN_H = 28;
let WM_DOCK_BTN_PAD = 4;

fn wm_draw_taskbar() {
    let dock_h = ui_theme_dock_height();
    let dock_y = vesa_height - dock_h;
    let mut x = WM_DOCK_BTN_PAD;
    let btn_y = dock_y + (dock_h - WM_DOCK_BTN_H) / 2;
    let mut i = 0;
    while i < wm_window_count {
        let addr = WM_TABLE_ADDR + i * 128;
        let flags = mem_read_u64(addr + 48);
        if wm_is_visible(flags) == 1 {
            let mut bg = ui_theme_border_color();
            if i == wm_focused_id {
                if wm_is_minimized(flags) == 0 {
                    bg = ui_theme_accent_color();
                }
            }
            vesa_fill_rect(x, btn_y, WM_DOCK_BTN_W, WM_DOCK_BTN_H, bg);
            vesa_rect(x, btn_y, WM_DOCK_BTN_W, WM_DOCK_BTN_H, ui_theme_panel_color());
            x = x + WM_DOCK_BTN_W + WM_DOCK_BTN_PAD;
        }
        i = i + 1;
    }
    return 0;
}

fn wm_hit_test_taskbar(px, py) {
    let dock_h = ui_theme_dock_height();
    let dock_y = vesa_height - dock_h;
    if py < dock_y { return 0 - 1; }
    let btn_y = dock_y + (dock_h - WM_DOCK_BTN_H) / 2;
    if py < btn_y { return 0 - 1; }
    if py >= btn_y + WM_DOCK_BTN_H { return 0 - 1; }
    let mut x = WM_DOCK_BTN_PAD;
    let mut i = 0;
    while i < wm_window_count {
        let addr = WM_TABLE_ADDR + i * 128;
        let flags = mem_read_u64(addr + 48);
        if wm_is_visible(flags) == 1 {
            if px >= x {
                if px < x + WM_DOCK_BTN_W { return i; }
            }
            x = x + WM_DOCK_BTN_W + WM_DOCK_BTN_PAD;
        }
        i = i + 1;
    }
    return 0 - 1;
}

fn wm_draw_topbar_text() {
    let top_h = ui_theme_topbar_height();
    let ty = (top_h - 16) / 2;
    // "HicOS" brand at left
    ui_draw_text(8, ty, "HicOS", ui_theme_text_color(), 0);
    return 0;
}

fn wm_init() {
    wm_window_count = 0;
    wm_focused_id = 0;
    ui_theme_init();
    // Clear screen to desktop color
    vesa_clear(ui_theme_desktop_color());
    return 0;
}

fn wm_draw_desktop_chrome() {
    let top_h = ui_theme_topbar_height();
    let dock_h = ui_theme_dock_height();
    vesa_fill_rect(0, 0, vesa_width, top_h, ui_theme_panel_color());
    vesa_fill_rect(0, top_h - 1, vesa_width, 1, ui_theme_border_color());
    wm_draw_topbar_text();
    vesa_fill_rect(0, vesa_height - dock_h, vesa_width, dock_h, ui_theme_panel_color());
    vesa_fill_rect(0, vesa_height - dock_h, vesa_width, 1, ui_theme_border_color());
    wm_draw_taskbar();
    return 0;
}

fn wm_create_window(x, y, w, h, title, owner) {
    if wm_window_count >= WM_MAX_WINDOWS { return 0 - 1; }
    let id = wm_window_count;
    wm_window_count = wm_window_count + 1;
    let addr = WM_TABLE_ADDR + id * 128;
    mem_write_u64(addr, id);
    mem_write_u64(addr+8, x);
    mem_write_u64(addr+16, y);
    mem_write_u64(addr+24, w);
    mem_write_u64(addr+32, h);
    mem_write_u64(addr+40, id);  // z = creation order
    mem_write_u64(addr+48, wm_make_flags(1, 0, 0));
    mem_write_u64(addr+56, 0);
    wm_titles[id] = title;
    mem_write_u64(addr+72, owner);
    mem_write_u64(addr+80, 1);  // dirty
    wm_focus_window(id);
    return id;
}

fn wm_draw_window(win_id) {
    let addr = WM_TABLE_ADDR + win_id * 128;
    let x = mem_read_u64(addr+8);
    let y = mem_read_u64(addr+16);
    let w = mem_read_u64(addr+24);
    let h = mem_read_u64(addr+32);
    let flags = mem_read_u64(addr+48);
    let title_h = ui_theme_title_height();

    if wm_is_visible(flags) == 0 { return 0; }
    if wm_is_minimized(flags) == 1 { return 0; }

    // Shadow
    vesa_fill_rect(x + ui_theme_shadow_offset(), y + ui_theme_shadow_offset(), w, h + title_h, ui_theme_shadow_color());

    // Title bar
    let mut title_color = ui_theme_titlebar_color();
    if win_id == wm_focused_id { title_color = ui_theme_titlebar_active_color(); }
    vesa_fill_rect(x, y, w, title_h, title_color);

    // Title text
    let t_str = wm_get_title(win_id);
    let t_ty = y + (title_h - 16) / 2;
    let max_chars = (w - 48) / 8;
    if max_chars > 0 {
        let mut draw_str = t_str;
        if len(draw_str) > max_chars { draw_str = substr(draw_str, 0, max_chars); }
        ui_draw_text(x + 6, t_ty, draw_str, ui_theme_surface_color(), 0);
    }

    // Minimize button (accent square next to close)
    vesa_fill_rect(x + w - 38, y + 2, 16, 16, ui_theme_accent_color());

    // Close button (red square at top-right)
    vesa_fill_rect(x + w - 18, y + 2, 16, 16, ui_theme_error_color());

    // Border
    vesa_rect(x, y, w, h + title_h, ui_theme_border_color());

    // Content area
    vesa_fill_rect(x + 1, y + title_h, w - 2, h - 1, ui_theme_surface_color());

    return 0;
}

fn wm_draw_all() {
    vesa_clear(ui_theme_desktop_color());
    if uidsk_initialized == 1 {
        uidsk_draw_chrome();
    } else {
        wm_draw_desktop_chrome();
    }
    // Draw windows from lowest z to highest z
    let mut z = 0;
    while z < wm_window_count {
        let mut i = 0;
        while i < wm_window_count {
            let addr = WM_TABLE_ADDR + i * 128;
            if mem_read_u64(addr+40) == z { wm_draw_window(i); }
            i = i + 1;
        }
        z = z + 1;
    }
    // Render UI terminal content if open
    if uiterm_is_open() == 1 { uiterm_render(); }
    // Render UI installer content if open
    if uiinst_is_open() == 1 { uiinst_render(); }
    // Render system monitor if open
    if uismon_is_open() == 1 { uismon_render(); }
    // Render file manager if open
    if uifiles_is_open() == 1 { uifiles_render(); }
    // Render settings center if open
    if uisettings_is_open() == 1 { uisettings_render(); }
    // Render text editor if open
    if uitxed_is_open() == 1 { uitxed_update(); }
    // Render calculator if open
    if uicalc_is_open() == 1 { uicalc_draw(); }
    // Render paint app if open
    if uipaint_is_open() == 1 { uipaint_draw(); }
    // Render browser if open
    if uibrowse_is_open() == 1 { uibrowse_draw(); }
    // Render image viewer if open
    if uiimg_is_open() == 1 { uiimg_draw(); }
    // Render hex editor if open
    if hexed_is_open() == 1 { hexed_draw(); }
    // Render calendar if open
    if uical_is_open() == 1 { uical_draw(); }
    // Render clock widget if open
    if uiclock_is_open == 1 { uiclock_draw(); uiclock_tick(); }
    // Render task manager if open
    if uitaskman_is_open() == 1 { uitaskman_draw(); uitaskman_tick(); }
    // Render notepad if open
    if notepad_is_open() == 1 { notepad_draw(); }
    // Toast notifications
    ui_notify_render();
    // Modal dialog overlay
    if ui_dialog_is_open() == 1 { ui_dialog_render(); }
    // Draw mouse cursor on top
    wm_draw_cursor(wm_mouse_x, wm_mouse_y);
    // Push GPU-backed framebuffer to display if VirtIO-GPU is active
    if gpu_initialized == 1 { gpu_flip(); }
    return 0;
}

fn wm_draw_cursor(x, y) {
    // Simple 8x8 arrow cursor
    vesa_fill_rect(x, y, 2, 8, VESA_WHITE);
    vesa_fill_rect(x, y, 8, 2, VESA_WHITE);
    vesa_putpixel(x+1, y+1, VESA_BLACK);
    vesa_putpixel(x+2, y+2, VESA_BLACK);
    vesa_putpixel(x+3, y+3, VESA_BLACK);
    vesa_putpixel(x+4, y+4, VESA_BLACK);
    return 0;
}

// Handle mouse movement
fn wm_mouse_move(dx, dy) {
    wm_mouse_x = wm_mouse_x + dx;
    wm_mouse_y = wm_mouse_y + dy;
    // Clamp to screen
    if wm_mouse_x < 0 { wm_mouse_x = 0; }
    if wm_mouse_y < 0 { wm_mouse_y = 0; }
    if wm_mouse_x >= vesa_width { wm_mouse_x = vesa_width - 1; }
    if wm_mouse_y >= vesa_height { wm_mouse_y = vesa_height - 1; }

    if wm_dragging == 1 {
        let addr = WM_TABLE_ADDR + wm_drag_win * 128;
        let ww = mem_read_u64(addr + 24);
        let wh = mem_read_u64(addr + 32) + ui_theme_title_height();
        let mut nx = wm_mouse_x - wm_drag_off_x;
        let mut ny = wm_mouse_y - wm_drag_off_y;
        let min_y = ui_theme_topbar_height();
        let max_x = vesa_width - ww;
        let max_y = vesa_height - ui_theme_dock_height() - wh;
        if nx < 0 { nx = 0; }
        if ny < min_y { ny = min_y; }
        if nx > max_x { nx = max_x; }
        if ny > max_y { ny = max_y; }
        wm_move_window(wm_drag_win, nx, ny);
    }
    // Paint: forward mouse move while pressing
    if uipaint_is_open() == 1 {
        uipaint_mouse_move(wm_mouse_x, wm_mouse_y);
    }
    return 0;
}

// Handle mouse button press at current position
fn wm_mouse_click(button) {
    if button == 0 { // left click release
        wm_dragging = 0;
        return 0;
    }

    // Find topmost window under cursor (highest z first)
    let mut best = 0 - 1;
    let mut best_z = 0 - 1;
    let mut i = 0;
    while i < wm_window_count {
        let addr = WM_TABLE_ADDR + i * 128;
        let wz = mem_read_u64(addr+40);
        if wm_hit_test_window(i, wm_mouse_x, wm_mouse_y) == 1 {
            if wz > best_z {
                best_z = wz;
                best = i;
            }
        }
        i = i + 1;
    }

    // Dialog intercepts all clicks when open
    if ui_dialog_is_open() == 1 {
        ui_dialog_click(wm_mouse_x, wm_mouse_y);
        return 0;
    }
    // Desktop app launcher
    if uidsk_initialized == 1 {
        if uidsk_handle_click(wm_mouse_x, wm_mouse_y) == 1 { return 0; }
    }
    // Check taskbar click
    let dock_win = wm_hit_test_taskbar(wm_mouse_x, wm_mouse_y);
    if dock_win >= 0 {
        let addr = WM_TABLE_ADDR + dock_win * 128;
        let flags = mem_read_u64(addr + 48);
        if wm_is_minimized(flags) == 1 {
            wm_restore_window(dock_win);
        } else {
            if dock_win == wm_focused_id {
                wm_minimize_window(dock_win);
            } else {
                wm_focus_window(dock_win);
            }
        }
        return 0;
    }

    if best >= 0 {
        wm_focus_window(best);
        if wm_hit_test_close(best, wm_mouse_x, wm_mouse_y) == 1 {
            wm_close_window(best);
            return 0;
        }
        if wm_hit_test_minimize(best, wm_mouse_x, wm_mouse_y) == 1 {
            wm_minimize_window(best);
            return 0;
        }
        if wm_hit_test_titlebar(best, wm_mouse_x, wm_mouse_y) == 1 {
            let addr = WM_TABLE_ADDR + best * 128;
            wm_dragging = 1;
            wm_drag_win = best;
            wm_drag_off_x = wm_mouse_x - mem_read_u64(addr + 8);
            wm_drag_off_y = wm_mouse_y - mem_read_u64(addr + 16);
            return 0;
        }
        // Route content area clicks to app modules
        if uiinst_is_open() == 1 {
            if best == uiinst_win_id {
                uiinst_handle_click(wm_mouse_x, wm_mouse_y);
                return 0;
            }
        }
        if uisettings_is_open() == 1 {
            if best == uisettings_win_id {
                uisettings_handle_click(wm_mouse_x, wm_mouse_y);
                return 0;
            }
        }
        // Calculator click routing
        if uicalc_is_open() == 1 {
            if uicalc_click(wm_mouse_x, wm_mouse_y) == 1 { return 0; }
        }
        // Paint app click routing
        if uipaint_is_open() == 1 {
            if uipaint_mouse_press(wm_mouse_x, wm_mouse_y) == 1 { return 0; }
        }
        // Browser click routing
        if uibrowse_is_open() == 1 {
            if uibrowse_click(wm_mouse_x, wm_mouse_y) == 1 { return 0; }
        }
        // Image viewer click routing
        if uiimg_is_open() == 1 {
            if uiimg_click(wm_mouse_x, wm_mouse_y) == 1 { return 0; }
        }
        // Hex editor click routing
        if hexed_is_open() == 1 {
            if hexed_click(wm_mouse_x, wm_mouse_y) == 1 { return 0; }
        }
        // Calendar click routing
        if uical_is_open() == 1 {
            if uical_click(wm_mouse_x, wm_mouse_y) == 1 { return 0; }
        }
        // Clock click routing
        if uiclock_is_open == 1 {
            uiclock_click(wm_mouse_x, wm_mouse_y);
        }
        // Task manager click routing
        if uitaskman_is_open() == 1 {
            uitaskman_click(wm_mouse_x, wm_mouse_y);
        }
        // Notepad click routing
        if notepad_is_open() == 1 {
            notepad_click(wm_mouse_x, wm_mouse_y);
        }
    }
    return 0;
}

fn wm_close_window(win_id) {
    if win_id < 0 { return 0; }
    if win_id >= wm_window_count { return 0; }
    let addr = WM_TABLE_ADDR + win_id * 128;
    mem_write_u64(addr + 48, 0);  // clear flags = invisible
    mem_write_u64(addr + 80, 1);
    if wm_drag_win == win_id {
        wm_dragging = 0;
        wm_drag_win = 0;
    }
    if wm_focused_id == win_id {
        let next = wm_find_top_visible();
        if next >= 0 {
            wm_focus_window(next);
        }
    }
    return 0;
}

fn wm_move_window(win_id, new_x, new_y) {
    if win_id < 0 { return 0 - 1; }
    if win_id >= wm_window_count { return 0 - 1; }
    let addr = WM_TABLE_ADDR + win_id * 128;
    mem_write_u64(addr + 8, new_x);
    mem_write_u64(addr + 16, new_y);
    mem_write_u64(addr + 80, 1);  // mark dirty
    return 0;
}

fn wm_resize_window(win_id, new_w, new_h) {
    if win_id < 0 { return 0 - 1; }
    if win_id >= wm_window_count { return 0 - 1; }
    let addr = WM_TABLE_ADDR + win_id * 128;
    mem_write_u64(addr + 24, new_w);
    mem_write_u64(addr + 32, new_h);
    mem_write_u64(addr + 80, 1);  // mark dirty
    return 0;
}

fn wm_get_focused() {
    return wm_focused_id;
}

fn wm_get_window_count() {
    return wm_window_count;
}

// Window coordinate accessors used by UI modules for rendering
fn wm_win_x(win_id) {
    if win_id < 0 { return 0; }
    if win_id >= wm_window_count { return 0; }
    return mem_read_u64(WM_TABLE_ADDR + win_id * 128 + 8);
}

fn wm_win_y(win_id) {
    if win_id < 0 { return 0; }
    if win_id >= wm_window_count { return 0; }
    return mem_read_u64(WM_TABLE_ADDR + win_id * 128 + 16);
}

fn wm_win_w(win_id) {
    if win_id < 0 { return 0; }
    if win_id >= wm_window_count { return 0; }
    return mem_read_u64(WM_TABLE_ADDR + win_id * 128 + 24);
}

fn wm_win_h(win_id) {
    if win_id < 0 { return 0; }
    if win_id >= wm_window_count { return 0; }
    return mem_read_u64(WM_TABLE_ADDR + win_id * 128 + 32);
}

// Destroy a window — alias for wm_close_window (for semantic clarity)
fn wm_destroy_window(win_id) {
    wm_close_window(win_id);
    return 0;
}

// Route a keyboard scancode to the currently focused UI module
fn wm_key_dispatch(key) {
    // Focused overlay modules get priority
    if ui_dialog_is_open() == 1 {
        ui_dialog_key(key);
        return 0;
    }
    if uismon_is_open() == 1 {
        if wm_focused_id == uismon_win_id {
            uismon_handle_key(key);
            return 0;
        }
    }
    if uifiles_is_open() == 1 {
        if wm_focused_id == uifiles_win_id {
            uifiles_handle_key(key);
            return 0;
        }
    }
    if uisettings_is_open() == 1 {
        if wm_focused_id == uisettings_win_id {
            uisettings_handle_key(key);
            return 0;
        }
    }
    if uitxed_is_open() == 1 {
        if wm_focused_id == uitxed_window_id {
            uitxed_handle_key(key);
            return 0;
        }
    }
    if uicalc_is_open() == 1 {
        if uicalc_key(key) == 1 { return 0; }
    }
    if uipaint_is_open() == 1 {
        if uipaint_key(key) == 1 { return 0; }
    }
    if uibrowse_is_open() == 1 {
        if uibrowse_key(key) == 1 { return 0; }
    }
    if uiimg_is_open() == 1 {
        if uiimg_key(key) == 1 { return 0; }
    }
    if hexed_is_open() == 1 {
        if hexed_key(key) == 1 { return 0; }
    }
    if uical_is_open() == 1 {
        if uical_key(key) == 1 { return 0; }
    }
    if uiclock_is_open == 1 {
        uiclock_key(key);
    }
    if uitaskman_is_open() == 1 {
        uitaskman_key(key);
    }
    if notepad_is_open() == 1 {
        if wm_focused_id == notep_win_id { notepad_key(key); }
    }
    if uiterm_is_open() == 1 {
        if wm_focused_id == uiterm_win_id {
            uiterm_handle_key(key);
            return 0;
        }
    }
    if uiinst_is_open() == 1 {
        uiinst_handle_key(key);
        return 0;
    }
    return 0;
}

fn wm_render_all() {
    wm_draw_all();
    return 0;
}

// Open default terminal window at boot (positioned after topbar)
fn wm_open_terminal_window() {
    let top_h = ui_theme_topbar_height();
    let margin = 20;
    let w = 640;
    let h = 400;
    let win_id = wm_create_window(margin, top_h + margin, w, h, "Terminal", 0);
    if win_id >= 0 {
        uiterm_open(win_id);
        wm_render_all();
    }
    return win_id;
}

print("wm.hl loaded");
print("Window manager: topbar + taskbar + minimize/restore + focus + drag + close + key dispatch");
