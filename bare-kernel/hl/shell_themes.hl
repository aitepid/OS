// shell_themes.hl -- 4 套主题 + 配色映射（Sprint G8）
//
// 主题名：Default / Light / Dark / Sepia
//   Default = Win11 Fluent 默认（蓝色强调，浅灰底）
//   Light   = 极简白底，#0078D4 强调
//   Dark    = 深灰底，强调色亮蓝
//   Sepia   = 暖色护眼，米黄底
//
// 每个主题对应壁纸主题（shell_wallpaper 已有 4 个内置渐变）。

let THEME_DEFAULT = 0;
let THEME_LIGHT   = 1;
let THEME_DARK    = 2;
let THEME_SEPIA   = 3;

let mut themes_initialized = 0;
let mut themes_current     = 0;

fn shell_themes_init() {
    if themes_initialized == 1 { return 0; }
    themes_current = THEME_DEFAULT;
    shell_themes_apply(themes_current);
    themes_initialized = 1;
    print("shell_themes: 4 themes ready");
    return 0;
}

fn shell_themes_current() { return themes_current; }

fn shell_themes_name(i) {
    if i == THEME_DEFAULT { return "Default"; }
    if i == THEME_LIGHT   { return "Light"; }
    if i == THEME_DARK    { return "Dark"; }
    return "Sepia";
}

fn shell_themes_apply(theme) {
    themes_current = theme;
    if theme == THEME_DEFAULT {
        ui_theme_set_accent(0x0078D4);
        shell_wallpaper_set(WP_THEME_AURORA);
    }
    if theme == THEME_LIGHT {
        ui_theme_set_accent(0x0078D4);
        shell_wallpaper_set(WP_THEME_AURORA);
    }
    if theme == THEME_DARK {
        ui_theme_set_accent(gfx_pack(255, 80, 160, 255));
        shell_wallpaper_set(WP_THEME_MONO);
    }
    if theme == THEME_SEPIA {
        ui_theme_set_accent(gfx_pack(255, 180, 130, 60));
        shell_wallpaper_set(WP_THEME_SUNSET);
        eyecare_set_color_temp(5000);
        eyecare_set_enabled(1);
    }
    return 0;
}

fn shell_themes_cycle() {
    let mut nxt = themes_current + 1;
    if nxt > THEME_SEPIA { nxt = THEME_DEFAULT; }
    return shell_themes_apply(nxt);
}

print("shell_themes.hl loaded");
