// errno.hl -- POSIX Error Codes
//
// Standard error numbers used by syscalls, VFS, network, and IPC.
// Every function that can fail returns a negative errno value.
// User code checks: if result < 0 { let err = 0 - result; ... }
//
// Numbering follows Linux convention for x86_64.

let EPERM   = 1;    // Operation not permitted
let ENOENT  = 2;    // No such file or directory
let ESRCH   = 3;    // No such process
let EINTR   = 4;    // Interrupted system call
let EIO     = 5;    // I/O error
let ENXIO   = 6;    // No such device or address
let E2BIG   = 7;    // Argument list too long
let ENOEXEC = 8;    // Exec format error
let EBADF   = 9;    // Bad file descriptor
let ECHILD  = 10;   // No child processes
let EAGAIN  = 11;   // Try again (also EWOULDBLOCK)
let ENOMEM  = 12;   // Out of memory
let EACCES  = 13;   // Permission denied
let EFAULT  = 14;   // Bad address
let EBUSY   = 16;   // Device or resource busy
let EEXIST  = 17;   // File exists
let EXDEV   = 18;   // Cross-device link
let ENODEV  = 19;   // No such device
let ENOTDIR = 20;   // Not a directory
let EISDIR  = 21;   // Is a directory
let EINVAL  = 22;   // Invalid argument
let ENFILE  = 23;   // File table overflow
let EMFILE  = 24;   // Too many open files
let ENOTTY  = 25;   // Not a typewriter
let EFBIG   = 27;   // File too large
let ENOSPC  = 28;   // No space left on device
let ESPIPE  = 29;   // Illegal seek
let EROFS   = 30;   // Read-only file system
let EMLINK  = 31;   // Too many links
let EPIPE   = 32;   // Broken pipe
let EDOM    = 33;   // Math argument out of domain
let ERANGE  = 34;   // Math result not representable
let EDEADLK = 35;   // Resource deadlock would occur
let ENAMETOOLONG = 36; // File name too long
let ENOSYS  = 38;   // Function not implemented
let ENOTEMPTY = 39;  // Directory not empty
let ELOOP   = 40;   // Too many symbolic links
let EWOULDBLOCK = 11; // Same as EAGAIN

// Network errors
let ENOTSOCK     = 88;   // Socket operation on non-socket
let EMSGSIZE     = 90;   // Message too long
let EPROTOTYPE   = 91;   // Protocol wrong type for socket
let ENOPROTOOPT  = 92;   // Protocol not available
let EPROTONOSUPPORT = 93; // Protocol not supported
let EAFNOSUPPORT = 97;   // Address family not supported
let EADDRINUSE   = 98;   // Address already in use
let EADDRNOTAVAIL = 99;  // Cannot assign requested address
let ENETDOWN     = 100;  // Network is down
let ENETUNREACH  = 101;  // Network is unreachable
let ECONNABORTED = 103;  // Connection aborted
let ECONNRESET   = 104;  // Connection reset by peer
let ENOBUFS      = 105;  // No buffer space available
let EISCONN      = 106;  // Transport endpoint is connected
let ENOTCONN     = 107;  // Transport endpoint is not connected
let ETIMEDOUT    = 110;  // Connection timed out
let ECONNREFUSED = 111;  // Connection refused
let EHOSTUNREACH = 113;  // No route to host
let EALREADY     = 114;  // Operation already in progress
let EINPROGRESS  = 115;  // Operation now in progress

// Convert errno to string name
fn errno_name(e) {
    if e == EPERM { return "EPERM"; }
    if e == ENOENT { return "ENOENT"; }
    if e == ESRCH { return "ESRCH"; }
    if e == EIO { return "EIO"; }
    if e == EBADF { return "EBADF"; }
    if e == EAGAIN { return "EAGAIN"; }
    if e == ENOMEM { return "ENOMEM"; }
    if e == EACCES { return "EACCES"; }
    if e == EFAULT { return "EFAULT"; }
    if e == EEXIST { return "EEXIST"; }
    if e == ENODEV { return "ENODEV"; }
    if e == EINVAL { return "EINVAL"; }
    if e == EMFILE { return "EMFILE"; }
    if e == ENOSPC { return "ENOSPC"; }
    if e == EPIPE { return "EPIPE"; }
    if e == ENOSYS { return "ENOSYS"; }
    if e == ECONNRESET { return "ECONNRESET"; }
    if e == ECONNREFUSED { return "ECONNREFUSED"; }
    if e == ETIMEDOUT { return "ETIMEDOUT"; }
    return "E" + to_string(e);
}

// Convert errno to human-readable message
fn errno_msg(e) {
    if e == EPERM { return "Operation not permitted"; }
    if e == ENOENT { return "No such file or directory"; }
    if e == EIO { return "I/O error"; }
    if e == EBADF { return "Bad file descriptor"; }
    if e == EAGAIN { return "Resource temporarily unavailable"; }
    if e == ENOMEM { return "Out of memory"; }
    if e == EACCES { return "Permission denied"; }
    if e == EEXIST { return "File exists"; }
    if e == EINVAL { return "Invalid argument"; }
    if e == EMFILE { return "Too many open files"; }
    if e == ENOSPC { return "No space left on device"; }
    if e == EPIPE { return "Broken pipe"; }
    if e == ENOSYS { return "Function not implemented"; }
    if e == ECONNRESET { return "Connection reset"; }
    if e == ECONNREFUSED { return "Connection refused"; }
    if e == ETIMEDOUT { return "Connection timed out"; }
    return "Unknown error " + to_string(e);
}

print("errno.hl loaded: POSIX error codes");
