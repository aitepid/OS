// benchmark.hl -- Pure H-L minimal benchmark

fn benchmark_run(iterations) {
    let mut i = 0;
    let mut sum = 0;
    while i < iterations {
        sum = sum + i;
        i = i + 1;
    }
    print("benchmark iterations=" + to_string(iterations) + " checksum=" + to_string(sum));
    return sum;
}

benchmark_run(1000);
