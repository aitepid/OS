// HicOS_ProcessManager.hl -- Process Manager (Native H-L)
//
// User-space process management interface.
// Delegates to bare-kernel/hl/task.hl, posix.hl, hlc_loader.hl.

fn hicos_proc_init() {
    print("HicOS process manager initialized");
    return 0;
}

fn hicos_proc_spawn(path) {
    // Load .hlc executable and create new process
    let pid = hlc_exec(path);
    if pid < 0 {
        print("proc: failed to spawn " + path);
        return 0 - 1;
    }
    print("proc: spawned PID " + to_string(pid) + " from " + path);
    return pid;
}

fn hicos_proc_fork() {
    return sys_fork();
}

fn hicos_proc_exec(path) {
    return sys_exec(path);
}

fn hicos_proc_wait(pid) {
    return sys_wait(pid);
}

fn hicos_proc_kill(pid, sig) {
    return signal_send(pid, sig);
}

fn hicos_proc_list() {
    task_list();
    return task_count();
}

fn hicos_proc_info(pid) {
    task_info(pid);
    return 0;
}

fn hicos_proc_count() {
    return task_count();
}

fn hicos_proc_current_pid() {
    return current_task;
}

print("HicOS_ProcessManager.hl loaded (native H-L)");



