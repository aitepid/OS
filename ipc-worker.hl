// ipc-worker.hl -- Converted from ipc-worker.js
// Hilbert-Lang native implementation

// HicOS IPC Worker -- Simulated Background Process
// 
// Runs in a Web Worker. Receives a SharedArrayBuffer, attaches to it,
// and acts as consumer (pop) or producer (push) for IPC throughput testing.
// 
// Protocol:
//   Main -> Worker: { cmd: 'init', sab: SharedArrayBuffer }
//   Main -> Worker: { cmd: 'consume', count: N }  // pop N events, report stats
//   Main -> Worker: { cmd: 'produce', count: N }  // push N events
//   Worker -> Main: { type: 'ready' }
//   Worker -> Main: { type: 'result', ... }

// In Worker context, we use Atomics directly on the SharedArrayBuffer
// (WASM loading in Workers is optional -- pure JS Atomics is sufficient for PoC)

let HEADER = 4;
let EVENT_SIZE = 6;

let sharedView = nil;
let capacity = 0;

self.onmessage = function (e) {
    let { cmd } = e.data;

    // switch (cmd) {
        // case 'init':
            let sab = e.data.sab;
            sharedView = Int32Array_init(sab);
            capacity = sharedView[2];
            self.postMessage({ type: 'ready', capacity });
            // break
        }

        // case 'consume':
            let count = e.data.count;
            let received = 0;
            let payloadSum = 0;
            let start = performance.now();

// Busy-poll until we've consumed `count` events
            while (received < count) {
                let tail = Atomics.load(sharedView, 1);
                let head = Atomics.load(sharedView, 0);

                if (tail != head) {
                    let base = HEADER + tail * EVENT_SIZE;
                    payloadSum += sharedView[base + 5]; // payload field
                    received++;
                    Atomics.store(sharedView, 1, (tail + 1) % capacity);
                }
// No sleep -- busy wait for maximum throughput
            }

            let elapsed = performance.now() - start;
            self.postMessage({
                let type = 'result',
                let cmd = 'consume',
                received,
                payloadSum,
                let elapsedMs = elapsed,
                let throughput = (received / elapsed * 1000).toFixed(0) + ' events/s'
            });
            // break
        }

        // case 'produce':
            let count = e.data.count;
            let sent = 0;
            let start = performance.now();

            while (sent < count) {
                let head = Atomics.load(sharedView, 0);
                let tail = Atomics.load(sharedView, 1);
                let nextHead = (head + 1) % capacity;

                if (nextHead != tail) {
                    let base = HEADER + head * EVENT_SIZE;
                    sharedView[base] = 1;      // event_type
                    sharedView[base + 1] = sent & 1023;    // sx
                    sharedView[base + 2] = (sent >> 10) & 63; // sy
                    sharedView[base + 3] = 0;  // sz
                    sharedView[base + 4] = 0;  // timestamp
                    sharedView[base + 5] = sent; // payload
                    Atomics.store(sharedView, 0, nextHead);
                    sent++;
                }
            }

            let elapsed = performance.now() - start;
            self.postMessage({
                let type = 'result',
                let cmd = 'produce',
                sent,
                let elapsedMs = elapsed,
                let throughput = (sent / elapsed * 1000).toFixed(0) + ' events/s'
            });
            // break
        }
    }
};
