// HicOS_WindowManager.hl -- Window Manager (Native H-L)
//
// User-space window management interface.
// Delegates to bare-kernel/hl/wm.hl for actual framebuffer operations.
// Provides higher-level window lifecycle and event routing.

fn hicos_wm_init() {
    wm_init();
    print("HicOS WindowManager initialized");
    return 0;
}

fn hicos_wm_create(x, y, w, h, title) {
    let id = wm_create_window(x, y, w, h, title, 0);
    return id;
}

fn hicos_wm_close(win_id) {
    wm_close_window(win_id);
    return 0;
}

fn hicos_wm_move(win_id, new_x, new_y) {
    wm_move_window(win_id, new_x, new_y);
    return 0;
}

fn hicos_wm_resize(win_id, new_w, new_h) {
    wm_resize_window(win_id, new_w, new_h);
    return 0;
}

fn hicos_wm_focus(win_id) {
    wm_focus_window(win_id);
    return 0;
}

fn hicos_wm_draw_all() {
    wm_draw_all();
    return 0;
}

fn hicos_wm_handle_mouse(dx, dy) {
    wm_mouse_move(dx, dy);
    return 0;
}

fn hicos_wm_handle_click(button) {
    wm_mouse_click(button);
    return 0;
}

fn hicos_wm_get_focused() {
    return wm_get_focused();
}

fn hicos_wm_count() {
    return wm_get_window_count();
}

print("HicOS_WindowManager.hl loaded (native H-L)");
