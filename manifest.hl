// manifest.hl -- HicOS Project Manifest (replaces package.json + hl-manifest.json)
//
// Pure H-L project descriptor. No JSON, no npm, no external tooling.
// This file is the single source of truth for project metadata.
// Post-iteration-120 sync: metadata aligned to current repo state.

let HICOS_VERSION = "6.0";
let HICOS_NAME = "HicOS";
let HICOS_LANG = "Hilbert-Lang (H-L)";
let HICOS_DESC = "100% pure H-L bare-metal x86_64 OS. Self-hosting. Zero external deps.";

// Source statistics
let KERNEL_MODULES = 130;
let HL_FILES = 198;
let SHELL_COMMANDS = 68;
let KERNEL_FUNCTIONS = 1700;
let HL_TOTAL_LINES = 46499;
let JS_FILES = 0;
let RS_FILES = 0;
let JSON_FILES = 0;
let EXTERNAL_DEPS = 0;

// Bootstrap
let BOOTSTRAP_SOURCE = "hl-bootstrap.hl";
let BOOTSTRAP_BINARY = "hicos-hl.img";
let BOOT_IMAGE_BYTES = 162816;
let BOOT_SIGNATURE = 0x55AA;
let SELF_HOSTING = 1;

// Build commands (interpreted by hl-bootstrap)
let CMD_BOOT = "qemu-system-x86_64 -drive format=raw,file=hicos-hl.img -serial stdio -display none";
let CMD_TEST = "hl-bootstrap bare-kernel/hl/test-runner.hl";
let CMD_BUILD = "hl-bootstrap bare-kernel/hl/build.hl";
let CMD_LINT = "hl-bootstrap bare-kernel/hl/lint.hl";

// Compiler pipeline
let COMPILER_BACKEND = "native x86_64";
let X86_INSTRUCTIONS = 126;
let IR_OPCODES = 37;
let REGALLOC = "linear-scan (14 GP regs)";
let ABI = "System V AMD64";

fn manifest_print() {
    print(HICOS_NAME + " v" + HICOS_VERSION);
    print(HICOS_DESC);
    print("");
    print("Kernel modules:  " + to_string(KERNEL_MODULES));
    print("H-L files:       " + to_string(HL_FILES));
    print("Shell commands:  " + to_string(SHELL_COMMANDS));
    print("Boot image:      " + BOOTSTRAP_BINARY + " (" + to_string(BOOT_IMAGE_BYTES) + " bytes)");
    print("External deps:   " + to_string(EXTERNAL_DEPS));
    print("Self-hosting:    yes");
    print("Backend:         " + COMPILER_BACKEND);
    print("x86 encoder:     " + to_string(X86_INSTRUCTIONS) + " instructions");
    print("IR opcodes:      " + to_string(IR_OPCODES));
    print("Regalloc:        " + REGALLOC);
    print("ABI:             " + ABI);
    return 0;
}

print("manifest.hl loaded");
