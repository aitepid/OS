// HicOS_Test.hl -- Pure H-L minimal test harness

let TEST_TOTAL = 0;
let TEST_PASS = 0;
let TEST_FAIL = 0;

fn test_assert(name, cond) {
    TEST_TOTAL = TEST_TOTAL + 1;
    if cond {
        TEST_PASS = TEST_PASS + 1;
        print("[ok] " + name);
        return 1;
    }
    TEST_FAIL = TEST_FAIL + 1;
    print("[fail] " + name);
    return 0;
}

fn test_summary() {
    print("tests=" + to_string(TEST_TOTAL) + " pass=" + to_string(TEST_PASS) + " fail=" + to_string(TEST_FAIL));
    return TEST_FAIL;
}

fn run_smoke_tests() {
    test_assert("math.add", 1 + 1 == 2);
    test_assert("string.concat", "hi" + "cos" == "hicos");
    return test_summary();
}

run_smoke_tests();


