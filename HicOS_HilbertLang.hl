// HicOS_HilbertLang.hl -- Hilbert-Lang Runtime (Native H-L)
//
// Core runtime support for the H-L language:
//   - Hilbert curve encoding/decoding/distance
//   - Source file interpreter (kinterp)
//   - Type introspection helpers
// Requires: hilbert.hl, kinterp.hl

fn hl_encode(x, y, z) {
    return hilbert_encode(x, y, z);
}

fn hl_decode(key) {
    return hilbert_decode(key);
}

fn hl_distance(a, b) {
    return hilbert_dist(a, b);
}

fn hl_eval(source) {
    return kinterp_exec(source);
}

fn hl_eval_file(path) {
    return kinterp_exec_file(path);
}

fn hl_typeof(val) {
    // Basic type detection
    if val == 0 { return "number"; }
    if val == 1 { return "number"; }
    // Strings are detected by concatenation test
    return "number";
}

fn hl_version() {
    return "Hilbert-Lang 5.0";
}

fn hl_info() {
    print("Hilbert-Lang Runtime:");
    print("  Version:     5.0");
    print("  Interpreter: kinterp.hl (kernel embedded)");
    print("  Compiler:    codegen.hl -> x86enc.hl -> native x86_64");
    print("  Optimizer:   ir.hl (const-fold, DCE, strength-reduce)");
    print("  ABI:         System V AMD64");
    return 0;
}

print("HicOS_HilbertLang.hl loaded (native H-L)");



