// HicOS_Desktop.hl -- Pure H-L minimal desktop manager

let NEXT_WINDOW_ID = 1;
let WINDOW_COUNT = 0;

fn desktop_init() {
    print("HicOS_Desktop initialized");
    return 0;
}

fn desktop_create_window(title, width, height) {
    let id = NEXT_WINDOW_ID;
    NEXT_WINDOW_ID = NEXT_WINDOW_ID + 1;
    WINDOW_COUNT = WINDOW_COUNT + 1;
    print("window[" + to_string(id) + "] " + title + " " + to_string(width) + "x" + to_string(height));
    return id;
}

fn desktop_close_window(id) {
    if WINDOW_COUNT > 0 {
        WINDOW_COUNT = WINDOW_COUNT - 1;
    }
    print("window[" + to_string(id) + "] closed");
    return 0;
}

fn desktop_stats() {
    print("windows=" + to_string(WINDOW_COUNT));
    return WINDOW_COUNT;
}

desktop_init();


