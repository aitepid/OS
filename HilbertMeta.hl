// HilbertMeta.hl -- Pure H-L Hilbert metadata utilities

fn hilbert_encode3(x, y, z) {
    return x * 1048576 + y * 1024 + z;
}

fn hilbert_decode3(key) {
    let x = key / 1048576;
    let y = (key / 1024) % 1024;
    let z = key % 1024;
    print("decode=" + to_string(x) + "," + to_string(y) + "," + to_string(z));
    return key;
}

fn hilbert_dist3(a, b) {
    if a >= b {
        return a - b;
    }
    return b - a;
}

fn hilbert_meta_selftest() {
    let k1 = hilbert_encode3(1, 2, 3);
    let k2 = hilbert_encode3(2, 2, 3);
    let d = hilbert_dist3(k1, k2);
    print("hilbert-meta selftest distance=" + to_string(d));
    return 0;
}

hilbert_meta_selftest();