// HicOS_Kernel.hl -- Kernel API Facade (Native H-L)
//
// Provides a unified user-space interface to kernel subsystems.
// Entry point: bare-kernel/hl/kernel_entry.hl → kernel_init.hl

fn hicos_kernel_info() {
    print("HicOS 5.0 Kernel");
    print("  Arch:    x86_64 long mode");
    print("  Modules: 112 (bare-kernel/hl/)");
    print("  Lang:    Hilbert-Lang (H-L)");
    print("  Image:   hicos-hl.img (6144 bytes)");
    return 0;
}

fn hicos_kernel_uptime() {
    let ticks = get_ticks();
    let seconds = ticks / 100; // PIT at 100Hz
    let minutes = seconds / 60;
    print("Uptime: " + to_string(minutes) + "m " + to_string(seconds % 60) + "s (" + to_string(ticks) + " ticks)");
    return seconds;
}

fn hicos_kernel_mem_info() {
    let free_pages = page_count_free();
    let total_pages = page_alloc_total_count();
    let used = total_pages - free_pages;
    print("Memory:");
    print("  Total: " + to_string(total_pages * 4) + " KB (" + to_string(total_pages) + " pages)");
    print("  Used:  " + to_string(used * 4) + " KB");
    print("  Free:  " + to_string(free_pages * 4) + " KB");
    return free_pages;
}

fn hicos_kernel_cpu_info() {
    print("CPU:");
    print("  Cores:     " + to_string(smp_cpu_count));
    print("  Scheduler: CFS");
    print("  Tasks:     " + to_string(task_count()));
    return smp_cpu_count;
}

fn hicos_kernel_irq_info() {
    print("Interrupts:");
    print("  IDT:   256 vectors");
    print("  PIC:   8259A cascaded");
    print("  LAPIC: per-CPU");
    print("  Timer: PIT IRQ0 (100Hz)");
    print("  KBD:   PS/2 IRQ1");
    print("  Mouse: PS/2 IRQ12");
    return 0;
}

fn hicos_kernel_panic(msg) {
    print("=== KERNEL PANIC ===");
    print(msg);
    print("System halted.");
    panic_halt();
    return 0;
}

fn hicos_kernel_version() {
    return "5.0";
}

print("HicOS_Kernel.hl loaded (native H-L)");


