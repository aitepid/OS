// HicOS_VirtualDesktop.hl -- Pure H-L minimal virtual desktop manager

let VD_READY = 0;
let VD_COUNT = 1;
let VD_ACTIVE = 1;

fn virtual_desktop_init() {
    VD_READY = 1;
    print("virtual-desktop: initialized");
    return 0;
}

fn virtual_desktop_create() {
    if VD_READY == 0 { return -1; }
    VD_COUNT = VD_COUNT + 1;
    return VD_COUNT;
}

fn virtual_desktop_switch(id) {
    if id > 0 && id <= VD_COUNT {
        VD_ACTIVE = id;
        return VD_ACTIVE;
    }
    return -1;
}

fn virtual_desktop_active() {
    return VD_ACTIVE;
}

virtual_desktop_init();


