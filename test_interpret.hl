// test_interpret.hl -- hl-bootstrap interpreter integration test
//
// This file exercises the interpreter's basic capabilities:
//   1. Variable binding (let, let mut)
//   2. Arithmetic expressions
//   3. String operations
//   4. Function definition and call
//   5. Conditionals (if/else)
//   6. Loops (while)
//   7. Print output
//
// Expected output (8 lines):
//   hello world
//   42
//   55
//   fib(10) = 55
//   PASS: arithmetic
//   PASS: strings
//   PASS: fib
//   All tests passed

let greeting = "hello world";
print(greeting);

let x = 6 * 7;
print(to_string(x));

// Fibonacci (iterative -- avoids PowerShell recursion limit)
fn fib(n) {
    let mut a = 0;
    let mut b = 1;
    let mut i = 0;
    while i < n {
        let tmp = a + b;
        a = b;
        b = tmp;
        i = i + 1;
    }
    return a;
}

let result = fib(10);
print(to_string(result));
print("fib(10) = " + to_string(result));

// Assertions
let mut pass = 0;
let mut fail = 0;

fn assert_eq(actual, expected, name) {
    if actual == expected {
        print("PASS: " + name);
        pass = pass + 1;
    } else {
        print("FAIL: " + name + " expected=" + to_string(expected) + " got=" + to_string(actual));
        fail = fail + 1;
    }
    return 0;
}

assert_eq(6 * 7, 42, "arithmetic");
assert_eq("hello" + " " + "world", "hello world", "strings");
assert_eq(fib(10), 55, "fib");

if fail == 0 {
    print("All tests passed");
} else {
    print("FAILED: " + to_string(fail) + " test(s)");
}
