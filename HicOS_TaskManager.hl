// HicOS_TaskManager.hl -- Task Manager (Native H-L)
//
// User-space interface for process/task management.
// Delegates to bare-kernel/hl/task.hl

fn hicos_task_list() {
    // Call kernel task_list to print all tasks
    task_list();
    return 0;
}

fn hicos_task_info(pid) {
    task_info(pid);
    return 0;
}

fn hicos_task_kill(pid) {
    task_kill(pid);
    print("Task " + to_string(pid) + " terminated");
    return 0;
}

fn hicos_task_run(path) {
    // Load and execute an .hlc or .hl file as new task
    let pid = hlc_exec(path);
    if pid < 0 {
        print("Failed to start: " + path);
        return 0 - 1;
    }
    print("Started: " + path + " (PID " + to_string(pid) + ")");
    return pid;
}

fn hicos_task_stats() {
    print("Tasks: " + to_string(task_count()) + "/" + to_string(MAX_TASKS));
    return task_count();
}

print("HicOS_TaskManager.hl loaded (native H-L)");
