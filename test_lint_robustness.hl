// test_lint_robustness.hl -- Sprint 36 self-test for lint-robustness.ps1
// Each function below intentionally violates one robustness rule.
// Expected lint output:
//   R1 error  on bad_empty_catch
//   R2 warning on bad_log_only_catch
//   R4 warning on bad_uninit_let
//   R5 warning on bad_finally_return

fn bad_empty_catch() {
    try {
        risky();
    } catch e {
    }
}

fn bad_log_only_catch() {
    try {
        risky();
    } catch e {
        print(e);
    }
}

fn bad_uninit_let() {
    let mut x;
    x = 1;
    return x;
}

fn bad_finally_return() {
    try {
        risky();
    } finally {
        return 0;
    }
}
