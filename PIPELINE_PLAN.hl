// PIPELINE_PLAN.hl -- 编译管线打通：项目推进策划案
//
// 当前同步说明（iteration 119 功能基线 + 后续维护修复）：
//   - host-side 编译管线已编译 119/119 模块
//   - 未解析重定位已从 120 降到 1
//   - hl-bootstrap cmd_build 当前可对 111 个 kernel module_paths（外加 3 个 boot stage，共 114 项构建集）完成 token+parse
//   - build_kernel() 的 native code 生成与跨模块链接仍未接通
//   - 该文件保留“自举闭环尚未完全打通”的诊断价值，但最新推进以 PROJECT_ADVANCEMENT_PLAN.hl 为准
//
// 目标: 继续使 hl-bootstrap build_kernel() 更接近完整自举闭环
//
// 诊断日期: 2025
// 诊断者:   hl-bootstrap 自动分析
//
// ============================================================
// 一、现状诊断（管线断裂地图）
// ============================================================
//
// hl-bootstrap.hl 已经具备七大子系统:
//   S1 Hilbert Coordinate Engine     -- 完成 ✓
//   S2 Lexer (source → tokens)       -- 完成 ✓
//   S3 Parser (tokens → AST)         -- 完成 ✓
//   S4 Interpreter / VM              -- 完成 ✓
//   S5 x86_64 Machine Code Encoder   -- 完成 ✓ (126 条指令)
//   S6 Boot Image Builder            -- 部分完成 ⚠
//   S7 CLI                           -- 完成 ✓
//
// bare-kernel/hl/ 下的组件:
//   ir.hl       -- H-IR 中间表示 (37 opcodes + 3 优化 pass) ✓
//   regalloc.hl -- 线性扫描寄存器分配 (14 GP 寄存器)       ✓
//   abi.hl      -- System V AMD64 ABI 调用约定              ✓
//   codegen.hl  -- AST → x86_64 (表达式+变量+二元运算+比较) ⚠ 不完整
//   x86enc.hl   -- 独立 x86_64 编码器 (kernel module 版)   ✓
//
// ============================================================
// 二、六个断裂点（按严重程度排序）
// ============================================================
//
// 断裂点 ① [致命] build_kernel() 尚未消费已解析模块 AST
//   位置: hl-bootstrap.hl `build_kernel()`（当前起始约第 3495 行）
//   现象: module_paths 参数被传入但完全未使用
//         函数生成硬编码 x86 字节序列 (串口+PIC+PIT+IDT+echo)
//   影响: 111 个 kernel module_paths 虽已进入 token+parse，但尚未进入 native build 阶段
//
// 断裂点 ② [致命] 缺少 AST → IR 降低 (Lowering) 层
//   位置: 需要在 ir.hl / codegen.hl 之间新建
//   现象: ir.hl 定义了 37 个 opcode 和 emit/optimize 函数
//         codegen.hl 直接从 AST 生成 x86 (跳过 IR)
//         没有 ast_to_ir() 函数将 AST 节点翻译为 IR 指令
//   影响: 优化 pass (常量折叠 / DCE / 强度削减) 形同虚设
//
// 断裂点 ③ [严重] codegen.hl 只处理表达式子集
//   位置: bare-kernel/hl/codegen.hl 第 194 行 compile_expr()
//   现象: 已实现: Num, Var, BinOp, Unary, Bool, Nil, Str, Array
//         未实现: FnDef, FnCall, If, While, For, Return
//                 Let, Assign, Print, Import, Quadrant
//   影响: 函数定义/调用/控制流/模块系统均无法编译为原生代码
//
// 断裂点 ④ [严重] 无跨模块链接器
//   位置: 缺失
//   现象: 每个模块编译后是独立字节数组，无符号表/重定位表
//         模块 A 调用模块 B 的函数时无法解析目标地址
//   影响: 111 个 kernel module_paths 尚无法组装成一个完整内核二进制
//
// 断裂点 ⑤ [中等] cmd_build() 构建集仍未覆盖 bare-kernel/hl 全量模块
//   位置: hl-bootstrap.hl `cmd_build()`（当前起始约第 4064 行）
//   现象: 当前构建集为 boot_chain 3 + module_paths 111 = 114 项，
//         与仓库中的 117 个 bare-kernel/hl 模块仍有差距
//   影响: 即使自举 native 管线接通，也还需要补齐构建集覆盖
//
// 断裂点 ⑥ [中等] 宿主文件 I/O 桥接
//   位置: hl-bootstrap-shim.ps1 interpret 命令
//   现象: VM 内置 file_read/file_write 只操作内存 VFS
//         build 流程通过 PowerShell rebuild-image.ps1 绕行
//         自举编译器无法自主读取磁盘 .hl 文件
//   影响: 即使编译管线打通，也依赖宿主脚本搬运文件
//
// ============================================================
// 三、六阶段推进计划
// ============================================================

let PHASE_COUNT = 6;

let phases = [
    // ----------------------------------------------------------
    // Phase 1: 模块加载器 (Module Loader)
    // ----------------------------------------------------------
    // 目标: build_kernel() 能够读取 .hl 源文件并产出 token 流
    // 工作量: 中等
    // 优先级: ★★★★★ (没有这一步后续全部阻塞)
    //
    // 任务清单:
    //   1.1  在 hl-bootstrap-shim.ps1 的 build 命令中:
    //        读取 bare-kernel/hl/*.hl 文件内容，
    //        注入到 VM 的 _vm_fs 内存文件系统
    //   1.2  在 image_builder.build_kernel() 中:
    //        遍历 module_paths，对每个路径调用 file_read()
    //   1.3  对读取到的源码调用 lexer.tokenize() 产出 token 流
    //   1.4  验证: 111 个 kernel module_paths 均能成功 tokenize/parse，无 panic
    //
    // 验收标准:
    //   hl-bootstrap build 输出:
    //     [lex] bare-kernel/hl/mem.hl: 847 tokens
    //     [lex] bare-kernel/hl/serial.hl: 312 tokens
    //     ...
    //     [lex] bare-kernel/hl/shell.hl: 2104 tokens
    //     Total: 111 modules, xxxxx tokens
    "Phase 1: Module Loader",

    // ----------------------------------------------------------
    // Phase 2: AST 降低到 IR (AST → H-IR Lowering)
    // ----------------------------------------------------------
    // 目标: 每个 .hl 模块产出 H-IR 指令流
    // 工作量: 大
    // 优先级: ★★★★★
    //
    // 任务清单:
    //   2.1  在 ir.hl 中新增 fn ast_to_ir(ast_node) 函数
    //        处理所有 AST 节点类型:
    //        - Num → IR_CONST
    //        - Var → IR_LOAD (从栈帧)
    //        - BinOp → IR_ADD/SUB/MUL/DIV/MOD/AND/OR/XOR/SHL/SHR
    //                   IR_CMP_EQ/NE/LT/LE/GT/GE
    //        - Unary → IR_NEG / IR_NOT
    //        - Let → IR_CONST + IR_STORE (栈分配)
    //        - Assign → IR_STORE
    //        - If → IR_JZ + IR_LABEL + IR_JMP
    //        - While → IR_LABEL + IR_JZ + IR_JMP (back-edge)
    //        - For → 展开为 While
    //        - FnDef → IR_LABEL (函数入口) + 参数绑定
    //        - Call → IR_ARG * N + IR_CALL
    //        - Return → IR_RET
    //        - Print → IR_PRINT (串口输出 side effect)
    //        - Str → IR_STR_CONST (数据段)
    //        - Array → IR_ALLOC + IR_ARRAY_SET * N
    //        - Index → IR_ARRAY_GET
    //   2.2  在 build_kernel() 中调用:
    //        tokens = lexer.tokenize(source)
    //        ast = parser.parse_program(tokens)
    //        ir_init()
    //        ast_to_ir(ast)
    //        ir_optimize()
    //   2.3  输出每个模块的 IR 统计:
    //        [ir] mem.hl: 342 instrs (280 live, 62 dead), 45 temps
    //
    // 验收标准:
    //   所有 111 个 kernel module_paths 产出有效 IR，优化 pass 能删除 >10% 死代码
    "Phase 2: AST to IR Lowering",

    // ----------------------------------------------------------
    // Phase 3: IR → 原生代码生成 (Full CodeGen)
    // ----------------------------------------------------------
    // 目标: codegen.hl 从 IR 生成完整的 x86_64 原生代码
    // 工作量: 大
    // 优先级: ★★★★☆
    //
    // 任务清单:
    //   3.1  完善 codegen.hl 新增 fn compile_ir(ir_ops, buf)
    //        将 IR 指令逐条翻译为 x86_64 机器码:
    //        - IR_CONST → mov r64, imm
    //        - IR_COPY → mov r64, r64
    //        - IR_ADD/SUB/MUL → add/sub/imul
    //        - IR_DIV/MOD → cqo + idiv
    //        - IR_AND/OR/XOR → and/or/xor
    //        - IR_SHL/SHR → shl/shr (CL 或 imm8)
    //        - IR_NOT/NEG → not/neg
    //        - IR_CMP_* → cmp + setcc + movzx
    //        - IR_JMP → jmp rel32
    //        - IR_JZ/JNZ → je/jne rel32
    //        - IR_LABEL → 记录地址 (patch 目标)
    //        - IR_CALL → 按 ABI push 参数 + call rel32
    //        - IR_ARG → mov rdi/rsi/rdx/rcx/r8/r9, src
    //        - IR_RET → mov rax, src + epilogue + ret
    //        - IR_LOAD/STORE → mov [rbp+disp], r64
    //        - IR_PRINT → 串口输出子程序调用
    //        - IR_STR_CONST → .rodata 段引用
    //        - IR_ALLOC → kmalloc 调用
    //        - IR_ARRAY_GET/SET → 指针偏移访问
    //   3.2  使用 regalloc.hl 分配物理寄存器:
    //        14 个 GP 寄存器 (rax-r15, 排除 rsp/rbp)
    //        溢出到栈帧 [rbp-N]
    //   3.3  使用 abi.hl 处理函数调用约定:
    //        参数: rdi, rsi, rdx, rcx, r8, r9, 栈
    //        返回: rax
    //        caller-saved: rax, rcx, rdx, r8-r11
    //        callee-saved: rbx, rbp, r12-r15
    //   3.4  每个模块编译后输出:
    //        [codegen] mem.hl: 1847 bytes native x86_64
    //
    // 验收标准:
    //   单个模块的简单函数能编译并在 QEMU 中正确执行
    "Phase 3: Full IR-to-Native CodeGen",

    // ----------------------------------------------------------
    // Phase 4: 跨模块链接器 (Cross-Module Linker)
    // ----------------------------------------------------------
    // 目标: 111 个 kernel module_paths 的 native code 合并为一个可执行内核
    // 工作量: 大
    // 优先级: ★★★★☆
    //
    // 任务清单:
    //   4.1  新建 bare-kernel/hl/linker.hl:
    //        - 符号表 (symbol table):
    //          每个模块导出的函数: [name, module_idx, offset]
    //        - 重定位表 (relocation table):
    //          每次 IR_CALL 到外部符号: [call_site, target_name]
    //   4.2  两遍链接:
    //        Pass 1: 收集所有模块的导出符号
    //                计算每个模块在最终二进制中的偏移
    //        Pass 2: 遍历所有重定位条目
    //                将 call rel32 的偏移填入正确地址
    //   4.3  内存布局:
    //        0x100000 - 0x1FFFFF  .text (所有模块的 native code)
    //        0x200000 - 0x200FFF  IDT (256 entries)
    //        0x210000 - 0x21FFFF  ISR stubs
    //        0x300000 - 0x3FFFFF  .data + .bss + heap
    //        0x400000 - 0x4FFFFF  .rodata (字符串常量池)
    //   4.4  入口点:
    //        链接器确保 kernel_init.kernel_main 是第一个
    //        被调用的函数
    //   4.5  每次链接输出:
    //        [link] 111 modules, 847 symbols, 2341 relocations
    //        [link] .text: 89,472 bytes
    //        [link] .rodata: 12,304 bytes
    //        [link] Total kernel: 101,776 bytes
    //
    // 验收标准:
    //   链接后的二进制中所有 call 指令指向正确的函数地址
    "Phase 4: Cross-Module Linker",

    // ----------------------------------------------------------
    // Phase 5: 完整 111 模块集成 + 镜像生成
    // ----------------------------------------------------------
    // 目标: build() 自动编译链接全部 111 个 kernel module_paths 并输出 .img
    // 工作量: 中等
    // 优先级: ★★★☆☆
    //
    // 任务清单:
    //   5.1  更新 cmd_build() 模块列表:
    //        从当前 111 个 module_paths + 3 个 boot stage
    //        扩展到覆盖全部 117 个 bare-kernel/hl 模块的真实构建集
    //   5.2  更新 build_kernel():
    //        替换硬编码内核为:
    //          a) 串口初始化 (保留现有 native code)
    //          b) PIC/PIT/IDT 初始化 (保留)
    //          c) 拼接所有模块的 compiled native code
    //          d) 入口跳转到 kernel_main
    //   5.3  更新 build_stage1() / build_stage2():
    //        根据实际内核大小动态计算扇区数
    //   5.4  更新 manifest.hl:
    //        BOOT_IMAGE_BYTES 改为动态值
    //   5.5  更新 rebuild-image.ps1:
    //        调用新的编译管线而不是硬编码生成
    //
    // 验收标准:
    //   hl-bootstrap build 输出:
    //     Compiling 111 kernel modules...
    //     [lex] ... 111 模块
    //     [ir] ... 111 模块
    //     [codegen] ... 111 模块
    //     [link] 111 modules linked
    //     Image size: XXX bytes (YYY sectors)
    //     HicOS Build Complete
    "Phase 5: Full 111-Module Integration",

    // ----------------------------------------------------------
    // Phase 6: 自验证与 QEMU 启动测试
    // ----------------------------------------------------------
    // 目标: 编译出的镜像能在 QEMU 中启动并输出 banner
    // 工作量: 中等
    // 优先级: ★★★☆☆
    //
    // 任务清单:
    //   6.1  QEMU 启动测试:
    //        qemu-system-x86_64 -drive format=raw,file=hicos-hl.img
    //                           -serial stdio -display none
    //        期望串口输出:
    //          HL!
    //          HicOS 6.0 -- Hilbert-Lang Kernel
    //          Initializing subsystems...
    //          [ok] ...
    //          HicOS>
    //   6.2  自验证:
    //        - 编译后的内核能执行 fib(10) = 89
    //        - 编译后的内核能执行 gcd(48, 18) = 6
    //        - 编译后的内核能响应键盘输入
    //   6.3  回归测试:
    //        - hl-bootstrap test 全部通过
    //        - full-gate.ps1 全部通过
    //        - qemu-boot-test.ps1 通过
    //
    // 验收标准:
    //   QEMU 串口输出包含 "HicOS 6.0" 和 "HicOS>"
    "Phase 6: Self-Verification and QEMU Boot"
];

