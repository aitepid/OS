// bootstrap.hl -- Compatibility bootstrap entry (pure H-L)
// Canonical bootstrap: hl-bootstrap.hl + bare-kernel/hl/build.hl

fn bootstrap_main() {
    print("HicOS Bootstrap Entry");
    print("Canonical bootstrap source: hl-bootstrap.hl");
    print("Canonical build script: bare-kernel/hl/build.hl");
    print("Run: hl-bootstrap bare-kernel/hl/build.hl");
    return 0;
}

bootstrap_main();