// HicOS_UserManager.hl -- User Manager (Native H-L)
//
// User-space multi-user management. Delegates to bare-kernel/hl/users.hl.

fn hicos_user_init() {
    users_init();
    print("HicOS user manager initialized");
    return 0;
}

fn hicos_user_add(name, password) {
    let uid = user_add(name, password);
    if uid < 0 {
        print("Error: cannot add user '" + name + "'");
        return 0 - 1;
    }
    print("User added: " + name + " (uid=" + to_string(uid) + ")");
    return uid;
}

fn hicos_user_del(uid) {
    return user_del(uid);
}

fn hicos_user_auth(name, password) {
    return user_login(name, password);
}

fn hicos_user_list() {
    let count = user_count();
    print("Users: " + to_string(count));
    let mut i = 0;
    while i < count {
        let info = user_info(i);
        print("  uid=" + to_string(i) + " name=" + info);
        i = i + 1;
    }
    return count;
}

fn hicos_user_whoami() {
    if current_uid == 0 { return "root"; }
    return "uid=" + to_string(current_uid);
}

fn hicos_user_su(uid) {
    current_uid = uid;
    current_gid = uid;
    return 0;
}

fn hicos_user_passwd(uid, new_password) {
    return user_set_password(uid, new_password);
}

print("HicOS_UserManager.hl loaded (native H-L)");


