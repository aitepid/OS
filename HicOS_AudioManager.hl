// HicOS_AudioManager.hl -- Audio Manager (Native H-L)
//
// User-space audio interface. Delegates to bare-kernel/hl/audio.hl.

fn hicos_audio_init() {
    ac97_init();
    print("HicOS audio initialized (AC97)");
    return 0;
}

fn hicos_audio_beep(freq, duration_ms) {
    ac97_beep(freq, duration_ms);
    return 0;
}

fn hicos_audio_set_volume(volume) {
    if volume < 0 { volume = 0; }
    if volume > 100 { volume = 100; }
    mixer_set_master(volume);
    return volume;
}

fn hicos_audio_get_volume() {
    return mixer_get_master();
}

fn hicos_audio_play(stream_id) {
    mixer_stream_play(stream_id);
    return 0;
}

fn hicos_audio_stop(stream_id) {
    mixer_stream_stop(stream_id);
    return 0;
}

fn hicos_audio_status() {
    mixer_status();
    return 0;
}

print("HicOS_AudioManager.hl loaded (native H-L)");


