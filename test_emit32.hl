// Test buf_emit32 behavior
let buf = [[]];

fn buf_emit(buf, b) { push(buf[0], b % 256); }
fn buf_emit16(buf, v) { buf_emit(buf, v % 256); buf_emit(buf, (v / 256) % 256); }
fn buf_emit32(buf, v) { buf_emit16(buf, v % 65536); buf_emit16(buf, (v / 65536) % 65536); }

// Test: emit 65535 (0x0000FFFF)
buf_emit32(buf, 65535);
// Expected little-endian bytes: FF FF 00 00
print("emit32(65535):");
print("  [0] = " + to_string(buf[0][0]) + " (expected 255)");
print("  [1] = " + to_string(buf[0][1]) + " (expected 255)");
print("  [2] = " + to_string(buf[0][2]) + " (expected 0)");
print("  [3] = " + to_string(buf[0][3]) + " (expected 0)");

// Test: emit 13605376 (0x00CF9A00)
let buf2 = [[]];
buf_emit32(buf2, 13605376);
print("emit32(13605376):");
print("  [0] = " + to_string(buf2[0][0]) + " (expected 0)");
print("  [1] = " + to_string(buf2[0][1]) + " (expected 154)");
print("  [2] = " + to_string(buf2[0][2]) + " (expected 207)");
print("  [3] = " + to_string(buf2[0][3]) + " (expected 0)");

// Test: 65535 / 65536 in H-L
print("65535 / 65536 = " + to_string(65535 / 65536));
print("65535 % 65536 = " + to_string(65535 % 65536));
