// Simple return propagation test
fn add(a, b) {
    return a + b;
}

fn dispatch(cmd) {
    if cmd == "hello" {
        return add(1, 2);
    }
    if cmd == "world" {
        return add(3, 4);
    }
    return 0;
}

let args = process_args();
if len(args) > 0 {
    let result = dispatch(args[0]);
    print(result);
}
